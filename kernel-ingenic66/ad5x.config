# Flashforge AD5X fragment, merged onto x2600_halley7_linux_defconfig
# with scripts/kconfig/merge_config.sh (see ad5x/build.sh).

# --- Board / device tree (built in, no DTB from the SPL) ---
# CONFIG_DT_X2600_HALLEY7 is not set
CONFIG_DT_X2600_MODULE_BASE=y
# Path relative to module_drivers/dts/ (module_drivers/dts/Makefile)
CONFIG_DT_X2600_MODULE_BASE_DTS_FILE="x2600/ad5x.dts"
CONFIG_INGENIC_BUILTIN_DTB=y
CONFIG_BUILTIN_DTB=y
# DT has no bootargs -> the SPL's argv command line is used
CONFIG_MIPS_CMDLINE_FROM_DTB=y
# CONFIG_CMDLINE_BOOL is not set
# CONFIG_CMDLINE_OVERRIDE is not set
CONFIG_LOCALVERSION="-ad5x"
# CONFIG_LOCALVERSION_AUTO is not set

# --- CPU / timing: keep SMP and HZ=100 (SPL passes a fixed lpj=11935744) ---
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_HZ_100=y
CONFIG_HZ=100
CONFIG_HIGHMEM=y

# --- No initramfs: root is squashfs on /dev/mmcblk0p2/p4 ---
# CONFIG_BLK_DEV_INITRD is not set
CONFIG_INITRAMFS_SOURCE=""

# --- Filesystems (rootfs squashfs: LZO in releases, XZ in some builds) ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_SINGLE=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- eMMC / USB ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI_INGENIC=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_STORAGE=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CP210X=y

# --- Webcams ---
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y

# --- Wi-Fi: RTL8821CU via in-tree rtw88 (firmware rtw88/rtw8821c_fw.bin) ---
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
# Built in, with its firmware built in too (CONFIG_EXTRA_FIRMWARE; build.sh
# fetches rtw88/rtw8821c_fw.bin from linux-firmware and sets the directory):
# no modules in the root filesystem, no race with the root mount.
CONFIG_RTW88=y
CONFIG_RTW88_8821CU=y
CONFIG_FW_LOADER=y
# regulatory.db and its signature: cfg80211 asks for them in late_initcall, before
# the root filesystem is mounted, so they must be built in too (build.sh copies them
# from the wireless-regdb package, REGDB_DIR).
CONFIG_EXTRA_FIRMWARE="rtw88/rtw8821c_fw.bin regulatory.db regulatory.db.p7s"

# --- Ethernet (SDK ingenic_mac) + common RMII PHYs ---
CONFIG_INGENIC_MAC=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y
CONFIG_ICPLUS_PHY=y
CONFIG_SMSC_PHY=y
CONFIG_MICREL_PHY=y
CONFIG_DAVICOM_PHY=y

# --- Networking extras ---
CONFIG_TUN=m

# --- Input / touch / keys / backlight ---
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_TSC2007=y
# CONFIG_TOUCHSCREEN_GT9XX is not set
CONFIG_KEYBOARD_GPIO=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_GPIO=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_CDEV=y

# --- Display: SDK fb_stage_wip + our LVDS panel only ---
CONFIG_FB=y
CONFIG_FB_INGENIC=y
CONFIG_FB_INGENIC_STAGE_WIP=y
CONFIG_FB_INGENIC_DISPLAYS_STAGE=y
CONFIG_STAGE_KX070=y
# CONFIG_STAGE_FW050 is not set
# CONFIG_STAGE_ZC50289HSHD02 is not set

# --- Watchdog (driver not auto-started; provides the reboot handler) ---
CONFIG_WATCHDOG=y
CONFIG_INGENIC_WDT=y

# --- zram swap ---
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_LZ4=y
CONFIG_SWAP=y

# --- Leave the RISC-V core (RTOS started by the SPL) alone ---
# CONFIG_REMOTEPROC is not set
# CONFIG_INGENIC_RISCV_RPROC is not set

# Kernel messages on the LCD (fbcon on the Ingenic fb). console=tty0 on the
# cmdline after console=ttyS0 makes tty0 the /dev/console as well.
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_8x8=y

# --- First chainload run (2026-10-17) ---
# Klipper/pyserial and Moonraker need flock(); the SDK defconfig turns the
# POSIX locking API off ("Could not exclusively lock port /dev/ttyS2").
CONFIG_FILE_LOCKING=y
# 16 KiB lost the early boot messages; 128 KiB.
CONFIG_LOG_BUF_SHIFT=17
# The SDK's Broadcom SDIO Wi-Fi driver (AP6212 on the dev board) isn't on
# the AD5X (RTL8821CU on USB, rtw88) and retries for seconds at boot.
# CONFIG_BCMDHD is not set
# Second run: the DPU probed and the LVDS PHY came up, then "Failed to
# allocate video memory": 800x480x4 x 3 frames = 4.6 MB in one
# dma_alloc_coherent, above the buddy allocator's 4 MB. Contiguous memory
# area for it (and camera/JPEG buffers).
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=16
# Third run: framebuffer up, but the rotator support pads each line to a
# 512-byte multiple (3584 for 800x32bpp); LVGL derives bpp from the stride
# and finds 35 bits ("No draw buffer"). The driver doesn't build without
# ROT_INGENIC, so patches/0003 drops the padding instead (stock doesn't
# rotate: rot_enable=0).
