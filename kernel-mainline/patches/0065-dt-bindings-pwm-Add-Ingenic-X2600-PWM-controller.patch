From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Mon, 9 Nov 2026 17:06:17 -0700
Subject: [PATCH 65/74] dt-bindings: pwm: Add Ingenic X2600 PWM controller

The PWM controller of the Ingenic X2600 is a block of its own, apart
from the TCU whose channels the JZ47xx SoCs use for PWM: 16 channels,
each with its own clock prescaler and 16-bit high and low counts.
---
 .../bindings/pwm/ingenic,x2600-pwm.yaml       | 58 +++++++++++++++++++
 1 file changed, 58 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/pwm/ingenic,x2600-pwm.yaml

diff --git a/Documentation/devicetree/bindings/pwm/ingenic,x2600-pwm.yaml b/Documentation/devicetree/bindings/pwm/ingenic,x2600-pwm.yaml
new file mode 100644
index 000000000..74806dbf8
--- /dev/null
+++ b/Documentation/devicetree/bindings/pwm/ingenic,x2600-pwm.yaml
@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pwm/ingenic,x2600-pwm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Ingenic X2600 PWM controller
+
+maintainers:
+  - Hunter Laux <hunterlaux@gmail.com>
+
+description:
+  The PWM controller of the Ingenic X2600, a block of its own apart from
+  the TCU (see timer/ingenic,tcu.yaml). It has 16 channels, each with its
+  own clock prescaler and 16-bit high and low counts; each channel can
+  also be fed from DMA, and has an input capture unit.
+
+allOf:
+  - $ref: pwm.yaml#
+
+properties:
+  compatible:
+    const: ingenic,x2600-pwm
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  "#pwm-cells":
+    const: 3
+
+required:
+  - compatible
+  - reg
+  - clocks
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/ingenic,x2600-cgu.h>
+
+    pwm@13610000 {
+        compatible = "ingenic,x2600-pwm";
+        reg = <0x13610000 0x1000>;
+
+        interrupts = <20>;
+
+        clocks = <&cgu X2600_CLK_PWM>;
+
+        #pwm-cells = <3>;
+    };
+...
-- 
