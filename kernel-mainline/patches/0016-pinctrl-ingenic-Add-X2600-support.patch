 static u32 ingenic_gpio_read_reg(struct ingenic_gpio_chip *jzgc, u8 reg)
 {
 	unsigned int val;
@@ -3535,23 +3803,49 @@ static void ingenic_gpio_set_bit(struct ingenic_gpio_chip *jzgc,
 	regmap_write(jzgc->jzpc->map, jzgc->reg_base + reg, BIT(offset));
 }
 
+/*
+ * Up to the X2100 the shadow registers are a port "Z" after the last port,
+ * loaded into a port by writing its number to GID2LD. On the X2600 each
+ * port has its own shadow registers, loaded by writing 1 to its GLD.
+ */
+static unsigned int ingenic_shadow_base(struct ingenic_pinctrl *jzpc,
+					unsigned int port)
+{
+	if (is_soc_or_above(jzpc, ID_X2600))
+		return port * jzpc->info->reg_offset + X2600_GPIO_SHADOW;
+
+	return REG_PZ_BASE(jzpc->info->reg_offset);
+}
+
+static void ingenic_shadow_load(struct ingenic_pinctrl *jzpc,
+				unsigned int port)
+{
+	if (is_soc_or_above(jzpc, ID_X2600))
+		regmap_write(jzpc->map,
+			     port * jzpc->info->reg_offset + X2600_GPIO_GLD, 1);
+	else
+		regmap_write(jzpc->map,
+			     REG_PZ_GID2LD(jzpc->info->reg_offset), port);
+}
