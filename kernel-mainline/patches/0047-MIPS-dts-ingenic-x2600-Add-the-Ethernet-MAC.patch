From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Sun, 8 Nov 2026 19:42:50 -0700
Subject: [PATCH 47/52] MIPS: dts: ingenic: x2600: Add the Ethernet MAC

Add the RMII Ethernet MAC, its MDIO bus and the CGU register that
controls its PHY interface. Its bus clock is the GMAC gate of AHB2.
---
 arch/mips/boot/dts/ingenic/x2600.dtsi | 29 +++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/arch/mips/boot/dts/ingenic/x2600.dtsi b/arch/mips/boot/dts/ingenic/x2600.dtsi
index 541f83277..56868173c 100644
--- a/arch/mips/boot/dts/ingenic/x2600.dtsi
+++ b/arch/mips/boot/dts/ingenic/x2600.dtsi
@@ -102,6 +102,11 @@ usb_phy: usb-phy@4c {
 
 			status = "disabled";
 		};
+
+		mac_phy_ctrl: mac-phy-ctrl@e4 {
+			compatible = "ingenic,x2600-mac-phy-ctrl", "syscon";
+			reg = <0xe4 0x4>;
+		};
 	};
 
 	ost: timer@12000000 {
@@ -239,6 +244,30 @@ msc1: mmc@13460000 {
 		status = "disabled";
 	};
 
+	mac: ethernet@134b0000 {
+		compatible = "ingenic,x2600-mac", "ingenic,x1000-mac", "snps,dwmac";
+		reg = <0x134b0000 0x2000>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <55>;
+		interrupt-names = "macirq";
+
+		clocks = <&cgu X2600_CLK_GMAC>;
+		clock-names = "stmmaceth";
+
+		mode-reg = <&mac_phy_ctrl>;
+
+		status = "disabled";
+
+		mdio: mdio {
+			compatible = "snps,dwmac-mdio";
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			status = "disabled";
+		};
+	};
+
 	otg: usb@13500000 {
 		compatible = "ingenic,x2600-otg", "ingenic,x2000-otg";
 		reg = <0x13500000 0x40000>;
-- 
2.43.0

