+#define X2600_CLK_USBPHY_REF		68
+#define X2600_CLK_OTGPHY		69
+#define X2600_CLK_USBPHY		70
+
+#endif /* __DT_BINDINGS_CLOCK_INGENIC_X2600_CGU_H__ */
