From e472974978b1b8fef36afe79a38efaad9221833a Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Sun, 8 Nov 2026 11:37:01 -0700
Subject: [PATCH 16/24] MIPS: dts: ingenic: Add X2600 SoC

Describe the parts of the Ingenic X2600 that mainline supports: the two
XBurst2 cores, the CPU interrupt controller with the per-core JZ4780
style interrupt controller, the CGU, the OST, the GPIO and pin
controller and the eight UARTs.

The UARTs have no DMA properties yet: the X2600 PDMA is not supported,
and 8250_ingenic does not use DMA.
---
 arch/mips/boot/dts/ingenic/x2600.dtsi | 270 ++++++++++++++++++++++++++
 1 file changed, 270 insertions(+)
 create mode 100644 arch/mips/boot/dts/ingenic/x2600.dtsi

diff --git a/arch/mips/boot/dts/ingenic/x2600.dtsi b/arch/mips/boot/dts/ingenic/x2600.dtsi
new file mode 100644
index 000000000..b633d3e81
--- /dev/null
+++ b/arch/mips/boot/dts/ingenic/x2600.dtsi
@@ -0,0 +1,270 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <dt-bindings/clock/ingenic,x2600-cgu.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	compatible = "ingenic,x2600";
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "ingenic,xburst2-fpu2.1-mxu2.1-smt";
+			reg = <0>;
+
+			clocks = <&cgu X2600_CLK_CPU>;
+		};
+
+		cpu1: cpu@1 {
+			device_type = "cpu";
+			compatible = "ingenic,xburst2-fpu2.1-mxu2.1-smt";
+			reg = <1>;
+
+			clocks = <&cgu X2600_CLK_CPU>;
+		};
+	};
+
+	cpuintc: interrupt-controller {
+		#address-cells = <0>;
+		#interrupt-cells = <1>;
+		interrupt-controller;
+		compatible = "mti,cpu-interrupt-controller";
+	};
+
+	/* The bank of CPU 0; each core has its own, 0x100 apart */
+	intc: interrupt-controller@12300000 {
+		compatible = "ingenic,x2600-intc", "ingenic,jz4780-intc";
+		reg = <0x12300000 0x40>;
+
+		interrupt-controller;
+		#interrupt-cells = <1>;
+
+		interrupt-parent = <&cpuintc>;
+		interrupts = <2>;
+	};
+
+	exclk: ext {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+	};
+
+	rtclk: rtc {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+	};
+
+	cgu: clock-controller@10000000 {
+		compatible = "ingenic,x2600-cgu", "simple-mfd";
+		reg = <0x10000000 0x100>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x10000000 0x100>;
+
+		#clock-cells = <1>;
+
+		clocks = <&exclk>, <&rtclk>;
+		clock-names = "ext", "rtc";
+	};
+
+	ost: timer@12000000 {
+		compatible = "ingenic,x2600-ost";
+		reg = <0x12000000 0x18>, <0x12100000 0x200>;
+		reg-names = "global", "core";
+
+		clocks = <&cgu X2600_CLK_OST>;
+		clock-names = "ost";
+
+		interrupt-parent = <&cpuintc>;
+		interrupts = <4>;
+	};
+
+	pinctrl: pinctrl@13601000 {
+		compatible = "ingenic,x2600-pinctrl";
+		reg = <0x13601000 0x5000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpa: gpio@0 {
+			compatible = "ingenic,x2600-gpio";
+			reg = <0>;
+
+			gpio-controller;
+			gpio-ranges = <&pinctrl 0 0 32>;
+			#gpio-cells = <2>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+
+			interrupt-parent = <&intc>;
+			interrupts = <17>;
+		};
+
+		gpb: gpio@1 {
+			compatible = "ingenic,x2600-gpio";
+			reg = <1>;
+
+			gpio-controller;
+			gpio-ranges = <&pinctrl 0 32 32>;
+			#gpio-cells = <2>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+
+			interrupt-parent = <&intc>;
+			interrupts = <16>;
+		};
+
+		gpc: gpio@2 {
+			compatible = "ingenic,x2600-gpio";
+			reg = <2>;
+
+			gpio-controller;
+			gpio-ranges = <&pinctrl 0 64 32>;
+			#gpio-cells = <2>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+
+			interrupt-parent = <&intc>;
+			interrupts = <15>;
+		};
+
+		gpd: gpio@3 {
+			compatible = "ingenic,x2600-gpio";
+			reg = <3>;
+
+			gpio-controller;
+			gpio-ranges = <&pinctrl 0 96 32>;
+			#gpio-cells = <2>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+
+			interrupt-parent = <&intc>;
+			interrupts = <14>;
+		};
+
+		gpe: gpio@4 {
+			compatible = "ingenic,x2600-gpio";
+			reg = <4>;
+
+			gpio-controller;
+			gpio-ranges = <&pinctrl 0 128 32>;
+			#gpio-cells = <2>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+
+			interrupt-parent = <&intc>;
+			interrupts = <13>;
+		};
+	};
+
+	uart0: serial@10030000 {
+		compatible = "ingenic,x2600-uart", "ingenic,x1000-uart";
+		reg = <0x10030000 0x100>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <47>;
+
+		clocks = <&exclk>, <&cgu X2600_CLK_UART0>;
+		clock-names = "baud", "module";
+
+		status = "disabled";
+	};
+
+	uart1: serial@10031000 {
+		compatible = "ingenic,x2600-uart", "ingenic,x1000-uart";
+		reg = <0x10031000 0x100>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <46>;
+
+		clocks = <&exclk>, <&cgu X2600_CLK_UART1>;
+		clock-names = "baud", "module";
+
+		status = "disabled";
+	};
+
+	uart2: serial@10032000 {
+		compatible = "ingenic,x2600-uart", "ingenic,x1000-uart";
+		reg = <0x10032000 0x100>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <45>;
+
+		clocks = <&exclk>, <&cgu X2600_CLK_UART2>;
+		clock-names = "baud", "module";
+
+		status = "disabled";
+	};
+
+	uart3: serial@10033000 {
+		compatible = "ingenic,x2600-uart", "ingenic,x1000-uart";
+		reg = <0x10033000 0x100>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <44>;
+
+		clocks = <&exclk>, <&cgu X2600_CLK_UART3>;
+		clock-names = "baud", "module";
+
+		status = "disabled";
+	};
+
+	uart4: serial@10034000 {
+		compatible = "ingenic,x2600-uart", "ingenic,x1000-uart";
+		reg = <0x10034000 0x100>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <43>;
+
+		clocks = <&exclk>, <&cgu X2600_CLK_UART4>;
+		clock-names = "baud", "module";
+
+		status = "disabled";
+	};
+
+	uart5: serial@10035000 {
+		compatible = "ingenic,x2600-uart", "ingenic,x1000-uart";
+		reg = <0x10035000 0x100>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <42>;
+
+		clocks = <&exclk>, <&cgu X2600_CLK_UART5>;
+		clock-names = "baud", "module";
+
+		status = "disabled";
+	};
+
+	uart6: serial@10036000 {
+		compatible = "ingenic,x2600-uart", "ingenic,x1000-uart";
+		reg = <0x10036000 0x100>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <41>;
+
+		clocks = <&exclk>, <&cgu X2600_CLK_UART6>;
+		clock-names = "baud", "module";
+
+		status = "disabled";
+	};
+
+	uart7: serial@10037000 {
+		compatible = "ingenic,x2600-uart", "ingenic,x1000-uart";
+		reg = <0x10037000 0x100>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <40>;
+
+		clocks = <&exclk>, <&cgu X2600_CLK_UART7>;
+		clock-names = "baud", "module";
+
+		status = "disabled";
+	};
+};
-- 
