From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Mon, 9 Nov 2026 10:04:54 -0700
Subject: [PATCH 58/74] MIPS: dts: ingenic: x2600: Add the I2C controllers

Describe the four I2C controllers of the X2600, with their interrupts,
clocks and DMA channels.
---
 arch/mips/boot/dts/ingenic/x2600.dtsi | 72 +++++++++++++++++++++++++++
 1 file changed, 72 insertions(+)

diff --git a/arch/mips/boot/dts/ingenic/x2600.dtsi b/arch/mips/boot/dts/ingenic/x2600.dtsi
index 56868173c..c9144a00a 100644
--- a/arch/mips/boot/dts/ingenic/x2600.dtsi
+++ b/arch/mips/boot/dts/ingenic/x2600.dtsi
@@ -121,6 +121,78 @@ ost: timer@12000000 {
 		interrupts = <4>;
 	};
 
+	i2c0: i2c@10050000 {
+		compatible = "ingenic,x2600-i2c", "ingenic,x1000-i2c";
+		reg = <0x10050000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <59>;
+
+		clocks = <&cgu X2600_CLK_I2C0>;
+
+		dmas = <&pdma X2600_DMA_I2C0_RX 0xffffffff>,
+		       <&pdma X2600_DMA_I2C0_TX 0xffffffff>;
+		dma-names = "rx", "tx";
+
+		status = "disabled";
+	};
+
+	i2c1: i2c@10051000 {
+		compatible = "ingenic,x2600-i2c", "ingenic,x1000-i2c";
+		reg = <0x10051000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <58>;
+
+		clocks = <&cgu X2600_CLK_I2C1>;
+
+		dmas = <&pdma X2600_DMA_I2C1_RX 0xffffffff>,
+		       <&pdma X2600_DMA_I2C1_TX 0xffffffff>;
+		dma-names = "rx", "tx";
+
+		status = "disabled";
+	};
+
+	i2c2: i2c@10052000 {
+		compatible = "ingenic,x2600-i2c", "ingenic,x1000-i2c";
+		reg = <0x10052000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <57>;
+
+		clocks = <&cgu X2600_CLK_I2C2>;
+
+		dmas = <&pdma X2600_DMA_I2C2_RX 0xffffffff>,
+		       <&pdma X2600_DMA_I2C2_TX 0xffffffff>;
+		dma-names = "rx", "tx";
+
+		status = "disabled";
+	};
+
+	i2c3: i2c@10053000 {
+		compatible = "ingenic,x2600-i2c", "ingenic,x1000-i2c";
+		reg = <0x10053000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <56>;
+
+		clocks = <&cgu X2600_CLK_I2C3>;
+
+		dmas = <&pdma X2600_DMA_I2C3_RX 0xffffffff>,
+		       <&pdma X2600_DMA_I2C3_TX 0xffffffff>;
+		dma-names = "rx", "tx";
+
+		status = "disabled";
+	};
+
 	pinctrl: pinctrl@13601000 {
 		compatible = "ingenic,x2600-pinctrl";
 		reg = <0x13601000 0x5000>;
-- 
2.43.0

