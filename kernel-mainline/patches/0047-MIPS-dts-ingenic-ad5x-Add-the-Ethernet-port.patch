From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Sun, 8 Nov 2026 19:43:18 -0700
Subject: [PATCH 47/49] MIPS: dts: ingenic: ad5x: Add the Ethernet port

The MAC talks RMII to an IC Plus IP101G at MDIO address 1, which also
supplies the 50 MHz reference clock: the stock firmware leaves the
SoC's own PHY clock output (PC15) as a GPIO.
---
 arch/mips/boot/dts/ingenic/ad5x.dts | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/arch/mips/boot/dts/ingenic/ad5x.dts b/arch/mips/boot/dts/ingenic/ad5x.dts
index 949335d43..8c11bca7f 100644
--- a/arch/mips/boot/dts/ingenic/ad5x.dts
+++ b/arch/mips/boot/dts/ingenic/ad5x.dts
@@ -69,6 +69,25 @@ &exclk {
 	clock-frequency = <24000000>;
 };
 
+&mac {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_mac>;
+
+	phy-mode = "rmii";
+	phy-handle = <&ip101g>;
+
+	status = "okay";
+};
+
+&mdio {
+	status = "okay";
+
+	ip101g: ethernet-phy@1 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <1>;
+	};
+};
+
 /* eMMC */
 &msc0 {
 	pinctrl-names = "default";
@@ -98,6 +117,11 @@ &otg_phy {
 };
 
 &pinctrl {
+	pins_mac: mac {
+		function = "mac0";
+		groups = "mac0-rmii";
+	};
+
 	pins_mmc0: mmc0 {
 		function = "mmc0";
 		groups = "mmc0-4bit", "mmc0-8bit";
