From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Mon, 9 Nov 2026 13:53:23 -0700
Subject: [PATCH 62/74] dt-bindings: watchdog: Add Ingenic X2600 watchdog

The watchdog of the Ingenic X2600 has the registers of the JZ47xx TCU
watchdog, but in a block of its own, not inside a TCU: it has its own
register range and its own clocks, the TCU0 bus clock and the RTC clock
it counts.
---
 .../watchdog/ingenic,x2600-watchdog.yaml      | 62 +++++++++++++++++++
 1 file changed, 62 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/watchdog/ingenic,x2600-watchdog.yaml

diff --git a/Documentation/devicetree/bindings/watchdog/ingenic,x2600-watchdog.yaml b/Documentation/devicetree/bindings/watchdog/ingenic,x2600-watchdog.yaml
new file mode 100644
index 000000000..fda0d9724
--- /dev/null
+++ b/Documentation/devicetree/bindings/watchdog/ingenic,x2600-watchdog.yaml
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/watchdog/ingenic,x2600-watchdog.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Ingenic X2600 watchdog
+
+maintainers:
+  - Hunter Laux <hunterlaux@gmail.com>
+
+description:
+  The watchdog of the Ingenic X2600 has the registers of the JZ47xx TCU
+  watchdog (see timer/ingenic,tcu.yaml), but in a block of its own rather
+  than inside a TCU. It counts the RTC clock through its own prescaler,
+  and resets the SoC when the count reaches its limit.
+
+allOf:
+  - $ref: watchdog.yaml#
+
+properties:
+  compatible:
+    const: ingenic,x2600-watchdog
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: Register access clock
+      - description: Counter input, the RTC clock
+
+  clock-names:
+    items:
+      - const: bus
+      - const: wdt
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/ingenic,x2600-cgu.h>
+
+    watchdog@13630000 {
+        compatible = "ingenic,x2600-watchdog";
+        reg = <0x13630000 0x40>;
+
+        interrupts = <26>;
+
+        clocks = <&cgu X2600_CLK_TCU0>, <&cgu X2600_CLK_RTC>;
+        clock-names = "bus", "wdt";
+    };
+...
