From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Mon, 9 Nov 2026 13:53:23 -0700
Subject: [PATCH 62/68] watchdog: jz4740: Add Ingenic X2600 support

The X2600 watchdog has the JZ47xx TCU watchdog registers (TDR, TCER,
TCNT, TCSR) and the TCU's stop set/clear registers, in a block of its
own. With no TCU around it there is no TCU clock driver to select and
divide its input either.

For the X2600, map the block's own registers, enable its bus clock, and
set up TCSR as the TCU clock driver does for the JZ47xx: the RTC clock
divided by 1024, which at EXCLK/512 lets the 16-bit counter run for up
to about 24 minutes. Then clear the watchdog's stop bit.

Its counter ignores writes, so a ping clears it with TCSR's CLRZ bit
instead of writing TCNT.

The driver's restart handler gives the X2600 its only way to restart
under mainline.
---
 drivers/watchdog/Kconfig      |   4 +-
 drivers/watchdog/jz4740_wdt.c | 116 ++++++++++++++++++++++++++++------
 2 files changed, 101 insertions(+), 19 deletions(-)

diff --git a/drivers/watchdog/Kconfig b/drivers/watchdog/Kconfig
index f7d0a0c2c..89c3a4897 100644
--- a/drivers/watchdog/Kconfig
+++ b/drivers/watchdog/Kconfig
@@ -1862,8 +1862,10 @@ config JZ4740_WDT
 	depends on COMMON_CLK
 	select WATCHDOG_CORE
 	select MFD_SYSCON
+	select REGMAP_MMIO
 	help
-	  Hardware driver for the built-in watchdog timer on Ingenic jz4740 SoCs.
+	  Hardware driver for the built-in watchdog timer on Ingenic jz4740
+	  and later SoCs, X2600 included. It also restarts the system.
 
 config WDT_MTX1
 	tristate "MTX-1 Hardware Watchdog"
diff --git a/drivers/watchdog/jz4740_wdt.c b/drivers/watchdog/jz4740_wdt.c
index 395bde79e..c7cd86af0 100644
--- a/drivers/watchdog/jz4740_wdt.c
+++ b/drivers/watchdog/jz4740_wdt.c
@@ -18,11 +18,28 @@
 #include <linux/slab.h>
 #include <linux/err.h>
 #include <linux/of.h>
+#include <linux/property.h>
 #include <linux/regmap.h>
 
 #define DEFAULT_HEARTBEAT 5
 #define MAX_HEARTBEAT     2048
 
+/*
+ * The X2600's watchdog has the TCU's watchdog registers and its stop
+ * bit, in a block of its own with no TCU clock driver to set up its
+ * input: the driver counts the RTC clock divided by 1024. Its counter
+ * ignores writes; TCSR's CLRZ bit clears it.
+ */
+#define X2600_WDT_TCSR_RTC_EN	BIT(1)
+#define X2600_WDT_TCSR_CLRZ	BIT(10)
+#define X2600_WDT_PRESCALE	5	/* 4^5 = 1024 */
+#define X2600_WDT_STOP		BIT(16)	/* in TSSR, TSCR */
+
+struct jz4740_wdt_soc_info {
+	bool own_regs;
+	bool clrz;
+};
+
 static bool nowayout = WATCHDOG_NOWAYOUT;
 module_param(nowayout, bool, 0);
 MODULE_PARM_DESC(nowayout,
@@ -38,16 +55,25 @@ MODULE_PARM_DESC(heartbeat,
 
 struct jz4740_wdt_drvdata {
 	struct watchdog_device wdt;
+	const struct jz4740_wdt_soc_info *soc_info;
 	struct regmap *map;
 	struct clk *clk;
 	unsigned long clk_rate;
 };
 
+static void jz4740_wdt_clear(struct jz4740_wdt_drvdata *drvdata)
+{
+	if (drvdata->soc_info && drvdata->soc_info->clrz)
+		regmap_set_bits(drvdata->map, TCU_REG_WDT_TCSR, X2600_WDT_TCSR_CLRZ);
+	else
+		regmap_write(drvdata->map, TCU_REG_WDT_TCNT, 0);
+}
+
 static int jz4740_wdt_ping(struct watchdog_device *wdt_dev)
 {
 	struct jz4740_wdt_drvdata *drvdata = watchdog_get_drvdata(wdt_dev);
 
-	regmap_write(drvdata->map, TCU_REG_WDT_TCNT, 0);
+	jz4740_wdt_clear(drvdata);
 
 	return 0;
 }
@@ -63,7 +89,7 @@ static int jz4740_wdt_set_timeout(struct watchdog_device *wdt_dev,
 	regmap_write(drvdata->map, TCU_REG_WDT_TCER, 0);
 
 	regmap_write(drvdata->map, TCU_REG_WDT_TDR, timeout_value);
-	regmap_write(drvdata->map, TCU_REG_WDT_TCNT, 0);
+	jz4740_wdt_clear(drvdata);
 
 	if (tcer & TCU_WDT_TCER_TCEN)
 		regmap_write(drvdata->map, TCU_REG_WDT_TCER, TCU_WDT_TCER_TCEN);
@@ -125,17 +151,62 @@ static const struct watchdog_ops jz4740_wdt_ops = {
 	.restart = jz4740_wdt_restart,
 };
 
+static const struct jz4740_wdt_soc_info x2600_wdt_soc_info = {
+	.own_regs = true,
+	.clrz = true,
+};
+
 #ifdef CONFIG_OF
 static const struct of_device_id jz4740_wdt_of_matches[] = {
 	{ .compatible = "ingenic,jz4740-watchdog", },
 	{ .compatible = "ingenic,jz4780-watchdog", },
+	{ .compatible = "ingenic,x2600-watchdog", .data = &x2600_wdt_soc_info },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, jz4740_wdt_of_matches);
 #endif
 
+static const struct regmap_config x2600_wdt_regmap_config = {
+	.reg_bits = 32,
+	.val_bits = 32,
+	.reg_stride = 4,
+	.max_register = TCU_REG_TSCR,
+};
+
+static int x2600_wdt_init(struct platform_device *pdev,
+			  struct jz4740_wdt_drvdata *drvdata)
+{
+	struct device *dev = &pdev->dev;
+	struct clk *bus_clk;
+	void __iomem *base;
+
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+
+	drvdata->map = devm_regmap_init_mmio(dev, base, &x2600_wdt_regmap_config);
+	if (IS_ERR(drvdata->map))
+		return PTR_ERR(drvdata->map);
+
+	bus_clk = devm_clk_get_enabled(dev, "bus");
+	if (IS_ERR(bus_clk))
+		return dev_err_probe(dev, PTR_ERR(bus_clk), "cannot get bus clock\n");
+
+	drvdata->clk_rate = clk_get_rate(drvdata->clk) >> (2 * X2600_WDT_PRESCALE);
+	if (!drvdata->clk_rate)
+		return dev_err_probe(dev, -EINVAL, "WDT clock too slow\n");
+
+	regmap_write(drvdata->map, TCU_REG_WDT_TCSR,
+		     X2600_WDT_TCSR_RTC_EN |
+		     (X2600_WDT_PRESCALE << TCU_TCSR_PRESCALE_LSB));
+	regmap_write(drvdata->map, TCU_REG_TSCR, X2600_WDT_STOP);
+
+	return 0;
+}
+
 static int jz4740_wdt_probe(struct platform_device *pdev)
 {
+	const struct jz4740_wdt_soc_info *soc_info;
 	struct device *dev = &pdev->dev;
 	struct jz4740_wdt_drvdata *drvdata;
 	struct watchdog_device *jz4740_wdt;
@@ -153,21 +224,36 @@ static int jz4740_wdt_probe(struct platform_device *pdev)
 		return PTR_ERR(drvdata->clk);
 	}
 
-	/* Set smallest clock possible */
-	rate = clk_round_rate(drvdata->clk, 1);
-	if (rate < 0)
-		return rate;
-
-	ret = clk_set_rate(drvdata->clk, rate);
-	if (ret)
-		return ret;
+	soc_info = device_get_match_data(dev);
+	drvdata->soc_info = soc_info;
+	if (soc_info && soc_info->own_regs) {
+		ret = x2600_wdt_init(pdev, drvdata);
+		if (ret)
+			return ret;
+	} else {
+		/* Set smallest clock possible */
+		rate = clk_round_rate(drvdata->clk, 1);
+		if (rate < 0)
+			return rate;
+
+		ret = clk_set_rate(drvdata->clk, rate);
+		if (ret)
+			return ret;
+
+		drvdata->clk_rate = rate;
+
+		drvdata->map = device_node_to_regmap(dev->parent->of_node);
+		if (IS_ERR(drvdata->map)) {
+			dev_err(dev, "regmap not found\n");
+			return PTR_ERR(drvdata->map);
+		}
+	}
 
-	drvdata->clk_rate = rate;
 	jz4740_wdt = &drvdata->wdt;
 	jz4740_wdt->info = &jz4740_wdt_info;
 	jz4740_wdt->ops = &jz4740_wdt_ops;
 	jz4740_wdt->min_timeout = 1;
-	jz4740_wdt->max_timeout = 0xffff / rate;
+	jz4740_wdt->max_timeout = 0xffff / drvdata->clk_rate;
 	jz4740_wdt->timeout = clamp(heartbeat,
 				    jz4740_wdt->min_timeout,
 				    jz4740_wdt->max_timeout);
@@ -175,12 +261,6 @@ static int jz4740_wdt_probe(struct platform_device *pdev)
 	watchdog_set_nowayout(jz4740_wdt, nowayout);
 	watchdog_set_drvdata(jz4740_wdt, drvdata);
 
-	drvdata->map = device_node_to_regmap(dev->parent->of_node);
-	if (IS_ERR(drvdata->map)) {
-		dev_err(dev, "regmap not found\n");
-		return PTR_ERR(drvdata->map);
-	}
-
 	return devm_watchdog_register_device(dev, &drvdata->wdt);
 }
 
