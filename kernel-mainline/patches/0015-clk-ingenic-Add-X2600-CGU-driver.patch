+		 * Disabling DDR clock or its parents will render DRAM
+		 * inaccessible; mark it critical.
+		 */
+		.flags = CLK_IS_CRITICAL,
+		.parents = { -1, X2600_CLK_SCLKA, X2600_CLK_MPLL, -1 },
+		.mux = { CGU_REG_DDRCDR, 30, 2 },
+		.div = X2600_CDR_DIV(CGU_REG_DDRCDR, 1, 4),
+		.gate = { CGU_REG_CLKGR1, 23 },
+	},
+
+	[X2600_CLK_MAC] = {
+		"mac", CGU_CLK_MUX | CGU_CLK_DIV,
+		.parents = X2600_CDR_PARENTS,
+		.mux = { CGU_REG_MACCDR, 30, 2 },
+		.div = X2600_CDR_DIV(CGU_REG_MACCDR, 1, 8),
+	},
+
+	[X2600_CLK_LCD] = {
+		"lcd", CGU_CLK_MUX | CGU_CLK_DIV | CGU_CLK_GATE,
+		.parents = X2600_CDR_PARENTS,
+		.mux = { CGU_REG_LPCDR, 30, 2 },
+		.div = X2600_CDR_DIV(CGU_REG_LPCDR, 1, 8),
+		.gate = { CGU_REG_CLKGR1, 14 },
+	},
+
+	[X2600_CLK_MSC0] = {
+		"msc0", CGU_CLK_MUX | CGU_CLK_DIV | CGU_CLK_GATE,
+		.parents = { X2600_CLK_SCLKA, X2600_CLK_MPLL, X2600_CLK_EXCLK, -1 },
+		.mux = { CGU_REG_MSC0CDR, 30, 2, .by_rate = true },
+		.div = X2600_CDR_DIV(CGU_REG_MSC0CDR, 4, 8),
+		.gate = { CGU_REG_CLKGR0, 2 },
+	},
+
+	[X2600_CLK_MSC1] = {
+		"msc1", CGU_CLK_MUX | CGU_CLK_DIV | CGU_CLK_GATE,
+		.parents = { X2600_CLK_SCLKA, X2600_CLK_MPLL, X2600_CLK_EXCLK, -1 },
