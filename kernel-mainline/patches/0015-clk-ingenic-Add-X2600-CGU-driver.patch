+	},
+
+	[X2600_CLK_G2D] = {
+		"g2d", CGU_CLK_MUX | CGU_CLK_DIV | CGU_CLK_GATE,
+		.parents = X2600_CDR_PARENTS,
+		.mux = { CGU_REG_G2DCDR, 30, 2 },
+		.div = X2600_CDR_DIV(CGU_REG_G2DCDR, 1, 4),
+		.gate = { CGU_REG_CLKGR1, 15 },
+	},
+
+	[X2600_CLK_PWM] = {
