+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Ingenic X2600 SoC CGU driver
+ *
+ * Register layout from Ingenic's X2600 SDK (Linux 6.6) clock driver.
+ */
+
+#include <linux/clk-provider.h>
+#include <linux/math64.h>
+#include <linux/of.h>
+#include <linux/units.h>
+
+#include <dt-bindings/clock/ingenic,x2600-cgu.h>
+
+#include "cgu.h"
+#include "pm.h"
+
+/* CGU register offsets */
+#define CGU_REG_CPCCR		0x00
+#define CGU_REG_APLL		0x10
+#define CGU_REG_MPLL		0x14
+#define CGU_REG_EPLL		0x18
+#define CGU_REG_CLKGR0		0x20
+#define CGU_REG_OPCR		0x24
+#define CGU_REG_CLKGR1		0x28
+#define CGU_REG_DDRCDR		0x2c
+#define CGU_REG_G2DCDR		0x30
+#define CGU_REG_MACCDR		0x54
+#define CGU_REG_SSICDR		0x5c
+#define CGU_REG_LPCDR		0x64
+#define CGU_REG_MSC0CDR		0x68
+#define CGU_REG_PWMCDR		0x6c
+#define CGU_REG_SFCCDR		0x74
+#define CGU_REG_CIMCDR		0x78
+#define CGU_REG_TPCCDR		0x7c
+#define CGU_REG_CAN0CDR		0xa0
+#define CGU_REG_MSC1CDR		0xa4
+#define CGU_REG_CAN1CDR		0xa8
+#define CGU_REG_SADCCDR		0xac
+
+/*
+ * The range of VCO rates among the PLL settings Ingenic lists for the
+ * X2600; the documented VCO range is not available.
+ */
+#define X2600_PLL_VCO_MIN	(672 * HZ_PER_MHZ)
+#define X2600_PLL_VCO_MAX	(2400 * HZ_PER_MHZ)
+
+/* The OD0 field holds the divider value itself (1 to 7) */
+static const s8 x2600_pll_od_encoding[] = { 1, 2, 3, 4, 5, 6, 7 };
+
+static void x2600_pll_calc_m_n_od(const struct ingenic_cgu_pll_info *pll_info,
+				  unsigned long rate, unsigned long parent_rate,
+				  unsigned int *pm, unsigned int *pn,
+				  unsigned int *pod)
+{
+	unsigned int m, n, od, best_m = 1, best_n = 1, best_od = 1;
+	u64 vco, err, best_err = U64_MAX;
+
+	/*
+	 * Fout = Fin * M / N / OD. Of the settings that keep the VCO in range,
+	 * with an input divider of 1 to 4 as in Ingenic's settings, take the
+	 * one closest to the requested rate; the lowest OD and N on a tie.
+	 */
+	for (od = 1; od <= pll_info->od_max; od++) {
+		vco = (u64)rate * od;
+		if (vco < X2600_PLL_VCO_MIN || vco > X2600_PLL_VCO_MAX)
+			continue;
+
+		for (n = 1; n <= 4; n++) {
+			m = DIV_ROUND_CLOSEST_ULL(vco * n, parent_rate);
+			if (!m || m >= BIT(pll_info->m_bits))
+				continue;
+
+			err = abs_diff(div_u64((u64)parent_rate * m, n * od),
+				       (u64)rate);
+			if (err < best_err) {
+				best_err = err;
+				best_m = m;
+				best_n = n;
+				best_od = od;
+			}
+		}
+	}
+
+	*pm = best_m;
+	*pn = best_n;
+	*pod = best_od;
+}
+
+#define X2600_PLL(_reg) {						\
+	.reg = _reg,							\
+	.rate_multiplier = 1,						\
+	.m_shift = 20,							\
+	.m_bits = 12,							\
+	.n_shift = 14,							\
+	.n_bits = 6,							\
+	.od_shift = 8,							\
+	.od_bits = 3,							\
+	.od_max = ARRAY_SIZE(x2600_pll_od_encoding),			\
+	.od_encoding = x2600_pll_od_encoding,				\
+	.od2_shift = 11,						\
+	.od2_bits = 3,							\
+	.bypass_bit = -1,						\
+	.enable_bit = 0,						\
+	.stable_bit = 3,						\
+	.calc_m_n_od = x2600_pll_calc_m_n_od,				\
+}
+
+/* Divider in a CDR register: CE bit 29, busy bit 28, stop bit 27 */
+#define X2600_CDR_DIV(_reg, _div, _bits)				\
+	{ _reg, 0, _div, _bits, 29, 28, 27 }
+
+#define X2600_CDR_PARENTS \
+	{ X2600_CLK_SCLKA, X2600_CLK_MPLL, X2600_CLK_EPLL, -1 }
+
+static const struct ingenic_cgu_clk_info x2600_cgu_clocks[] = {
+	/* External clocks */
+
+	[X2600_CLK_EXCLK] = { "ext", CGU_CLK_EXT },
+	[X2600_CLK_RTCLK] = { "rtc", CGU_CLK_EXT },
+
+	/* PLLs */
+
+	[X2600_CLK_APLL] = {
+		"apll", CGU_CLK_PLL,
+		.parents = { X2600_CLK_EXCLK, -1, -1, -1 },
+		.pll = X2600_PLL(CGU_REG_APLL),
+	},
+
+	[X2600_CLK_MPLL] = {
+		"mpll", CGU_CLK_PLL,
+		.parents = { X2600_CLK_EXCLK, -1, -1, -1 },
+		.pll = X2600_PLL(CGU_REG_MPLL),
+	},
+
+	[X2600_CLK_EPLL] = {
+		"epll", CGU_CLK_PLL,
+		.parents = { X2600_CLK_EXCLK, -1, -1, -1 },
+		.pll = X2600_PLL(CGU_REG_EPLL),
+	},
+
+	/* Muxes & dividers */
+
+	[X2600_CLK_SCLKA] = {
+		"sclk_a", CGU_CLK_MUX,
+		.parents = { -1, X2600_CLK_EXCLK, X2600_CLK_APLL, -1 },
+		.mux = { CGU_REG_CPCCR, 30, 2 },
+	},
+
+	[X2600_CLK_CPUMUX] = {
+		"cpu_mux", CGU_CLK_MUX,
+		.parents = { -1, X2600_CLK_SCLKA, X2600_CLK_MPLL, -1 },
+		.mux = { CGU_REG_CPCCR, 28, 2 },
+	},
+
+	/*
+	 * The busy flags of the CPCCR dividers are in CPCSR, which the CGU
+	 * code cannot poll; like on the X1830 they go without.
+	 */
+	[X2600_CLK_CPU] = {
+		"cpu", CGU_CLK_DIV,
+		.flags = CLK_IS_CRITICAL,
+		.parents = { X2600_CLK_CPUMUX, -1, -1, -1 },
+		.div = { CGU_REG_CPCCR, 0, 1, 4, 22, -1, -1 },
+	},
+
+	[X2600_CLK_L2CACHE] = {
+		"l2cache", CGU_CLK_DIV,
+		/*
+		 * The L2 cache clock is critical if caches are enabled and
+		 * disabling it or any parent clocks will hang the system.
+		 */
+		.flags = CLK_IS_CRITICAL,
+		.parents = { X2600_CLK_CPUMUX, -1, -1, -1 },
