From ddd81264fd71fa13dfb67e208e0b5c6a89ca9863 Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Sun, 8 Nov 2026 11:28:29 -0700
Subject: [PATCH 12/23] dt-bindings: timer: Add Ingenic X2600 OST

The OST of the Ingenic X2600 is split in two: a global 64-bit counter
shared by all cores, and a 32-bit compare timer per core, which
interrupts its own core directly. Unlike the X1000 SYSOST, both parts
are separate register blocks, so describe it with its own binding.
---
 .../bindings/timer/ingenic,x2600-ost.yaml     | 66 +++++++++++++++++++
 1 file changed, 66 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/timer/ingenic,x2600-ost.yaml

diff --git a/Documentation/devicetree/bindings/timer/ingenic,x2600-ost.yaml b/Documentation/devicetree/bindings/timer/ingenic,x2600-ost.yaml
new file mode 100644
index 000000000..efd0cfb9c
--- /dev/null
+++ b/Documentation/devicetree/bindings/timer/ingenic,x2600-ost.yaml
@@ -0,0 +1,66 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/timer/ingenic,x2600-ost.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Ingenic X2600 operating system timer (OST)
+
+maintainers:
+  - Hunter Laux <hunterlaux@gmail.com>
+
+description:
+  The OST of the Ingenic X2600 has a global part, one 64-bit counter shared
+  by all cores, and a core part, one 32-bit compare timer per core in banks
+  of 0x100 bytes. The core timers interrupt their own core directly, on CPU
+  interrupt line 4.
+
+properties:
+  compatible:
+    const: ingenic,x2600-ost
+
+  reg:
+    items:
+      - description: Global OST, the 64-bit counter
+      - description: Core OST, one 0x100-byte bank per core
+
+  reg-names:
+    items:
+      - const: global
+      - const: core
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: ost
+
+  interrupts:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/ingenic,x2600-cgu.h>
+
+    timer@12000000 {
+        compatible = "ingenic,x2600-ost";
+        reg = <0x12000000 0x18>, <0x12100000 0x200>;
+        reg-names = "global", "core";
+
+        clocks = <&cgu X2600_CLK_OST>;
+        clock-names = "ost";
+
+        interrupt-parent = <&cpuintc>;
+        interrupts = <4>;
+    };
+...
