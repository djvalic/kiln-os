From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Sun, 8 Nov 2026 15:41:13 -0700
Subject: [PATCH 21/46] dt-bindings: dma: ingenic: Add X2600

The DMA controller of the Ingenic X2600 has the registers, descriptor
format and 32 channels of the X1830's. Document its compatible, with the
X1830 one as fallback, and add its request type numbers.
---
 .../devicetree/bindings/dma/ingenic,dma.yaml  |  3 ++
 include/dt-bindings/dma/ingenic,x2600-dma.h   | 51 +++++++++++++++++++
 2 files changed, 54 insertions(+)
 create mode 100644 include/dt-bindings/dma/ingenic,x2600-dma.h

diff --git a/Documentation/devicetree/bindings/dma/ingenic,dma.yaml b/Documentation/devicetree/bindings/dma/ingenic,dma.yaml
index d9cca3006..d6b8af30b 100644
--- a/Documentation/devicetree/bindings/dma/ingenic,dma.yaml
+++ b/Documentation/devicetree/bindings/dma/ingenic,dma.yaml
@@ -32,6 +32,9 @@ properties:
       - items:
           - const: ingenic,jz4770-bdma
           - const: ingenic,jz4760b-bdma
+      - items:
+          - const: ingenic,x2600-dma
+          - const: ingenic,x1830-dma
 
   reg:
     items:
diff --git a/include/dt-bindings/dma/ingenic,x2600-dma.h b/include/dt-bindings/dma/ingenic,x2600-dma.h
new file mode 100644
index 000000000..547556646
--- /dev/null
+++ b/include/dt-bindings/dma/ingenic,x2600-dma.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+/*
+ * Request type numbers for the Ingenic X2600 DMA controller (written to the
+ * DRTn register of the channel).
+ */
+
+#ifndef __DT_BINDINGS_DMA_INGENIC_X2600_DMA_H__
+#define __DT_BINDINGS_DMA_INGENIC_X2600_DMA_H__
+
+#define X2600_DMA_PCM_TX	0x06
+#define X2600_DMA_PCM_RX	0x07
+#define X2600_DMA_AUTO		0x08
+#define X2600_DMA_UART5_TX	0x0a
+#define X2600_DMA_UART5_RX	0x0b
+#define X2600_DMA_UART4_TX	0x0c
+#define X2600_DMA_UART4_RX	0x0d
+#define X2600_DMA_UART3_TX	0x0e
+#define X2600_DMA_UART3_RX	0x0f
+#define X2600_DMA_UART2_TX	0x10
+#define X2600_DMA_UART2_RX	0x11
+#define X2600_DMA_UART1_TX	0x12
+#define X2600_DMA_UART1_RX	0x13
+#define X2600_DMA_UART0_TX	0x14
+#define X2600_DMA_UART0_RX	0x15
+#define X2600_DMA_SSI0_TX	0x16
+#define X2600_DMA_SSI0_RX	0x17
+#define X2600_DMA_SSI1_TX	0x18
+#define X2600_DMA_SSI1_RX	0x19
+#define X2600_DMA_SSISLV_TX	0x1a
+#define X2600_DMA_SSISLV_RX	0x1b
+#define X2600_DMA_CAN0_TX	0x20
+#define X2600_DMA_CAN0_RX	0x21
+#define X2600_DMA_CAN1_TX	0x22
+#define X2600_DMA_CAN1_RX	0x23
+#define X2600_DMA_I2C0_TX	0x24
+#define X2600_DMA_I2C0_RX	0x25
+#define X2600_DMA_I2C1_TX	0x26
+#define X2600_DMA_I2C1_RX	0x27
+#define X2600_DMA_I2C2_TX	0x28
+#define X2600_DMA_I2C2_RX	0x29
+#define X2600_DMA_I2C3_TX	0x2a
+#define X2600_DMA_I2C3_RX	0x2b
+#define X2600_DMA_UART6_TX	0x30
+#define X2600_DMA_UART6_RX	0x31
+#define X2600_DMA_UART7_TX	0x32
+#define X2600_DMA_UART7_RX	0x33
+#define X2600_DMA_AIC_LOOP	0x3d
+#define X2600_DMA_AIC_TX	0x3e
+#define X2600_DMA_AIC_RX	0x3f
+
+#endif /* __DT_BINDINGS_DMA_INGENIC_X2600_DMA_H__ */
