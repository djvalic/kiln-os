From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Mon, 9 Nov 2026 10:04:54 -0700
Subject: [PATCH 59/74] MIPS: dts: ingenic: x2600: Add the display controller
 and LVDS PHY

Describe the display processing unit (DPU) and the Innosilicon MIPI/LVDS
PHY that serves as its LVDS output.
---
 arch/mips/boot/dts/ingenic/x2600.dtsi | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/arch/mips/boot/dts/ingenic/x2600.dtsi b/arch/mips/boot/dts/ingenic/x2600.dtsi
index c9144a00a..f042ecf23 100644
--- a/arch/mips/boot/dts/ingenic/x2600.dtsi
+++ b/arch/mips/boot/dts/ingenic/x2600.dtsi
@@ -275,6 +275,19 @@ gpe: gpio@4 {
 		};
 	};
 
+	dpu: display-controller@13050000 {
+		compatible = "ingenic,x2600-dpu";
+		reg = <0x13050000 0x10000>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <31>;
+
+		clocks = <&cgu X2600_CLK_LCD>;
+		clock-names = "lcd";
+
+		status = "disabled";
+	};
+
 	pdma: dma-controller@13420000 {
 		compatible = "ingenic,x2600-dma", "ingenic,x1830-dma";
 		reg = <0x13420000 0x400>, <0x13421000 0x40>;
@@ -372,6 +385,18 @@ usb: usb@13540000 {
 		status = "disabled";
 	};
 
+	dsi_dphy: phy@10024000 {
+		compatible = "ingenic,x2600-dsi-dphy";
+		reg = <0x10024000 0x1000>;
+
+		clocks = <&exclk>, <&cgu X2600_CLK_DSI>;
+		clock-names = "ref", "pclk";
+
+		#phy-cells = <0>;
+
+		status = "disabled";
+	};
+
 	uart0: serial@10030000 {
 		compatible = "ingenic,x2600-uart", "ingenic,x1000-uart";
 		reg = <0x10030000 0x100>;
-- 
2.43.0

