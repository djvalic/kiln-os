From 3b8f7cd35df19f11736a50687dbd2e65ecd94bf2 Mon Sep 17 00:00:00 2001
From: valix <djvalic.wc@gmail.com>
Date: Wed, 11 Nov 2026 18:42:31 -0500
Subject: [PATCH] MIPS: dts: ingenic: ad5x: Run the eMMC at 50 MHz

Kiln OS's 6.6 kernel runs the eMMC at 50 MHz. 150 MHz in HS200 has
been read and written without errors on one board, but the root and
data filesystems sit on it and a print gains nothing from the speed,
so start where 6.6 is proven and raise it after a longer soak.
---
 arch/mips/boot/dts/ingenic/ad5x.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/mips/boot/dts/ingenic/ad5x.dts b/arch/mips/boot/dts/ingenic/ad5x.dts
index efd466b59..7e4b5ff29 100644
--- a/arch/mips/boot/dts/ingenic/ad5x.dts
+++ b/arch/mips/boot/dts/ingenic/ad5x.dts
@@ -188,7 +188,7 @@ &msc0 {
 	pinctrl-0 = <&pins_mmc0>;
 
 	bus-width = <8>;
-	max-frequency = <150000000>;
+	max-frequency = <50000000>;
 	non-removable;
 	no-sd;
 	no-sdio;
-- 
2.56.0

