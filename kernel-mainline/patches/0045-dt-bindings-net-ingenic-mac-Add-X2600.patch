From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Sun, 8 Nov 2026 19:41:59 -0700
Subject: [PATCH 45/52] dt-bindings: net: ingenic,mac: Add X2600

The X2600's Ethernet MAC is a DWMAC GMAC 3.7 and, like the X1000's, it
only has an RMII interface; the glue driver handles it as an X1000. So
it takes the X1000 compatible, then "snps,dwmac", as fallbacks.
---
 .../devicetree/bindings/net/ingenic,mac.yaml  | 21 ++++++++++++-------
 .../devicetree/bindings/net/snps,dwmac.yaml   |  2 ++
 2 files changed, 15 insertions(+), 8 deletions(-)

diff --git a/Documentation/devicetree/bindings/net/ingenic,mac.yaml b/Documentation/devicetree/bindings/net/ingenic,mac.yaml
index 446184dc6..ede1df992 100644
--- a/Documentation/devicetree/bindings/net/ingenic,mac.yaml
+++ b/Documentation/devicetree/bindings/net/ingenic,mac.yaml
@@ -14,14 +14,19 @@ description:
 
 properties:
   compatible:
-    items:
-      - enum:
-          - ingenic,jz4775-mac
-          - ingenic,x1000-mac
-          - ingenic,x1600-mac
-          - ingenic,x1830-mac
-          - ingenic,x2000-mac
-      - const: snps,dwmac
+    oneOf:
+      - items:
+          - enum:
+              - ingenic,jz4775-mac
+              - ingenic,x1000-mac
+              - ingenic,x1600-mac
+              - ingenic,x1830-mac
+              - ingenic,x2000-mac
+          - const: snps,dwmac
+      - items:
+          - const: ingenic,x2600-mac
+          - const: ingenic,x1000-mac
+          - const: snps,dwmac
 
   reg:
     maxItems: 1
diff --git a/Documentation/devicetree/bindings/net/snps,dwmac.yaml b/Documentation/devicetree/bindings/net/snps,dwmac.yaml
index 2449311c6..9a0799b23 100644
--- a/Documentation/devicetree/bindings/net/snps,dwmac.yaml
+++ b/Documentation/devicetree/bindings/net/snps,dwmac.yaml
@@ -67,6 +67,7 @@ properties:
         - ingenic,x1600-mac
         - ingenic,x1830-mac
         - ingenic,x2000-mac
+        - ingenic,x2600-mac
         - loongson,ls2k-dwmac
         - loongson,ls7a-dwmac
         - nuvoton,ma35d1-dwmac
@@ -629,6 +630,7 @@ allOf:
                 - ingenic,x1600-mac
                 - ingenic,x1830-mac
                 - ingenic,x2000-mac
+                - ingenic,x2600-mac
                 - qcom,qcs404-ethqos
                 - qcom,sa8775p-ethqos
                 - qcom,sc8280xp-ethqos
-- 
