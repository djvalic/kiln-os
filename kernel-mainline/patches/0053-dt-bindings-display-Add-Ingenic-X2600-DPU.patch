From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Mon, 9 Nov 2026 10:04:37 -0700
Subject: [PATCH 53/68] dt-bindings: display: Add Ingenic X2600 DPU

Describe the display processing unit (DPU) of the Ingenic X2600, which
drives a parallel TFT panel or, through the SoC's LVDS PHY, an LVDS
panel.
---
 .../bindings/display/ingenic,x2600-dpu.yaml   | 77 +++++++++++++++++++
 1 file changed, 77 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/ingenic,x2600-dpu.yaml

diff --git a/Documentation/devicetree/bindings/display/ingenic,x2600-dpu.yaml b/Documentation/devicetree/bindings/display/ingenic,x2600-dpu.yaml
new file mode 100644
index 000000000..f8a49c0d0
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/ingenic,x2600-dpu.yaml
@@ -0,0 +1,77 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/ingenic,x2600-dpu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Ingenic X2600 display processing unit (DPU)
+
+maintainers:
+  - Hunter Laux <hunterlaux@gmail.com>
+
+description:
+  The display controller of the Ingenic X2600. It reads framebuffers from
+  memory through a composer or a simple read channel and drives a parallel
+  TFT panel, or an LVDS panel through the SoC's LVDS PHY.
+
+properties:
+  compatible:
+    const: ingenic,x2600-dpu
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: lcd
+
+  phys:
+    maxItems: 1
+    description: The LVDS PHY, for an LVDS panel
+
+  phy-names:
+    const: lvds
+
+  port:
+    $ref: /schemas/graph.yaml#/properties/port
+    description: The display output, to the panel or bridge
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/ingenic,x2600-cgu.h>
+
+    display-controller@13050000 {
+        compatible = "ingenic,x2600-dpu";
+        reg = <0x13050000 0x10000>;
+
+        interrupt-parent = <&intc>;
+        interrupts = <31>;
+
+        clocks = <&cgu X2600_CLK_LCD>;
+        clock-names = "lcd";
+
+        phys = <&dsi_dphy>;
+        phy-names = "lvds";
+
+        port {
+            endpoint {
+                remote-endpoint = <&panel_in>;
+            };
+        };
+    };
+...
-- 
