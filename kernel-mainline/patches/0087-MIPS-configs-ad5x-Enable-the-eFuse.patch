From 330b2d8b60a922cba3527f3e368108d84d814816 Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Tue, 17 Nov 2026 19:15:38 -0700
Subject: [PATCH] MIPS: configs: ad5x: Enable the eFuse

The SoC information in the eFuse tells the X2600 variants apart; enable
the driver so that user space can read it.

Signed-off-by: Hunter Laux <hunterlaux@gmail.com>
---
 arch/mips/configs/ad5x_defconfig | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/mips/configs/ad5x_defconfig b/arch/mips/configs/ad5x_defconfig
index e0301ea6f..e70a323ce 100644
--- a/arch/mips/configs/ad5x_defconfig
+++ b/arch/mips/configs/ad5x_defconfig
@@ -76,6 +76,8 @@ CONFIG_PWM=y
 CONFIG_PWM_INGENIC_X2600=y
 CONFIG_PHY_INGENIC_USB=y
 CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
+CONFIG_NVMEM=y
+CONFIG_NVMEM_JZ4780_EFUSE=y
 CONFIG_EXT4_FS=y
 CONFIG_TMPFS=y
 CONFIG_SQUASHFS=y
-- 
2.43.0

