From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Sun, 8 Nov 2026 16:17:42 -0700
Subject: [PATCH 34/45] MIPS: configs: ad5x: Enable the eMMC

Enable the DesignWare MSHC driver for the eMMC, and ext4 and squashfs
(LZO, XZ), which the printer's partitions use.
---
 arch/mips/configs/ad5x_defconfig | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/mips/configs/ad5x_defconfig b/arch/mips/configs/ad5x_defconfig
index 20b9ff27d..b1e8f927f 100644
--- a/arch/mips/configs/ad5x_defconfig
+++ b/arch/mips/configs/ad5x_defconfig
@@ -32,12 +32,20 @@ CONFIG_GPIO_SYSFS=y
 # CONFIG_HWMON is not set
 # CONFIG_HID is not set
 # CONFIG_USB_SUPPORT is not set
+CONFIG_MMC=y
+CONFIG_MMC_SDHCI=y
+CONFIG_MMC_SDHCI_PLTFM=y
+CONFIG_MMC_SDHCI_OF_DWCMSHC=y
 CONFIG_DMADEVICES=y
 CONFIG_DMA_JZ4780=y
 # CONFIG_INGENIC_TIMER is not set
 CONFIG_INGENIC_X2600_OST=y
 # CONFIG_IOMMU_SUPPORT is not set
+CONFIG_EXT4_FS=y
 CONFIG_TMPFS=y
+CONFIG_SQUASHFS=y
+CONFIG_SQUASHFS_LZO=y
+CONFIG_SQUASHFS_XZ=y
 CONFIG_PRINTK_TIME=y
 CONFIG_CONSOLE_LOGLEVEL_DEFAULT=15
 CONFIG_MESSAGE_LOGLEVEL_DEFAULT=7
