From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Sun, 8 Nov 2026 19:48:47 -0700
Subject: [PATCH 08/68] dt-bindings: net: ingenic,mac: Describe the MAC as a
 DWMAC

The MAC is a Synopsys DWMAC GMAC, and the binding did not say so:

  - The DTs list "snps,dwmac" after the SoC's compatible, which is what
    makes the stmmac driver treat the core as a GMAC rather than a
    10/100 MAC100, but the binding rejected it.
  - A board describes its PHY connection with the common DWMAC
    properties (phy-mode, phy-handle, the mdio node), but the binding
    rejected every property it does not list itself.

Require the "snps,dwmac" fallback and reference the DWMAC binding, as
the other glue bindings do.
---
 .../devicetree/bindings/net/ingenic,mac.yaml  | 23 ++++++++++++-------
 1 file changed, 15 insertions(+), 8 deletions(-)

diff --git a/Documentation/devicetree/bindings/net/ingenic,mac.yaml b/Documentation/devicetree/bindings/net/ingenic,mac.yaml
index bdea101c2..446184dc6 100644
--- a/Documentation/devicetree/bindings/net/ingenic,mac.yaml
+++ b/Documentation/devicetree/bindings/net/ingenic,mac.yaml
@@ -14,12 +14,14 @@ description:
 
 properties:
   compatible:
-    enum:
-      - ingenic,jz4775-mac
-      - ingenic,x1000-mac
-      - ingenic,x1600-mac
-      - ingenic,x1830-mac
-      - ingenic,x2000-mac
+    items:
+      - enum:
+          - ingenic,jz4775-mac
+          - ingenic,x1000-mac
+          - ingenic,x1600-mac
+          - ingenic,x1830-mac
+          - ingenic,x2000-mac
+      - const: snps,dwmac
 
   reg:
     maxItems: 1
@@ -55,14 +57,17 @@ required:
   - clock-names
   - mode-reg
 
-additionalProperties: false
+allOf:
+  - $ref: snps,dwmac.yaml#
+
+unevaluatedProperties: false
 
 examples:
   - |
     #include <dt-bindings/clock/ingenic,x1000-cgu.h>
 
     mac: ethernet@134b0000 {
-        compatible = "ingenic,x1000-mac";
+        compatible = "ingenic,x1000-mac", "snps,dwmac";
         reg = <0x134b0000 0x2000>;
 
         interrupt-parent = <&intc>;
@@ -73,5 +78,7 @@ examples:
         clock-names = "stmmaceth";
 
         mode-reg = <&mac_phy_ctrl>;
+
+        phy-mode = "rmii";
     };
 ...
