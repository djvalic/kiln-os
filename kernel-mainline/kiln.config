# Kiln OS userspace on the mainline kernel: merged onto ad5x_defconfig
# (kernel-mainline/build.sh). What Kiln's root filesystem expects of a
# kernel, as in kernel-ingenic66/ad5x.config; the series' defconfig stays
# a plain board defconfig.

# The root filesystem has no modules: Wi-Fi built in, with its firmware
# and cfg80211's regulatory database (asked for before the root is
# mounted). build.sh sets EXTRA_FIRMWARE_DIR.
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RTW88=y
CONFIG_RTW88_8821CU=y
CONFIG_EXTRA_FIRMWARE="rtw88/rtw8821c_fw.bin regulatory.db regulatory.db.p7s"

# Webcams (ad5x-camera, ustreamer), USB serial adapters and sticks
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# The root filesystem: squashfs pages read straight into the page cache
# and one decompressor per CPU, as on 6.6 (the defaults copy through a
# cache and decompress on one CPU at a time)
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU=y

# zram swap, contiguous memory for camera buffers
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=16

# HelixScreen (display and touch come with ad5x_defconfig)
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y

# S07ad5x-board's heartbeat LED (/sys/class/gpio/export)
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_SYSFS_LEGACY=y

# A fixed release string: S00ad5x-kernel records failures by release, so
# it must not change from build to build (LOCALVERSION_AUTO would add the
# commit of the git am in build.sh, which is new every build).
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION="-ad5x"

# Wi-Fi off powers the radio down (S42ad5x-wifi, HelixScreen: rfkill)
CONFIG_RFKILL=y

# The kernel log of a crash, from the ramoops region in ad5x.dts
# (S05ad5x-data mounts /sys/fs/pstore and keeps it; issue #29)
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y

# A hang reboots and leaves its log (pstore) instead of waiting for a
# power cycle; as 6.6 (PANIC_TIMEOUT=10 comes with the defconfig). A task
# stuck in the kernel only warns.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_WQ_WATCHDOG=y

# The userspace is o32 FP64: without this doubles come out wrong (the
# defconfig has it; kept here so it can't go missing)
CONFIG_MIPS_O32_FP64_SUPPORT=y

# Console messages as on 6.6
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
