# Flashforge AD5X, first image: our userspace on the stock kernel.
# See buildroot/README.md. Build: make -C buildroot/src O=$PWD/buildroot/output \
#   BR2_EXTERNAL=$PWD/buildroot ad5x_defconfig all

# Ingenic X2600 (XBurst2, MIPS32r5), hard float with a 64-bit FPU, NaN2008:
# the ABI the stock kernel and its modules were built for.
BR2_mipsel=y
BR2_mips_32r5=y
# BR2_MIPS_SOFT_FLOAT is not set
BR2_MIPS_FP32_MODE_64=y
BR2_MIPS_ENABLE_NAN_2008=y

# Toolchain: glibc, headers for the stock 5.10 kernel
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_5_10=y

BR2_DL_DIR="$(BR2_EXTERNAL_AD5X_PATH)/dl"

# System. The stock kernel has no cgroups, so no systemd: BusyBox init and
# mdev, like stock.
BR2_TARGET_GENERIC_HOSTNAME="ad5x"
BR2_TARGET_GENERIC_ISSUE="Kiln OS"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
# squashfs root: read-only
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# Serial login on the debug console, ttyS0 (stock: console=ttyS0,115200n8).
# The other UARTs belong to boards: ttyS2 mainboard MCU, ttyS4 IFS, ttyS5
# eboard, ttyS7 weighing board.
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
# eth0 is set up by S41ad5x-eth (stock MAC, DHCP)
BR2_TARGET_TZ_INFO=y
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_AD5X_PATH)/board/ad5x/users.table"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_AD5X_PATH)/board/ad5x/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_AD5X_PATH)/board/ad5x/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_AD5X_PATH)/board/ad5x/post-image.sh"

# No kernel or bootloader built yet: the stock ones are used
# (post-image.sh copies the stock kernel from the local firmware download).

# Python for Klipper
BR2_PACKAGE_PYTHON3=y
# Bytecode only (room in the 100 MiB slot; board/ad5x/post-build.sh)
BR2_PACKAGE_PYTHON3_PYC_ONLY=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON_CFFI=y
BR2_PACKAGE_PYTHON_GREENLET=y
BR2_PACKAGE_PYTHON_JINJA2=y
BR2_PACKAGE_PYTHON_MARKUPSAFE=y
BR2_PACKAGE_PYTHON_SERIAL=y
BR2_PACKAGE_PYTHON_CAN=y

# Network and access
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_CHRONY=y
BR2_PACKAGE_E2FSPROGS=y
# HTTPS (Moonraker announcements, HelixScreen)
BR2_PACKAGE_CA_CERTIFICATES=y
# ip -json, for Moonraker's network status
BR2_PACKAGE_IPROUTE2=y
# sudo, for one thing: Moonraker's host reboot runs "sudo reboot" as klipper;
# /etc/sudoers (rootfs overlay) allows that and nothing else
BR2_PACKAGE_SUDO=y
# git over https: plugins from their own repositories (docs/plugins.md),
# cloned and kept up to date by Moonraker's update manager. Trimmed in
# post-build.sh.
BR2_PACKAGE_GIT=y
BR2_PACKAGE_LIBCURL=y

# This project
BR2_PACKAGE_KLIPPER=y
BR2_PACKAGE_MOONRAKER=y
# Fluidd on port 80 through nginx (S63nginx, board/ad5x/rootfs-overlay/etc/nginx)
BR2_PACKAGE_FLUIDD=y
# Only static files and the proxy: no PCRE, FastCGI, uWSGI, SCGI
# BR2_PACKAGE_NGINX_HTTP_REWRITE_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_FASTCGI_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_UWSGI_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_SCGI_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_MEMCACHED_MODULE is not set
# Touch screen UI on the panel (S70helixscreen, gated on
# /data/ad5x/helixscreen.enable)
BR2_PACKAGE_HELIXSCREEN=y
BR2_PACKAGE_AD5X_SYSTEM=y

# Images: squashfs with LZO (what the stock kernel reads), plus a tarball
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZO=y
BR2_TARGET_ROOTFS_TAR=y
# ext4 copy for the USB test stick (usb-test.img, see post-image.sh)
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="AD5XROOT"
BR2_TARGET_ROOTFS_EXT2_SIZE="768M"
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_PYTHON_NUMPY=y
BR2_PACKAGE_USTREAMER=y
BR2_PACKAGE_AD5X_KERNEL66=y
