# Flashforge AD5X recovery/update OS for slot A (kernel p1 + rootfs p2).
# The main OS lives in slot B. See docs/recovery-os.md. Build:
#   make -C buildroot/src O=$PWD/buildroot/output-recovery \
#     BR2_EXTERNAL=$PWD/buildroot ad5x_recovery_defconfig all

# Same ABI as ad5x_defconfig (the stock kernel's): MIPS32r5, FP64, NaN2008
BR2_mipsel=y
BR2_mips_32r5=y
# BR2_MIPS_SOFT_FLOAT is not set
BR2_MIPS_FP32_MODE_64=y
BR2_MIPS_ENABLE_NAN_2008=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_5_10=y

BR2_DL_DIR="$(BR2_EXTERNAL_AD5X_PATH)/dl"

# System: BusyBox init, eudev, read-only squashfs root, as the main OS
BR2_TARGET_GENERIC_HOSTNAME="ad5x-recovery"
BR2_TARGET_GENERIC_ISSUE="Kiln OS recovery"
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_AD5X_PATH)/board/ad5x-recovery/busybox.fragment"
# eudev (NetworkManager needs udev): /etc/init.d/S10udevd, no hardware
# database (vendor names, nothing here reads them)
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
# BR2_PACKAGE_EUDEV_ENABLE_HWDB is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_AD5X_PATH)/board/ad5x-recovery/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_AD5X_PATH)/board/ad5x-recovery/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_AD5X_PATH)/board/ad5x-recovery/post-image.sh"
# Keep it small
# BR2_PACKAGE_URANDOM_SCRIPTS is not set
BR2_ENABLE_LOCALE_PURGE=y
BR2_STRIP_strip=y

# Network and access (NetworkManager, connections on /data: docs/networkmanager.md)
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y
# NetworkManager runs the network (docs/networkmanager.md): Ethernet and
# Wi-Fi, DHCP (its internal client), nmcli for HelixScreen and ad5x-status
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_NETWORK_MANAGER_CLI=y

# Filesystems on sticks and userdata (fsck, mkfs)
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y

# SWUpdate: signed .swu (RSA, mbedTLS), raw + shell script handlers,
# embedded web server (mongoose, port 8080), progress socket
BR2_PACKAGE_SWUPDATE=y
BR2_PACKAGE_SWUPDATE_CONFIG="$(BR2_EXTERNAL_AD5X_PATH)/package/ad5x-recovery/swupdate/swupdate.config"
BR2_PACKAGE_SWUPDATE_WEBSERVER=y
BR2_PACKAGE_SWUPDATE_INSTALL_WEBSITE=y
BR2_PACKAGE_MBEDTLS=y
BR2_PACKAGE_LIBCONFIG=y

BR2_PACKAGE_AD5X_RECOVERY=y
# Touch UI (recovery-ui/, started by S80ad5x-recovery-ui)
BR2_PACKAGE_AD5X_RECOVERY_UI=y

# Image: LZO squashfs (what the stock kernel reads), tarball for qemu tests
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZO=y
BR2_TARGET_ROOTFS_TAR=y
BR2_REPRODUCIBLE=y
