#!/bin/sh
#
# Start all init scripts in /etc/init.d in numerical order (Buildroot's
# rcS). Installed (slot A or B) it also keeps a boot trace (ad5x-bootlog): each
# script's start and end, and a tick every 2 s for the first 3 minutes, in
# the ota partition at 64 KiB, readable from stock with:
#   dd if=/dev/mmcblk0p5 bs=1024 skip=64 count=8 | tr -d '\0'
# The start/end lines only go to /run/ad5x-boot.log (no fork, no eMMC
# write: ad5x-bootlog's copy and sync cost ~0.13 s each, ~8 s a boot); each
# tick and "rcS done" copy the whole trace to the ota partition, so a hang
# loses at most the last 2 s of lines.
#

# The services' files are readable by klipper and www-data (issue #31):
# the kernel's 022, stated here. Kiln's own scripts set it too, for a
# restart from a root SSH session with another umask.
umask 022

: > /run/ad5x-boot.log 2>/dev/null
trace() { read -r up _ < /proc/uptime; echo "$up $*" >> /run/ad5x-boot.log; }
ad5x-bootlog "rcS start $(cat /etc/ad5x-release 2>/dev/null)"
if . /usr/lib/ad5x/slot.sh && [ -n "$SLOT" ]; then
	( n=0; while [ $n -lt 90 ]; do sleep 2; ad5x-bootlog tick; n=$((n + 1)); done ) &
fi

for i in /etc/init.d/S??*; do

	# Ignore dangling symlinks (if any).
	[ ! -f "$i" ] && continue

	trace "start ${i##*/}"
	case "$i" in
		*.sh)
			# Source shell script for speed.
			(
				trap - INT QUIT TSTP
				set start
				# shellcheck source=/dev/null
				. "$i"
			)
			;;
		*)
			# No sh extension, so fork subprocess.
			"$i" start
			;;
	esac
	trace "end ${i##*/} rc=$?"
done
ad5x-bootlog "rcS done"
