# Main OS BusyBox additions (on top of Buildroot's default config)
# ionice: the timelapse plugin zips and renders at idle I/O priority, so
# its eMMC writes don't starve Klipper (issue #40; mq-deadline honours it)
CONFIG_IONICE=y
# swapon -p: S04ad5x-memory's zram swap on 256 MiB boards (priority 100)
CONFIG_FEATURE_SWAPON_PRI=y
# No crond or crontab: Kiln OS schedules nothing with cron (S51ad5x-clock
# saves the time itself), so S50crond isn't installed and its idle daemon
# doesn't run (docs/memory.md)
# CONFIG_CROND is not set
# CONFIG_CRONTAB is not set
# inotifyd: S40ad5x-network writes the Wi-Fi networks NetworkManager saves
# back to /data/ad5x/wpa_supplicant.conf as soon as it saves them
# (docs/network.md)
CONFIG_INOTIFYD=y
# mkpasswd with SHA-512: ad5x-passwd hashes root's password with it
# (Buildroot's default config has these; kept here so they stay)
CONFIG_MKPASSWD=y
CONFIG_USE_BB_CRYPT=y
CONFIG_USE_BB_CRYPT_SHA=y
# Passwords and hashes pass only through the shell's builtins (printf,
# echo, test), awk's environment and pipes, never a command line that
# other users can read in /proc (lib/rootpw.sh, ad5x-passwd); flock
# keeps two password changes apart
CONFIG_ASH_PRINTF=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_TEST=y
CONFIG_AWK=y
CONFIG_FLOCK=y
