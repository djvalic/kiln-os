#
# SWUpdate for A/B updates in the main OS (lib/ab.sh, docs/ab-updates.md).
# Options not listed take SWUpdate's defaults (Buildroot runs olddefconfig).
#
# - U-Boot's environment through libubootenv (/etc/fw_env.config): the
#   sw-description's bootenv sets kiln_slot, upgrade_available and
#   bootcount in one write; SWUpdate's own markers recovery_status (the
#   install running) and ustate (1 installed; Kiln's U-Boot sets 3 when it
#   goes back) live there too (u-boot patch 0051).
# - Handlers: raw (the slot's rootfs), shell scripts (ad5x-ab.sh: checks
#   before, read-back and the slot's kernel partition after) and the
#   bootloader handler, which sw-description's bootenv needs.
# - Unsigned, as the recovery OS's default: every artifact carries a sha256
#   that SWUpdate checks (HASH_VERIFY).
# - Hardware check: sw-description "hardware-compatibility" against
#   /etc/hwrevision ("ad5x 1.0").
# - No web server, no daemon: ad5x-update runs swupdate once.
#
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_DEFAULT_CONFIG_FILE="/etc/swupdate.cfg"
CONFIG_SCRIPTS=y
CONFIG_HW_COMPATIBILITY=y
CONFIG_HW_COMPATIBILITY_FILE="/etc/hwrevision"
CONFIG_SW_VERSIONS_FILE="/etc/sw-versions"
# CONFIG_MTD is not set
# CONFIG_LUA is not set
CONFIG_CROSS_COMPILE=""
CONFIG_SYSROOT=""
CONFIG_EXTRA_CFLAGS=""
CONFIG_EXTRA_LDFLAGS=""
CONFIG_EXTRA_LDLIBS=""
CONFIG_UBOOT=y
CONFIG_UBOOT_FWENV="/etc/fw_env.config"
CONFIG_BOOTLOADER_DEFAULT_UBOOT=y
CONFIG_UPDATE_STATE_CHOICE_BOOTLOADER=y
CONFIG_UPDATE_STATE_BOOTLOADER="ustate"
CONFIG_SSL_IMPL_MBEDTLS=y
CONFIG_HASH_VERIFY=y
# CONFIG_SIGNED_IMAGES is not set
# CONFIG_ENCRYPTED_IMAGES is not set
# CONFIG_WEBSERVER is not set
CONFIG_LIBCONFIG=y
CONFIG_PARSERROOT=""
CONFIG_RAW=y
CONFIG_SHELLSCRIPTHANDLER=y
# CONFIG_ARCHIVE is not set
# CONFIG_DISKPART is not set
# CONFIG_DISKFORMAT_HANDLER is not set
CONFIG_BOOTLOADERHANDLER=y
# CONFIG_SURICATTA is not set
# CONFIG_DOWNLOAD is not set
