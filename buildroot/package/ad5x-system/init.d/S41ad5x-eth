#!/bin/sh
# Wired network: the MAC stock assigns (usershare /MAC, stock /usr/prog/MAC),
# then DHCP or a static address from /data/ad5x/network.conf (see
# /usr/lib/ad5x/network.sh). In USB test mode stock has already done this.

# Files this creates are readable by klipper and www-data, whoever started
# it (a root SSH session may run with umask 077; issue #31)
umask 022

case "$1" in
start)
	[ -n "$AD5X_USB" ] && exit 0
	for u in /sys/class/block/*/uevent; do
		grep -qx "PARTNAME=usershare" "$u" 2>/dev/null || continue
		dev=/dev/$(sed -n 's/^DEVNAME=//p' "$u")
		mkdir -p /tmp/usershare
		if mount -t ext4 -o ro "$dev" /tmp/usershare; then
			mac=$(cat /tmp/usershare/MAC 2>/dev/null)
			umount /tmp/usershare
		fi
	done
	# A route through a port whose cable is out is ignored. Without this, unplugging
	# Ethernet leaves its subnet route first in the table and the Wi-Fi replies go
	# out the dead port (issue #8: Wi-Fi unreachable until a reboot). Set before the
	# link comes up so Wi-Fi (S42) inherits it too.
	echo 1 > /proc/sys/net/ipv4/conf/default/ignore_routes_with_linkdown 2>/dev/null
	echo 1 > /proc/sys/net/ipv4/conf/all/ignore_routes_with_linkdown 2>/dev/null
	ifconfig eth0 down
	[ -n "$mac" ] && ifconfig eth0 hw ether "$mac"
	ifconfig eth0 up
	. /usr/lib/ad5x/network.sh
	net_up eth0
	;;
stop)
	[ -f /var/run/udhcpc.eth0.pid ] && kill "$(cat /var/run/udhcpc.eth0.pid)"
	;;
esac
exit 0
