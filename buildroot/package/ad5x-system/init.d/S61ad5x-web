#!/bin/sh
# The web interface on port 80 (docs/web-interface.md): Fluidd, or
# Mainsail once the owner picked it (ad5x-webui; /data/ad5x/webui). Each
# is served from a copy Moonraker can update (moonraker-updates.conf,
# components/kiln_os.py) in /data/ad5x/web/NAME, made when it is missing,
# broken or older than the image's (so a Kiln OS update never brings an
# older UI back). Fluidd's copy is kept up to date whichever is chosen,
# as before Mainsail was in; Mainsail's once it is chosen. Before
# Moonraker (S62), which checks the copies at its start; nginx (S63)
# serves the chosen one (/run/nginx/fluidd-root.conf; its service worker
# cookie maps in /run/nginx/webui-map.conf), or the image's own files if
# there is no copy. Without a valid choice: Fluidd, exactly as
# before.
# Back to the image's version: delete /data/ad5x/web/NAME and reboot.
# The code is in /usr/lib/ad5x/webui.sh (AD5X_LIB overrides /usr/lib/ad5x).

# Files this creates are readable by klipper and www-data, whoever started
# it (a root SSH session may run with umask 077; issue #31)
umask 022

. ${AD5X_LIB:-/usr/lib/ad5x}/webui.sh

case "$1" in
start)
	[ -f "$(webui_image fluidd)/index.html" ] || exit 0
	webui_copy fluidd
	ui=$(webui_choice)
	if [ $ui != fluidd ] && ! webui_copy $ui && \
			[ ! -f "$(webui_image $ui)/index.html" ]; then
		ui=fluidd
	fi
	[ $ui = fluidd ] || echo "web: $(webui_title $ui) on port 80 ($WEBUI_CHOICE)"
	webui_root_conf $ui
	webui_map_conf $ui
	;;
esac
exit 0
