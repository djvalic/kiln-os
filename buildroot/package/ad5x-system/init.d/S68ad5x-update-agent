#!/bin/sh
# Installs updates that Moonraker downloaded (components/kiln_os.py,
# docs/updates.md). Moonraker runs as klipper and can't stage an update,
# restart services or reboot; it puts the checked file in
# /data/ad5x/kiln-update and writes "install" (file name, sha256). This
# root loop picks it up and refuses while a print runs:
#   kiln-os-*-update.zip     staged with ad5x-update (boot flag on the
#                            recovery OS), reboot; the recovery installs it
#   klipper-*.tar.gz,        daily package: unpacked into /data/ad5x/apps/
#   moonraker-*.tar.gz       NAME (lib/apps.sh), service restarted
# Result for Moonraker in "status", log in /data/ad5x/kiln-log/agent.log.
# Also: "restart-moonraker" (written by Klipper's ad5x_plugins when a
# plugin switch changes what Moonraker loads): Moonraker is restarted, so it
# reads the plugins' parts again (not while printing).
# Also: "kernel-retry" (POST /machine/kiln_os/kernel_retry, issue #42): runs
# "ad5x-kernel retry" (our kernel is tried again from the next boot) and
# reboots; status "rebooting", or "refused: ..." while a print runs or
# before start-up has finished (the boot flag still on the other slot, see
# S01ad5x-tryboot: a reboot then would start the recovery OS).
# Also: "boot-recovery" (POST /machine/kiln_os/boot_recovery, issue #47):
# runs "ad5x-boot-recovery --no-reboot" (boot flag on the recovery OS in
# slot A) and reboots; refused as kernel-retry is. The recovery OS then
# installs what is waiting (an update zip on a stick with ad5x-autoupdate,
# docs/updates.md) or shows its touch UI.
# Also: "return-stock" (POST /machine/kiln_os/return_stock, HelixScreen's
# Return to Flashforge firmware): the same with "ad5x-boot-recovery
# --no-reboot --return-stock", so the recovery OS opens Return to
# Flashforge firmware, which writes nothing before a tap there.
# Also: "plugin-request" (written by Klipper's ad5x_plugins): a plugin's
# root script (root/install.sh, update.sh, uninstall.sh) from the packed
# root/ folder next to it, answered in "plugin-status"; refused as the
# installs are while a print may run. The code is in
# /usr/lib/ad5x/plugin-root.sh (docs/plugin-root-hooks.md), the log in
# kiln-log/plugins-root.log. This loop does one thing at a time, so a
# plugin's script never overlaps an update install.
# Also: "service" (Fluidd's service buttons through Moonraker's kiln_agent
# provider, components/kiln_os.py): "ACTION NAME", see service_request.
# Also: "reboot" and "shutdown" (Moonraker's /machine/reboot and
# /machine/shutdown through the same provider: Fluidd's and the touch
# screen's Reboot and Shutdown): see power_request.
# Also: "memory-mode" (POST /machine/kiln_os/memory, the KILN_MEMORY_MODE
# macro; docs/memory.md): "on" or "off", runs "ad5x-memory extended on|off",
# see memory_request. Allowed while printing: it only writes the switch.
# Also: "webui" (POST /machine/kiln_os/webui; docs/web-interface.md):
# "fluidd" or "mainsail", runs "ad5x-webui --no-sync NAME" (the choice in
# /data/ad5x/webui, nginx reloaded), see webui_request. Allowed while
# printing and while the IFS firmware is switched: only the web page
# changes, a print and Klipper are not touched.
# Also: "ifs-firmware" (POST /machine/kiln_os/ifs_firmware; docs/
# mcu-flashing.md, "IFS firmware switch"): "stock" or "klipper". Checked
# here (owner opt-in for klipper, not while a print may run or the
# printer is busy, one switch at a time), answered "done: switching ..."
# at once, then run as a background job ("ifs-job": Klipper stopped,
# ad5x-mcu flash-ifs, Klipper started again whatever came out), so this
# loop keeps answering. Its progress and result are in $IFS_STATUS
# (root's folder, read by Moonraker). While it runs, requests that would
# restart Klipper, reboot or power off the printer, install an update or
# run a plugin's root script are refused at once ("the IFS firmware is
# being switched"); memory-mode still goes through.
# Also, from the touch screen only: "root-password-default" in $SCREQ, a
# folder of root's (0700) in /run, so no request survives a restart and
# Moonraker, Klipper and plugins (user klipper) can't make one. HelixScreen
# runs as root and writes it after a 5 s hold of its reset button: root's
# password becomes "root" (ad5x-passwd --default), answered in
# root-password-default.status beside it; see screen_password_request.
# root-password-reset.state there says "locked" or "unlocked" (the owner's
# ad5x-passwd --lock-reset, over SSH), kept up to date each round, so the
# screen can grey the button. These run in a loop of their own ("screen",
# every second, pid $SPID), so nothing the main loop does (hashing a big
# download, a plugin's root script, a slow Moonraker) delays them.
# A Kiln OS update is also refused before start-up has finished: the
# reboot would leave our kernel's start marker behind, which counts as an
# unfinished start of it (issue #47). And while the recovery OS is being
# written into slot A (S99ad5x-update-recovery, after an update of the main
# OS): refused at once, so Moonraker's answer says what happens (ad5x-update
# would wait up to 3 minutes for the write, longer than Moonraker waits).
# Refused too when slot A doesn't hold the recovery OS or a whole kernel
# (ad5x-update's exit code 4, its reason passed on).
# Installs, kernel-retry and boot-recovery are refused while a print may run: Moonraker
# gives no answer at all, or Klipper is ready and its print state is
# printing, paused or unknown. A Klipper that is not ready (startup,
# shutdown, error, disconnected) can't be printing: allowed, so a printer
# with a broken Klipper can still be updated.
# The request and the file it names are klipper's: before root reads,
# hashes or unpacks them, each is moved into a new root-only folder in
# $STAGE and used only when it is a plain file there (regular, not a link,
# one name), so a link or a FIFO klipper puts in $D can't make root read
# another file or wait forever. Only checked names reach the log.
# The answers go the other way, into klipper's folder: the status is
# written in $STAGE and renamed over $D/status (a rename replaces a link or
# a FIFO klipper put there instead of writing through it), and the log is
# in a folder of root's, $LOGD, that klipper can only read.
# "S68ad5x-update-agent once": one round of the loop (tests); "screen-once":
# one round of the screen requests' loop; AD5X_LIB
# overrides /usr/lib/ad5x (tools/test_kernel_fallback.sh), AD5X_DATA /data
# (tools/test_update_agent_links.sh).

# Files this creates are readable by klipper and www-data, whoever started
# it (a root SSH session may run with umask 077; issue #31)
umask 022

D=${AD5X_DATA:-/data}/ad5x/kiln-update
PID=/run/ad5x-update-agent.pid
# Root's (0755): klipper reads the log, can't replace it
LOGD=${AD5X_DATA:-/data}/ad5x/kiln-log
LOG=$LOGD/agent.log
# Root-only (0700), on the same file system as $D (a move is a rename)
STAGE=${AD5X_DATA:-/data}/ad5x/kiln-stage
. ${AD5X_LIB:-/usr/lib/ad5x}/apps.sh
. ${AD5X_LIB:-/usr/lib/ad5x}/slot.sh
# Root's password (screen_password_request: the owner's lock on the
# screen's reset); without the file the reset counts as locked
if [ -f ${AD5X_LIB:-/usr/lib/ad5x}/rootpw.sh ]; then
	. ${AD5X_LIB:-/usr/lib/ad5x}/rootpw.sh
else
	rootpw_reset_locked() { return 0; }
	rootpw_reset_unlock() { return 1; }
fi
# The plugins' root scripts (plugin_request, pr_setup)
[ -f ${AD5X_LIB:-/usr/lib/ad5x}/plugin-root.sh ] && . ${AD5X_LIB:-/usr/lib/ad5x}/plugin-root.sh
# The IFS firmware switch (ifs_request, ifs_job): its status in a folder of
# root's that klipper can only read (Moonraker serves it), the running
# job's pid, the owner's opt-in (/data/ad5x is root's: no client can make
# it), Klipper's init script and the image's IFS firmware
IFSD=${AD5X_DATA:-/data}/ad5x/kiln-status
IFS_STATUS=$IFSD/ifs-firmware
IFS_PID=${AD5X_IFS_PID:-/run/ad5x-ifs-switch.pid}
IFS_OPTIN=${AD5X_DATA:-/data}/ad5x/ifs-switch.enable
IFS_KLIPPER=${AD5X_DATA:-/data}/ad5x/ifs-klipper.enable
KINIT=${AD5X_INITD:-/etc/init.d}/S61klipper
IFS_HEX=${AD5X_MCU_FW:-/usr/share/ad5x/mcu}/ifs.hex

# The touch screen's root-only requests (screen_password_request), and
# ad5x-fbstream's record of touches from a browser (S65ad5x-screen)
# (under the test's data folder when AD5X_DATA is set)
RUND=${AD5X_DATA:+$AD5X_DATA/run/ad5x}
RUND=${RUND:-/run/ad5x}
SCREQ=${AD5X_SCREEN_REQ:-$RUND/screen-request}
RTOUCH=${AD5X_REMOTE_TOUCH:-$RUND/remote-touch}
SCREEN_PID=${AD5X_SCREEN_PID:-/run/ad5x-screen.pid}
# The screen requests' own loop
SPID=/run/ad5x-update-agent-screen.pid
# A browser touch this long before the press (seconds) or later refuses
# the reset: more than the screen's 5 s hold
REMOTE_TOUCH_WINDOW=30
# A request whose press is older than this (seconds) is refused: the
# screen gave up on it, or it waited behind something
REQUEST_MAX_AGE=10
# Whether the owner's lock (ad5x-passwd --lock-reset) also stops
# HelixScreen's factory reset from setting root's password: no (the
# owner's choice) = a factory reset always sets it to "root" and removes
# the lock, so whoever locked themselves out has a way back, at the cost
# of the screen's settings; yes = it leaves the password and the lock
# alone while locked (the rest of the factory reset still happens). The
# one place for this choice. The button always honours the lock.
FACTORY_RESET_HONOURS_LOCK=no
# root's uid (the laptop test runs this as a normal user)
ROOT_UID=${AD5X_TEST_ROOT_UID:-0}

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> $LOG; }

# The file say writes in $D: Moonraker's "status"; a plugin request answers
# Klipper in "plugin-status" instead (lib/plugin-root.sh)
ANSWER=status

# say TEXT: the status Moonraker waits for, renamed into place from $STAGE
say() {
	local t
	mkdir -p $STAGE && chmod 700 $STAGE && t=$(mktemp $STAGE/s.XXXXXX) || return 1
	if [ -d $D/$ANSWER ] && [ ! -L $D/$ANSWER ]; then
		rm -f "$t"; log "no status written: $D/$ANSWER is a folder"; return 1
	fi
	# -T: never into a folder klipper links there (BusyBox refuses, GNU
	# replaces the link). The name is removed first (unlink never follows a
	# link), so a link to a folder doesn't keep the answer from Moonraker.
	rm -f $D/$ANSWER 2>/dev/null
	printf '%s\n' "$*" > "$t" && chmod 644 "$t" && mv -T -f "$t" $D/$ANSWER && return 0
	rm -f "$t"; log "no status written: $D/$ANSWER is not a file"; return 1
}

# S99ad5x-booted has pointed the boot flag back at this slot and made its
# marker (lib/slot.sh, start_done); no slot (USB test mode): yes
started_up() { [ -z "$SLOT" ] || start_done; }

# The recovery OS is being written into slot A (ad5x-update's lock)
WLOCK=${AD5X_RECOVERY_WLOCK:-/run/ad5x-recovery-write.pid}
writing() { [ -f $WLOCK ] && kill -0 "$(cat $WLOCK)" 2>/dev/null; }

# How long after boot a reboot or shutdown waits for start-up to finish
# (power_request): a start that takes longer has hung somewhere, and
# rebooting it (into the recovery OS, the boot flag still points there) is
# what the user then needs. A normal start finishes in 1-2 minutes.
POWER_GRACE=600

# uptime: whole seconds since boot
uptime_s() { cut -d. -f1 /proc/uptime; }

# Klipper's print_stats state through Moonraker; empty without an answer
print_state() {
	wget -q -T 5 -O- 'http://127.0.0.1:7125/printer/objects/query?print_stats=state' \
		2>/dev/null | sed -n 's/.*"state": *"\([a-z_]*\)".*/\1/p' | head -n 1
}

printing() { case "$(print_state)" in printing|paused) return 0 ;; esac; return 1; }

# Klipper's idle_timeout state (Idle, Ready, Printing) through Moonraker;
# empty without an answer. Printing also while a command typed in the
# console runs (a filament load), not only during a print.
idle_state() {
	wget -q -T 5 -O- 'http://127.0.0.1:7125/printer/objects/query?idle_timeout=state' \
		2>/dev/null | sed -n 's/.*"state": *"\([A-Za-z_]*\)".*/\1/p' | head -n 1
}

# Moonraker's klippy_state (ready, startup, shutdown, error, disconnected);
# empty when Moonraker gives no answer
klippy_state() {
	wget -q -T 5 -O- 'http://127.0.0.1:7125/server/info' 2>/dev/null |
		sed -n 's/.*"klippy_state": *"\([a-z_]*\)".*/\1/p' | head -n 1
}

# busy WHAT: true (and the refusal in status) while a print may run
busy() {
	ks=$(klippy_state)
	case "$ks" in
	'')
		log "$1 refused: no answer from Moonraker"
		say "refused: no answer from Moonraker"
		return 0 ;;
	ready) ;;
	*) return 1 ;;	# Klipper not ready: no print can run
	esac
	st=$(print_state)
	case "$st" in
	standby|complete|cancelled|error) return 1 ;;
	printing|paused)
		log "$1 refused: printing"
		say "refused: a print is running" ;;
	*)
		log "$1 refused: print state unknown (${st:-no answer})"
		say "refused: the print state is unknown, try again" ;;
	esac
	return 0
}

# plain FILE: a regular file, not a link, with one name (this kernel lets
# klipper hard-link root's files: fs.protected_hardlinks is 0)
plain() {
	[ -f "$1" ] && [ ! -L "$1" ] && [ "$(ls -ldn "$1" | awk '{print $2}')" = 1 ]
}

# stage NAME: move $D/NAME into a new root-only folder in $STAGE (a rename:
# a link or FIFO moves as it is, nothing is opened) and print its new path
# when it is a plain file there; anything else is removed (a folder is
# left in $STAGE: root never removes klipper's folders recursively)
stage() {
	local t
	mkdir -p $STAGE && chmod 700 $STAGE && t=$(mktemp -d $STAGE/r.XXXXXX) || return 1
	if mv "$D/$1" "$t/" 2>/dev/null && plain "$t/$1"; then
		echo "$t/$1"; return 0
	fi
	[ -d "$t/$1" ] && [ ! -L "$t/$1" ] || { rm -f "$t/$1"; rmdir "$t"; }
	return 1
}

# unstage PATH: remove a staged file and its folder
unstage() { rm -f "$1"; rmdir "${1%/*}" 2>/dev/null; return 0; }

# good_name NAME: one plain file name (letters, digits, . _ + -), not
# starting with a dot or a dash; good_sum SUM: sha256 hex digits
good_name() {
	case $1 in ''|.*|-*|*[!A-Za-z0-9._+-]*) return 1 ;; esac
	[ ${#1} -le 128 ]
}
good_sum() {
	case $1 in ''|*[!0-9a-f]*) return 1 ;; esac
	[ ${#1} -le 64 ]
}

# own_links DIR: every regular file in DIR with more than one name has all
# of them in DIR (no hard link to a file outside it)
own_links() {
	find "$1" -type f -exec ls -ldin {} + |
		awk '$3 > 1 { n[$1]++; l[$1] = $3 } END { for (i in n) if (n[i] != l[i]) exit 1 }'
}

# install_app FILE SHA256 STAGED: a daily Klipper/Moonraker package, moved
# into a staging folder (stage) as STAGED
install_app() {
	local f=$1 sum=$2 pkg=$3 name sub t new have urc err ver
	name=${f%%-*}
	sub=$(app_sub $name)
	t=${pkg%/*}
	have=$(sha256sum "$pkg" | cut -d' ' -f1)
	if [ "$have" != "$sum" ]; then
		unstage "$pkg"; log "$f: sha256 mismatch"
		say "failed: damaged download"; return
	fi
	# Unpacked by root in the staging folder: out of klipper's reach until
	# it is checked and handed over. The image's BusyBox tar has no gzip:
	# zcat feeds it. BusyBox tar drops leading "/" and everything up to the
	# last "../" from names and makes links that point outside (absolute or
	# with "..") only at the end; hard links out of the package and device
	# nodes or FIFOs are refused here. Its error output goes to the log,
	# cut short, anything but printable ASCII replaced (a byte range: the
	# image's BusyBox tr has no character classes).
	new=$t/$name
	mkdir "$new"
	zcat "$pkg" 2> "$t/zcat.err" | tar -xf - -C "$new" 2> "$t/tar.err"
	urc=$?
	[ -s "$t/zcat.err" ] && urc=1
	err=$(cat "$t/zcat.err" "$t/tar.err" | head -c 2000 |
		tr -c ' -~' ' ' | tr -s ' ' | head -c 300 | sed 's/^ //; s/ $//')
	rm -f "$pkg" "$t/zcat.err" "$t/tar.err"
	if [ $urc != 0 ] || [ -n "$(find "$new" ! -type d ! -type f ! -type l | head -n 1)" ] ||
	   ! own_links "$new" || ! plain "$new/kiln-app" ||
	   ! grep -qx "name=$name" "$new/kiln-app" ||
	   [ -L "$new/$sub" ] || ! plain "$new/$sub/.version"; then
		rm -rf "$new"; rmdir "$t"
		log "$f: not a $name package${err:+ (unpack: $err)}"
		say "failed: not a $name package"; return
	fi
	ver=$(head -c 64 "$new/$sub/.version" | head -n 1)
	case $ver in ''|*[!A-Za-z0-9._+-]*) ver='?' ;; esac
	chown -R klipper:klipper "$new"
	rm -rf "$APPS/.old-$name"
	[ -d "$APPS/$name" ] && mv "$APPS/$name" "$APPS/.old-$name"
	mv "$new" "$APPS/$name" && rm -rf "$APPS/.old-$name"
	rmdir "$t"
	sync
	log "$name $ver installed; runs from $(app_root $name)"
	if [ "$name" = moonraker ]; then
		# Moonraker is the one asking: answer first, then restart it
		say "restarting moonraker"
		sleep 2
		/etc/init.d/S62moonraker restart >> $LOG 2>&1
	else
		/etc/init.d/S61klipper restart >> $LOG 2>&1
		say "restarted klipper"
	fi
}

# service_request: Moonraker's "service", one line "ACTION NAME" (Fluidd's
# service buttons, the update manager's restarts): runs the init script
# this maps NAME to, never a path from klipper. Refused while a print may
# run (busy). Moonraker and nginx carry the answer back (Moonraker is the
# one asking, nginx passes its reply on): for them the answer comes first
# and the restart 3 s later. Only restart for those two; start, stop and
# restart for the others. AD5X_INITD overrides /etc/init.d (tests).
service_request() {
	local req r act name sc
	if ! req=$(stage service); then
		log "ignored a service request that is not a plain file"
		say "failed: bad request"; return
	fi
	r=$(head -c 64 "$req" | head -n 1)
	unstage "$req"
	act=${r%% *} name=${r#* }
	case $name in
	klipper) sc=S61klipper ;;
	moonraker) sc=S62moonraker ;;
	nginx) sc=S63nginx ;;
	ad5x-camera) sc=S64ad5x-camera ;;
	helixscreen) sc=S70helixscreen ;;
	*) sc= ;;
	esac
	case $act:$name in
	restart:*) ;;
	start:moonraker|stop:moonraker|start:nginx|stop:nginx) sc= ;;
	start:*|stop:*) ;;
	*) sc= ;;
	esac
	if [ -z "$sc" ]; then
		log "ignored a service request without a known service and action"
		say "failed: bad request"; return
	fi
	busy "$name $act" && return
	sc=${AD5X_INITD:-/etc/init.d}/$sc
	case $name in
	moonraker|nginx)
		log "restarting $name"
		say "done: restarting $name"
		sleep 3
		$sc restart < /dev/null >> $LOG 2>&1 ;;
	*)
		log "$act $name"
		if $sc $act < /dev/null >> $LOG 2>&1; then
			case $act in
			stop) say "done: stopped $name" ;;
			*) say "done: ${act}ed $name" ;;
			esac
		else
			say "failed: $act $name, see $LOG"
		fi ;;
	esac
}

# memory_request: Moonraker's "memory-mode", one line "on" or "off": runs
# "ad5x-memory extended on|off", which writes or removes the switch
# /data/ad5x/kernel/extended-memory (the next start uses it; "on" also
# removes the failure record). No print check: nothing stops or restarts.
# Answers the CLI's "done: extended memory on|off, ..." line, "refused:
# this printer has 256 MiB" (reason not_available in Moonraker; it checks
# first too) or "failed: ...".
memory_request() {
	local req r out why d
	if ! req=$(stage memory-mode); then
		log "ignored a memory mode request that is not a plain file"
		say "failed: bad request"; return
	fi
	r=$(head -c 64 "$req" | head -n 1)
	unstage "$req"
	case $r in
	on|off) ;;
	*)
		log "ignored a memory mode request without on or off"
		say "failed: bad request"; return ;;
	esac
	if out=$(ad5x-memory extended $r 2>&1 < /dev/null); then
		log "extended memory $r: $out"
		# The CLI's own "done:" line says when it takes effect (the next
		# start, or only after a boot loader update).
		d=$(printf '%s\n' "$out" | sed -n 's/^done: //p' | tail -n 1)
		say "done: ${d:-extended memory $r, takes effect at the next start}"
		return
	fi
	# One line of printable ASCII for the log and the answer
	out=$(printf '%s\n' "$out" | head -c 2000 | tr -c ' -~' ' ' | tr -s ' ' |
		head -c 300 | sed 's/^ //; s/ $//')
	log "extended memory $r failed: ${out:-no output}"
	case $out in
	*"refused: this printer has 256 MiB"*)
		say "refused: this printer has 256 MiB" ;;
	*"refused: "*)
		why=${out##*refused: }
		say "refused: $why" ;;
	*)
		say "failed: ad5x-memory extended $r: ${out:-no output}" ;;
	esac
}

# webui_request: Moonraker's "webui", one line "fluidd" or "mainsail":
# runs "ad5x-webui --no-sync NAME" and passes its one-line answer on
# ("done: ...", "refused: ..." or "failed: ..."). No print check: nginx
# reloads gracefully, nothing else restarts.
webui_request() {
	local req r out
	if ! req=$(stage webui); then
		log "ignored a web interface request that is not a plain file"
		say "failed: bad request"; return
	fi
	r=$(head -c 64 "$req" | head -n 1)
	unstage "$req"
	case $r in
	fluidd|mainsail) ;;
	*)
		log "ignored a web interface request without fluidd or mainsail"
		say "failed: bad request"; return ;;
	esac
	out=$(ad5x-webui --no-sync $r 2>&1 < /dev/null)
	# One line of printable ASCII for the log and the answer
	out=$(printf '%s\n' "$out" | head -n 1 | head -c 300 | tr -c ' -~' ' ' |
		sed 's/ *$//')
	log "web interface $r: ${out:-no output}"
	case $out in
	done:*|refused:*|failed:*) say "$out" ;;
	*) say "failed: ad5x-webui $r: ${out:-no output}" ;;
	esac
}

# The IFS firmware switch's job runs
ifs_switching() { [ -f $IFS_PID ] && kill -0 "$(cat $IFS_PID 2>/dev/null)" 2>/dev/null; }

# The owner turned the switch on: ifs-switch.enable, or ifs-klipper.enable
# (Klipper on the IFS, turned on over SSH before the switch existed)
ifs_opted_in() { [ -f $IFS_OPTIN ] || [ -f $IFS_KLIPPER ]; }

# One line of printable ASCII for the status file and the log
one_line() {
	printf '%s\n' "$*" | head -c 2000 | tr -c ' -~' ' ' | tr -s ' ' |
		head -c 300 | sed 's/^ //; s/ $//'
}

# ifs_request: Moonraker's "ifs-firmware", one line "stock" or "klipper".
# The switch to Klipper only with the owner's opt-in; the way back to
# stock for everyone (Flashforge's firmware is the IFS's default). Not
# while a print may run (busy) or a command runs (idle_timeout Printing),
# not while a switch runs. Then the status says running and the answer
# comes at once ("done: switching ..."); the job does the rest.
ifs_request() {
	local req t is
	if ! req=$(stage ifs-firmware); then
		log "ignored an IFS firmware request that is not a plain file"
		say "failed: bad request"; return
	fi
	t=$(head -c 64 "$req" | head -n 1)
	unstage "$req"
	case $t in
	stock|klipper) ;;
	*)
		log "ignored an IFS firmware request without stock or klipper"
		say "failed: bad request"; return ;;
	esac
	if ifs_switching; then
		log "IFS firmware $t refused: a switch is running"
		say "refused: the IFS firmware is being switched, try again in a few minutes"
		return
	fi
	if [ $t = klipper ] && ! ifs_opted_in; then
		log "IFS firmware klipper refused: the owner hasn't turned the switch on"
		say "refused: the IFS firmware switch is off (the owner turns it on over SSH: touch $IFS_OPTIN)"
		return
	fi
	if [ $t = klipper ] && [ ! -f $IFS_HEX ]; then
		log "IFS firmware klipper refused: no $IFS_HEX"
		say "refused: this image has no Klipper firmware for the IFS"
		return
	fi
	busy "IFS firmware $t" && return
	is=$(idle_state)
	if [ "$is" = Printing ]; then
		log "IFS firmware $t refused: the printer is busy (idle_timeout Printing)"
		say "refused: the printer is busy, try again when it is idle"
		return
	fi
	mkdir -p $IFSD && chmod 755 $IFSD
	IFS_FW_STATUS=$IFS_STATUS ad5x-mcu ifs-status target=$t state=running phase=stopping \
		reason= message= version= >> $LOG 2>&1
	log "IFS firmware: switching to $t"
	say "done: switching the IFS to $t firmware"
	# A process of its own, so its pid is its own; not killed when this
	# loop stops
	sh $0 ifs-job $t < /dev/null >> $LOG 2>&1 &
	echo $! > $IFS_PID
}

# ifs_job stock|klipper: the switch itself (S68ad5x-update-agent ifs-job,
# started by ifs_request). Klipper is stopped (it holds the IFS's port),
# ad5x-mcu flash-ifs writes the firmware and checks what answers, then
# Klipper is started again, also after a failure. To Klipper:
# ifs-klipper.enable first, so a power cut during the write is finished
# by the next start (ad5x-mcu boot writes Klipper's firmware when the IFS
# doesn't answer with it). To stock: ad5x-mcu removes ifs-klipper.enable
# only once Flashforge's firmware is written, so after a power cut the
# next start writes Klipper's back, a firmware that works. An owner who
# had turned Klipper on the IFS on keeps the switch (ifs-switch.enable).
# A plugin that drives the IFS is skipped while the IFS isn't on Klipper
# (ad5x_plugins.py), so Klipper starts either way.
ifs_job() {
	local t=$1 rc out v why msg
	echo $$ > $IFS_PID
	export IFS_FW_STATUS=$IFS_STATUS
	log "IFS firmware $t: stopping Klipper"
	$KINIT stop < /dev/null >> $LOG 2>&1
	if [ $t = klipper ]; then
		: > $IFS_KLIPPER
		set -- flash-ifs
	else
		[ -f $IFS_KLIPPER ] && : > $IFS_OPTIN
		set -- flash-ifs stock
	fi
	out=$(ad5x-mcu "$@" < /dev/null 2>&1)
	rc=$?
	printf '%s\n' "$out" >> $LOG
	ad5x-mcu ifs-status phase=starting >> $LOG 2>&1
	log "IFS firmware $t: starting Klipper"
	$KINIT start < /dev/null >> $LOG 2>&1
	if [ $rc = 0 ]; then
		# "flashforge 3.0.7" or Klipper's version (ad5x-mcu's record)
		v=$(head -c 64 ${AD5X_DATA:-/data}/ad5x/mcu/ifs 2>/dev/null | head -n 1)
		v=$(one_line "${v#flashforge }")
		log "IFS firmware: on $t firmware ($v)"
		ad5x-mcu ifs-status state=done phase= reason= message= version="$v" >> $LOG 2>&1
	else
		why=$(sed -n 's/^reason=//p' $IFS_STATUS 2>/dev/null)
		msg=$(printf '%s\n' "$out" | sed -n 's/^ad5x-mcu: //p' | tail -n 1)
		msg=$(one_line "${msg#ifs: }")
		log "IFS firmware $t failed (${why:-failed}): $msg"
		ad5x-mcu ifs-status state=failed phase= reason="${why:-failed}" \
			message="${msg:-ad5x-mcu flash-ifs failed, see $LOG}" version= >> $LOG 2>&1
	fi
	[ "$(cat $IFS_PID 2>/dev/null)" != $$ ] || rm -f $IFS_PID
}

# ifs_refuse_others: while the switch runs, the requests that would cut
# it short or restart Klipper under it are answered at once
ifs_refuse_others() {
	local r
	for r in kernel-retry boot-recovery return-stock reboot shutdown service install; do
		if [ -e $D/$r ] || [ -L $D/$r ]; then
			rm -f $D/$r
			log "$r refused: the IFS firmware is being switched"
			say "refused: the IFS firmware is being switched, try again in a few minutes"
		fi
	done
	if [ -e $D/plugin-request ] || [ -L $D/plugin-request ]; then
		rm -f $D/plugin-request
		log "plugin request refused: the IFS firmware is being switched"
		( ANSWER=plugin-status; say "refused: the IFS firmware is being switched, try again in a few minutes" )
	fi
}

# power_request reboot|shutdown: Moonraker's /machine/reboot and
# /machine/shutdown (and its reboot_machine, shutdown_machine remote
# methods) through the kiln_agent provider (components/kiln_os.py; the
# klipper user has no sudo for it). Refused while a print may run (busy),
# while the recovery OS is being written into slot A (a reboot or power-off
# would cut it short: slot A then holds no recovery OS until the next
# start writes it again), and before start-up has finished (the boot flag
# still on the recovery OS, which would start instead, and our kernel's
# start would count as unfinished), the last only for the first
# POWER_GRACE s after boot. The answer ("rebooting", "shutting down") comes
# first, then the reboot or power-off.
power_request() {
	local what=$1 cmd=reboot ans=rebooting
	[ $what = shutdown ] && cmd=poweroff ans="shutting down"
	busy $what && return
	if writing; then
		log "$what refused: the recovery OS is being written"
		say "refused: the recovery OS is being written into slot A, try again in a few minutes"
	elif ! started_up && [ "$(uptime_s)" -lt $POWER_GRACE ]; then
		log "$what refused: start-up not finished"
		say "refused: start-up has not finished yet, try again in a minute"
	else
		started_up || log "$what: start-up not finished after $POWER_GRACE s, going ahead"
		log "$what: $ans"
		say "$ans"
		sync
		sleep 2
		$cmd
		exit 0
	fi
}

# screen_reset_state: "locked" or "unlocked" in $SCREQ for the touch
# screen, rewritten only when it changes
screen_reset_state() {
	local want=unlocked t cur=
	rootpw_reset_locked && want=locked
	[ -d $SCREQ ] && [ ! -L $SCREQ ] || return 0
	{ read -r cur < $SCREQ/root-password-reset.state; } 2>/dev/null
	[ "$cur" = $want ] && return 0
	t=$(mktemp $SCREQ/.s.XXXXXX) || return 0
	echo $want > "$t" && chmod 644 "$t" &&
		mv -f "$t" $SCREQ/root-password-reset.state || rm -f "$t"
}

# screen_once: one round of the screen requests' loop
screen_once() {
	screen_reset_state
	if [ -e $SCREQ/root-password-default ] || [ -L $SCREQ/root-password-default ]; then
		screen_password_request
	fi
}

agent_once() {
	if [ -e $D/ifs-firmware ] || [ -L $D/ifs-firmware ]; then
		ifs_request
	fi
	if ifs_switching; then
		ifs_refuse_others
	elif grep -qx 'state=running' $IFS_STATUS 2>/dev/null; then
		# The job ended without its result (killed): not running any more
		log "IFS firmware: the switch stopped without a result"
		IFS_FW_STATUS=$IFS_STATUS ad5x-mcu ifs-status state=failed phase= reason=failed \
			message="the switch stopped without a result, see $LOG" >> $LOG 2>&1
	fi
	if [ -f $D/restart-moonraker ]; then
		rm -f $D/restart-moonraker
		if printing; then
			log "Moonraker restart for plugins refused: printing"
		else
			log "restarting Moonraker (plugins changed)"
			/etc/init.d/S62moonraker restart >> $LOG 2>&1
		fi
	fi
	if [ -f $D/kernel-retry ]; then
		rm -f $D/kernel-retry
		if busy "kernel retry"; then
			:
		elif ! started_up; then
			log "kernel retry refused: start-up not finished"
			say "refused: start-up has not finished yet, try again in a minute"
		elif out=$(ad5x-kernel retry 2>&1); then
			log "kernel retry: $out; rebooting"
			say "rebooting"
			sync
			sleep 2
			reboot
			exit 0
		else
			log "kernel retry failed: $out"
			say "failed: $out"
		fi
	fi
	if [ -f $D/boot-recovery ]; then
		rm -f $D/boot-recovery
		if busy "boot into recovery"; then
			:
		elif ! started_up; then
			log "boot into recovery refused: start-up not finished"
			say "refused: start-up has not finished yet, try again in a minute"
		elif out=$(ad5x-boot-recovery --no-reboot 2>&1); then
			log "boot into recovery: $out; rebooting"
			say "rebooting"
			sync
			sleep 2
			reboot
			exit 0
		else
			log "boot into recovery refused: $out"
			say "refused: ${out#ad5x-boot-recovery: }"
		fi
	fi
	if [ -f $D/return-stock ]; then
		rm -f $D/return-stock
		if busy "return to Flashforge firmware"; then
			:
		elif ! started_up; then
			log "return to Flashforge firmware refused: start-up not finished"
			say "refused: start-up has not finished yet, try again in a minute"
		elif out=$(ad5x-boot-recovery --no-reboot --return-stock 2>&1); then
			log "return to Flashforge firmware: $out; rebooting"
			say "rebooting"
			sync
			sleep 2
			reboot
			exit 0
		else
			log "return to Flashforge firmware refused: $out"
			say "refused: ${out#ad5x-boot-recovery: }"
		fi
	fi
	# Before a reboot or shutdown asked at the same time: the switch is
	# written first
	if [ -e $D/memory-mode ] || [ -L $D/memory-mode ]; then
		memory_request
	fi
	if [ -e $D/webui ] || [ -L $D/webui ]; then
		webui_request
	fi
	for p in reboot shutdown; do
		if [ -e $D/$p ] || [ -L $D/$p ]; then
			rm -f $D/$p
			power_request $p
		fi
	done
	if [ -e $D/service ] || [ -L $D/service ]; then
		service_request
	fi
	if [ -e $D/install ] || [ -L $D/install ]; then
		install_request
	fi
	if [ -e $D/plugin-request ] || [ -L $D/plugin-request ]; then
		# In a subshell: the request's answer file and variables stay its own
		if command -v plugin_request > /dev/null; then
			( plugin_request )
		else
			rm -f $D/plugin-request
			( ANSWER=plugin-status; say "failed: this system has no plugin root scripts" )
		fi
	fi
}

# screen_say TEXT: the touch screen's answer, renamed into place in $SCREQ
screen_say() {
	local t
	t=$(mktemp $SCREQ/.s.XXXXXX) || return 1
	printf '%s\n' "$*" > "$t" && chmod 600 "$t" &&
		mv -f "$t" $SCREQ/root-password-default.status || rm -f "$t"
}

# remote_touch_near STAMP: true while the record says a browser press is
# down (also with the streamer gone: an injected press stays held in the
# input system until something releases it), or a browser touched it at or after REMOTE_TOUCH_WINDOW
# seconds before STAMP (the press's start; its record: "STATE
# SECONDS-SINCE-BOOT"). Those touches reach the panel's own input device,
# so the screen can't tell them from a finger. With the streamer running
# and no readable record: true. Measured from the press, not from now, so
# a request that waited is judged as when it was made.
remote_touch_near() {
	local st t running= pid
	pid=$(cat $SCREEN_PID 2>/dev/null)
	case $pid in ''|*[!0-9]*) ;; *) kill -0 $pid 2>/dev/null && running=1 ;; esac
	if [ ! -f $RTOUCH ] || [ -L $RTOUCH ]; then
		[ -n "$running" ]; return
	fi
	read -r st t < $RTOUCH 2>/dev/null
	case $t in ''|*[!0-9]*) [ -n "$running" ]; return ;; esac
	[ "$st" = down ] && return 0
	[ $t -ge $(( $1 - REMOTE_TOUCH_WINDOW )) ]
}

# print_state_soon: print_stats's state with a short wait (the screen's
# answer is due within seconds); empty without an answer
print_state_soon() {
	wget -q -T 2 -O- 'http://127.0.0.1:7125/printer/objects/query?print_stats=state' \
		2>/dev/null | sed -n 's/.*"state": *"\([a-z_]*\)".*/\1/p' | head -n 1
}

# fresh STAMP: the press was at most REQUEST_MAX_AGE seconds ago (and not
# in the future)
fresh() {
	local now
	now=$(uptime_s)
	[ "$1" -le "$now" ] && [ $(( now - $1 )) -le $REQUEST_MAX_AGE ]
}

# screen_password_request: HelixScreen's "Reset root password" (Settings >
# System, a 5 s hold on the printer's screen; docs/install.md, "SSH login
# and the root password"). Physical access only: the request folder is
# root's, and a reset is refused while touches come from a browser
# (remote_touch_near). Refused while a print runs. The request is one
# line in a plain file of root's: "KIND STAMP", KIND "reset" (the button)
# or "factory-reset" (HelixScreen's Settings > System > Factory reset,
# after its own reset: applied whatever the lock says, and the lock
# removed, as FACTORY_RESET_HONOURS_LOCK says), STAMP the seconds since
# boot (CLOCK_BOOTTIME, as /proc/uptime) when the press began. Refused
# when that is more than REQUEST_MAX_AGE seconds ago, checked first and
# again last, just before the password changes. Moonraker not answering
# the print state (2 s) counts as not printing: a reset can't harm a
# print, a broken Moonraker shouldn't keep the owner out, and a slow
# answer only makes the request too old.
screen_password_request() {
	local f=$SCREQ/root-password-default out kind= stamp= line=
	# read only once it is a plain file of root's (never a FIFO or a link)
	plain $f && [ "$(ls -ldn $f | awk '{print $3}')" = "$ROOT_UID" ] &&
		line=$(head -c 40 $f)
	case $line in
	reset\ [0-9]*|factory-reset\ [0-9]*)
		kind=${line%% *} stamp=${line#* }
		case $stamp in ''|*[!0-9]*|0?*) kind= ;; esac
		[ ${#stamp} -le 10 ] || kind= ;;
	esac
	if [ -z "$kind" ]; then
		rm -f $f
		log "touch screen password reset: ignored a bad request"
		screen_say "failed: bad request"
		return
	fi
	rm -f $f
	if ! fresh $stamp; then
		log "touch screen password reset ($kind) refused: the request is too old (press at ${stamp}s, now $(uptime_s)s)"
		screen_say "refused: the request came too late; try again"
	elif rootpw_reset_locked &&
			{ [ $kind = reset ] || [ $FACTORY_RESET_HONOURS_LOCK = yes ]; }; then
		log "touch screen password reset ($kind) refused: locked (ad5x-passwd --lock-reset)"
		screen_say "refused: password reset is locked (turned off over SSH)"
	elif remote_touch_near $stamp; then
		log "touch screen password reset refused: the screen was used from a browser"
		screen_say "refused: the screen was used from a browser; touch it on the printer itself and try again in 30 seconds"
	elif case "$(print_state_soon)" in printing|paused) true ;; *) false ;; esac; then
		log "touch screen password reset refused: printing"
		screen_say "refused: a print is running"
	elif ! fresh $stamp; then
		log "touch screen password reset ($kind) refused: too old once checked (press at ${stamp}s, now $(uptime_s)s)"
		screen_say "refused: the request came too late; try again"
	elif out=$(AD5X_PASSWD_WHO="touch screen, $kind" \
			AD5X_PASSWD_NOT_AFTER=$(( stamp + REQUEST_MAX_AGE )) ad5x-passwd --default 2>&1); then
		log "touch screen password reset ($kind): root's password is root"
		if [ $kind = factory-reset ] && rootpw_reset_locked &&
				[ $FACTORY_RESET_HONOURS_LOCK = no ]; then
			if rootpw_reset_unlock; then
				log "touch screen factory reset: the password reset lock removed"
			else
				log "touch screen factory reset: the lock could not be removed"
			fi
		fi
		screen_say "done"
	else
		case $out in
		*"ad5x-passwd: too late"*)
			log "touch screen password reset ($kind) refused: too old once the password lock was free"
			screen_say "refused: the request came too late; try again" ;;
		*)
			log "touch screen password reset failed: $out"
			screen_say "failed: ${out#ad5x-passwd: }" ;;
		esac
	fi
}

# install_request: Moonraker's "install" (file name, sha256), read from the
# staged copy; the download is staged when the install goes ahead
install_request() {
	local req r f sum pkg urc
	if ! req=$(stage install); then
		log "ignored an install request that is not a plain file"
		say "failed: bad request"; return
	fi
	r=$(head -c 512 "$req")
	unstage "$req"
	f=$(printf '%s\n' "$r" | sed -n 1p)
	sum=$(printf '%s\n' "$r" | sed -n 2p)
	case "$f" in
	kiln-os-*-update.zip|klipper-*.tar.gz|moonraker-*.tar.gz) ;;
	*) f= ;;
	esac
	if ! good_name "$f" || ! good_sum "$sum"; then
		log "ignored an install request without an update's file name and sha256"
		say "failed: bad request"; return
	fi
	case "$f" in
	klipper-*.tar.gz|moonraker-*.tar.gz)
		busy "$f" && return
		if ! pkg=$(stage "$f"); then
			log "$f: missing or not a plain file"
			say "failed: the download is missing or not a plain file"; return
		fi
		install_app "$f" "$sum" "$pkg"
		return ;;
	esac
	if busy "$f"; then
		:
	elif ! started_up; then
		log "$f refused: start-up not finished"
		say "refused: start-up has not finished yet, try again in a minute"
	elif writing; then
		log "$f refused: the recovery OS is being written"
		say "refused: the recovery OS is being written into slot A, try again in a few minutes"
	elif ! pkg=$(stage "$f"); then
		log "$f: missing or not a plain file"
		say "failed: the download is missing or not a plain file"
	else
		log "staging $f"
		# --no-wait: a recovery OS write that started just now is refused
		# (exit code 3), not waited for
		ad5x-update --no-wait "$pkg" "$sum" >> $LOG 2>&1
		urc=$?
		unstage "$pkg"
		case $urc in
		0)
			log "staged, rebooting"
			say "rebooting"
			sync
			sleep 2
			reboot
			exit 0 ;;
		3)
			log "$f refused: the recovery OS is being written"
			say "refused: the recovery OS is being written into slot A, try again in a few minutes" ;;
		4)
			# slot A can't start the recovery OS; ad5x-update's last
			# line says why (reason no_recovery in Moonraker)
			why=$(tail -n 1 $LOG | sed 's/^ad5x-update: //')
			log "$f refused: $why"
			say "refused: $why" ;;
		*)
			log "ad5x-update failed"
			say "failed: ad5x-update, see $LOG" ;;
		esac
	fi
}

agent() {
	while :; do
		agent_once
		sleep 3
	done
}

screen_agent() {
	while :; do
		screen_once
		sleep 1
	done
}

case "$1" in
start)
	mkdir -p $D $APPS $LOGD
	chown klipper:klipper $D
	chown root:root $LOGD
	chmod 755 $D $APPS $LOGD
	rm -f $D/agent.log	# the log before PR #52, in klipper's folder: no longer written
	# The read token for a private update server (root's copy is fine;
	# Moonraker reads it as klipper)
	[ -f /data/ad5x/kiln-os.token ] &&
		chown root:klipper /data/ad5x/kiln-os.token &&
		chmod 640 /data/ad5x/kiln-os.token
	rm -f $D/install $D/kernel-retry $D/boot-recovery $D/return-stock \
		$D/service $D/reboot $D/shutdown $D/memory-mode $D/webui $D/ifs-firmware $D/status
	# The IFS firmware switch's status folder; a switch that was running
	# when the printer went off (power cut, reset) is reported as such
	mkdir -p $IFSD && chown root:root $IFSD && chmod 755 $IFSD
	if ! ifs_switching && grep -qx 'state=running' $IFS_STATUS 2>/dev/null; then
		log "IFS firmware: the switch was cut short by a restart"
		IFS_FW_STATUS=$IFS_STATUS ad5x-mcu ifs-status state=failed phase= reason=interrupted \
			message="the printer restarted during the switch; try again" >> $LOG 2>&1
	fi
	# The touch screen's request folder: root's only, in RAM
	[ -d $SCREQ ] && [ ! -L $SCREQ ] || { rm -f $SCREQ; mkdir -p $SCREQ; }
	chown root:root $SCREQ && chmod 700 $SCREQ
	rm -f $SCREQ/root-password-default $SCREQ/root-password-reset.state $SCREQ/.s.*
	# Staged files a reboot left behind (root's own; a folder klipper
	# swapped in stays)
	mkdir -p $STAGE && chown root:root $STAGE && chmod 700 $STAGE
	rm -rf $STAGE/r.*/klipper $STAGE/r.*/moonraker
	rm -f $STAGE/r.*/* 2>/dev/null; rmdir $STAGE/r.* 2>/dev/null; rm -f $STAGE/s.*
	# The plugins' root folder; no plugin request survives a reboot. No
	# plugin script runs here (S69ad5x-plugin-boot runs the boot scripts).
	command -v pr_setup > /dev/null && pr_setup
	start-stop-daemon -S -b -m -p $PID -x /bin/sh -- $0 run
	start-stop-daemon -S -b -m -p $SPID -x /bin/sh -- $0 screen-run
	;;
run)
	agent
	;;
screen-run)
	screen_agent
	;;
once)
	agent_once
	;;
screen-once)
	screen_once
	;;
ifs-job)
	ifs_job "$2"
	;;
stop)
	start-stop-daemon -K -p $SPID
	start-stop-daemon -K -p $PID
	rm -f $PID $SPID
	;;
esac
exit 0
