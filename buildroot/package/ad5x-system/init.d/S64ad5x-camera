#!/bin/sh
# USB cameras: one ustreamer per UVC camera, behind nginx as /webcam/ (first
# camera, 127.0.0.1:8090) and /webcam2/ (second camera, 8091). Stream:
# /webcam/?action=stream or /webcam/stream, snapshot: /webcam/snapshot. The
# camera's own MJPEG is passed through (--encoder=HW), so the CPU only copies
# frames. At most two cameras: 8092 is the screen stream (S65ad5x-screen),
# and nginx has a location only for /webcam/ and /webcam2/ (it is built
# without PCRE, so each path is a fixed location). Further cameras are
# logged and not started.
#
# /data/ad5x/camera.conf (optional, shell syntax):
#   CAMERA=off            no cameras
#   RESOLUTION=1280x720   all cameras (default 1280x720)
#   FPS=15                all cameras (default 15)
#   RESOLUTION_2=640x480  camera 2 only (same for FPS_2, ...)

# Files this creates are readable by klipper and www-data, whoever started
# it (a root SSH session may run with umask 077; issue #31)
umask 022

USTREAMER=/usr/bin/ustreamer
CONF=/data/ad5x/camera.conf
# UVC devices that are not printer cameras, as vendor:product (space separated)
CAMERA_IGNORE="0bda:d565"
RUN=/run/ad5x-camera
BASE_PORT=8090
# Cameras 1 and 2 use 8090 and 8091; nginx.conf has a location for each
MAX_CAMERAS=2

# Capture nodes of UVC cameras, in USB port order: index 0 of each
# interface (index 1 is the metadata node)
cameras() {
	for v in /sys/class/video4linux/video*; do
		[ -e "$v" ] || continue
		[ "$(cat $v/index 2>/dev/null)" = 0 ] || continue
		drv=$(basename "$(readlink -f $v/device/driver)" 2>/dev/null)
		[ "$drv" = uvcvideo ] || continue
		# Skip known non-camera UVC devices (USB vendor:product, space
		# separated). 0bda:d565 ("Snapshot Camera" on the OTG port) answers
		# no probe and is not the printer camera (issue: dead webcam tile).
		usb=$(dirname "$(readlink -f $v/device)")
		ids="$(cat $usb/idVendor 2>/dev/null):$(cat $usb/idProduct 2>/dev/null)"
		case " $CAMERA_IGNORE " in *" $ids "*) continue ;; esac
		echo "$(readlink -f $v/device) /dev/$(basename $v)"
	done | sort | cut -d' ' -f2
}

# Moonraker's webcam list (Fluidd, HelixScreen). Camera n is registered
# ("Chamber/Bed", then "Camera n") once its snapshot answers, and as disabled
# when it does not, so a camera that is plugged in but dead is not a tile.
# Only cameras that were started are registered. Only database webcams can be
# changed through the API (config webcams cannot).
MOONRAKER=http://127.0.0.1:7125
WEBCAM_API=$MOONRAKER/server/webcams/item
PYTHON=/usr/bin/python3

# prune_webcams COUNT: tidy Kiln's webcam entries for camera slots that are
# not running now (slot > COUNT). Slots 1 and 2 (an unplugged camera, or
# CAMERA=off) are set disabled, not deleted: Fluidd hides them, and a flip or
# rotation set in Fluidd is still there when the camera returns (its
# registration sets enabled again and sends neither field). Slots above
# MAX_CAMERAS can never run ("Camera 3" from a boot before the two-camera cap)
# and are deleted, as are the old names camera1, camera2, ... (renamed to
# "Chamber/Bed", "Camera n"). Kiln's entry for slot n is a database webcam
# named as Kiln names it, with exactly Kiln's URLs for that slot
# (/webcam$n/stream, /webcam$n/snapshot; slot 1 has no number). Any other
# entry, the screen and the user's own cameras included, is never touched.
# BusyBox wget cannot send DELETE or JSON, hence python3.
prune_webcams() {
	$PYTHON - "$MOONRAKER" "$1" "$MAX_CAMERAS" <<'PY'
import json, re, sys, urllib.parse, urllib.request
base, running, max_cams = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
item = base + "/server/webcams/item"
try:
    with urllib.request.urlopen(base + "/server/webcams/list", timeout=5) as r:
        cams = json.load(r)["result"]["webcams"]
except Exception:
    print("camera: could not read Moonraker's webcam list")
    sys.exit(0)
for cam in cams:
    if cam.get("source") != "database":
        continue
    m = re.fullmatch(r"/webcam([2-9]|[1-9][0-9]+)?/stream",
                     str(cam.get("stream_url", "")))
    if not m:
        continue
    suffix = m.group(1) or ""
    slot = int(suffix or 1)
    if cam.get("snapshot_url") != "/webcam%s/snapshot" % suffix:
        continue
    name = cam.get("name")
    current = "Chamber/Bed" if slot == 1 else "Camera %d" % slot
    if name not in (current, "camera%d" % slot):
        continue                        # not an entry Kiln made
    if slot <= running and name == current:
        continue                        # this camera runs now
    uid = str(cam.get("uid", ""))
    try:
        if name == current and slot <= max_cams:
            if cam.get("enabled") is False:
                continue                # already hidden
            req = urllib.request.Request(
                item, method="POST",
                data=json.dumps({"uid": uid, "enabled": False}).encode(),
                headers={"Content-Type": "application/json"})
            urllib.request.urlopen(req, timeout=5).close()
            print("camera: webcam '%s' disabled (camera %d is not running)"
                  % (name, slot))
            continue
        req = urllib.request.Request(
            item + "?" + urllib.parse.urlencode({"uid": uid}), method="DELETE")
        urllib.request.urlopen(req, timeout=5).close()
        print("camera: removed webcam '%s' (%s)" % (name,
              "old name" if name != current else
              "at most %d cameras" % max_cams))
    except Exception:
        print("camera: could not update webcam '%s'" % name)
PY
}

sync_webcams() {
	count=$1
	# Moonraker (S62) may still be starting: wait for its HTTP port first
	w=0
	while [ $w -lt 60 ] && ! wget -q -O /dev/null -T 3 $MOONRAKER/server/info; do
		w=$((w + 1))
		sleep 2
	done
	prune_webcams $count
	i=1
	while [ $i -le $count ]; do
		port=$((BASE_PORT + i - 1))
		suffix=""
		[ $i -gt 1 ] && suffix=$i
		enabled=false
		# Moonraker and the streamer take a few seconds to come up
		for try in 1 2 3 4 5 6 7 8; do
			if wget -q -O /dev/null -T 5 "http://127.0.0.1:$port/?action=snapshot"; then
				enabled=true
				break
			fi
			sleep 2
		done
		name="Chamber/Bed"
		[ $i -gt 1 ] && name="Camera $i"
		wget -q -O /dev/null -T 5 --post-data "name=$name&enabled=$enabled&service=mjpegstreamer-adaptive&stream_url=/webcam$suffix/stream&snapshot_url=/webcam$suffix/snapshot&location=printer&icon=mdiWebcam&aspect_ratio=4:3&target_fps=15&target_fps_idle=5" \
			"$WEBCAM_API" || echo "camera $i: could not register with Moonraker"
		echo "camera $i: webcam enabled=$enabled"
		i=$((i + 1))
	done
}

# --- camera.conf reader begin
# camera.conf is read as data, never run. Only the keys below are taken, and
# each value is checked; anything else is logged and skipped. The file must be
# a plain file owned by the user running this (root at boot) and not writable
# by group or others. Keys: CAMERA=on|off, RESOLUTION=WIDTHxHEIGHT, FPS=1..60,
# and the numbered forms RESOLUTION_2=, FPS_2=, ...
load_conf() {
	f=$1
	[ -e "$f" ] || return 0
	if [ -L "$f" ] || [ ! -f "$f" ]; then
		echo "camera: $f is not a plain file, not read"
		return 0
	fi
	# BusyBox here has no stat (issue #30): find tests owner and mode. Both
	# tests pass only when find prints the name, so an error refuses the file.
	[ -n "$(find "$f" -maxdepth 0 -user "$(id -u)")" ] || {
		echo "camera: $f is not owned by root, not read"
		return 0
	}
	[ -n "$(find "$f" -maxdepth 0 ! -perm /022)" ] || {
		echo "camera: $f is writable by group or others, not read"
		return 0
	}
	while IFS= read -r line || [ -n "$line" ]; do
		line=${line%"$(printf '\r')"}
		case "$line" in ''|'#'*) continue ;; esac
		case "$line" in
		*=*) ;;
		*) echo "camera: ignored a line without '='"; continue ;;
		esac
		key=${line%%=*}
		val=${line#*=}
		case "$key" in
		CAMERA|RESOLUTION|FPS) ;;
		RESOLUTION_*|FPS_*)
			# the number is all digits, so it is safe to build the name below
			case "${key#*_}" in
			''|*[!0-9]*) echo "camera: ignored key $key"; continue ;;
			esac ;;
		*) echo "camera: ignored unknown key $key"; continue ;;
		esac
		base=${key%%_*}
		ok=0
		case "$base" in
		CAMERA)
			case "$val" in on|off) ok=1 ;; esac ;;
		RESOLUTION)
			echo "$val" | grep -qx '[0-9]\{3,4\}x[0-9]\{3,4\}' && ok=1 ;;
		FPS)
			case "$val" in
			''|*[!0-9]*) ;;
			*) [ "$val" -ge 1 ] && [ "$val" -le 60 ] && ok=1 ;;
			esac ;;
		esac
		[ $ok = 1 ] || { echo "camera: ignored $key (not a valid value)"; continue; }
		eval "$key=\$val"
	done < "$f"
}
# --- camera.conf reader end

start() {
	[ -x $USTREAMER ] || exit 0
	CAMERA=on RESOLUTION=1280x720 FPS=15
	load_conf $CONF
	if [ "$CAMERA" = off ]; then
		echo "camera: off ($CONF)"
		# Hide the tiles of cameras started on an earlier boot
		sync_webcams 0 &
		return 0
	fi
	mkdir -p $RUN
	n=0
	for dev in $(cameras); do
		if [ $n -ge $MAX_CAMERAS ]; then
			echo "camera: $dev not started, at most $MAX_CAMERAS cameras (/webcam/, /webcam2/)"
			continue
		fi
		n=$((n + 1))
		port=$((BASE_PORT + n - 1))
		eval res=\${RESOLUTION_$n:-$RESOLUTION}
		eval fps=\${FPS_$n:-$FPS}
		start-stop-daemon -S -b -m -p $RUN/$n.pid -x $USTREAMER -- \
			--device=$dev --host=127.0.0.1 --port=$port \
			--format=MJPEG --encoder=HW --resolution=$res \
			--desired-fps=$fps --persistent \
			--drop-same-frames=30 --log-level=0
		echo "camera $n: $dev ${res}@${fps} on /webcam$([ $n -gt 1 ] && echo $n)/"
	done
	[ $n -gt 0 ] || echo "camera: none found"
	# Background: the streams take seconds, and boot must not wait for them.
	# Also with no camera, to hide the entries of an earlier boot.
	sync_webcams $n &
}

stop() {
	for p in $RUN/*.pid; do
		[ -f "$p" ] || continue
		start-stop-daemon -K -p $p -q
		rm -f $p
	done
}

case "$1" in
start) . /usr/lib/ad5x/safe.sh; safe_skip S64ad5x-camera; start ;;
stop) stop ;;
restart) stop; sleep 1; start ;;
esac
exit 0
