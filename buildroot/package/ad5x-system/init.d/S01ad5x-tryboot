#!/bin/sh
# "Try once": first thing at boot, point the boot flag at the OTHER slot
# (the previous, known-good system); S99ad5x-booted points it back at this
# slot once start-up has finished. A system (or update) that fails after
# this point comes back up on the other slot at the next power cycle.
# Does nothing in USB test mode.

# Files this creates are readable by klipper and www-data, whoever started
# it (a root SSH session may run with umask 077; issue #31)
umask 022

. /usr/lib/ad5x/slot.sh
case "$1" in
start)
	[ -n "$SLOT" ] || exit 0
	# A slot whose root has no squashfs superblock can't start (a recovery
	# write cut short, see ad5x-update): stay on this one.
	if [ "$(head -c 4 "$(rootfs_of $OTHER)" 2>/dev/null)" != hsqs ]; then
		echo "tryboot: slot $OTHER holds no root filesystem; boot flag stays on slot $SLOT"
		exit 0
	fi
	set_flag $OTHER
	echo "tryboot: running slot $SLOT; boot flag on slot $OTHER until start-up completes"
	;;
esac
exit 0
