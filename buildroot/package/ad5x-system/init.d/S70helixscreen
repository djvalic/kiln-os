#!/bin/sh
# HelixScreen, the touch screen UI, on the panel's framebuffer /dev/fb0
# (800x480) on every kernel: 6.6 and stock have only fbdev, mainline 7.3
# has a DRM driver and gives fb0 through its fbdev emulation, so the wait
# for fb0 below holds everywhere. The build also has the DRM backend:
# off by default (HELIX_DISPLAY_BACKEND=fbdev), on with
# /data/ad5x/helixscreen.drm where the kernel has a DRM driver (the
# opt-in 7.3). ad5x-fbstream reads the screen through DRM there, so the
# browser's screen view works with either backend. The tsc2007 touch (evdev) is
# found by the app. Talks to Moonraker at 127.0.0.1:7125. Read-only
# files in /usr/lib/helixscreen;
# settings and cache in /data/ad5x/helixscreen, log with Klipper's (so
# Fluidd shows it). Runs as root (framebuffer, DRM, input) at nice 10.
# On by default; /data/ad5x/helixscreen.disable turns it off. A first
# start gets a ready-made setup (ad5x preset: stock names, our fans and
# toolhead sensor, touch calibration) with the wizard not yet completed, so
# the setup wizard runs once: language, Wi-Fi, then the AD5X tuning steps
# (docs/setup-wizard.md); the hardware pickers stay collapsed. An existing
# settings.json is never touched, so an update does not bring the wizard
# back. printer_data/comms/run-setup-wizard (SETUP_WIZARD) runs it once more on
# the next start; HelixScreen deletes the flag. In USB test mode the stock
# app is not running, so nothing else draws on fb0.

# Files this creates are readable by klipper and www-data, whoever started
# it (a root SSH session may run with umask 077; issue #31)
umask 022

D=/data/ad5x/helixscreen
LOG=/data/ad5x/printer_data/logs/helixscreen.log
PID=/var/run/helixscreen.pid
case "$1" in
start)
	if [ -f /data/ad5x/helixscreen.disable ]; then
		echo "helixscreen: off (remove /data/ad5x/helixscreen.disable to start it)"
		exit 0
	fi
	# $D/.helixscreen: settings backups ($HOME/.helixscreen; /var/lib is read-only)
	mkdir -p $D/config $D/cache $D/.helixscreen ${LOG%/*}
	[ -f $D/config/settings.json ] || \
		cp /usr/share/ad5x/helixscreen-settings.json $D/config/settings.json
	# touch calibration in the running kernel's units (stock 0-800/0-480
	# with Y flipped, our 6.6 raw 0-4095): ad5x-touch-units. The same
	# range in stock units for the recovery OS's touch UI (it always runs
	# the stock kernel; S80ad5x-recovery-ui reads it, issue #47)
	ad5x-touch-units $D/config/settings.json \
		--recovery-cal /data/ad5x/recovery/touch-cal
	i=0
	while [ ! -c /dev/fb0 ] && [ $i -lt 10 ]; do sleep 1; i=$((i + 1)); done
	# The speaker (S35ad5x-sound: PWM channel 13 of pwmchip0, only on our
	# kernel): HelixScreen's own sounds use it directly (its sysfs PWM
	# backend, patch 0007), so taps don't queue behind print moves as M300
	# through Klipper would
	grep -q '^PWM=pwmchip0/pwm13$' /run/ad5x-sound.conf 2>/dev/null &&
		export HELIX_PWM_SOUND=0:13
	# Log detail follows Klipper's LOG_MODE (klipper/extras/ad5x_log.py
	# writes comms/log-mode: "short" or "extended [until]"; docs/logs.md):
	# short = warnings and errors, extended = debug. Klipper rewrites the
	# file when it connects; the screen then follows printer.ad5x_log
	# itself (patch 0049), also when the mode changes or its time is over.
	LEVEL=warn
	MODEFILE=/data/ad5x/printer_data/comms/log-mode
	if [ -f $MODEFILE ] && read -r m t < $MODEFILE && [ "$m" = extended ]; then
		case $t in
		''|*[!0-9]*) LEVEL=debug ;;
		*) [ "$(date +%s)" -lt "$t" ] && LEVEL=debug ;;
		esac
	fi
	# DRM only when asked for and the kernel has it (7.3); fbdev otherwise
	BACKEND=fbdev
	[ -f /data/ad5x/helixscreen.drm ] && [ -e /dev/dri/card0 ] && BACKEND=drm
	# At warn the screen's own start lines aren't in its log: one here
	echo "$(date '+%F %T') S70helixscreen: start, log level $LEVEL, display $BACKEND" >> $LOG
	HOME=$D \
	HELIX_DATA_DIR=/usr/lib/helixscreen \
	HELIX_CONFIG_DIR=$D/config \
	HELIX_CACHE_DIR=$D/cache \
	HELIX_LOG_DEST=file HELIX_LOG_FILE=$LOG HELIX_LOG_LEVEL=$LEVEL \
	HELIX_LOG_ROTATE_BYTES=1048576 HELIX_LOG_ROTATE_FILES=3 \
	HELIX_DISABLE_AUTO_UPDATES=1 \
	HELIX_DISPLAY_BACKEND=$BACKEND \
	HELIX_WIZARD_FLAG_FILE=/data/ad5x/printer_data/comms/run-setup-wizard \
	HELIX_OOM_SCORE_ADJ=300 \
	start-stop-daemon -S -b -m -p $PID -N 10 \
		-x /usr/lib/helixscreen/bin/helix-screen -- \
		--moonraker ws://127.0.0.1:7125 --skip-splash
	;;
stop)
	start-stop-daemon -K -p $PID -s TERM
	rm -f $PID
	;;
restart)
	$0 stop; sleep 2; $0 start
	;;
esac
exit 0
