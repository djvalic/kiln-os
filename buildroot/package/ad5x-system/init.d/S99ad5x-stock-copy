#!/bin/sh
# A second copy of this printer's stock files on the usershare partition
# (ad5x-stock-copy usershare --if-changed: kiln-stock-backup there, only
# when 64 MiB stay free for stock), so Return to Flashforge firmware (the
# recovery OS's ad5x-return-stock) still finds them after a wipe of the
# data partition. In the background, a minute after start-up, at low
# priority; nothing to do when the copy already has the files. Main OS in
# slot B only. /data/ad5x/stock-copy.disable switches it off. Log:
# /data/ad5x/kiln-log/stock-copy.log.

# Files this creates are readable by klipper and www-data, whoever started
# it (a root SSH session may run with umask 077; issue #31)
umask 022

. /usr/lib/ad5x/slot.sh
case "$1" in
start)
	. /usr/lib/ad5x/safe.sh; safe_skip S99ad5x-stock-copy
	[ "$SLOT" = B ] && [ -f /data/ad5x/stock/SHA256SUMS ] || exit 0
	[ -e /data/ad5x/stock-copy.disable ] && { echo "stock-copy: off (/data/ad5x/stock-copy.disable)"; exit 0; }
	mkdir -p /data/ad5x/kiln-log
	( sleep 60
	  echo "=== $(date) usershare copy of /data/ad5x/stock"
	  nice -n 19 ad5x-stock-copy usershare --if-changed
	) </dev/null >> /data/ad5x/kiln-log/stock-copy.log 2>&1 &
	echo "stock-copy: the stock files' usershare copy is checked in the background"
	;;
esac
exit 0
