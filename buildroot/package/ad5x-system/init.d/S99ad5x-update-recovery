#!/bin/sh
# The recovery OS travels with the main OS (docs/recovery-os.md, "Updates"):
# each main image carries the recovery image it was released with
# (/usr/share/ad5x/recovery: rootfs.squashfs, .sha256, .id). After a
# complete start (S99ad5x-booted has pointed the flag at this slot), slot A
# is compared by content ID (/etc/ad5x-recovery-id); another ID, or none
# (recovery OSes before v0.0.5), gets this one written with "ad5x-update
# --install-recovery" (read-back check, superblock last). Also when slot
# A's kernel isn't the one it is to hold, which that copies there (header
# last): a copy cut short, or one from before a kernel update. Which kernel
# (lib/uboot.sh, slot_a_kernel_src): with Kiln's SPL in the first MiB this
# system's own 6.6 (the one running now, or on 7.3 one not recorded as
# failed), never Flashforge's 5.10, whoever started this boot (U-Boot, or
# Kiln's SPL alone); with Flashforge's SPL slot B's kernel, its 5.10, but
# never Kiln's U-Boot or Kiln's 6.6 from kernel2. Only over a recovery OS,
# or a slot A left empty by a write cut short; stock in slot A is left to
# S99ad5x-install-recovery. At most 3 tries per image; log in
# /data/ad5x/recovery/update.log. /data/ad5x/recovery-update.disable:
# slot A never.
# With Kiln's SPL also this slot's own kernel partition (kernel2, p3): the
# same 6.6 goes there with "ad5x-update --kernel2" when it isn't there yet,
# so no Flashforge kernel is left in either slot and Kiln's SPL boots 6.6
# directly when U-Boot proper is missing or fails. At most 3 tries per
# kernel, the same log.
# AD5X_LIB overrides /usr/lib/ad5x, AD5X_RECOVERY_IMG /usr/share/ad5x/recovery
# (tools/test_kernel_fallback.sh).

# Files this creates are readable by klipper and www-data, whoever started
# it (a root SSH session may run with umask 077; issue #31)
umask 022

LIB=${AD5X_LIB:-/usr/lib/ad5x}
. $LIB/slot.sh
[ -f $LIB/uboot.sh ] && . $LIB/uboot.sh
R=${AD5X_RECOVERY_IMG:-/usr/share/ad5x/recovery}
D=/data/ad5x/recovery

# tries KEY FILE: the count for KEY so far (0 for another key)
tries() {
	set -- "$1" $(cat "$2" 2>/dev/null)
	[ "$2" = "$1" ] && echo "${3:-0}" || echo 0
}

# Slot A: sets want, have, kwhy; 0 when it is to be written
slot_a_due() {
	[ -f $R/rootfs.squashfs ] && [ -f $R/rootfs.id ] || return 1
	if [ -f /data/ad5x/recovery-update.disable ]; then
		echo "update-recovery: off (/data/ad5x/recovery-update.disable)"
		return 1
	fi
	want=$(cat $R/rootfs.id)
	m=/run/ad5x-recovery-check
	mkdir -p $m
	kind=other have=
	if mount -t squashfs -o ro "$(rootfs_of A)" $m 2>/dev/null; then
		if [ -f $m/etc/ad5x-recovery ]; then
			kind=recovery
			have=$(cat $m/etc/ad5x-recovery-id 2>/dev/null)
		fi
		umount $m
	elif [ "$(head -c 4 "$(rootfs_of A)")" != hsqs ]; then
		kind=empty	# an earlier write cut short (no superblock): write it again
		have=none
	fi
	[ $kind = recovery ] || [ $kind = empty ] || return 1
	# Slot A's kernel must be the one it is to hold (the same bytes as a
	# kernel that started a system here: cheaper than reading its data
	# CRC). Otherwise: no whole uImage (a copy cut short by a reboot, which
	# ad5x-update and ad5x-boot-recovery refuse to point the flag at), or
	# another kernel. Either way the write below copies it again.
	kwhy=
	if [ $kind = recovery ] && command -v slot_a_kernel_src >/dev/null 2>&1 &&
	   slot_a_kernel_src "$LIB" && ! kernel_same "$SLOT_A_SRC" "$(kernel_of A)"; then
		if [ "$SLOT_A_SRC" = "$(kernel_of B)" ]; then kname="slot B's"
		else kname="Kiln's 6.6 ($SLOT_A_SRC)"
		fi
		if uimage_data_ok "$(kernel_of A)"; then
			kwhy="its kernel differs from $kname"
		else
			kwhy="no complete kernel (uImage header or data CRC wrong)"
		fi
	fi
	[ "$have" = "$want" ] && [ -z "$kwhy" ] && return 1
	n=$(tries "$want" $D/update.tries)
	if [ "$n" -ge 3 ]; then
		echo "update-recovery: gave up on $want after 3 tries, see $D/update.log"
		return 1
	fi
	mkdir -p $D
	echo "$want $((n + 1))" > $D/update.tries
	atry=$((n + 1))
	return 0
}

# kernel2 (Kiln's SPL only): sets k2 and k2key; 0 when it is to be written
kernel2_due() {
	command -v kiln_slot_kernel >/dev/null 2>&1 || return 1
	k2=$(kiln_slot_kernel "$LIB") || return 1
	kernel_same "$k2" "$(kernel_of B)" && return 1
	# the kernel's data CRC (uImage header bytes 24-27) names it
	k2key=$(head -c 28 "$k2" | tail -c 4 | od -An -t x1 | tr -d ' \n')
	n=$(tries "$k2key" $D/kernel2.tries)
	if [ "$n" -ge 3 ]; then
		echo "update-recovery: gave up writing Kiln's 6.6 into kernel2 after 3 tries, see $D/update.log"
		return 1
	fi
	mkdir -p $D
	echo "$k2key $((n + 1))" > $D/kernel2.tries
	k2try=$((n + 1))
	return 0
}

case "$1" in
start)
	. /usr/lib/ad5x/safe.sh; safe_skip S99ad5x-update-recovery
	[ "$SLOT" = B ] || exit 0
	# A first install still writing its recovery OS (S99ad5x-install-recovery)
	[ -f /data/ad5x/install/recovery.squashfs ] && exit 0
	[ "$(read_flag)" = ota:kernel2 ] || { echo "update-recovery: start-up not complete, later"; exit 0; }
	doa= dok2=
	slot_a_due && doa=1
	kernel2_due && dok2=1
	[ -n "$doa$dok2" ] || exit 0
	(
		if [ -n "$doa" ]; then
			echo "=== $(date) recovery OS ${have:-(no ID)} -> $want${kwhy:+ (slot A: $kwhy)} (try $atry)"
			if ad5x-update --install-recovery $R/rootfs.squashfs "$(cat $R/rootfs.sha256)"; then
				rm -f $D/update.tries
				echo "update-recovery: OK, recovery OS $want in slot A"
			else
				echo "update-recovery: FAILED (tried again at the next start)"
			fi
		fi
		if [ -n "$dok2" ]; then
			echo "=== $(date) kernel2: Kiln's 6.6 ($k2) (try $k2try)"
			if ad5x-update --kernel2; then
				rm -f $D/kernel2.tries
				echo "update-recovery: OK, Kiln's 6.6 in kernel2"
			else
				echo "update-recovery: kernel2 FAILED (tried again at the next start)"
			fi
		fi
	) >> $D/update.log 2>&1 &
	[ -n "$doa" ] && echo "update-recovery: writing recovery OS $want into slot A in the background${kwhy:+ (slot A: $kwhy)} ($D/update.log)"
	[ -n "$dok2" ] && echo "update-recovery: writing Kiln's 6.6 into kernel2 in the background ($D/update.log)"
	;;
esac
exit 0
