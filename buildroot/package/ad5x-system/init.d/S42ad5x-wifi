#!/bin/sh
# Wi-Fi client on wlan0. wpa_supplicant always runs (unless Wi-Fi is off,
# below) with /data/ad5x/wpa_supplicant.conf, so HelixScreen's Wi-Fi
# screens (setup wizard, Settings > Network) can scan, join and save
# networks there (update_config=1; updates never touch /data). The first
# start without that file brings over the networks stock saved (usershare
# /wifi/wpa_supplicant.conf, joined on the Flashforge screen), or starts
# with none. DHCP: udhcpc on wlan0, renewed by wpa_cli (this script with
# "wlan0 CONNECTED") the moment a network is joined. A disconnect doesn't
# release the lease: the address and route stay on wlan0, so a short drop
# doesn't cut connections. Power saving is off on wlan0 (power_save_off,
# below).
#
# Off: HelixScreen's Wi-Fi switch saves wifi_enabled false in its
# settings.json and blocks the radio (rfkill). This script leaves that to
# HelixScreen (issue #37): at its start it blocks the radio again only
# when Ethernet is up, and leaves it on otherwise, so an off switch can't
# strand the printer. A block here at boot could outlast that decision
# (and the recovery OS, which runs this script, has no HelixScreen).
# /data/ad5x/wifi.disable: no Wi-Fi at all (no wpa_supplicant, nothing
# for the screen to switch on).
#
# What happened at start is in printer_data/logs/wifi.log (Fluidd shows
# it): kernel, Wi-Fi driver and its settings, the number of saved networks
# (no names or passwords), wpa_supplicant's own words if it didn't start.
# The previous start's log is kept as wifi.log.1 (one generation), so a
# Wi-Fi that died before a reboot still has its log. A config it
# can't read is put aside (wpa_supplicant.conf.bad-*) and it starts with
# a new one, so the screen can still join a network. Any other failure
# (the adapter or its driver, issue #45) keeps the config: two more tries,
# then Wi-Fi stays down until the next start.

# Files this creates are readable by klipper and www-data, whoever started
# it (a root SSH session may run with umask 077; issue #31)
umask 022

CONF=/data/ad5x/wpa_supplicant.conf
LOG=/data/ad5x/printer_data/logs/wifi.log
OFF=/data/ad5x/wifi.disable
HELIX=/data/ad5x/helixscreen/config/settings.json
CTRL=/var/run/wpa_supplicant
OUT=/tmp/ad5x-wifi-start.txt

log() {
	echo "ad5x-wifi: $*"
	echo "$(date '+%F %T') $*" >> $LOG 2>/dev/null
}

stock_conf() {
	for u in /sys/class/block/*/uevent; do
		grep -qx "PARTNAME=usershare" "$u" 2>/dev/null || continue
		dev=/dev/$(sed -n 's/^DEVNAME=//p' "$u")
		mkdir -p /tmp/usershare-wifi
		if mount -t ext4 -o ro "$dev" /tmp/usershare-wifi 2>/dev/null; then
			# its networks only: our own ctrl_interface and update_config
			sed -n '/^[[:space:]]*network[[:space:]]*=/,$p' \
				/tmp/usershare-wifi/wifi/wpa_supplicant.conf 2>/dev/null
			umount /tmp/usershare-wifi
		fi
		rmdir /tmp/usershare-wifi 2>/dev/null
	done
}

# The saved networks' passwords: $CONF, its temp file and the copies put
# aside (.bad-*) are 0600, set here, not left to the umask (issue #31).
# wpa_supplicant rewrites $CONF when the screen saves a network, with the
# mode its umask gives (wpa_config_write: fopen of $CONF.tmp, then
# rename), so it runs with umask 077 (start_wpa). Older versions ran it
# with 022, so a network saved on the screen left $CONF 0644:
# private_conf, at each start, puts that right.
private_conf() {
	for f in $CONF $CONF.bad-*; do
		[ -f "$f" ] && chmod 600 "$f"
	done
	return 0
}

# private_write: stdin to $CONF.tmp, 0600 from the start
private_write() {
	rm -f $CONF.tmp
	(umask 077; cat > $CONF.tmp) && chmod 600 $CONF.tmp
}

make_conf() {
	nets=$(stock_conf)
	{
		echo "# Wi-Fi networks (HelixScreen saves here; see S42ad5x-wifi)"
		echo "ctrl_interface=$CTRL"
		echo "update_config=1"
		[ -n "$nets" ] && printf '\n%s\n' "$nets"
	} | private_write && mv $CONF.tmp $CONF
	if [ -n "$nets" ]; then
		log "new $CONF with stock's saved networks"
	else
		log "new $CONF (no networks yet)"
	fi
}

# scan_ssid=1 in every saved network: stock saves only ssid and psk, so a
# hidden network joined on stock's screen would never be found here (it
# answers only probes that name it). Costs a probe per saved network.
probe_hidden() {
	awk '
	/^[[:space:]]*network[[:space:]]*=[[:space:]]*\{/ { inb = 1; seen = 0 }
	inb && /^[[:space:]]*scan_ssid[[:space:]]*=/ { seen = 1 }
	inb && /^[[:space:]]*\}/ { if (!seen) print "\tscan_ssid=1"; inb = 0 }
	{ print }' $CONF | private_write
	if cmp -s $CONF $CONF.tmp; then
		rm -f $CONF.tmp
	else
		mv $CONF.tmp $CONF
	fi
}

nets() {
	grep -c '^[[:space:]]*network[[:space:]]*=' $CONF 2>/dev/null
}

# start_wpa: wpa_supplicant on $CONF, up when its control socket is
start_wpa() {
	(umask 077; exec wpa_supplicant -B -i wlan0 -c $CONF \
		-P /var/run/wpa_supplicant.pid) > $OUT 2>&1
	rc=$?
	# -B returns after the interface is set up: a failure leaves no
	# daemon whose socket could still come
	i=0
	while [ $rc = 0 ] && [ ! -S $CTRL/wlan0 ] && [ $i -lt 30 ]; do
		usleep 100000; i=$((i + 1))
	done
	[ $rc = 0 ] && [ -S $CTRL/wlan0 ] && return 0
	log "wpa_supplicant didn't start (exit $rc):"
	sed 's/^/    /' $OUT >> $LOG 2>/dev/null
	cat $OUT
	[ -f /var/run/wpa_supplicant.pid ] &&
		kill "$(cat /var/run/wpa_supplicant.pid)" 2>/dev/null
	return 1
}

# Power saving off on wlan0 (issue #37): the kernel starts it on (our
# config leaves CFG80211_DEFAULT_PS at its default), and with it the
# rtw88 8821CU's signal reading falls to -95 dBm, wpa_supplicant loses
# the network and joins again, over and over. mac80211 keeps the setting
# while wlan0 exists; it is set again on each join for an adapter that
# came back (USB) with the default. $1 "start" logs the result; a join
# logs only when it found power saving on.
power_save_off() {
	was=$(iw dev wlan0 get power_save 2>/dev/null)
	case "$was" in
	*off) [ "$1" = start ] && log "power saving off" ;;
	*on)
		if ! iw dev wlan0 set power_save off 2>/dev/null; then
			log "power saving on: the driver doesn't take it off"
		elif [ "$1" = start ]; then
			log "power saving off"
		else
			log "power saving was on again at a join; off"
		fi
		;;
	*) [ "$1" = start ] && log "power saving: no answer from iw" ;;
	esac
	return 0
}

# The rtw88 driver's settings and firmware version (issue #37), so a log
# sent in shows what the driver ran with: its module parameters (built
# in, but still in /sys/module and changeable at run time) and the
# firmware line the kernel printed at probe.
driver_info() {
	p=/sys/module/rtw88_core/parameters
	if [ -d $p ]; then
		s=
		for f in "$p"/*; do
			[ -f "$f" ] && s="$s ${f##*/}=$(cat "$f" 2>/dev/null)"
		done
		log "rtw88_core:$s"
	fi
	fw=$(dmesg 2>/dev/null | grep -m 1 'rtw_.*: Firmware version')
	[ -n "$fw" ] && log "firmware: ${fw#*Firmware version }"
	return 0
}

# Is the config to blame for the failed start_wpa? When wpa_supplicant
# says so: every way wpa_config_read() fails ends in this line
# (wpa_supplicant 2.11, wpa_supplicant_init_iface()), and it reads the
# config before it touches the driver. Or when it started (exit 0) but
# made no control socket: no ctrl_interface=$CTRL in the config. Anything
# else, e.g. "Could not set interface wlan0 flags (UP)" / "Failed to
# initialize driver interface", is the adapter or its driver (issue #45).
conf_bad() {
	[ "$rc" = 0 ] || grep -q 'Failed to read or parse configuration' $OUT 2>/dev/null
}

# Not the config: two more tries, 2 s apart (each brings wlan0 up again,
# so the 8821CU downloads its firmware again, issue #43)
retry_wpa() {
	for t in 2 3; do
		sleep 2
		log "try $t of 3"
		start_wpa && return 0
	done
	return 1
}

radio() {
	for r in /sys/class/net/wlan0/phy80211/rfkill*/soft; do
		[ -f "$r" ] && echo "$1" > "$r"
	done
}

case "$1" in
start)
	if [ -f /var/run/wpa_supplicant.pid ] &&
	   kill -0 "$(cat /var/run/wpa_supplicant.pid)" 2>/dev/null; then
		echo "ad5x-wifi: already running"
		exit 0
	fi
	mkdir -p ${LOG%/*}
	# keep the previous start's log (issue #37: the log of a Wi-Fi that
	# died went with the reboot that followed); one generation
	[ -s $LOG ] && mv -f $LOG $LOG.1 2>/dev/null
	: > $LOG 2>/dev/null
	log "start: kernel $(uname -r), $(head -1 /etc/ad5x-release 2>/dev/null)"
	if [ -f $OFF ]; then
		log "off (remove $OFF to use Wi-Fi)"
		ip link set wlan0 down 2>/dev/null
		exit 0
	fi
	# the USB adapter usually shows up long before this; some seconds
	# more only when it hasn't
	i=0
	while [ ! -d /sys/class/net/wlan0 ] && [ $i -lt 10 ]; do
		sleep 1; i=$((i + 1))
	done
	if [ ! -d /sys/class/net/wlan0 ]; then
		log "no wlan0 after ${i} s; interfaces: $(ls /sys/class/net | tr '\n' ' ')"
		log "USB: $(cat /sys/bus/usb/devices/*/product 2>/dev/null | tr '\n' ',')"
		exit 0
	fi
	drv=$(readlink /sys/class/net/wlan0/device/driver 2>/dev/null)
	log "wlan0 after ${i} s, driver ${drv##*/}"
	driver_info
	power_save_off start
	[ -f $CONF ] || make_conf
	probe_hidden
	private_conf
	if grep -Eq '"wifi_enabled"[[:space:]]*:[[:space:]]*(false|0)' $HELIX 2>/dev/null; then
		log "switched off on the screen: radio not blocked at start (HelixScreen blocks it when Ethernet is up)"
	else
		radio 0
	fi
	if start_wpa; then
		:
	elif ! conf_bad; then
		retry_wpa || {
			log "wpa_supplicant didn't start, not for its config: $CONF kept ($(nets) saved network(s)); Wi-Fi is down until the next start"
			exit 0
		}
	else
		bad=$CONF.bad-$(date +%Y%m%d-%H%M%S)
		mv $CONF $bad
		log "$(grep -c '^[[:space:]]*network[[:space:]]*=' $bad) saved network(s) put aside in $bad; starting with none"
		{
			echo "# Wi-Fi networks (HelixScreen saves here; see S42ad5x-wifi)"
			echo "ctrl_interface=$CTRL"
			echo "update_config=1"
		} | private_write && mv $CONF.tmp $CONF
		start_wpa || { log "wpa_supplicant fails with a new config too"; exit 0; }
	fi
	log "wpa_supplicant running, $(nets) saved network(s)"
	wpa_cli -B -p $CTRL -i wlan0 -a /etc/init.d/S42ad5x-wifi \
		-P /var/run/wpa_cli.wlan0.pid
	udhcpc -b -i wlan0 -p /var/run/udhcpc.wlan0.pid >/dev/null 2>&1 &
	;;
stop)
	for p in wpa_cli.wlan0 udhcpc.wlan0 wpa_supplicant; do
		[ -f /var/run/$p.pid ] && kill "$(cat /var/run/$p.pid)" 2>/dev/null
		rm -f /var/run/$p.pid
	done
	;;
wlan0)
	# wpa_cli -a: "wlan0 CONNECTED" / "wlan0 DISCONNECTED"
	p=/var/run/udhcpc.wlan0.pid
	case "$2" in
	CONNECTED)
		log "joined; DHCP renew"
		power_save_off join
		if [ -f $p ] && kill -0 "$(cat $p)" 2>/dev/null; then
			kill -USR1 "$(cat $p)"
		else
			udhcpc -b -i wlan0 -p $p >/dev/null 2>&1 &
		fi
		;;
	DISCONNECTED)
		# no release (issue #37): udhcpc keeps the lease, the address and
		# route stay, and the next join renews it
		log "disconnected; DHCP lease kept"
		;;
	esac
	;;
esac
exit 0
