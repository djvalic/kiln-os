#!/bin/sh
# passwd on Kiln OS (installed over BusyBox's /usr/bin/passwd link, both
# OSes). /etc is on the read-only root, so BusyBox's passwd can't write
# /etc/shadow (it makes /etc/shadow+ there and renames it). Root's own
# password goes through ad5x-passwd, which keeps it on /data; other users
# have no password on Kiln OS.
if [ "$(id -u)" = 0 ] && { [ $# = 0 ] || { [ $# = 1 ] && [ "$1" = root ]; }; }; then
	exec ad5x-passwd
fi
echo "passwd: on Kiln OS only root's password can be set: run passwd as root, with no options (or ad5x-passwd --help)" >&2
exit 1
