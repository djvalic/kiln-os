#!/bin/sh
# Boot into the recovery OS on request (issue #47): points the boot flag at
# slot A and reboots. Unlike an interrupted boot this records no unfinished
# start of our kernel, so the next main OS start still uses it.
#
#   ad5x-boot-recovery [--no-reboot] [--return-stock]
#
# Refused unless this is the main OS in slot B, slot A holds the recovery
# OS and a whole kernel (uImage header and data CRC), no recovery OS write
# is running (S99ad5x-update-recovery) and
# start-up has finished (S99ad5x-booted has pointed the boot flag back at
# slot B and made /run/ad5x-booted, start_done in lib/slot.sh: before that,
# our kernel's start marker is still there and a reboot counts as an
# unfinished start). --no-reboot sets the flag and
# leaves the reboot to the caller (S68ad5x-update-agent answers Moonraker
# first). Prints are not checked here: the update agent refuses while one
# may run (POST /machine/kiln_os/boot_recovery, docs/updates.md).
# --return-stock: also asks the recovery OS to open Return to Flashforge
# firmware (/data/ad5x/return-stock/request, read by ad5x-recovery-auto),
# which still waits for a tap there (HelixScreen's Settings > System >
# Return to Flashforge firmware, POST /machine/kiln_os/return_stock).
# AD5X_LIB overrides /usr/lib/ad5x, AD5X_DATA /data (tests).
. ${AD5X_LIB:-/usr/lib/ad5x}/slot.sh

die() { echo "ad5x-boot-recovery: $*" >&2; exit 1; }

reboot_after=1 ret=
for a in "$@"; do
	case "$a" in
	--no-reboot) reboot_after= ;;
	--return-stock) ret=1 ;;
	-h|--help) sed -n '2,21p' "$0"; exit 0 ;;
	*) die "unknown option $a (usage: ad5x-boot-recovery [--no-reboot] [--return-stock])" ;;
	esac
done

[ "$SLOT" = B ] || die "run from the main OS in slot B (this is slot '${SLOT:-?}')"

# The same test as ad5x-update's
AROOT=$(rootfs_of A)
MNT=/run/ad5x-target
mkdir -p $MNT
slot_a_holds() {
	holds=unknown
	if mount -t squashfs -o ro $AROOT $MNT 2>/dev/null; then
		if [ -f $MNT/etc/ad5x-recovery ]; then holds=recovery
		elif [ -f $MNT/etc/ad5x-release ]; then holds=main
		elif [ -d $MNT/usr/prog ] || [ -f $MNT/etc/ota_bin/ota_local_method.sh ]; then holds=stock
		fi
		umount $MNT
	fi
	echo $holds
}

WLOCK=/run/ad5x-recovery-write.pid
if [ -f $WLOCK ] && kill -0 "$(cat $WLOCK)" 2>/dev/null; then
	die "the recovery OS is being written into slot A (S99ad5x-update-recovery); try again in a few minutes"
fi
flag=$(read_flag)
start_done || \
	die "start-up has not finished yet (boot flag '$flag', $BOOTED_MARK $([ -f $BOOTED_MARK ] && echo there || echo missing)); try again in a minute"
holds=$(slot_a_holds)
[ "$holds" = recovery ] || die "slot A doesn't hold the recovery OS (it holds: $holds)"
# Its kernel too, whole (header and data CRC): a reboot can cut short the
# background write of slot A (S99ad5x-update-recovery copies the kernel),
# and the boot loader would start a broken one.
AKERN=$(kernel_of A)
uimage_data_ok "$AKERN" ||
	die "slot A doesn't hold the recovery OS's kernel: no complete uImage in ${AKERN:-its kernel partition} (header or data CRC wrong)"

if [ -n "$ret" ]; then
	RS=${AD5X_DATA:-/data}/ad5x/return-stock
	mkdir -p "$RS" && date > "$RS/request" && sync || die "can't write the boot flag (no request file in $RS)"
fi
set_flag A && [ "$(read_flag)" = "$(flag_for A)" ] || die "can't write the boot flag"
sync
echo "boot flag on the recovery OS ($(read_flag))${ret:+; it opens Return to Flashforge firmware}"
if [ -n "$reboot_after" ]; then
	echo "rebooting into the recovery OS"
	reboot
fi
exit 0
