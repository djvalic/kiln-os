#!/usr/bin/env python3
"""Show an image on the panel's framebuffer, in the framebuffer's format.

usage: ad5x-fb-show IMAGE [FBDEV [SYSFS_DIR]]

IMAGE (JPEG or PNG) is scaled to the panel's 800x480 and written to the
first frame of FBDEV (default /dev/fb0) in one write. The format comes from
SYSFS_DIR (default /sys/class/graphics/<name of FBDEV>):
  bits_per_pixel 32  XRGB8888 (6.6 kernel)
  bits_per_pixel 16  RGB565, little-endian (7.3 kernel since patch 0078)
  stride             bytes per line; a stride wider than 800 pixels gets
                     zero padding at the end of each line.
Any other depth, a stride too narrow for 800 pixels, or no sysfs files:
nothing is written, the reason goes to stderr and the exit code is 1.

Used by S07ad5x-board (boot logo) and ad5x-mcu (board update screens) on
Kiln's kernels; the stock kernel draws with cmd_jpeg_display instead.
tools/make_logo.py --raw packs S02ad5x-logo's pre-rendered frames with
frame() below. Not used by the recovery OS.
"""
import os
import sys

W, H = 800, 480


def fail(msg):
    sys.stderr.write("ad5x-fb-show: %s\n" % msg)
    sys.exit(1)


def read_int(path):
    with open(path) as f:
        return int(f.read().strip())


def rgb565(im):
    """RGB image -> little-endian RGB565 bytes (Pillow 12 has no packer
    for it): low byte GGGBBBBB, high byte RRRRRGGG."""
    from PIL import Image, ImageChops
    r, g, b = im.split()
    hi = ImageChops.add(r.point(lambda v: v & 0xf8), g.point(lambda v: v >> 5))
    lo = ImageChops.add(g.point(lambda v: (v << 3) & 0xe0), b.point(lambda v: v >> 3))
    return Image.merge("LA", (lo, hi)).tobytes()


def frame(im, bpp, stride):
    """The first frame's bytes for an 800x480 RGB image."""
    if bpp == 32:
        data = im.tobytes("raw", "BGRX")
    elif bpp == 16:
        data = rgb565(im)
    else:
        raise ValueError("%d bits per pixel not supported" % bpp)
    line = W * bpp // 8
    if stride < line:
        raise ValueError("stride %d is less than %d pixels (%d bytes)" % (stride, W, line))
    if stride > line:
        pad = bytes(stride - line)
        data = b"".join(data[i:i + line] + pad for i in range(0, len(data), line))
    return data


def main(argv):
    if len(argv) < 2 or len(argv) > 4 or argv[1].startswith("-"):
        sys.stderr.write(__doc__)
        return 2
    img = argv[1]
    fb = argv[2] if len(argv) > 2 else "/dev/fb0"
    sysdir = argv[3] if len(argv) > 3 else "/sys/class/graphics/" + os.path.basename(fb)
    try:
        bpp = read_int(sysdir + "/bits_per_pixel")
        stride = read_int(sysdir + "/stride")
    except (OSError, ValueError) as e:
        fail("no framebuffer format in %s (%s): nothing written" % (sysdir, e))
    if bpp not in (16, 32):
        fail("%s: %d bits per pixel not supported: nothing written" % (fb, bpp))
    if stride < W * bpp // 8:
        fail("%s: stride %d is less than %d pixels: nothing written" % (fb, stride, W))
    from PIL import Image
    try:
        im = Image.open(img).convert("RGB")
        if im.size != (W, H):
            im = im.resize((W, H))
        data = frame(im, bpp, stride)
    except (OSError, ValueError) as e:
        fail("%s: %s: nothing written" % (img, e))
    # No O_CREAT: without a framebuffer, no stray file named fb0 in /dev
    try:
        fd = os.open(fb, os.O_WRONLY)
        try:
            view = memoryview(data)
            while view:
                n = os.write(fd, view)
                if n <= 0:
                    raise OSError("short write, %d bytes left" % len(view))
                view = view[n:]
        finally:
            os.close(fd)
    except OSError as e:
        fail("%s: %s" % (fb, e))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
