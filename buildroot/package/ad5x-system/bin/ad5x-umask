#!/bin/sh
# Owner's switch for root's SSH sessions (docs/deviations-from-stock.md).
# Run as root over SSH:
#   ad5x-umask on      files root creates are readable by plugins and the
#                      web server (umask 022, the default)
#   ad5x-umask off     private files (077)
#   ad5x-umask status
# The SSH service reads the setting when it starts: restart it with
#   /etc/init.d/S50dropbear restart
# or reboot. Restarting closes SSH sessions. The services set their own
# umask (022) whatever this says, and files with secrets (Wi-Fi passwords,
# SSH keys, grants) get their modes where they are written.
# /data/ad5x/umask-root was the old file (off, 077, by default): removed.
set -f

FILE=${AD5X_UMASK_FILE:-/data/ad5x/umask-ssh}
OLD=${AD5X_UMASK_OLD:-/data/ad5x/umask-root}
LOG=${AD5X_UMASK_LOG:-/data/ad5x/umask.log}

die() { echo "ad5x-umask: $*" >&2; exit 1; }

# AD5X_UMASK_TEST lets the laptop test run this as a normal user
if [ "$(id -u)" != 0 ] && [ -z "$AD5X_UMASK_TEST" ]; then
	die "must run as root"
fi

current() {
	if [ "$(cat "$FILE" 2>/dev/null)" = 077 ]; then
		echo off
	else
		echo on
	fi
}

log() {
	echo "$(date '+%Y-%m-%d %H:%M:%S') root SSH umask $1" >> "$LOG"
}

case "$1" in
on)
	rm -f "$OLD"
	rm -f "$FILE" || die "cannot remove $FILE"
	log "022 (on)"
	echo "Root SSH files readable by plugins and the web server (022, the default)."
	echo "Applies after: /etc/init.d/S50dropbear restart (closes SSH) or reboot."
	;;
off)
	rm -f "$OLD"
	mkdir -p "$(dirname "$FILE")"
	echo 077 > "$FILE.tmp" && sync && mv "$FILE.tmp" "$FILE" || die "cannot write $FILE"
	log "077 (off)"
	echo "Root SSH files private (077). 'ad5x-umask on' goes back to the default."
	echo "Applies after: /etc/init.d/S50dropbear restart (closes SSH) or reboot."
	;;
status)
	echo "root SSH umask: $(current) ($([ "$(current)" = on ] && echo 022 || echo 077))"
	;;
*)
	echo "usage: ad5x-umask on | off | status" >&2
	exit 2
	;;
esac
