#!/bin/sh
# The boards' Klipper firmware (docs/mcu-flashing.md, "Automatic updates").
#
# Kiln OS needs mainline Klipper on the mainboard and on the toolhead board
# (eboard), at the version this image was tested against
# (/usr/share/ad5x/mcu/VERSION, from klipper/mcu-dicts/FLASHED). At every
# start (S60ad5x-eboard) "boot" checks both and flashes the ones that differ,
# with Kiln OS's own flashers (ad5x-flash-n32, ad5x-flash-iap, and ad5x-flash-ifs,
# a link to ad5x-flash-iap). Flashforge's binaries (NationsCommand, IAPCommand,
# ifsF37, IFSCommand) are not used at all; nothing from them is copied to the
# printer or kept in our images:
#   - mainboard: Klipper "identify" on ttyS2; any other answer (or none):
#     ad5x-flash-n32 through the chip's ROM bootloader (BOOT0/NRST over GPIO),
#     verified, then identified again;
#   - eboard: only its bootloader can write it, and that waits after
#     power-on and after a reset ("Ready" on ttyS5). If it waits and the
#     last eboard flash on record isn't this version: ad5x-flash-iap, then
#     start it ('A'). If its application already runs (a warm restart) with
#     another version, it is asked for the bootloader (Klipper's serial
#     bootloader request: it resets into it), then flashed the same way.
#     Only when that fails (Flashforge's application, no answer, a failed
#     write) the screen asks for a power-cycle; the next start flashes it;
#   - IFS (filament unit), only with /data/ad5x/ifs-klipper.enable: Klipper
#     "identify" on ttyS4 (115200); any other answer: ad5x-flash-ifs (F37
#     entry, then the write; the F37 step erases the bootloader's flag page
#     and resets into it). A failure here doesn't
#     hold Klipper back: printer.cfg says whether it needs the IFS.
# Before writing a board, stock's own board update is armed (Update and
# UpdateM in stock's control directory): Kiln OS never runs it, but if stock
# ever starts again (a failed first start, ad5x-restore-stock) it flashes
# Flashforge's images back by itself.
# When both boards run this version, /data/ad5x/klipper.enable is created
# once (S61klipper starts Klipper only with it). Before the screen asks for
# a power-cycle, this start counts as complete (S99ad5x-booted): otherwise
# the try-once boot flag would still point at the recovery OS and the
# power-cycle the screen asks for would start the recovery OS instead.
#
# usage: ad5x-mcu boot                 at start-up (S60ad5x-eboard)
#        ad5x-mcu status               versions on the boards and wanted, the
#                                      IFS on Klipper or Flashforge's firmware
#                                      (not while Klipper runs: it holds the
#                                      ports)
#        ad5x-mcu flash-mainboard      flash the mainboard now (refused while
#                                      Klipper runs)
#        ad5x-mcu flash-eboard         flash the eboard now, without a
#                                      power-cycle: its Klipper application
#                                      restarts into the bootloader on
#                                      request (nothing is sent when the
#                                      bootloader already waits; refused
#                                      while Klipper runs)
#        ad5x-mcu flash-ifs [HEX|stock] flash the IFS now: this version, HEX,
#                                      or "stock": Flashforge's ifs.hex from
#                                      this printer's usershare backup
#                                      (refused while Klipper runs; Klipper
#                                      only with ifs-klipper.enable). If its
#                                      bootloader doesn't answer, it keeps
#                                      trying for 2 minutes: unplug the IFS
#                                      cable and plug it back in. HEX with
#                                      Flashforge's firmware (stock ifs.hex),
#                                      or "stock": no enable file needed,
#                                      checked with F19, not as Klipper, and
#                                      ifs-klipper.enable is removed
#        ad5x-mcu ifs-status KEY=VALUE...
#                                      change lines of $IFS_FW_STATUS (the
#                                      root update agent's IFS firmware
#                                      switch writes it this way)
#        ad5x-mcu arm-stock            arm stock's own board update
#        ad5x-mcu tools                check the flashing tools are installed
# /data/ad5x/mcu.disable: "boot" only starts the eboard, flashes nothing.
# /data/ad5x/ifs-klipper.enable: "boot" also keeps the IFS on this version.
# Log: /data/ad5x/mcu/log.
#
# Test overrides: AD5X_DATA (/data), AD5X_SYS (/sys), AD5X_DEV (/dev),
# AD5X_RUN (/run/ad5x), AD5X_MCU_FW (/usr/share/ad5x/mcu),
# AD5X_USERSHARE (a directory holding stock's PROGRAM/ instead of mounting
# the usershare partition), AD5X_SCREENS (/usr/share/ad5x/screens),
# AD5X_KERNEL (stock|own), AD5X_BOOTED (/etc/init.d/S99ad5x-booted).
# IFS_FW_STATUS: set by the update agent's IFS firmware switch
# (S68ad5x-update-agent): flash-ifs writes its progress there (phase) and,
# when it fails, why (reason: bad_image, no_stock_firmware, no_bootloader,
# flash_failed, no_answer).
: "${AD5X_DATA:=/data}" "${AD5X_SYS:=/sys}" "${AD5X_DEV:=/dev}" "${AD5X_RUN:=/run/ad5x}"
: "${AD5X_MCU_FW:=/usr/share/ad5x/mcu}" "${AD5X_SCREENS:=/usr/share/ad5x/screens}"
ST=$AD5X_DATA/ad5x/mcu
LOG=$ST/log
MB=$AD5X_DEV/ttyS2
EB=$AD5X_DEV/ttyS5
IFS_PORT=$AD5X_DEV/ttyS4
WANT=$(cat "$AD5X_MCU_FW/VERSION" 2>/dev/null)
# The IFS's own version (IFS_VERSION); an image without it uses VERSION
IFS_WANT=$(cat "$AD5X_MCU_FW/IFS_VERSION" 2>/dev/null)
IFS_WANT=${IFS_WANT:-$WANT}

say() { echo "ad5x-mcu: $*"; echo "$(date '+%F %T') $*" >> "$LOG" 2>/dev/null; }
blog() { command -v ad5x-bootlog >/dev/null 2>&1 && ad5x-bootlog "  mcu: $*" 2>/dev/null; true; }
ver() {	# PORT -> the version its firmware reports, empty if none answers
	ad5x-mcu-version --port "$1" --baud 230400 --timeout "${2:-3}" 2>/dev/null
}
secs() {	# seconds since boot: no RTC, so the clock jumps when NTP sets it (10 min, 2026-11-05)
	s=$(cut -d. -f1 /proc/uptime 2>/dev/null)
	echo "${s:-$(date +%s)}"
}
eboard_runs() {	# [SECONDS] the eboard application answers with WANT within SECONDS (60); logs how long it took
	t0=$(secs); end=$((t0 + ${1:-60}))
	while :; do
		[ "$(ver "$EB" 5)" = "$WANT" ] && { say "eboard: answers $WANT after $(( $(secs) - t0 )) s"; return 0; }
		[ "$(secs)" -lt $end ] || return 1
	done
}
eboard_to_bootloader() {	# the eboard's Klipper application into its bootloader; 0 when it waits
	# Klipper restarts into the bootloader when it gets the 32-byte serial
	# request (patch 0002: a plain reset, after which the bootloader waits,
	# as after power-on). Flashforge's application may not know it.
	# A non-blocking open with CLOCAL, within 10 s: this runs before Klipper,
	# Moonraker and the screen start, so a stuck port must not hold them.
	# A SYNC (~) first ends any half-sent block, then the request.
	limit 10 python3 -c 'import os, sys, termios, tty
fd = os.open(sys.argv[1], os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
tty.setraw(fd)
a = termios.tcgetattr(fd)
a[2] |= termios.CLOCAL | termios.CREAD
a[4] = a[5] = termios.B230400
termios.tcsetattr(fd, termios.TCSANOW, a)
os.write(fd, b"\x7e \x1c Request Serial Bootloader!! ~")
termios.tcdrain(fd)
os.close(fd)' "$EB" 2>/dev/null || return 1
	boot_eboard --port "$EB" --listen 2>/dev/null
}
eboard_soft_flash() {	# [waiting] flash the eboard, no power-cycle; 0 when it runs WANT
	# Its application runs (another version): asked for the bootloader first.
	# "waiting": its bootloader already waits, nothing is sent before the
	# write (the request, at 230400, would reach it as noise at 115200).
	rm -f "$ST/eboard"	# the board is about to be written: the old record no longer holds
	if [ "${1:-}" != waiting ]; then
		say "eboard: asking its application for the bootloader"
		eboard_to_bootloader || { say "eboard: no bootloader after the request"; return 1; }
	fi
	flash_eboard || return 1
	# flash_eboard may have started it already (a start reply other than ACK)
	eboard_runs 5 && return 0
	boot_eboard --port "$EB" 2>/dev/null || say "eboard: no start after 'A'"
	eboard_runs 30
}
ifs_ver() {	# [TIMEOUT] -> the version the IFS reports as Klipper, empty if none answers
	ad5x-mcu-version --port "$IFS_PORT" --baud 115200 --timeout "${1:-3}" 2>/dev/null
}
kernel() {
	[ -n "$AD5X_KERNEL" ] && { echo "$AD5X_KERNEL"; return; }
	case "$(uname -r)" in 5.10.*) echo stock ;; *) echo own ;; esac
}
show() {	# screen NAME or a JPEG path (best effort; HelixScreen starts later)
	case "$1" in /*) f=$1 ;; *) f=$AD5X_SCREENS/$1.jpg ;; esac
	echo "$(date '+%F %T') screen ${f##*/}" >> "$LOG" 2>/dev/null
	[ -f "$f" ] && [ -e "$AD5X_DEV/fb0" ] || return 0
	if [ "$(kernel)" = stock ]; then
		cmd_jpeg_display "$f" >/dev/null 2>&1
	else
		# at the framebuffer's depth (32 bpp on 6.6, 16 on 7.3); then frame
		# 0 and the backlight, as S07ad5x-board does (6.6's backlight
		# probes powered off: lit here too, in case S07 hasn't yet)
		if msg=$(ad5x-fb-show "$f" "$AD5X_DEV/fb0" "$AD5X_SYS/class/graphics/fb0" 2>&1); then
			echo 0,0 > "$AD5X_SYS/class/graphics/fb0/pan" 2>/dev/null
			for b in "$AD5X_SYS"/class/backlight/*; do
				[ -e "$b/bl_power" ] && echo 0 > "$b/bl_power" 2>/dev/null
				[ -e "$b/brightness" ] && cat "$b/max_brightness" > "$b/brightness" 2>/dev/null
			done
		else
			echo "$(date '+%F %T') screen not shown: $msg" >> "$LOG" 2>/dev/null
		fi
	fi
	true
}
klippy_running() {	# Klipper holds both ports: asking a board would break its link
	ps w 2>/dev/null | grep -v grep | grep -q "klippy/klippy.py"
}
part() {	# GPT name -> device
	for u in "$AD5X_SYS"/class/block/*/uevent; do
		grep -qx "PARTNAME=$1" "$u" 2>/dev/null || continue
		echo "$AD5X_DEV/$(sed -n 's/^DEVNAME=//p' "$u")"; return 0
	done
	return 1
}

# Stock's control directory (the newest version dir, as stock's own
# app_startup.sh picks it) on the usershare partition, mounted at $US.
US=
us_mount() {	# ro|rw
	if [ -n "$AD5X_USERSHARE" ]; then US=$AD5X_USERSHARE; return 0; fi
	dev=$(part usershare) || { say "no usershare partition"; return 1; }
	US=$AD5X_RUN/usershare
	mkdir -p "$US"
	umount "$US" 2>/dev/null
	mount -t ext4 -o "$1" "$dev" "$US" 2>/dev/null || { say "can't mount $dev ($1)"; return 1; }
}
us_umount() { [ -n "$AD5X_USERSHARE" ] || { sync; umount "$US" 2>/dev/null; }; }
control_dir() {
	best=
	for d in "$US"/PROGRAM/control/[0-9]*; do
		[ -d "$d" ] || continue
		v=${d##*/}
		if [ -z "$best" ] || [ "$(printf '%s\n%s\n' "${best##*/}" "$v" |
			awk -F. '{ k = sprintf("%06d%06d%06d", $1, $2, $3); print k " " $0 }' |
			sort | tail -1 | cut -d' ' -f2)" = "$v" ]; then
			best=$d
		fi
	done
	[ -n "$best" ] && echo "$best"
}

tools() {	# the flashing tools are installed with the image
	command -v ad5x-flash-n32 >/dev/null 2>&1 && command -v ad5x-flash-iap >/dev/null 2>&1 && return 0
	say "flashing tools missing: ad5x-flash-n32 or ad5x-flash-iap (reinstall the image)"
	return 1
}

arm_stock() {	# stock's own board update at its next start
	us_mount rw || return 1
	c=$(control_dir)
	if [ -z "$c" ]; then
		say "no stock control directory on usershare: stock can't restore the boards itself"
		us_umount; return 1
	fi
	ok=1
	for f in AD5X.bin ADM_App.hex run.sh; do
		[ -f "$c/$f" ] || { say "stock control ${c##*/}: $f missing"; ok=; }
	done
	if [ -n "$ok" ] && [ -f "$c/md5sum.list" ]; then
		( cd "$c" && grep -E ' (\./)?(AD5X\.bin|ADM_App\.hex)$' md5sum.list | md5sum -c -s - ) ||
			{ say "stock control ${c##*/}: images don't match md5sum.list"; ok=; }
	fi
	touch "$c/Update" "$c/UpdateM"
	rc=$?
	us_umount
	[ $rc = 0 ] || { say "couldn't arm stock's board update"; return 1; }
	if [ -n "$ok" ]; then
		say "armed stock's board update (${c##*/}): stock restores its board firmware when it starts"
	else
		say "armed stock's board update (${c##*/}), but its images look incomplete"
	fi
}

flash_mainboard() {
	tools || return 1
	say "mainboard: flashing $WANT (ad5x-flash-n32)"
	ad5x-flash-n32 -p "$MB" --uid-file "$ST/mainboard.uid" "$AD5X_MCU_FW/mainboard.bin" > "$ST/nations.log" 2>&1
	rc=$?
	if [ $rc != 0 ] || ! grep -q "verification succeeded" "$ST/nations.log"; then
		say "mainboard: flashing failed (exit $rc, $ST/nations.log)"
		return 1
	fi
	sleep 1
	v=$(ver "$MB")
	[ "$v" = "$WANT" ] || { say "mainboard: flashed, but it reports '${v:-nothing}'"; return 1; }
	say "mainboard: $WANT"
}

flash_eboard() {	# the bootloader must be waiting
	tools || return 1
	say "eboard: flashing $WANT (ad5x-flash-iap)"
	ad5x-flash-iap -p "$EB" "$AD5X_MCU_FW/eboard.hex" > "$ST/iap.log" 2>&1
	rc=$?
	# ad5x-flash-iap sends 'A' after EOT and wants ACK back. Another reply (R, seen
	# on the printer 2026-11-04) doesn't say the start failed: the image is written.
	# After R the bootloader waits again: the application never answered in a
	# 4-minute wait, and answered at once after boot_eboard's 'A' (2026-11-05).
	# So start it again, then ask for its version: this version counts as started.
	if [ $rc != 0 ] && grep -q "STM32Write: success" "$ST/iap.log" && ! grep -q "HD" "$ST/iap.log"; then
		boot_eboard --port "$EB" 2>/dev/null || say "eboard: no start after R and 'A'"
		if eboard_runs 60; then
			say "eboard: start reply not ACK (ad5x-flash-iap), but it runs $WANT"
			rc=0
		else
			say "eboard: written, but the application did not start (power-cycle the eboard)"
		fi
	fi
	# exit 0 with "Update :HD" means nothing was written
	if [ $rc != 0 ] || ! grep -q "STM32Write: success" "$ST/iap.log" || grep -q "HD" "$ST/iap.log"; then
		say "eboard: flashing failed (exit $rc, $ST/iap.log)"
		rm -f "$ST/eboard"
		return 1
	fi
	echo "$WANT" > "$ST/eboard"
}

limit() {	# SECONDS CMD...: run CMD, killed after SECONDS
	l=$1; shift
	"$@" & lp=$!
	( sleep "$l"; kill $lp 2>/dev/null ) & lk=$!
	wait $lp; lrc=$?
	kill $lk 2>/dev/null
	return $lrc
}

ifs_f19() {	# the version Flashforge's firmware on the IFS reports, empty if none answers
	python3 - "$IFS_PORT" 2>/dev/null <<'EOF'
import os, sys, termios, time
fd = os.open(sys.argv[1], os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
a = termios.tcgetattr(fd)
a[0] = a[1] = a[3] = 0
a[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
a[4] = a[5] = termios.B115200
termios.tcsetattr(fd, termios.TCSANOW, a)
termios.tcflush(fd, termios.TCIOFLUSH)
os.write(fd, b"F19\r\n")
time.sleep(1)
try:
    r = os.read(fd, 256).decode("ascii", "replace")
except OSError:
    r = ""
if "version:" in r:
    print(r.split("version:")[-1].strip(" ."))
EOF
}

ifs_status() {	# KEY=VALUE...: change those lines of $IFS_FW_STATUS, replace it atomically
	for k in target state phase reason message version; do
		eval "st_$k=\$(sed -n \"s/^$k=//p\" \"\$IFS_FW_STATUS\" 2>/dev/null)"
	done
	for kv; do
		case $kv in
		target=*) st_target=${kv#*=} ;;
		state=*) st_state=${kv#*=} ;;
		phase=*) st_phase=${kv#*=} ;;
		reason=*) st_reason=${kv#*=} ;;
		message=*) st_message=${kv#*=} ;;
		version=*) st_version=${kv#*=} ;;
		esac
	done
	mkdir -p "${IFS_FW_STATUS%/*}"
	printf 'target=%s\nstate=%s\nphase=%s\nreason=%s\nmessage=%s\nversion=%s\n' \
		"$st_target" "$st_state" "$st_phase" "$st_reason" "$st_message" "$st_version" \
		> "$IFS_FW_STATUS.tmp" && mv "$IFS_FW_STATUS.tmp" "$IFS_FW_STATUS"
}
ifs_progress() {	# PHASE: only while the agent's switch runs (IFS_FW_STATUS)
	[ -z "$IFS_FW_STATUS" ] || ifs_status phase="$1"
}
ifs_fail() {	# REASON: why the switch failed, for the agent (IFS_FW_STATUS)
	[ -z "$IFS_FW_STATUS" ] || ifs_status reason="$1"
}

# ifs_hex_ok HEX: HEX is an image the IFS bootloader can take, checked
# before anything is sent (F37 already erases the bootloader's flag page):
# every record well formed with a right checksum, one end-of-file record
# at the end, the data from 0x08010000 (where the bootloader puts the
# first block; ad5x-flash-ifs sends no address) to below 0x08080000
# (512 KiB of flash), a stack pointer the bootloader accepts
# ((SP & 0x2FFE0000) == 0x20000000; it starts no other application) and a
# reset vector in the image (Thumb). Prints why not.
ifs_hex_ok() {
	python3 - "$1" <<'EOF'
import sys
START, END = 0x08010000, 0x08080000
def bad(why):
    print(why)
    sys.exit(1)
try:
    lines = [l.strip() for l in open(sys.argv[1], errors="replace")]
except OSError as e:
    bad("can't read it: %s" % e.strerror)
lines = [l for l in lines if l]
if not lines:
    bad("empty")
data, base, eof = {}, 0, False
for n, l in enumerate(lines, 1):
    if eof:
        bad("data after the end-of-file record (line %d)" % n)
    if not l.startswith(":") or len(l) < 11:
        bad("not an Intel hex record (line %d)" % n)
    try:
        b = bytes.fromhex(l[1:])
    except ValueError:
        bad("not an Intel hex record (line %d)" % n)
    if len(b) != b[0] + 5 or sum(b) & 0xff:
        bad("bad length or checksum (line %d)" % n)
    kind, addr, payload = b[3], (b[1] << 8) | b[2], b[4:-1]
    if kind == 0:
        for i, v in enumerate(payload):
            a = base + addr + i
            if a in data:
                bad("address 0x%08X written twice (line %d)" % (a, n))
            data[a] = v
    elif kind == 1:
        eof = True
    elif kind == 2 and len(payload) == 2:
        base = ((payload[0] << 8) | payload[1]) << 4
    elif kind == 4 and len(payload) == 2:
        base = ((payload[0] << 8) | payload[1]) << 16
    elif kind in (3, 5) and len(payload) == 4:
        pass
    else:
        bad("unknown record type %d (line %d)" % (kind, n))
if not eof:
    bad("no end-of-file record")
if not data:
    bad("no data")
lo, hi = min(data), max(data)
if lo != START:
    bad("starts at 0x%08X, not 0x%08X" % (lo, START))
if hi >= END:
    bad("ends at 0x%08X, past the IFS's flash" % hi)
if any(START + i not in data for i in range(8)):
    bad("no vector table at 0x%08X" % START)
word = lambda a: sum(data[a + i] << (8 * i) for i in range(4))
sp, reset = word(START), word(START + 4)
if sp & 0x2FFE0000 != 0x20000000:
    bad("stack pointer 0x%08X: the IFS bootloader would not start it" % sp)
if not reset & 1 or not START <= reset & ~1 <= hi:
    bad("reset vector 0x%08X is not in the image" % reset)
EOF
}

flash_ifs() {	# HEX WHAT: write HEX to the IFS (WHAT for the log)
	command -v ad5x-flash-ifs >/dev/null 2>&1 || { say "ifs: ad5x-flash-ifs missing (reinstall the image)"; ifs_fail flash_failed; return 1; }
	if ! why=$(ifs_hex_ok "$1" 2>&1); then
		say "ifs: $1 is not an IFS image (${why:-python3 failed}): nothing sent to the IFS"
		ifs_fail bad_image; return 1
	fi
	say "ifs: flashing $2 (ad5x-flash-ifs)"
	ifs_progress writing
	end=$(( $(secs) + ${IFS_WAIT:-0} )) told=
	while :; do
		# ad5x-flash-ifs (= ad5x-flash-iap) sends F37 itself, then writes the IFS.
		# F37 on every try: after the cable is plugged back in, the IFS may run
		# its application again (an F37 that got lost), and only F37 gets it
		# into the bootloader; a bootloader that already waits ignores it.
		# Nothing after EOT (--no-start): the IFS bootloader starts the application
		# itself, as with stock IFSCommand; an 'A' there left the application erased
		ad5x-flash-ifs --f37 --no-start -p "$IFS_PORT" -w 20 "$1" > "$ST/ifs.log" 2>&1
		rc=$?
		if [ $rc = 0 ] && grep -q "STM32Write: success" "$ST/ifs.log" && ! grep -q "HD" "$ST/ifs.log"; then
			# written; flash_ifs_klipper checks the version the IFS then reports
			return 0
		fi
		if grep -q "Can not connect" "$ST/ifs.log" && [ "$(secs)" -lt $end ]; then
			if [ -z "$told" ]; then
				say "ifs: no bootloader answers: unplug the IFS cable and plug it back in"
				ifs_progress replug
			fi
			told=1; continue
		fi
		if grep -q "Can not connect" "$ST/ifs.log"; then
			say "ifs: no bootloader answered (exit $rc, $ST/ifs.log)"
			ifs_fail no_bootloader
		else
			say "ifs: flashing failed (exit $rc, $ST/ifs.log)"
			ifs_fail flash_failed
		fi
		return 1
	done
}

flash_ifs_klipper() {	# HEX [WANT]: Klipper firmware; WANT empty: any version
	[ -f "$1" ] || { say "ifs: no $1"; ifs_fail bad_image; return 1; }
	flash_ifs "$1" "${2:-$1}" || return 1
	ifs_progress verifying
	sleep 2
	v=$(ifs_ver 3)
	if [ -z "$v" ] || { [ -n "$2" ] && [ "$v" != "$2" ]; }; then
		say "ifs: flashed, but it reports '${v:-nothing}'"; rm -f "$ST/ifs"; ifs_fail no_answer; return 1
	fi
	echo "$v" > "$ST/ifs"
	say "ifs: $v"
}

ifs_hex_stock() {	# HEX: 0 when HEX is Flashforge's IFS firmware (it carries its F19 answer)
	# Stock's ifs.hex holds "F19 ok. four color. version: 3.0.7" as plain
	# text; a Klipper build has no such string (its own strings are IDs in a
	# compressed data dictionary). Kiln's ifs.hex itself is always Klipper.
	[ -f "$1" ] || return 1
	[ -f "$AD5X_MCU_FW/ifs.hex" ] && cmp -s "$1" "$AD5X_MCU_FW/ifs.hex" && return 1
	python3 - "$1" 2>/dev/null <<'EOF'
import sys
d = bytearray()
for l in open(sys.argv[1], errors="replace"):
    l = l.strip()
    if not l.startswith(":"):
        continue
    try:
        b = bytes.fromhex(l[1:])
    except ValueError:
        continue
    if len(b) > 4 and b[3] == 0:
        d += b[4:4 + b[0]]
sys.exit(0 if b"F19 ok." in d else 1)
EOF
}

stock_check() {	# stock's ifs.hex in $SH, its md5 checked; mounted. Else STOCK_ERR, unmounted
	SH=
	us_mount ro || { STOCK_ERR="can't read the usershare partition"; return 1; }
	c=$(control_dir)
	if [ -z "$c" ]; then
		STOCK_ERR="no control directory on the usershare partition"
		us_umount; return 1
	fi
	want=$(sed -n 's|^\([0-9a-fA-F]*\)[ *]*\(\./\)\{0,1\}ifs\.hex$|\1|p' "$c/md5sum.list" 2>/dev/null | head -1)
	if [ -z "$want" ] || [ ! -f "$c/ifs.hex" ]; then
		STOCK_ERR="stock ${c##*/} has no ifs.hex with an md5sum.list entry"
		us_umount; return 1
	fi
	if [ "$(md5sum < "$c/ifs.hex" | cut -d' ' -f1)" != "$want" ]; then
		STOCK_ERR="stock ${c##*/}: ifs.hex doesn't match md5sum.list"
		us_umount; return 1
	fi
	if ! ifs_hex_stock "$c/ifs.hex"; then
		STOCK_ERR="stock ${c##*/}: ifs.hex is not Flashforge's IFS firmware"
		us_umount; return 1
	fi
	SH=$c/ifs.hex
}

flash_ifs_stock() {	# HEX: Flashforge's firmware back on the IFS; 0 when it answers F19
	[ -f "$1" ] || { say "ifs: no $1"; ifs_fail no_stock_firmware; return 1; }
	flash_ifs "$1" "$1 (Flashforge's firmware)" || return 1
	ifs_progress verifying
	rm -f "$ST/ifs"
	# Klipper is gone from the IFS: "boot" must not write it back, and
	# S61klipper leaves the IFS to ifs.py's serial link
	if [ -f "$AD5X_DATA/ad5x/ifs-klipper.enable" ]; then
		rm -f "$AD5X_DATA/ad5x/ifs-klipper.enable"
		say "ifs: Klipper IFS off ($AD5X_DATA/ad5x/ifs-klipper.enable removed; create it again to go back to Klipper)"
	fi
	sleep 2
	n=0
	while :; do
		v=$(ifs_f19)
		[ -n "$v" ] && break
		n=$((n + 1)); [ $n -lt 3 ] || break
		sleep 1
	done
	if [ -z "$v" ]; then
		say "ifs: Flashforge's firmware written, but it doesn't answer F19 (switch the printer off and on; $ST/ifs.log)"
		ifs_fail no_answer
		return 1
	fi
	echo "flashforge $v" > "$ST/ifs"
	say "ifs: flashforge $v (Flashforge's firmware, not Klipper)"
}

boot() {
	mkdir -p "$ST"
	if [ -f "$AD5X_DATA/ad5x/mcu.disable" ]; then
		say "mcu.disable: no board updates"
		boot_eboard --port "$EB"; return 0
	fi
	[ -n "$WANT" ] || { say "no firmware in $AD5X_MCU_FW"; boot_eboard --port "$EB"; return 1; }
	armed=
	arm() {	# before the first write: tools present, stock's way back armed
		[ -z "$armed" ] || return 0
		tools || return 1
		arm_stock; armed=1; show mcu-updating
	}
	failed= mbflashed=
	# The mainboard's version and whether the eboard's bootloader waits,
	# at the same time (two ports; each takes 1-2 s at start-up)
	ver "$MB" > "$ST/.mbver" 2>/dev/null &
	vpid=$!
	listen=1
	boot_eboard --port "$EB" --listen 2>/dev/null && listen=0
	wait $vpid
	mv=$(cat "$ST/.mbver" 2>/dev/null); rm -f "$ST/.mbver"
	# Mainboard: can be flashed at any time
	if [ "$mv" != "$WANT" ]; then
		say "mainboard runs '${mv:-nothing}', want $WANT"
		{ arm && flash_mainboard; } || failed=1
		mbflashed=1
		# look again after the mainboard's restart
		listen=1
		boot_eboard --port "$EB" --listen 2>/dev/null && listen=0
	fi
	# Eboard: its bootloader waits after power-on (or after a reset, as
	# below); a running application is asked for it further down
	if [ $listen = 0 ]; then
		if [ "$(cat "$ST/eboard" 2>/dev/null)" != "$WANT" ]; then
			{ arm && flash_eboard; } || failed=1
		fi
		boot_eboard --port "$EB" || say "eboard: no start after 'A'"
	fi
	# An application that answers with another version won't change by
	# waiting; otherwise give it up to 60 s to start
	ev=$(ver "$EB")
	if [ -z "$ev" ] || [ "$ev" = "$WANT" ]; then
		eboard_runs && ev=$WANT || ev=$(ver "$EB")
	fi
	# Its application runs, another version: try the bootloader on
	# request first; the power-cycle only when that doesn't work
	if [ -n "$ev" ] && [ "$ev" != "$WANT" ]; then
		say "eboard runs '$ev', want $WANT"
		if arm && eboard_soft_flash; then
			ev=$WANT
		else
			ev=$(ver "$EB")
		fi
	fi
	if [ "$ev" = "$WANT" ]; then
		echo "$WANT" > "$ST/eboard"
	else
		rm -f "$ST/eboard"	# flash it at the next power-on
		say "eboard runs '${ev:-nothing}', want $WANT: needs a power-cycle"
		[ -n "$failed" ] || failed=power
	fi
	# a flashed mainboard: check what it runs now
	[ -z "$mbflashed" ] || mv=$(ver "$MB" 1)
	# IFS: only when asked for; a failure doesn't hold Klipper back
	if [ -f "$AD5X_MCU_FW/ifs.hex" ] && [ -f "$AD5X_DATA/ad5x/ifs-klipper.enable" ]; then
		iv=$(ifs_ver 1)
		if [ "$iv" != "$IFS_WANT" ]; then
			say "ifs runs '${iv:-something else}', want $IFS_WANT"
			{ arm && flash_ifs_klipper "$AD5X_MCU_FW/ifs.hex" "$IFS_WANT"; } ||
				say "ifs: not updated (ad5x-mcu flash-ifs)"
		fi
	fi
	if [ -z "$failed" ] && [ "$mv" = "$WANT" ]; then
		blog "boards on $WANT"
		if [ ! -f "$ST/klipper-enabled" ]; then
			touch "$AD5X_DATA/ad5x/klipper.enable" "$ST/klipper-enabled"
			say "both boards on $WANT: Klipper enabled"
		fi
		if [ -n "$armed" ]; then	# back to the boot logo
			l=/usr/share/ad5x/logo.jpg
			[ -f "$AD5X_DATA/ad5x/logo.jpg" ] && l=$AD5X_DATA/ad5x/logo.jpg
			show "$l"
		fi
		return 0
	fi
	if [ "$failed" = power ]; then
		"${AD5X_BOOTED:-/etc/init.d/S99ad5x-booted}" start
		show mcu-powercycle; blog "eboard needs a power-cycle"
	else
		show mcu-failed; blog "board update failed (ad5x-mcu status)"
	fi
	return 1
}

status() {
	echo "want=${WANT:-?}"
	if klippy_running; then
		echo "mainboard=(in use by Klipper)"
		echo "eboard=(in use by Klipper)"
	else
		echo "mainboard=$(ver "$MB" 2)"
		echo "eboard=$(ver "$EB" 2)"
	fi
	echo "eboard_flashed=$(cat "$ST/eboard" 2>/dev/null)"
	if command -v ad5x-flash-n32 >/dev/null 2>&1 && command -v ad5x-flash-iap >/dev/null 2>&1; then
		echo "tools=ok"
	else
		echo "tools=missing"
	fi
	[ -f "$AD5X_DATA/ad5x/mcu.disable" ] && echo "disabled=1"
	# IFS: Flashforge's firmware (the default) or Klipper with the enable file.
	# While Klipper runs it holds ttyS4 either way (ifs.py's serial link or
	# [mcu ifs]): nothing is sent then. Otherwise the likely firmware is asked
	# first: with the enable file Klipper "identify", then F19; without it
	# F19 (Flashforge's read-only identify; Klipper drops it as noise), then
	# "identify" only if F19 got no answer, so Flashforge's firmware never
	# sees Klipper's binary frames.
	if klippy_running; then
		echo "ifs=(in use by Klipper)"
	elif [ -f "$AD5X_DATA/ad5x/ifs-klipper.enable" ]; then
		v=$(ifs_ver 2)
		[ -n "$v" ] || v=$(ifs_f19 | sed 's/^/flashforge /')
		echo "ifs=$v"
	else
		v=$(ifs_f19 | sed 's/^/flashforge /')
		[ -n "$v" ] || v=$(ifs_ver 2)
		echo "ifs=$v"
	fi
	echo "ifs_flashed=$(cat "$ST/ifs" 2>/dev/null)"
	if command -v ad5x-flash-ifs >/dev/null 2>&1; then
		echo "ifs_tools=ok"
	else
		echo "ifs_tools=missing"
	fi
	if [ -f "$AD5X_DATA/ad5x/ifs-klipper.enable" ]; then
		echo "ifs_klipper_enabled=1"
	else
		echo "ifs_klipper_enabled=0"
	fi
	true
}

case "$1" in
boot) boot ;;
status) status ;;
flash-mainboard)
	klippy_running && { echo "ad5x-mcu: Klipper runs: /etc/init.d/S61klipper stop first" >&2; exit 1; }
	mkdir -p "$ST"; [ -n "$WANT" ] && tools && arm_stock && flash_mainboard ;;
flash-eboard)
	klippy_running && { echo "ad5x-mcu: Klipper runs: /etc/init.d/S61klipper stop first" >&2; exit 1; }
	mkdir -p "$ST"; [ -n "$WANT" ] && tools && arm_stock || exit 1
	# Its bootloader may wait already (after power-on, or an interrupted write)
	if boot_eboard --port "$EB" --listen 2>/dev/null; then
		eboard_soft_flash waiting
	else
		eboard_soft_flash
	fi ;;
flash-ifs)
	# Flashforge's image (the way back to stock) needs no enable file: it is
	# the IFS's default firmware. Klipper on the IFS is the opt-in.
	# "stock": Flashforge's own ifs.hex from this printer's usershare
	# backup (stock's newest control directory, checked against its
	# md5sum.list); nothing from Flashforge is in the image.
	stock=
	if [ "$2" = stock ]; then
		stock=1
	elif [ -n "$2" ] && ifs_hex_stock "$2"; then
		stock=1
	fi
	[ -n "$stock" ] || [ -f "$AD5X_DATA/ad5x/ifs-klipper.enable" ] || {
		echo "ad5x-mcu: no Klipper on the IFS without $AD5X_DATA/ad5x/ifs-klipper.enable (Flashforge's ifs.hex needs none)" >&2; exit 1; }
	klippy_running && { echo "ad5x-mcu: Klipper runs: /etc/init.d/S61klipper stop first" >&2; exit 1; }
	mkdir -p "$ST"; arm_stock
	export IFS_WAIT=120
	if [ "$2" = stock ]; then
		stock_check || { say "ifs: $STOCK_ERR"; ifs_fail no_stock_firmware; exit 1; }
		flash_ifs_stock "$SH"
		rc=$?
		us_umount
		exit $rc
	elif [ -n "$stock" ]; then
		flash_ifs_stock "$2"
	elif [ -z "$2" ]; then
		[ -n "$IFS_WANT" ] && flash_ifs_klipper "$AD5X_MCU_FW/ifs.hex" "$IFS_WANT"
	else
		flash_ifs_klipper "$2"	# another Klipper build
	fi ;;
ifs-status)
	[ -n "$IFS_FW_STATUS" ] || { echo "ad5x-mcu: ifs-status needs IFS_FW_STATUS" >&2; exit 2; }
	shift; ifs_status "$@" ;;
arm-stock) mkdir -p "$ST"; arm_stock ;;
tools) mkdir -p "$ST"; tools ;;
*) sed -n '2,/^# Log:/p' "$0"; exit 2 ;;
esac
