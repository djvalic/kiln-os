#!/usr/bin/env python3
"""Draw the safe-mode screen (lib/safe.sh) on the panel: why, the address
to reach the printer at, and how to get out. Redrawn by S65ad5x-screen
while the address changes. usage: ad5x-safe-screen [OUT.png]"""
import subprocess
import sys
import textwrap

from PIL import Image, ImageDraw, ImageFont


def sh(cmd):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True,
                              text=True, timeout=10).stdout.strip()
    except Exception:
        return ""


def main():
    out = sys.argv[1] if len(sys.argv) > 1 else "/run/ad5x-safe-screen.png"
    ips = sh("ip -4 -o addr show scope global | awk '{print $4}' "
             "| cut -d/ -f1 | tr '\\n' ' '") or "no network yet"
    reason = sh("dd if=/dev/mmcblk0p5 bs=512 skip=1153 count=1 2>/dev/null "
                "| tr -d '\\000' | sed -n 's/^reason //p'") or "-"
    root = sh("grep -o 'root=[^ ]*' /proc/cmdline")
    lines = [("SAFE MODE", 4, (255, 200, 0)), ("", 2, None),
             ("No system slot finished starting, so the printer", 2, None),
             ("started without Klipper, the web UI and plugins.", 2, None),
             ("", 2, None),
             ] + [(t, 2, None) for t in
                  textwrap.wrap("Last fallback: " + reason, 52)[:3]] + [

             ("Running from " + root, 2, None),
             ("", 2, None),
             ("SSH: root@" + ips.strip(), 2, (120, 255, 120)),
             ("ad5x-safe          what happened", 2, None),
             ("ad5x-safe retry    start normally again", 2, None)]
    im = Image.new("RGB", (800, 480), (40, 0, 0))
    try:		# FreeType: real sizes
        fonts = {n: ImageFont.load_default(size=14 * n) for n in (2, 4)}
    except (TypeError, ImportError, OSError):
        fonts = None	# Pillow without FreeType: the bitmap font, scaled
    y = 30
    for text, scale, colour in lines:
        colour = colour or (255, 255, 255)
        if fonts:
            ImageDraw.Draw(im).text((40, y), text, fill=colour,
                                    font=fonts[scale])
            h = 15 * scale
        elif text:
            f = ImageFont.load_default()
            box = f.getbbox(text)
            w, h0 = box[2] + 2, box[3] + 2
            t = Image.new("RGB", (w, h0), (40, 0, 0))
            ImageDraw.Draw(t).text((0, 0), text, fill=colour, font=f)
            t = t.resize((w * scale, h0 * scale), Image.NEAREST)
            im.paste(t, (40, y))
            h = h0 * scale
        else:
            h = 10 * scale
        y += h + 6
    im.save(out)
    return subprocess.call(["ad5x-fb-show", out])


if __name__ == "__main__":
    sys.exit(main())
