#!/bin/sh
# Recovery OS state for scripts and the touch UI: one key=value per line,
# values to the end of the line (may contain spaces).
#
# usage: ad5x-status [--slots]
#   --slots  also mount and identify both slots (slot_a=, slot_b=; slower)
#
# Keys: release, slot, root, flag, flag_at_boot, net_mode (dhcp|static),
# net_if, net_ip (address/prefix, empty without a link), ssh (running|stopped),
# swupdate (running|stopped), web_port, ui (running|absent|stopped),
# update_pending (.swu files waiting in /data/ad5x/update), update_last (last
# line of /data/ad5x/update/last.log), auto (running|done|off: the start-up
# actions, ad5x-recovery-auto, still running, done, or skipped by
# /data/ad5x/recovery/noauto; jobs that need them done wait), stock_saved
# (yes|no: /data/ad5x/stock), vendor (ok|missing|damaged: the printer's own
# drivers in /data/ad5x/vendor), usb (count of mounted USB partitions; details:
# ad5x-usb list), data (mounted|tmpfs), main_trace (last line of the main
# OS's boot trace in the ota partition: how far its last start-up got),
# return_stock (none|unfinished|done: Return to Flashforge firmware,
# /data/ad5x/return-stock/state), return_stock_open (request|usb, empty:
# the page to open at start, ad5x-recovery-auto), bootloader_install
# (none|started|installed|verified|unverified|removed: Kiln's own boot loader,
# /data/ad5x/bootloader/state), bootloader_kind (install|upgrade, empty:
# what that record's run was), bootloader_open (result|resume, empty: its
# page to open at start, ad5x-bootloader-install --verify-start). With
# --slots also bootloader (flashforge|kiln|kiln-spl|unknown),
# bootloader_upgrade (yes|no: "Update Kiln's boot loader" offered, Kiln's
# boot loader of another build there to upgrade) and bootloader_offer
# (yes|no: "Install Kiln's boot loader" offered, the board on the allowlist
# and, for now, /data/ad5x/bootloader-offer.enable there, or an install
# stopped part-way; ad5x-bootloader-install --offer).
. /usr/lib/ad5x-recovery/recovery.sh
running() { pidof "$1" >/dev/null && echo running || echo stopped; }
echo "release=$(cat /etc/ad5x-release 2>/dev/null)"
echo "slot=$(rc_slot)"
echo "root=$(rc_root)"
echo "flag=$(rc_read_flag)"
echo "flag_at_boot=$(cat "$AD5X_RUN/flag-at-boot" 2>/dev/null)"
MODE=dhcp IFACE=
[ -f "$AD5X_DATA/ad5x/network.conf" ] && . "$AD5X_DATA/ad5x/network.conf" 2>/dev/null
[ "$MODE" = static ] || MODE=dhcp
echo "net_mode=$MODE"
ifc=${IFACE:-eth0}
ip=$(ip -4 addr show dev "$ifc" 2>/dev/null | awk '/inet / { print $2; exit }')
if [ -z "$ip" ]; then
	ip=$(ip -4 addr show dev wlan0 2>/dev/null | awk '/inet / { print $2; exit }')
	[ -n "$ip" ] && ifc=wlan0
fi
echo "net_if=$ifc"
echo "net_ip=$ip"
echo "ssh=$(running dropbear)"
echo "swupdate=$(running swupdate)"
echo "web_port=8080"
if [ -x /usr/bin/ad5x-recovery-ui ]; then echo "ui=$(running ad5x-recovery-ui)"; else echo "ui=absent"; fi
echo "update_pending=$(ls "$AD5X_DATA"/ad5x/update/*.swu 2>/dev/null | tr '\n' ' ')"
echo "update_last=$(tail -n 1 "$AD5X_DATA/ad5x/update/last.log" 2>/dev/null)"
if [ -f "$AD5X_RUN/auto.done" ]; then echo "auto=done"
elif [ -e "$AD5X_DATA/ad5x/recovery/noauto" ]; then echo "auto=off"
else echo "auto=running"; fi
[ -f "$AD5X_DATA/ad5x/stock/rootfs.squashfs" ] && echo "stock_saved=yes" || echo "stock_saved=no"
echo "vendor=$(AD5X_DATA=$AD5X_DATA ad5x-vendor status 2>/dev/null | sed -n 's/^vendor=//p')"
echo "usb=$(rc_usb_mounts | wc -l | tr -d ' ')"
fs=$(awk '$2 == "/data" { print $3; exit }' "$AD5X_MOUNTS")
[ "$fs" = ext4 ] && echo "data=mounted" || echo "data=tmpfs"
case "$(sed -n 's/^state=//p' "$AD5X_DATA/ad5x/return-stock/state" 2>/dev/null)" in
started) echo "return_stock=unfinished" ;;
done) echo "return_stock=done" ;;
*) echo "return_stock=none" ;;
esac
echo "return_stock_open=$(cat "$AD5X_RUN/return-stock.open" 2>/dev/null)"
bl=$(sed -n 's/^state=//p' "$AD5X_DATA/ad5x/bootloader/state" 2>/dev/null)
echo "bootloader_install=${bl:-none}"
echo "bootloader_kind=$(sed -n 's/^kind=//p' "$AD5X_DATA/ad5x/bootloader/state" 2>/dev/null)"
echo "bootloader_open=$(cat "$AD5X_RUN/bootloader.open" 2>/dev/null)"
o=$(rc_part ota) && echo "main_trace=$(dd if="$o" bs=1024 skip=64 count=8 2>/dev/null | tr -d '\0' | tail -n 1)"
if [ "$1" = --slots ]; then
	echo "slot_a=$(rc_slot_holds rootfs)"
	echo "slot_b=$(rc_slot_holds rootfs2)"
	command -v ad5x-bootloader-install >/dev/null 2>&1 && ad5x-bootloader-install --offer 2>/dev/null
fi
exit 0
