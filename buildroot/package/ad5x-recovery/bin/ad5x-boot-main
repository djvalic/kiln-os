#!/bin/sh
# Leave recovery: point the boot flag at slot B (the main OS) and reboot.
#
# usage: ad5x-boot-main [--no-reboot] [--force]
#   --no-reboot  only set the flag (the next power-cycle or reboot runs B)
#   --force      skip the check that slot B holds a system
#
# The check: rootfs2 is a squashfs with /linuxrc (our main OS or stock)
# and kernel2 starts with a uImage header. The main OS's try-once points
# the flag back here if its start-up doesn't finish.
# Started by Kiln's U-Boot (ad5x.uboot=1): also gives the main OS fresh
# tries (U-Boot's state and kernel failure records cleared, rc_uboot_fresh
# in recovery.sh), so U-Boot tries 7.3/6.6 again instead of falling back
# here at once.
# Refused while a Return to Flashforge firmware is unfinished
# (ad5x-return-stock: slot B may hold part of stock), even with --force:
# finish it, or drop its record with ad5x-return-stock --forget.
# AD5X_RECOVERY_LIB overrides /usr/lib/ad5x-recovery (tests).
. ${AD5X_RECOVERY_LIB:-/usr/lib/ad5x-recovery}/recovery.sh
noreboot= force=
for a in "$@"; do
	case "$a" in
	--no-reboot) noreboot=1 ;;
	--force) force=1 ;;
	-h|--help) sed -n '2,14p' "$0"; exit 0 ;;
	*) sed -n '2,14p' "$0" >&2; exit 2 ;;
	esac
done
[ "$(sed -n 's/^state=//p' "$AD5X_DATA/ad5x/return-stock/state" 2>/dev/null)" = started ] &&
	rc_die "a Return to Flashforge firmware is not finished (slot B may hold part of stock): finish it on the screen (Return to Flashforge firmware), or ad5x-return-stock --forget"
if [ -z "$force" ]; then
	k=$(rc_part kernel2) && rc_uimage_len "$k" >/dev/null ||
		rc_die "kernel2 holds no uImage (use --force to boot it anyway)"
	holds=$(rc_slot_holds rootfs2)
	case "$holds" in
	ad5x*|stock|recovery*) ;;
	*) rc_die "slot B holds '$holds' (use --force to boot it anyway)" ;;
	esac
	echo "boot-main: slot B holds $holds"
fi
rc_set_flag B || rc_die "setting the boot flag failed"
echo "boot-main: boot flag $(rc_read_flag)"
# Kiln's U-Boot: fresh tries for the main OS (not fatal: U-Boot then
# counts on from what it has)
r=$(rc_uboot_fresh "Boot main OS")
[ -n "$r" ] && echo "boot-main: $r"
[ -n "$noreboot" ] && exit 0
echo "boot-main: rebooting"
sync; reboot
