#!/bin/sh
# Install Kiln's own boot loader (Kiln's SPL and U-Boot proper, u-boot/)
# into this printer's first MiB, from the recovery OS (slot A). Opt-in and
# experimental, at the user's own risk: docs/own-boot-loader.md. The
# recovery screen's "Install Kiln's boot loader (experimental)" runs it,
# offered only on a board on the allowlist (lib/bootloader.sh), and its
# "Update Kiln's boot loader" (--upgrade) when the printer has Kiln's boot
# loader of another build; over SSH it runs on its own. Without it the printer keeps starting as it does
# (Flashforge's SPL and U-Boot, its 5.10 chainloading Kiln's 6.6).
#
# usage: ad5x-bootloader-install [--check] [--upgrade] [--unsupported-board]
#        ad5x-bootloader-install --yes [--upgrade] [--unsupported-board]
#        ad5x-bootloader-install --fingerprint | --status | --offer
#        ad5x-bootloader-install --verify-start
#   --check        (the default) every check, this board's fingerprint, what
#                  would be written and what is done already; writes nothing
#   --yes          do it (or finish it: after a stop or a power cut the work
#                  goes on from what the eMMC already holds). On a disk
#                  with Kiln's boot loader of another build: upgrade it to
#                  this one (see "Upgrade" below)
#   --upgrade      only an upgrade (the recovery screen's "Update Kiln's
#                  boot loader"): with --check or --yes, refused (exit 1,
#                  nothing written) unless the disk holds Kiln's boot loader
#                  of another build to upgrade, or an upgrade that stopped
#                  (the record's kind=upgrade); this build's already (nothing
#                  to do) is fine. Never an install over Flashforge's SPL,
#                  and never a downgrade: an older build than the disk's
#                  (by build time, see --offer) is refused; --yes alone
#                  over SSH does it
#   --unsupported-board  expert override, SSH only: go on although this
#                  board's fingerprint is not on the allowlist (asks for a
#                  typed confirmation on a terminal; never from the touch
#                  screen). Please post the fingerprint in djvalic/kiln-os#68.
#                  It also covers an X2600E (256 MiB; Kiln's SPL sets
#                  it up, but has not run from eMMC on one yet). A chip
#                  it can't tell (bl_variant unknown) is refused anyway
#   --fingerprint  read only: the board's fingerprint as #68's snippet prints
#                  it (of the disk, or under Kiln's boot loader of the saved
#                  stock first MiB, as --offer finds it)
#   --status       read only, quick: the boot loader, its build and the one
#                  this recovery OS carries, a network rescue record in
#                  LBA 2047, and the install record
#   --offer        read only, quick (ad5x-status --slots): bootloader=,
#                  bootloader_upgrade=yes|no and bootloader_offer=yes|no for
#                  the recovery screen. offer: yes on a board on the
#                  allowlist without Kiln's boot loader, or for an install
#                  that stopped part-way. upgrade: yes when
#                  the disk holds Kiln's boot loader of another build,
#                  this one is newer (or its age can't be told) and could
#                  replace it; an older one is not offered. The
#                  saved stock first MiB: /data's, else (a wiped /data) its
#                  copy in usershare's or a mounted USB stick's
#                  kiln-stock-backup/ (usershare mounted read-only for it).
#                  With Kiln's boot loader also bootloader_build= (its
#                  build date), bootloader_carries= (the build this
#                  recovery OS carries, empty without images),
#                  bootloader_same=yes|no and bootloader_carries_newer=
#                  yes|no|unknown, for the screen's status line. Newer or
#                  older by build time: each build's later date of its SPL
#                  and U-Boot (they come from one build of u-boot/, and a
#                  mixed pair is as new as its newer half), the zones
#                  taken into account (lib/bootloader.sh, bl_compare_builds);
#                  unknown when a date is missing or both times are equal
#   --verify-start at the recovery OS's start (ad5x-recovery-auto): the first
#                  start after an install is recorded (by Kiln's U-Boot or
#                  not) and the screen opens the result
#   --stop-after N tests: stop (exit 9) once step N is done
#
# Steps, in this order, each read back, the boot flag left on slot A (this
# recovery OS) all through:
#   0. the stock first MiB saved: /data/ad5x/stock/boot.img (+ .sha256,
#      .info) if it isn't there, from the disk (Flashforge's SPL there), or
#      else from its copy in usershare's kiln-stock-backup/ or a USB
#      stick's kiln-stock-backup/ (a wiped /data: checked as the saved one
#      and against the disk), and its copy on usershare (ad5x-stock-copy
#      usershare): Return to Flashforge firmware takes Flashforge's SPL
#      from there
#   1. Kiln's SPL: the SPL's header sector (34) zeroed, sectors 35-81, the
#      boot ROM's length at 0x4, then sector 34 last (lib/bootloader.sh's
#      bl_put_spl). Flashforge's U-Boot at 0xA400 stays; Kiln's SPL doesn't
#      start it and boots the flagged slot itself
#   2. kernel2 (p3) <- Kiln's 6.6, the main OS's own (from rootfs2), header last
#   3. kernel (p1) <- the same, header last. Under Kiln's SPL no Flashforge
#      kernel stays in a slot (Kiln's SPL alone starts 6.6 directly; U-Boot
#      starts the recovery OS only from Kiln's 6.6 in p1)
#   4. U-Boot's settings, state and records in ota (0x80000-0x903FF) zeroed:
#      its first start is a fresh one
#   5. Kiln's U-Boot at 0xA400: its body, then its header sector (until then
#      0xA400 holds no uImage and Kiln's SPL boots the slot); then the whole
#      first MiB read back as the expected one: boot.img with Kiln's SPL and
#      U-Boot (as u-boot/tools/ad5x_spl_image.py makes it), nothing else
# A network rescue record in the first MiB's last sector (LBA 2047, left by
# a rescue that gave up: u-boot patches 0045-0046) is not this printer's
# boot loader: the disk is compared as if that sector were boot.img's, and
# --yes first writes boot.img's sector over it, read back (with nothing
# else to do, that alone). Without a saved boot.img, refused
# Every state in between starts a system: Kiln's SPL with Flashforge's
# kernels or Kiln's 6.6 in the slots (tools/bench/README.md steps 3 and 5).
# The exception is step 1 itself (a few milliseconds): while sector 34 is
# zero the boot ROM finds no SPL and, after a power cut there, goes to USB
# boot mode by itself (the J28 restore in docs/own-boot-loader.md); it
# never meets a header in front of half an SPL. After the install,
# restart: Kiln's SPL and U-Boot start this recovery OS again on Kiln's
# 6.6, and its screen shows the result (--verify-start).
#
# Upgrade: when the disk is the saved boot.img with a whole Kiln SPL and a
# whole Kiln U-Boot of another build in it (as an install or the bench
# tools put them, nothing else changed; with or without an install
# record), --yes replaces them with this build's, in the same order:
#   0. as above (boot.img must be there: the disk has no Flashforge SPL)
#   1. this build's SPL, as above. The way back if it doesn't read back is
#      the old Kiln SPL (saved first in /data/ad5x/bootloader/
#      before-upgrade.img), never Flashforge's: Flashforge's SPL would
#      start the Kiln U-Boot at 0xA400 as its own raw U-Boot
#   2, 3. only if the slots don't hold the main OS's 6.6 already
#   4. skipped: U-Boot's settings, state and records stay (U-Boot drops
#      settings of another build by itself; the records keep failed-mem
#      and the failure records, and both builds read each other's)
#   5. this build's U-Boot: the old one's header sector zeroed first, then
#      the body up to the end of the old U-Boot or the new one, whichever
#      is longer (past the new one's end boot.img's bytes, so nothing of
#      the old U-Boot stays), then the header sector
# Why this order boots at every point: the SPL goes first, as in an
# install, so the brick window (sector 34 zero, milliseconds) is the only
# one. After it the new SPL starts the old U-Boot: the SPL loads U-Boot
# the same way in both builds (a uImage at 0xA400, its CRCs checked, no
# arguments passed), and they share the CPSPR hand-over (ad5x_start.h:
# 0x4bxx values; the old U-Boot writes 0 before a kernel, the new one
# 0x55xx, both read as a fresh start by either SPL). U-Boot reads the
# eFuse itself for the RAM size and keeps its own command line, so it
# needs nothing from the new SPL. While U-Boot is written (header zero)
# the new SPL finds no U-Boot and starts the flagged slot (Kiln's 6.6 in
# p1, this recovery OS) itself. A write that fails puts boot.img's bytes
# back at 0xA400 (Kiln's SPL then starts the slots itself, as in an
# install). The other order would work too (the old SPL reads the new
# U-Boot's 0x55xx as a fresh start), but then the SPL's own start of
# the main OS's 6.6 during the U-Boot write would come from the old SPL,
# with the old memory layout. The install record says kind=upgrade, so a
# run after a stop or power cut goes on as an upgrade (ota kept).
#
# Refused, nothing written, unless: root; the recovery OS in slot A; no
# other job; no unfinished Return to Flashforge firmware; an eMMC (not
# SD-NAND), writable, not mounted, its partitions where the SPL's table has
# them, its GPT right and its entries ending by 0x4400 (rc_gpt: at the LBA
# its header names, 2 or 32 on known boards); the stock first MiB saved
# (or savable: the disk holds Flashforge's SPL, or a copy of it that checks
# is in usershare's or a USB stick's kiln-stock-backup/) and the disk the same
# outside Kiln's ranges, its copy on usershare (or makable: the stock
# files in /data/ad5x/stock, and room for them on usershare as step 0's
# ad5x-stock-copy needs it, its --space-check); the board on
# the allowlist (or --unsupported-board); an X2600H (512 MiB: MemTotal and
# the mem= bank at 0x30000000), or an X2600E with --unsupported-board
# (Kiln's SPL has its table but has not run from eMMC on one yet); a
# board it can't tell is refused even with --unsupported-board; the images in
# /usr/share/ad5x/bootloader matching their SHA256SUMS, an SPL and a U-Boot Kiln's SPL starts; the main
# OS in slot B a Kiln OS that confirms U-Boot's starts (lib/uboot.sh,
# S99ad5x-booted), brings this recovery OS (same content ID) and has a
# whole 6.6 not recorded as failed; the kernel slots holding Flashforge's
# 5.10 or Kiln's 6.6; Kiln's boot loader of another build at 0x4400 or
# 0xA400 only whole, as an upgrade takes it (or an upgrade's own
# write cut short, by the record).
# Progress lines "@progress N [code] text" for the touch screen (the code
# is the screen's translation: recovery-ui/src/progress.c); log in
# /data/ad5x/bootloader/log; the install record in /data/ad5x/bootloader/state.
# Exit: 0 done, or nothing to do ("result: already installed (this
# build)": the disk holds this build's first MiB byte for byte and no run
# is unfinished; that result even when other checks fail, another job or
# the start-up actions running, as nothing would be written), 1 refused
# (nothing written), 2 checks passed (no --yes; "result: ready to install"
# for a fresh install, "ready to go on" only for a run that stopped: the
# record says started, or Kiln's SPL or part of its U-Boot is on the disk),
# 3 a write failed but every system still starts (run it again), 4 the boot
# loader area is not as before (don't switch off; run it again now), 9
# stopped by --stop-after.
# AD5X_RECOVERY_LIB, AD5X_LIB, AD5X_BOOTLOADER_FILES, AD5X_ROOT, AD5X_MEMINFO (tests).
. ${AD5X_RECOVERY_LIB:-/usr/lib/ad5x-recovery}/recovery.sh
LIB=${AD5X_LIB:-/usr/lib/ad5x}
# uimage_ok, uimage_data_ok, uimage_name, kiln_kernel, kernel_same
. "$LIB/slot.sh" || { echo "ad5x-bootloader-install: no $LIB/slot.sh" >&2; exit 1; }
. "$LIB/bootloader.sh" || { echo "ad5x-bootloader-install: no $LIB/bootloader.sh" >&2; exit 1; }

ME=ad5x-bootloader-install
LOG=$BL_DATA/log
STOCK=$AD5X_DATA/ad5x/stock
MARK=kiln-stock-backup
PHRASE="I accept the risk of an unsupported board"
ISSUE="https://github.com/djvalic/kiln-os/issues/68"

mode=check override= stop_after= dry= only_upgrade=
while [ $# -gt 0 ]; do
	case "$1" in
	--check) mode=check ;;
	--yes) mode=yes ;;
	--fingerprint) mode=fingerprint ;;
	--status) mode=status ;;
	--offer) mode=offer ;;
	--verify-start) mode=verify ;;
	--unsupported-board) override=1 ;;
	--upgrade) only_upgrade=1 ;;
	--dry-run) dry=1 ;;
	--stop-after) stop_after=$2; shift ;;
	-h|--help) sed -n '2,/^# AD5X_RECOVERY_LIB/p' "$0"; exit 0 ;;
	*) sed -n '2,/--stop-after N/p' "$0" >&2; exit 1 ;;
	esac
	shift
done
[ -n "$dry" ] && [ "$mode" = yes ] && mode=check

mkdir -p "$AD5X_RUN" 2>/dev/null
T=$(mktemp -d "${TMPDIR:-/tmp}/$ME.XXXXXX") || { echo "$ME: no temp folder" >&2; exit 1; }
BL_TMP=$T
LOCK=$AD5X_RUN/bootloader-install.lock
locked= mnt= us_mnt=
cleanup() {
	[ -n "$mnt" ] && umount "$mnt" 2>/dev/null && rmdir "$mnt" 2>/dev/null
	[ -n "$us_mnt" ] && umount "$us_mnt" 2>/dev/null && rmdir "$us_mnt" 2>/dev/null
	rm -rf "$T"
	[ -n "$locked" ] && rmdir "$LOCK" 2>/dev/null
	return 0
}
trap cleanup EXIT
# a signal ends it through cleanup too (no mount left behind); --yes
# ignores them once it writes
trap 'exit 1' HUP INT TERM PIPE

logging=0
say() {
	echo "$*"
	[ "$logging" = 1 ] && echo "$*" >> "$LOG" 2>/dev/null
	return 0
}
nfail=0
ok() { say "  ok    $*"; }
bad() { say "  FAIL  $*"; nfail=$((nfail + 1)); }
note() { say "  note  $*"; }
# prog N CODE TEXT: the screen's progress line, not in the log
prog() { echo "@progress $1 [$2] $3"; }
loud() {
	say "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
	for l in "$@"; do say "!! $l"; done
	say "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
}
sha() { sha256sum < "$1" | cut -d' ' -f1; }
fsize() { wc -c < "$1" | tr -d ' '; }
is_zero() { [ -z "$(tr -d '\000' < "$1" | head -c 1)" ]; }

DISK=$(rc_disk 2>/dev/null)
dn=${DISK##*/}
P1=$(rc_part kernel) P3=$(rc_part kernel2) P4=$(rc_part rootfs2) P5=$(rc_part ota) P6=$(rc_part usershare)
cur_mib() { bl_read "$DISK" 0 2048 "$1"; }
cpspr() { command -v devmem >/dev/null 2>&1 && devmem 0x10000034 32 2>/dev/null; }
# the first MiB's U-Boot at 0xA400: Kiln's (a uImage named Kiln U-Boot)
kiln_ub_at() { bl_kiln_ub "$1"; }
emmc_type() { cat "$AD5X_SYS/class/block/$dn/device/type" 2>/dev/null; }
# SD-NAND, not eMMC (lib/bootloader.sh)
sdnand() { bl_sdnand "$dn"; }
parts_line() {
	for n in $RC_PARTS; do rc_part_start "$n" 2>/dev/null; done | tr '\n' ' ' | sed 's/ $//'
}
emmc_line() {
	echo "$(cat "$AD5X_SYS/class/block/$dn/device/name" 2>/dev/null) $(cat "$AD5X_SYS/class/block/$dn/size" 2>/dev/null)"
}
# boot.img as S99ad5x-booted saves it (lib/bootloader.sh's
# bl_boot_img_why). FILE: another copy (default $STOCK/boot.img), with
# FILE.sha256, FILE.info
boot_img_why() { bl_boot_img_why "${1:-$STOCK/boot.img}"; }
st_open() { echo "$1" > "$AD5X_RUN/bootloader.open" 2>/dev/null; }
# usershare (read-only, while needed; cleanup unmounts it at any exit). The
# read-only modes (--offer, --fingerprint) mount it at a folder of their
# own (US_DIR.PID): one can run while an install has usershare mounted
US_DIR=$AD5X_RUN/bootloader-usershare
case "$mode" in offer|fingerprint) US_DIR=$US_DIR.$$ ;; esac
usershare_mount() {
	[ -n "$us_mnt" ] && return 0
	us_mnt=$US_DIR
	mkdir -p "$us_mnt"
	mount -t ext4 -o ro "$P6" "$us_mnt" 2>/dev/null || { rmdir "$us_mnt"; us_mnt=; return 1; }
}
usershare_umount() { [ -n "$us_mnt" ] && umount "$us_mnt" 2>/dev/null && rmdir "$us_mnt" 2>/dev/null; us_mnt=; }
# find_alt [mounted]: the stock first MiB's copy elsewhere, for when
# $STOCK/boot.img is gone or bad (a wiped /data): usershare's
# kiln-stock-backup/, then a USB stick's kiln-stock-backup/, the first that
# checks as S99ad5x-booted saves it (boot_img_why), copied to $T/alt (with
# .sha256 and .info): ALT, ALT_FROM; false when there is none. usershare is
# unmounted again before it returns. "mounted": only the sticks mounted
# already (ad5x-recovery-auto mounts them at start), none mounted here
find_alt() {
	ALT= ALT_FROM= fa_c=
	if usershare_mount && boot_img_why "$us_mnt/$MARK/boot.img" >/dev/null; then
		fa_c=$us_mnt/$MARK/boot.img ALT_FROM="usershare's $MARK/"
	else
		[ "$1" = mounted ] || [ -n "$(rc_usb_mounts)" ] || ad5x-usb mount 3 >/dev/null 2>&1
		for fa_m in $(rc_usb_mounts); do
			boot_img_why "$fa_m/$MARK/boot.img" >/dev/null || continue
			fa_c=$fa_m/$MARK/boot.img ALT_FROM="the USB stick's $MARK/ (${fa_m##*/})"
			break
		done
	fi
	if [ -n "$fa_c" ]; then
		mkdir -p "$T/alt" && cp "$fa_c" "$T/alt/boot.img" && cp "$fa_c.sha256" "$T/alt/boot.img.sha256" &&
			cp "$fa_c.info" "$T/alt/boot.img.info" && boot_img_why "$T/alt/boot.img" >/dev/null &&
			ALT=$T/alt/boot.img
	fi
	usershare_umount
	[ -n "$ALT" ] || { ALT_FROM=; return 1; }
}
# ro_boot CUR (the disk's first MiB): the stock first MiB for the read-only
# modes, in the install's order: $STOCK/boot.img when it checks, else its
# copy elsewhere (find_alt, sticks mounted already) when it is this
# printer's: the disk's outside Kiln's ranges (bl_spl_class: its GPT, with
# this printer's GUIDs), as the install checks it. RB=, RB_FROM=; looked up
# once. No cache across runs: --offer runs at ad5x-status --slots only (at
# the screen's start and after each job, never during one), it mounts
# usershare only when /data's copy is missing or bad, and a cached answer
# could outlive the copy it was about (ad5x-stock-copy, Return to
# Flashforge firmware and a restore rewrite kiln-stock-backup/)
RB= RB_FROM= rb_done=
ro_boot() {
	if [ -z "$rb_done" ]; then
		rb_done=1
		if boot_img_why >/dev/null; then RB=$STOCK/boot.img RB_FROM=$STOCK/boot.img
		elif find_alt mounted; then
			case "$(bl_spl_class "$1" "$ALT" "$ALT")" in
			other*) ;;
			*) RB=$ALT RB_FROM="boot.img in $ALT_FROM" ;;
			esac
		fi
	fi
	[ -n "$RB" ]
}

# built WHAT FILE OFF LEN: the build date in the version string WHAT
# (lib/bootloader.sh's bl_built: the part in brackets of "U-Boot SPL
# 2026.10 (Nov 15 2026 - 19:48:50 +0000)"); empty when there is none
built() { bl_built "$@"; }
# ver SPL-DATE UBOOT-DATE: one date when both are the same build
ver() {
	if [ "$1" = "$2" ]; then echo "built ${1:-?}"
	elif [ -z "$2" ]; then echo "SPL built ${1:-?}, no U-Boot"
	else echo "SPL built ${1:-?}, U-Boot built ${2:-?}"; fi
}
# mib_ver FILE (a first MiB): its Kiln boot loader's build
mib_ver() {
	mvu=
	if [ "$(bl_ufield "$1" $BL_UB_OFF)" = 27051956 ]; then
		mvu=$(built "U-Boot" "$1" $BL_UB_OFF $((BL_MIB - BL_UB_OFF)))
		[ -n "$mvu" ] || mvu="?"
	fi
	ver "$(built "U-Boot SPL" "$1" $BL_SPL_OFF $((BL_SPL_END - BL_SPL_OFF)))" "$mvu"
}
# files_ver: the build of the images this recovery OS carries
files_ver() {
	ver "$(built "U-Boot SPL" "$BL_FILES/spl-mmc.img" 0 $((BL_SPL_END - BL_SPL_OFF)))" \
		"$(built "U-Boot" "$BL_FILES/u-boot-emmc.img" 0 $BL_MIB)"
}
# mib_date FILE (a first MiB) / files_date: the build as the recovery
# screen's boot loader line shows it, words left out (the screen's
# language): one date, or "SPL date / U-Boot date" when they differ;
# empty when there is none
bdate() {
	if [ -z "$2" ] || [ "$1" = "$2" ]; then echo "${1:-$2}"
	else echo "${1:-?} / $2"; fi
}
mib_date() { bl_mib_dates "$1"; bdate "$BL_D_SPL" "$BL_D_UB"; }
files_date() { bl_files_dates || return 0; bdate "$BL_D_SPL" "$BL_D_UB"; }
# carried_vs FILE (a first MiB with Kiln's boot loader): the build this
# recovery OS carries against the one in FILE, by their build times (the
# later of SPL and U-Boot date each, lib/bootloader.sh's
# bl_compare_builds): newer, older or unknown (a date missing, or the same
# time); "same" when the images are the ones there (files_same)
carried_vs() {
	files_same "$1" && { echo same; return 0; }
	bl_files_dates || { echo unknown; return 0; }
	cvs=$BL_D_SPL cvu=$BL_D_UB
	bl_mib_dates "$1"
	bl_compare_builds "$cvs" "$cvu" "$BL_D_SPL" "$BL_D_UB"
}
# files_same FILE (a first MiB): its SPL and U-Boot are the images this
# recovery OS carries (the SPL but its params block at 0x100-0x1FF, which
# an install takes from boot.img; a quick look, no boot.img needed)
files_same() {
	fss=$BL_FILES/spl-mmc.img fsu=$BL_FILES/u-boot-emmc.img
	[ -f "$fss" ] && [ -f "$fsu" ] || return 1
	fsn=$(fsize "$fss") fun=$(fsize "$fsu")
	cmp -s -n 256 "$fss" "$1" 0 $BL_SPL_OFF &&
		cmp -s -n $((fsn - 512)) "$fss" "$1" 512 $((BL_SPL_OFF + 512)) &&
		cmp -s -n "$fun" "$fsu" "$1" 0 $BL_UB_OFF
}
# kiln_whole FILE (a first MiB): FILE is $BOOT with a whole Kiln SPL and a
# whole Kiln U-Boot (of any build) put in as an install puts them
# (bl_compose), and nothing else: Kiln's boot loader of another build,
# safe to upgrade. It leaves both images in $T/kw-spl.img, $T/kw-ub.img
kiln_whole() {
	[ -n "$BOOT" ] && [ "$(bl_loader "$1")" = kiln ] || return 1
	kwn=$(($(bl_le32 "$1" $((BL_SPL_OFF + 4))) * 512))
	[ "$kwn" -gt 0 ] && [ "$kwn" -le $((BL_SPL_END - BL_SPL_OFF)) ] || return 1
	tail -c +$((BL_SPL_OFF + 1)) "$1" | head -c "$kwn" > "$T/kw-spl.img"
	bl_spl_image_ok "$T/kw-spl.img" || return 1
	[ "$(bl_ufield "$1" $BL_UB_OFF)" = 27051956 ] || return 1
	kwn=$((0x$(bl_ufield "$1" $((BL_UB_OFF + 12))) + 64))
	[ "$kwn" -le $((BL_MIB - BL_UB_OFF)) ] || return 1
	tail -c +$((BL_UB_OFF + 1)) "$1" | head -c "$kwn" > "$T/kw-ub.img"
	bl_uboot_image_ok "$T/kw-ub.img" $((BL_MIB - BL_UB_OFF)) || return 1
	bl_compose "$BOOT" "$T/kw-spl.img" "$T/kw-ub.img" "$T/kw.img" && cmp -s "$T/kw.img" "$1"
}

# ------------------------------------------------------------- --status
if [ "$mode" = status ]; then
	cur_mib "$T/cur.img" || { echo "boot loader: can't read the first MiB"; exit 1; }
	l=$(bl_loader "$T/cur.img")
	if [ "$l" = kiln ] && kiln_ub_at "$T/cur.img"; then
		echo "boot loader: Kiln's SPL and U-Boot ($(tail -c +$((BL_UB_OFF + 33)) "$T/cur.img" | head -c 32 | tr -d '\000'))"
	elif [ "$l" = kiln ]; then echo "boot loader: Kiln's SPL, no U-Boot at 0xA400 (it starts the slots itself)"
	else echo "boot loader: $l"; fi
	[ "$l" = kiln ] && echo "on the disk: Kiln boot loader $(mib_ver "$T/cur.img")"
	bl_rescue_rec "$T/cur.img" && echo "network rescue record in LBA $BL_RESCUE_LBA: $(bl_rescue_says "$T/cur.img") (--yes clears it, as does \"ad5x_rescue clear\" at Kiln's U-Boot prompt)"
	if [ -f "$BL_FILES/spl-mmc.img" ] && [ -f "$BL_FILES/u-boot-emmc.img" ]; then
		w=
		if [ "$l" = kiln ]; then
			case "$(carried_vs "$T/cur.img")" in
			same) w=" (the same)" ;;
			newer) w=" (another build, newer: ad5x-bootloader-install --check shows the upgrade)" ;;
			older) w=" (another build, older: not offered on the screen; ad5x-bootloader-install --yes downgrades to it)" ;;
			*) w=" (another build: ad5x-bootloader-install --check shows the upgrade)" ;;
			esac
		fi
		echo "this recovery OS carries: Kiln boot loader $(files_ver)$w"
	else
		echo "this recovery OS carries: no Kiln boot loader images"
	fi
	bl_variant
	echo "chip: $(bl_variant_says)"
	echo "this start: $(rc_uboot && echo "by Kiln's U-Boot (ad5x.uboot=1)" || echo "not by Kiln's U-Boot")$(c=$(cpspr) && echo ", CPSPR $c")"
	echo "record: $(bl_stval state)"
	[ -f "$BL_STATE" ] && grep -v '^state=' "$BL_STATE" | sed 's/^/  /'
	exit 0
fi

# ------------------------------------------------------------- --verify-start
if [ "$mode" = verify ]; then
	rm -f "$AD5X_RUN/bootloader.open"
	case "$(bl_stval state)" in
	installed)
		c=$(cpspr)
		if rc_uboot; then
			bl_stset state verified
			bl_stset start "$(date '+%Y-%m-%d %H:%M:%S') recovery OS started by Kiln's U-Boot (ad5x.uboot=1${c:+, CPSPR $c}), kernel $(uname -r)"
			ad5x-bootlog "bootloader: first start by Kiln's U-Boot" 2>/dev/null
		else
			bl_stset state unverified
			bl_stset start "$(date '+%Y-%m-%d %H:%M:%S') recovery OS started WITHOUT Kiln's U-Boot (no ad5x.uboot=1${c:+, CPSPR $c}), kernel $(uname -r)"
			ad5x-bootlog "bootloader: first start not by Kiln's U-Boot" 2>/dev/null
		fi
		st_open result
		echo "$ME: $(bl_stval start)" ;;
	started) st_open resume; echo "$ME: an install was stopped before it finished" ;;
	esac
	exit 0
fi

# ------------------------------------------------------------- --offer
if [ "$mode" = offer ]; then
	# a plain read (no cache drop): it runs at every ad5x-status --slots
	offer=no upgrade=no
	# The stock first MiB (boot.img) comes from ro_boot: /data's saved copy,
	# else (a wiped /data) its copy in usershare's kiln-stock-backup/ or on
	# a USB stick mounted already, as the install takes it. It is looked
	# for only when needed (the cheap checks first): usershare is mounted
	# read-only for a moment only when /data's copy is missing or bad, and
	# nothing is written
	if [ -n "$DISK" ] && dd if="$DISK" of="$T/cur.img" bs=65536 count=16 2>/dev/null &&
	   [ "$(fsize "$T/cur.img")" = $BL_MIB ]; then
		l=$(bl_loader "$T/cur.img") src=
		if [ "$l" = kiln ] && kiln_ub_at "$T/cur.img"; then
			echo "bootloader=kiln"
			# the screen's boot loader line (Reboot / Power, always
			# shown): the build on the disk, the one carried, the same?
			echo "bootloader_build=$(mib_date "$T/cur.img")"
			echo "bootloader_carries=$(files_date)"
			vs=$(carried_vs "$T/cur.img")
			[ "$vs" = same ] && echo "bootloader_same=yes" || echo "bootloader_same=no"
			# newer: the carried build is later than the disk's (by
			# the later of each build's SPL and U-Boot dates); no: the
			# same or an older one; unknown: a date missing or the same
			# time with other bytes (offered as before: no proof of a
			# downgrade)
			case "$vs" in
			newer) echo "bootloader_carries_newer=yes" ;;
			unknown) echo "bootloader_carries_newer=unknown" ;;
			*) echo "bootloader_carries_newer=no" ;;
			esac
			# an upgrade: another build, newer (or of unknown age), whole
			# over this printer's boot.img (allowlisted), an X2600H, the
			# images there (no opt-in file: the owner installed Kiln's
			# boot loader already). An older build is never offered on
			# the screen (a downgrade stays possible over SSH with
			# --yes). A network rescue record: looked at as boot.img's
			# sector (--yes clears it with an upgrade)
			if [ "$(rc_slot)" = A ] && ! sdnand && [ -f "$BL_FILES/spl-mmc.img" ] &&
			   [ -f "$BL_FILES/u-boot-emmc.img" ] && { [ "$vs" = newer ] || [ "$vs" = unknown ]; } &&
			   ro_boot "$T/cur.img" && BOOT=$RB &&
			   { ! bl_rescue_rec "$T/cur.img" ||
			     dd if="$BOOT" of="$T/cur.img" bs=512 skip=$BL_RESCUE_LBA seek=$BL_RESCUE_LBA count=1 conv=notrunc 2>/dev/null; } &&
			   kiln_whole "$T/cur.img" &&
			   bl_fingerprint "$BOOT" >/dev/null && bl_allowed "$BL_FP_SPL" "$BL_FP_DDR" &&
			   [ "$BL_VARIANT" = H ]; then
				upgrade=yes
			fi
		else
			case "$l" in
			flashforge) echo "bootloader=flashforge"; src=$T/cur.img
			      [ "$(bl_stval state)" = started ] && ro_boot "$T/cur.img" && src=$RB ;;
			kiln) echo "bootloader=kiln-spl"
			      [ "$(bl_stval state)" = started ] && ro_boot "$T/cur.img" && src=$RB ;;
			*) echo "bootloader=unknown" ;;
			esac
			if [ -n "$src" ] && [ "$(rc_slot)" = A ] && ! sdnand &&
			   bl_fingerprint "$src" >/dev/null && bl_allowed "$BL_FP_SPL" "$BL_FP_DDR" &&
			   [ "$BL_VARIANT" = H ] &&
			   [ -f "$BL_FILES/spl-mmc.img" ] && [ -f "$BL_FILES/u-boot-emmc.img" ]; then
				offer=yes
			fi
		fi
	else
		echo "bootloader=unknown"
	fi
	echo "bootloader_upgrade=$upgrade"
	echo "bootloader_offer=$offer"
	exit 0
fi

# ------------------------------------------------------------- --fingerprint
fingerprint() {	# FILE WHAT: the lines as #68's snippet prints them
	bl_fingerprint "$1"
	echo "parts:  $(parts_line)"
	echo "emmc:   $(emmc_line)"
	if bl_allowed "$BL_FP_SPL" "$BL_FP_DDR"; then echo "match:  yes (tested boards)"
	else echo "match:  no, please post this"; fi
	[ -n "$2" ] && echo "(of $2)"
	return 0
}
if [ "$mode" = fingerprint ]; then
	cur_mib "$T/cur.img" || { echo "$ME: can't read the first MiB of ${DISK:-the eMMC}" >&2; exit 1; }
	# else the saved stock first MiB: /data's, or (a wiped /data) its copy
	# in usershare's or a mounted USB stick's kiln-stock-backup/ (ro_boot)
	if [ "$(bl_loader "$T/cur.img")" = flashforge ]; then fingerprint "$T/cur.img" ""
	elif ro_boot "$T/cur.img"; then fingerprint "$RB" "$RB_FROM, the stock first MiB saved before Kiln's boot loader"
	else echo "$ME: the disk doesn't hold Flashforge's SPL and there is no saved boot.img to read instead (/data/ad5x/stock, usershare's or a USB stick's $MARK/)" >&2; exit 1; fi
	exit 0
fi

# ------------------------------------------------------------- checks
mkdir -p "$BL_DATA" 2>/dev/null && : >> "$LOG" 2>/dev/null && logging=1
say "== $ME $(date '+%Y-%m-%d %H:%M:%S') ($mode${only_upgrade:+, --upgrade}${override:+, --unsupported-board})"
say "checks:"
prog 2 checking "Checking"
if [ "$(id -u)" = 0 ]; then ok "root"; else bad "not root"; fi
if [ -f "${AD5X_ROOT:-}/etc/ad5x-recovery" ] && [ "$(rc_slot)" = A ]; then
	ok "the recovery OS, slot A ($(rc_root)): no print can run"
else
	bad "not the recovery OS in slot A (root $(rc_root)): run it there"
fi
busy=
for p in ad5x-swu-apply swupdate-client ad5x-restore ad5x-backup ad5x-usb-rescue ad5x-zip-to-swu ad5x-return-stock; do
	pidof "$p" >/dev/null 2>&1 && busy="$busy $p"
done
if [ ! -f "$AD5X_RUN/auto.done" ] && [ ! -e "$AD5X_DATA/ad5x/recovery/noauto" ]; then
	busy="$busy start-up-actions"
fi
if [ -z "$busy" ]; then ok "no other job running"
else bad "busy:$busy (wait for it to finish)"; fi
if [ "$(sed -n 's/^state=//p' "$AD5X_DATA/ad5x/return-stock/state" 2>/dev/null)" = started ]; then
	bad "a Return to Flashforge firmware is unfinished: finish it (or forget it) first"
fi

# the disk
disk_ok=
if [ -z "$DISK" ] || [ ! -e "$DISK" ]; then
	bad "no eMMC disk found"
elif [ -z "${AD5X_TEST:-}" ] && [ ! -b "$DISK" ]; then
	bad "$DISK is not a block device"
elif sdnand; then
	bad "$DISK is SD-NAND (type '$(emmc_type)'), not eMMC: Kiln's SPL reads only eMMC; refused"
else
	ro=
	for s in "$AD5X_SYS/class/block/$dn" $(for n in kernel kernel2 ota; do rc_part_sys $n; done); do
		[ "$(cat "$s/ro" 2>/dev/null || echo 0)" = 0 ] || ro="$ro ${s##*/}"
	done
	mt=
	for d in "$DISK" "$P1" "$P3" "$P5"; do rc_mounted "$d" && mt="$mt ${d##*/}"; done
	if [ -n "$ro" ]; then bad "read-only:$ro"
	elif [ -n "$mt" ]; then bad "mounted:$mt"
	else disk_ok=1; ok "$DISK: eMMC ($(emmc_type)), writable, the kernel slots and ota not mounted"; fi
fi
gpt=1
for e in $RC_SPL_TABLE; do
	n=${e%%:*}
	s=$(rc_part_sys "$n") || { gpt=; bad "no $n partition"; continue; }
	if [ "$n" = userdata ]; then
		[ "$(cat "$s/start")" = "$(echo "$e" | cut -d: -f2)" ] || { gpt=; bad "userdata starts at $(cat "$s/start"), not where the SPL's table has it"; }
	else
		rc_spl_ok "$n" || { gpt=; bad "$n is at $(cat "$s/start"):$(cat "$s/size"), the SPL's table has $(echo "$e" | cut -d: -f2-)"; }
	fi
done
[ -n "$gpt" ] && ok "partitions where the SPL's table has them (the first at sector 2048, beyond the boot loader area)"
CUR=$T/cur.img CUR_CMP=$T/cur.img
if [ -n "$disk_ok" ] && cur_mib "$CUR"; then
	if [ "$(head -c 4 "$CUR")" != INGE ] || [ "$(tail -c +513 "$CUR" | head -c 8)" != "EFI PART" ]; then
		bad "the first MiB has no boot ROM block (INGE) or no GPT"; disk_ok=
	elif ! rc_gpt "$CUR" > "$T/gpt.why"; then
		bad "$(cat "$T/gpt.why"): refused (the SPL range must stay clear of the GPT)"; disk_ok=
	else
		ok "first MiB: boot ROM block, GPT entries at LBA $RCG_LBA end at $(printf '0x%x' $RCG_END) (the SPL starts at 0x4400)"
	fi
else
	[ -n "$disk_ok" ] && bad "can't read the first MiB"
	disk_ok=
fi
# the stock first MiB's copy elsewhere (find_alt), for when $STOCK/boot.img
# is gone or bad (a wiped /data). It is compared with the disk as the saved
# one is, and step 0 puts it back in $STOCK.
ALT= ALT_FROM=
[ -n "$disk_ok" ] && ! boot_img_why >/dev/null && find_alt
BIMG=
if boot_img_why >/dev/null; then BIMG=$STOCK/boot.img; elif [ -n "$ALT" ]; then BIMG=$ALT; fi
# a network rescue record in LBA 2047: compared as boot.img's sector (the
# copy, not the disk), cleared by --yes before anything else (clear_rescue)
RESCUE=
if [ -n "$disk_ok" ] && bl_rescue_rec "$CUR"; then
	RESCUE=$(bl_rescue_says "$CUR")
	if [ -n "$BIMG" ]; then
		dd if="$BIMG" of="$CUR" bs=512 skip=$BL_RESCUE_LBA seek=$BL_RESCUE_LBA count=1 conv=notrunc 2>/dev/null
		note "LBA $BL_RESCUE_LBA holds a network rescue record ($RESCUE): compared as the saved stock first MiB's sector; --yes writes that sector over it first"
	else
		bad "LBA $BL_RESCUE_LBA holds a network rescue record ($RESCUE) and no stock first MiB is saved ($STOCK/boot.img): the sector's own bytes are unknown: refused"
		RESCUE= disk_ok=
	fi
fi
LOADER=
[ -n "$disk_ok" ] && LOADER=$(bl_loader "$CUR")

# the stock first MiB (boot.img): saved, or savable from the disk (or its
# copy elsewhere) now
BOOT= SAVE_BOOT= BOOT_FROM="the disk's first MiB (Flashforge's SPL)"
if [ -n "$disk_ok" ]; then
	if why=$(boot_img_why); then
		BOOT=$STOCK/boot.img
		if [ "$LOADER" = flashforge ]; then
			if cmp -s "$BOOT" "$CUR"; then ok "stock first MiB saved ($BOOT, sha256 $(cut -c1-16 "$BOOT.sha256")...): the disk's byte for byte"
			elif bl_stamp_only "$BOOT" "$CUR"; then
				# the disk written back over USB since boot.img was saved: from
				# here on the disk is compared as if it had boot.img's 4 bytes
				ok "stock first MiB saved ($BOOT): the disk's byte for byte but 0x4480-0x4483, USBCloner's DDR type (a USB restore; no SPL reads it, Kiln's SPL replaces it)"
				cp "$BOOT" "$T/cur-cmp.img" && CUR_CMP=$T/cur-cmp.img
			elif [ "$(bl_stval state)" = started ] && [ "$(bl_spl_class "$CUR" "$BOOT" "$BOOT")" = partial ]; then
				# an SPL write cut short: its header zeroed, Flashforge's body (part) still there
				ok "stock first MiB saved ($BOOT): the disk's outside Kiln's ranges (an SPL write cut short)"
			else bad "$BOOT differs from the disk's first MiB (another printer's, or the GPT changed since): refused"; BOOT=; fi
		else
			c=$(bl_spl_class "$CUR" "$BOOT" "$BOOT")
			case "$c" in
			other*) bad "$BOOT differs from the disk outside Kiln's ranges (offset $(printf '0x%x' "${c#other }")): another printer's, or the GPT changed: refused"; BOOT= ;;
			*) ok "stock first MiB saved ($BOOT): the disk's outside Kiln's ranges" ;;
			esac
		fi
	elif [ "$LOADER" = flashforge ] && [ -n "$RESCUE" ] && ! cmp -s "$BIMG" "$CUR"; then
		# the record's sector was taken from the copy elsewhere, which isn't the disk's
		bad "no saved stock first MiB ($STOCK/boot.img: $why), a network rescue record in LBA $BL_RESCUE_LBA, and the copy in $ALT_FROM differs from the disk: the sector's own bytes are unknown: refused"
	elif [ "$LOADER" = flashforge ]; then
		[ "$why" = missing ] || note "$STOCK/boot.img: $why: saved again from the disk"
		BOOT=$T/boot.img SAVE_BOOT=1
		cp "$CUR" "$BOOT"
		ok "stock first MiB: not saved yet; step 0 saves it from the disk (Flashforge's SPL is there)"
	elif [ -n "$ALT" ]; then
		[ "$why" = missing ] || note "$STOCK/boot.img: $why"
		c=$(bl_spl_class "$CUR" "$ALT" "$ALT")
		case "$c" in
		other*) bad "no saved stock first MiB ($STOCK/boot.img: $why), and its copy in $ALT_FROM differs from the disk outside Kiln's ranges (offset $(printf '0x%x' "${c#other }")): another printer's, or the GPT changed: refused" ;;
		*) ok "stock first MiB: not in $STOCK ($why); its copy in $ALT_FROM is the disk's outside Kiln's ranges: step 0 puts it back in $STOCK"
		   BOOT=$ALT SAVE_BOOT=1 BOOT_FROM="its copy in $ALT_FROM" ;;
		esac
	else
		bad "no saved stock first MiB ($STOCK/boot.img: $why) and the disk doesn't hold Flashforge's SPL: no way back to Flashforge's boot loader; refused"
	fi
fi
# its copy on usershare (Return to Flashforge firmware takes it from there
# when /data/ad5x/stock is gone)
US_OK=
us_has_boot() {	# usershare's copy holds this boot.img
	usershare_mount || return 1
	[ -n "$BOOT" ] && [ -f "$us_mnt/$MARK/boot.img" ] && cmp -s "$us_mnt/$MARK/boot.img" "$BOOT"
}
if [ -n "$BOOT" ]; then
	if us_has_boot; then US_OK=1; ok "its copy on usershare ($MARK/boot.img) is the same"
	elif [ -f "$STOCK/kernel.img" ] && [ -f "$STOCK/rootfs.squashfs" ] && [ -f "$STOCK/SHA256SUMS" ]; then
		# step 0's ad5x-stock-copy needs room for the new copy next to
		# any old one (or the old one's big files out first): its own
		# room test, now, before anything is written
		usershare_umount
		sp=$(ad5x-stock-copy usershare --space-check ${SAVE_BOOT:+--with-boot} 2>&1 | tail -n 1)
		case "$sp" in
		"stock-copy: room OK"*)
			ok "its copy on usershare: not there yet; step 0 makes it (ad5x-stock-copy usershare; ${sp#stock-copy: })" ;;
		*)	bad "its copy on usershare: not there yet, and step 0 can't make it: ${sp#stock-copy: FAILED }: refused (make room on usershare, or save the stock files to a USB stick and remove the old kiln-stock-backup/)" ;;
		esac
	else
		bad "no copy of the stock files on usershare and none can be made ($STOCK has no kernel.img, rootfs.squashfs and SHA256SUMS): refused"
	fi
	usershare_umount
fi

# the board
BOARD_OK=
if [ -n "$BOOT" ]; then
	say "board fingerprint (djvalic/kiln-os#68)$([ "$LOADER" != flashforge ] && echo ", of the saved stock first MiB"):"
	fingerprint "$BOOT" "" | sed 's/^/    /' | while IFS= read -r l; do say "$l"; done
	bl_fingerprint "$BOOT" >/dev/null
	if bl_allowed "$BL_FP_SPL" "$BL_FP_DDR"; then
		BOARD_OK=1; ok "board: on the allowlist ($BL_BOARD)"; say "board: known"
	elif [ -n "$override" ]; then
		note "board: NOT on the allowlist; going on only because of --unsupported-board"; say "board: unknown (override)"
	else
		bad "board: not on the allowlist (spl $BL_FP_SPL, ddr $BL_FP_DDR): Kiln's SPL is not known to fit it. Please post the fingerprint above in $ISSUE"
		say "board: unknown"
	fi
fi
# the chip. Kiln's SPL reads the eFuse and sets up the X2600H's 512 MiB
# DDR3L or the X2600E's 256 MiB DDR3 (u-boot patch 0029). It is proven
# from eMMC on the X2600H only, so an X2600E goes on with
# --unsupported-board alone (a wrong DDR setup leaves the board in the
# boot ROM's USB mode: the J28 restore). A chip it can't tell is refused
# whatever the override
bl_variant
case "$BL_VARIANT" in
H) ok "chip: $(bl_variant_says)" ;;
E)	if [ -n "$override" ]; then
		note "chip: $(bl_variant_says): Kiln's SPL has its memory table but has not run from eMMC on an X2600E yet; going on only because of --unsupported-board"
	else
		bad "chip: $(bl_variant_says): Kiln's SPL has not run from eMMC on an X2600E yet; only with --unsupported-board (SSH, at your own risk). Please post the fingerprint above in $ISSUE"
	fi ;;
*) bad "chip: $(bl_variant_says): can't tell an X2600H from an X2600E, so it is refused (--unsupported-board doesn't change this)" ;;
esac

# the images this recovery OS carries
SPLI=$BL_FILES/spl-mmc.img UBI=$BL_FILES/u-boot-emmc.img img_ok=1
for f in "$SPLI" "$UBI"; do
	n=${f##*/}
	w=$(awk -v f="$n" '$2 == f || $2 == "*" f { print $1; exit }' "$BL_FILES/SHA256SUMS" 2>/dev/null)
	if [ ! -f "$f" ]; then bad "no $f (this recovery OS carries no boot loader images)"; img_ok=
	elif [ -z "$w" ] || [ "$(sha "$f")" != "$w" ]; then bad "$n: sha256 $(sha "$f") isn't the one in SHA256SUMS ('${w:-none}')"; img_ok=; fi
done
if [ -n "$img_ok" ]; then
	if ! bl_spl_image_ok "$SPLI"; then bad "spl-mmc.img: $BL_WHY"; img_ok=
	elif ! bl_uboot_image_ok "$UBI" $BL_UB_MAX; then bad "u-boot-emmc.img: $BL_WHY (it must end before the rescue record's sector, LBA $BL_RESCUE_LBA)"; img_ok=
	elif [ "$BL_UB_SIZE" != "$(fsize "$UBI")" ]; then bad "u-boot-emmc.img: $(fsize "$UBI") bytes, its header says $BL_UB_SIZE"; img_ok=
	else
		UB_END=$((BL_UB_OFF + (BL_UB_SIZE + 511) / 512 * 512))
		ok "Kiln's SPL ($(fsize "$SPLI") bytes, '$(tr -c ' -~' '\n' < "$SPLI" | grep -m1 'U-Boot SPL')') and U-Boot ($BL_UB_SIZE bytes, '$(tail -c +33 "$UBI" | head -c 32 | tr -d '\000')', sectors $BL_UB_LBA-$((UB_END / 512 - 1))): sha256 as SHA256SUMS, both start"
	fi
fi
FINAL=$T/final.img
if [ -n "$BOOT" ] && [ -n "$img_ok" ]; then
	bl_compose "$BOOT" "$SPLI" "$UBI" "$FINAL" || { bad "$BL_WHY"; FINAL=; }
else
	FINAL=
fi

# the main OS: Kiln OS that confirms U-Boot's starts, its 6.6, this recovery
K66= REL66=
if [ -n "$P4" ]; then
	mnt=$AD5X_RUN/bootloader-main
	mkdir -p "$mnt"
	if mount -t squashfs -o ro "$P4" "$mnt" 2>/dev/null; then
		m=$mnt
		if [ ! -f "$m/etc/ad5x-release" ] || [ -f "$m/etc/ad5x-recovery" ]; then
			bad "slot B holds no Kiln OS main system: install Kiln OS first"
		else
			ok "slot B: $(cat "$m/etc/ad5x-release")"
			if [ -f "$m/usr/lib/ad5x/uboot.sh" ] && grep -q 'uboot_started && uboot_booted' "$m/etc/init.d/S99ad5x-booted" 2>/dev/null; then
				ok "the main OS confirms Kiln's U-Boot's starts (S99ad5x-booted, lib/uboot.sh)"
			else
				bad "the main OS doesn't confirm Kiln's U-Boot's starts (U-Boot would fall back after two good starts): update Kiln OS first"
			fi
			REL66=$(cat "$m/usr/lib/ad5x/kernel66/release" 2>/dev/null)
			if kiln_kernel "$m/usr/lib/ad5x/kernel66/xImage" 2>/dev/null && [ -n "$REL66" ]; then
				K66=$T/k66.img
				cp "$m/usr/lib/ad5x/kernel66/xImage" "$K66" 2>/dev/null || K66=
			fi
			if [ -z "$K66" ]; then bad "the main OS has no whole Kiln 6.6 (usr/lib/ad5x/kernel66): update Kiln OS first"
			elif [ "$(fsize "$K66")" -gt "$(rc_part_bytes kernel)" ]; then bad "its 6.6 doesn't fit a kernel slot"; K66=
			else ok "its 6.6: '$(uimage_name "$K66")' ($REL66, $(fsize "$K66") bytes, header and data CRCs good)"; fi
			mid=$(cat "$m/usr/share/ad5x/recovery/rootfs.id" 2>/dev/null) rid=$(cat "${AD5X_ROOT:-}/etc/ad5x-recovery-id" 2>/dev/null)
			if [ -n "$mid" ] && [ "$mid" = "$rid" ]; then
				ok "this recovery OS is the one the main OS brings (content ID ${rid%"${rid#????????????}"}...)"
			else
				bad "this recovery OS (ID '${rid:-none}') isn't the one the main OS brings ('${mid:-none}'): start the main OS once (it brings this recovery OS up to date), then try again"
			fi
		fi
		umount "$mnt" 2>/dev/null; rmdir "$mnt" 2>/dev/null; mnt=
	else
		rmdir "$mnt" 2>/dev/null; mnt=
		bad "slot B's root doesn't mount: install Kiln OS first"
	fi
fi
for r in failed failed-mainline; do
	v=$(sed -n 1p "$AD5X_DATA/ad5x/kernel/$r" 2>/dev/null)
	[ -n "$v" ] && [ "$v" = "$REL66" ] &&
		bad "Kiln OS recorded its 6.6 ($v) as failed (/data/ad5x/kernel/$r): U-Boot would skip it. Start the main OS on 6.6 (ad5x-kernel retry) first"
done
# the kernel slots: Flashforge's 5.10 (it goes) or Kiln's 6.6
for k in kernel kernel2; do
	d=$(rc_part $k)
	kk=$(rc_kernel_kind "$d")
	case "$kk" in
	stock) ok "$k (${d##*/}): Flashforge's 5.10; Kiln's 6.6 goes there" ;;
	kiln) if [ -n "$K66" ] && kernel_same "$K66" "$d"; then ok "$k (${d##*/}): the main OS's 6.6 already"
	      else ok "$k (${d##*/}): a Kiln 6.6 ('$(rc_uimage_name "$d")'); the main OS's goes there"; fi ;;
	none) if [ "$(bl_stval state)" = started ]; then note "$k (${d##*/}): no kernel header (a write cut short): written again"
	      else bad "$k (${d##*/}) holds no kernel"; fi ;;
	*) bad "$k (${d##*/}) holds '$(rc_uimage_name "$d")' ($kk), not Flashforge's 5.10 or Kiln's 6.6" ;;
	esac
done
av=$(df -k "$AD5X_DATA" 2>/dev/null | awk 'NR == 2 { print $4 }')
if [ -n "$av" ] && [ "$av" -ge 2048 ]; then ok "/data: $av KiB free"
else bad "/data: ${av:-?} KiB free, less than 2 MiB (the log, the stock first MiB)"; fi

# where the disk stands
SPLC= UBC= UPG= OLDV= NEWV= SAME= PREV= DOWN=
REC=$(bl_stval state)
UB_WEND=$UB_END
if [ -n "$FINAL" ]; then
	SPLC=$(bl_spl_class "$CUR_CMP" "$BOOT" "$FINAL")
	UBC=$(bl_ub_class "$CUR_CMP" "$BOOT" "$FINAL")
	say "first MiB now: 0-0xA3FF $SPLC ('$(bl_banner "$CUR")'), from 0xA400 $UBC"
	NEWV=$(mib_ver "$FINAL")
	cmp -s "$CUR_CMP" "$FINAL" && SAME=1
	# an upgrade: an upgrade's run that stopped (the record: it goes on
	# from the first MiB it kept), or Kiln's boot loader of another build,
	# whole, over this printer's boot.img (kiln_whole). The old first MiB
	# is step 1's way back
	if [ -z "$SAME" ] && [ "$REC" = started ] && [ "$(bl_stval kind)" = upgrade ]; then
		UPG=resume OLDV=$(bl_stval from)
		p=$BL_DATA/before-upgrade.img
		if [ -f "$p" ] && [ "$(sha "$p")" = "$(cut -d' ' -f1 "$p.sha256" 2>/dev/null)" ] && kiln_whole "$p"; then PREV=$p
		else note "no saved first MiB from before the upgrade ($p): if Kiln's SPL doesn't read back, it is written once more"; fi
	elif [ -z "$SAME" ] && [ "$LOADER" = kiln ] && kiln_whole "$CUR_CMP"; then
		UPG=1 OLDV=$(mib_ver "$CUR_CMP") PREV=$T/old.img
		cp "$CUR_CMP" "$PREV"
	fi
	[ -n "$UPG" ] && say "upgrade: Kiln boot loader ${OLDV:-?} -> $NEWV"
	# an older build carried (the build times: carried_vs): a downgrade.
	# --yes over SSH does it as an upgrade (the same steps, the same
	# checks); the screen never offers it (--offer), and its --upgrade
	# refuses it below. A downgrade that stopped goes on (UPG=resume)
	DOWN=
	if [ "$UPG" = 1 ] && [ "$(carried_vs "$CUR_CMP")" = older ]; then
		DOWN=1
		note "this recovery OS carries an older build than the one on the disk: a downgrade"
	fi
	# U-Boot's range to write: up to this build's end, or further where the
	# disk differs from FINAL past it (an older, longer U-Boot): past its end
	# FINAL holds boot.img's bytes, so nothing of the old one stays
	l=$(tail -c +$((UB_END + 1)) "$CUR_CMP" > "$T/tail.img" &&
		tail -c +$((UB_END + 1)) "$FINAL" | cmp -l - "$T/tail.img" 2>/dev/null | tail -n 1 | awk '{ print $1 }')
	[ -n "$l" ] && UB_WEND=$((UB_END + ((l - 1) / 512 + 1) * 512))
	case "$SPLC:$UBC" in
	stock:stock|final:stock|final:partial|final:final) ;;
	partial:stock)
		if [ "$REC" = started ]; then note "the SPL range holds a write cut short: written again"
		else bad "0x4400-0xA3FF holds an SPL that is neither Flashforge's nor this build's (another Kiln build, the bench tools?) and no Kiln U-Boot behind it: not touched. Return to Flashforge firmware first"; fi ;;
	final:kiln|partial:kiln|partial:final)
		if [ "$UPG" = 1 ]; then
			ok "Kiln's boot loader of another build, whole, over the saved stock first MiB (nothing else differs): an upgrade$([ "$UB_WEND" -gt "$UB_END" ] && printf ', the old U-Boot longer: written up to 0x%x' "$UB_WEND")"
		elif [ -n "$UPG" ] && [ "$SPLC" = partial ] && [ "$UBC" = kiln ]; then
			note "the SPL range holds an upgrade's write cut short: written again"
		elif [ -n "$UPG" ] && [ "$UBC" = kiln ]; then
			ok "an upgrade that stopped after the SPL: this build's SPL, the old U-Boot; going on"
		elif [ "$UBC" = kiln ]; then
			bad "0xA400 holds another Kiln U-Boot ('$(tail -c +$((BL_UB_OFF + 33)) "$CUR" | head -c 32 | tr -d '\000')'), but the disk isn't the saved stock first MiB with a whole Kiln boot loader in it: not touched. Return to Flashforge firmware first"
		else
			bad "0x4400-0xA3FF holds an SPL that is neither Flashforge's nor this build's: not touched. Return to Flashforge firmware first"
		fi ;;
	stock:*) bad "0xA400 differs from the saved stock first MiB under Flashforge's SPL: refused" ;;
	other*) bad "the disk differs from the saved stock first MiB outside Kiln's ranges (offset $(printf '0x%x' "${SPLC#other }")): refused" ;;
	*) bad "0x4400-0xA3FF and 0xA400 hold neither the stock bytes nor this build's ($SPLC, $UBC): refused" ;;
	esac
	# --upgrade (the screen's Update): an upgrade or nothing to do, never
	# an install
	if [ -n "$only_upgrade" ] && [ -z "$UPG" ] && [ -z "$SAME" ]; then
		bad "--upgrade: no Kiln boot loader of another build here to update (installing Kiln's boot loader is a step of its own): refused"
	fi
	if [ -n "$only_upgrade" ] && [ -n "$DOWN" ]; then
		bad "--upgrade: this recovery OS carries an older build than the one on the disk; the screen's Update doesn't downgrade (over SSH: ad5x-bootloader-install --yes): refused"
	fi
fi

# ------------------------------------------------------------- the steps
done_0() { [ -z "$SAVE_BOOT" ] && [ -n "$US_OK" ]; }
done_1() { bl_read "$DISK" 0 $((BL_SPL_END / 512)) "$T/d1" && head -c $BL_UB_OFF "$FINAL" | cmp -s - "$T/d1"; }
done_2() { [ -n "$K66" ] && rc_drop_caches && kernel_same "$K66" "$P3"; }
done_3() { [ -n "$K66" ] && rc_drop_caches && kernel_same "$K66" "$P1"; }
done_4() { [ -n "$UPG" ] && return 0; done_5 && return 0; bl_read "$P5" $BL_OTA_LBA $BL_OTA_N "$T/d4" && is_zero "$T/d4"; }
done_5() { bl_read "$DISK" $BL_UB_LBA $((UB_WEND / 512 - BL_UB_LBA)) "$T/d5" && tail -c +$((BL_UB_OFF + 1)) "$FINAL" | head -c $((UB_WEND - BL_UB_OFF)) | cmp -s - "$T/d5"; }
# the network rescue record: boot.img's (FINAL's) sector over it, read back
clear_rescue() {
	say "LBA $BL_RESCUE_LBA: the network rescue record ($RESCUE) replaced by the saved stock first MiB's sector"
	bl_dd "$FINAL" "$DISK" bs=512 skip=$BL_RESCUE_LBA seek=$BL_RESCUE_LBA count=1 &&
		bl_same_range "$DISK" "$FINAL" $((BL_RESCUE_LBA * 512)) 512
}
NAME_0="the stock first MiB saved (/data, usershare)" NAME_1="Kiln's SPL (0x4600-0xA3FF, the length at 0x4, the header sector last)"
NAME_2="kernel2 (p3) <- Kiln's 6.6" NAME_3="kernel (p1) <- Kiln's 6.6"
NAME_4="U-Boot's settings, state and records in ota cleared" NAME_5="Kiln's U-Boot at 0xA400 (body, then header)"
STEP_UP=	# steps whose name (and screen code, bl_stepN_up) an upgrade changes
if [ -n "$UPG" ]; then
	STEP_UP=" 1 4 5 "
	NAME_1="this build's SPL (0x4600-0xA3FF, the length at 0x4, the header sector last)"
	NAME_4="U-Boot's settings, state and records in ota: kept (an upgrade)"
	NAME_5="this build's U-Boot at 0xA400 (the old header zeroed, the body, then the header)"
fi

todo=
if [ "$nfail" = 0 ]; then
	say "plan (in this order; the boot flag stays on slot A, this recovery OS):"
	[ -n "$RESCUE" ] && say "  first: LBA $BL_RESCUE_LBA (a network rescue record) <- the saved stock first MiB's sector"
	if [ -n "$SAME" ]; then
		# Kiln's boot loader is this build's: every step was done (step 5
		# runs only once 0-4 are); the slots are the main OS's to keep
		say "  nothing: the first MiB is the one this build leads to, byte for byte"
	else
		for n in 0 1 2 3 4 5; do
			eval "nm=\$NAME_$n"
			if done_$n; then say "  $n. $nm: done"
			else say "  $n. $nm"; todo="$todo $n"; fi
		done
	fi
fi
say ""
# Kiln's boot loader of this build there already, byte for byte, and no
# run of it unfinished (the record not "started"), no rescue record to
# clear: there is nothing to write, so the result is that, whatever else
# failed above (another job, start-up actions still running: those matter
# only to a write). Exit 0, as the screen's Check reads it. The record is
# left as it is (verified, unverified: the first start after the install)
already() {
	say "result: already installed (this build): Kiln's SPL and U-Boot are installed ($(bl_stval state)), the ones this recovery OS carries ($NEWV) byte for byte: nothing to do"
	exit 0
}
if [ "$nfail" != 0 ] && [ -n "$SAME" ] && [ -z "$RESCUE" ] && [ "$REC" != started ]; then
	say "plan: nothing: the first MiB is the one this build leads to, byte for byte (the failed check(s) above matter only to a write)"
	already
fi
if [ "$nfail" != 0 ]; then
	say "result: refused ($nfail check(s) failed), nothing written"
	exit 1
fi
if [ -z "$todo" ] && [ -n "$RESCUE" ]; then
	if [ "$mode" != yes ]; then
		say "result: ready: the boot loader is this build's; the network rescue record in LBA $BL_RESCUE_LBA (--yes clears it)"
		exit 2
	fi
	mkdir "$LOCK" 2>/dev/null || { say "result: refused: another $ME runs ($LOCK)"; exit 1; }
	locked=1
	clear_rescue || { say "result: failed: the rescue record's sector didn't read back as boot.img's; every system still starts (run it again)"; exit 3; }
	RESCUE=
fi
if [ -z "$todo" ]; then
	case "$REC" in started|'') bl_stset state installed; bl_stset date "$(date '+%Y-%m-%d %H:%M:%S')" ;; esac
	if [ "$REC" != started ] && [ -n "$SAME" ]; then
		already
	else
		say "result: done: Kiln's SPL and U-Boot are installed ($(bl_stval state)). Restart to start through them"
	fi
	exit 0
fi
if [ "$mode" != yes ]; then
	if [ "$REC" = started ]; then
		say "result: ready to go on: an earlier $([ -n "$UPG" ] && echo upgrade || echo install) stopped after part of the work (--yes finishes it)"
	elif [ -n "$UPG" ]; then
		say "result: ready: an upgrade of Kiln's boot loader ($OLDV -> $NEWV), nothing written yet (--yes starts it)"
	elif [ "$SPLC" != stock ] || [ "$UBC" != stock ]; then
		# no record (a wiped /data), but Kiln's SPL or part of Kiln's
		# U-Boot on the disk: an install stopped part-way. Steps 0 and 4
		# done alone are no such sign: boot.img saved earlier (by the
		# main OS or a check) and an ota area blank (Flashforge's factory
		# reset blanks it) are a fresh install's start
		say "result: ready to go on: an earlier install stopped after part of the work (--yes finishes it)"
	else
		say "result: ready to install: nothing written yet (--yes starts it)"
	fi
	exit 2
fi

# ------------------------------------------------------------- the override
# (a board not on the allowlist, or an X2600E: both need the typed phrase)
if [ -z "$BOARD_OK" ] || [ "$BL_VARIANT" = E ]; then
	say ""
	if [ "$BL_VARIANT" = E ]; then
	say "This printer has the X2600E chip (256 MiB). Kiln's SPL carries its memory"
	say "setup, but it has NOT started from the eMMC of an X2600E yet. If the"
	say "memory setup is wrong, the printer may not start at all after the next"
	say "restart, and there is no proven way to bring it back without opening it"
	say "(the J28 USB connector and Ingenic's USB tool; see docs/own-boot-loader.md)."
	say "Please post the fingerprint above and how it went in $ISSUE."
	else
	say "This board's stock boot loader is NOT one Kiln's SPL is known to fit:"
	say "Kiln's SPL sets up the DDR memory and clocks as the tested boards' stock"
	say "SPL does. If this board differs, the printer may not start at all after"
	say "the next restart, and there is no proven way to bring it back without"
	say "opening it (the J28 USB connector and Ingenic's USB tool; see"
	say "docs/own-boot-loader.md). Please post the fingerprint above in"
	say "$ISSUE either way."
	fi
	if [ -z "${AD5X_TEST_TTY:-}" ] && ! [ -t 0 ]; then
		say "result: refused: --unsupported-board needs a terminal to type the confirmation (SSH)"
		exit 1
	fi
	say "To go on, type exactly: $PHRASE"
	printf '> '
	IFS= read -r answer || answer=
	if [ "$answer" != "$PHRASE" ]; then
		say "result: refused: the confirmation didn't match, nothing written"
		exit 1
	fi
	say "confirmed: going on with an unsupported board"
fi

# ------------------------------------------------------------- --yes
mkdir "$LOCK" 2>/dev/null || { say "result: refused: another $ME runs ($LOCK)"; exit 1; }
locked=1
trap '' HUP INT TERM PIPE
# a network rescue record first: an old Kiln U-Boot started after a stop
# or a power cut from here on must not run it
if [ -n "$RESCUE" ]; then
	clear_rescue || { say "result: failed: the rescue record's sector didn't read back as boot.img's, nothing else written; every system still starts (run it again)"; exit 3; }
fi
# an upgrade: the old first MiB kept on /data first (step 1's way back
# after a stop or a power cut, too)
if [ "$UPG" = 1 ]; then
	p=$BL_DATA/before-upgrade.img
	mkdir -p "$BL_DATA" && cp "$PREV" "$p.new" && echo "$(sha "$p.new")  before-upgrade.img" > "$p.sha256.new" &&
		sync && [ "$(sha "$p.new")" = "$(sha "$PREV")" ] && mv -f "$p.new" "$p" && mv -f "$p.sha256.new" "$p.sha256" && sync || {
		rm -f "$p.new" "$p.sha256.new"
		say "result: refused: can't keep the first MiB from before the upgrade in $p, nothing written"
		exit 1
	}
	say "the first MiB from before the upgrade kept: $p"
fi
bl_stset state started
bl_stset date "$(date '+%Y-%m-%d %H:%M:%S')"
if [ -n "$UPG" ]; then
	bl_stset kind upgrade
	[ "$UPG" = 1 ] && bl_stset from "$OLDV"
else
	bl_stset kind install
	bl_stset from ""
fi
bl_stset to "$NEWV"
# the first start after this run goes into the record anew (--verify-start, S99ad5x-booted)
bl_stset start ""
bl_stset main_start ""
bl_stset board "$BL_FP_SPL $BL_FP_DDR$([ -z "$BOARD_OK" ] && echo " (not on the allowlist: --unsupported-board)")"
bl_stset chip "$BL_VARIANT, MemTotal $BL_MEM_KB kB"
bl_stset spl "$(sha "$SPLI")"
bl_stset uboot "$(sha "$UBI")"
if [ -n "$UPG" ]; then ad5x-bootlog "bootloader: upgrade started (${OLDV:-?} -> $NEWV)" 2>/dev/null
else ad5x-bootlog "bootloader: install started" 2>/dev/null; fi
say "writing (don't switch the printer off):"

fail3() {	# WHAT: a write failed, every system still starts
	loud "$1" "The boot flag is still on slot A: this recovery OS starts again." \
		"Run it again to finish ($([ -n "$UPG" ] && echo Update || echo Install) Kiln's boot loader)."
	ad5x-bootlog "bootloader: failed: $1" 2>/dev/null
	say "result: failed: $1; run it again"
	exit 3
}
fail4() {	# WHAT
	loud "$1" "THE BOOT LOADER AREA IS NOT AS BEFORE. Do not switch the printer off." \
		"Run $ME --yes again now. If that fails too, see docs/own-boot-loader.md" \
		"(the printer may need the J28 USB restore)."
	ad5x-bootlog "bootloader: boot area not as before: $1" 2>/dev/null
	say "result: failed: the boot loader area is not as before; don't switch off"
	exit 4
}
stop_point() {
	[ -n "$stop_after" ] && [ "$1" = "$stop_after" ] && { say "result: stopped after step $1 (--stop-after)"; exit 9; }
	return 0
}
step_0() {
	if [ -n "$SAVE_BOOT" ]; then
		say "  $STOCK/boot.img <- $BOOT_FROM"
		mkdir -p "$STOCK" || return 1
		n=$STOCK/.boot.img.new
		cp "$BOOT" "$n" && echo "$(sha "$n")  boot.img" > "$n.sha256" &&
			echo "Flashforge's boot loader: $(bl_banner "$n")" > "$n.info" && sync &&
			[ "$(sha "$n")" = "$(sha "$BOOT")" ] &&
			mv -f "$n.info" "$STOCK/boot.img.info" && mv -f "$n.sha256" "$STOCK/boot.img.sha256" && sync &&
			mv -f "$n" "$STOCK/boot.img" && sync || return 1
		boot_img_why >/dev/null || return 1
		BOOT=$STOCK/boot.img SAVE_BOOT=
	fi
	if ! us_has_boot; then
		usershare_umount
		say "  usershare: ad5x-stock-copy usershare"
		out=$(ad5x-stock-copy usershare 2>&1)
		echo "$out" | sed 's/^/    /' | while IFS= read -r l; do say "$l"; done
		us_has_boot || { usershare_umount; return 1; }
	fi
	usershare_umount
	US_OK=1
}
step_1() {
	prog 20 bl_spl "Writing Kiln's SPL"
	bl_put_spl "$FINAL" "$DISK" && return 0
	if [ -n "$UPG" ]; then
		# never Flashforge's SPL here: it would start the Kiln U-Boot at
		# 0xA400 as its own raw one. The old Kiln SPL, else this one again
		back=${PREV:-$FINAL}
		[ -n "$PREV" ] && what="the old Kiln SPL" || what="this build's SPL (written once more)"
		say "  Kiln's SPL didn't read back right: putting $what back"
		for k in 1 2; do
			if bl_same_range "$DISK" "$back" 0 $BL_UB_OFF || bl_put_spl "$back" "$DISK"; then
				[ "$back" = "$FINAL" ] && return 0
				loud "writing this build's SPL failed; the old Kiln SPL is back and reads back right." \
					"Nothing else was written. Run it again."
				say "result: failed: this build's SPL didn't take; the old Kiln SPL is back"
				ad5x-bootlog "bootloader: SPL write failed, the old Kiln SPL back" 2>/dev/null
				exit 3
			fi
		done
		fail4 "writing Kiln's SPL failed and $what doesn't read back either"
	fi
	say "  Kiln's SPL didn't read back right: putting Flashforge's back"
	for k in 1 2; do
		if bl_same_range "$DISK" "$BOOT" 0 $BL_UB_OFF || bl_put_spl "$BOOT" "$DISK"; then
			loud "writing Kiln's SPL failed; Flashforge's is back and reads back right." \
				"Nothing else was written. Run it again."
			say "result: failed: Kiln's SPL didn't take; Flashforge's is back"
			ad5x-bootlog "bootloader: SPL write failed, Flashforge's back" 2>/dev/null
			exit 3
		fi
	done
	fail4 "writing Kiln's SPL failed and Flashforge's doesn't read back either"
}
step_2() { prog 40 bl_kernel2 "Writing Kiln's 6.6 into kernel2"; bl_put_kernel "$K66" "$P3" && kiln_kernel "$P3"; }
step_3() { prog 60 bl_kernel "Writing Kiln's 6.6 into kernel"; bl_put_kernel "$K66" "$P1" && kiln_kernel "$P1"; }
step_4() {
	say "  ota: sectors $BL_OTA_LBA-$((BL_OTA_LBA + BL_OTA_N - 1)) (U-Boot's settings, state, records) zeroed"
	dd if=/dev/zero of="$P5" bs=512 seek=$BL_OTA_LBA count=$BL_OTA_N conv=notrunc,fsync 2>/dev/null &&
		bl_read "$P5" $BL_OTA_LBA $BL_OTA_N "$T/o4" && is_zero "$T/o4"
}
step_5() {
	prog 80 bl_uboot "Writing Kiln's U-Boot"
	# a U-Boot header there (an upgrade's old U-Boot): its sector zeroed
	# first, so no header stands in front of a body being changed; from
	# then on Kiln's SPL finds no U-Boot and starts the flagged slot itself
	if bl_read "$DISK" $BL_UB_LBA 1 "$T/h5" && [ "$(bl_ufield "$T/h5" 0)" = 27051956 ]; then
		say "  sector $BL_UB_LBA (the U-Boot header there, '$(tail -c +33 "$T/h5" | head -c 32 | tr -d '\000')') zeroed first: until the new one is written last, Kiln's SPL starts the flagged slot itself"
		bl_dd /dev/zero "$DISK" bs=512 seek=$BL_UB_LBA count=1 && bl_read "$DISK" $BL_UB_LBA 1 "$T/h5" && is_zero "$T/h5" || return 1
	fi
	[ "$UB_WEND" -gt "$UB_END" ] && say "  the old U-Boot was longer: sectors up to $((UB_WEND / 512 - 1)) written (boot.img's bytes past this build's U-Boot)"
	bl_put_uboot "$FINAL" "$DISK" "$UB_WEND" && cur_mib "$T/rb.img" && cmp -s "$T/rb.img" "$FINAL" && return 0
	say "  Kiln's U-Boot didn't read back right: putting the stock bytes back from 0xA400 (header first)"
	for k in 1 2; do
		if bl_same_range "$DISK" "$BOOT" $BL_UB_OFF $((UB_WEND - BL_UB_OFF)) || bl_unput_uboot "$BOOT" "$DISK" "$UB_WEND"; then
			fail3 "Kiln's U-Boot didn't take; the stock bytes are back at 0xA400 (Kiln's SPL starts the slots itself)"
		fi
	done
	fail4 "writing Kiln's U-Boot failed and the stock bytes don't read back either"
}

si=0 total=$(echo $todo | wc -w)
for sn in $todo; do
	eval "nm=\$NAME_$sn"
	pc=bl_step$sn
	case "$STEP_UP" in *" $sn "*) pc=${pc}_up ;; esac
	prog $((10 + si * 85 / total)) $pc "Step $sn: $nm"
	if [ "$sn" = 5 ]; then
		# every step before it, checked once more on the disk
		for sm in 0 1 2 3 4; do done_$sm || fail3 "step $sm isn't done on the disk before U-Boot"; done
	fi
	step_$sn || fail3 "step $sn ($nm) failed or didn't read back"
	say "  step $sn done: $nm"
	si=$((si + 1))
	stop_point $sn
done
cur_mib "$T/rb.img" && cmp -s "$T/rb.img" "$FINAL" || fail3 "the first MiB doesn't read back as expected at the end"
bl_stset state installed
bl_stset date "$(date '+%Y-%m-%d %H:%M:%S')"
prog 100 done "Done"
if [ -n "$UPG" ]; then
	ad5x-bootlog "bootloader: upgraded (${OLDV:-?} -> $NEWV)" 2>/dev/null
	say "result: done: Kiln's boot loader upgraded (${OLDV:-?} -> $NEWV). Restart: it starts this recovery OS, and the screen shows the result"
else
	ad5x-bootlog "bootloader: installed" 2>/dev/null
	say "result: done. Restart: Kiln's boot loader starts this recovery OS, and the screen shows the result"
fi
exit 0
