#!/bin/sh
# Mount the printer's data partition (GPT "userdata", stock /usr/data) at
# /data, read-write: SSH host keys, the update drop folder, logs. A failed
# mount gets one e2fsck -p and a second try; without it /data is a tmpfs.
# Root login: the password set with ad5x-passwd, else stock's root password
# (usershare /etc/shadow), bound over our /etc/shadow as the main OS does
# (lib/rootpw.sh); keys in /data/ad5x/ssh/authorized_keys.
. /usr/lib/ad5x-recovery/recovery.sh
case "$1" in
start)
	dev=$(rc_part userdata)
	if grep -q ' /data ' /proc/mounts; then
		echo "data: /data already mounted"
	elif [ -n "$dev" ] && { mount -t ext4 -o noatime "$dev" /data ||
		{ echo "data: mount failed, e2fsck -p $dev"; e2fsck -p "$dev"
		  mount -t ext4 -o noatime "$dev" /data; }; }; then
		echo "data: $dev on /data"
	else
		echo "data: no usable userdata partition, tmpfs on /data (nothing is kept)"
		mount -t tmpfs -o mode=0755 tmpfs /data
	fi
	# No battery clock: the last time the main OS saved instead of 1970
	ad5x-clock restore
	mkdir -p /data/ad5x/ssh/hostkeys /data/ad5x/update /data/ad5x/recovery
	chmod 700 /data/ad5x/ssh
	us=$(rc_part usershare)
	mkdir -p /tmp/usershare
	if [ -n "$us" ] && mount -t ext4 -o ro "$us" /tmp/usershare; then
		hash=$(sed -n 's/^root:\([^:]*\):.*/\1/p' /tmp/usershare/etc/shadow 2>/dev/null)
		umount /tmp/usershare
	fi
	# The main OS's lib/rootpw.sh: the password set with ad5x-passwd
	# (/data/ad5x/ssh/root-password) when it is sound, else stock's
	if [ ! -f /usr/lib/ad5x/rootpw.sh ]; then
		# Without the library (it shouldn't happen): stock's hash, as
		# before it, so the rest of this script still runs
		echo "data: rootpw.sh missing, stock's root password only"
		# (no stock hash: the image's own /etc/shadow, whose root
		# password is the default "root" (post-build.sh); the hash
		# reaches awk through its environment, not its argv)
		if [ -n "$hash" ] && ! grep -q ' /etc/shadow ' /proc/mounts; then
			mkdir -p /run/ad5x
			(umask 077; H=$hash awk -F: -v OFS=: \
				'$1 == "root" { $2 = ENVIRON["H"] } 1' /etc/shadow > /run/ad5x/shadow)
			chmod 600 /run/ad5x/shadow
			mount --bind /run/ad5x/shadow /etc/shadow
		fi
	elif . /usr/lib/ad5x/rootpw.sh && rootpw_boot "$hash"; then
		case $ROOTPW_FROM in
		kiln) echo "data: root password set with ad5x-passwd" ;;
		stock) echo "data: root password from stock's settings" ;;
		default) echo "data: no root password set and no stock one: the default, root" ;;
		esac
	else
		echo "data: root password copy not made; the image's own applies (root)"
	fi
	# SSH host keys kept on /data (/etc/dropbear -> /var/run/dropbear), the
	# same keys as the main OS.
	mkdir -p /run/dropbear
	grep -q ' /run/dropbear ' /proc/mounts || \
		mount --bind /data/ad5x/ssh/hostkeys /run/dropbear
	;;
stop)
	umount /data 2>/dev/null
	;;
esac
exit 0
