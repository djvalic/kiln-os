@@ -7,6 +7,7 @@
 from __future__ import annotations
 import os
 import sys
+import stat
 import pathlib
 import shutil
 import logging
@@ -64,6 +65,12 @@ WATCH_FLAGS = iFlags.CREATE | iFlags.DELETE | iFlags.MODIFY \
     | iFlags.MOVED_TO | iFlags.MOVED_FROM | iFlags.ONLYDIR \
     | iFlags.CLOSE_WRITE
 
+def _have_write_access(path: StrOrPath) -> bool:
+    # Kiln OS: as the upload check in _parse_upload_args()
+    if os.access in os.supports_effective_ids:
+        return os.access(path, os.W_OK, effective_ids=True)
+    return os.access(path, os.W_OK)
+
 class FileManager:
     def __init__(self, config: ConfigHelper) -> None:
         self.server = config.get_server()
@@ -763,11 +770,13 @@ class FileManager:
                 f"Directory does not exist ({path})")
         self.check_reserved_path(path, False)
         flist: Dict[str, Any] = {'dirs': [], 'files': []}
+        folder_access: Dict[str, bool] = {}
         for fname in os.listdir(path):
             full_path = os.path.join(path, fname)
             if not os.path.exists(full_path):
                 continue
-            path_info = self.get_path_info(full_path, root)
+            path_info = self.get_path_info(
+                full_path, root, folder_access=folder_access)
             if os.path.isdir(full_path):
                 path_info['dirname'] = fname
                 flist['dirs'].append(path_info)
@@ -794,7 +803,11 @@ class FileManager:
         return flist
 
     def get_path_info(
-        self, path: StrOrPath, root: str, raise_error: bool = True
+        self,
+        path: StrOrPath,
+        root: str,
+        raise_error: bool = True,
+        folder_access: Optional[Dict[str, bool]] = None
     ) -> Dict[str, Any]:
         if isinstance(path, str):
             path = pathlib.Path(path)
@@ -820,12 +833,41 @@ class FileManager:
                         permissions = ""
                         break
                     permissions = "r"
+            if (
+                permissions == "rw" and
+                not self._can_write(
+                    path, stat.S_ISDIR(fstat.st_mode), folder_access)
+            ):
+                permissions = "r"
         return {
             'modified': fstat.st_mtime,
             'size': fstat.st_size,
             'permissions': permissions
         }
 
+    def _can_write(
+        self,
+        path: pathlib.Path,
+        is_dir: bool,
+        folder_access: Optional[Dict[str, bool]] = None
+    ) -> bool:
+        """Kiln OS: can this process change the item at path? A folder: can
+        it write into it. A file: can it write the file and the folder
+        that holds it. An upload is moved over the file from the temp
+        folder: a rename needs the folder, the copy shutil.move() falls
+        back to needs the file; a delete or a rename needs the folder.
+        folder_access caches the folder results over one listing."""
+        if not _have_write_access(path):
+            return False
+        if is_dir:
+            return True
+        folder = os.path.dirname(path)
+        if folder_access is None:
+            return _have_write_access(folder)
+        if folder not in folder_access:
+            folder_access[folder] = _have_write_access(folder)
+        return folder_access[folder]
+
     def gen_temp_upload_path(self) -> str:
         loop_time = int(self.event_loop.get_loop_time())
         return os.path.join(
@@ -1067,6 +1109,7 @@ class FileManager:
