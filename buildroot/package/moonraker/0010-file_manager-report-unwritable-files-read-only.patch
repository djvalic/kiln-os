 .../components/file_manager/file_manager.py   |  50 +++++-
 tests/test_file_manager.py                    | 145 ++++++++++++++++++
 2 files changed, 192 insertions(+), 3 deletions(-)
 create mode 100644 tests/test_file_manager.py

diff --git a/moonraker/components/file_manager/file_manager.py b/moonraker/components/file_manager/file_manager.py
