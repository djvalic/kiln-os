                 continue
             unlisted.add((ust.st_dev, ust.st_ino))
+        folder_access: Dict[str, bool] = {}
         for dir_path, dir_names, files in os.walk(path, followlinks=True):
             scan_dirs: List[str] = []
             # Filter out directories that have already been visited. This
@@ -1090,7 +1133,8 @@ class FileManager:
                 if not os.path.exists(full_path):
                     continue
                 fname = full_path[len(path) + 1:]
-                finfo = self.get_path_info(full_path, root)
+                finfo = self.get_path_info(
+                    full_path, root, folder_access=folder_access)
                 filelist[fname] = finfo
         if list_format:
             flist: List[Dict[str, Any]] = []
diff --git a/tests/test_file_manager.py b/tests/test_file_manager.py
new file mode 100644
index 0000000..8ebd020
--- /dev/null
+++ b/tests/test_file_manager.py
@@ -0,0 +1,145 @@
+# Unit tests for the permissions the file manager reports
+#
+# This file may be distributed under the terms of the GNU GPLv3 license.
+from __future__ import annotations
+import os
+import pathlib
+import pytest
+from typing import Dict, Iterator, Tuple
+from unittest import mock
+from moonraker.components.file_manager import file_manager as fm_module
+from moonraker.components.file_manager.file_manager import FileManager
+
+# Root bypasses the mode bits, os.access() is True for everything
+pytestmark = pytest.mark.skipif(
+    os.geteuid() == 0, reason="permission checks don't apply to root"
+)
+
+
+def make_manager(root_path: pathlib.Path) -> FileManager:
+    # A bare FileManager without running __init__: get_path_info() and the
+    # listings only read these attributes.
+    fm = FileManager.__new__(FileManager)
+    fm.file_paths = {"config": str(root_path)}
+    fm.full_access_roots = {"config"}
+    fm.reserved_paths = {}
+    fm.unlisted_paths = set()
+    return fm
+
+
+@pytest.fixture
+def config_root(tmp_path: pathlib.Path) -> Iterator[pathlib.Path]:
+    root = tmp_path.joinpath("config")
+    root.mkdir()
+    root.joinpath("printer.cfg").write_text("[printer]\n")
+    root.joinpath("locked.cfg").write_text("[locked]\n")
+    root.joinpath("locked.cfg").chmod(0o444)
+    plugin = root.joinpath("plugin")
+    plugin.mkdir()
+    for name in ("plugin.cfg", "macros.cfg"):
+        plugin.joinpath(name).write_text("[gcode_macro TEST]\n")
+    plugin.chmod(0o555)
+    yield root
+    # let pytest remove the folder
+    plugin.chmod(0o755)
+
+
+def perms(fm: FileManager, path: pathlib.Path, **kwargs) -> str:
+    return fm.get_path_info(path, "config", **kwargs)["permissions"]
+
+
+def test_writable_file(config_root: pathlib.Path) -> None:
+    fm = make_manager(config_root)
+    assert perms(fm, config_root.joinpath("printer.cfg")) == "rw"
+
+
+def test_unwritable_file(config_root: pathlib.Path) -> None:
+    fm = make_manager(config_root)
+    assert perms(fm, config_root.joinpath("locked.cfg")) == "r"
+
+
+def test_file_in_unwritable_folder(config_root: pathlib.Path) -> None:
+    # The file itself is writable, but an upload replaces it with a file
+    # moved into its folder
+    fm = make_manager(config_root)
+    path = config_root.joinpath("plugin", "plugin.cfg")
+    assert os.access(path, os.W_OK)
+    assert perms(fm, path) == "r"
+
+
+def test_folders(config_root: pathlib.Path) -> None:
+    fm = make_manager(config_root)
+    assert perms(fm, config_root) == "rw"
+    assert perms(fm, config_root.joinpath("plugin")) == "r"
+
+
+def test_link_to_unwritable_folder(config_root: pathlib.Path) -> None:
+    # A file reached through a linked folder is checked in the folder the
+    # link points to
+    fm = make_manager(config_root)
+    link = config_root.joinpath("linked")
+    link.symlink_to(config_root.joinpath("plugin"))
+    assert perms(fm, link) == "r"
+    assert perms(fm, link.joinpath("macros.cfg")) == "r"
+
+
+def test_existing_rules_kept(config_root: pathlib.Path) -> None:
+    # Only "rw" is lowered: read only roots and reserved paths stay as they
+    # were, and an unwritable file never becomes writable
+    fm = make_manager(config_root)
+    fm.full_access_roots = set()
+    assert perms(fm, config_root.joinpath("printer.cfg")) == "r"
+    assert perms(fm, config_root.joinpath("locked.cfg")) == "r"
+    fm.full_access_roots = {"config"}
+    fm.reserved_paths = {
+        "update_manager plugin": (config_root.joinpath("plugin"), True),
+        "secrets": (config_root.joinpath("printer.cfg").resolve(), False),
+    }
+    assert perms(fm, config_root.joinpath("plugin", "plugin.cfg")) == "r"
+    assert perms(fm, config_root.joinpath("printer.cfg")) == ""
+    assert perms(fm, config_root.joinpath("locked.cfg")) == "r"
+
+
+def count_access(fm: FileManager, call) -> Tuple[Dict[str, int], object]:
+    calls: Dict[str, int] = {}
+    real_access = fm_module._have_write_access
+
+    def counted(path) -> bool:
+        calls[str(path)] = calls.get(str(path), 0) + 1
+        return real_access(path)
+    with mock.patch.object(fm_module, "_have_write_access", counted):
+        result = call()
+    return calls, result
+
+
+def test_list_directory(config_root: pathlib.Path) -> None:
+    fm = make_manager(config_root)
+    plugin = config_root.joinpath("plugin")
+    calls, result = count_access(
+        fm, lambda: fm._list_directory(str(plugin), "config"))
+    files = {f["filename"]: f["permissions"] for f in result["files"]}
+    assert files == {"plugin.cfg": "r", "macros.cfg": "r"}
+    # the folder is checked once for the whole listing
+    assert calls[str(plugin)] == 1
+    calls, result = count_access(
+        fm, lambda: fm._list_directory(str(config_root), "config"))
+    files = {f["filename"]: f["permissions"] for f in result["files"]}
+    dirs = {d["dirname"]: d["permissions"] for d in result["dirs"]}
+    assert files == {"printer.cfg": "rw", "locked.cfg": "r"}
+    assert dirs == {"plugin": "r"}
+    # printer.cfg's folder; locked.cfg stops at the file
+    assert calls[str(config_root)] == 1
+    assert result["root_info"] == {"name": "config", "permissions": "rw"}
+
+
+def test_file_list(config_root: pathlib.Path) -> None:
+    fm = make_manager(config_root)
+    calls, result = count_access(fm, lambda: fm.get_file_list("config"))
+    found = {name: info["permissions"] for name, info in result.items()}
+    assert found == {
+        "printer.cfg": "rw",
+        "locked.cfg": "r",
+        os.path.join("plugin", "plugin.cfg"): "r",
+        os.path.join("plugin", "macros.cfg"): "r",
+    }
+    assert calls[str(config_root.joinpath("plugin"))] == 1
