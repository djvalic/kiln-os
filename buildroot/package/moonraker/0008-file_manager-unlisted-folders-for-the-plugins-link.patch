+    def add_unlisted_path(self, path: StrOrPath) -> None:
+        """Kiln OS: a folder that get_file_list() (server.files.list) doesn't
+        enter when it is reached inside a root, through a link or not. It
+        stays browsable with get_directory, and its files can be read,
+        written, uploaded and deleted as before; inotify still watches it.
+        For big trees linked into a root, such as the plugins folder in
+        config: the list runs on the event loop and costs several ms per
+        file on the AD5X (get_path_info)."""
+        if isinstance(path, str):
+            path = pathlib.Path(path)
+        self.unlisted_paths.add(path.expanduser().resolve())
