+def system_bus_present() -> bool:
+    # The system bus address as dbus_fast reads it. Only a unix socket
+    # path can be checked; any other transport is tried.
+    address = os.environ.get("DBUS_SYSTEM_BUS_ADDRESS") or SYSTEM_BUS_ADDRESS
+    for entry in address.split(";"):
+        transport, _, options = entry.strip().partition(":")
+        if not transport:
+            continue
+        paths = [
+            unquote(opt[5:]) for opt in options.split(",")
+            if opt.startswith("path=")
+        ]
+        if transport != "unix" or not paths or os.path.exists(paths[0]):
+            return True
+    return False
