From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: valix <djvalic.wc@gmail.com>
Date: Mon, 9 Nov 2026 12:00:00 +0000
Subject: [PATCH] led, output_pin: send late after a host stall, not in the past

An idle SET_LED, SET_PIN, SET_FAN_SPEED or M106 is scheduled at the
toolhead's idle start time, about 0.25 s ahead of the MCU clock, but it
is sent only after the rest of the macro and the next reactor pass. On
the AD5X a host stall of that size (Moonraker zipping timelapse frames)
left the time in the past and the MCU stopped with "Timer too close".

Kiln OS: when the scheduled time is already less than the MCU's minimum
schedule time (0.1 s) away, use now + 0.1 s instead. Nothing changes
when the host keeps up; batch (file output) mode is unchanged. Step
timing is not touched. Issue #40.
---
--- a/klippy/extras/led.py
+++ b/klippy/extras/led.py
@@ -134,9 +134,14 @@ class PrinterPWMLED:
     def update_leds(self, led_state, print_time):
         mcu = self.pins[0][1].get_mcu()
         min_sched_time = mcu.min_schedule_time()
+        eventtime = self.printer.get_reactor().monotonic()
+        min_print_time = mcu.estimated_print_time(eventtime) + min_sched_time
         if print_time is None:
-            eventtime = self.printer.get_reactor().monotonic()
-            print_time = mcu.estimated_print_time(eventtime) + min_sched_time
+            print_time = min_print_time
+        elif not mcu.is_fileoutput():
+            # Kiln OS: a host stall between SET_LED and this send can leave
+            # print_time in the past ("Timer too close"); send late instead
+            print_time = max(print_time, min_print_time)
         print_time = max(print_time, self.last_print_time + min_sched_time)
         color = led_state[0]
         for idx, mcu_pin in self.pins:
--- a/klippy/extras/output_pin.py
+++ b/klippy/extras/output_pin.py
@@ -37,6 +37,12 @@ class GCodeRequestQueue:
             while pos + 1 < len(rqueue) and rqueue[pos + 1][0] <= next_time:
                 pos += 1
             req_pt, req_val = rqueue[pos]
+            if not self.mcu.is_fileoutput():
+                # Kiln OS: after a host stall, send late instead of in the
+                # past ("Timer too close")
+                systime = self.printer.get_reactor().monotonic()
+                next_time = max(next_time, min_sched_time
+                                + self.mcu.estimated_print_time(systime))
             # Invoke callback for the request
             ret = self.callback(next_time, req_val)
             if ret is not None:
