+const helix::printer::DeviceAction* find_action(
+    const std::vector<helix::printer::DeviceAction>& actions, const std::string& id) {
+    for (const auto& a : actions) {
+        if (a.id == id) {
+            return &a;
+        }
+    }
+    return nullptr;
+}
