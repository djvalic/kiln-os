+TEST_CASE("AD5X IFS lists Kiln's device operations", "[ams][ad5x_ifs][kiln_ifs][device_actions]") {
+    KilnCaptureBackend backend;
+
+    SECTION("nothing before the driver's fields arrive") {
+        CHECK(backend.get_device_sections().empty());
+        CHECK(backend.get_device_actions().empty());
+    }
+
+    Ad5xIfsTestAccess::handle_status(backend, kiln_idle_frame());
+    Ad5xIfsTestAccess::handle_status(backend, kiln_refill_frame(true));
+    Ad5xIfsTestAccess::handle_status(backend, kiln_info_frame());
+
+    SECTION("sections from the shared vocabulary") {
+        const auto sections = backend.get_device_sections();
+        std::vector<std::string> ids;
+        for (const auto& s : sections) {
+            ids.push_back(s.id);
+            const auto* kind = helix::printer::find_device_section_kind(s.id);
+            REQUIRE(kind != nullptr);
+            CHECK(s.label == kind->label);
+        }
+        CHECK(ids == std::vector<std::string>{"endless_spool", "setup", "calibration", "feeder"});
+        // Every action sits in a declared section.
+        for (const auto& a : backend.get_device_actions()) {
+            INFO(a.id);
+            CHECK(std::find(ids.begin(), ids.end(), a.section) != ids.end());
+        }
+    }
+    SECTION("values the driver published") {
+        const auto actions = backend.get_device_actions();
+        const auto* match = find_action(actions, "kiln_refill_match");
+        REQUIRE(match);
+        CHECK(std::any_cast<std::string>(match->current_value) == "Similar");
+        const auto* map = find_action(actions, "kiln_map_mode");
+        REQUIRE(map);
+        CHECK(std::any_cast<std::string>(map->current_value) == "Slot per file");
+        const auto* speed = find_action(actions, "kiln_tune_speed");
+        REQUIRE(speed);
+        CHECK(std::any_cast<std::string>(speed->current_value) == "1500 mm/min");
+        const auto* load = find_action(actions, "kiln_tune_load");
+        REQUIRE(load);
+        CHECK(std::any_cast<std::string>(load->current_value) ==
+              "1: 512 mm · 2: - · 3: 498 mm · 4: -");
+        const auto* unload = find_action(actions, "kiln_tune_unload");
+        REQUIRE(unload);
+        CHECK(std::any_cast<std::string>(unload->current_value) == "Not tuned");
+        CHECK(find_action(actions, "kiln_tune_progress") == nullptr);
+        CHECK(backend.get_system_info().version == "3.0.7");
+    }
+    SECTION("pre-feed only a slot with filament that is not loaded") {
+        const auto actions = backend.get_device_actions();
+        const auto* one = find_action(actions, "kiln_prefeed_1");
+        const auto* two = find_action(actions, "kiln_prefeed_2");
