+std::vector<helix::printer::DeviceSection> AmsBackendAd5xIfs::get_device_sections() const {
+    using helix::printer::device_section;
+    std::vector<helix::printer::DeviceSection> sections;
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!ifs_module_live_.load() || has_ifs_vars_) {
+        return sections;
+    }
+    if (kiln_refill_live_locked()) {
+        sections.push_back(
+            device_section("endless_spool", 0, TR_NOOP("Which spool auto-refill takes over with")));
+    }
+    if (kiln_info_.map_mode.has_value()) {
+        sections.push_back(
+            device_section("setup", 1, TR_NOOP("Which slot each tool of a print uses")));
+    }
+    if (kiln_info_.tune_seen) {
+        sections.push_back(device_section("calibration", 2,
+                                          TR_NOOP("Tune the IFS feed speed and load distances")));
+    }
+    if (kiln_info_.tune_seen || kiln_refill_.enabled.has_value()) {
+        sections.push_back(
+            device_section("feeder", 3, TR_NOOP("Feed a spool up to the toolhead in advance")));
+    }
+    return sections;
+}
+
+std::vector<helix::printer::DeviceAction> AmsBackendAd5xIfs::get_device_actions() const {
+    using DA = helix::printer::DeviceAction;
+    std::vector<DA> actions;
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!ifs_module_live_.load() || has_ifs_vars_) {
+        return actions;
+    }
+    const bool ifs_busy =
+        kiln_owns_action_ || ams_action_holds_system(system_info_.action) || kiln_info_.tune_running;
+
+    if (kiln_refill_live_locked()) {
+        actions.push_back(DA::dropdown(
+            "kiln_refill_match", "Colour match", "endless_spool", kiln_choice_labels(kKilnMatches),
+            kiln_choice_label(kKilnMatches, kiln_refill_.match), "palette",
+            "Exact: the same colour code. Similar: close shades. Any colour: the same material is "
+            "enough."));
+    }
+
+    if (kiln_info_.map_mode.has_value()) {
+        actions.push_back(DA::dropdown(
+            "kiln_map_mode", "Tool to slot", "setup", kiln_choice_labels(kKilnMapModes),
+            kiln_choice_label(kKilnMapModes, *kiln_info_.map_mode), "filament",
+            "Slot per file: the file's own slot for each tool. Auto colour: each tool uses the "
+            "loaded slot with the same material and the nearest colour, so a file made before can "
+            "still print."));
+    }
+
+    if (kiln_info_.tune_seen) {
+        DA tune = DA::button("kiln_tune", "Tune IFS", "calibration", "tune",
+                             "Finds the fastest reliable feed speed and each slot's distance to "
+                             "the toolhead sensor. Cuts and loads filament; takes several minutes.")
+                      .with_machine_motion();
+        if (kiln_info_.tune_running) {
+            tune.enabled = false;
+            tune.disable_reason = TR_NOOP("Tuning is running");
+        } else if (ifs_busy) {
+            tune.enabled = false;
+            tune.disable_reason = TR_NOOP("The IFS is busy");
+        }
+        actions.push_back(std::move(tune));
+
+        if (kiln_info_.tune_running) {
+            std::string progress =
+                fmt::format("{:.0f}%", kiln_info_.tune_progress * 100.0);
+            if (!kiln_info_.tune_message.empty()) {
+                progress += " · " + kiln_info_.tune_message;
+            }
+            actions.push_back(DA::info("kiln_tune_progress", "Tuning", "calibration",
+                                       std::move(progress), "progress_clock"));
+        } else if (!kiln_info_.tune_message.empty()) {
+            actions.push_back(DA::info("kiln_tune_result", "Last tune", "calibration",
+                                       kiln_info_.tune_message, "info_outline"));
+        }
+
+        const std::string not_tuned = lv_tr("Not tuned");
+        actions.push_back(DA::info(
+            "kiln_tune_speed", "Feed speed", "calibration",
+            kiln_info_.tune_speed ? fmt::format("{:.0f} mm/min", *kiln_info_.tune_speed)
+                                  : not_tuned,
+            "speed_up"));
+        std::string load;
+        bool any_load = false;
+        for (int i = 0; i < kNumPorts; ++i) {
+            const auto& d = kiln_info_.tune_load_dist[static_cast<size_t>(i)];
+            any_load = any_load || d.has_value();
+            load += fmt::format("{}{}: {}", i ? " · " : "", i + 1, d ? kiln_mm(*d) : "-");
+        }
+        actions.push_back(DA::info("kiln_tune_load", "Load distance", "calibration",
+                                   any_load ? load : not_tuned, "arrow_down"));
+        actions.push_back(DA::info(
+            "kiln_tune_unload", "Unload distance", "calibration",
+            kiln_info_.tune_unload_dist ? kiln_mm(*kiln_info_.tune_unload_dist) : not_tuned,
+            "arrow_up"));
+    }
+
+    if (kiln_info_.tune_seen || kiln_refill_.enabled.has_value()) {
+        // One literal per slot: the label is its own translation key.
+        static constexpr const char* kPrefeedLabels[kNumPorts] = {
+            TR_NOOP("Pre-feed slot 1"), TR_NOOP("Pre-feed slot 2"), TR_NOOP("Pre-feed slot 3"),
+            TR_NOOP("Pre-feed slot 4")};
+        for (int i = 0; i < kNumPorts; ++i) {
+            DA prefeed =
+                DA::button(kKilnPrefeedPrefix + std::to_string(i + 1), kPrefeedLabels[i],
+                           "feeder", "",
+                           "Feeds the spool up to the toolhead sensor and backs it off, so a "
+                           "swap to it is quick")
+                    .with_machine_motion();
+            prefeed.slot_index = i;
+            if (!port_presence_[static_cast<size_t>(i)]) {
+                prefeed.enabled = false;
+                prefeed.disable_reason = TR_NOOP("No filament in this slot");
+            } else if (system_info_.current_slot == i) {
+                prefeed.enabled = false;
+                prefeed.disable_reason = TR_NOOP("Loaded in the toolhead");
+            } else if (ifs_busy) {
+                prefeed.enabled = false;
+                prefeed.disable_reason = TR_NOOP("The IFS is busy");
+            }
+            actions.push_back(std::move(prefeed));
+        }
+    }
+    return actions;
+}
+
+AmsError AmsBackendAd5xIfs::do_execute_device_action(const std::string& action_id,
+                                                     const std::any& value) {
+    if (action_id == "kiln_refill_match" || action_id == "kiln_map_mode") {
+        const bool match = action_id == "kiln_refill_match";
+        const auto [choice, err] = helix::printer::device_action_value<std::string>(
+            value, match ? "colour match" : "tool to slot");
+        if (!err) {
+            return err;
+        }
+        const char* name = match ? kiln_choice_value(kKilnMatches, choice)
+                                 : kiln_choice_value(kKilnMapModes, choice);
+        if (name == nullptr) {
+            return AmsErrorHelper::invalid_parameter("Unknown choice: " + choice);
+        }
+        return execute_gcode(match ? fmt::format("IFS_AUTO_REFILL MATCH={}", name)
+                                   : fmt::format("IFS_MAP_MODE MODE={}", name));
+    }
+    if (action_id == "kiln_tune") {
+        return execute_gcode("IFS_TUNE");
+    }
+    if (action_id.rfind(kKilnPrefeedPrefix, 0) == 0) {
+        const auto channel =
+            helix::text_io::parse_leading<int>(action_id.substr(std::strlen(kKilnPrefeedPrefix)));
+        if (!channel || *channel < 1 || *channel > kNumPorts) {
+            return AmsErrorHelper::invalid_parameter("Unknown slot: " + action_id);
+        }
+        return execute_gcode(fmt::format("IFS_PREFEED CHANNEL={}", *channel));
+    }
+    return AmsErrorHelper::not_supported("Unknown IFS action: " + action_id);
+}
