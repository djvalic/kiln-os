+json kiln_info_frame(bool tune_running = false) {
+    return json{{"ifs",
+                 {{"map_mode", "fixed"},
+                  {"version", "3.0.7"},
+                  {"tune",
+                   {{"speed", 1500.0},
+                    {"load_dist", {{"1", 512.4}, {"2", nullptr}, {"3", 498.0}, {"4", nullptr}}},
+                    {"unload_dist", nullptr},
+                    {"tube_unload", nullptr},
+                    {"running", tune_running},
+                    {"progress", tune_running ? 0.45 : 0.0},
+                    {"message", tune_running ? "Speed 1500 mm/min" : ""}}}}}};
+}
