+constexpr const char* kKilnPrefeedPrefix = "kiln_prefeed_";
+
+/// The colour match choices, as the dropdown shows them (Settings > Filament
+/// Auto-Refill uses the same words), and Klipper's names for them.
+struct KilnChoice {
+    const char* label;
+    const char* value;
+};
+constexpr KilnChoice kKilnMatches[] = {
+    {TR_NOOP("Exact"), "exact"}, {TR_NOOP("Similar"), "similar"}, {TR_NOOP("Any colour"), "any"}};
+constexpr KilnChoice kKilnMapModes[] = {{TR_NOOP("Slot per file"), "fixed"},
+                                        {TR_NOOP("Auto colour"), "loaded"}};
+
+template <size_t N> std::vector<std::string> kiln_choice_labels(const KilnChoice (&choices)[N]) {
+    std::vector<std::string> out;
+    for (const auto& c : choices) {
+        out.emplace_back(lv_tr(c.label));
+    }
+    return out;
+}
+
+/// The label shown for Klipper's @p value, or empty when it names none.
+template <size_t N>
+std::string kiln_choice_label(const KilnChoice (&choices)[N], const std::string& value) {
+    for (const auto& c : choices) {
+        if (value == c.value) {
+            return lv_tr(c.label);
+        }
+    }
+    return {};
+}
+
+/// Klipper's name for the shown @p label, or nullptr.
+template <size_t N>
+const char* kiln_choice_value(const KilnChoice (&choices)[N], const std::string& label) {
+    for (const auto& c : choices) {
+        if (label == lv_tr(c.label) || label == c.value) {
+            return c.value;
+        }
+    }
+    return nullptr;
+}
+
+std::string kiln_mm(double mm) {
+    return fmt::format("{:.0f} mm", mm);
+}
+
