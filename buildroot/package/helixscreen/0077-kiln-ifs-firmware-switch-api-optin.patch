+    if (watch) {
+        // Klipper is stopped on purpose: no "Printer shutdown" or "Klipper
+        // disconnected" dialog, renewed at each tick, also with the overlay closed
+        EmergencyStopOverlay::instance().suppress_recovery_dialog(
+            helix::recovery_suppression::LONG);
+        if (!poll_timer_ && !client_override_) {
+            poll_timer_.reset(lv_timer_create(
+                [](lv_timer_t* t) {
+                    static_cast<Ad5xIfsFirmwareModel*>(lv_timer_get_user_data(t))->poll_tick();
+                },
+                kPollMs, this));
+        }
+    } else {
+        poll_timer_.reset();
+        if (watching_ && following_ && klippy_failed_) {
