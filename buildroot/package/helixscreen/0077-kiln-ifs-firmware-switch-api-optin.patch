+    drain();
+    CHECK(subject_int("ad5x_ifs_firmware_available") == 0);
+    CHECK_FALSE(model().state().has_value());
+}
+
+TEST_CASE_METHOD(IfsFirmwareFixture, "a switch: sent, followed, held off, shown when Klipper is back",
+                 "[ad5x_ifs_firmware]") {
+    fetched(kiln_object("stock"));
+    requested("klipper");
+    CHECK(model().busy());
+    CHECK(model().watching());
+    CHECK(model().status().state == "running");
+    CHECK(EmergencyStopOverlay::instance().is_recovery_suppressed());
+    // A second tap does nothing
+    model().request_switch("stock");
+    CHECK(client.rpc_calls.size() == 1);
+
+    client.rpc_calls[0].success_cb(
+        rpc_result(kiln_object("unknown", "running", true, "klipper", "stopping")));
+    drain();
+    client.rpc_calls.clear();
+    CHECK(model().status().phase == "stopping");
+    CHECK(hardware_change_expected());
+
+    // Klipper stops: the model keeps asking Kiln, also with no overlay
+    model().set_listener(nullptr);
+    model().on_klippy_state(static_cast<int>(helix::KlippyState::STARTUP));
+    model().poll_tick();
+    REQUIRE(client.rpc_calls.size() == 1);
+    CHECK(client.rpc_calls[0].method == kGetMethod);
+    client.rpc_calls[0].success_cb(
+        rpc_result(kiln_object("unknown", "running", true, "klipper", "replug")));
+    drain();
+    client.rpc_calls.clear();
+    CHECK(model().status().phase == "replug");
+
+    // Done, Klipper still starting: still watched and held off
+    model().poll_tick();
+    REQUIRE(client.rpc_calls.size() == 1);
+    client.rpc_calls[0].success_cb(rpc_result(
+        kiln_object("unknown", "done", true, "klipper", nullptr, nullptr, "v0.13.0-806")));
+    drain();
+    client.rpc_calls.clear();
+    CHECK(model().watching());
+    CHECK(ifs_firmware_view(model().status(), model().klippy_ready(), model().seconds_waiting())
+              .kind == IfsFirmwareViewKind::Progress);
+
+    // Klipper is back: Kiln is asked once more, the result shows
+    model().on_klippy_state(static_cast<int>(helix::KlippyState::READY));
+    REQUIRE(client.rpc_calls.size() == 1);
+    client.rpc_calls[0].success_cb(rpc_result(
+        kiln_object("klipper", "done", true, "klipper", nullptr, nullptr, "v0.13.0-806")));
+    drain();
+    client.rpc_calls.clear();
+    CHECK_FALSE(model().watching());
+    const IfsFirmwareView v =
+        ifs_firmware_view(model().status(), model().klippy_ready(), model().seconds_waiting());
+    CHECK(v.kind == IfsFirmwareViewKind::Done);
+    CHECK(v.body == "IFS on Klipper firmware: v0.13.0-806 answers. Plugins that need it run again.");
+
+    // OK: back to the choice
+    model().dismiss_result();
+    CHECK_FALSE(model().busy());
+    CHECK(ifs_firmware_view(model().status(), true, 0).kind == IfsFirmwareViewKind::Choose);
+}
+
+TEST_CASE_METHOD(IfsFirmwareFixture, "a refusal shows Kiln's reason and stops following",
+                 "[ad5x_ifs_firmware]") {
+    fetched(kiln_object("stock"));
+    requested("klipper");
+    client.rpc_calls[0].error_cb(MoonrakerError::from_json_rpc(
+        json{{"code", 409},
+             {"message", "[ifs_switching] The IFS firmware is being switched, try again in a few "
+                         "minutes"},
+             {"data", {{"reason", "ifs_switching"}}}},
+        kSwitchMethod));
+    drain();
+    CHECK_FALSE(model().watching());
+    CHECK_FALSE(hardware_change_expected());
+    const IfsFirmwareStatus s = model().status();
+    CHECK(s.state == "refused");
+    CHECK(s.message == "The IFS firmware is being switched, try again in a few minutes");
+    const IfsFirmwareView v = ifs_firmware_view(s, true, 0);
+    CHECK(v.kind == IfsFirmwareViewKind::Failed);
+    CHECK(v.title == "IFS firmware switch refused");
+    model().dismiss_result();
+    CHECK(model().status().state == "idle");
+}
+
+TEST_CASE_METHOD(IfsFirmwareFixture, "Klipper's error after the switch ends the hold-off at once",
+                 "[ad5x_ifs_firmware]") {
+    fetched(kiln_object("klipper"));
+    requested("stock");
+    client.rpc_calls[0].success_cb(
+        rpc_result(kiln_object("unknown", "running", true, "stock", "stopping")));
+    drain();
+    client.rpc_calls.clear();
+    model().on_klippy_state(static_cast<int>(helix::KlippyState::STARTUP));
+    model().poll_tick();
+    REQUIRE(client.rpc_calls.size() == 1);
+    client.rpc_calls[0].success_cb(rpc_result(kiln_object(
+        "unknown", "failed", true, "stock", nullptr, "flashing failed (exit 1)", nullptr)));
+    drain();
+    client.rpc_calls.clear();
+    CHECK(model().watching());
+    CHECK(EmergencyStopOverlay::instance().is_recovery_suppressed());
+    model().on_klippy_state(static_cast<int>(helix::KlippyState::ERROR));
+    CHECK_FALSE(model().watching());
+    CHECK_FALSE(EmergencyStopOverlay::instance().is_recovery_suppressed());
+}
+
+TEST_CASE_METHOD(IfsFirmwareFixture, "a switch started elsewhere is followed and held off",
+                 "[ad5x_ifs_firmware]") {
+    fetched(kiln_object("unknown", "running", true, "stock", "writing"));
+    CHECK(model().watching());
+    CHECK_FALSE(model().busy());
