+TEST_CASE_METHOD(IfsFirmwareFixture, "the Devices row shows only where Kiln offers the switch",
+                 "[ad5x_ifs_firmware]") {
+    CHECK(subject_int("ad5x_ifs_firmware_available") == 0);
+    CHECK(subject_text("ad5x_ifs_firmware_text").empty());
+    fetched(kiln_object("stock", "idle", false));
+    CHECK(subject_int("ad5x_ifs_firmware_available") == 0);
+    CHECK_FALSE(available());
+    fetched(kiln_object("stock"));
+    CHECK(subject_int("ad5x_ifs_firmware_available") == 1);
+    CHECK(subject_text("ad5x_ifs_firmware_text") == "Stock");
+    CHECK(available());
+    fetched(kiln_object("klipper"));
