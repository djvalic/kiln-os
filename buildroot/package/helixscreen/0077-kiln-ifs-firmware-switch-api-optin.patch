+// ============================================================================
+// THE MODEL (Kiln's object, the request, the hold-off)
+// ============================================================================
+
+namespace {
+
+struct IfsFirmwareFixture : LVGLUITestFixture {
+    FakeMoonrakerClient client;
+    int notified = 0;
+
+    IfsFirmwareFixture() {
+        set_built_in_for_test(true);
+        model().init_subjects();
+        model().set_client_for_test(&client);
+        model().reset_for_test();
+        model().set_listener([this] { ++notified; });
+    }
+
+    ~IfsFirmwareFixture() override {
+        model().reset_for_test();
+        model().set_client_for_test(nullptr);
+        set_built_in_for_test(std::nullopt);
+        drain();
+    }
+
+    static void drain() {
+        helix::ui::UpdateQueue::instance().drain();
+    }
+
+    static int subject_int(const char* name) {
+        lv_subject_t* s = lv_xml_get_subject(nullptr, name);
+        REQUIRE(s != nullptr);
+        return lv_subject_get_int(s);
+    }
+
+    static std::string subject_text(const char* name) {
+        lv_subject_t* s = lv_xml_get_subject(nullptr, name);
+        REQUIRE(s != nullptr);
+        return lv_subject_get_string(s);
+    }
+
+    /// Fetch and answer with @p result
+    void fetched(const json& result) {
+        client.rpc_calls.clear();
+        model().fetch();
+        REQUIRE(client.rpc_calls.size() == 1);
+        CHECK(client.rpc_calls[0].method == kGetMethod);
+        client.rpc_calls[0].success_cb(rpc_result(result));
+        drain();
+        client.rpc_calls.clear();
+    }
+
+    /// Request @p target; the POST is the last call, not answered yet
+    void requested(const std::string& target) {
+        client.rpc_calls.clear();
+        model().request_switch(target);
+        REQUIRE(client.rpc_calls.size() == 1);
+        CHECK(client.rpc_calls[0].method == kSwitchMethod);
+        CHECK(client.rpc_calls[0].params == json{{"target", target}});
+    }
+};
+
+} // namespace
+
+TEST_CASE("Kiln's object is read field by field", "[ad5x_ifs_firmware]") {
+    const auto s = parse_state(kiln_object("stock", "done", true, "stock", nullptr, nullptr, "3.0.7"));
+    REQUIRE(s.has_value());
+    CHECK(s->available);
+    CHECK(s->firmware == "stock");
+    CHECK(s->state == "done");
+    CHECK(s->target == "stock");
+    CHECK(s->phase.empty());
+    CHECK(s->version == "3.0.7");
+    CHECK_FALSE(parse_state(json::object()).has_value());
+    CHECK_FALSE(parse_state(json::array()).has_value());
+    CHECK_FALSE(parse_state(json{{"available", true}}).has_value());
+    const auto off = parse_state(json{{"available", "yes"}, {"state", "idle"}});
+    REQUIRE(off.has_value());
+    CHECK_FALSE(off->available);
+}
