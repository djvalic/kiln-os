+        rpc_result(kiln_object("stock", "done", true, "stock", nullptr, nullptr, "3.0.7")));
+    drain();
+    // Not this screen's switch: no result to dismiss, back to the choice
+    CHECK_FALSE(model().watching());
+    CHECK(ifs_firmware_view(model().status(), true, 0).kind == IfsFirmwareViewKind::Choose);
+}
