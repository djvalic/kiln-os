   # Kiln's tour (patch 0058, tour_steps_kiln.cpp)
   'Welcome to Kiln OS': 'Welcome to Kiln OS'
   'Here''s a quick tour of the screen, so you can find things fast.': 'Here''s a quick tour of the screen, so you can find things fast.'
diff --git a/translations/ru.yml b/translations/ru.yml
index be23251..861545a 100644
--- a/translations/ru.yml
+++ b/translations/ru.yml
@@ -5170,6 +5170,7 @@ translations:
