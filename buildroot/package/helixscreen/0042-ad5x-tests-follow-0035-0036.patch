+    REQUIRE(ifs != nullptr);
+    lv_subject_t* count = AmsState::instance().get_slot_count_subject();
+    lv_subject_set_int(count, 0);
+    settle();
+    CHECK(lv_obj_has_flag(ifs, LV_OBJ_FLAG_HIDDEN));
+    lv_subject_set_int(count, 4);
