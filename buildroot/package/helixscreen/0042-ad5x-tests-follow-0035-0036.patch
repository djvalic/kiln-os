+                 "[print_status][ad5x]") {
+    CHECK(lv_obj_find_by_name(root_, "ps_printer_area") == nullptr);
+    CHECK(lv_obj_find_by_name(root_, "ps_printer_image") == nullptr);
+    REQUIRE(lv_obj_find_by_name(root_, "kiln_ps_stats") != nullptr);
+    for (const char* name :
+         {"kiln_ps_stat_nozzle", "kiln_ps_stat_bed", "kiln_ps_stat_fan", "kiln_ps_stat_speed"}) {
+        INFO(name);
+        CHECK(lv_obj_find_by_name(root_, name) != nullptr);
+    }
+}
