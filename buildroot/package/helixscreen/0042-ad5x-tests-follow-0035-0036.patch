+// ============================================================================
+// AD5X (patch 0036): stat tiles and the IFS in the printer tile
+// ============================================================================
+
+namespace {
+
+/// The panel at 800x480 with the IFS slot subjects registered before the
+/// tree, so the IFS part's bindings resolve as in the app.
+struct Ad5xTile800 : PrintStatusPanelFixture {
+    Ad5xTile800()
+        : PrintStatusPanelFixture([]() -> std::shared_ptr<void> {
+              helix::led::LedController::instance().init(nullptr, nullptr);
+              ToolState::instance().init_subjects(false);
+              helix::PrinterImageManager::instance().init_subjects();
+              AmsState::instance().init_subjects(true);
+              return std::make_shared<helix::test::ScopedGeometry>(800, 480);
+          }) {
+        lv_obj_remove_flag(root_, LV_OBJ_FLAG_HIDDEN);
+        settle();
+    }
+
+    void settle() {
+        UpdateQueue::instance().drain();
+        lv_obj_update_layout(root_);
+        UpdateQueue::instance().drain();
+        lv_obj_update_layout(root_);
+        PrintStatusPanelTestAccess::tiles(panel()).update_now();
+        UpdateQueue::instance().drain();
+    }
+};
+
+/// Whether a label under @p obj shows exactly @p text.
+bool shows_text(lv_obj_t* obj, const std::string& text) {
+    if (lv_obj_check_type(obj, &lv_label_class)) {
+        const char* t = lv_label_get_text(obj);
+        if (t && text == t) {
+            return true;
+        }
+    }
+    for (uint32_t i = 0; i < lv_obj_get_child_count(obj); ++i) {
+        if (shows_text(lv_obj_get_child(obj, static_cast<int32_t>(i)), text)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+} // namespace
