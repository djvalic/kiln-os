+    lv_obj_t* bed = lv_obj_find_by_name(root_, "kiln_ps_stat_bed");
+    REQUIRE(bed != nullptr);
+    const std::string text = subject_str("ps_chip_bed_text");
+    REQUIRE_FALSE(text.empty());
+    CHECK(shows_text(bed, text));
+}
