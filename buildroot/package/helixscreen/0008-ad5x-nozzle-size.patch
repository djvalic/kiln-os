+
+    helix::ui::WidgetRef root_;
+    helix::ui::WidgetRef dropdown_;
+    std::vector<double> sizes_;
+    bool picked_ = false; ///< The user changed the dropdown
+    bool applying_ = false;
+    double target_ = 0.0;
+    uint32_t waited_ms_ = 0;
+    uint32_t apply_seq_ = 0; ///< Bumped when an apply ends; drops a late answer
