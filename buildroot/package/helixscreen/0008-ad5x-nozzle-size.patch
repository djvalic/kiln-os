diff --git a/ui_xml/wizard_ad5x_nozzle.xml b/ui_xml/wizard_ad5x_nozzle.xml
new file mode 100644
index 0000000000..21fb8ca9a4
--- /dev/null
+++ b/ui_xml/wizard_ad5x_nozzle.xml
@@ -0,0 +1,69 @@
+<?xml version="1.0"?>
+<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
+<component>
+  <!-- First-Run Wizard: AD5X nozzle size step, after the time zone and before
+       the tuning steps. The sizes and the selection come from
+       ui_wizard_ad5x_setup.cpp (the ad5x_nozzle Klipper object). Next with
+       another size sends SET_NOZZLE_SIZE and waits for Klipper to come back.
+       ad5x_nozzle_step_view: 0 ready, 1 waiting for Klipper, 2 applying, 3 failed -->
+  <consts>
+    <str name="step_title" value="Nozzle Size" value_tag="Nozzle Size"/>
+    <str name="step_subtitle" value="The nozzle fitted to the printer" value_tag="The nozzle fitted to the printer"/>
+  </consts>
+  <styles>
+    <style name="text_failed" text_color="#danger"/>
+  </styles>
+  <view name="wizard_ad5x_nozzle_root"
+        extends="lv_obj" width="100%" height="content" style_bg_opa="0" style_border_width="0" style_pad_all="0"
+        flex_flow="column" style_flex_main_place="start" style_flex_cross_place="center" scrollable="false">
+    <ui_card width="100%"
+             height="content" style_radius="#border_radius" style_pad_all="#space_lg" style_pad_gap="#space_md"
+             flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start" scrollable="false">
+      <text_body width="100%"
+                 text="The nozzle fitted to the printer. Line widths, purge lengths and the first-layer test use it. Change it later in Settings."
+                 long_mode="wrap"/>
+      <text_body text="Nozzle Size"/>
+      <lv_dropdown name="nozzle_dropdown"
+                   width="100%" height="#header_height" options="" style_border_opa="100%"
+                   style_radius="#border_radius" style_pad_all="#space_lg">
+        <bind_state_if cond="ad5x_nozzle_local or ad5x_nozzle_step_view eq 2" state="disabled"/>
+        <event_cb trigger="value_changed" callback="on_ad5x_nozzle_changed"/>
+      </lv_dropdown>
+      <!-- local.cfg wins over the choice here -->
+      <lv_obj width="100%"
+              height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
+              style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0" scrollable="false">
+        <bind_flag_if_eq subject="ad5x_nozzle_local" flag="hidden" ref_value="0"/>
+        <icon src="alert" size="xs" variant="warning"/>
+        <text_small width="0"
+                    flex_grow="1" text="local.cfg sets the nozzle size; edit it there" long_mode="wrap"
+                    style_text_color="#warning"/>
+      </lv_obj>
+      <!-- Waiting for Klipper, applying (Klipper restarts) or why it failed -->
+      <lv_obj width="100%"
+              height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
+              style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0" scrollable="false">
+        <bind_flag_if_eq subject="ad5x_nozzle_step_view" flag="hidden" ref_value="0"/>
+        <spinner size="sm">
+          <bind_flag_if cond="ad5x_nozzle_step_view ne 1 and ad5x_nozzle_step_view ne 2" flag="hidden"/>
+        </spinner>
+        <text_body width="0" flex_grow="1" bind_text="ad5x_nozzle_step_message" long_mode="wrap">
+          <bind_style_if_eq name="text_failed" subject="ad5x_nozzle_step_view" ref_value="3"/>
+        </text_body>
+      </lv_obj>
+      <lv_obj width="100%"
+              height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center" style_bg_opa="0"
+              style_border_width="0" scrollable="false">
+        <bind_flag_if_not_eq subject="ad5x_nozzle_step_view" flag="hidden" ref_value="3"/>
+        <ui_button name="btn_ad5x_nozzle_retry" width="#wizard_button_width" height="#button_height" text="Retry">
+          <event_cb trigger="clicked" callback="on_ad5x_nozzle_retry"/>
+        </ui_button>
+      </lv_obj>
+      <text_small width="100%"
+                  text="Skip keeps the nozzle size Klipper runs with now." long_mode="wrap"
+                  style_text_color="#text_muted">
+        <bind_flag_if cond="ad5x_nozzle_step_view ne 1 and ad5x_nozzle_step_view ne 3" flag="hidden"/>
+      </text_small>
+    </ui_card>
+  </view>
+</component>
