+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+/**
+ * @file ui_ad5x_nozzle.h
+ * @brief The AD5X nozzle size: the `ad5x_nozzle` Klipper object and SET_NOZZLE_SIZE
+ *
+ * Klipper's object: `size` (the nozzle_diameter it runs with), `saved`
+ * (nozzle.cfg's), `local` (local.cfg sets nozzle_diameter, which wins over
+ * the chosen size) and `sizes` (what SET_NOZZLE_SIZE takes). SET_NOZZLE_SIZE
+ * SIZE=<mm> writes nozzle.cfg and restarts Klipper; it is refused during a
+ * print.
+ *
+ * Used by the setup wizard's Nozzle Size step (ui_wizard_ad5x_setup.cpp) and
+ * the Settings > Nozzle Size row, whose chooser is Ad5xNozzleModal.
+ *
+ * @threading Main thread only; Moonraker callbacks hop over via lifetime tokens
+ */
+
+#include "ui_modal.h"
+#include "ui_observer_guard.h"
+#include "ui_subscription_guard.h"
+
+#include "async_lifetime_guard.h"
+#include "json_fwd.h"
+#include "lvgl/lvgl.h"
+#include "subject_managed_panel.h"
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace helix::ad5x_nozzle {
+
+/// The sizes SET_NOZZLE_SIZE takes, for a Klipper that does not list them.
+const std::vector<double>& default_sizes();
+
+/// The factory nozzle, assumed while nothing says otherwise.
+inline constexpr double kDefaultSize = 0.4;
+
+/// The `ad5x_nozzle` object as the screen uses it.
+struct Status {
+    std::optional<double> size;                  ///< nozzle_diameter Klipper runs with
+    bool local = false;                          ///< local.cfg sets the size
+    std::vector<double> sizes = default_sizes(); ///< Offered sizes, never empty
+};
+
+/// Status from the object; missing fields keep their defaults.
+Status parse_status(const json& obj);
+
+/// Sizes to offer: @p status's list plus its running size when that is not in it.
+std::vector<double> offered_sizes(const Status& status);
+
+/// Same nozzle (the offered sizes differ by 0.05 mm or more).
+bool same_size(double a, double b);
+
+/// "0.4", "0.25", "1.0"
+std::string size_number(double mm);
+
+/// "0.4 mm"
+std::string size_label(double mm);
+
+/// Dropdown options, one size_label() per line.
+std::string dropdown_options(const std::vector<double>& sizes);
+
+/// Position of @p mm in @p sizes, else of kDefaultSize, else 0.
+uint32_t index_of(const std::vector<double>& sizes, double mm);
+
+/// "SET_NOZZLE_SIZE SIZE=0.6"
+std::string gcode_for(double mm);
+
+/// Whether the printer publishes the `ad5x_nozzle` object.
+bool available();
+
+/// The cached object, the shared subjects and the command.
+///
+/// Subjects: `ad5x_nozzle_size_text` ("0.4 mm", empty while unknown) and
+/// `ad5x_nozzle_local` (1 when local.cfg sets the size).
+class Ad5xNozzleModel {
+  public:
+    Ad5xNozzleModel() = default;
+    ~Ad5xNozzleModel();
+    Ad5xNozzleModel(const Ad5xNozzleModel&) = delete;
+    Ad5xNozzleModel& operator=(const Ad5xNozzleModel&) = delete;
+
+    void init_subjects();
+
+    /// Follow the object (status updates, Klipper restarts) from now on, and
+    /// query it. Safe to call again; later calls only query.
+    void start();
+
+    /// Ask Klipper for the whole object.
+    void query();
+
+    const Status& status() const {
+        return status_;
+    }
+    /// The object answered since Klipper last became ready.
+    bool loaded() const {
+        return loaded_;
+    }
+    bool klippy_ready() const {
+        return klippy_ready_;
+    }
+
+    /// Runs on the main thread after status(), loaded() or klippy_ready()
+    /// changed. One listener (the wizard step on screen); nullptr clears it.
+    void set_listener(std::function<void()> listener);
+
+    /// Sends SET_NOZZLE_SIZE for @p mm, which restarts Klipper. @p done runs on
+    /// the main thread with an empty string when Klipper took it (or went away
+    /// restarting), else with Klipper's answer.
+    void apply(double mm, std::function<void(const std::string& error)> done);
+
+  private:
+    void set_status(const Status& status);
+    void notify();
+
+    SubjectManager subjects_;
+    lv_subject_t size_text_{};
+    lv_subject_t local_{};
+    char size_text_buf_[64] = "";
+    bool subjects_initialized_ = false;
+
+    Status status_;
+    bool loaded_ = false;
+    bool klippy_ready_ = true;
+    bool started_ = false;
+    std::function<void()> listener_;
+
+    SubscriptionGuard subscription_;
+    ObserverGuard klippy_observer_;
+    AsyncLifetimeGuard lifetime_;
+};
+
+Ad5xNozzleModel& model();
+
+} // namespace helix::ad5x_nozzle
+
+namespace helix::ui {
+
+/// Settings > Nozzle Size: the sizes in a dropdown; Apply asks first (Klipper
+/// restarts), then sends SET_NOZZLE_SIZE. Apply is off during a print and
+/// hidden when local.cfg sets the size.
+class Ad5xNozzleModal : public Modal {
+  public:
+    const char* get_name() const override {
+        return "AD5X Nozzle Size";
+    }
+    const char* component_name() const override {
+        return "ad5x_nozzle_modal";
+    }
+
+    /// One-shot owned show over the active screen.
+    static bool show_owned();
+
+  protected:
+    void on_show() override;
+    void on_ok() override;
+
+  private:
+    std::vector<double> sizes_;
+};
+
+} // namespace helix::ui
