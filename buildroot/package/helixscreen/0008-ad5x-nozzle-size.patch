+// SETTINGS CHOOSER
+// ============================================================================
+
+namespace helix::ui {
+
+bool Ad5xNozzleModal::show_owned() {
+    return Modal::show_owned(std::make_unique<Ad5xNozzleModal>(), lv_screen_active());
+}
+
+void Ad5xNozzleModal::on_show() {
+    wire_ok_button("btn_primary");
+    wire_cancel_button("btn_secondary");
+
+    auto& nozzle = ad5x_nozzle::model();
+    nozzle.start();
+    const ad5x_nozzle::Status& status = nozzle.status();
+    sizes_ = ad5x_nozzle::offered_sizes(status);
+    if (lv_obj_t* dropdown = find_widget("nozzle_dropdown")) {
+        lv_dropdown_set_options(dropdown, ad5x_nozzle::dropdown_options(sizes_).c_str());
+        lv_dropdown_set_selected(
+            dropdown,
+            ad5x_nozzle::index_of(sizes_, status.size.value_or(ad5x_nozzle::kDefaultSize)));
+    }
+}
+
+void Ad5xNozzleModal::on_ok() {
+    lv_obj_t* dropdown = find_widget("nozzle_dropdown");
+    const uint32_t index = dropdown ? lv_dropdown_get_selected(dropdown) : 0;
+    std::optional<double> chosen;
+    if (index < sizes_.size()) {
+        chosen = sizes_[index];
+    }
+    // Everything this needs is copied out: the instance goes with the dialog.
+    hide(ModalCloseReason::ButtonPress);
+
+    const ad5x_nozzle::Status& status = ad5x_nozzle::model().status();
+    if (!chosen || status.local || (status.size && ad5x_nozzle::same_size(*chosen, *status.size))) {
+        return;
+    }
+    if (lv_subject_get_int(get_printer_state().print_state().get_print_active_subject()) != 0) {
+        NOTIFY_WARNING("{}", lv_tr("The nozzle size can't change during a print"));
+        return;
+    }
+    const double mm = *chosen;
+    const std::string title =
+        fmt::format(lv_tr("Change the nozzle size to {}?"), ad5x_nozzle::size_label(mm));
+    modal_confirm(title.c_str(), lv_tr("Klipper restarts to apply this. Continue?"),
+                  ModalSeverity::Warning, lv_tr("Change"), [mm]() {
+                      ad5x_nozzle::model().apply(mm, [](const std::string& error) {
+                          if (!error.empty()) {
+                              NOTIFY_WARNING("{}", error);
+                          }
+                      });
+                  });
+}
+
+} // namespace helix::ui
