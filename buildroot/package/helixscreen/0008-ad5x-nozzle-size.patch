+// ============================================================================
+// Nozzle size step
+// ============================================================================
+
+namespace {
+
+/// How long Next waits for Klipper to come back with the new size.
+constexpr uint32_t kNozzleApplyTimeoutMs = 60u * 1000u;
+/// While it waits the object is asked again this often: Klipper's restart can
+/// fall between two klippy state notifications.
+constexpr uint32_t kNozzlePollMs = 2000u;
+
+} // namespace
+
+WizardAd5xNozzleStep* get_wizard_ad5x_nozzle_step() {
+    return &helix::ad5x_setup::owner().nozzle_step;
+}
+
+WizardAd5xNozzleStep::~WizardAd5xNozzleStep() {
+    lifetime_.invalidate();
+    timer_.reset();
+    subjects_.deinit_all();
+}
+
+bool WizardAd5xNozzleStep::should_skip(const helix::wizard::StepContext& ctx) const {
+    if (!helix::ad5x_setup::available(ctx) || !ctx.api) {
+        return true;
+    }
+    const auto& objects = ctx.api->hardware().printer_objects();
+    return std::find(objects.begin(), objects.end(), "ad5x_nozzle") == objects.end();
+}
+
+void WizardAd5xNozzleStep::init_subjects() {
+    helix::ad5x_nozzle::model().init_subjects();
+    if (subjects_initialized_) {
+        return;
+    }
+    UI_MANAGED_SUBJECT_INT(view_, 0, "ad5x_nozzle_step_view", subjects_);
+    UI_MANAGED_SUBJECT_STRING(message_, message_buf_, "", "ad5x_nozzle_step_message", subjects_);
+    subjects_initialized_ = true;
+}
+
+static void on_ad5x_nozzle_changed(lv_event_t* /*e*/) {
+    LVGL_SAFE_EVENT_CB_BEGIN("[AD5X nozzle] on_changed");
+    get_wizard_ad5x_nozzle_step()->handle_choice_changed();
+    LVGL_SAFE_EVENT_CB_END();
+}
+
+static void on_ad5x_nozzle_retry(lv_event_t* /*e*/) {
+    LVGL_SAFE_EVENT_CB_BEGIN("[AD5X nozzle] on_retry");
+    get_wizard_ad5x_nozzle_step()->handle_retry();
+    LVGL_SAFE_EVENT_CB_END();
+}
+
+void WizardAd5xNozzleStep::register_callbacks() {
+    lv_xml_register_event_cb(nullptr, "on_ad5x_nozzle_changed", on_ad5x_nozzle_changed);
+    lv_xml_register_event_cb(nullptr, "on_ad5x_nozzle_retry", on_ad5x_nozzle_retry);
+}
+
+lv_obj_t* WizardAd5xNozzleStep::create(lv_obj_t* parent) {
+    root_ = static_cast<lv_obj_t*>(lv_xml_create(parent, component_name(), nullptr));
+    if (!root_) {
+        spdlog::error("[{}] Failed to create screen from XML", log_name());
+        return nullptr;
+    }
+    dropdown_ = helix::ui::find_required(root_, "nozzle_dropdown", log_name());
+    picked_ = false;
+    error_.clear();
+    stop_apply();
+
+    auto& nozzle = helix::ad5x_nozzle::model();
+    const auto token = lifetime_.token();
+    nozzle.set_listener([this, token]() {
+        if (!token.expired()) {
+            on_model_changed();
+        }
+    });
+    fill_dropdown();
+    nozzle.start();
+    refresh();
+    return root_;
+}
+
+void WizardAd5xNozzleStep::cleanup() {
+    // Leaving while Klipper restarts stops only the waiting; the size is sent.
+    stop_apply();
+    helix::ad5x_nozzle::model().set_listener(nullptr);
+    error_.clear();
+    dropdown_.reset();
+    root_ = nullptr;
+    lv_subject_set_int(&wizard_show_skip, 0);
+    lv_subject_set_int(&connection_test_passed, 1);
+}
+
+std::optional<double> WizardAd5xNozzleStep::chosen_size() const {
+    if (!dropdown_) {
+        return std::nullopt;
+    }
+    const uint32_t index = lv_dropdown_get_selected(dropdown_);
+    if (index >= sizes_.size()) {
+        return std::nullopt;
+    }
+    return sizes_[index];
+}
+
+void WizardAd5xNozzleStep::fill_dropdown() {
+    if (!dropdown_) {
+        return;
+    }
+    const helix::ad5x_nozzle::Status& status = helix::ad5x_nozzle::model().status();
+    sizes_ = helix::ad5x_nozzle::offered_sizes(status);
+    lv_dropdown_set_options(dropdown_, helix::ad5x_nozzle::dropdown_options(sizes_).c_str());
+    lv_dropdown_set_selected(dropdown_,
+                             helix::ad5x_nozzle::index_of(
+                                 sizes_, status.size.value_or(helix::ad5x_nozzle::kDefaultSize)));
+}
+
+void WizardAd5xNozzleStep::handle_choice_changed() {
+    picked_ = true;
+    if (!applying_) {
+        // A new choice is a new attempt: Next again
+        error_.clear();
+    }
+    refresh();
+}
+
+void WizardAd5xNozzleStep::handle_retry() {
+    const auto chosen = chosen_size();
+    if (applying_ || !chosen) {
+        return;
+    }
+    error_.clear();
+    start_apply(*chosen);
+}
+
+bool WizardAd5xNozzleStep::hold_on_next() {
+    if (applying_) {
+        return true;
+    }
+    auto& nozzle = helix::ad5x_nozzle::model();
+    // Skip while Klipper is not ready or after a failure keeps the running size
+    if (!error_.empty() || !nozzle.klippy_ready() || !nozzle.loaded()) {
+        return false;
+    }
+    const helix::ad5x_nozzle::Status& status = nozzle.status();
+    const auto chosen = chosen_size();
+    if (status.local || !chosen ||
+        (status.size && helix::ad5x_nozzle::same_size(*chosen, *status.size))) {
+        return false;
+    }
+    start_apply(*chosen);
+    return true;
+}
+
+void WizardAd5xNozzleStep::start_apply(double mm) {
+    applying_ = true;
+    target_ = mm;
+    waited_ms_ = 0;
+    error_.clear();
+    timer_.reset(lv_timer_create(
+        [](lv_timer_t* t) {
+            static_cast<WizardAd5xNozzleStep*>(lv_timer_get_user_data(t))->on_tick();
+        },
+        kNozzlePollMs, this));
+    refresh();
+
+    const uint32_t seq = apply_seq_;
+    const auto token = lifetime_.token();
+    helix::ad5x_nozzle::model().apply(mm, [this, token, seq](const std::string& error) {
+        if (token.expired() || !applying_ || seq != apply_seq_) {
+            return;
+        }
+        if (!error.empty()) {
+            fail(error);
+        }
+        // Taken: Klipper restarts, and on_model_changed() sees it come back
+    });
+}
+
+void WizardAd5xNozzleStep::on_model_changed() {
+    auto& nozzle = helix::ad5x_nozzle::model();
+    if (applying_) {
+        const auto& size = nozzle.status().size;
+        if (nozzle.klippy_ready() && nozzle.loaded() && size &&
+            helix::ad5x_nozzle::same_size(*size, target_)) {
+            finish_apply();
+            return;
+        }
+    } else if (!picked_ && nozzle.loaded()) {
+        // The object answered after the step was built
+        fill_dropdown();
+    }
+    refresh();
+}
+
+void WizardAd5xNozzleStep::on_tick() {
+    if (!applying_) {
+        timer_.reset();
+        return;
+    }
+    waited_ms_ += kNozzlePollMs;
+    if (waited_ms_ >= kNozzleApplyTimeoutMs) {
+        fail(fmt::format(lv_tr("Klipper did not come back with {} within a minute."),
+                         helix::ad5x_nozzle::size_label(target_)));
+        return;
+    }
+    auto& nozzle = helix::ad5x_nozzle::model();
+    if (nozzle.klippy_ready()) {
+        nozzle.query();
+    }
+}
+
+void WizardAd5xNozzleStep::stop_apply() {
+    applying_ = false;
+    ++apply_seq_;
+    timer_.reset();
+}
+
+void WizardAd5xNozzleStep::finish_apply() {
+    spdlog::info("[{}] Klipper is back with a {} nozzle", log_name(),
+                 helix::ad5x_nozzle::size_label(target_));
+    stop_apply();
+    refresh();
+    ui_wizard_advance();
+}
+
+void WizardAd5xNozzleStep::fail(const std::string& message) {
+    spdlog::warn("[{}] Nozzle size {} not applied: {}", log_name(),
+                 helix::ad5x_nozzle::size_label(target_), message);
+    stop_apply();
+    error_ = message;
+    refresh();
+}
+
+void WizardAd5xNozzleStep::refresh() {
+    if (!subjects_initialized_ || !root_) {
+        return;
+    }
+    auto& nozzle = helix::ad5x_nozzle::model();
+    View view = View::Ready;
+    std::string message;
+    if (applying_) {
+        view = View::Applying;
+        message = fmt::format(lv_tr("Applying {}... Klipper restarts."),
+                              helix::ad5x_nozzle::size_label(target_));
+    } else if (!error_.empty()) {
+        view = View::Failed;
+        message = error_;
+    } else if (!nozzle.klippy_ready() || !nozzle.loaded()) {
+        view = View::Waiting;
+        message = lv_tr("Waiting for Klipper...");
+    }
+    lv_subject_copy_string(&message_, message.c_str());
+    lv_subject_set_int(&view_, static_cast<int>(view));
+    // Skip goes on without a size from Klipper; nothing moves on while it restarts
+    lv_subject_set_int(&wizard_show_skip, (view == View::Waiting || view == View::Failed) ? 1 : 0);
+    lv_subject_set_int(&connection_test_passed, view == View::Applying ? 0 : 1);
+}
