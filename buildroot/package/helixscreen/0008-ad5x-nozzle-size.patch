diff --git a/src/ui/ui_ad5x_nozzle.cpp b/src/ui/ui_ad5x_nozzle.cpp
new file mode 100644
index 0000000000..dfa5236bd7
--- /dev/null
+++ b/src/ui/ui_ad5x_nozzle.cpp
@@ -0,0 +1,370 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "ui_ad5x_nozzle.h"
+
+#include "ui_emergency_stop.h"
+#include "ui_error_reporting.h"
+
+#include "app_globals.h"
+#include "i_moonraker_api.h"
+#include "i_moonraker_client.h"
+#include "json_utils.h"
+#include "lvgl/src/others/translation/lv_translation.h"
+#include "macro_executor.h"
+#include "observer_factory.h"
+#include "printer_discovery.h"
+#include "printer_state.h"
+#include "static_panel_registry.h"
+
+#include <spdlog/fmt/fmt.h>
+#include <spdlog/spdlog.h>
+
+#include <algorithm>
+#include <cmath>
+#include <memory>
+
+namespace helix::ad5x_nozzle {
+
+namespace {
+
+constexpr const char* kObject = "ad5x_nozzle";
+
+/// The offered sizes differ by 0.05 mm or more; closer is the same nozzle.
+constexpr double kSameSizeTolerance = 0.001;
+
+/// Applies the fields @p obj carries (a full object or a status delta).
+void apply_fields(Status& status, const json& obj) {
+    if (const json* size = json_util::find_member(obj, "size")) {
+        if (size->is_number()) {
+            status.size = size->get<double>();
+        } else {
+            status.size.reset();
+        }
+    }
+    if (const json* local = json_util::find_member(obj, "local")) {
+        status.local = json_util::as_bool(*local);
+    }
+    if (const json* list = json_util::find_member(obj, "sizes"); list && list->is_array()) {
+        std::vector<double> sizes;
+        for (const auto& item : *list) {
+            if (item.is_number() && item.get<double>() > 0.0) {
+                sizes.push_back(item.get<double>());
+            }
+        }
+        status.sizes = sizes.empty() ? default_sizes() : sizes;
+    }
+}
+
+} // namespace
+
+// ============================================================================
+// STATUS OBJECT
+// ============================================================================
+
+const std::vector<double>& default_sizes() {
+    static const std::vector<double> sizes = {0.2, 0.25, 0.4, 0.6, 0.8, 1.0};
+    return sizes;
+}
+
+Status parse_status(const json& obj) {
+    Status status;
+    apply_fields(status, obj);
+    return status;
+}
+
+std::vector<double> offered_sizes(const Status& status) {
+    std::vector<double> sizes = status.sizes.empty() ? default_sizes() : status.sizes;
+    // local.cfg can set a size the list does not have; show it rather than a wrong one
+    if (status.size && std::none_of(sizes.begin(), sizes.end(),
+                                    [&](double mm) { return same_size(mm, *status.size); })) {
+        sizes.push_back(*status.size);
+        std::sort(sizes.begin(), sizes.end());
+    }
+    return sizes;
+}
+
+bool same_size(double a, double b) {
+    return std::fabs(a - b) < kSameSizeTolerance;
+}
+
+std::string size_number(double mm) {
+    // One decimal where that is exact (0.4, 1.0), else two (0.25)
+    const bool tenths = std::fabs(mm * 10.0 - std::round(mm * 10.0)) < kSameSizeTolerance;
+    return tenths ? fmt::format("{:.1f}", mm) : fmt::format("{:.2f}", mm);
+}
+
+std::string size_label(double mm) {
+    return size_number(mm) + " mm";
+}
+
+std::string dropdown_options(const std::vector<double>& sizes) {
+    std::string options;
+    for (double mm : sizes) {
+        if (!options.empty()) {
+            options += '\n';
+        }
+        options += size_label(mm);
+    }
+    return options;
+}
+
+uint32_t index_of(const std::vector<double>& sizes, double mm) {
+    for (double want : {mm, kDefaultSize}) {
+        for (size_t i = 0; i < sizes.size(); ++i) {
+            if (same_size(sizes[i], want)) {
+                return static_cast<uint32_t>(i);
+            }
+        }
+    }
+    return 0;
+}
+
+std::string gcode_for(double mm) {
+    return fmt::format("SET_NOZZLE_SIZE SIZE={}", size_number(mm));
+}
+
+bool available() {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api) {
+        return false;
+    }
+    const auto& objects = api->hardware().printer_objects();
+    return std::find(objects.begin(), objects.end(), kObject) != objects.end();
+}
+
+// ============================================================================
+// MODEL
+// ============================================================================
+
+Ad5xNozzleModel::~Ad5xNozzleModel() {
+    lifetime_.invalidate();
+    subscription_.reset();
+    klippy_observer_.reset();
+    subjects_.deinit_all();
+}
+
+void Ad5xNozzleModel::init_subjects() {
+    if (subjects_initialized_) {
+        return;
+    }
+    // "0.4 mm" for the Settings row, empty while the object has not answered
+    UI_MANAGED_SUBJECT_STRING(size_text_, size_text_buf_, "", "ad5x_nozzle_size_text", subjects_);
+    // 1: local.cfg sets nozzle_diameter, so choosing here changes nothing
+    UI_MANAGED_SUBJECT_INT(local_, 0, "ad5x_nozzle_local", subjects_);
+    subjects_initialized_ = true;
+}
+
+void Ad5xNozzleModel::start() {
+    if (!started_) {
+        IMoonrakerAPI* api = get_moonraker_api();
+        if (api) {
+            started_ = true;
+            const auto token = lifetime_.token();
+            // Runs on the WebSocket thread: copy the object out, apply it on the main thread.
+            const SubscriptionId id = api->subscribe_notifications([this, token](const json& note) {
+                const json* params = json_util::find_member(note, "params");
+                if (!params || !params->is_array() || params->empty()) {
+                    return;
+                }
+                const json* obj = json_util::find_member((*params)[0], kObject);
+                if (!obj || !obj->is_object()) {
+                    return;
+                }
+                json delta = *obj;
+                token.defer("Ad5xNozzleModel::status_update", [this, delta]() {
+                    // Deltas only patch a full object; the query in flight brings one
+                    if (!loaded_) {
+                        return;
+                    }
+                    Status status = status_;
+                    apply_fields(status, delta);
+                    set_status(status);
+                });
+            });
+            subscription_ = SubscriptionGuard(api, id);
+
+            // SET_NOZZLE_SIZE restarts Klipper: the object comes back with the new size.
+            klippy_observer_ = ui::observe<int>(
+                get_printer_state().network_state().get_klippy_state_subject(), this,
+                [](Ad5xNozzleModel* self, int state) {
+                    const bool ready = static_cast<KlippyState>(state) == KlippyState::READY;
+                    if (ready == self->klippy_ready_) {
+                        return;
+                    }
+                    self->klippy_ready_ = ready;
+                    if (ready) {
+                        self->query();
+                    } else {
+                        self->loaded_ = false;
+                    }
+                    self->notify();
+                },
+                get_printer_state().get_subjects_lifetime());
+        }
+    }
+    query();
+}
+
+void Ad5xNozzleModel::query() {
+    IMoonrakerClient* client = get_moonraker_client();
+    if (!client || client->get_connection_state() != ConnectionState::CONNECTED) {
+        return;
+    }
+    const auto token = lifetime_.token();
+    json params = {{"objects", {{kObject, nullptr}}}};
+    client->send_jsonrpc(
+        "printer.objects.query", params,
+        [this, token](const json& response) {
+            const json* result = json_util::find_member(response, "result");
+            const json* status = result ? json_util::find_member(*result, "status") : nullptr;
+            const json* obj = status ? json_util::find_member(*status, kObject) : nullptr;
+            if (!obj || !obj->is_object()) {
+                return;
+            }
+            json full = *obj;
+            token.defer("Ad5xNozzleModel::status_query",
+                        [this, full]() { set_status(parse_status(full)); });
+        },
+        [](const MoonrakerError& err) {
+            spdlog::debug("[AD5X nozzle] {} query failed: {}", kObject, err.message);
+        },
+        0, /*silent=*/true);
+}
+
+void Ad5xNozzleModel::set_status(const Status& status) {
+    status_ = status;
+    loaded_ = true;
+    if (subjects_initialized_) {
+        std::string text;
+        if (status_.size) {
+            text = size_label(*status_.size);
+            if (status_.local) {
+                text = fmt::format(lv_tr("{}, set in local.cfg"), text);
+            }
+        }
+        lv_subject_copy_string(&size_text_, text.c_str());
+        lv_subject_set_int(&local_, status_.local ? 1 : 0);
+    }
+    notify();
+}
+
+void Ad5xNozzleModel::set_listener(std::function<void()> listener) {
+    listener_ = std::move(listener);
+}
+
+void Ad5xNozzleModel::notify() {
+    // A copy: the listener may replace itself
+    if (auto listener = listener_) {
+        listener();
+    }
+}
+
+void Ad5xNozzleModel::apply(double mm, std::function<void(const std::string& error)> done) {
+    auto finish = std::make_shared<std::function<void(const std::string&)>>(std::move(done));
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api) {
+        if (*finish) {
+            (*finish)(lv_tr("Not connected to the printer"));
+        }
+        return;
+    }
+    const std::string gcode = gcode_for(mm);
+    spdlog::info("[AD5X nozzle] {}", gcode);
+    // Armed before sending: Klipper can drop the connection before it answers,
+    // and a restart nobody announced shows the disconnect and recovery dialogs.
+    helix::ui::begin_expected_klippy_restart("Changing the nozzle size... Klipper will restart.");
+
+    const auto token = lifetime_.token();
+    api->execute_gcode(
+        gcode,
+        [this, token, finish]() {
+            token.defer("Ad5xNozzleModel::apply_done", [this, finish]() {
+                query();
+                if (*finish) {
+                    (*finish)(std::string());
+                }
+            });
+        },
+        [token, finish](const MoonrakerError& err) {
+            // Klipper restarting drops the reply: that is the command working
+            const bool restarting = classify_macro_rpc_failure(MacroHostEffect::Restarts, err) ==
+                                    MacroFailureReport::ExpectedRestart;
+            const std::string message = err.message;
+            token.defer("Ad5xNozzleModel::apply_error", [finish, restarting, message]() {
+                if (!*finish) {
+                    return;
+                }
+                if (restarting) {
+                    (*finish)(std::string());
+                } else {
+                    (*finish)(message.empty() ? std::string(lv_tr("Failed")) : message);
+                }
+            });
+        },
+        0, /*silent=*/false, /*on_queued=*/nullptr, /*caller_surfaces_errors=*/true);
+}
+
+Ad5xNozzleModel& model() {
+    return helix::lazy_global<Ad5xNozzleModel>("Ad5xNozzleModel");
+}
+
+} // namespace helix::ad5x_nozzle
+
