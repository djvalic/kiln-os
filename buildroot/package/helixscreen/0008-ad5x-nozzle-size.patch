+<?xml version="1.0"?>
+<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
+<component>
+  <!-- Settings > Nozzle Size on the AD5X: choose the nozzle fitted to the
+       printer. The sizes and the selection come from Ad5xNozzleModal
+       (ui_ad5x_nozzle.cpp); Apply asks first, since Klipper restarts. No
+       change during a print; none at all while local.cfg sets the size.
+       Backdrop created by the Modal system. -->
+  <view name="ad5x_nozzle_modal"
+        extends="ui_dialog" width="70%" height="content" style_min_width="320" style_max_width="480"
+        style_max_height="85%" align="center" flex_flow="column" style_flex_main_place="start" style_pad_gap="0"
+        scrollable="false">
+    <lv_obj width="100%"
+            height="content" style_max_height="#dialog_content_max" style_pad_left="#space_lg"
+            style_pad_right="#space_lg" style_pad_top="#space_lg" style_pad_bottom="#space_lg" flex_flow="column"
+            style_flex_cross_place="center" style_pad_gap="#space_md" scrollable="true" scroll_snap_y="none">
+      <lv_obj width="100%"
+              height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center"
+              style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
+        <icon src="ruler" size="md" variant="primary"/>
+        <text_heading text="Nozzle Size"/>
+      </lv_obj>
+      <text_small width="100%"
+                  long_mode="wrap"
+                  text="The nozzle fitted to the printer. Line widths, purge lengths and the first-layer test use it."
+                  style_text_color="#text_muted" style_text_align="center"/>
+      <lv_obj width="100%"
+              height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
+              style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
+        <text_body text="Nozzle" flex_grow="1"/>
+        <lv_dropdown name="nozzle_dropdown" width="55%" style_radius="#border_radius">
+          <bind_state_if cond="print_active or ad5x_nozzle_local" state="disabled"/>
+        </lv_dropdown>
+      </lv_obj>
+      <lv_obj width="100%"
+              height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
+              style_pad_gap="#space_sm" scrollable="false">
+        <bind_flag_if_eq subject="ad5x_nozzle_local" flag="hidden" ref_value="0"/>
+        <icon src="alert" size="xs" variant="warning"/>
+        <text_small width="0"
+                    flex_grow="1" text="local.cfg sets the nozzle size; edit it there" long_mode="wrap"
+                    style_text_color="#warning"/>
+      </lv_obj>
+      <lv_obj width="100%"
+              height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
+              style_pad_gap="#space_sm" scrollable="false">
+        <bind_flag_if_eq subject="print_active" flag="hidden" ref_value="0"/>
+        <icon src="lock" size="xs" variant="secondary"/>
+        <text_small width="0" flex_grow="1" text="The nozzle size can't change during a print" long_mode="wrap"/>
+      </lv_obj>
+    </lv_obj>
+    <modal_button_row primary_text="Apply" secondary_text="Cancel" primary_disable_subject="print_active"
+                      primary_hide_subject="ad5x_nozzle_local"/>
+  </view>
+</component>
