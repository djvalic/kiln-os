+++ b/tests/unit/test_settings_kiln_memory.cpp
@@ -0,0 +1,457 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Kiln OS: Settings > System > Extended memory. Moonraker's kiln_os component
+// answers machine.kiln_os.get_memory and machine.kiln_os.post_memory with
+// {available, enabled, active, restart_needed, failed, notice_pending,
+// bootloader_update_needed, hw_mem_mib, mem_kb};
+// machine.kiln_os.memory_notice_seen marks the one-time notice seen. A refusal is an error with "[reason] text" as the message.
+
+#include "ui_notification_history.h"
+#include "ui_panel_notification_history.h"
+#include "ui_settings_kiln_memory.h"
+#include "ui_update_queue.h"
+
+#include "../fake_moonraker_client.h"
+#include "../lvgl_ui_test_fixture.h"
+#include "config.h"
+#include "helix-xml/src/xml/lv_xml.h"
+#include "moonraker_error.h"
+
+#include <cstring>
+#include <string>
+
+#include "../catch_amalgamated.hpp"
+
+using helix::test::FakeMoonrakerClient;
+using nlohmann::json;
+namespace memory = helix::kiln_memory;
+
+namespace {
+
+/// Kiln's memory object
+json memory_object(bool enabled, const char* active, bool restart_needed,
+                   json failed = nullptr, bool notice_pending = false, bool available = true) {
+    return json{{"available", available},
+                {"enabled", enabled},
+                {"active", active},
+                {"restart_needed", restart_needed},
+                {"failed", failed},
+                {"notice_pending", notice_pending},
+                {"hw_mem_mib", available ? 512 : 256},
+                {"mem_kb", 245000}};
+}
+
+/// The same from an older Kiln boot loader that can't choose the mode: Kiln
+/// says a boot loader update is needed, no restart and no notice
+json old_bootloader(json object) {
+    object["bootloader_update_needed"] = true;
+    object["restart_needed"] = false;
+    object["notice_pending"] = false;
+    return object;
+}
+
+json rpc_result(const json& result) {
+    return json{{"jsonrpc", "2.0"}, {"result", result}};
+}
+
+int subject(const char* name) {
+    lv_subject_t* s = lv_xml_get_subject(nullptr, name);
+    REQUIRE(s != nullptr);
+    return lv_subject_get_int(s);
+}
+
+size_t entries_with_action(const char* action) {
+    size_t n = 0;
+    for (const auto& e : NotificationHistory::instance().get_all()) {
+        if (std::strcmp(e.action, action) == 0) {
+            ++n;
+        }
+    }
+    return n;
+}
+
+struct KilnMemoryFixture : LVGLUITestFixture {
+    FakeMoonrakerClient client;
+    int prompts = 0;
+
+    KilnMemoryFixture() {
+        memory::set_built_in_for_test(true);
+        memory::set_restart_prompt_for_test([this] { ++prompts; });
+        memory::model().init_subjects();
+        memory::model().set_client_for_test(&client);
+        memory::model().reset_for_test();
+        NotificationHistory::instance().clear();
+    }
+
+    ~KilnMemoryFixture() override {
+        memory::model().reset_for_test();
+        memory::model().set_client_for_test(nullptr);
+        memory::set_restart_prompt_for_test(nullptr);
+        memory::set_built_in_for_test(std::nullopt);
+        NotificationHistory::instance().clear();
+        drain();
+    }
+
+    static void drain() {
+        helix::ui::UpdateQueue::instance().drain();
+    }
+
+    /// Fetch and answer with @p result
+    void fetched(const json& result) {
+        client.rpc_calls.clear();
+        memory::model().fetch();
+        REQUIRE(client.rpc_calls.size() == 1);
+        CHECK(client.rpc_calls[0].method == memory::kGetMethod);
+        client.rpc_calls[0].success_cb(rpc_result(result));
+        // The answer is applied on the main thread, through the queue
+        drain();
+        client.rpc_calls.clear();
+    }
+};
+
+} // namespace
+
+TEST_CASE("Kiln memory: Kiln's object is read field by field", "[kiln][kiln_memory]") {
+    const auto s = memory::parse_state(memory_object(true, "extended", false, "no start, 2026-11-17"));
+    REQUIRE(s.has_value());
+    CHECK(s->available);
+    CHECK(s->enabled);
+    CHECK(s->extended_active);
+    CHECK_FALSE(s->restart_needed);
+    CHECK(s->failed == "no start, 2026-11-17");
+    CHECK_FALSE(s->notice_pending);
+    CHECK_FALSE(s->bootloader_update_needed);
+
+    const auto old = memory::parse_state(old_bootloader(memory_object(false, "extended", true)));
+    REQUIRE(old.has_value());
+    CHECK(old->bootloader_update_needed);
+    CHECK_FALSE(old->restart_needed);
+
+    const auto standard = memory::parse_state(memory_object(false, "standard", false, nullptr, true));
+    REQUIRE(standard.has_value());
+    CHECK_FALSE(standard->extended_active);
+    CHECK(standard->failed.empty());
+    CHECK(standard->notice_pending);
+
+    // Not the memory object
+    CHECK_FALSE(memory::parse_state(json::object()).has_value());
+    CHECK_FALSE(memory::parse_state(json::array()).has_value());
+    CHECK_FALSE(memory::parse_state(json{{"state", "rebooting"}}).has_value());
+    // A field that isn't there reads as off
+    const auto bare = memory::parse_state(json{{"available", true}});
+    REQUIRE(bare.has_value());
+    CHECK_FALSE(bare->enabled);
+    CHECK_FALSE(bare->restart_needed);
+    CHECK_FALSE(bare->bootloader_update_needed);
+}
+
+TEST_CASE("Kiln memory: the switch and the pending line", "[kiln][kiln_memory]") {
+    memory::State s;
+    s.available = true;
+    s.enabled = true;
+    s.restart_needed = true;
+    CHECK(memory::shows_enabled(s));
+    CHECK(memory::shows_pending(s));
+
+    // A failed start turned it off: the switch shows off, nothing is pending
+    s.failed = "no start";
+    CHECK_FALSE(memory::shows_enabled(s));
+    CHECK_FALSE(memory::shows_pending(s));
+
+    // A 256 MiB board: nothing
+    memory::State small;
+    small.enabled = true;
+    small.restart_needed = true;
+    CHECK_FALSE(memory::shows_enabled(small));
+    CHECK_FALSE(memory::shows_pending(small));
+}
+
+TEST_CASE("Kiln memory: a boot loader update instead of a restart", "[kiln][kiln_memory]") {
+    memory::State s;
+    s.available = true;
+    s.enabled = true;
+    s.restart_needed = true;
+    CHECK(memory::offers_restart(s));
+    CHECK_FALSE(memory::shows_bootloader_update(s));
+
+    // Even if Kiln said a restart is needed, a restart wouldn't change it
+    s.bootloader_update_needed = true;
+    CHECK(memory::shows_bootloader_update(s));
+    CHECK_FALSE(memory::shows_pending(s));
+    CHECK_FALSE(memory::offers_restart(s));
+    // The switch still shows the choice
+    CHECK(memory::shows_enabled(s));
+
+    // A 256 MiB board: nothing
+    memory::State small;
+    small.bootloader_update_needed = true;
+    CHECK_FALSE(memory::shows_bootloader_update(small));
+}
