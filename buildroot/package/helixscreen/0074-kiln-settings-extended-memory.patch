diff --git a/src/ui/ui_settings_kiln_memory.cpp b/src/ui/ui_settings_kiln_memory.cpp
new file mode 100644
index 00000000..b3f89a55
--- /dev/null
+++ b/src/ui/ui_settings_kiln_memory.cpp
@@ -0,0 +1,329 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "ui_settings_kiln_memory.h"
+
+#include "ui_error_reporting.h"
+#include "ui_modal.h"
+#include "ui_notification.h"
+#include "ui_panel_notification_history.h"
+#include "ui_settings_kiln_recovery.h"
+#include "ui_settings_system.h"
+#include "ui_update_queue.h"
+
+#include "app_globals.h"
+#include "config.h"
+#include "i_moonraker_client.h"
+#include "json_utils.h"
+#include "lvgl/src/others/translation/lv_translation.h"
+#include "moonraker_error.h"
+#include "panel_widgets/shutdown_widget.h"
+#include "static_panel_registry.h"
+
+#include <spdlog/spdlog.h>
+
+namespace helix::kiln_memory {
+
+namespace {
+
+// The touch screen is the AD5X's own (HELIX_KILN_AD5X, set in
+// buildroot/package/helixscreen/helixscreen.mk); other builds have no
+// kiln_os component to ask.
+#if defined(HELIX_KILN_AD5X)
+constexpr bool kBuiltIn = true;
+#else
+constexpr bool kBuiltIn = false;
+#endif
+
+std::optional<bool> g_built_in_override;
+std::function<void()> g_restart_prompt_override;
+
+bool connected(const IMoonrakerClient* client) {
+    return client && client->get_connection_state() == ConnectionState::CONNECTED;
+}
+
+bool flag(const json& object, const char* key) {
+    const json* v = json_util::find_member(object, key);
+    return v && v->is_boolean() && v->get<bool>();
+}
+
+/// The config key that holds the failure last shown, so each one shows once
+std::string failure_shown_key() {
+    return Config::get_instance()->df() + "kiln/extended_memory_failure_shown";
+}
+
+/// Set @p subject, notifying also when the value is unchanged (a switch
+/// the user flipped shows its own state until its subject says otherwise).
+void set_and_notify(lv_subject_t* subject, int value) {
+    if (lv_subject_get_int(subject) == value) {
+        lv_subject_notify(subject);
+    } else {
+        lv_subject_set_int(subject, value);
+    }
+}
+
+} // namespace
+
+bool built_in() {
+    return g_built_in_override.value_or(kBuiltIn);
+}
+
+void set_built_in_for_test(std::optional<bool> value) {
+    g_built_in_override = value;
+}
+
+std::optional<State> parse_state(const json& result) {
+    if (!result.is_object() || !json_util::find_member(result, "available")) {
+        return std::nullopt;
+    }
+    State s;
+    s.available = flag(result, "available");
+    s.enabled = flag(result, "enabled");
+    const json* active = json_util::find_member(result, "active");
+    s.extended_active = active && active->is_string() && active->get<std::string>() == "extended";
+    s.restart_needed = flag(result, "restart_needed");
+    const json* failed = json_util::find_member(result, "failed");
+    if (failed && failed->is_string()) {
+        s.failed = failed->get<std::string>();
+    }
+    s.notice_pending = flag(result, "notice_pending");
+    s.bootloader_update_needed = flag(result, "bootloader_update_needed");
+    return s;
+}
+
+bool shows_enabled(const State& state) {
+    return state.available && state.enabled && state.failed.empty();
+}
+
+bool shows_pending(const State& state) {
+    return state.available && state.restart_needed && !state.bootloader_update_needed &&
+           state.failed.empty();
+}
+
+bool shows_bootloader_update(const State& state) {
+    return state.available && state.bootloader_update_needed;
+}
+
+bool offers_restart(const State& state) {
+    // Kiln says no restart is needed then too; a restart wouldn't change it
+    return state.restart_needed && !state.bootloader_update_needed;
+}
+
+MemoryModel::~MemoryModel() {
+    lifetime_.invalidate();
+    subjects_.deinit_all();
+}
+
+void MemoryModel::init_subjects() {
+    if (subjects_initialized_) {
+        return;
+    }
+    UI_MANAGED_SUBJECT_INT(available_, 0, "kiln_extended_memory_available", subjects_);
+    UI_MANAGED_SUBJECT_INT(enabled_, 0, "kiln_extended_memory_enabled", subjects_);
+    UI_MANAGED_SUBJECT_INT(pending_, 0, "kiln_extended_memory_pending", subjects_);
+    UI_MANAGED_SUBJECT_INT(failed_, 0, "kiln_extended_memory_failed", subjects_);
+    UI_MANAGED_SUBJECT_INT(bootloader_, 0, "kiln_extended_memory_bootloader", subjects_);
+    subjects_initialized_ = true;
+    // An answer that came before Settings > System was first opened
+    publish();
+}
+
+void MemoryModel::publish() {
+    if (!subjects_initialized_) {
+        return;
+    }
+    const State s = state_.value_or(State{});
+    lv_subject_set_int(&available_, s.available ? 1 : 0);
+    if (!busy_) {
+        // While a change is on its way the switch shows it; the answer decides
+        set_and_notify(&enabled_, shows_enabled(s) ? 1 : 0);
+    }
+    lv_subject_set_int(&pending_, shows_pending(s) ? 1 : 0);
+    lv_subject_set_int(&failed_, s.available && !s.failed.empty() ? 1 : 0);
+    lv_subject_set_int(&bootloader_, shows_bootloader_update(s) ? 1 : 0);
+}
+
+IMoonrakerClient* MemoryModel::client() const {
+    IMoonrakerClient* c = client_override_ ? client_override_ : get_moonraker_client();
+    return connected(c) ? c : nullptr;
+}
+
+void MemoryModel::fetch() {
+    IMoonrakerClient* c = built_in() ? client() : nullptr;
+    if (!c) {
+        return;
+    }
+    const auto token = lifetime_.token();
+    c->send_jsonrpc(
+        kGetMethod, json::object(),
+        [this, token](const json& response) {
+            const json* result = json_util::find_member(response, "result");
+            std::optional<State> s = result ? parse_state(*result) : std::nullopt;
+            if (!s) {
+                spdlog::debug("[Kiln memory] Unexpected answer to {}", kGetMethod);
+                return;
+            }
+            token.defer("kiln_memory::state", [this, state = *s]() { apply(state); });
+        },
+        [](const MoonrakerError& err) {
+            // A Kiln OS without extended memory has no such method
+            spdlog::debug("[Kiln memory] {} failed: {}", kGetMethod, err.message);
+        },
+        0, /*silent=*/true);
+}
+
+void MemoryModel::set_enabled(bool on) {
+    if (busy_) {
+        // One change at a time: the switch keeps showing the one on its way
+        if (subjects_initialized_) {
+            lv_subject_notify(&enabled_);
+        }
+        return;
+    }
+    if (!state_ || !state_->available) {
+        // None before Kiln has said the board has 512 MiB
+        publish();
+        return;
+    }
+    IMoonrakerClient* c = client();
+    if (!c) {
+        NOTIFY_WARNING("{}", lv_tr("Not connected to the printer"));
+        publish();
+        return;
+    }
+    spdlog::info("[Kiln memory] Extended memory {}", on ? "on" : "off");
+    busy_ = true;
+    if (subjects_initialized_) {
+        lv_subject_set_int(&enabled_, on ? 1 : 0);
+    }
+    const auto token = lifetime_.token();
+    c->send_jsonrpc(
+        kSetMethod, json{{"enable", on}},
+        [this, token](const json& response) {
+            const json* result = json_util::find_member(response, "result");
+            std::optional<State> s = result ? parse_state(*result) : std::nullopt;
+            token.defer("kiln_memory::set_done", [this, s]() {
+                busy_ = false;
+                if (!s) {
+                    spdlog::warn("[Kiln memory] Unexpected answer to {}", kSetMethod);
+                    NOTIFY_WARNING("{}", lv_tr("Failed"));
+                    publish();
+                    return;
+                }
+                apply(*s);
+                if (offers_restart(*s)) {
+                    if (g_restart_prompt_override) {
+                        g_restart_prompt_override();
+                    } else {
+                        prompt_restart();
+                    }
+                }
+            });
+        },
+        [this, token](const MoonrakerError& err) {
+            spdlog::warn("[Kiln memory] Refused ({}, {}): {}", err.code, err.kiln_reason(),
+                         err.message);
+            const std::string text = helix::kiln_recovery::refusal_text(err.message);
+            token.defer("kiln_memory::set_refused", [this, text]() {
+                busy_ = false;
+                NOTIFY_WARNING("{}", text.empty() ? std::string(lv_tr("Failed")) : text);
+                publish();
+            });
+        },
+        kTimeoutMs, /*silent=*/true);
+}
+
+void MemoryModel::apply(const State& state) {
+    state_ = state;
+    publish();
+    if (!state.available) {
+        return;
+    }
+    // A notice for a mode that can't work before a boot loader update: none
+    if (state.notice_pending && !state.bootloader_update_needed && !notice_posted_) {
+        post_notice();
+    }
+    if (!state.failed.empty()) {
+        show_failure(state.failed);
+    }
+}
+
+void MemoryModel::post_notice() {
+    notice_posted_ = true;
+    helix::ui::set_notification_action_handler(kNoticeAction,
+                                               [](const std::string&) { open_system_settings(); });
+    ui_notification_info_with_action(
+        lv_tr("Extended memory available"),
+        lv_tr("This printer has 512 MiB of memory. Kiln OS uses 256 MiB by default, the same on "
+              "every AD5X. You can switch Extended memory on in Settings > System. It isn't "
+              "needed; it is off by default."),
+        kNoticeAction);
+}
+
+void MemoryModel::show_failure(const std::string& failed) {
+    // Kiln's failure record is one line, the reason and the date: a new
+    // failure is a new text
+    Config* cfg = Config::get_instance();
+    if (cfg && cfg->get<std::string>(failure_shown_key(), "") == failed) {
+        return;
+    }
+    spdlog::warn("[Kiln memory] A start with extended memory failed: {}", failed);
+    NOTIFY_WARNING("{}", lv_tr("Extended memory was turned off: the printer didn't finish "
+                               "starting with it."));
+    if (cfg) {
+        cfg->set<std::string>(failure_shown_key(), failed);
+        cfg->save();
+    }
+}
+
+void MemoryModel::notice_seen() {
+    if (!notice_posted_ || seen_sent_) {
+        return;
+    }
+    IMoonrakerClient* c = client();
+    if (!c) {
+        return;
+    }
+    seen_sent_ = true;
+    spdlog::info("[Kiln memory] Notice seen");
+    const auto token = lifetime_.token();
+    c->send_jsonrpc(
+        kNoticeSeenMethod, json::object(), [](const json&) {},
+        [this, token](const MoonrakerError& err) {
+            spdlog::warn("[Kiln memory] {} failed: {}", kNoticeSeenMethod, err.message);
+            // The next opening of the bell tries again
+            token.defer("kiln_memory::seen_failed", [this]() { seen_sent_ = false; });
+        },
+        0, /*silent=*/true);
+}
+
+void MemoryModel::reset_for_test() {
+    lifetime_.invalidate();
+    state_.reset();
+    busy_ = false;
+    notice_posted_ = false;
+    seen_sent_ = false;
+    publish();
+}
+
+MemoryModel& model() {
+    return helix::lazy_global<MemoryModel>("KilnMemoryModel");
+}
+
+void prompt_restart() {
+    helix::ui::ConfirmOptions options;
+    options.cancel_text = lv_tr("Later");
+    helix::ui::modal_confirm(
+        lv_tr("Restart now?"), lv_tr("Extended memory changes at the next start."),
+        ModalSeverity::Info, lv_tr("Restart"),
+        [] { helix::request_kiln_reboot(get_moonraker_api()); }, options);
+}
+
+void set_restart_prompt_for_test(std::function<void()> prompt) {
+    g_restart_prompt_override = std::move(prompt);
+}
+
+void open_system_settings() {
+    helix::settings::get_system_settings_overlay().show(lv_display_get_screen_active(nullptr));
+}
+
+} // namespace helix::kiln_memory
