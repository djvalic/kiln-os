+void request_kiln_reboot(IMoonrakerAPI* api) {
+    if (!api || !api->is_connected()) {
+        spdlog::warn("[ShutdownDialog] Kiln OS: Moonraker not connected, no reboot");
+        ToastManager::instance().show(ToastSeverity::ERROR, lv_tr("Not connected to the printer"),
+                                      6000);
+        return;
+    }
+    spdlog::info("[ShutdownDialog] Kiln OS: machine reboot through Moonraker");
+    api->machine_reboot(
+        [api]() {
+            spdlog::info("[ShutdownDialog] Kiln OS: machine reboot accepted");
+            schedule_host_down_verification(api, /*is_reboot=*/true);
+        },
+        [](const MoonrakerError& err) {
+            spdlog::warn("[ShutdownDialog] Kiln OS: machine reboot refused ({}, {}): {}", err.code,
+                         err.kiln_reason(), err.message);
+            const std::string message = err.message;
+            helix::ui::queue_update("ShutdownDialog::kiln_reboot_refused", [message]() {
+                ToastManager::instance().show(
+                    ToastSeverity::ERROR,
+                    kiln_power_failure_message(message, /*is_reboot=*/true).c_str(), 8000);
+            });
+        });
+}
+
 bool kiln_power_locked(bool kiln_host_power, bool job_holds_machine) {
     return kiln_host_power && job_holds_machine;
 }
