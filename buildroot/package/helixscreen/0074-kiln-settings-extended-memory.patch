+TEST_CASE_METHOD(KilnMemoryFixture,
+                 "Kiln memory: with an older boot loader the switch posts, no restart is offered",
+                 "[kiln][kiln_memory]") {
+    fetched(old_bootloader(memory_object(false, "extended", false)));
+
+    memory::model().set_enabled(true);
+    REQUIRE(client.rpc_calls.size() == 1);
+    CHECK(client.rpc_calls[0].method == memory::kSetMethod);
+    CHECK(client.rpc_calls[0].params == json{{"enable", true}});
+    client.rpc_calls[0].success_cb(rpc_result(old_bootloader(memory_object(true, "extended", false))));
+    drain();
+    CHECK(subject("kiln_extended_memory_enabled") == 1);
+    CHECK(subject("kiln_extended_memory_bootloader") == 1);
+    CHECK(subject("kiln_extended_memory_pending") == 0);
+    CHECK(prompts == 0);
+
+    // Even an answer that says a restart is needed: not offered
+    memory::model().set_enabled(false);
+    REQUIRE(client.rpc_calls.size() == 2);
+    json answer = old_bootloader(memory_object(false, "extended", false));
+    answer["restart_needed"] = true;
+    client.rpc_calls[1].success_cb(rpc_result(answer));
+    drain();
+    CHECK(subject("kiln_extended_memory_enabled") == 0);
+    CHECK(subject("kiln_extended_memory_pending") == 0);
+    CHECK(prompts == 0);
+}
