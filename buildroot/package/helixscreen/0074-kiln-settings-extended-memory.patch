+    memory::model().notice_seen();
+    REQUIRE(client.rpc_calls.size() == 1);
+    client.rpc_calls[0].error_cb(MoonrakerError::from_json_rpc(
+        {{"code", 503}, {"message", "Database unavailable"}}, memory::kNoticeSeenMethod));
+    drain();
+    memory::model().notice_seen();
+    CHECK(client.rpc_calls.size() == 2);
+}
+
+TEST_CASE_METHOD(KilnMemoryFixture, "Kiln memory: no notice when none is due or seen is unasked",
+                 "[kiln][kiln_memory]") {
+    // Nothing posted: nothing to mark seen
+    memory::model().notice_seen();
+    CHECK(client.rpc_calls.empty());
+
+    fetched(memory_object(true, "extended", false, nullptr, /*notice_pending=*/false));
+    CHECK_FALSE(memory::model().notice_posted());
+    CHECK(entries_with_action(memory::kNoticeAction) == 0);
+
+    // A 256 MiB board never gets one
+    fetched(memory_object(false, "standard", false, nullptr, true, /*available=*/false));
+    CHECK_FALSE(memory::model().notice_posted());
+}
+
+TEST_CASE_METHOD(KilnMemoryFixture, "Kiln memory: a failed start is shown once per failure",
+                 "[kiln][kiln_memory]") {
+    Config* cfg = Config::get_instance();
+    REQUIRE(cfg != nullptr);
+    const std::string key = cfg->df() + "kiln/extended_memory_failure_shown";
+    cfg->set<std::string>(key, "");
+
+    fetched(memory_object(true, "standard", true, "no start, 2026-11-17 10:00"));
+    CHECK(subject("kiln_extended_memory_failed") == 1);
+    CHECK(subject("kiln_extended_memory_enabled") == 0);
+    CHECK(subject("kiln_extended_memory_pending") == 0);
+    CHECK(cfg->get<std::string>(key, "") == "no start, 2026-11-17 10:00");
+    const size_t shown = NotificationHistory::instance().get_all().size();
+
+    // The same failure on the next start: not again
+    fetched(memory_object(true, "standard", true, "no start, 2026-11-17 10:00"));
+    CHECK(NotificationHistory::instance().get_all().size() == shown);
+
+    // A new one is
+    fetched(memory_object(true, "standard", true, "no start, 2026-11-18 09:00"));
+    CHECK(cfg->get<std::string>(key, "") == "no start, 2026-11-18 09:00");
+
+    cfg->set<std::string>(key, "");
+}
+
+TEST_CASE_METHOD(KilnMemoryFixture, "Kiln memory: opening the bell marks the notice seen",
+                 "[kiln][kiln_memory][notification_history]") {
+    fetched(memory_object(false, "standard", false, nullptr, true));
+    REQUIRE(entries_with_action(memory::kNoticeAction) == 1);
+
+    auto panel = std::make_unique<NotificationHistoryPanel>(state(), nullptr);
+    panel->init_subjects();
+    auto* root = static_cast<lv_obj_t*>(
+        lv_xml_create(lv_screen_active(), "notification_history_panel", nullptr));
+    REQUIRE(root != nullptr);
+    panel->setup(root, lv_screen_active());
+
+    REQUIRE(client.rpc_calls.size() == 1);
+    CHECK(client.rpc_calls[0].method == memory::kNoticeSeenMethod);
+
+    lv_obj_delete(root);
+    drain();
+    panel.reset();
+    drain();
+}
