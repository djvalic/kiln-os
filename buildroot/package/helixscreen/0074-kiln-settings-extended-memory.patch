+
+// Kiln OS: Extended memory shows where Kiln says the board has 512 MiB
+// (kiln_extended_memory_available), greys while a job holds the machine
+// (kiln_power_locked), and its switch posts the change.
+TEST_CASE_METHOD(SystemCallbacksFixture,
+                 "System page: Extended memory shows on 512 MiB boards and posts the switch",
+                 "[settings][system_callbacks][kiln]") {
+    namespace memory = helix::kiln_memory;
+    helix::test::FakeMoonrakerClient client;
+    memory::set_built_in_for_test(true);
+    memory::set_restart_prompt_for_test([] {});
+    memory::model().set_client_for_test(&client);
+    memory::model().reset_for_test();
+    process_lvgl(5);
+
+    lv_obj_t* container = lv_obj_find_by_name(root_, "container_kiln_extended_memory");
+    REQUIRE(container != nullptr);
+    lv_obj_t* pending = lv_obj_find_by_name(root_, "kiln_extended_memory_pending");
+    REQUIRE(pending != nullptr);
+    lv_obj_t* failed = lv_obj_find_by_name(root_, "kiln_extended_memory_failed");
+    REQUIRE(failed != nullptr);
+    lv_obj_t* toggle = part("row_kiln_extended_memory", "toggle");
+    lv_obj_t* row = lv_obj_find_by_name(root_, "row_kiln_extended_memory");
+    REQUIRE(row != nullptr);
+    lv_obj_t* row_bootloader = lv_obj_find_by_name(root_, "row_kiln_extended_memory_bootloader");
+    REQUIRE(row_bootloader != nullptr);
+    lv_obj_t* toggle_bootloader = part("row_kiln_extended_memory_bootloader", "toggle");
+
+    // Before Kiln answers (and on every other build): hidden
+    CHECK(lv_obj_has_flag(container, LV_OBJ_FLAG_HIDDEN));
+
+    memory::State s;
+    s.available = true;
+    memory::model().apply(s);
+    process_lvgl(5);
+    CHECK_FALSE(lv_obj_has_flag(container, LV_OBJ_FLAG_HIDDEN));
+    CHECK(lv_obj_has_flag(pending, LV_OBJ_FLAG_HIDDEN));
+    CHECK(lv_obj_has_flag(failed, LV_OBJ_FLAG_HIDDEN));
+    CHECK_FALSE(lv_obj_has_state(toggle, LV_STATE_CHECKED));
+    // The usual subtitle; the boot loader one only where it is needed
+    CHECK_FALSE(lv_obj_has_flag(row, LV_OBJ_FLAG_HIDDEN));
+    CHECK(lv_obj_has_flag(row_bootloader, LV_OBJ_FLAG_HIDDEN));
+
+    // Greyed while a job holds the machine
+    lv_subject_t* locked = lv_xml_get_subject(nullptr, "kiln_power_locked");
+    REQUIRE(locked != nullptr);
+    lv_subject_set_int(locked, 1);
+    process_lvgl(5);
+    CHECK(lv_obj_has_state(toggle, LV_STATE_DISABLED));
+    lv_subject_set_int(locked, 0);
+    process_lvgl(5);
+    CHECK_FALSE(lv_obj_has_state(toggle, LV_STATE_DISABLED));
+
+    // The switch posts the change
+    lv_obj_add_state(toggle, LV_STATE_CHECKED);
+    lv_obj_send_event(toggle, LV_EVENT_VALUE_CHANGED, nullptr);
+    REQUIRE(client.rpc_calls.size() == 1);
+    CHECK(client.rpc_calls[0].method == memory::kSetMethod);
+    CHECK(client.rpc_calls[0].params == nlohmann::json{{"enable", true}});
+
+    // Kiln's answer: on from the next start
+    s.enabled = true;
+    s.restart_needed = true;
+    client.rpc_calls[0].success_cb(nlohmann::json{
+        {"jsonrpc", "2.0"},
+        {"result",
+         {{"available", true},
+          {"enabled", true},
+          {"active", "standard"},
+          {"restart_needed", true},
+          {"failed", nullptr},
+          {"notice_pending", false}}}});
+    helix::ui::UpdateQueue::instance().drain();
+    process_lvgl(5);
+    CHECK(lv_obj_has_state(toggle, LV_STATE_CHECKED));
+    CHECK_FALSE(lv_obj_has_flag(pending, LV_OBJ_FLAG_HIDDEN));
+
+    // A start with it failed: the failure shows instead, the switch is off
+    s.failed = "no start, 2026-11-17";
+    memory::model().apply(s);
+    process_lvgl(5);
+    CHECK_FALSE(lv_obj_has_flag(failed, LV_OBJ_FLAG_HIDDEN));
+    CHECK(lv_obj_has_flag(pending, LV_OBJ_FLAG_HIDDEN));
+    CHECK_FALSE(lv_obj_has_state(toggle, LV_STATE_CHECKED));
+
+    // An older Kiln boot loader: the same switch with "Needs a boot loader
+    // update to take effect.", nothing pending; its switch posts too
+    s.failed.clear();
+    s.restart_needed = false;
+    s.bootloader_update_needed = true;
+    memory::model().apply(s);
+    process_lvgl(5);
+    CHECK(lv_obj_has_flag(row, LV_OBJ_FLAG_HIDDEN));
+    CHECK_FALSE(lv_obj_has_flag(row_bootloader, LV_OBJ_FLAG_HIDDEN));
+    CHECK(lv_obj_has_flag(pending, LV_OBJ_FLAG_HIDDEN));
+    CHECK(lv_obj_has_state(toggle_bootloader, LV_STATE_CHECKED));
+    lv_obj_t* subtitle = lv_obj_find_by_name(row_bootloader, "description");
+    REQUIRE(subtitle != nullptr);
+    CHECK(std::string(lv_label_get_text(subtitle)) == "Needs a boot loader update to take effect.");
+    lv_obj_remove_state(toggle_bootloader, LV_STATE_CHECKED);
+    lv_obj_send_event(toggle_bootloader, LV_EVENT_VALUE_CHANGED, nullptr);
+    REQUIRE(client.rpc_calls.size() == 2);
+    CHECK(client.rpc_calls[1].params == nlohmann::json{{"enable", false}});
+    lv_subject_set_int(locked, 1);
+    process_lvgl(5);
+    CHECK(lv_obj_has_state(toggle_bootloader, LV_STATE_DISABLED));
+    lv_subject_set_int(locked, 0);
+    process_lvgl(5);
+
+    // A 256 MiB board: hidden
+    memory::model().apply(memory::State{});
+    process_lvgl(5);
+    CHECK(lv_obj_has_flag(container, LV_OBJ_FLAG_HIDDEN));
+
+    memory::model().reset_for_test();
+    memory::model().set_client_for_test(nullptr);
+    memory::set_restart_prompt_for_test(nullptr);
+    memory::set_built_in_for_test(std::nullopt);
+    if (Config* cfg = Config::get_instance()) {
+        cfg->set<std::string>(cfg->df() + "kiln/extended_memory_failure_shown", "");
+    }
+    helix::ui::UpdateQueue::instance().drain();
+}
