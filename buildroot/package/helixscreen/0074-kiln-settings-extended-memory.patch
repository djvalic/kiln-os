--- /dev/null
+++ b/include/ui_settings_kiln_memory.h
@@ -0,0 +1,200 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * @file ui_settings_kiln_memory.h
+ * @brief Kiln OS: Settings > System > Extended memory
+ *
+ * An AD5X with 512 MiB of memory runs Kiln OS in 256 MiB by default, as every
+ * AD5X does. Extended memory gives Linux the whole 512 MiB from the next start
+ * on. Moonraker's kiln_os component answers:
+ *
+ * - `GET /machine/kiln_os/memory` (JSON-RPC `machine.kiln_os.get_memory`):
+ *   {available, enabled, active, restart_needed, failed, notice_pending,
+ *   bootloader_update_needed, hw_mem_mib, mem_kb}. available: the board has
+ *   512 MiB; enabled: the switch is on; active: "standard" or "extended", what
+ *   this start got; restart_needed: the switch and this start differ; failed:
+ *   why a start with it did not finish (it is then off until switched on
+ *   again), or null; notice_pending: the one-time "Extended memory available"
+ *   notice is due; bootloader_update_needed: an older Kiln boot loader started
+ *   this and can't choose the mode, so a restart changes nothing (Kiln then
+ *   says restart_needed and notice_pending false).
+ * - `POST /machine/kiln_os/memory` with enable (`machine.kiln_os.post_memory`):
+ *   Kiln's update agent sets the switch, which takes effect at the next start;
+ *   answers the GET object. 409 `not_available` on a 256 MiB board.
+ * - `POST /machine/kiln_os/memory_notice_seen`
+ *   (`machine.kiln_os.memory_notice_seen`): the notice was seen (also when it
+ *   is dismissed in Fluidd or Mainsail); answers the GET object.
+ *
+ * Moonraker names the JSON-RPC methods of an endpoint with both GET and POST
+ * get_<name> and post_<name>.
+ *
+ * The state is fetched in the discovery sequence, so on every connect and
+ * Klipper restart. The row shows only when the board has 512 MiB and is
+ * greyed while a job holds the machine (kiln_power_locked). A change asks
+ * "Restart now?"; Restart goes through Moonraker's machine.reboot (Kiln's
+ * update agent and its refusals), Later leaves the change for the next start
+ * and the row says so. Where a boot loader update is needed the row's
+ * subtitle says that instead, and no restart is offered.
+ *
+ * The notice is a bell entry; tapping it opens Settings > System. Opening the
+ * bell (or clearing it) with the entry in it marks the notice seen. A failure
+ * is a warning once per failure (the failed text, kept in the config).
+ *
+ * HELIX_KILN_AD5X builds only: elsewhere nothing is fetched and the row stays
+ * hidden.
+ *
+ * @threading Main thread; Moonraker's answers hop over through lifetime tokens
+ */
+
+#pragma once
+
+#include "async_lifetime_guard.h"
+#include "json_fwd.h"
+#include "lvgl/lvgl.h"
+#include "subject_managed_panel.h"
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string>
+
+namespace helix {
+class IMoonrakerClient;
+}
+
+namespace helix::kiln_memory {
+
+/// The JSON-RPC method of GET /machine/kiln_os/memory
+inline constexpr const char* kGetMethod = "machine.kiln_os.get_memory";
+
+/// The JSON-RPC method of POST /machine/kiln_os/memory
+inline constexpr const char* kSetMethod = "machine.kiln_os.post_memory";
+
+/// The JSON-RPC method of POST /machine/kiln_os/memory_notice_seen
+inline constexpr const char* kNoticeSeenMethod = "machine.kiln_os.memory_notice_seen";
+
+/// The bell entry's action: opens Settings > System
+inline constexpr const char* kNoticeAction = "kiln_ext_memory";
+
+/// The POST waits for Kiln's update agent (up to 30 s); a little more here
+inline constexpr uint32_t kTimeoutMs = 45000;
+
+/// True on HELIX_KILN_AD5X builds; tests override it.
+bool built_in();
+void set_built_in_for_test(std::optional<bool> value);
+
+/// Kiln's memory object
+struct State {
+    bool available = false;
+    bool enabled = false;
+    bool extended_active = false; ///< active == "extended"
+    bool restart_needed = false;
+    std::string failed;           ///< empty: none
+    bool notice_pending = false;
+    bool bootloader_update_needed = false; ///< a restart changes nothing
+};
+
+/// The memory object (a JSON-RPC result); nullopt when @p result is not one.
+/// A missing field reads as false or empty.
+std::optional<State> parse_state(const nlohmann::json& result);
+
+/// The row's switch: on while the switch is on and no start with it failed
+bool shows_enabled(const State& state);
+
+/// The "changes at the next start" line: a restart is needed, it would help
+/// and nothing failed
+bool shows_pending(const State& state);
+
+/// The "Needs a boot loader update" subtitle (512 MiB boards only)
+bool shows_bootloader_update(const State& state);
+
+/// "Restart now?" after a change Kiln answered with @p state
+bool offers_restart(const State& state);
+
+/// The Extended memory row and its notices.
+///
+/// Subjects: `kiln_extended_memory_available` (1 shows the row),
+/// `kiln_extended_memory_enabled` (the switch), `kiln_extended_memory_pending`
+/// (1 shows "Extended memory changes at the next start."),
+/// `kiln_extended_memory_failed` (1 shows the failure) and
+/// `kiln_extended_memory_bootloader` (1: the row's subtitle says a boot loader
+/// update is needed).
+class MemoryModel {
+  public:
+    MemoryModel() = default;
+    ~MemoryModel();
+    MemoryModel(const MemoryModel&) = delete;
+    MemoryModel& operator=(const MemoryModel&) = delete;
+
+    void init_subjects();
+
+    /// Ask Kiln for the state over the screen's own Moonraker connection
+    /// (nothing off a Kiln build or without a connection).
+    void fetch();
+
+    /// The switch was set to @p on: POST it, then offer the restart. Nothing
+    /// before Kiln has said the board has 512 MiB, or while a change is on
+    /// its way.
+    void set_enabled(bool on);
+
+    /// Kiln's answer: the subjects, and the notice and failure once.
+    void apply(const State& state);
+
+    /// The bell showed (or cleared) the notice: tell Kiln once (again after
+    /// a failed try).
+    void notice_seen();
+
+    const std::optional<State>& state() const {
+        return state_;
+    }
+    bool busy() const {
+        return busy_;
+    }
+    bool notice_posted() const {
+        return notice_posted_;
+    }
+
+    /// Tests: forget the state and what was shown (the subjects stay).
+    void reset_for_test();
+    /// Tests: the client the requests go over; nullptr: the screen's own.
+    void set_client_for_test(IMoonrakerClient* client) {
+        client_override_ = client;
+    }
+
+  private:
+    /// The subjects from state_ (the switch also when unchanged: it may show
+    /// a tap that did not go through).
+    void publish();
+    void post_notice();
+    void show_failure(const std::string& failed);
+    /// The connected client to ask, else nullptr
+    IMoonrakerClient* client() const;
+
+    SubjectManager subjects_;
+    lv_subject_t available_{};
+    lv_subject_t enabled_{};
+    lv_subject_t pending_{};
+    lv_subject_t failed_{};
+    lv_subject_t bootloader_{};
+    bool subjects_initialized_ = false;
+
+    std::optional<State> state_;
+    bool busy_ = false;
+    bool notice_posted_ = false;
+    bool seen_sent_ = false;
+    IMoonrakerClient* client_override_ = nullptr;
+    AsyncLifetimeGuard lifetime_;
+};
+
+MemoryModel& model();
+
+/// Offer the restart after a change ("Restart now?" / Restart / Later).
+void prompt_restart();
+/// Tests: what runs instead of prompt_restart(); empty: prompt_restart().
+void set_restart_prompt_for_test(std::function<void()> prompt);
+
+/// The bell entry's action: open Settings > System. Registered once a notice
+/// is posted.
+void open_system_settings();
+
+} // namespace helix::kiln_memory
