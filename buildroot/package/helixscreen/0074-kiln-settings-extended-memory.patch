+TEST_CASE_METHOD(KilnMemoryFixture, "Kiln memory: the fetch fills the row's subjects",
+                 "[kiln][kiln_memory]") {
+    CHECK(subject("kiln_extended_memory_available") == 0);
+
+    fetched(memory_object(true, "standard", true));
+    CHECK(subject("kiln_extended_memory_available") == 1);
+    CHECK(subject("kiln_extended_memory_enabled") == 1);
+    CHECK(subject("kiln_extended_memory_pending") == 1);
+    CHECK(subject("kiln_extended_memory_failed") == 0);
+
+    fetched(memory_object(true, "extended", false));
+    CHECK(subject("kiln_extended_memory_pending") == 0);
+
+    CHECK(subject("kiln_extended_memory_bootloader") == 0);
+
+    // An older Kiln boot loader: the boot loader subtitle, nothing pending
+    fetched(old_bootloader(memory_object(false, "extended", true)));
+    CHECK(subject("kiln_extended_memory_available") == 1);
+    CHECK(subject("kiln_extended_memory_bootloader") == 1);
+    CHECK(subject("kiln_extended_memory_pending") == 0);
+
+    // A 256 MiB board hides the row
+    fetched(memory_object(false, "standard", false, nullptr, false, /*available=*/false));
+    CHECK(subject("kiln_extended_memory_available") == 0);
+    CHECK(subject("kiln_extended_memory_bootloader") == 0);
+}
