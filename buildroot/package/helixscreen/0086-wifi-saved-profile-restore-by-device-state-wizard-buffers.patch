+WifiBackendNetworkManager::ProfileActivation
+WifiBackendNetworkManager::parse_profile_activation(const std::string& output,
+                                                    const std::string& uuid) {
+    // One block per device, blank line between: GENERAL.CON-UUID:<uuid or empty>
+    // and GENERAL.STATE:<number> (<text>)
+    std::istringstream stream(output + "\n");
+    std::string line;
+    std::string block_uuid;
+    int block_state = -1;
+    while (std::getline(stream, line)) {
+        if (line.empty()) {
+            if (!uuid.empty() && block_uuid == uuid) {
+                if (block_state == 100) {
+                    return ProfileActivation::Activated;
+                }
+                if (block_state >= 40 && block_state < 100) {
+                    return ProfileActivation::Activating;
+                }
+            }
+            block_uuid.clear();
+            block_state = -1;
+            continue;
+        }
+        auto colon = line.find(':');
+        if (colon == std::string::npos) {
+            continue;
+        }
+        const std::string name = line.substr(0, colon);
+        const std::string value = line.substr(colon + 1);
+        if (name == "GENERAL.CON-UUID") {
+            block_uuid = value;
+        } else if (name == "GENERAL.STATE") {
+            block_state = std::atoi(value.c_str());
+        }
+    }
+    return ProfileActivation::Other;
+}
+
+WifiBackendNetworkManager::ProfileActivation
+WifiBackendNetworkManager::profile_activation(const std::string& uuid) {
+    // A fixed command line: every device, matched to the UUID here
+    return parse_profile_activation(
+        exec_nmcli("-t -f GENERAL.CON-UUID,GENERAL.STATE device show"), uuid);
+}
+
+WifiBackendNetworkManager::ProfileActivation
+WifiBackendNetworkManager::settle_activation(const std::string& uuid,
+                                             std::chrono::milliseconds wait) {
+    constexpr auto kPoll = std::chrono::milliseconds(1000);
+    constexpr auto kStep = std::chrono::milliseconds(100);
+    const auto deadline = std::chrono::steady_clock::now() + wait;
+    ProfileActivation state = profile_activation(uuid);
+    while (state == ProfileActivation::Activating && connect_active_ &&
+           std::chrono::steady_clock::now() < deadline) {
+        const auto next = std::chrono::steady_clock::now() + kPoll;
+        while (connect_active_ && std::chrono::steady_clock::now() < next) {
+            std::this_thread::sleep_for(kStep);
+        }
+        state = profile_activation(uuid);
+    }
+    return state;
+}
