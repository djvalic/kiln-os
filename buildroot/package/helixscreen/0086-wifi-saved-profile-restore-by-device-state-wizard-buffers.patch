 void copy_if_changed(lv_subject_t* subject, const std::string& text) {
+    // A text longer than the subject's buffer (a long custom material name)
+    // is cut before a whole character: lv_strlcpy cuts bytes, so half a
+    // Cyrillic letter would end the line
+    std::string fit = text;
+    if (subject->size > 0 && fit.size() >= subject->size) {
+        size_t cut = subject->size - 1;
+        while (cut > 0 && (static_cast<unsigned char>(fit[cut]) & 0xC0) == 0x80) {
+            --cut;
+        }
+        fit.resize(cut);
+    }
