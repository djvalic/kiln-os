+++ b/src/ui/ui_wizard.cpp
@@ -708,7 +708,7 @@ void ui_wizard_navigate_to_step(helix::wizard::StepId step) {
                 }
             }
             if (lbl) {
-                lv_label_set_text(lbl, btn_label_text);
+                lv_label_set_text(lbl, lv_tr(btn_label_text));
             }
         }
     }
diff --git a/tests/unit/test_settings_ad5x_refill.cpp b/tests/unit/test_settings_ad5x_refill.cpp
index 6d65baa414..d1c29f6f39 100644
--- a/tests/unit/test_settings_ad5x_refill.cpp
+++ b/tests/unit/test_settings_ad5x_refill.cpp
@@ -61,16 +61,16 @@ TEST_CASE("backups are listed for the slots with filament", "[ad5x_refill]") {
     CHECK(slots[2].backups == std::vector<int>{1});
     CHECK(any_backup(slots));
 
-    CHECK(backup_line(slots[1]) == "Slot 2 · PLA → no backup");
+    CHECK(backup_line(slots[1]) == "Slot 2 · PLA — no backup");
     const std::string first = backup_line(slots[0]);
     CHECK(first.rfind("Slot 1 · PLA ", 0) == 0);
     CHECK(first.find("black") != std::string::npos);
-    CHECK(first.find("→ Slot 3") != std::string::npos);
+    CHECK(first.find("— Slot 3") != std::string::npos);
 
     SlotBackup several;
     several.slot = 4;
     several.backups = {2, 1};
-    CHECK(backup_line(several) == "Slot 4 · material not set → Slots 2, 1");
+    CHECK(backup_line(several) == "Slot 4 · material not set — Slots 2, 1");
 }
 
 TEST_CASE("without loaded_channels the slots with a backup are listed", "[ad5x_refill]") {
