+TEST_CASE_METHOD(LVGLUITestFixture, "drag: the build-time walk stops drags on buttons only",
+                 "[kiln][drag_scroll]") {
+    lv_obj_t* page = lv_obj_create(test_screen());
+    lv_obj_t* card = lv_obj_create(page); // a setting_group card: clickable lv_obj
+    lv_obj_remove_flag(card, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_t* row = lv_button_create(card); // setting_action_row: an lv_button
+    lv_obj_set_name(row, "row_printer");
+    lv_obj_t* in_row = lv_button_create(row);
+    lv_obj_t* indexed = lv_button_create(card);
+    lv_obj_set_name(indexed, "profile_row_0");
+    lv_obj_t* button = lv_button_create(page);
+    lv_obj_t* label = lv_label_create(page);
+    lv_obj_add_flag(label, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_t* slider = lv_slider_create(page);
+
+    helix::ui::stop_drag_chain_on_buttons(page);
+
+    CHECK(lv_obj_has_flag(page, LV_OBJ_FLAG_SCROLL_CHAIN_VER));
+    CHECK(lv_obj_has_flag(card, LV_OBJ_FLAG_SCROLL_CHAIN_VER));
+    CHECK(lv_obj_has_flag(row, LV_OBJ_FLAG_SCROLL_CHAIN_VER));
+    CHECK(lv_obj_has_flag(in_row, LV_OBJ_FLAG_SCROLL_CHAIN_VER));
+    CHECK(lv_obj_has_flag(indexed, LV_OBJ_FLAG_SCROLL_CHAIN_VER));
+    CHECK(lv_obj_has_flag(label, LV_OBJ_FLAG_SCROLL_CHAIN_VER));
+    CHECK_FALSE(lv_obj_has_flag(button, LV_OBJ_FLAG_SCROLL_CHAIN));
+    // A slider keeps what LVGL gave it: no chain along its own axis
+    CHECK_FALSE(lv_obj_has_flag(slider, LV_OBJ_FLAG_SCROLL_CHAIN_HOR));
+
+    CHECK(helix::ui::is_list_row_name("row"));
+    CHECK(helix::ui::is_list_row_name("row_display"));
+    CHECK(helix::ui::is_list_row_name("history_list_row_#"));
+    CHECK_FALSE(helix::ui::is_list_row_name("arrow_up"));
+    CHECK_FALSE(helix::ui::is_list_row_name("group_printer"));
+    CHECK_FALSE(helix::ui::is_list_row_name(nullptr));
+    lv_obj_delete(page);
+}
