         for (const auto& spec : k_specs) {
@@ -773,3 +778,43 @@ void WizardAd5xSetupStep::cleanup() {
     model().deactivate();
     root_ = nullptr;
 }
+
+// ============================================================================
+// Time zone step
+// ============================================================================
+
+WizardAd5xTimezoneStep* get_wizard_ad5x_timezone_step() {
+    return &helix::ad5x_setup::owner().timezone_step;
+}
+
+bool WizardAd5xTimezoneStep::should_skip(const helix::wizard::StepContext& ctx) const {
+    return !helix::ad5x_setup::available(ctx);
+}
+
+void WizardAd5xTimezoneStep::register_callbacks() {
+    // The dropdown reuses Settings > Language & Time's on_timezone_changed,
+    // which that overlay registers only when first opened.
+    helix::settings::get_language_time_settings_overlay().register_callbacks();
+}
+
+lv_obj_t* WizardAd5xTimezoneStep::create(lv_obj_t* parent) {
+    root_ = static_cast<lv_obj_t*>(lv_xml_create(parent, component_name(), nullptr));
+    if (!root_) {
+        spdlog::error("[{}] Failed to create screen from XML", log_name());
+        return nullptr;
+    }
+    // The zone list is built at runtime: fill it and select the current zone.
+    if (lv_obj_t* dropdown = helix::ui::find_required(root_, "timezone_dropdown", log_name())) {
+        const std::string options = helix::DisplaySettingsManager::get_timezone_options();
+        const int index = helix::DisplaySettingsManager::instance().get_timezone_index();
+        lv_dropdown_set_options(dropdown, options.c_str());
+        lv_dropdown_set_selected(dropdown, static_cast<uint32_t>(index));
+    }
+    // Next, never Skip: keeping the current zone is a valid answer.
+    lv_subject_set_int(&wizard_show_skip, 0);
+    return root_;
+}
+
+void WizardAd5xTimezoneStep::cleanup() {
+    root_ = nullptr;
+}
