  * G-code `SETUP_WIZARD_STEP` as fallback) and shows
  * the `ad5x_setup` Klipper status object (state, message, progress, results,
@@ -58,7 +61,8 @@ const std::vector<StepSpec>& step_specs();
 /// Spec for @p id, or nullptr when @p id is not an AD5X tuning step.
 const StepSpec* spec_for(wizard::StepId id);
 
-/// The tuning steps' ids in wizard order (for a targeted wizard session).
+/// The AD5X steps' ids in wizard order, time zone first (for a targeted wizard
+/// session).
 std::vector<wizard::StepId> step_ids();
 
 /// Whether the printer has the AD5X setup steps: the `ad5x` preset is set for
@@ -173,3 +177,34 @@ class WizardAd5xSetupStep : public helix::wizard::Step {
 
 /// The step instance for @p id (one of the AD5X tuning step ids).
 WizardAd5xSetupStep* get_wizard_ad5x_setup_step(helix::wizard::StepId id);
+
+/**
+ * @class WizardAd5xTimezoneStep
+ * @brief AD5X time zone step: the Settings > Language & Time zone list
+ *
+ * Nothing runs on the printer; a pick is applied and saved at once by
+ * DisplaySettingsManager, and Next is always allowed (UTC is a valid answer).
+ */
+class WizardAd5xTimezoneStep : public helix::wizard::Step {
+  public:
+    helix::wizard::StepId id() const override {
+        return helix::wizard::StepId::Ad5xTimezone;
+    }
+    const char* component_name() const override {
+        return "wizard_ad5x_timezone";
+    }
+    const char* log_name() const override {
+        return "WizardAd5xTimezone";
+    }
+    bool should_skip(const helix::wizard::StepContext& ctx) const override;
+
+    void init_subjects() override {}
+    void register_callbacks() override;
+    lv_obj_t* create(lv_obj_t* parent) override;
+    void cleanup() override;
+
+  private:
+    lv_obj_t* root_ = nullptr;
+};
+
+WizardAd5xTimezoneStep* get_wizard_ad5x_timezone_step();
