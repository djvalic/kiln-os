+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Kiln OS's IFS driver (klipper/extras/ifs.py) publishes the standalone
+// module's `ifs` object plus what it is doing: `operation`, `phase`,
+// `target_channel` and `activity_channel`. These tests pin how the AD5X
+// backend shows that, and that an older driver without the fields keeps the
+// plain `activity` mapping.
+
+#include "../lvgl_test_fixture.h"
+#include "../test_helpers/print_state_test_drivers.h"
+#include "ams_backend_ad5x_ifs.h"
+#include "ams_types.h"
+#include "app_globals.h"
+#include "printer_state.h"
+#include "test_helpers/ad5x_ifs_test_access.h"
+
+#include <chrono>
+#include <string>
+#include <vector>
+
+#include "../catch_amalgamated.hpp"
+
+using helix::Ad5xIfsTestAccess;
+using helix::AmsAction;
+using helix::AmsBackendAd5xIfs;
+using helix::StepOperationType;
+
+using json = nlohmann::json;
+
+namespace {
+
+/// An idle Kiln `ifs` frame: lanes 1 and 3 hold filament, lane 1 is loaded.
+json kiln_idle_frame() {
+    return json{{"ifs",
+                 {{"connected", true},
+                  {"error", nullptr},
+                  {"activity", "ready"},
+                  {"activity_channel", 0},
+                  {"active_channel", 1},
+                  {"loaded_channels", {1, 3}},
+                  {"operation", ""},
+                  {"phase", ""},
+                  {"target_channel", 0}}}};
+}
+
+/// A diff frame: only the step fields.
+json kiln_step(const char* operation, const char* phase, int target, int moving,
+               const char* activity = "loading") {
+    return json{{"ifs",
+                 {{"operation", operation},
+                  {"phase", phase},
+                  {"target_channel", target},
+                  {"activity_channel", moving},
+                  {"activity", activity}}}};
+}
+
+} // namespace
+
+TEST_CASE("AD5X IFS maps Kiln's operation and phase onto steps", "[ams][ad5x_ifs][kiln_ifs]") {
+    using V = AmsBackendAd5xIfs;
+
+    SECTION("an unload heats, cuts and retracts") {
+        auto v = V::kiln_step_view("unload", "heating", "unloading");
+        CHECK(v.action == AmsAction::HEATING);
+        CHECK(v.phase_index == 0);
+        CHECK(v.op == StepOperationType::UNLOAD);
+        v = V::kiln_step_view("unload", "cutting", "unloading");
+        CHECK(v.action == AmsAction::CUTTING);
+        CHECK(v.phase_index == 1);
+        v = V::kiln_step_view("unload", "unloading", "unloading");
+        CHECK(v.action == AmsAction::UNLOADING);
+        CHECK(v.phase_index == 2);
+    }
+    SECTION("a swap shows the unload steps, then the load steps") {
+        auto v = V::kiln_step_view("swap", "heating", "loading");
+        CHECK(v.op == StepOperationType::UNLOAD);
+        CHECK(v.phase_index == 0);
+        v = V::kiln_step_view("swap", "unloading", "unloading");
+        CHECK(v.op == StepOperationType::UNLOAD);
+        CHECK(v.phase_index == 2);
+        v = V::kiln_step_view("swap", "selecting", "selecting");
+        CHECK(v.action == AmsAction::LOADING);
+        CHECK(v.op == StepOperationType::LOAD_SWAP);
+        CHECK(v.phase_index == 1);
+        v = V::kiln_step_view("refill", "feeding", "loading");
+        CHECK(v.op == StepOperationType::LOAD_SWAP);
+        CHECK(v.phase_index == 1);
+        v = V::kiln_step_view("swap", "priming", "loading");
+        CHECK(v.action == AmsAction::PURGING);
+        CHECK(v.phase_index == 2);
+    }
+    SECTION("a load into an empty toolhead heats, feeds and purges") {
+        auto v = V::kiln_step_view("load", "heating", "loading");
+        CHECK(v.op == StepOperationType::LOAD_FRESH);
+        CHECK(v.phase_index == 0);
+        v = V::kiln_step_view("load", "purging", "loading");
+        CHECK(v.action == AmsAction::PURGING);
+        CHECK(v.op == StepOperationType::LOAD_FRESH);
+    }
+    SECTION("a lane-only move has no toolhead steps") {
+        for (const char* op : {"prefeed", "feed", "retract", "select", "tune"}) {
+            auto v = V::kiln_step_view(op, "feeding", "loading");
+            CHECK(v.action == AmsAction::SELECTING);
+            CHECK(v.phase_index == -1);
+            CHECK_FALSE(v.op.has_value());
+        }
+    }
+    SECTION("no operation: the activity alone") {
+        CHECK(V::kiln_step_view("", "", "loading").action == AmsAction::LOADING);
+        CHECK(V::kiln_step_view("", "", "unloading").action == AmsAction::UNLOADING);
+        CHECK(V::kiln_step_view("", "", "homing").action == AmsAction::SELECTING);
+        CHECK(V::kiln_step_view("", "", "ready").action == AmsAction::IDLE);
+        CHECK_FALSE(V::kiln_step_view("", "", "loading").op.has_value());
+    }
+}
+
+TEST_CASE("AD5X IFS shows a swap Kiln's driver runs", "[ams][ad5x_ifs][kiln_ifs]") {
+    AmsBackendAd5xIfs backend(nullptr, nullptr);
+    Ad5xIfsTestAccess::handle_status(backend, kiln_idle_frame());
+    REQUIRE(Ad5xIfsTestAccess::module_live(backend));
+    REQUIRE(Ad5xIfsTestAccess::action(backend) == AmsAction::IDLE);
+
+    // A slicer's T2 mid-print: slot 1 to slot 3, cutting slot 1 first.
+    Ad5xIfsTestAccess::handle_status(backend, kiln_step("swap", "cutting", 3, 1, "unloading"));
+    auto info = backend.get_system_info();
+    CHECK(info.action == AmsAction::CUTTING);
+    CHECK(info.operation_phase == 1);
+    CHECK(info.pending_target_slot == 2);
+    CHECK(info.operation_working_slot == 0);
+    CHECK(info.operation_detail.find("3") != std::string::npos);
+    CHECK(info.operation_detail.find("Cutting filament") != std::string::npos);
+    CHECK(backend.running_step_operation() == StepOperationType::UNLOAD);
+
+    // Feeding slot 3: the load half.
+    Ad5xIfsTestAccess::handle_status(backend, kiln_step("swap", "feeding", 3, 3));
+    info = backend.get_system_info();
+    CHECK(info.action == AmsAction::LOADING);
+    CHECK(info.operation_phase == 1);
+    CHECK(info.operation_working_slot == 2);
+    CHECK(backend.running_step_operation() == StepOperationType::LOAD_SWAP);
+
+    // A long phase is not a stuck one: the driver reports its own end.
+    Ad5xIfsTestAccess::check_action_timeout(backend, std::chrono::seconds(600));
+    CHECK(Ad5xIfsTestAccess::action(backend) == AmsAction::LOADING);
+
+    // Done: a diff frame carrying only the cleared operation.
+    Ad5xIfsTestAccess::handle_status(
+        backend, json{{"ifs", {{"operation", ""}, {"phase", ""}, {"target_channel", 0},
+                               {"activity_channel", 0}, {"activity", "ready"}}}});
+    info = backend.get_system_info();
+    CHECK(info.action == AmsAction::IDLE);
+    CHECK(info.operation_phase == -1);
+    CHECK(info.pending_target_slot == -1);
+    CHECK(info.operation_working_slot == -1);
+    CHECK(info.operation_detail.empty());
+    CHECK_FALSE(backend.running_step_operation().has_value());
+}
+
+TEST_CASE("AD5X IFS keeps a Kiln operation busy between its moves", "[ams][ad5x_ifs][kiln_ifs]") {
+    AmsBackendAd5xIfs backend(nullptr, nullptr);
+    Ad5xIfsTestAccess::handle_status(backend, kiln_idle_frame());
+
+    // An auto-refill whose board pauses between the unload and the load: the
+    // activity reads "ready", the operation still runs. The runout detector
+    // reads any non-IDLE action as an operation in flight.
+    Ad5xIfsTestAccess::handle_status(backend, kiln_step("refill", "unloading", 3, 1, "unloading"));
+    Ad5xIfsTestAccess::handle_status(backend, json{{"ifs", {{"activity", "ready"}}}});
+    CHECK(Ad5xIfsTestAccess::action(backend) == AmsAction::UNLOADING);
+    CHECK(backend.get_system_info().operation_detail.find("Auto-refill") != std::string::npos);
+}
+
+TEST_CASE("AD5X IFS shows a Kiln pre-feed as a lane move", "[ams][ad5x_ifs][kiln_ifs]") {
+    AmsBackendAd5xIfs backend(nullptr, nullptr);
+    Ad5xIfsTestAccess::handle_status(backend, kiln_idle_frame());
+
+    Ad5xIfsTestAccess::handle_status(backend, kiln_step("prefeed", "feeding", 0, 3));
+    const auto info = backend.get_system_info();
+    CHECK(info.action == AmsAction::SELECTING);
+    CHECK(info.operation_phase == -1);
+    // Slot 3 pulses although slot 1 is the one loaded.
+    CHECK(info.pending_target_slot == 2);
+    CHECK(info.operation_detail.find("Pre-feeding") != std::string::npos);
+    CHECK_FALSE(backend.running_step_operation().has_value());
+}
+
+TEST_CASE("AD5X IFS without Kiln's step fields keeps the activity mapping",
+          "[ams][ad5x_ifs][kiln_ifs]") {
+    AmsBackendAd5xIfs backend(nullptr, nullptr);
+    // An older driver: no operation / phase / target_channel.
+    Ad5xIfsTestAccess::handle_status(
+        backend, json{{"ifs", {{"activity", "loading"}, {"active_channel", 0},
+                               {"loaded_channels", json::array()}}}});
+    auto info = backend.get_system_info();
+    CHECK(info.action == AmsAction::LOADING);
+    CHECK(info.operation_phase == -1);
+    CHECK(info.operation_detail == "Loading filament");
+    CHECK_FALSE(backend.running_step_operation().has_value());
+
+    // clamped is a moment inside the load: no change.
+    Ad5xIfsTestAccess::handle_status(backend, json{{"ifs", {{"activity", "clamped"}}}});
+    CHECK(Ad5xIfsTestAccess::action(backend) == AmsAction::LOADING);
+
+    Ad5xIfsTestAccess::handle_status(backend, json{{"ifs", {{"activity", "ready"}}}});
+    CHECK(Ad5xIfsTestAccess::action(backend) == AmsAction::IDLE);
+    CHECK(backend.get_system_info().operation_detail.empty());
+}
+
+TEST_CASE("AD5X IFS leaves our own load's steps to the phase tracker",
+          "[ams][ad5x_ifs][kiln_ifs]") {
+    AmsBackendAd5xIfs backend(nullptr, nullptr);
+    Ad5xIfsTestAccess::handle_status(backend, kiln_idle_frame());
+    // The tracker's first phase, as do_load_filament() leaves it.
+    Ad5xIfsTestAccess::begin_phase_tracking(backend, /*is_unload=*/false);
+    REQUIRE(Ad5xIfsTestAccess::action(backend) == AmsAction::HEATING);
+
+    Ad5xIfsTestAccess::handle_status(backend, kiln_step("load", "purging", 3, 3));
+    const auto info = backend.get_system_info();
+    CHECK(info.action == AmsAction::HEATING);
+    // The slots still follow the driver.
+    CHECK(info.pending_target_slot == 2);
+    CHECK_FALSE(backend.running_step_operation().has_value());
+}
+
+namespace {
+
+/// LVGL plus the global PrinterState the runout detector reads.
+struct KilnRunoutFixture : public LVGLTestFixture {
+    KilnRunoutFixture() {
+        get_printer_state().init_subjects(false);
+        set_print_state(helix::PrintJobState::STANDBY);
+    }
+    ~KilnRunoutFixture() override {
+        set_print_state(helix::PrintJobState::STANDBY);
+    }
+    static void set_print_state(helix::PrintJobState s) {
+        if (get_printer_state().print_state().get_print_state_enum_subject()) {
+            helix::test::set_wire_state(get_printer_state(), s);
+        }
+    }
+    static json head(bool detected) {
+        return json{{"filament_switch_sensor toolhead", {{"filament_detected", detected}}}};
+    }
+};
+
+} // namespace
+
+TEST_CASE_METHOD(KilnRunoutFixture, "AD5X IFS holds the runout check while Kiln refills",
+                 "[ams][ad5x_ifs][kiln_ifs][runout]") {
+    AmsBackendAd5xIfs backend(nullptr, nullptr);
+    Ad5xIfsTestAccess::set_zcolor_supported(backend, false);
+    Ad5xIfsTestAccess::handle_status(backend, kiln_idle_frame());
+    Ad5xIfsTestAccess::handle_status(backend, head(true));
+    set_print_state(helix::PrintJobState::PAUSED);
+
+    // The refill cuts the spent strand: the head empties while it runs.
+    Ad5xIfsTestAccess::handle_status(backend, kiln_step("refill", "unloading", 3, 1, "unloading"));
+    Ad5xIfsTestAccess::handle_status(backend, head(false));
+    CHECK_FALSE(Ad5xIfsTestAccess::head_empty_armed(backend));
+    CHECK_FALSE(Ad5xIfsTestAccess::evaluate_runout(backend));
+
+    SECTION("a refill that loads the backup raises nothing") {
+        Ad5xIfsTestAccess::handle_status(backend, head(true));
+        Ad5xIfsTestAccess::handle_status(backend, kiln_idle_frame());
+        CHECK(Ad5xIfsTestAccess::action(backend) == AmsAction::IDLE);
+        CHECK_FALSE(Ad5xIfsTestAccess::head_empty_armed(backend));
+    }
+    SECTION("a refill that ends with the head empty arms the check") {
+        Ad5xIfsTestAccess::handle_status(backend, kiln_idle_frame());
+        CHECK(Ad5xIfsTestAccess::action(backend) == AmsAction::IDLE);
+        REQUIRE(Ad5xIfsTestAccess::head_empty_armed(backend));
+        Ad5xIfsTestAccess::age_head_empty(backend, std::chrono::seconds(600));
+        Ad5xIfsTestAccess::age_op_dispatch(backend, std::chrono::seconds(600));
+        CHECK(Ad5xIfsTestAccess::evaluate_runout(backend));
+        CHECK(Ad5xIfsTestAccess::runout_active(backend));
+    }
+}
