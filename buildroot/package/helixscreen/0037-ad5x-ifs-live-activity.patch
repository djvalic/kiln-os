@@ -5607,48 +5644,290 @@ bool AmsBackendAd5xIfs::apply_ifs_module_objects(const json& status) {
     // freshly pushed-in lane. Those set no tracker and install no ack callback;
     // the board's activity is the only Moonraker-visible signal they produce.
     // Transitions are deliberately one-directional per frame (busy only from
-    // IDLE, idle only from a busy the board itself reported): a polling "ready"
-    // frame must never erase the HEATING a tracked op just published.
+    // IDLE or the board's own busy, idle only from a busy the board itself
+    // reported): a polling "ready" frame must never erase the HEATING a
+    // tracked op just published.
+    //
+    // Kiln OS's driver also names the operation, its phase and the slots it
+    // moves, so a swap the slicer, a macro or auto-refill started shows its
+    // steps like one of ours. Diff frames carry only what changed: the fields
+    // are merged, and a frame carrying none of them changes nothing.
     bool action_changed = false;
-    if (!activity.empty()) {
+    if (!activity.empty() || operation || phase || target_channel || activity_channel) {
         std::lock_guard<std::mutex> lock(mutex_);
-        const AmsAction before = system_info_.action;
+        if (!activity.empty()) {
+            kiln_step_.activity = activity;
+        }
+        if (error_field) {
+            kiln_step_.error = *error_field;
+        }
+        if (operation) {
+            kiln_step_.operation = *operation;
+        }
+        if (phase) {
+            kiln_step_.phase = *phase;
+        }
+        if (target_channel) {
+            kiln_step_.target_channel = *target_channel;
+        }
+        if (activity_channel) {
+            kiln_step_.activity_channel = *activity_channel;
+        }
+        action_changed = apply_kiln_step_locked();
+    }
+    if (action_changed) {
+        emit_event(EVENT_STATE_CHANGED);
+    }
+    return true;
+}
+
+namespace {
+
+/// An `activity` that moves something: an older driver's only busy signal.
+bool kiln_activity_busy(const std::string& activity) {
+    return activity == "loading" || activity == "unloading" || activity == "homing" ||
+           activity == "selecting";
+}
+
+/// 0-based slot of a 1-based driver channel, -1 for none.
+int kiln_channel_slot(int channel) {
+    return channel >= 1 && channel <= AmsBackendAd5xIfs::kNumPorts ? channel - 1 : -1;
+}
+
+} // namespace
+
+AmsBackendAd5xIfs::KilnStepView AmsBackendAd5xIfs::kiln_step_view(const std::string& operation,
+                                                                  const std::string& phase,
+                                                                  const std::string& activity) {
+    KilnStepView v;
+    if (operation.empty()) {
+        // An older driver, or no operation running: the activity alone, with
+        // no step (the sidebar guesses the operation as before).
         if (activity == "loading") {
-            if (!phase_tracker_.active && system_info_.action == AmsAction::IDLE) {
-                system_info_.action = AmsAction::LOADING;
-                action_start_time_ = std::chrono::steady_clock::now();
-                set_operation_detail_locked("IFS: loading");
-            }
+            v.action = AmsAction::LOADING;
         } else if (activity == "unloading") {
-            if (!phase_tracker_.active && system_info_.action == AmsAction::IDLE) {
-                system_info_.action = AmsAction::UNLOADING;
+            v.action = AmsAction::UNLOADING;
+        } else if (activity == "homing" || activity == "selecting") {
+            v.action = AmsAction::SELECTING;
+        }
+        return v;
+    }
+
+    const bool unload = operation == "unload" || operation == "eject";
+    const bool load = operation == "load" || operation == "swap" || operation == "refill";
+    if (!unload && !load) {
+        // A lane-only move: nothing at the toolhead, so no Heat/Feed/Purge.
+        v.action = AmsAction::SELECTING;
+        return v;
+    }
+
+    // Indices are get_operation_step_model()'s: unload = Heat, Cut, Retract;
+    // load = Heat, Feed, Purge. A swap's heating is for its cut.
+    const StepOperationType load_op =
+        operation == "load" ? StepOperationType::LOAD_FRESH : StepOperationType::LOAD_SWAP;
+    const auto set = [&v](AmsAction action, StepOperationType op, int index) {
+        v.action = action;
+        v.op = op;
+        v.phase_index = index;
+    };
+    if (phase == "heating") {
+        set(AmsAction::HEATING, operation == "load" ? load_op : StepOperationType::UNLOAD, 0);
+    } else if (phase == "cutting") {
+        set(AmsAction::CUTTING, StepOperationType::UNLOAD, 1);
+    } else if (phase == "unloading") {
+        set(AmsAction::UNLOADING, StepOperationType::UNLOAD, 2);
+    } else if (unload) {
+        // Homing, selecting, a purge: still the retract end of the unload.
+        set(AmsAction::UNLOADING, StepOperationType::UNLOAD, phase.empty() ? -1 : 2);
+    } else if (phase == "homing" || phase == "selecting" || phase == "feeding") {
+        set(AmsAction::LOADING, load_op, 1);
+    } else if (phase == "purging" || phase == "priming") {
+        set(AmsAction::PURGING, load_op, 2);
+    } else {
+        set(activity == "unloading" ? AmsAction::UNLOADING : AmsAction::LOADING, load_op, -1);
+    }
+    return v;
+}
+
+std::optional<StepOperationType> AmsBackendAd5xIfs::running_step_operation() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!kiln_owns_action_ || phase_tracker_.active) {
+        return std::nullopt;
+    }
+    return kiln_step_view(kiln_step_.operation.value_or(""), kiln_step_.phase, kiln_step_.activity)
+        .op;
+}
+
+std::string AmsBackendAd5xIfs::kiln_step_detail_locked() const {
+    const KilnIfsStep& s = kiln_step_;
+    const std::string op = s.operation.value_or("");
+    const int target = kiln_channel_slot(s.target_channel);
+    const int moving = kiln_channel_slot(s.activity_channel);
+    const auto lane = [this](int slot) { return helix::ui::lane_label(lane_noun(), slot); };
+    // The slot the operation is about: where it heads, else the one moving.
+    const int slot = target >= 0 ? target : moving;
+    // The same slot for an unload or a lane move: the one moving, else the target.
+    const int own = moving >= 0 ? moving : target;
+
+    std::string what;
+    if (op == "swap") {
+        what = slot >= 0 ? fmt::format(lv_tr("Swap to {}"), lane(slot)) : lv_tr("Swapping filament");
+    } else if (op == "refill") {
+        what = slot >= 0 ? fmt::format(lv_tr("Auto-refill to {}"), lane(slot))
+                         : lv_tr("Auto-refill");
+    } else if (op == "load") {
+        what = slot >= 0 ? fmt::format(lv_tr("Loading {}"), lane(slot)) : lv_tr("Loading filament");
+    } else if (op == "unload") {
+        what = own >= 0 ? fmt::format(lv_tr("Unloading {}"), lane(own))
+                        : lv_tr("Unloading filament");
+    } else if (op == "eject") {
+        what = own >= 0 ? fmt::format(lv_tr("Ejecting {}"), lane(own)) : lv_tr("Ejecting filament");
+    } else if (op == "prefeed") {
+        what = own >= 0 ? fmt::format(lv_tr("Pre-feeding {}"), lane(own))
+                        : lv_tr("Pre-feeding filament");
+    } else if (op == "feed") {
+        what = own >= 0 ? fmt::format(lv_tr("Feeding {}"), lane(own)) : lv_tr("Feeding filament");
+    } else if (op == "retract") {
+        what = own >= 0 ? fmt::format(lv_tr("Retracting {}"), lane(own))
+                        : lv_tr("Retracting filament");
+    } else if (op == "select") {
+        what = slot >= 0 ? fmt::format(lv_tr("Selecting {}"), lane(slot)) : lv_tr("Selecting a slot");
+    } else if (op == "tune") {
+        what = own >= 0 ? fmt::format(lv_tr("Tuning {}"), lane(own)) : lv_tr("Tuning the IFS");
+    } else if (s.activity == "loading") {
+        what = lv_tr("Loading filament");
+    } else if (s.activity == "unloading") {
+        what = lv_tr("Unloading filament");
+    } else if (s.activity == "homing") {
+        what = lv_tr("Homing the IFS");
+    } else if (s.activity == "selecting") {
+        what = own >= 0 ? fmt::format(lv_tr("Selecting {}"), lane(own)) : lv_tr("Selecting a slot");
+    }
+    if (op.empty()) {
+        return what; // an older driver names no phase
+    }
+
+    std::string step;
+    if (s.phase == "heating") {
+        const int target_deci = last_extruder_target_deci_;
+        const int temp_deci = last_extruder_temp_deci_;
+        if (target_deci > 0 && temp_deci > 0) {
+            step = fmt::format(lv_tr("Heating nozzle to {}°C ({}°C)"),
+                               helix::ui::temperature::deci_to_degrees(target_deci),
+                               helix::ui::temperature::deci_to_degrees(temp_deci));
+        } else if (target_deci > 0) {
+            step = fmt::format(lv_tr("Heating nozzle to {}°C"),
+                               helix::ui::temperature::deci_to_degrees(target_deci));
+        } else {
+            step = lv_tr("Heating nozzle");
+        }
+    } else if (s.phase == "cutting") {
+        step = lv_tr("Cutting filament");
+    } else if (s.phase == "unloading") {
+        step = lv_tr("Retracting filament");
+    } else if (s.phase == "homing") {
+        step = lv_tr("Homing the IFS");
+    } else if (s.phase == "selecting") {
+        step = lv_tr("Selecting the slot");
+    } else if (s.phase == "feeding") {
+        step = lv_tr("Feeding filament");
+    } else if (s.phase == "purging") {
+        step = lv_tr("Purging");
+    } else if (s.phase == "priming") {
+        step = lv_tr("Priming the nozzle");
+    }
+    if (what.empty() || step.empty()) {
+        return what.empty() ? step : what;
+    }
+    return what + " · " + step;
+}
+
+bool AmsBackendAd5xIfs::apply_kiln_step_locked() {
+    const AmsAction action_before = system_info_.action;
+    const std::string detail_before = system_info_.operation_detail;
+    const int phase_before = system_info_.operation_phase;
+    const int target_before = system_info_.pending_target_slot;
+    const int working_before = system_info_.operation_working_slot;
+
+    const KilnIfsStep& s = kiln_step_;
+    const std::string operation = s.operation.value_or("");
+    const bool busy = !operation.empty() || kiln_activity_busy(s.activity);
+    // An older driver idles on "ready" / "polling"; clamped and unclamping are
+    // sub-second states inside a load or unload, and guessing a direction from
+    // them would be wrong. With `operation` published, "" is idle.
+    const bool idle = !busy && (s.operation.has_value() || s.activity == "ready" ||
+                                s.activity == "polling");
+
+    if (s.activity == "driver_error") {
+        // The board's stepper driver faulted. Report it unless a fault with
+        // richer state (the runout detector) already holds ERROR - and never
+        // clear it from here; the module's IFS_RESET_DRIVER recovery path owns
+        // that.
+        if (system_info_.action != AmsAction::ERROR && !runout_active_) {
+            system_info_.action = AmsAction::ERROR;
+            set_operation_detail_locked(s.error.empty() ? lv_tr("IFS driver error") : s.error);
+        }
+        if (kiln_owns_action_) {
+            system_info_.operation_phase = -1;
+            kiln_owns_action_ = false;
+        }
+    } else if (busy) {
+        const int target = kiln_channel_slot(s.target_channel);
+        const int moving = kiln_channel_slot(s.activity_channel);
+        // The slots pulse while busy: the one the operation heads for, else
+        // the one moving. The header names the one moving.
+        system_info_.pending_target_slot = target >= 0 ? target : moving;
+        system_info_.operation_working_slot = moving >= 0 ? moving : target;
+
+        // A runout raised on a paused print that the driver now handles (an
+        // auto-refill, a swap from the console): the swap is the recovery.
+        if (runout_active_ && !operation.empty()) {
+            clear_runout_locked("the IFS driver is changing the filament");
+        }
+        // Our own ops keep the phase tracker's steps. An op that set an
+        // action without the tracker (do_change_tool's T<n>) is the driver's
+        // to describe.
+        const bool may_take =
+            !phase_tracker_.active &&
+            (kiln_owns_action_ || system_info_.action == AmsAction::IDLE ||
+             system_info_.action == AmsAction::LOADING ||
+             system_info_.action == AmsAction::UNLOADING);
+        if (may_take) {
+            const KilnStepView view = kiln_step_view(operation, s.phase, s.activity);
+            if (view.action != system_info_.action ||
+                view.phase_index != system_info_.operation_phase) {
                 action_start_time_ = std::chrono::steady_clock::now();
-                set_operation_detail_locked("IFS: unloading");
-            }
-        } else if (activity == "ready" || activity == "polling") {
-            if (!phase_tracker_.active && (system_info_.action == AmsAction::LOADING ||
-                                           system_info_.action == AmsAction::UNLOADING)) {
-                system_info_.action = AmsAction::IDLE;
-                set_operation_detail_locked("");
             }
-        } else if (activity == "driver_error") {
-            // The board's stepper driver faulted. Report it unless a fault with
-            // richer state (the runout detector) already holds ERROR - and
-            // never clear it from here; the module's IFS_RESET_DRIVER recovery
-            // path owns that.
-            if (system_info_.action != AmsAction::ERROR && !runout_active_) {
-                system_info_.action = AmsAction::ERROR;
-                set_operation_detail_locked(error_text.empty() ? "IFS driver error" : error_text);
+            system_info_.action = view.action;
+            system_info_.operation_phase = view.phase_index;
+            set_operation_detail_locked(kiln_step_detail_locked());
+            kiln_owns_action_ = true;
+        }
+    } else if (idle) {
+        system_info_.pending_target_slot = -1;
+        system_info_.operation_working_slot = -1;
+        if (!phase_tracker_.active &&
+            (kiln_owns_action_ || system_info_.action == AmsAction::LOADING ||
+             system_info_.action == AmsAction::UNLOADING)) {
+            // An operation of the driver's ended with the print paused and the
+            // toolhead empty (a refill or swap that did not load): that is the
+            // runout the detector reports, armed now because the head went
+            // empty while the operation still ran.
+            if (kiln_owns_action_ && head_switch_seen_ && !head_switch_present_ &&
+                print_is_paused() && !runout_active_) {
+                head_empty_since_ = std::chrono::steady_clock::now();
             }
+            system_info_.action = AmsAction::IDLE;
+            system_info_.operation_phase = -1;
+            set_operation_detail_locked("");
         }
-        // clamped / unclamping are sub-second transitional states of a load or
-        // unload already covered above; mapping them would guess a direction.
-        action_changed = system_info_.action != before;
+        kiln_owns_action_ = false;
     }
-    if (action_changed) {
-        emit_event(EVENT_STATE_CHANGED);
-    }
-    return true;
+
+    return system_info_.action != action_before || system_info_.operation_detail != detail_before ||
+           system_info_.operation_phase != phase_before ||
+           system_info_.pending_target_slot != target_before ||
+           system_info_.operation_working_slot != working_before;
 }
 
 void AmsBackendAd5xIfs::apply_zcolor_result(const ZColorSilentResult& result) {
@@ -6614,6 +6893,8 @@ void AmsBackendAd5xIfs::begin_phase_tracking_locked(bool is_unload) {
     phase_tracker_ = IfsPhaseTracker{};
