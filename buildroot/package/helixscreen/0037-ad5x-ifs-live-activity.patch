 }
@@ -5497,6 +5509,12 @@ bool AmsBackendAd5xIfs::apply_ifs_module_objects(const json& status) {
     bool saw_module_content = false;
     std::string activity;
     std::string error_text;
+    std::optional<std::string> error_field;
+    // Kiln OS's driver: the operation, its phase and the slots it moves.
+    std::optional<std::string> operation;
+    std::optional<std::string> phase;
+    std::optional<int> target_channel;
+    std::optional<int> activity_channel;
 
     if (auto it = status.find("ifs"); it != status.end() && it->is_object()) {
         const auto& obj = *it;
@@ -5539,6 +5557,25 @@ bool AmsBackendAd5xIfs::apply_ifs_module_objects(const json& status) {
         }
         if (auto e = obj.find("error"); e != obj.end() && e->is_string()) {
             error_text = e->get<std::string>();
