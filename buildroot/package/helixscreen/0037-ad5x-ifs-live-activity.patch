@@ -597,6 +597,27 @@ class AmsBackendAd5xIfs : public AmsSubscriptionBackend {
     [[nodiscard]] OperationStepModel get_operation_step_model(StepOperationType op) const override;
     [[nodiscard]] lv_subject_t* get_operation_step_index_subject(StepOperationType op) override;
 
+    /// Kiln OS's IFS driver names what it is doing: `operation` ("" when
+    /// idle; load, unload, swap, refill, eject, prefeed, feed, retract,
+    /// select, tune) and its `phase` (heating, cutting, unloading, homing,
+    /// selecting, feeding, purging, priming). How such a step shows: the
+    /// action, the step of get_operation_step_model() it is at (-1 none) and
+    /// that model's operation. A swap or an auto-refill shows the unload steps
+    /// while it heats, cuts and retracts, then the load steps. A lane-only
+    /// move (pre-feed, feed, retract, select, tune) is SELECTING with no
+    /// steps. An empty @p operation is an older driver: @p activity alone.
+    struct KilnStepView {
+        AmsAction action = AmsAction::IDLE;
+        int phase_index = -1;
+        std::optional<StepOperationType> op;
+    };
+    [[nodiscard]] static KilnStepView kiln_step_view(const std::string& operation,
+                                                     const std::string& phase,
+                                                     const std::string& activity);
+
+    /// The operation Kiln OS's IFS driver runs, while it owns the action.
+    [[nodiscard]] std::optional<StepOperationType> running_step_operation() const override;
+
     // User-initiated state refresh. Re-reads Adventurer5M.json (the JSON poll
     // is the primary truth source on both old and new zmod) and schedules a
     // GET_ZCOLOR SILENT=1 follow-up to refresh the active-slot view. Both
@@ -1150,6 +1171,16 @@ class AmsBackendAd5xIfs : public AmsSubscriptionBackend {
     /// @return true if the frame carried either object.
     bool apply_ifs_module_objects(const nlohmann::json& status);
 
+    /// Show kiln_step_ in system_info_: the action and step (unless an op of
+    /// ours runs), the detail line, the target slot (pending_target_slot) and
+    /// the slot moving now (operation_working_slot). Caller holds mutex_.
+    /// @return true when any of them changed.
+    bool apply_kiln_step_locked();
+
+    /// The detail line for kiln_step_, translated: "Swap to Slot 3 ·
+    /// Cutting filament". Caller holds mutex_.
+    [[nodiscard]] std::string kiln_step_detail_locked() const;
+
     /// Z-Mod's change macro keeps the target tool in
     /// `gcode_macro END_CHANGE_FILAMENT`.last_data.channel from the start of a
     /// filament change to its end, and 99 otherwise. Its runout auto-swap and
@@ -1830,6 +1861,24 @@ class AmsBackendAd5xIfs : public AmsSubscriptionBackend {
     /// none), re-supplied into Ports-only diff frames for the same reason
     /// zmod_last_chan_ exists. Guarded by mutex_.
     std::optional<int> module_last_chan_;
+    /// What Kiln OS's IFS driver reports doing, merged across diff frames.
+    /// Channels are 1-based, 0 for none: `target_channel` is the slot the
+    /// operation heads for, `activity_channel` the slot moving now. An older
+    /// driver publishes `activity` alone and `operation` stays unset.
+    /// Guarded by mutex_.
+    struct KilnIfsStep {
+        std::string activity;
+        std::optional<std::string> operation;
+        std::string phase;
+        int target_channel = 0;
+        int activity_channel = 0;
+        std::string error;
+    };
+    KilnIfsStep kiln_step_;
+    /// True while system_info_.action is the driver's (apply_kiln_step_locked):
+    /// only its idle report clears it, and the action timeout leaves it to the
+    /// driver. Guarded by mutex_.
+    bool kiln_owns_action_ = false;
     /// True while the SELECTING in system_info_.action was set by
     /// apply_zmod_change_macro, so only that source clears it. Guarded by mutex_.
     bool zmod_change_owns_action_ = false;
diff --git a/src/printer/ams_backend_ad5x_ifs.cpp b/src/printer/ams_backend_ad5x_ifs.cpp
index 84a3f9d..46124cd 100644
--- a/src/printer/ams_backend_ad5x_ifs.cpp
+++ b/src/printer/ams_backend_ad5x_ifs.cpp
@@ -798,6 +798,13 @@ void AmsBackendAd5xIfs::handle_status(const json& status_obj) {
             if (system_info_.action != before || system_info_.operation_detail != detail_before) {
                 state_changed = true;
             }
