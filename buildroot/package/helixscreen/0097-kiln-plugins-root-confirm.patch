diff --git a/include/ui_settings_ad5x_plugins.h b/include/ui_settings_ad5x_plugins.h
index d6a30416d7..c52e03bf31 100644
--- a/include/ui_settings_ad5x_plugins.h
+++ b/include/ui_settings_ad5x_plugins.h
@@ -42,6 +42,7 @@ struct Ad5xInstalledPlugin {
     bool builtin = false;    ///< Shipped with the OS: can be switched, not removed
     bool enabled = false;    ///< On at this Klipper start
     bool compatible = true;  ///< Plugin API new enough
+    bool root = false;       ///< Has root scripts: ENABLE_PLUGIN needs ROOT=1
 };
 
 /// One catalog plugin that is not installed.
@@ -61,6 +62,20 @@ std::vector<Ad5xCatalogPlugin> ad5x_catalog_plugins(const json& status);
 /// Catalog title for @p name, else @p name itself.
 std::string ad5x_plugin_title(const json& status, const std::string& name);
 
+/// What switching an installed plugin on or off asks first, and sends.
+struct Ad5xToggleConfirm {
+    std::string title;
+    std::string message;
+    std::string button;
+    std::string gcode;
+    bool restarts = true; ///< Klipper restarts as soon as the command is accepted
+};
+
+/// The confirmation for switching @p p on (@p on) or off. A plugin with root
+/// scripts says so before it goes on and is enabled with ROOT=1; Klipper
+/// restarts only after root's install.sh, so not right away.
+Ad5xToggleConfirm ad5x_toggle_confirm(const Ad5xInstalledPlugin& p, bool on);
+
 /// What the status line says about the job.
 enum class Ad5xJobLine {
     None = 0,    ///< Nothing to report: the line is hidden
@@ -127,7 +142,7 @@ class Ad5xPluginsOverlay : public OverlayBase {
 
     json status_ = json::object();
     std::vector<Ad5xInstalledPlugin> installed_;
-    /// enabled + available + catalog as last rendered; rows rebuild when it changes
+    /// enabled + available + catalog + a failed job, as last rendered; a change rebuilds the rows
     std::string rows_key_;
     bool loaded_ = false;
     bool klippy_ready_ = true;
diff --git a/src/ui/ui_settings_ad5x_plugins.cpp b/src/ui/ui_settings_ad5x_plugins.cpp
index db745e6f9a..0238b84e4c 100644
--- a/src/ui/ui_settings_ad5x_plugins.cpp
+++ b/src/ui/ui_settings_ad5x_plugins.cpp
@@ -102,6 +102,7 @@ std::vector<Ad5xInstalledPlugin> ad5x_installed_plugins(const json& status) {
         p.version = json_util::safe_string(it.value(), "version");
         p.builtin = json_util::safe_string(it.value(), "source") != "user";
         p.compatible = json_util::safe_bool(it.value(), "compatible", true);
+        p.root = json_util::safe_bool(it.value(), "root", false);
         p.enabled = std::find(enabled.begin(), enabled.end(), p.name) != enabled.end();
         out.push_back(std::move(p));
     }
@@ -137,6 +138,24 @@ std::vector<Ad5xCatalogPlugin> ad5x_catalog_plugins(const json& status) {
     return out;
 }
 
+Ad5xToggleConfirm ad5x_toggle_confirm(const Ad5xInstalledPlugin& p, bool on) {
+    Ad5xToggleConfirm c;
+    c.title = fmt::format(on ? lv_tr("Turn on {}?") : lv_tr("Turn off {}?"), p.title);
+    c.button = on ? lv_tr("Turn On") : lv_tr("Turn Off");
+    if (on && p.root) {
+        c.message = lv_tr("This plugin runs some of its code as root, the system's administrator "
+                          "account, for example to set up USB devices. Turn it on only if you "
+                          "trust where it comes from. Klipper restarts.");
+        c.gcode = fmt::format("ENABLE_PLUGIN NAME={} ROOT=1", p.name);
+        // A job first (root/install.sh, the status line); the restart follows it
+        c.restarts = false;
+        return c;
+    }
+    c.message = lv_tr("Klipper restarts to apply this. Continue?");
+    c.gcode = fmt::format("{} NAME={}", on ? "ENABLE_PLUGIN" : "DISABLE_PLUGIN", p.name);
+    return c;
+}
+
 // ============================================================================
 // LIFECYCLE
 // ============================================================================
@@ -365,6 +384,12 @@ void Ad5xPluginsOverlay::render_rows(bool force) {
             lists[key] = *v;
         }
     }
+    // A failed job rebuilds them too: a switch turned on for a job that
+    // failed (root/install.sh) goes back to off
+    if (const json* job = json_util::find_member(status_, "job");
+        job && json_util::safe_string(*job, "state") == "failed") {
+        lists["failed_job"] = *job;
+    }
     const std::string key = json_util::safe_dump(lists);
     installed_ = ad5x_installed_plugins(status_);
     const std::vector<Ad5xCatalogPlugin> catalog = ad5x_catalog_plugins(status_);
@@ -483,18 +508,15 @@ void Ad5xPluginsOverlay::handle_toggle(const std::string& name, bool on) {
         render_rows(true);
         return;
     }
-    const std::string title =
-        fmt::format(on ? lv_tr("Turn on {}?") : lv_tr("Turn off {}?"), p->title);
-    const std::string gcode =
-        fmt::format("{} NAME={}", on ? "ENABLE_PLUGIN" : "DISABLE_PLUGIN", name);
+    const Ad5xToggleConfirm c = ad5x_toggle_confirm(*p, on);
     helix::ui::ConfirmOptions opts;
     opts.owner_token = object_lifetime_.token();
     // Cancelling puts the switch back
     opts.on_cancel = [this]() { render_rows(true); };
     opts.on_dismiss = [this]() { render_rows(true); };
     helix::ui::modal_confirm(
-        title.c_str(), lv_tr("Klipper restarts to apply this. Continue?"), ModalSeverity::Warning,
-        on ? lv_tr("Turn On") : lv_tr("Turn Off"), [this, gcode]() { send(gcode, true); }, opts);
+        c.title.c_str(), c.message.c_str(), ModalSeverity::Warning, c.button.c_str(),
+        [this, gcode = c.gcode, restarts = c.restarts]() { send(gcode, restarts); }, opts);
 }
 
 void Ad5xPluginsOverlay::handle_install(const std::string& name) {
diff --git a/tests/unit/test_settings_ad5x_plugins.cpp b/tests/unit/test_settings_ad5x_plugins.cpp
index 976830a8e5..49480d888d 100644
--- a/tests/unit/test_settings_ad5x_plugins.cpp
+++ b/tests/unit/test_settings_ad5x_plugins.cpp
@@ -2,10 +2,16 @@
 
 #include "ui_settings_ad5x_plugins.h"
 
+#include "lvgl/src/others/translation/lv_translation.h"
+#include "translation_loader.h"
+
+#include <string>
+
 #include "../catch_amalgamated.hpp"
 #include "hv/json.hpp"
 
 using namespace helix::settings;
+using Catch::Matchers::ContainsSubstring;
 
 namespace {
 
@@ -20,7 +26,9 @@ json sample_status() {
             "notify": {"source": "user", "description": "Print notifications",
                        "version": "0.3.0", "compatible": true},
             "bambufy-compat": {"source": "shipped", "description": "", "version": "",
-                               "compatible": false}
+                               "compatible": false},
+            "ff-nfc": {"source": "user", "description": "NFC spool tags", "version": "1.0.0",
+                       "compatible": true, "root": true, "root_installed": false}
         },
         "catalog": {
             "notify": {"title": "Notifications", "description": "Telegram, ntfy, ...",
@@ -40,22 +48,28 @@ json sample_status() {
 TEST_CASE("installed plugins are sorted, titled from the catalog and carry their state",
           "[ad5x_plugins]") {
     const auto rows = ad5x_installed_plugins(sample_status());
-    REQUIRE(rows.size() == 3);
+    REQUIRE(rows.size() == 4);
     CHECK(rows[0].name == "bambufy-compat");
-    CHECK(rows[1].name == "notify");
-    CHECK(rows[2].name == "zmod-compat");
+    CHECK(rows[1].name == "ff-nfc");
+    CHECK(rows[2].name == "notify");
+    CHECK(rows[3].name == "zmod-compat");
 
     CHECK(rows[0].title == "bambufy-compat");
     CHECK_FALSE(rows[0].compatible);
     CHECK_FALSE(rows[0].enabled);
 
-    CHECK(rows[1].title == "Notifications");
-    CHECK_FALSE(rows[1].builtin);
-    CHECK(rows[1].enabled);
-    CHECK(rows[1].version == "0.3.0");
+    CHECK(rows[1].root);
+    CHECK_FALSE(rows[1].enabled);
 
-    CHECK(rows[2].builtin);
+    CHECK(rows[2].title == "Notifications");
+    CHECK_FALSE(rows[2].builtin);
     CHECK(rows[2].enabled);
+    CHECK(rows[2].version == "0.3.0");
+    CHECK_FALSE(rows[2].root);
+
+    CHECK(rows[3].builtin);
+    CHECK(rows[3].enabled);
+    CHECK_FALSE(rows[3].root);
 }
 
 TEST_CASE("the catalog section lists only plugins not installed", "[ad5x_plugins]") {
@@ -82,3 +96,82 @@ TEST_CASE("an object without lists yields no rows", "[ad5x_plugins]") {
     CHECK(ad5x_catalog_plugins(status).empty());
     CHECK(ad5x_plugin_title(status, "notify") == "notify");
 }
+
+TEST_CASE("switching a plugin on or off asks and sends as before", "[ad5x_plugins]") {
+    Ad5xInstalledPlugin p;
+    p.name = "notify";
+    p.title = "Notifications";
+
+    const Ad5xToggleConfirm on = ad5x_toggle_confirm(p, true);
+    CHECK(on.title == "Turn on Notifications?");
+    CHECK(on.message == "Klipper restarts to apply this. Continue?");
+    CHECK(on.button == "Turn On");
+    CHECK(on.gcode == "ENABLE_PLUGIN NAME=notify");
+    CHECK(on.restarts);
+
+    const Ad5xToggleConfirm off = ad5x_toggle_confirm(p, false);
+    CHECK(off.title == "Turn off Notifications?");
+    CHECK(off.message == "Klipper restarts to apply this. Continue?");
+    CHECK(off.button == "Turn Off");
+    CHECK(off.gcode == "DISABLE_PLUGIN NAME=notify");
+    CHECK(off.restarts);
+}
+
+TEST_CASE("a plugin with root scripts says so and goes on with ROOT=1", "[ad5x_plugins]") {
+    const auto rows = ad5x_installed_plugins(sample_status());
+    REQUIRE(rows.size() == 4);
+    REQUIRE(rows[1].name == "ff-nfc");
+
+    const Ad5xToggleConfirm on = ad5x_toggle_confirm(rows[1], true);
+    CHECK(on.title == "Turn on ff-nfc?");
+    CHECK_THAT(on.message, ContainsSubstring("runs some of its code as root"));
+    CHECK_THAT(on.message, ContainsSubstring("administrator account"));
+    CHECK_THAT(on.message, ContainsSubstring("only if you trust where it comes from"));
+    CHECK_THAT(on.message, ContainsSubstring("Klipper restarts"));
+    CHECK(on.button == "Turn On");
+    CHECK(on.gcode == "ENABLE_PLUGIN NAME=ff-nfc ROOT=1");
+    // root/install.sh runs first; Klipper restarts after it
+    CHECK_FALSE(on.restarts);
+
+    // Turning it off is the same as for any plugin
+    Ad5xInstalledPlugin enabled = rows[1];
+    enabled.enabled = true;
+    const Ad5xToggleConfirm off = ad5x_toggle_confirm(enabled, false);
+    CHECK(off.gcode == "DISABLE_PLUGIN NAME=ff-nfc");
+    CHECK(off.message == "Klipper restarts to apply this. Continue?");
+    CHECK(off.restarts);
+}
+
+TEST_CASE("the root question is in every language, one language at a time",
+          "[ad5x_plugins][i18n]") {
+    struct RestoreLanguage {
+        ~RestoreLanguage() {
+            lv_translation_set_language(helix::ui::kIdentityLocale);
+        }
+    } restore;
+    Ad5xInstalledPlugin p;
+    p.name = "ff-nfc";
+    p.title = "NFC";
+    p.root = true;
+    for (const char* lang : {"de", "es", "fr", "it", "ja", "ko", "pt", "ru", "tr", "zh"}) {
+        CAPTURE(lang);
+        helix::ui::ensure_translation_loaded(lang);
+        lv_translation_set_language(lang);
+        const Ad5xToggleConfirm on = ad5x_toggle_confirm(p, true);
+        CHECK(on.title != "Turn on NFC?");
+        CHECK_THAT(on.title, ContainsSubstring("NFC"));
+        CHECK_THAT(on.message, ContainsSubstring("root"));
+        CHECK_THAT(on.message, ContainsSubstring("USB"));
+        CHECK_THAT(on.message, !ContainsSubstring("administrator"));
+        CHECK_THAT(on.message, !ContainsSubstring("Turn it on"));
+        CHECK(on.button != "Turn On");
+        CHECK(on.gcode == "ENABLE_PLUGIN NAME=ff-nfc ROOT=1");
+    }
+    helix::ui::ensure_translation_loaded("ru");
+    lv_translation_set_language("ru");
+    const Ad5xToggleConfirm ru = ad5x_toggle_confirm(p, true);
+    CHECK(ru.title == "Включить NFC?");
+    CHECK_THAT(ru.message, ContainsSubstring("от имени root"));
+    CHECK_THAT(ru.message, ContainsSubstring("Klipper перезапустится"));
+    CHECK(ru.button == "Включить");
+}
