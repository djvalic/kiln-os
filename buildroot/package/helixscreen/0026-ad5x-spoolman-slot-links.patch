 // --- Status parsing ---
 
+// The kiln-spoolman plugin publishes each IFS slot's Spoolman spool as the
+// printer object `spoolman_slots`: {"slots": {"1": id-or-null, ...}}. A new
+// non-null id links that slot to the spool through the same override save the
+// slot edit uses; SpoolmanManager then fetches its remaining weight. A null
+// id does not unlink, so a spool chosen on the screen is never cleared by the
+// plugin.
+bool AmsBackendAd5xIfs::parse_spoolman_slots_locked(const json& object) {
+    if (!object.is_object() || !object.contains("slots") || !object["slots"].is_object()) {
+        return false;
+    }
+    const auto& slots = object["slots"];
+    bool changed = false;
+    for (int slot = 0; slot < kNumPorts; ++slot) {
+        auto it = slots.find(std::to_string(slot + 1));
+        const int spool = (it != slots.end() && it->is_number_integer()) ? it->get<int>() : 0;
+        if (spool <= 0) {
+            plugin_spool_seen_[slot] = 0;
+            continue;
+        }
+        const int seen = plugin_spool_seen_[slot];
+        if (spool == seen) {
+            continue;
+        }
+        plugin_spool_seen_[slot] = spool;
+        auto found = overrides_.find(slot);
+        const int linked = found != overrides_.end() ? found->second.spoolman_id : 0;
+        if (linked == spool) {
+            continue;
+        }
+        // First frame after a restart: keep a link the screen saved earlier.
+        if (seen < 0 && linked > 0) {
+            continue;
+        }
+        overrides_[slot].spoolman_id = spool;
+        publish_override_locked(slot, "kiln-spoolman slot link");
+        changed = true;
+    }
+    return changed;
+}
