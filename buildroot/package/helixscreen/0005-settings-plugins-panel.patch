+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * @file ui_settings_ad5x_plugins.h
+ * @brief Settings > Plugins on the AD5X: the printer's own plugins (Klipper add-ons)
+ *
+ * Shows the `ad5x_plugins` Klipper status object: the installed plugins with
+ * an on/off switch (Update and Remove for user-installed ones), the catalog
+ * plugins not installed yet with Install, and the running install/update job.
+ * Every change is a G-code command (ENABLE_PLUGIN, DISABLE_PLUGIN,
+ * INSTALL_PLUGIN, UPDATE_PLUGIN, REMOVE_PLUGIN); most of them restart Klipper,
+ * after which the object comes back and the rows are rebuilt from it.
+ *
+ * Not HelixScreen's own plugin host (plugins_overlay.h): those are screen
+ * plugins, these live in Klipper.
+ *
+ * @pattern Overlay (lazy init), rows rebuilt from the cached status object
+ * @threading Main thread only; Moonraker callbacks hop over via lifetime tokens
+ */
+
+#pragma once
+
+#include "ui_observer_guard.h"
+#include "ui_subscription_guard.h"
+
+#include "json_fwd.h"
+#include "overlay_base.h"
+#include "static_panel_registry.h"
+#include "subject_managed_panel.h"
+
+#include <string>
+#include <vector>
+
+namespace helix::settings {
+
+/// One installed plugin, as its row shows it.
+struct Ad5xInstalledPlugin {
+    std::string name;        ///< NAME= value
+    std::string title;       ///< Catalog title when listed there, else the name
+    std::string description; ///< May be empty
+    std::string version;     ///< May be empty
+    bool builtin = false;    ///< Shipped with the OS: can be switched, not removed
+    bool enabled = false;    ///< On at this Klipper start
+    bool compatible = true;  ///< Plugin API new enough
+};
+
+/// One catalog plugin that is not installed.
+struct Ad5xCatalogPlugin {
+    std::string name;
+    std::string title;
+    std::string description;
+    bool compatible = true;
+};
+
+/// Installed plugins from the status object, sorted by name.
+std::vector<Ad5xInstalledPlugin> ad5x_installed_plugins(const json& status);
+
+/// Catalog plugins offered but not installed, sorted by name.
+std::vector<Ad5xCatalogPlugin> ad5x_catalog_plugins(const json& status);
+
+/// Catalog title for @p name, else @p name itself.
+std::string ad5x_plugin_title(const json& status, const std::string& name);
+
+/// What the status line says about the job.
+enum class Ad5xJobLine {
+    None = 0,    ///< Nothing to report: the line is hidden
+    Working = 1, ///< A job runs, or Klipper is not ready yet
+    Done = 2,    ///< The last job finished
+    Failed = 3,  ///< The last job failed
+};
+
+class Ad5xPluginsOverlay : public OverlayBase {
+  public:
+    ~Ad5xPluginsOverlay() override;
+
+    const char* get_name() const override {
+        return "AD5X Plugins";
+    }
+    const char* xml_component() const override {
+        return "settings_ad5x_plugins_overlay";
+    }
+    /// Freed on close; the next open rebuilds it.
+    bool destroy_on_close() const override {
+        return true;
+    }
+
+    void init_subjects() override;
+    void deinit_subjects();
+    void register_callbacks() override;
+    lv_obj_t* create(lv_obj_t* parent) override;
+
+    /// Subscribe, query the object, follow Klipper's restarts.
+    void on_activate() override;
+
+    /// Whether the printer publishes the `ad5x_plugins` object.
+    static bool available();
+
+    void handle_toggle(const std::string& name, bool on);
+    void handle_install(const std::string& name);
+    void handle_update(const std::string& name);
+    void handle_remove(const std::string& name);
+
+  protected:
+    void on_deactivating(DeactivateReason reason) override;
+    void on_ui_destroyed() override;
+
+  private:
+    void query_status();
+    void merge_status(const json& delta);
+    /// Status line, warnings and the busy flag from the cached object.
+    void refresh();
+    /// Rebuilds the rows when the plugin lists changed, or always with @p force.
+    void render_rows(bool force);
+    /// Sends @p gcode; @p restarts says Klipper restarts right after it.
+    void send(const std::string& gcode, bool restarts);
+    const Ad5xInstalledPlugin* installed(const std::string& name) const;
+
+    SubjectManager subjects_;
+    lv_subject_t status_subject_{};
+    lv_subject_t status_kind_subject_{};
+    lv_subject_t warnings_subject_{};
+    lv_subject_t has_warnings_subject_{};
+    lv_subject_t busy_subject_{};
+    lv_subject_t catalog_state_subject_{};
+    char status_buf_[256] = "";
+    char warnings_buf_[512] = "";
+
+    json status_ = json::object();
+    std::vector<Ad5xInstalledPlugin> installed_;
+    /// enabled + available + catalog as last rendered; rows rebuild when it changes
+    std::string rows_key_;
+    bool loaded_ = false;
+    bool klippy_ready_ = true;
+    bool command_in_flight_ = false;
+
+    SubscriptionGuard subscription_;
+    ObserverGuard klippy_observer_;
+};
+
+inline Ad5xPluginsOverlay& get_ad5x_plugins_overlay() {
+    return lazy_global<Ad5xPluginsOverlay>("Ad5xPluginsOverlay");
+}
+
+} // namespace helix::settings
