+
+#include <spdlog/fmt/fmt.h>
+#include <spdlog/spdlog.h>
+
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+
+namespace helix::settings {
+
+namespace {
+
+constexpr const char* kObject = "ad5x_plugins";
+
+/// Rows of a setting_group other than its header.
+void clear_group_rows(lv_obj_t* group) {
+    for (int32_t i = static_cast<int32_t>(lv_obj_get_child_count(group)) - 1; i >= 0; --i) {
+        lv_obj_t* child = lv_obj_get_child(group, i);
+        const char* name = lv_obj_get_name(child);
+        if (name && (std::strcmp(name, "setting_group_header") == 0 ||
+                     std::strcmp(name, "ad5x_catalog_all_installed") == 0)) {
+            continue;
+        }
+        helix::ui::safe_delete_deferred(child);
+    }
+}
+
+/// Plugin names are directory names ("zmod-compat"); anything else never
+/// reaches a G-code line.
+bool safe_plugin_name(const std::string& name) {
+    return !name.empty() && std::all_of(name.begin(), name.end(), [](unsigned char c) {
+        return std::isalnum(c) || c == '-' || c == '_' || c == '.';
+    });
+}
+
+/// The plugin name an event_cb was bound with (user_data="$plugin").
+std::string event_plugin(lv_event_t* e) {
+    const char* s = static_cast<const char*>(lv_event_get_user_data(e));
+    return s ? std::string(s) : std::string();
+}
+
+} // namespace
+
+// ============================================================================
+// STATUS OBJECT
+// ============================================================================
+
+std::string ad5x_plugin_title(const json& status, const std::string& name) {
+    if (const json* catalog = json_util::find_member(status, "catalog")) {
+        if (const json* entry = json_util::find_member(*catalog, name.c_str())) {
+            std::string title = json_util::safe_string(*entry, "title");
+            if (!title.empty()) {
+                return title;
+            }
+        }
+    }
+    return name;
+}
+
+std::vector<Ad5xInstalledPlugin> ad5x_installed_plugins(const json& status) {
+    std::vector<Ad5xInstalledPlugin> out;
+    const json* available = json_util::find_member(status, "available");
+    if (!available || !available->is_object()) {
+        return out;
+    }
+    std::vector<std::string> enabled;
+    if (const json* list = json_util::find_member(status, "enabled"); list && list->is_array()) {
+        for (const auto& item : *list) {
+            enabled.push_back(json_util::as_string(item));
+        }
+    }
+    for (auto it = available->begin(); it != available->end(); ++it) {
+        if (!it.value().is_object()) {
+            continue;
+        }
+        Ad5xInstalledPlugin p;
+        p.name = it.key();
+        p.title = ad5x_plugin_title(status, p.name);
+        p.description = json_util::safe_string(it.value(), "description");
+        p.version = json_util::safe_string(it.value(), "version");
+        p.builtin = json_util::safe_string(it.value(), "source") != "user";
+        p.compatible = json_util::safe_bool(it.value(), "compatible", true);
+        p.enabled = std::find(enabled.begin(), enabled.end(), p.name) != enabled.end();
+        out.push_back(std::move(p));
+    }
+    std::sort(
+        out.begin(), out.end(),
+        [](const Ad5xInstalledPlugin& a, const Ad5xInstalledPlugin& b) { return a.name < b.name; });
+    return out;
+}
+
+std::vector<Ad5xCatalogPlugin> ad5x_catalog_plugins(const json& status) {
+    std::vector<Ad5xCatalogPlugin> out;
+    const json* catalog = json_util::find_member(status, "catalog");
+    if (!catalog || !catalog->is_object()) {
+        return out;
+    }
+    const json* available = json_util::find_member(status, "available");
+    for (auto it = catalog->begin(); it != catalog->end(); ++it) {
+        // A shipped plugin of the same name counts as installed too
+        if (!it.value().is_object() || json_util::safe_bool(it.value(), "installed") ||
+            (available && json_util::find_member(*available, it.key().c_str()))) {
+            continue;
+        }
+        Ad5xCatalogPlugin p;
+        p.name = it.key();
+        p.title = json_util::safe_string(it.value(), "title", p.name);
+        p.description = json_util::safe_string(it.value(), "description");
+        p.compatible = json_util::safe_bool(it.value(), "compatible", true);
+        out.push_back(std::move(p));
+    }
+    std::sort(out.begin(), out.end(), [](const Ad5xCatalogPlugin& a, const Ad5xCatalogPlugin& b) {
+        return a.name < b.name;
+    });
+    return out;
+}
+
+// ============================================================================
+// LIFECYCLE
+// ============================================================================
+
+Ad5xPluginsOverlay::~Ad5xPluginsOverlay() {
+    deinit_subjects();
+}
+
+bool Ad5xPluginsOverlay::available() {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api) {
+        return false;
+    }
+    const auto& objects = api->hardware().printer_objects();
+    return std::find(objects.begin(), objects.end(), kObject) != objects.end();
+}
+
+void Ad5xPluginsOverlay::init_subjects() {
+    init_subjects_guarded([this]() {
+        UI_MANAGED_SUBJECT_STRING(status_subject_, status_buf_, "", "ad5x_plugins_status",
+                                  subjects_);
+        // Ad5xJobLine: hides the line, shows the spinner or colours a failure
+        UI_MANAGED_SUBJECT_INT(status_kind_subject_, 0, "ad5x_plugins_status_kind", subjects_);
+        UI_MANAGED_SUBJECT_STRING(warnings_subject_, warnings_buf_, "", "ad5x_plugins_warnings",
+                                  subjects_);
+        UI_MANAGED_SUBJECT_INT(has_warnings_subject_, 0, "ad5x_plugins_has_warnings", subjects_);
+        // 1 while a job or a command runs, or Klipper is not ready: every
+        // switch and button binds it (print_active is the other reason)
+        UI_MANAGED_SUBJECT_INT(busy_subject_, 1, "ad5x_plugins_busy", subjects_);
+        // 0 no catalog, 1 plugins to install, 2 all of them installed
+        UI_MANAGED_SUBJECT_INT(catalog_state_subject_, 0, "ad5x_plugins_catalog_state", subjects_);
+    });
+}
+
+void Ad5xPluginsOverlay::deinit_subjects() {
+    deinit_subjects_base(subjects_);
+}
+
+void Ad5xPluginsOverlay::register_callbacks() {
+    register_xml_callbacks({
+        {"on_ad5x_plugin_toggled",
+         [](lv_event_t* e) {
+             get_ad5x_plugins_overlay().handle_toggle(event_plugin(e), helix::ui::event_checked(e));
+         }},
+        {"on_ad5x_plugin_install",
+         [](lv_event_t* e) { get_ad5x_plugins_overlay().handle_install(event_plugin(e)); }},
+        {"on_ad5x_plugin_update",
+         [](lv_event_t* e) { get_ad5x_plugins_overlay().handle_update(event_plugin(e)); }},
+        {"on_ad5x_plugin_remove",
+         [](lv_event_t* e) { get_ad5x_plugins_overlay().handle_remove(event_plugin(e)); }},
+    });
+}
+
+lv_obj_t* Ad5xPluginsOverlay::create(lv_obj_t* parent) {
+    if (!OverlayBase::create(parent)) {
+        return nullptr;
+    }
+    rows_key_.clear();
+    render_rows(true);
+    return overlay_root_;
+}
+
+void Ad5xPluginsOverlay::on_ui_destroyed() {
+    rows_key_.clear();
+}
+
+void Ad5xPluginsOverlay::on_activate() {
+    OverlayBase::on_activate();
+
+    if (IMoonrakerAPI* api = get_moonraker_api()) {
+        const auto token = lifetime_.token();
+        // Runs on the WebSocket thread: copy the object out, apply it on the main thread.
+        const SubscriptionId id = api->subscribe_notifications([this, token](const json& note) {
+            const json* params = json_util::find_member(note, "params");
+            if (!params || !params->is_array() || params->empty()) {
+                return;
+            }
+            const json* obj = json_util::find_member((*params)[0], kObject);
+            if (!obj || !obj->is_object()) {
+                return;
+            }
+            json delta = *obj;
+            token.defer("Ad5xPluginsOverlay::status_update", [this, delta]() {
+                merge_status(delta);
+                refresh();
+                render_rows(false);
+            });
+        });
+        subscription_ = SubscriptionGuard(api, id);
+    }
+
+    // ENABLE/DISABLE/INSTALL/REMOVE restart Klipper: the object goes away
+    // and comes back with the new lists.
+    klippy_observer_ = ui::observe<int>(
+        get_printer_state().network_state().get_klippy_state_subject(), this,
+        [](Ad5xPluginsOverlay* self, int state) {
+            const bool ready = static_cast<KlippyState>(state) == KlippyState::READY;
+            if (!ready) {
+                // The rows stay (disabled) until the new object arrives
+                self->loaded_ = false;
+            } else if (!self->klippy_ready_) {
+                self->query_status();
+            }
+            self->klippy_ready_ = ready;
+            self->refresh();
+        },
+        get_printer_state().get_subjects_lifetime());
+
+    query_status();
+    refresh();
+}
+
+void Ad5xPluginsOverlay::on_deactivating(DeactivateReason /*reason*/) {
+    subscription_.reset();
+    klippy_observer_.reset();
+    command_in_flight_ = false;
+}
+
+// ============================================================================
+// STATUS
+// ============================================================================
+
+void Ad5xPluginsOverlay::query_status() {
+    IMoonrakerClient* client = get_moonraker_client();
+    if (!client || client->get_connection_state() != ConnectionState::CONNECTED) {
+        return;
+    }
+    const auto token = lifetime_.token();
+    json params = {{"objects", {{kObject, nullptr}}}};
+    client->send_jsonrpc(
+        "printer.objects.query", params,
+        [this, token](const json& response) {
+            const json* result = json_util::find_member(response, "result");
+            const json* status = result ? json_util::find_member(*result, "status") : nullptr;
+            const json* obj = status ? json_util::find_member(*status, kObject) : nullptr;
+            if (!obj || !obj->is_object()) {
+                return;
+            }
+            json full = *obj;
+            token.defer("Ad5xPluginsOverlay::status_query", [this, full]() {
+                status_ = full;
+                loaded_ = true;
+                refresh();
+                render_rows(false);
+            });
+        },
+        [](const MoonrakerError& err) {
+            spdlog::debug("[AD5X plugins] {} query failed: {}", kObject, err.message);
+        },
+        0, /*silent=*/true);
+}
+
+void Ad5xPluginsOverlay::merge_status(const json& delta) {
+    // Deltas only patch a full object; the query in flight brings one
+    if (!loaded_ || !status_.is_object()) {
+        return;
+    }
+    for (auto it = delta.begin(); it != delta.end(); ++it) {
+        status_[it.key()] = it.value();
+    }
+}
+
+void Ad5xPluginsOverlay::refresh() {
+    if (!subjects_initialized_) {
+        return;
+    }
+
+    std::string line;
+    Ad5xJobLine kind = Ad5xJobLine::None;
+    const json* job = json_util::find_member(status_, "job");
+    const std::string job_state = job ? json_util::safe_string(*job, "state") : "";
+    const bool job_running = job_state == "running";
+    if (!klippy_ready_ || !loaded_) {
+        line = lv_tr("Waiting for Klipper...");
+        kind = Ad5xJobLine::Working;
+    } else if (job && (job_running || job_state == "done" || job_state == "failed")) {
+        const std::string title = ad5x_plugin_title(status_, json_util::safe_string(*job, "name"));
+        const std::string action = json_util::safe_string(*job, "action");
+        if (job_running) {
+            if (action == "install") {
+                line = fmt::format(lv_tr("Installing {}..."), title);
+            } else if (action == "update") {
+                line = fmt::format(lv_tr("Updating {}..."), title);
+            } else {
+                line = fmt::format(lv_tr("Working on {}..."), title);
+            }
+            kind = Ad5xJobLine::Working;
+        } else {
+            // Klipper's own result text ("installed and enabled", "up to date (abc123)", ...)
+            line = fmt::format("{}: {}", title, json_util::safe_string(*job, "message"));
+            kind = job_state == "failed" ? Ad5xJobLine::Failed : Ad5xJobLine::Done;
+        }
+    }
+    lv_subject_copy_string(&status_subject_, line.c_str());
+    lv_subject_set_int(&status_kind_subject_, static_cast<int>(kind));
+
+    std::string warnings;
+    if (const json* list = json_util::find_member(status_, "warnings"); list && list->is_array()) {
+        for (const auto& w : *list) {
+            if (!warnings.empty()) {
+                warnings += '\n';
+            }
+            warnings += json_util::as_string(w);
+        }
+    }
+    lv_subject_copy_string(&warnings_subject_, warnings.c_str());
+    lv_subject_set_int(&has_warnings_subject_, warnings.empty() ? 0 : 1);
+
+    const bool busy = !klippy_ready_ || !loaded_ || job_running || command_in_flight_;
+    lv_subject_set_int(&busy_subject_, busy ? 1 : 0);
+}
+
+const Ad5xInstalledPlugin* Ad5xPluginsOverlay::installed(const std::string& name) const {
+    for (const auto& p : installed_) {
+        if (p.name == name) {
+            return &p;
+        }
+    }
+    return nullptr;
+}
+
+void Ad5xPluginsOverlay::render_rows(bool force) {
+    json lists = json::object();
+    for (const char* key : {"enabled", "available", "catalog"}) {
+        if (const json* v = json_util::find_member(status_, key)) {
+            lists[key] = *v;
+        }
+    }
+    const std::string key = json_util::safe_dump(lists);
+    installed_ = ad5x_installed_plugins(status_);
+    const std::vector<Ad5xCatalogPlugin> catalog = ad5x_catalog_plugins(status_);
+
+    if (subjects_initialized_) {
+        const json* raw_catalog = json_util::find_member(status_, "catalog");
+        const bool has_catalog = raw_catalog && raw_catalog->is_object() && !raw_catalog->empty();
+        lv_subject_set_int(&catalog_state_subject_, !has_catalog ? 0 : catalog.empty() ? 2 : 1);
+    }
+
+    // A rebuild inside the status deferral would also reset a switch the user
+    // is about to confirm; only a change of the lists themselves rebuilds.
+    if (!overlay_root_ || (!force && key == rows_key_)) {
+        return;
+    }
+    rows_key_ = key;
+
+    lv_obj_t* group = helix::ui::find_required(overlay_root_, "ad5x_plugins_installed", get_name());
+    if (group) {
+        clear_group_rows(group);
+        for (const auto& p : installed_) {
+            std::string details = p.version.empty() ? std::string() : "v" + p.version;
+            // Switching off stays possible for a plugin that is on
+            const bool blocked = !p.compatible && !p.enabled;
+            const char* attrs[] = {
+                "plugin",      p.name.c_str(),
+                "title",       p.title.c_str(),
+                "description", p.description.c_str(),
+                "details",     details.c_str(),
+                "builtin",     p.builtin ? lv_tr("Built-in") : "",
+                "checked",     p.enabled ? "true" : "false",
+                "blocked",     blocked ? "1" : "0",
+                "note",        p.compatible ? "" : lv_tr("Needs a newer Kiln OS"),
+                "manage",      p.builtin ? "" : "1",
+                nullptr};
+            if (!lv_xml_create(group, "ad5x_plugin_row", attrs)) {
+                spdlog::warn("[AD5X plugins] cannot create a row for {}", p.name);
+            }
+        }
+    }
+
+    group = helix::ui::find_required(overlay_root_, "ad5x_plugins_catalog", get_name());
+    if (group) {
+        clear_group_rows(group);
+        for (const auto& p : catalog) {
+            const char* attrs[] = {
+                "plugin",      p.name.c_str(),
+                "title",       p.title.c_str(),
+                "description", p.description.c_str(),
+                "blocked",     p.compatible ? "0" : "1",
+                "note",        p.compatible ? "" : lv_tr("Needs a newer Kiln OS"),
+                nullptr};
+            if (!lv_xml_create(group, "ad5x_catalog_row", attrs)) {
+                spdlog::warn("[AD5X plugins] cannot create a row for {}", p.name);
+            }
+        }
+    }
+}
+
+// ============================================================================
+// COMMANDS
+// ============================================================================
+
+void Ad5xPluginsOverlay::send(const std::string& gcode, bool restarts) {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api) {
+        render_rows(true);
+        return;
+    }
+    spdlog::info("[AD5X plugins] {}", gcode);
+    command_in_flight_ = true;
+    refresh();
+
+    const auto token = lifetime_.token();
+    const MacroHostEffect effect = restarts ? MacroHostEffect::Restarts : MacroHostEffect::None;
+    api->execute_gcode(
+        gcode,
+        [this, token, restarts]() {
+            if (restarts) {
+                helix::ui::begin_expected_klippy_restart("Firmware restarting...");
+            }
+            token.defer("Ad5xPluginsOverlay::command_done", [this]() {
+                command_in_flight_ = false;
+                query_status();
+                refresh();
+            });
+        },
+        [this, token, effect](const MoonrakerError& err) {
+            // Klipper restarting drops the reply: that is the command working
+            if (classify_macro_rpc_failure(effect, err) == MacroFailureReport::ExpectedRestart) {
+                helix::ui::begin_expected_klippy_restart("Firmware restarting...");
+                token.defer("Ad5xPluginsOverlay::command_restart", [this]() {
+                    command_in_flight_ = false;
+                    refresh();
+                });
+                return;
+            }
+            const std::string message = err.message;
+            helix::ui::queue_update("Ad5xPluginsOverlay::command_error",
+                                    [message]() { NOTIFY_WARNING("{}", message); });
+            token.defer("Ad5xPluginsOverlay::command_error", [this]() {
+                command_in_flight_ = false;
+                query_status();
+                refresh();
+                // Puts a switch the command did not change back
+                render_rows(true);
+            });
+        },
+        0, /*silent=*/false, /*on_queued=*/nullptr, /*caller_surfaces_errors=*/true);
+}
+
+void Ad5xPluginsOverlay::handle_toggle(const std::string& name, bool on) {
+    spdlog::debug("[AD5X plugins] {} switched {}", name, on ? "on" : "off");
+    const Ad5xInstalledPlugin* p = installed(name);
+    if (!p || p->enabled == on || !safe_plugin_name(name)) {
+        render_rows(true);
+        return;
+    }
+    const std::string title =
+        fmt::format(on ? lv_tr("Turn on {}?") : lv_tr("Turn off {}?"), p->title);
+    const std::string gcode =
+        fmt::format("{} NAME={}", on ? "ENABLE_PLUGIN" : "DISABLE_PLUGIN", name);
+    helix::ui::ConfirmOptions opts;
+    opts.owner_token = object_lifetime_.token();
+    // Cancelling puts the switch back
+    opts.on_cancel = [this]() { render_rows(true); };
+    opts.on_dismiss = [this]() { render_rows(true); };
+    helix::ui::modal_confirm(
+        title.c_str(), lv_tr("Klipper restarts to apply this. Continue?"), ModalSeverity::Warning,
+        on ? lv_tr("Turn On") : lv_tr("Turn Off"), [this, gcode]() { send(gcode, true); }, opts);
+}
+
+void Ad5xPluginsOverlay::handle_install(const std::string& name) {
+    if (!safe_plugin_name(name)) {
+        return;
+    }
+    const std::string title = fmt::format(lv_tr("Install {}?"), ad5x_plugin_title(status_, name));
+    const std::string gcode = fmt::format("INSTALL_PLUGIN NAME={} ENABLE=1", name);
+    helix::ui::ConfirmOptions opts;
+    opts.owner_token = object_lifetime_.token();
+    helix::ui::modal_confirm(
+        title.c_str(),
+        lv_tr("Downloads the plugin and turns it on. Klipper restarts when it is installed."),
+        ModalSeverity::Info, lv_tr("Install"), [this, gcode]() { send(gcode, false); }, opts);
+}
+
+void Ad5xPluginsOverlay::handle_update(const std::string& name) {
+    const Ad5xInstalledPlugin* p = installed(name);
+    if (!p || !safe_plugin_name(name)) {
+        return;
+    }
+    const std::string gcode = fmt::format("UPDATE_PLUGIN NAME={}", name);
+    if (!p->enabled) {
+        send(gcode, false);
+        return;
+    }
+    const std::string title = fmt::format(lv_tr("Update {}?"), p->title);
+    helix::ui::ConfirmOptions opts;
+    opts.owner_token = object_lifetime_.token();
+    helix::ui::modal_confirm(
+        title.c_str(), lv_tr("When there is a new version, Klipper restarts to load it."),
+        ModalSeverity::Info, lv_tr("Update"), [this, gcode]() { send(gcode, false); }, opts);
+}
+
+void Ad5xPluginsOverlay::handle_remove(const std::string& name) {
+    const Ad5xInstalledPlugin* p = installed(name);
+    if (!p || p->builtin || !safe_plugin_name(name)) {
+        return;
+    }
+    const bool restarts = p->enabled;
+    const std::string title = fmt::format(lv_tr("Remove {}?"), p->title);
+    const std::string gcode = fmt::format("REMOVE_PLUGIN NAME={}", name);
+    helix::ui::ConfirmOptions opts;
+    opts.owner_token = object_lifetime_.token();
+    helix::ui::modal_confirm(
+        title.c_str(),
+        restarts ? lv_tr("Turns the plugin off and deletes it from the printer. Klipper restarts.")
+                 : lv_tr("Deletes the plugin from the printer."),
+        ModalSeverity::Warning, lv_tr("Remove"),
+        [this, gcode, restarts]() { send(gcode, restarts); }, opts);
+}
+
+} // namespace helix::settings
diff --git a/tests/unit/test_settings_ad5x_plugins.cpp b/tests/unit/test_settings_ad5x_plugins.cpp
new file mode 100644
index 0000000000..976830a8e5
--- /dev/null
+++ b/tests/unit/test_settings_ad5x_plugins.cpp
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "ui_settings_ad5x_plugins.h"
+
+#include "../catch_amalgamated.hpp"
+#include "hv/json.hpp"
+
+using namespace helix::settings;
+
+namespace {
+
+/// The `ad5x_plugins` object as Klipper publishes it.
+json sample_status() {
+    return json::parse(R"({
+        "api_version": "1.4",
+        "enabled": ["zmod-compat", "notify"],
+        "available": {
+            "zmod-compat": {"source": "shipped", "description": "zMod macros",
+                            "version": "1.1.0", "compatible": true},
+            "notify": {"source": "user", "description": "Print notifications",
+                       "version": "0.3.0", "compatible": true},
+            "bambufy-compat": {"source": "shipped", "description": "", "version": "",
+                               "compatible": false}
+        },
+        "catalog": {
+            "notify": {"title": "Notifications", "description": "Telegram, ntfy, ...",
+                       "compatible": true, "installed": true},
+            "timelapse": {"title": "Timelapse", "description": "Videos of the print",
+                          "compatible": true, "installed": false},
+            "spoolman": {"title": "Spoolman", "description": "Spool tracking",
+                         "compatible": false, "installed": false}
+        },
+        "job": {"name": "", "action": "", "state": "idle", "message": ""},
+        "warnings": []
+    })");
+}
+
+} // namespace
+
+TEST_CASE("installed plugins are sorted, titled from the catalog and carry their state",
+          "[ad5x_plugins]") {
+    const auto rows = ad5x_installed_plugins(sample_status());
+    REQUIRE(rows.size() == 3);
+    CHECK(rows[0].name == "bambufy-compat");
+    CHECK(rows[1].name == "notify");
+    CHECK(rows[2].name == "zmod-compat");
+
+    CHECK(rows[0].title == "bambufy-compat");
+    CHECK_FALSE(rows[0].compatible);
+    CHECK_FALSE(rows[0].enabled);
+
+    CHECK(rows[1].title == "Notifications");
+    CHECK_FALSE(rows[1].builtin);
+    CHECK(rows[1].enabled);
+    CHECK(rows[1].version == "0.3.0");
+
+    CHECK(rows[2].builtin);
+    CHECK(rows[2].enabled);
+}
+
+TEST_CASE("the catalog section lists only plugins not installed", "[ad5x_plugins]") {
+    const auto rows = ad5x_catalog_plugins(sample_status());
+    REQUIRE(rows.size() == 2);
+    CHECK(rows[0].name == "spoolman");
+    CHECK_FALSE(rows[0].compatible);
+    CHECK(rows[1].name == "timelapse");
+    CHECK(rows[1].title == "Timelapse");
+    CHECK(rows[1].compatible);
+}
+
+TEST_CASE("a catalog entry shipped with the OS counts as installed", "[ad5x_plugins]") {
+    json status = sample_status();
+    status["available"]["timelapse"] = {{"source", "shipped"}, {"compatible", true}};
+    const auto rows = ad5x_catalog_plugins(status);
+    REQUIRE(rows.size() == 1);
+    CHECK(rows[0].name == "spoolman");
+}
+
+TEST_CASE("an object without lists yields no rows", "[ad5x_plugins]") {
+    const json status = json::parse(R"({"api_version": "1.3", "enabled": []})");
+    CHECK(ad5x_installed_plugins(status).empty());
+    CHECK(ad5x_catalog_plugins(status).empty());
+    CHECK(ad5x_plugin_title(status, "notify") == "notify");
+}
