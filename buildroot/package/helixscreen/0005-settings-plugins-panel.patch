+<?xml version="1.0"?>
+<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
+<!-- Settings > Plugins on the AD5X: the printer's Klipper plugins (ad5x_plugins object) -->
+<!-- Ad5xPluginsOverlay builds one row per plugin into the INSTALLED and AVAILABLE groups -->
+<component>
+  <styles>
+    <style name="pad_standard" pad_left="#space_lg" pad_right="#space_lg" pad_top="#space_md" pad_bottom="#space_md"/>
+    <style name="pad_micro" pad_left="#space_md" pad_right="#space_md" pad_top="#space_sm" pad_bottom="#space_sm"/>
+    <style name="text_failed" text_color="#danger"/>
+  </styles>
+  <view name="settings_ad5x_plugins_overlay" extends="overlay_panel" title="Plugins" bg_color="#screen_bg">
+    <!-- Content Area - no padding, rows handle their own -->
+    <lv_obj name="overlay_content"
+            width="100%" flex_grow="1" style_pad_top="0" style_pad_left="0" style_pad_right="0"
+            style_pad_bottom="#space_lg" scrollable="true" flex_flow="column">
+      <!-- Running job or last result, warnings, print lock; collapses when all are hidden -->
+      <setting_group name="ad5x_plugins_status_group">
+        <setting_group_header title="STATUS"/>
+        <lv_obj name="ad5x_plugins_status_row"
+                width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
+                style_bg_opa="0" style_border_width="0" scrollable="false">
+          <bind_style_if_eq name="pad_micro" subject="ui_breakpoint" ref_value="0"/>
+          <bind_style_if_ge name="pad_standard" subject="ui_breakpoint" ref_value="1"/>
+          <bind_flag_if_eq subject="ad5x_plugins_status_kind" flag="hidden" ref_value="0"/>
+          <spinner size="sm">
+            <bind_flag_if_not_eq subject="ad5x_plugins_status_kind" flag="hidden" ref_value="1"/>
+          </spinner>
+          <text_small name="ad5x_plugins_status" width="0" flex_grow="1" bind_text="ad5x_plugins_status" long_mode="wrap">
+            <bind_style_if_eq name="text_failed" subject="ad5x_plugins_status_kind" ref_value="3"/>
+          </text_small>
+        </lv_obj>
