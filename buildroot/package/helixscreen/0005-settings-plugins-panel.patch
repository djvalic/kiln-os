+<?xml version="1.0"?>
+<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
+<!-- One installed AD5X plugin in Settings > Plugins: title, description, version, -->
+<!-- Built-in tag and an on/off switch; Update and Remove for user-installed plugins. -->
+<!-- Created by Ad5xPluginsOverlay::render_rows(); every value is fixed at creation -->
+<!-- (the rows are rebuilt when the plugin lists change). -->
+<component>
+  <api>
+    <prop name="plugin" type="string" default=""/>
+    <prop name="title" type="string" default=""/>
+    <prop name="description" type="string" default=""/>
+    <prop name="details" type="string" default=""/>
+    <!-- Tag text for a plugin shipped with the OS, empty for user plugins -->
+    <prop name="builtin" type="string" default=""/>
+    <prop name="checked" type="string" default="false"/>
+    <!-- 1: the switch never works (plugin API too old), on top of print/busy -->
+    <prop name="blocked" type="string" default="0"/>
+    <prop name="note" type="string" default=""/>
+    <!-- Non-empty: show Update and Remove -->
+    <prop name="manage" type="string" default=""/>
+  </api>
+  <styles>
+    <style name="pad_standard"
+           pad_left="#space_lg" pad_right="#space_lg" pad_top="#space_md" pad_bottom="#space_md" pad_gap="#space_sm"/>
+    <style name="pad_micro"
+           pad_left="#space_md" pad_right="#space_md" pad_top="#space_sm" pad_bottom="#space_sm" pad_gap="#space_xs"/>
+  </styles>
+  <view name="ad5x_plugin_row"
+        extends="lv_obj" width="100%" height="content" flex_flow="column" style_bg_opa="0" style_border_width="0"
+        scrollable="false">
+    <bind_style_if_eq name="pad_micro" subject="ui_breakpoint" ref_value="0"/>
+    <bind_style_if_ge name="pad_standard" subject="ui_breakpoint" ref_value="1"/>
+    <lv_obj width="100%"
+            height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_md"
+            style_bg_opa="0" style_border_width="0" scrollable="false">
+      <icon src="puzzle_outline" size="sm" variant="secondary"/>
+      <lv_obj width="0"
+              height="content" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs"
+              style_bg_opa="0" style_border_width="0" scrollable="false">
+        <lv_obj width="100%"
+                height="content" style_pad_all="0" flex_flow="row_wrap" style_flex_cross_place="center"
+                style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0" scrollable="false">
+          <text_body name="title" text="$title"/>
+          <text_small name="details" text="$details" style_text_color="#text_muted" hidden_if_empty="$details"/>
+          <status_pill name="builtin" text="$builtin" variant="muted" hidden_if_empty="$builtin"/>
+        </lv_obj>
+        <text_small name="description"
+                    width="100%" text="$description" long_mode="wrap" style_text_color="#text_muted"
+                    hidden_if_empty="$description"/>
+        <text_small name="note"
+                    width="100%" text="$note" long_mode="wrap" style_text_color="#warning" hidden_if_empty="$note"/>
+      </lv_obj>
+      <ui_switch name="toggle" size="small" checked="$checked">
+        <bind_state_if cond="print_active or ad5x_plugins_busy or ${blocked}" state="disabled"/>
+        <event_cb trigger="value_changed" callback="on_ad5x_plugin_toggled" user_data="$plugin"/>
+      </ui_switch>
+    </lv_obj>
+    <!-- User plugins: Update and Remove, right-aligned under the switch -->
