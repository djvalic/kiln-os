+// Bed already hot from the last print, the slicer purges: no box purge, no
+// soak, the stock centre Z check instead of a mesh, a prime line.
+TEST_CASE_METHOD(Ad5xStartFixture, "kiln ad5x: no box purge, no soak, centre Z check, prime line",
+                 "[kiln][ad5x][print_start]") {
+    helix::sim::SimulatedClock::ManualScope clock(helix::sim::SimSpeed::of(1.0));
+    collector().set_macro_analysis(analyze(kKilnMacros));
+    heaters(600, 0, 400, 0);
+    start();
+
+    say("Homing");
+    clock.advance(std::chrono::seconds(12));
+    say("Heating bed and nozzle");
