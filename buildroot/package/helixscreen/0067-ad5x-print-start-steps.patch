+TEST_CASE("kiln ad5x profile: each Kiln text names its step", "[kiln][ad5x][print_start_profile]") {
+    using M = std::pair<P, std::string>;
+    // The console line ("echo: " from RESPOND) and the M117 alike.
+    for (const std::string prefix : {"echo: ", ""}) {
+        INFO(prefix);
+        CHECK(ad5x_match(prefix + "Homing") == M{P::HOMING, "Homing"});
+        CHECK(ad5x_match(prefix + "Heating bed and nozzle") ==
+              M{P::HEATING_BED, "Heating bed and nozzle"});
+        // The box purge runs while the soak's clock already runs and before the
+        // brushing: part of the heating, not the purge step.
+        CHECK(ad5x_match(prefix + "Purging at the box") == M{P::HEATING_BED, "Purging at the box"});
+        CHECK(ad5x_match(prefix + "Heat soak 3:09") == M{P::SOAKING, "Heat soak 3:09"});
+        CHECK(ad5x_match(prefix + "Heat soak 0:04") == M{P::SOAKING, "Heat soak 0:04"});
+        CHECK(ad5x_match(prefix + "Heat soak: waiting for Z to settle") ==
+              M{P::SOAKING, "Heat soak: waiting for Z to settle"});
+        CHECK(ad5x_match(prefix + "Checking Z") == M{P::CLEANING, "Checking Z"});
+        CHECK(ad5x_match(prefix + "Cleaning nozzle on the bed edge") ==
+              M{P::CLEANING, "Cleaning nozzle on the bed edge"});
+        CHECK(ad5x_match(prefix + "Bed mesh: print area") ==
+              M{P::BED_MESH, "Bed mesh: print area"});
+        CHECK(ad5x_match(prefix + "Bed mesh: whole bed") == M{P::BED_MESH, "Bed mesh: whole bed"});
+        CHECK(ad5x_match(prefix + "Heating to print temperature") ==
+              M{P::HEATING_NOZZLE, "Heating to print temperature"});
+        CHECK(ad5x_match(prefix + "Prime line") == M{P::PURGING, "Prime line"});
+        CHECK(ad5x_match(prefix + "Loading first colour") == M{P::PURGING, "Loading first colour"});
+    }
+
+    // Lines around the steps that name none.
+    for (const char* line : {
+             // the soak's length, announced while the nozzle still heats
+             "// Bed heat soak: 192 s (calibrated at 60 C)",
+             "// Bed heat soak: Z settled (at most 0.004 mm in 60 s)",
+             "echo: Slicer purges (ifs_purge_mode 0): no purge at the box",
+             "echo: _CHECK_Z: centre drift 0.012 mm (not applied, as stock)",
+             "// probe at 60.000,-3.000 is z=1.234567",
+             "!! Prime line skipped: the objects leave no room on the plate",
+             "echo: Purge box (trash bin) at X52.5 Y229 (offset 0, 0; RESET=1 for unit.cfg)",
+             "G28",
+             "M190 S60",
+             "M109 S220",
+             "BED_MESH_CALIBRATE ADAPTIVE=1",
+             "Homing axes",
+             "Heating bed",
+             "",
+             "echo: ",
+         }) {
+        INFO(line);
+        CHECK(ad5x_match(line).first == P::IDLE);
+    }
+}
