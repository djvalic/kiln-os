+void PrintStartProfile::parse_checklist(const json& block, const std::string& source_path) {
+    if (!block.is_object()) {
+        spdlog::warn("[PrintStartProfile] checklist must be an object in {} - ignored",
+                     source_path);
+        return;
+    }
+    // A listed phase is one a row can show: never IDLE, INITIALIZING or COMPLETE.
+    const auto listed_phase = [&](const json& name) -> std::optional<PrintStartPhase> {
+        std::optional<PrintStartPhase> phase;
+        if (name.is_string()) {
+            phase = helix::print_start_phase_from_name(
+                helix::text_io::to_upper(name.get<std::string>()));
+        }
+        if (!phase || *phase == PrintStartPhase::IDLE || *phase == PrintStartPhase::INITIALIZING ||
+            *phase == PrintStartPhase::COMPLETE) {
+            spdlog::warn("[PrintStartProfile] Ignoring checklist phase {} in {}", name.dump(),
+                         source_path);
+            return std::nullopt;
+        }
+        return phase;
+    };
+    const auto phase_list = [&](const char* key, std::vector<PrintStartPhase>& out) {
+        if (!block.contains(key)) {
+            return;
+        }
+        if (!block[key].is_array()) {
+            spdlog::warn("[PrintStartProfile] checklist {} must be an array in {}", key,
+                         source_path);
+            return;
+        }
+        for (const auto& name : block[key]) {
+            const auto phase = listed_phase(name);
+            if (phase && std::find(out.begin(), out.end(), *phase) == out.end()) {
+                out.push_back(*phase);
+            }
+        }
+    };
+    phase_list("steps", checklist_.steps);
+    phase_list("macro_steps", checklist_.macro_steps);
+    if (block.contains("labels") && block["labels"].is_object()) {
+        for (const auto& [name, label] : block["labels"].items()) {
+            const auto phase = listed_phase(json(name));
+            if (phase && label.is_string() && !label.get_ref<const std::string&>().empty()) {
+                checklist_.labels[static_cast<int>(*phase)] = label.get<std::string>();
+            }
+        }
+    }
+    if (block.contains("hide_overrun") && block["hide_overrun"].is_boolean()) {
+        checklist_.hide_overrun = block["hide_overrun"].get<bool>();
+    }
+}
