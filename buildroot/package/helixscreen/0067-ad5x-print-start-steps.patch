+int K(P p) {
+    return static_cast<int>(p);
+}
+
+/// What a row reads: the printer's words, else the label key, else the
+/// phase's own label (the keys, as the identity locale shows them).
+std::string row_label(const PreprintStepRow& row) {
+    if (!row.text.empty()) {
+        return row.text;
+    }
+    if (!row.label_key.empty()) {
+        return row.label_key;
+    }
+    return helix::print_start_phase_step_key(row.phase);
+}
+
+/// "+Homing 12" done, ">Heat soak 3:09" current, "-Bed mesh 60" upcoming;
+/// a time of -1 is left out.
+std::vector<std::string> describe(const std::vector<PreprintStepRow>& rows) {
+    std::vector<std::string> out;
+    for (const auto& row : rows) {
+        const char* mark = row.status == PreprintStepStatus::Done      ? "+"
+                           : row.status == PreprintStepStatus::Current ? ">"
+                                                                       : "-";
+        std::string s = mark + row_label(row);
+        if (row.seconds >= 0) {
+            s += " " + std::to_string(row.seconds);
+        }
+        out.push_back(s);
+    }
+    return out;
+}
