+// Cold printer, colour already loaded: box purge, a 3 min soak, mesh of the
+// print area, the first colour from the IFS.
+TEST_CASE_METHOD(Ad5xStartFixture, "kiln ad5x: box purge, soak, mesh, first colour",
+                 "[kiln][ad5x][print_start]") {
+    helix::sim::SimulatedClock::ManualScope clock(helix::sim::SimSpeed::of(1.0));
+    collector().set_macro_analysis(analyze(kKilnMacros));
+    heaters(250, 0, 260, 0);
+    start();
+
+    say("Homing");
+    CHECK(rows() == Rows{">Homing 12", "-Heating", "-Heat soak 120", "-Cleaning nozzle 30",
+                         "-Bed mesh 60", "-Heating nozzle", "-Purge 40"});
+    clock.advance(std::chrono::seconds(12));
+
+    say("Heating bed and nozzle");
+    heaters(260, 600, 300, 2200);
+    clock.advance(std::chrono::seconds(30));
+    // The nozzle heats faster: at its target while the bed is still short.
+    heaters(450, 600, 2200, 2200);
+    clock.advance(std::chrono::seconds(60));
+    // The bed arrives; the soak's clock starts, the nozzle wait follows.
+    heaters(595, 600, 2200, 2200);
+    console("// Bed heat soak: 192 s (calibrated at 60 C)");
+    CHECK(phase() == P::HEATING_BED);
+    CHECK(rows() == Rows{"+Homing 12", ">Heating bed and nozzle", "-Heat soak 120",
+                         "-Cleaning nozzle 30", "-Bed mesh 60", "-Heating nozzle", "-Purge 40"});
+
+    say("Purging at the box");
+    for (int i = 0; i < 5; ++i) {
+        collector().check_purge_shape(); // the box purge extrudes in place
+    }
+    CHECK(phase() == P::HEATING_BED);
+    CHECK(rows()[1] == ">Purging at the box");
+    clock.advance(std::chrono::seconds(20));
+    heaters(600, 600, 2150, 1800); // M104 S180 for the brushing
+    clock.advance(std::chrono::seconds(10));
+    heaters(600, 600, 1800, 1800);
+
+    say("Heat soak 2:42");
+    CHECK(rows() == Rows{"+Homing 12", "+Heating 120", ">Heat soak 2:42", "-Cleaning nozzle 30",
+                         "-Bed mesh 60", "-Heating nozzle", "-Purge 40"});
+    for (int left = 157; left > 0; left -= 5) {
+        clock.advance(std::chrono::seconds(5));
+        char text[32];
+        std::snprintf(text, sizeof(text), "Heat soak %d:%02d", left / 60, left % 60);
+        say(text);
+        tick();
+    }
+    // 160 s into a 120 s prediction: still running, so no time.
+    CHECK(rows()[2] == ">Heat soak 0:02");
+
+    say("Checking Z");
+    console(probe_at(60, -3));
+    clock.advance(std::chrono::seconds(4));
+    CHECK(rows() == Rows{"+Homing 12", "+Heating 120", "+Heat soak 160", ">Checking Z 26",
+                         "-Bed mesh 60", "-Heating nozzle", "-Purge 40"});
+    say("Cleaning nozzle on the bed edge");
+    heaters(600, 600, 1750, 1400); // M104 S140 while it scrubs
+    clock.advance(std::chrono::seconds(6));
+    CHECK(rows()[3] == ">Cleaning nozzle on the bed edge 20");
+
+    say("Bed mesh: print area");
+    console("// Adapted probe count: (4,4)");
+    for (int i = 0; i < 16; ++i) {
+        console(probe_at(80 + 10 * (i % 4), 80 + 10 * (i / 4)));
+        clock.advance(std::chrono::seconds(4));
+    }
+    CHECK(phase() == P::BED_MESH);
+    CHECK(rows() == Rows{"+Homing 12", "+Heating 120", "+Heat soak 160", "+Cleaning nozzle 10",
+                         ">Bed mesh: print area", "-Heating nozzle", "-Purge 40"});
+
+    say("Heating to print temperature");
+    heaters(585, 600, 1400, 2200);
+    clock.advance(std::chrono::seconds(40));
+    // The nozzle arrives with the bed a degree or two short: the bed wait.
+    heaters(585, 600, 2200, 2200);
+    clock.advance(std::chrono::seconds(10));
+    heaters(592, 600, 2200, 2200);
+    CHECK(phase() == P::HEATING_NOZZLE);
+    CHECK(rows() == Rows{"+Homing 12", "+Heating 120", "+Heat soak 160", "+Cleaning nozzle 10",
+                         "+Bed mesh 64", ">Heating to print temperature", "-Purge 40"});
+
+    say("Loading first colour");
+    clock.advance(std::chrono::seconds(15));
+    CHECK(rows() == Rows{"+Homing 12", "+Heating 120", "+Heat soak 160", "+Cleaning nozzle 10",
+                         "+Bed mesh 64", "+Heating nozzle 50", ">Loading first colour 25"});
+}
