+TEST_CASE_METHOD(Ad5xStartFixture, "kiln ad5x: the steps follow the AD5X order, not the macro's",
+                 "[kiln][ad5x][print_start]") {
+    const auto analysis = analyze(kKilnMacros);
+    REQUIRE(analysis.found);
+    collector().set_macro_analysis(analysis);
+    start();
+    {
+        // What upstream listed: the scan's order, Bed mesh first (BED_MESH_CLEAR).
+        std::vector<P> scanned;
+        for (const auto& op : analysis.operations) {
+            if (auto p = helix::phase_of_category(op.category);
+                p && std::find(scanned.begin(), scanned.end(), *p) == scanned.end()) {
+                scanned.push_back(*p);
+            }
+        }
+        CHECK(scanned == std::vector<P>{P::BED_MESH, P::HOMING, P::PURGING, P::CLEANING});
+    }
+    CHECK(rows() == Rows{"-Homing 12", "-Heating", "-Heat soak 120", "-Cleaning nozzle 30",
+                         "-Bed mesh 60", "-Heating nozzle", "-Purge 40"});
+}
