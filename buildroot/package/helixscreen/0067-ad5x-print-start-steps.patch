 }
 
+/// Kiln OS (AD5X): the printer's words carry their own countdown ("Heat soak
+/// 1:41"), a digit, a colon and two digits.
+bool has_own_time(const std::string& text) {
+    for (size_t i = 1; i + 2 < text.size(); ++i) {
+        const auto digit = [&text](size_t j) { return text[j] >= '0' && text[j] <= '9'; };
+        if (text[i] == ':' && digit(i - 1) && digit(i + 1) && digit(i + 2)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+std::string label_key_of(const PreprintChecklistInput& in, PrintStartPhase p) {
+    auto it = in.label_keys.find(static_cast<int>(p));
+    return it == in.label_keys.end() ? std::string() : it->second;
+}
+
+/// Index in expected_order of the step the sequence has reached: the current
+/// one, else the last done one listed; -1 for none.
+int reached_index(const PreprintChecklistInput& in) {
+    const auto index_of = [&in](PrintStartPhase p) {
+        auto it = std::find(in.expected_order.begin(), in.expected_order.end(), p);
+        return it == in.expected_order.end() ? -1
+                                             : static_cast<int>(it - in.expected_order.begin());
+    };
+    if (is_listed_phase(in.current)) {
+        if (const int i = index_of(in.current); i >= 0) {
+            return i;
+        }
+    }
+    for (auto it = in.done_in_order.rbegin(); it != in.done_in_order.rend(); ++it) {
+        if (const int i = index_of(*it); i >= 0) {
+            return i;
+        }
+    }
+    return -1;
+}
+
 } // namespace
 
