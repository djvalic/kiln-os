+// Every message and label the profile shows is translated: a key in each
+// catalog the build makes the language packs from.
+TEST_CASE("kiln ad5x profile: its messages and labels are in every catalog",
+          "[kiln][ad5x][print_start_profile][i18n]") {
+    std::ifstream f(helix::find_readable("print_start_profiles/ad5x.json"));
+    REQUIRE(f.good());
+    const json j = json::parse(f);
+    std::set<std::string> keys;
+    for (const auto& rp : j.at("response_patterns")) {
+        keys.insert(rp.at("message").get<std::string>());
+    }
+    for (const auto& [phase, label] : j.at("checklist").at("labels").items()) {
+        keys.insert(label.get<std::string>());
+    }
+    REQUIRE(keys.count("Heating") == 1);
+
+    int catalogs = 0;
+    for (const auto& entry :
+         std::filesystem::directory_iterator(helix::asset_path("translations"))) {
+        if (entry.path().extension() != ".yml") {
+            continue;
+        }
+        ++catalogs;
+        std::ifstream in(entry.path());
+        const std::string yml((std::istreambuf_iterator<char>(in)),
+                              std::istreambuf_iterator<char>());
+        for (const auto& key : keys) {
+            INFO(entry.path().filename().string() << ": " << key);
+            CHECK((yml.find("\n  " + key + ": ") != std::string::npos ||
+                   yml.find("\n  '" + key + "': ") != std::string::npos));
+        }
+    }
+    CHECK(catalogs >= 11); // de en es fr it ja ko pt ru tr zh
+}
