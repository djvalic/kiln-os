+helix::PrintStartAnalysis analyze(const std::string& printer_cfg) {
+    helix::PrintStartAnalysis out;
+    helix::PrintStartAnalyzer analyzer;
+    analyzer.analyze({{"printer.cfg", printer_cfg}},
+                     [&out](const helix::PrintStartAnalysis& a) { out = a; });
+    return out;
+}
