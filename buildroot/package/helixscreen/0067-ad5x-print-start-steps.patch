+                in.expected_order.push_back(p);
+            }
+        }
+        in.expected_is_sequence = true;
     } else {
         in.expected_order = macro_expected_phases_;
     }
+    if (own) {
+        in.hide_overrun = own->hide_overrun;
+        in.label_keys = own->labels;
+    }
+    in.current_text = step_text_;
     in.predicted_seconds = predictor_.predicted_phases();
     return in;
 }
