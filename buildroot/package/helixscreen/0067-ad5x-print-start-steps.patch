@@ -31,20 +69,36 @@ std::vector<PreprintStepRow> build_preprint_checklist(const PreprintChecklistInp
     for (PrintStartPhase p : in.done_in_order) {
         if (!is_listed_phase(p) || contains(rows, p))
             continue;
-        rows.push_back(
-            {p, PreprintStepStatus::Done, std::max(0, lookup_seconds(in.actual_seconds, p))});
+        rows.push_back({p, PreprintStepStatus::Done,
+                        std::max(0, lookup_seconds(in.actual_seconds, p)), label_key_of(in, p)});
     }
 
     if (is_listed_phase(in.current) && !contains(rows, in.current)) {
         int predicted = lookup_seconds(in.predicted_seconds, in.current);
         int left = predicted < 0 ? -1 : std::max(0, predicted - in.current_elapsed_seconds);
-        rows.push_back({in.current, PreprintStepStatus::Current, left});
+        // Kiln OS (AD5X): a step past its prediction is still running, so it
+        // shows no time rather than a countdown stuck at 0s.
+        if (in.hide_overrun && predicted >= 0 && predicted <= in.current_elapsed_seconds) {
+            left = -1;
+        }
+        // Kiln OS (AD5X): the printer's own countdown in the label is the real
+        // time left; a guess from past prints next to it would disagree.
+        if (in.hide_overrun && has_own_time(in.current_text)) {
+            left = -1;
+        }
+        rows.push_back({in.current, PreprintStepStatus::Current, left, label_key_of(in, in.current),
+                        in.current_text});
     }
 
-    for (PrintStartPhase p : in.expected_order) {
+    const int reached = in.expected_is_sequence ? reached_index(in) : -1;
+    for (size_t i = 0; i < in.expected_order.size(); ++i) {
+        const PrintStartPhase p = in.expected_order[i];
         if (!is_listed_phase(p) || contains(rows, p))
             continue;
-        rows.push_back({p, PreprintStepStatus::Upcoming, lookup_seconds(in.predicted_seconds, p)});
+        if (static_cast<int>(i) <= reached)
+            continue; // passed over: the printer's sequence went on without it
+        rows.push_back({p, PreprintStepStatus::Upcoming, lookup_seconds(in.predicted_seconds, p),
+                        label_key_of(in, p)});
     }
 
     // Drop the oldest done rows first; the current row and upcoming rows stay.
