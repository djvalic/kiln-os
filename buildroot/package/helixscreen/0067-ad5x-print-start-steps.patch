+    // heating step, no nozzle row of its own.
+    heaters(600, 600, 500, 2200);
+    clock.advance(std::chrono::seconds(30));
+    heaters(600, 600, 1900, 2200);
+    CHECK(phase() == P::HEATING_BED);
+    CHECK(rows() == Rows{"+Homing 12", ">Heating bed and nozzle", "-Heat soak 120",
+                         "-Cleaning nozzle 30", "-Bed mesh 60", "-Heating nozzle", "-Purge 40"});
+    clock.advance(std::chrono::seconds(10));
+    heaters(600, 600, 2200, 2200);
+    console("echo: Slicer purges (ifs_purge_mode 0): no purge at the box");
+    clock.advance(std::chrono::seconds(20)); // the brushing
+    heaters(600, 600, 1800, 1800);
+
+    // No soak: the Z check follows, and the soak's row goes.
+    say("Checking Z");
+    console(probe_at(60, -3));
+    CHECK(rows() == Rows{"+Homing 12", "+Heating 60", ">Checking Z 30", "-Bed mesh 60",
+                         "-Heating nozzle", "-Purge 40"});
+    clock.advance(std::chrono::seconds(4));
+    say("Cleaning nozzle on the bed edge");
+    clock.advance(std::chrono::seconds(6));
+    say("Checking Z"); // the centre check, no mesh
+    console(probe_at(107.5, 107.5));
+    clock.advance(std::chrono::seconds(5));
+    CHECK(phase() == P::CLEANING);
+    CHECK(rows() == Rows{"+Homing 12", "+Heating 60", ">Checking Z 15", "-Bed mesh 60",
+                         "-Heating nozzle", "-Purge 40"});
+
+    // Heating for the print: the mesh's row goes.
+    say("Heating to print temperature");
+    heaters(600, 600, 1400, 2200);
+    clock.advance(std::chrono::seconds(45));
+    heaters(600, 600, 2200, 2200);
+    CHECK(rows() == Rows{"+Homing 12", "+Heating 60", "+Cleaning nozzle 15",
+                         ">Heating to print temperature", "-Purge 40"});
+
+    say("Prime line");
+    clock.advance(std::chrono::seconds(50)); // past its 40 s
+    CHECK(rows() == Rows{"+Homing 12", "+Heating 60", "+Cleaning nozzle 15", "+Heating nozzle 45",
+                         ">Prime line"});
+}
