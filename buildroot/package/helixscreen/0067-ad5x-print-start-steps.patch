+    }
+
+    void drain() {
+        helix::ui::UpdateQueueTestAccess::drain(helix::ui::UpdateQueue::instance());
+    }
+
+    /// Start a run with a history: homing 12 s, soak 120 s, edge clean and
+    /// Z check 30 s, mesh 60 s, first colour 40 s (heating has no history).
+    void start() {
+        collector_->start();
+        collector_->enable_fallbacks();
+        helix::PreprintEntry e;
+        e.total_seconds = 500;
+        e.timestamp = 1000;
+        e.temp_bucket = 1;
+        e.phase_durations = {{K(P::HOMING), 12},
+                             {K(P::SOAKING), 120},
+                             {K(P::CLEANING), 30},
+                             {K(P::BED_MESH), 60},
+                             {K(P::PURGING), 40}};
+        PrintStartCollectorTestAccess::load_prediction_entries(*collector_, {e});
+        drain();
+    }
+
+    void console(const std::string& line) {
+        json msg = {{"method", "notify_gcode_response"}, {"params", {line}}};
+        client_->dispatch_method_callback("notify_gcode_response", msg);
+        drain();
+    }
+
+    void status(const json& object) {
+        client_->dispatch_status_update(object);
+        drain();
+    }
+
+    /// _PRINT_STATUS MSG=text: the console line, then the M117.
+    void say(const std::string& text) {
+        console("echo: " + text);
+        status({{"display_status", {{"message", text}}}});
+    }
+
+    /// Heaters in decidegrees, in the subjects the fallback tick reads and as
+    /// a status frame; then one fallback tick.
+    void heaters(int bed, int bed_target, int nozzle, int nozzle_target) {
+        auto& t = state_.temperature_state();
+        lv_subject_set_int(t.get_bed_temp_subject(), bed);
+        lv_subject_set_int(t.get_bed_target_subject(), bed_target);
+        lv_subject_set_int(t.get_active_extruder_temp_subject(), nozzle);
+        lv_subject_set_int(t.get_active_extruder_target_subject(), nozzle_target);
+        status({{"heater_bed", {{"temperature", bed / 10.0}, {"target", bed_target / 10.0}}},
+                {"extruder", {{"temperature", nozzle / 10.0}, {"target", nozzle_target / 10.0}}}});
+        tick();
+    }
+
+    void tick() {
+        collector_->check_fallback_completion();
+        drain();
+        drain();
+    }
+
+    PrintStartPhase phase() {
+        return static_cast<PrintStartPhase>(
+            lv_subject_get_int(state_.print_state().get_print_start_phase_subject()));
+    }
+
+    Rows rows() {
+        return describe(helix::build_preprint_checklist(collector_->checklist_input()));
+    }
+
+  protected:
+    PrinterState state_;
+    std::unique_ptr<MoonrakerClientMock> client_;
+    std::shared_ptr<PrintStartCollector> collector_;
+};
