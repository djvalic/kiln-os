+std::shared_ptr<PrintStartProfile> ad5x_profile() {
+    auto profile = PrintStartProfile::load("ad5x");
+    REQUIRE_FALSE(profile->is_default());
+    return profile;
+}
+
+/// The phase and the printer's words a line maps to; IDLE when none.
+std::pair<P, std::string> ad5x_match(const std::string& line) {
+    static const auto profile = ad5x_profile();
+    PrintStartProfile::MatchResult result;
+    if (!profile->try_match_pattern(line, result)) {
+        return {P::IDLE, ""};
+    }
+    return {result.phase, result.label};
+}
