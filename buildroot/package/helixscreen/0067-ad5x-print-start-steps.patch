+TEST_CASE("kiln ad5x checklist: a sequence drops the steps passed over",
+          "[kiln][ad5x][preprint_checklist]") {
+    PreprintChecklistInput in;
+    in.expected_order = {P::HOMING,   P::HEATING_BED,    P::SOAKING, P::CLEANING,
+                         P::BED_MESH, P::HEATING_NOZZLE, P::PURGING};
+    in.expected_is_sequence = true;
+    in.done_in_order = {P::HOMING, P::HEATING_BED};
+    in.current = P::CLEANING; // no soak: the bed was hot
+    auto rows = build_preprint_checklist(in);
+    CHECK(describe(rows) == Rows{"+Homing 0", "+Heating bed 0", ">Cleaning nozzle", "-Bed mesh",
+                                 "-Heating nozzle", "-Purge"});
+
+    // No current step listed (the print start only just began): the last done
+    // one is where the sequence stands.
+    in.current = P::INITIALIZING;
+    rows = build_preprint_checklist(in);
+    CHECK(describe(rows) == Rows{"+Homing 0", "+Heating bed 0", "-Heat soak", "-Cleaning nozzle",
+                                 "-Bed mesh", "-Heating nozzle", "-Purge"});
+
+    // Upstream: every expected step not shown yet is upcoming.
+    in.expected_is_sequence = false;
+    in.current = P::CLEANING;
+    rows = build_preprint_checklist(in);
+    CHECK(describe(rows) == Rows{"+Homing 0", "+Heating bed 0", ">Cleaning nozzle", "-Heat soak",
+                                 "-Bed mesh", "-Heating nozzle", "-Purge"});
+}
