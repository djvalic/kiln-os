+/// Kiln's PRINT_START as the macro scan reads it, abridged to the lines that
+/// call commands (the Jinja conditions stay): it clears the mesh before it
+/// homes and purges at the box before the edge clean, so the scan finds Bed
+/// mesh, Homing, Purge, Cleaning in that order.
+const char* kKilnMacros = R"cfg([gcode_macro PRINT_START]
+gcode:
+  CLEAR_PAUSE
+  M104 S0
+  M140 S0
+  BED_MESH_CLEAR
+  _PRINT_STATUS MSG="Homing"
+  G28
+  _PURGE_BOX
+  _PRINT_STATUS MSG="Heating bed and nozzle"
+  M140 S{bed}
+  M104 S{nozzle}
+  _PRINT_START_WAIT HEATER=heater_bed MINIMUM={bed - 1}
+  BED_SOAK_START BED={bed}
+  _PRINT_START_WAIT HEATER=extruder
+  {% if not skip_box %}
+    _PRINT_STATUS MSG="Purging at the box"
+    G1 E90 F300
+    _PURGE_WIPE
+  {% endif %}
+  M104 S180
+  _NOZZLE_BRUSH
+  _NOZZLE_BRUSH
+  BED_SOAK_WAIT
+  _CHECK_Z MESH={level} ADAPTIVE={adaptive}
+  _PRINT_STATUS MSG="Heating to print temperature"
+  M104 S{nozzle}
+  _PRINT_START_WAIT HEATER=extruder
+  {% if ifs_load %}
+    _PRINT_STATUS MSG="Loading first colour"
+    _PRINT_START_TOOL CHANNEL={chan}
+  {% else %}
+    _PRIME_LINE
+  {% endif %}
+  _PRINT_STATUS
+
+[gcode_macro _PRINT_STATUS]
+gcode:
+  M117 {params.MSG}
+  RESPOND MSG="{params.MSG}"
+
+[gcode_macro _PRINT_START_WAIT]
+gcode:
+  TEMPERATURE_WAIT SENSOR={params.HEATER}
+
+[gcode_macro _CHECK_Z]
+gcode:
+  _PRINT_STATUS MSG="Checking Z"
+  PROBE
+  _CHECK_Z_SCRUB MESH={params.MESH} ADAPTIVE={params.ADAPTIVE}
+
+[gcode_macro _CHECK_Z_SCRUB]
+gcode:
+  _PRINT_STATUS MSG="Cleaning nozzle on the bed edge"
+  {% if params.MESH|int %}
+    _PRINT_STATUS MSG="Bed mesh: print area"
+    BED_MESH_CALIBRATE ADAPTIVE=1
+  {% else %}
+    _PRINT_STATUS MSG="Checking Z"
+    PROBE
+  {% endif %}
+)cfg";
