--- /dev/null
+++ b/src/ui/ui_settings_ad5x_refill.cpp
@@ -0,0 +1,706 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "ui_settings_ad5x_refill.h"
+
+#include "ui_callback_helpers.h"
+#include "ui_error_reporting.h"
+#include "ui_panel_ams_overview.h"
+#include "ui_swatch.h"
+#include "ui_update_queue.h"
+#include "ui_utils.h"
+
+#include "ams_state.h"
+#include "app_globals.h"
+#include "color_utils.h"
+#include "i_moonraker_api.h"
+#include "i_moonraker_client.h"
+#include "json_utils.h"
+#include "lvgl/src/others/translation/lv_translation.h"
+#include "observer_factory.h"
+#include "printer_discovery.h"
+#include "printer_state.h"
+#include "theme_manager.h"
+#include "ui/ui_widget_helpers.h"
+
+#include <spdlog/fmt/fmt.h>
+#include <spdlog/spdlog.h>
+
+#include <algorithm>
+#include <cctype>
+#include <cstdlib>
+#include <cstring>
+
+namespace helix::ad5x_refill {
+
+namespace {
+
+constexpr const char* kObject = "ifs";
+constexpr const char* kMaterialsObject = "ifs_materials";
+/// The `ifs` fields this uses; the object has many more, updated often.
+constexpr const char* kFields[] = {"auto_refill", "refill_match", "refill_backups", "refill_notice",
+                                   "loaded_channels"};
+constexpr const char* kMatchNames[] = {"exact", "similar", "any"};
+constexpr int kSlotCount = 4;
+
+void copy_if_changed(lv_subject_t* subject, const std::string& text) {
+    const char* cur = lv_subject_get_string(subject);
+    if (!cur || text != cur) {
+        lv_subject_copy_string(subject, text.c_str());
+    }
+}
+
+void set_if_changed(lv_subject_t* subject, int value) {
+    if (lv_subject_get_int(subject) != value) {
+        lv_subject_set_int(subject, value);
+    }
+}
+
+/// The fields of `ifs` this uses, out of a delta or a whole object.
+json pick_ifs_fields(const json& obj) {
+    json out = json::object();
+    for (const char* key : kFields) {
+        if (const json* v = json_util::find_member(obj, key)) {
+            out[key] = *v;
+        }
+    }
+    return out;
+}
+
+/// Slot number of a JSON key or value ("3" or 3); 0 when it is none.
+int slot_of(const json& v) {
+    int n = 0;
+    if (v.is_number_integer()) {
+        n = v.get<int>();
+    } else if (v.is_string()) {
+        const std::string& s = v.get_ref<const std::string&>();
+        char* end = nullptr;
+        const long l = std::strtol(s.c_str(), &end, 10);
+        n = (end != s.c_str() && *end == '\0') ? static_cast<int>(l) : 0;
+    }
+    return (n >= 1 && n <= kSlotCount) ? n : 0;
+}
+
+std::string lowercase(std::string s) {
+    std::transform(s.begin(), s.end(), s.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return s;
+}
+
+bool print_active() {
+    return lv_subject_get_int(get_printer_state().print_state().get_print_active_subject()) != 0;
+}
+
+} // namespace
+
+// ============================================================================
+// STATUS OBJECT
+// ============================================================================
+
+const char* match_name(int index) {
+    if (index < 0 || index >= static_cast<int>(std::size(kMatchNames))) {
+        return kMatchNames[static_cast<int>(Match::Similar)];
+    }
+    return kMatchNames[index];
+}
+
+int match_index(const std::string& name) {
+    const std::string n = lowercase(name);
+    for (int i = 0; i < static_cast<int>(std::size(kMatchNames)); ++i) {
+        if (n == kMatchNames[i]) {
+            return i;
+        }
+    }
+    return static_cast<int>(Match::Similar);
+}
+
+std::string enable_gcode(bool on) {
+    return fmt::format("IFS_AUTO_REFILL ENABLE={}", on ? 1 : 0);
+}
+
+std::string match_gcode(int index) {
+    return fmt::format("IFS_AUTO_REFILL MATCH={}", match_name(index));
+}
+
+std::vector<SlotBackup> parse_backups(const json& ifs, const json& materials) {
+    const json* backups = json_util::find_member(ifs, "refill_backups");
+    const json* loaded = json_util::find_member(ifs, "loaded_channels");
+    const json* mat_slots = json_util::find_member(materials, "slots");
+
+    std::vector<bool> present(kSlotCount + 1, false);
+    if (loaded && loaded->is_array()) {
+        for (const auto& v : *loaded) {
+            present[static_cast<std::size_t>(slot_of(v))] = true;
+        }
+    } else if (backups && backups->is_object()) {
+        // Without the presence list, the slots something would take over from
+        for (auto it = backups->begin(); it != backups->end(); ++it) {
+            if (it.value().is_array() && !it.value().empty()) {
+                present[static_cast<std::size_t>(slot_of(json(it.key())))] = true;
+            }
+        }
+    }
+
+    std::vector<SlotBackup> out;
+    for (int slot = 1; slot <= kSlotCount; ++slot) {
+        if (!present[static_cast<std::size_t>(slot)]) {
+            continue;
+        }
+        SlotBackup s;
+        s.slot = slot;
+        const std::string key = std::to_string(slot);
+        if (backups && backups->is_object()) {
+            const json* list = json_util::find_member(*backups, key.c_str());
+            if (list && list->is_array()) {
+                for (const auto& v : *list) {
+                    const int b = slot_of(v);
+                    if (b != 0 && b != slot) {
+                        s.backups.push_back(b);
+                    }
+                }
+            }
+        }
+        if (mat_slots && mat_slots->is_object()) {
+            const json* entry = json_util::find_member(*mat_slots, key.c_str());
+            if (entry && entry->is_object()) {
+                s.material = json_util::safe_string(*entry, "type");
+                if (s.material == "?") {
+                    s.material.clear();
+                }
+                const std::string color = json_util::safe_string(*entry, "color");
+                uint32_t rgb = 0;
+                if (!color.empty() && parse_hex_color(color.c_str(), rgb)) {
+                    s.rgb = rgb;
+                }
+            }
+        }
+        out.push_back(std::move(s));
+    }
+    return out;
+}
+
+std::string backup_line(const SlotBackup& slot) {
+    std::string what;
+    if (slot.material.empty()) {
+        what = lv_tr("material not set");
+    } else {
+        what = slot.material;
+        if (slot.rgb) {
+            what += " " + lowercase(describe_color(*slot.rgb));
+        }
+    }
+    std::string target;
+    if (slot.backups.empty()) {
+        target = lv_tr("no backup");
+    } else if (slot.backups.size() == 1) {
+        target = fmt::format(fmt::runtime(lv_tr("Slot {}")), slot.backups.front());
+    } else {
+        std::string list;
+        for (int b : slot.backups) {
+            if (!list.empty()) {
+                list += ", ";
+            }
+            list += std::to_string(b);
+        }
+        target = fmt::format(fmt::runtime(lv_tr("Slots {}")), list);
+    }
+    return fmt::format(fmt::runtime(lv_tr("Slot {} · {} → {}")), slot.slot, what, target);
+}
+
+bool any_backup(const std::vector<SlotBackup>& slots) {
+    return std::any_of(slots.begin(), slots.end(),
+                       [](const SlotBackup& s) { return !s.backups.empty(); });
+}
+
+std::string summary_text(bool enabled, int match, const std::vector<SlotBackup>& slots) {
+    if (!enabled) {
+        return lv_tr("Off");
+    }
+    const char* match_label = match == static_cast<int>(Match::Exact) ? lv_tr("Exact colour")
+                              : match == static_cast<int>(Match::Any) ? lv_tr("Any colour")
+                                                                      : lv_tr("Similar colour");
+    std::string covered;
+    for (const auto& s : slots) {
+        if (s.backups.empty()) {
+            continue;
+        }
+        if (!covered.empty()) {
+            covered += ", ";
+        }
+        covered += std::to_string(s.slot);
+    }
+    if (covered.empty()) {
+        return fmt::format("{} · {} · {}", lv_tr("On"), match_label, lv_tr("no backup spools"));
+    }
+    return fmt::format("{} · {} · {}", lv_tr("On"), match_label,
+                       fmt::format(fmt::runtime(lv_tr("backups for slot {}")), covered));
+}
+
+std::string notice_body(const std::string& notice) {
+    return fmt::format("{}\n\n{}", notice,
+                       lv_tr("To add one, put the same filament in a free slot and set its "
+                             "material and colour; it is fed in when it's needed."));
+}
+
+bool available() {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api) {
+        return false;
+    }
+    const auto& objects = api->hardware().printer_objects();
+    return std::find(objects.begin(), objects.end(), kObject) != objects.end();
+}
+
+void open_filament_slots() {
+    if (!AmsState::instance().get_backend()) {
+        NOTIFY_WARNING("{}", lv_tr("The filament slots aren't available yet"));
+        return;
+    }
+    navigate_to_ams_panel();
+}
+
+// ============================================================================
+// MODEL
+// ============================================================================
+
+Ad5xRefillModel::~Ad5xRefillModel() {
+    lifetime_.invalidate();
+    subscription_.reset();
+    klippy_observer_.reset();
+    print_observer_.reset();
+    subjects_.deinit_all();
+}
+
+void Ad5xRefillModel::init_subjects() {
+    if (subjects_initialized_) {
+        return;
+    }
+    // "On · Similar colour · backups for slot 1, 3" for the Settings row, empty until loaded
+    UI_MANAGED_SUBJECT_STRING(summary_, summary_buf_, "", "ad5x_refill_summary", subjects_);
+    UI_MANAGED_SUBJECT_INT(enabled_, 0, "ad5x_refill_enabled", subjects_);
+    // Match: 0 exact, 1 similar, 2 any
+    UI_MANAGED_SUBJECT_INT(match_, 1, "ad5x_refill_match", subjects_);
+    // 1 while a change is pending, the object has not answered or Klipper is not ready
+    UI_MANAGED_SUBJECT_INT(busy_, 1, "ad5x_refill_busy", subjects_);
+    // 1 when some slot has a backup: hides the "No backups" hint
+    UI_MANAGED_SUBJECT_INT(has_backups_, 0, "ad5x_refill_has_backups", subjects_);
+    subjects_initialized_ = true;
+}
+
+void Ad5xRefillModel::attach(IMoonrakerAPI* api, const json& status) {
+    init_subjects();
+    if (!api) {
+        return;
+    }
+    const auto& objects = api->hardware().printer_objects();
+    if (std::find(objects.begin(), objects.end(), kObject) == objects.end()) {
+        // Another printer, or Klipper without the IFS
+        detach();
+        return;
+    }
+
+    if (api != api_) {
+        detach();
+        api_ = api;
+        const auto token = lifetime_.token();
+        // Runs on the WebSocket thread: copy the fields out, apply them on the main thread.
+        // Most `ifs` updates are the IFS's sensors and motors; only ours are deferred.
+        const SubscriptionId id = api->subscribe_notifications([this, token](const json& note) {
+            const json* params = json_util::find_member(note, "params");
+            if (!params || !params->is_array() || params->empty()) {
+                return;
+            }
+            const json& status_obj = (*params)[0];
+            json ifs_delta = json::object();
+            json materials_delta = json::object();
+            if (const json* obj = json_util::find_member(status_obj, kObject);
+                obj && obj->is_object()) {
+                ifs_delta = pick_ifs_fields(*obj);
+            }
+            if (const json* obj = json_util::find_member(status_obj, kMaterialsObject);
+                obj && obj->is_object()) {
+                if (const json* slots = json_util::find_member(*obj, "slots")) {
+                    materials_delta["slots"] = *slots;
+                }
+            }
+            if (ifs_delta.empty() && materials_delta.empty()) {
+                return;
+            }
+            token.defer("Ad5xRefillModel::status_update", [this, ifs_delta, materials_delta]() {
+                merge(ifs_delta, materials_delta);
+            });
+        });
+        subscription_ = SubscriptionGuard(api, id);
+    }
+
+    if (!klippy_observer_) {
+        klippy_observer_ = ui::observe<int>(
+            get_printer_state().network_state().get_klippy_state_subject(), this,
+            [](Ad5xRefillModel* self, int state) {
+                const bool ready = static_cast<KlippyState>(state) == KlippyState::READY;
+                if (ready == self->klippy_ready_) {
+                    return;
+                }
+                self->klippy_ready_ = ready;
+                if (ready) {
+                    self->query();
+                }
+                self->refresh();
+            },
+            get_printer_state().get_subjects_lifetime());
+    }
+    if (!print_observer_) {
+        // A notice that came before the print state did shows once it runs
+        print_observer_ = ui::observe<int>(
+            get_printer_state().print_state().get_print_active_subject(), this,
+            [](Ad5xRefillModel* self, int active) {
+                if (active != 0) {
+                    self->check_notice();
+                }
+            },
+            get_printer_state().get_subjects_lifetime());
+    }
+
+    // The discovery's initial status carries both objects whole
+    json ifs_delta = json::object();
+    json materials_delta = json::object();
+    if (const json* obj = json_util::find_member(status, kObject); obj && obj->is_object()) {
+        ifs_delta = pick_ifs_fields(*obj);
+    }
+    if (const json* obj = json_util::find_member(status, kMaterialsObject);
+        obj && obj->is_object()) {
+        if (const json* slots = json_util::find_member(*obj, "slots")) {
+            materials_delta["slots"] = *slots;
+        }
+    }
+    if (!ifs_delta.empty() || !materials_delta.empty()) {
+        merge(ifs_delta, materials_delta);
+    } else {
+        query();
+    }
+}
+
+void Ad5xRefillModel::detach() {
+    subscription_.reset();
+    api_ = nullptr;
+    ifs_ = json::object();
+    materials_ = json::object();
+    loaded_ = false;
+    pending_ = 0;
+    refresh();
+}
+
+void Ad5xRefillModel::start() {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (api && api != api_) {
+        attach(api, json::object());
+        return;
+    }
+    query();
+}
+
+void Ad5xRefillModel::query() {
+    IMoonrakerClient* client = get_moonraker_client();
+    if (!client || client->get_connection_state() != ConnectionState::CONNECTED || !api_) {
+        return;
+    }
+    const auto token = lifetime_.token();
+    json fields = json::array();
+    for (const char* key : kFields) {
+        fields.push_back(key);
+    }
+    json params = {{"objects", {{kObject, fields}, {kMaterialsObject, json::array({"slots"})}}}};
+    client->send_jsonrpc(
+        "printer.objects.query", params,
+        [this, token](const json& response) {
+            const json* result = json_util::find_member(response, "result");
+            const json* status = result ? json_util::find_member(*result, "status") : nullptr;
+            if (!status || !status->is_object()) {
+                return;
+            }
+            json ifs_delta = json::object();
+            json materials_delta = json::object();
+            if (const json* obj = json_util::find_member(*status, kObject);
+                obj && obj->is_object()) {
+                ifs_delta = pick_ifs_fields(*obj);
+            }
+            if (const json* obj = json_util::find_member(*status, kMaterialsObject);
+                obj && obj->is_object()) {
+                if (const json* slots = json_util::find_member(*obj, "slots")) {
+                    materials_delta["slots"] = *slots;
+                }
+            }
+            token.defer("Ad5xRefillModel::status_query", [this, ifs_delta, materials_delta]() {
+                merge(ifs_delta, materials_delta);
+            });
+        },
+        [](const MoonrakerError& err) {
+            spdlog::debug("[AD5X refill] {} query failed: {}", kObject, err.message);
+        },
+        0, /*silent=*/true);
+}
+
+void Ad5xRefillModel::merge(const json& ifs_delta, const json& materials_delta) {
+    if (!api_) {
+        return;
+    }
+    for (auto it = ifs_delta.begin(); it != ifs_delta.end(); ++it) {
+        ifs_[it.key()] = it.value();
+    }
+    for (auto it = materials_delta.begin(); it != materials_delta.end(); ++it) {
+        materials_[it.key()] = it.value();
+    }
+    // Klipper without auto-refill has no such field: nothing to show then
+    loaded_ = ifs_.contains("auto_refill");
+    refresh();
+    check_notice();
+}
+
+void Ad5xRefillModel::send(const std::string& gcode) {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api) {
+        NOTIFY_WARNING("{}", lv_tr("Not connected to the printer"));
+        refresh();
+        return;
+    }
+    spdlog::info("[AD5X refill] {}", gcode);
+    ++pending_;
+    refresh();
+
+    // Klipper's answer releases the controls; a fresh query then shows what it kept
+    const auto token = lifetime_.token();
+    api->execute_gcode(
+        gcode,
+        [this, token]() {
+            token.defer("Ad5xRefillModel::send_done", [this]() {
+                pending_ = std::max(0, pending_ - 1);
+                query();
+                refresh();
+            });
+        },
+        [this, token](const MoonrakerError& err) {
+            const std::string message = err.message;
+            token.defer("Ad5xRefillModel::send_error", [this, message]() {
+                pending_ = std::max(0, pending_ - 1);
+                NOTIFY_WARNING("{}", message.empty() ? std::string(lv_tr("Failed")) : message);
+                query();
+                refresh();
+            });
+        },
+        0, /*silent=*/false, /*on_queued=*/nullptr, /*caller_surfaces_errors=*/true);
+}
+
+void Ad5xRefillModel::set_enabled(bool on) {
+    if (subjects_initialized_) {
+        lv_subject_set_int(&enabled_, on ? 1 : 0);
+    }
+    send(enable_gcode(on));
+}
+
+void Ad5xRefillModel::set_match(int index) {
+    const int count = static_cast<int>(std::size(kMatchNames));
+    index = std::clamp(index, 0, count - 1);
+    if (subjects_initialized_) {
+        lv_subject_set_int(&match_, index);
+    }
+    send(match_gcode(index));
+}
+
+void Ad5xRefillModel::refresh() {
+    std::vector<SlotBackup> slots = parse_backups(ifs_, materials_);
+    // The list is rebuilt only when what it shows changed
+    std::string key;
+    for (const auto& s : slots) {
+        key += backup_line(s);
+        key += s.rgb ? fmt::format("#{:06X}\n", *s.rgb) : std::string("-\n");
+    }
+    key += loaded_ ? "1" : "0";
+    const bool slots_changed = key != slots_key_;
+    slots_key_ = key;
+    slots_ = std::move(slots);
+
+    if (subjects_initialized_) {
+        const bool enabled = json_util::safe_bool(ifs_, "auto_refill");
+        const int match = match_index(json_util::safe_string(ifs_, "refill_match", "similar"));
+        copy_if_changed(&summary_, loaded_ ? summary_text(enabled, match, slots_) : std::string());
+        // While Klipper has not answered a change, the controls keep what the user set
+        if (loaded_ && pending_ == 0) {
+            set_if_changed(&enabled_, enabled ? 1 : 0);
+            set_if_changed(&match_, match);
+        }
+        set_if_changed(&busy_, (pending_ > 0 || !loaded_ || !klippy_ready_) ? 1 : 0);
+        set_if_changed(&has_backups_, any_backup(slots_) ? 1 : 0);
+    }
+    if (slots_changed && on_slots_changed_) {
+        on_slots_changed_();
+    }
+}
+
+void Ad5xRefillModel::check_notice() {
+    const std::string notice = json_util::safe_string(ifs_, "refill_notice");
+    if (notice.empty()) {
+        // Cleared by a new print: the same sentence in that print is news again
+        if (ifs_.contains("refill_notice")) {
+            shown_notice_.clear();
+        }
+        return;
+    }
+    if (notice == shown_notice_ || !print_active() || is_wizard_active()) {
+        return;
+    }
+    shown_notice_ = notice;
+    spdlog::info("[AD5X refill] Notice: {}", notice);
+    // A newer notice replaces one still open
+    if (lv_obj_t* open = ModalStack::instance().dialog_for_component("ad5x_refill_notice_modal")) {
+        Modal::hide(open);
+    }
+    helix::ui::Ad5xRefillNoticeModal::show_owned(notice_body(notice));
+}
+
+Ad5xRefillModel& model() {
+    return helix::lazy_global<Ad5xRefillModel>("Ad5xRefillModel");
+}
