+void Ad5xRefillOverlay::init_subjects() {
+    ad5x_refill::model().init_subjects();
+}
+
+void Ad5xRefillOverlay::register_callbacks() {
+    register_xml_callbacks({
+        {"on_ad5x_refill_enabled_changed",
+         [](lv_event_t* e) {
+             get_ad5x_refill_overlay().handle_enabled_changed(helix::ui::event_checked(e));
+         }},
+        {"on_ad5x_refill_match_changed",
+         [](lv_event_t* e) {
+             get_ad5x_refill_overlay().handle_match_changed(helix::ui::event_selected(e));
+         }},
+        {"on_ad5x_refill_slots",
+         [](lv_event_t*) { get_ad5x_refill_overlay().handle_filament_slots(); }},
+    });
+}
+
+void Ad5xRefillOverlay::on_activate() {
+    OverlayBase::on_activate();
+    auto& refill = ad5x_refill::model();
+    refill.set_on_slots_changed([this]() { render_slots(); });
+    refill.start();
+    render_slots();
+}
+
+void Ad5xRefillOverlay::on_ui_destroyed() {
+    ad5x_refill::model().set_on_slots_changed(nullptr);
+}
+
+void Ad5xRefillOverlay::render_slots() {
+    if (!overlay_root_) {
+        return;
+    }
+    lv_obj_t* list = helix::ui::find_required(overlay_root_, "ad5x_refill_slots", get_name());
+    if (!list) {
+        return;
+    }
+    helix::ui::safe_clean_children(list);
+
+    const auto& refill = ad5x_refill::model();
+    if (!refill.loaded()) {
+        return;
+    }
+    const auto& slots = refill.slots();
+    if (slots.empty()) {
+        const char* attrs[] = {"text", lv_tr("No filament in the IFS"), nullptr};
+        if (lv_obj_t* row =
+                static_cast<lv_obj_t*>(lv_xml_create(list, "ad5x_refill_slot_row", attrs))) {
+            if (lv_obj_t* swatch = helix::ui::find_required(row, "swatch", get_name())) {
+                lv_obj_add_flag(swatch, LV_OBJ_FLAG_HIDDEN);
+            }
+        }
+        return;
+    }
+    for (const auto& slot : slots) {
+        const std::string text = ad5x_refill::backup_line(slot);
+        const char* attrs[] = {"text", text.c_str(), nullptr};
+        auto* row = static_cast<lv_obj_t*>(lv_xml_create(list, "ad5x_refill_slot_row", attrs));
+        if (!row) {
+            spdlog::warn("[AD5X refill] cannot create a row for slot {}", slot.slot);
+            continue;
+        }
+        lv_obj_t* swatch = helix::ui::find_required(row, "swatch", get_name());
+        if (!swatch) {
+            continue;
+        }
+        if (slot.rgb) {
+            helix::ui::apply_swatch_color(swatch, *slot.rgb, std::string());
+        } else {
+            // No colour set: an outline, like an empty slot
+            helix::ui::clear_swatch_color(swatch);
+            lv_obj_set_style_border_width(swatch, 2, 0);
+            lv_obj_set_style_border_color(swatch, theme_manager_get_color("text_muted"), 0);
+            lv_obj_set_style_border_opa(swatch, LV_OPA_COVER, 0);
+        }
+    }
+}
+
+void Ad5xRefillOverlay::handle_enabled_changed(bool on) {
+    ad5x_refill::model().set_enabled(on);
+}
+
+void Ad5xRefillOverlay::handle_match_changed(int index) {
+    ad5x_refill::model().set_match(index);
+}
+
+void Ad5xRefillOverlay::handle_filament_slots() {
+    ad5x_refill::open_filament_slots();
+}
