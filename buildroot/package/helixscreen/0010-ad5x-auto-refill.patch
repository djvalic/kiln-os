+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * @file ui_settings_ad5x_refill.h
+ * @brief Filament auto-refill on the AD5X: Settings > Filament Auto-Refill and
+ *        the "No backup spool" pop-up
+ *
+ * Klipper's `ifs` object: `auto_refill` (IFS_AUTO_REFILL ENABLE=0|1, saved),
+ * `refill_match` ("exact", "similar", "any"; IFS_AUTO_REFILL MATCH=, saved),
+ * `refill_backups` ({"1": [3], "2": [], ...}: per slot, the slots that would
+ * take over if it ran out, nearest colour first), `refill_notice` (a sentence
+ * when a print loaded a slot with no backup; cleared when the next print
+ * starts; the print carries on) and `loaded_channels` (the slots with
+ * filament). The slots' materials and colours are `ifs_materials.slots`.
+ *
+ * Ad5xRefillModel follows both objects from the first discovery on (a tail
+ * discovery step attaches it), so the pop-up comes up on any screen during a
+ * print, once per distinct notice. Ad5xRefillOverlay is the Settings screen.
+ *
+ * @pattern Overlay (lazy init) over a process-wide model
+ * @threading Main thread only; Moonraker callbacks hop over via lifetime tokens
+ */
+
+#pragma once
+
+#include "ui_modal.h"
+#include "ui_observer_guard.h"
+#include "ui_subscription_guard.h"
+
+#include "async_lifetime_guard.h"
+#include "json_fwd.h"
+#include "lvgl/lvgl.h"
+#include "overlay_base.h"
+#include "static_panel_registry.h"
+#include "subject_managed_panel.h"
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace helix {
+class IMoonrakerAPI;
+}
+
+namespace helix::ad5x_refill {
+
+/// The colour match choices, in the dropdown's order.
+enum class Match {
+    Exact = 0,   ///< The same colour code
+    Similar = 1, ///< Close shades (Klipper's refill_color_tolerance); the default
+    Any = 2,     ///< Any colour of the same material
+};
+
+/// "exact" / "similar" / "any" for @p index (out of range: "similar").
+const char* match_name(int index);
+
+/// Index of Klipper's `refill_match` value; Similar for anything unknown.
+int match_index(const std::string& name);
+
+/// "IFS_AUTO_REFILL ENABLE=1"
+std::string enable_gcode(bool on);
+
+/// "IFS_AUTO_REFILL MATCH=similar"
+std::string match_gcode(int index);
+
+/// One slot with filament and the slots that would take over from it.
+struct SlotBackup {
+    int slot = 0;                ///< 1-4
+    std::string material;        ///< "PLA"; empty when not set
+    std::optional<uint32_t> rgb; ///< The slot's colour, when set
+    std::vector<int> backups;    ///< Nearest colour first; empty: no backup
+};
+
+/// The slots with filament (`ifs.loaded_channels`; without it, the slots
+/// with a backup list entry) with their backups and materials, by slot.
+std::vector<SlotBackup> parse_backups(const json& ifs, const json& materials);
+
+/// "Slot 1 · PLA black → Slot 3", "Slot 2 · PLA → no backup".
+std::string backup_line(const SlotBackup& slot);
+
+/// Whether any slot has a backup.
+bool any_backup(const std::vector<SlotBackup>& slots);
+
+/// The Settings row's line: "Off", "On · Similar colour · slots 1, 3 backed up",
+/// "On · Similar colour · no backup spools".
+std::string summary_text(bool enabled, int match, const std::vector<SlotBackup>& slots);
+
+/// The pop-up's text: Klipper's notice and how to add a backup.
+std::string notice_body(const std::string& notice);
+
+/// Whether the printer publishes the `ifs` object (an AD5X with the IFS).
+bool available();
+
+/// Open HelixScreen's filament slot panel (the AMS panel), where the slots'
+/// materials and colours are edited. A toast when there is none yet.
+void open_filament_slots();
+
+/// Both objects, the shared subjects, the commands and the pop-up.
+///
+/// Subjects: `ad5x_refill_summary` (the Settings row's line),
+/// `ad5x_refill_enabled`, `ad5x_refill_match` (Match), `ad5x_refill_busy` (1
+/// while a change is pending, the object has not answered or Klipper is not
+/// ready: the controls bind it) and `ad5x_refill_has_backups`.
+class Ad5xRefillModel {
+  public:
+    Ad5xRefillModel() = default;
+    ~Ad5xRefillModel();
+    Ad5xRefillModel(const Ad5xRefillModel&) = delete;
+    Ad5xRefillModel& operator=(const Ad5xRefillModel&) = delete;
+
+    void init_subjects();
+
+    /// From each discovery: follow @p api's status updates (again when the
+    /// API changed) and take `ifs` / `ifs_materials` from the discovery's
+    /// initial @p status. Nothing on a printer without the IFS.
+    void attach(IMoonrakerAPI* api, const json& status);
+
+    /// attach() to the current API if that has not happened, and query.
+    void start();
+
+    /// Ask Klipper for the fields this uses.
+    void query();
+
+    bool loaded() const {
+        return loaded_;
+    }
+    const std::vector<SlotBackup>& slots() const {
+        return slots_;
+    }
+
+    /// IFS_AUTO_REFILL ENABLE=0|1
+    void set_enabled(bool on);
+
+    /// IFS_AUTO_REFILL MATCH=exact|similar|any
+    void set_match(int index);
+
+    /// Called (main thread) when the backup list changed; the overlay sets it
+    /// while it is built. Empty to stop.
+    void set_on_slots_changed(std::function<void()> cb) {
+        on_slots_changed_ = std::move(cb);
+    }
+
+  private:
+    void detach();
+    void merge(const json& ifs_delta, const json& materials_delta);
+    void send(const std::string& gcode);
+    void refresh();
+    /// Pops the notice up when it is new, a print runs and no wizard is open.
+    void check_notice();
+
+    SubjectManager subjects_;
+    lv_subject_t summary_{};
+    lv_subject_t enabled_{};
+    lv_subject_t match_{};
+    lv_subject_t busy_{};
+    lv_subject_t has_backups_{};
+    char summary_buf_[160] = "";
+    bool subjects_initialized_ = false;
+
+    IMoonrakerAPI* api_ = nullptr;
+    json ifs_ = json::object();       ///< The `ifs` fields this uses
+    json materials_ = json::object(); ///< `ifs_materials`' slots
+    bool loaded_ = false;
+    bool klippy_ready_ = true;
+    int pending_ = 0;
+    std::vector<SlotBackup> slots_;
+    std::string slots_key_;
+    /// The notice last shown; another print's same sentence shows again
+    /// (an empty notice in between forgets it).
+    std::string shown_notice_;
+    std::function<void()> on_slots_changed_;
+
+    SubscriptionGuard subscription_;
+    ObserverGuard klippy_observer_;
+    ObserverGuard print_observer_;
+    AsyncLifetimeGuard lifetime_;
+};
+
+Ad5xRefillModel& model();
+
+} // namespace helix::ad5x_refill
+
+namespace helix::ui {
+
+/// "No backup spool": Klipper's notice with OK, Turn off auto-refill and
+/// Filament slots. The print never waits for it.
+class Ad5xRefillNoticeModal : public Modal {
+  public:
+    explicit Ad5xRefillNoticeModal(std::string text) : text_(std::move(text)) {}
+
+    const char* get_name() const override {
+        return "AD5X Auto-Refill Notice";
+    }
+    const char* component_name() const override {
+        return "ad5x_refill_notice_modal";
+    }
+
+    /// One-shot owned show over the active screen.
+    static bool show_owned(const std::string& text);
+
+  protected:
+    void on_show() override;
+    void on_ok() override;       ///< OK
+    void on_cancel() override;   ///< Filament slots
+    void on_tertiary() override; ///< Turn off auto-refill
+    void on_escape() override;   ///< Closes, like OK
+
+  private:
+    std::string text_;
+};
+
+} // namespace helix::ui
+
+namespace helix::settings {
+
+/// Settings > Filament Auto-Refill: the switch, the colour match, the live
+/// backup list and the way to the filament slots.
+class Ad5xRefillOverlay : public OverlayBase {
+  public:
+    const char* get_name() const override {
+        return "AD5X Filament Auto-Refill";
+    }
+    const char* xml_component() const override {
+        return "settings_ad5x_refill_overlay";
+    }
+    /// Freed on close; the next open rebuilds it.
+    bool destroy_on_close() const override {
+        return true;
+    }
+
+    void init_subjects() override;
+    void register_callbacks() override;
+    void on_activate() override;
+    void on_ui_destroyed() override;
+
+    void handle_enabled_changed(bool on);
+    void handle_match_changed(int index);
+    void handle_filament_slots();
+
+  private:
+    /// One row per slot with filament: its colour, material and backups.
+    void render_slots();
+};
+
+inline Ad5xRefillOverlay& get_ad5x_refill_overlay() {
+    return lazy_global<Ad5xRefillOverlay>("Ad5xRefillOverlay");
+}
+
+} // namespace helix::settings
