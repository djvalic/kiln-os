+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "ui_settings_ad5x_refill.h"
+
+#include "../catch_amalgamated.hpp"
+#include "hv/json.hpp"
+
+using namespace helix::ad5x_refill;
+
+namespace {
+
+/// The `ifs` fields as Klipper publishes them: slots 1-3 have filament.
+json sample_ifs() {
+    return json::parse(R"({
+        "auto_refill": true,
+        "refill_match": "similar",
+        "refill_backups": {"1": [3], "2": [], "3": [1], "4": []},
+        "refill_notice": "",
+        "loaded_channels": [1, 2, 3]
+    })");
+}
+
+json sample_materials() {
+    return json::parse(R"({
+        "slots": {
+            "1": {"type": "PLA", "color": "#000000", "temp": 220},
+            "2": {"type": "PLA", "color": null, "temp": null},
+            "3": {"type": "PLA", "color": "#050505", "temp": 220},
+            "4": {"type": "?", "color": "#FFFFFF", "temp": null}
+        }
+    })");
+}
+
+} // namespace
+
+TEST_CASE("auto-refill commands", "[ad5x_refill]") {
+    CHECK(enable_gcode(true) == "IFS_AUTO_REFILL ENABLE=1");
+    CHECK(enable_gcode(false) == "IFS_AUTO_REFILL ENABLE=0");
+    CHECK(match_gcode(0) == "IFS_AUTO_REFILL MATCH=exact");
+    CHECK(match_gcode(1) == "IFS_AUTO_REFILL MATCH=similar");
+    CHECK(match_gcode(2) == "IFS_AUTO_REFILL MATCH=any");
+    CHECK(match_gcode(7) == "IFS_AUTO_REFILL MATCH=similar");
+
+    CHECK(match_index("exact") == 0);
+    CHECK(match_index("ANY") == 2);
+    CHECK(match_index("similar") == 1);
+    CHECK(match_index("") == 1);
+}
+
+TEST_CASE("backups are listed for the slots with filament", "[ad5x_refill]") {
+    const auto slots = parse_backups(sample_ifs(), sample_materials());
+    REQUIRE(slots.size() == 3);
+    CHECK(slots[0].slot == 1);
+    CHECK(slots[0].material == "PLA");
+    REQUIRE(slots[0].rgb.has_value());
+    CHECK(*slots[0].rgb == 0x000000u);
+    CHECK(slots[0].backups == std::vector<int>{3});
+    CHECK(slots[1].slot == 2);
+    CHECK_FALSE(slots[1].rgb.has_value());
+    CHECK(slots[1].backups.empty());
+    CHECK(slots[2].backups == std::vector<int>{1});
+    CHECK(any_backup(slots));
+
+    CHECK(backup_line(slots[1]) == "Slot 2 · PLA → no backup");
+    const std::string first = backup_line(slots[0]);
+    CHECK(first.rfind("Slot 1 · PLA ", 0) == 0);
+    CHECK(first.find("black") != std::string::npos);
+    CHECK(first.find("→ Slot 3") != std::string::npos);
+
+    SlotBackup several;
+    several.slot = 4;
+    several.backups = {2, 1};
+    CHECK(backup_line(several) == "Slot 4 · material not set → Slots 2, 1");
+}
+
+TEST_CASE("without loaded_channels the slots with a backup are listed", "[ad5x_refill]") {
+    json ifs = sample_ifs();
+    ifs.erase("loaded_channels");
+    const auto slots = parse_backups(ifs, sample_materials());
+    REQUIRE(slots.size() == 2);
+    CHECK(slots[0].slot == 1);
+    CHECK(slots[1].slot == 3);
+
+    CHECK(parse_backups(json::object(), json::object()).empty());
+    // Malformed entries are skipped
+    const auto odd = parse_backups(
+        json::parse(R"({"loaded_channels": [0, 9, "2"], "refill_backups": {"2": [2, "x", 4]}})"),
+        json::object());
+    REQUIRE(odd.size() == 1);
+    CHECK(odd[0].slot == 2);
+    CHECK(odd[0].backups == std::vector<int>{4});
+}
+
+TEST_CASE("auto-refill row line and notice", "[ad5x_refill]") {
+    const auto slots = parse_backups(sample_ifs(), sample_materials());
+    CHECK(summary_text(false, 1, slots) == "Off");
+    CHECK(summary_text(true, 1, slots) == "On · Similar colour · backups for slot 1, 3");
+    CHECK(summary_text(true, 0, {}) == "On · Exact colour · no backup spools");
+
+    const std::string body = notice_body("Auto-refill: slot 2 (PLA) has no backup spool.");
+    CHECK(body.rfind("Auto-refill: slot 2 (PLA) has no backup spool.\n\nTo add one, ", 0) == 0);
+}
diff --git a/ui_xml/ad5x_refill_notice_modal.xml b/ui_xml/ad5x_refill_notice_modal.xml
