+++ b/ui_xml/ad5x_refill_notice_modal.xml
@@ -0,0 +1,24 @@
+<?xml version="1.0"?>
+<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
+<component>
+  <!-- AD5X auto-refill: a print loaded a slot that has no backup spool (the ifs object's
+       refill_notice). The text is Klipper's notice and how to add a backup, set by
+       Ad5xRefillNoticeModal (ui_settings_ad5x_refill.cpp). The print carries on meanwhile.
+       Left to right: Turn off auto-refill (btn_tertiary), Filament slots (btn_secondary),
+       OK (btn_primary); ESC and the backdrop close it like OK.
+       Backdrop created by the Modal system. -->
+  <view name="ad5x_refill_notice_modal"
+        extends="ui_dialog" width="80%" height="content" style_max_width="640" style_max_height="90%"
+        align="center" flex_flow="column" style_flex_main_place="start" style_pad_gap="0">
+    <modal_header icon_src="filament_alert" icon_variant="warning" title="No backup spool"/>
+    <lv_obj width="100%"
+            height="content" style_max_height="#dialog_content_max" style_pad_left="#space_lg"
+            style_pad_right="#space_lg" style_pad_top="#space_sm" style_pad_bottom="#space_lg" flex_flow="column"
+            style_pad_gap="#space_sm" scrollable="true" scroll_snap_y="none">
+      <text_body name="ad5x_refill_notice_text" width="100%" long_mode="wrap" text=""/>
+    </lv_obj>
+    <modal_button_row hide_tertiary="false"
+                      tertiary_name="btn_tertiary" tertiary_variant="secondary" tertiary_text="Turn off auto-refill"
+                      secondary_text="Filament slots" primary_text="OK"/>
+  </view>
+</component>
diff --git a/ui_xml/components/ad5x_refill_slot_row.xml b/ui_xml/components/ad5x_refill_slot_row.xml
new file mode 100644
index 0000000000..a6944a63d9
--- /dev/null
+++ b/ui_xml/components/ad5x_refill_slot_row.xml
@@ -0,0 +1,24 @@
+<?xml version="1.0"?>
+<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
+<!-- One slot with filament in Settings > Filament Auto-Refill: its colour and -->
+<!-- "Slot 1 · PLA black → Slot 3". Created by Ad5xRefillOverlay::render_slots(), which -->
+<!-- paints the swatch (an outline when the slot has no colour set). -->
+<component>
+  <api>
+    <prop name="text" type="string" default=""/>
+  </api>
+  <styles>
+    <style name="pad_standard"
+           pad_left="#space_lg" pad_right="#space_lg" pad_top="#space_sm" pad_bottom="#space_sm" pad_gap="#space_md"/>
+    <style name="pad_micro"
+           pad_left="#space_md" pad_right="#space_md" pad_top="#space_xs" pad_bottom="#space_xs" pad_gap="#space_sm"/>
+  </styles>
+  <view name="ad5x_refill_slot_row"
+        extends="lv_obj" width="100%" height="content" flex_flow="row" style_flex_cross_place="center"
+        style_bg_opa="0" style_border_width="0" scrollable="false">
+    <bind_style_if_eq name="pad_micro" subject="ui_breakpoint" ref_value="0"/>
+    <bind_style_if_ge name="pad_standard" subject="ui_breakpoint" ref_value="1"/>
+    <color_dot name="swatch" size="#space_xl"/>
+    <text_body name="label" width="0" flex_grow="1" text="$text" long_mode="wrap"/>
+  </view>
+</component>
diff --git a/ui_xml/settings_ad5x_refill_overlay.xml b/ui_xml/settings_ad5x_refill_overlay.xml
new file mode 100644
index 0000000000..cfa102443e
--- /dev/null
+++ b/ui_xml/settings_ad5x_refill_overlay.xml
@@ -0,0 +1,67 @@
+<?xml version="1.0"?>
+<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
+<!-- Settings > Filament Auto-Refill on the AD5X: the ifs Klipper object's auto_refill, -->
+<!-- refill_match and refill_backups. Ad5xRefillModel (ui_settings_ad5x_refill.cpp) owns every -->
+<!-- subject here; the backup rows (ad5x_refill_slot_row) are built by Ad5xRefillOverlay. -->
+<component>
+  <styles>
+    <style name="pad_standard" pad_left="#space_lg" pad_right="#space_lg" pad_top="#space_md" pad_bottom="#space_md"/>
+    <style name="pad_micro" pad_left="#space_md" pad_right="#space_md" pad_top="#space_sm" pad_bottom="#space_sm"/>
+  </styles>
+  <view name="settings_ad5x_refill_overlay"
+        extends="overlay_panel" title="Filament Auto-Refill" bg_color="#screen_bg">
+    <!-- Content Area - no padding, rows handle their own -->
+    <lv_obj name="overlay_content"
+            width="100%" flex_grow="1" style_pad_top="0" style_pad_left="0" style_pad_right="0"
+            style_pad_bottom="#space_lg" scrollable="true" flex_flow="column">
+      <!-- On/off and the colour match (IFS_AUTO_REFILL, both saved by Klipper) -->
+      <setting_group name="ad5x_refill_enable_group">
+        <setting_toggle_row name="row_ad5x_refill_enabled"
+                            label="Auto-refill" icon="sync" subject="ad5x_refill_enabled"
+                            callback="on_ad5x_refill_enabled_changed" disabled="ad5x_refill_busy"/>
+        <lv_obj name="ad5x_refill_explanation_row"
+                width="100%" height="content" style_bg_opa="0" style_border_width="0" scrollable="false">
+          <bind_style_if_eq name="pad_micro" subject="ui_breakpoint" ref_value="0"/>
+          <bind_style_if_ge name="pad_standard" subject="ui_breakpoint" ref_value="1"/>
+          <text_small width="100%"
+                      long_mode="wrap" style_text_color="#text_muted"
+                      text="When a spool runs out mid-print, the printer switches to a slot with the same material and colour and carries on."/>
+        </lv_obj>
+        <setting_dropdown_row name="row_ad5x_refill_match"
+                              label="Colour match" icon="palette" options="Exact&#10;Similar&#10;Any colour"
+                              description="Exact: the same colour code. Similar: close shades. Any colour: the same material is enough."
+                              bind_selected="ad5x_refill_match" callback="on_ad5x_refill_match_changed"
+                              disabled="ad5x_refill_busy" dropdown_width="40%"/>
+      </setting_group>
+      <!-- Per slot with filament: its colour, material and the slots that would take over -->
+      <setting_group name="ad5x_refill_backups_group">
+        <setting_group_header title="BACKUPS"/>
+        <lv_obj name="ad5x_refill_slots"
+                width="100%" height="content" style_pad_all="0" flex_flow="column" style_bg_opa="0"
+                style_border_width="0" scrollable="false"/>
+        <lv_obj name="ad5x_refill_no_backups_row"
+                width="100%" height="content" flex_flow="row" style_flex_cross_place="start" style_pad_gap="#space_sm"
+                style_bg_opa="0" style_border_width="0" scrollable="false">
+          <bind_style_if_eq name="pad_micro" subject="ui_breakpoint" ref_value="0"/>
+          <bind_style_if_ge name="pad_standard" subject="ui_breakpoint" ref_value="1"/>
+          <bind_flag_if_eq subject="ad5x_refill_has_backups" flag="hidden" ref_value="1"/>
+          <icon src="info_outline" size="xs" variant="secondary"/>
+          <text_small width="0"
+                      flex_grow="1" long_mode="wrap" style_text_color="#text_muted"
+                      text="No backups: put the same filament in another slot and set its material and colour on the Filament screen."/>
+        </lv_obj>
+        <lv_obj name="ad5x_refill_slots_button_row"
+                width="100%" height="content" flex_flow="row" style_flex_main_place="end" style_bg_opa="0"
+                style_border_width="0" scrollable="false">
+          <bind_style_if_eq name="pad_micro" subject="ui_breakpoint" ref_value="0"/>
+          <bind_style_if_ge name="pad_standard" subject="ui_breakpoint" ref_value="1"/>
+          <ui_button name="btn_ad5x_refill_slots"
+                     width="content" height="#button_height_sm" style_min_width="120" text="Filament slots"
+                     icon="filament" variant="secondary">
+            <event_cb trigger="clicked" callback="on_ad5x_refill_slots"/>
+          </ui_button>
+        </lv_obj>
+      </setting_group>
+    </lv_obj>
+  </view>
+</component>
