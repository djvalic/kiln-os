+            c.message += "\n\n";
+            c.message += lv_tr("This plugin needs root access, so it can change system files. "
+                               "Install it only if you trust the author.");
+        }
         c.gcode = fmt::format("ENABLE_PLUGIN NAME={} ROOT=1", p.name);
         // A job first (root/install.sh, the status line); the restart follows it
         c.restarts = false;
@@ -156,6 +220,38 @@ Ad5xToggleConfirm ad5x_toggle_confirm(const Ad5xInstalledPlugin& p, bool on) {
     return c;
 }
 
+Ad5xCommunityNotice ad5x_community_notice() {
+    Ad5xCommunityNotice n;
+    n.title = lv_tr("About community plugins");
+    n.message = lv_tr("These plugins are made by members of the Kiln OS community. Each author "
+                      "looks after their own plugin, and every update passes Kiln's automated "
+                      "checks before it's offered. Questions or problems? The author's page is "
+                      "the best place to ask. You can turn off or remove a plugin any time.");
+    n.button = lv_tr("Got it");
+    n.back = lv_tr("Back");
+    return n;
+}
+
+Ad5xTabStep ad5x_tab_step(Ad5xPluginTab wanted) {
+    if (wanted != Ad5xPluginTab::Community) {
+        return Ad5xTabStep::Show;
+    }
+    auto* cfg = ::helix::Config::get_instance();
+    const bool seen = cfg && cfg->get<bool>(kAd5xCommunityNoticeSeen, false);
+    return seen ? Ad5xTabStep::Show : Ad5xTabStep::Notice;
+}
+
+Ad5xPluginTab ad5x_community_notice_answer(bool show) {
+    if (!show) {
+        return Ad5xPluginTab::Kiln;
+    }
+    if (auto* cfg = ::helix::Config::get_instance()) {
+        cfg->set<bool>(kAd5xCommunityNoticeSeen, true);
+        cfg->save();
+    }
+    return Ad5xPluginTab::Community;
+}
+
