+TEST_CASE("the community notice shows until Got it, and Back keeps Kiln OS",
+          "[ad5x_plugins][community]") {
+    CommunityNoticeReset reset;
+
+    // Kiln OS never asks
+    CHECK(ad5x_tab_step(Ad5xPluginTab::Kiln) == Ad5xTabStep::Show);
+    CHECK(ad5x_tab_step(Ad5xPluginTab::Community) == Ad5xTabStep::Notice);
+
+    // Back: the Kiln OS tab, nothing remembered, so it comes again
+    CHECK(ad5x_community_notice_answer(false) == Ad5xPluginTab::Kiln);
+    CHECK_FALSE(helix::Config::get_instance()->get<bool>(kAd5xCommunityNoticeSeen, false));
+    CHECK(ad5x_tab_step(Ad5xPluginTab::Community) == Ad5xTabStep::Notice);
+
+    // Got it: Community, remembered in the settings
+    CHECK(ad5x_community_notice_answer(true) == Ad5xPluginTab::Community);
+    CHECK(helix::Config::get_instance()->get<bool>(kAd5xCommunityNoticeSeen, false));
+
+    // Shown once: the next open goes straight to the tab
+    CHECK(ad5x_tab_step(Ad5xPluginTab::Community) == Ad5xTabStep::Show);
+    CHECK(ad5x_tab_step(Ad5xPluginTab::Community) == Ad5xTabStep::Show);
+
+    const Ad5xCommunityNotice n = ad5x_community_notice();
+    CHECK(n.title == "About community plugins");
+    CHECK(n.message == "These plugins are made by members of the Kiln OS community. Each author "
+                       "looks after their own plugin, and every update passes Kiln's automated "
+                       "checks before it's offered. Questions or problems? The author's page is "
+                       "the best place to ask. You can turn off or remove a plugin any time.");
+    CHECK(n.button == "Got it");
+    CHECK(n.back == "Back");
+}
+
+TEST_CASE("the root confirmation adds the trust line only for a community plugin",
+          "[ad5x_plugins][community]") {
+    const char* line = "This plugin needs root access, so it can change system files. Install "
+                       "it only if you trust the author.";
+    const json status = community_status();
+    const auto community = ad5x_installed_plugins(status, Ad5xPluginTab::Community);
+    REQUIRE(community.size() == 3);
+    REQUIRE(community[2].name == "usb-relay");
+
+    // Community plugin with root scripts: 0097's text, then the line
+    const Ad5xToggleConfirm on = ad5x_toggle_confirm(community[2], true);
+    CHECK_THAT(on.message, ContainsSubstring("runs some of its code as root"));
+    CHECK_THAT(on.message, ContainsSubstring(std::string("Klipper restarts.\n\n") + line));
+    CHECK(on.gcode == "ENABLE_PLUGIN NAME=usb-relay ROOT=1");
+    CHECK_FALSE(on.restarts);
+
+    // Kiln's own plugin with root scripts: 0097's text only
+    Ad5xInstalledPlugin kiln = community[2];
+    kiln.community = false;
+    const Ad5xToggleConfirm kiln_on = ad5x_toggle_confirm(kiln, true);
+    CHECK_THAT(kiln_on.message, ContainsSubstring("runs some of its code as root"));
+    CHECK_THAT(kiln_on.message, !ContainsSubstring("trust the author"));
+    CHECK(kiln_on.gcode == "ENABLE_PLUGIN NAME=usb-relay ROOT=1");
+
+    // Community plugin without root scripts: the plain question
+    const Ad5xToggleConfirm plain = ad5x_toggle_confirm(community[1], true);
+    CHECK(plain.message == "Klipper restarts to apply this. Continue?");
+
+    // Turning a community root plugin off: no root text
+    Ad5xInstalledPlugin enabled = community[2];
+    enabled.enabled = true;
+    const Ad5xToggleConfirm off = ad5x_toggle_confirm(enabled, false);
+    CHECK(off.message == "Klipper restarts to apply this. Continue?");
+}
