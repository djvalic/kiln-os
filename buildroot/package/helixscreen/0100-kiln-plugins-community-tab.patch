 Ad5xToggleConfirm ad5x_toggle_confirm(const Ad5xInstalledPlugin& p, bool on) {
     Ad5xToggleConfirm c;
     c.title = fmt::format(on ? lv_tr("Turn on {}?") : lv_tr("Turn off {}?"), p.title);
@@ -146,6 +205,11 @@ Ad5xToggleConfirm ad5x_toggle_confirm(const Ad5xInstalledPlugin& p, bool on) {
