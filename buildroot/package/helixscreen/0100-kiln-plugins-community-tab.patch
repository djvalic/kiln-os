+/// The object with community plugins: Klipper's community/author/commit fields.
+json community_status() {
+    return json::parse(R"({
+        "api_version": "1.6",
+        "enabled": ["zmod-compat", "spool-colors"],
+        "available": {
+            "zmod-compat": {"source": "shipped", "description": "zMod macros", "version": "1.1.0",
+                            "compatible": true, "community": false, "author": ""},
+            "notify": {"source": "user", "description": "Print notifications", "version": "0.3.0",
+                       "compatible": true, "community": false},
+            "spool-colors": {"source": "user", "description": "Spool colours", "version": "0.2.0",
+                             "compatible": true, "community": true, "author": "Jane Maker"},
+            "usb-relay": {"source": "user", "description": "A USB relay", "version": "1.0.0",
+                          "compatible": true, "community": true, "author": "", "root": true},
+            "by-hand": {"source": "user", "description": "", "version": "",
+                        "compatible": true, "community": true}
+        },
+        "catalog": {
+            "notify": {"title": "Notifications", "description": "Telegram, ntfy, ...",
+                       "compatible": true, "installed": true, "community": false, "author": "",
+                       "commit": ""},
+            "timelapse": {"title": "Timelapse", "description": "Videos of the print",
+                          "compatible": true, "installed": false, "community": false},
+            "usb-relay": {"title": "USB relay", "description": "Switch a relay",
+                          "compatible": true, "installed": true, "community": true,
+                          "author": "Relay Person",
+                          "commit": "0123456789abcdef0123456789abcdef01234567"},
+            "bed-glow": {"title": "Bed glow", "description": "LED effects", "compatible": true,
+                         "installed": false, "community": true, "author": "Glow Dev",
+                         "commit": "89abcdef0123456789abcdef0123456789abcdef"},
+            "no-author": {"title": "No author", "description": "", "compatible": true,
+                          "installed": false, "community": true, "author": ""}
+        },
+        "job": {"name": "", "action": "", "state": "idle", "message": ""},
+        "warnings": []
+    })");
+}
+
+std::vector<std::string> names(const std::vector<Ad5xInstalledPlugin>& rows) {
+    std::vector<std::string> out;
+    for (const auto& r : rows) {
+        out.push_back(r.name);
+    }
+    return out;
+}
+
+std::vector<std::string> names(const std::vector<Ad5xCatalogPlugin>& rows) {
+    std::vector<std::string> out;
+    for (const auto& r : rows) {
+        out.push_back(r.name);
+    }
+    return out;
+}
