+/// The catalog entry for @p name, or nullptr.
+const json* catalog_entry(const json& status, const std::string& name) {
+    const json* catalog = json_util::find_member(status, "catalog");
+    return catalog ? json_util::find_member(*catalog, name.c_str()) : nullptr;
