+TEST_CASE("the community texts are in every language, one language at a time",
+          "[ad5x_plugins][community][i18n]") {
+    RestoreLanguage restore;
+    Ad5xInstalledPlugin p;
+    p.name = "usb-relay";
+    p.title = "USB relay";
+    p.root = true;
+    p.community = true;
+    // Texts that cannot read the same in another language
+    const char* sentences[] = {
+        "Made and supported by their authors. You can turn them off at any time.",
+        "No community plugins installed",
+        "No community plugins in the catalog",
+        // The rest of the Plugins screen, so the tabs don't sit beside English
+        "Plugins can't be changed during a print",
+        "All catalog plugins are installed",
+        "Needs a newer Kiln OS",
+        "Waiting for Klipper...",
+        "Downloads the plugin and turns it on. Klipper restarts when it is installed.",
+        "When there is a new version, Klipper restarts to load it.",
+        "Turns the plugin off and deletes it from the printer. Klipper restarts.",
+        "Deletes the plugin from the printer.",
+    };
+    for (const char* lang : {"de", "es", "fr", "it", "ja", "ko", "pt", "ru", "tr", "zh"}) {
+        CAPTURE(lang);
+        helix::ui::ensure_translation_loaded(lang);
+        lv_translation_set_language(lang);
+
+        const Ad5xCommunityNotice n = ad5x_community_notice();
+        CHECK(n.title != "About community plugins");
+        CHECK(n.message.rfind("These plugins are made by members", 0) == std::string::npos);
+        CHECK_THAT(n.message, !ContainsSubstring("author's page"));
+        CHECK(n.button != "Got it");
+        CHECK(n.back != "Back");
+
+        const std::string by = ad5x_author_line("Jane Maker");
+        CHECK_THAT(by, ContainsSubstring("Jane Maker"));
+        CHECK(by != "By Jane Maker");
+
+        const Ad5xToggleConfirm on = ad5x_toggle_confirm(p, true);
+        CHECK_THAT(on.message, ContainsSubstring("root"));
+        CHECK_THAT(on.message, !ContainsSubstring("trust the author"));
+        CHECK_THAT(on.message, !ContainsSubstring("system files"));
+        // 0097's paragraph, then the community line
+        CHECK(on.message.find("\n\n") != std::string::npos);
+
+        for (const char* s : sentences) {
+            CAPTURE(s);
+            CHECK(std::string(lv_tr(s)) != s);
+        }
+        for (const char* s : {"Installing {}...", "Updating {}...", "Working on {}...",
+                              "Install {}?", "Update {}?", "Remove {}?", "Turn off {}?"}) {
+            CAPTURE(s);
+            const std::string t = fmt::format(fmt::runtime(lv_tr(s)), "USB relay");
+            CHECK_THAT(t, ContainsSubstring("USB relay"));
+            CHECK(t != fmt::format(fmt::runtime(s), "USB relay"));
+        }
+    }
+    helix::ui::ensure_translation_loaded("ru");
+    lv_translation_set_language("ru");
+    CHECK(std::string(lv_tr("Community")) == "Сообщество");
+    CHECK(ad5x_community_notice().button == "Понятно");
+}
