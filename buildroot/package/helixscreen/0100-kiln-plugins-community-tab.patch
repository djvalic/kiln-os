+std::vector<Ad5xInstalledPlugin> ad5x_installed_plugins(const json& status, Ad5xPluginTab tab) {
+    std::vector<Ad5xInstalledPlugin> out = ad5x_installed_plugins(status);
+    out.erase(std::remove_if(out.begin(), out.end(),
+                             [tab](const Ad5xInstalledPlugin& p) { return !in_tab(p.community, tab); }),
+              out.end());
+    return out;
+}
+
+std::vector<Ad5xCatalogPlugin> ad5x_catalog_plugins(const json& status, Ad5xPluginTab tab) {
+    std::vector<Ad5xCatalogPlugin> out = ad5x_catalog_plugins(status);
+    out.erase(std::remove_if(out.begin(), out.end(),
+                             [tab](const Ad5xCatalogPlugin& p) { return !in_tab(p.community, tab); }),
+              out.end());
+    return out;
+}
+
+int ad5x_catalog_state(const json& status, Ad5xPluginTab tab) {
+    const json* catalog = json_util::find_member(status, "catalog");
+    if (!catalog || !catalog->is_object()) {
+        return 0;
+    }
+    const bool any = std::any_of(catalog->begin(), catalog->end(), [tab](const json& entry) {
+        return entry.is_object() && in_tab(json_util::safe_bool(entry, "community", false), tab);
+    });
+    if (!any) {
+        return 0;
+    }
+    return ad5x_catalog_plugins(status, tab).empty() ? 2 : 1;
+}
+
+std::string ad5x_author_line(const std::string& author) {
+    if (author.empty()) {
+        return {};
+    }
+    return fmt::format(lv_tr("By {}"), author);
+}
