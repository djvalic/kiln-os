+TEST_CASE("each tab lists its own plugins: Kiln's in Kiln OS, community=true in Community",
+          "[ad5x_plugins][community]") {
+    const json status = community_status();
+
+    // Every installed plugin is still known (switches and buttons look them up)
+    CHECK(ad5x_installed_plugins(status).size() == 5);
+
+    using V = std::vector<std::string>;
+    CHECK(names(ad5x_installed_plugins(status, Ad5xPluginTab::Kiln)) == V{"notify", "zmod-compat"});
+    CHECK(names(ad5x_installed_plugins(status, Ad5xPluginTab::Community)) ==
+          V{"by-hand", "spool-colors", "usb-relay"});
+
+    CHECK(names(ad5x_catalog_plugins(status, Ad5xPluginTab::Kiln)) == V{"timelapse"});
+    CHECK(names(ad5x_catalog_plugins(status, Ad5xPluginTab::Community)) ==
+          V{"bed-glow", "no-author"});
+
+    const auto community = ad5x_installed_plugins(status, Ad5xPluginTab::Community);
+    REQUIRE(community.size() == 3);
+    CHECK(community[0].community);
+    CHECK(community[2].title == "USB relay");
+    CHECK(community[2].root);
+
+    CHECK(ad5x_catalog_state(status, Ad5xPluginTab::Kiln) == 1);
+    CHECK(ad5x_catalog_state(status, Ad5xPluginTab::Community) == 1);
+}
+
+TEST_CASE("a tab's AVAILABLE state counts only that tab's catalog plugins",
+          "[ad5x_plugins][community]") {
+    json status = community_status();
+    status["available"]["timelapse"] = {{"source", "user"}, {"compatible", true}};
+    // Kiln's catalog all installed; Community still offers two
+    CHECK(ad5x_catalog_state(status, Ad5xPluginTab::Kiln) == 2);
+    CHECK(ad5x_catalog_state(status, Ad5xPluginTab::Community) == 1);
+
+    status["catalog"].erase("bed-glow");
+    status["catalog"].erase("no-author");
+    status["catalog"].erase("usb-relay");
+    // No community plugin in the catalog at all
+    CHECK(ad5x_catalog_state(status, Ad5xPluginTab::Community) == 0);
+    CHECK(ad5x_catalog_plugins(status, Ad5xPluginTab::Community).empty());
+}
+
+TEST_CASE("without community fields every plugin is on the Kiln OS tab, as before",
