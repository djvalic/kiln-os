+<?xml version="1.0"?>
+<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
+<!-- One print event in Sound > Printer Sounds on the AD5X: its name, the sound it -->
+<!-- plays (Off or one of the printer's sound files) and a button that plays it. -->
+<!-- SoundSettingsOverlay fills the dropdown from the ad5x_sound object. -->
+<component>
+  <api>
+    <!-- Event name as Klipper's ad5x_sound object knows it (startup, complete, ...) -->
+    <prop name="event" type="string" default=""/>
+    <prop name="label" type="string" default=""/>
+    <!-- Subject that is 1 when the event plays a sound: enables the play button -->
+    <prop name="on_subject" type="string" default=""/>
+  </api>
+  <styles>
+    <style name="pad_standard"
+           pad_left="#space_lg" pad_right="#space_lg" pad_top="#space_md" pad_bottom="#space_md" pad_gap="#space_sm"/>
+    <style name="pad_micro"
+           pad_left="#space_md" pad_right="#space_md" pad_top="#space_sm" pad_bottom="#space_sm" pad_gap="#space_sm"/>
+  </styles>
+  <view name="ad5x_sound_event_row"
+        extends="lv_obj" width="100%" height="content" flex_flow="row" style_flex_cross_place="center"
+        style_bg_opa="0" style_border_width="0" scrollable="false">
+    <bind_style_if_eq name="pad_micro" subject="ui_breakpoint" ref_value="0"/>
+    <bind_style_if_ge name="pad_standard" subject="ui_breakpoint" ref_value="1"/>
+    <text_body name="label" width="0" flex_grow="1" text="$label" long_mode="wrap"/>
+    <lv_dropdown name="dropdown" width="40%" height="content" options="" style_radius="#border_radius">
+      <event_cb trigger="value_changed" callback="on_ad5x_sound_selected" user_data="$event"/>
+    </lv_dropdown>
+    <ui_button name="play_btn"
+               width="#button_height_sm" height="#button_height_sm" icon="play" variant="secondary">
+      <bind_state_if_eq subject="$on_subject" state="disabled" ref_value="0"/>
+      <event_cb trigger="clicked" callback="on_ad5x_sound_play" user_data="$event"/>
+    </ui_button>
+  </view>
+</component>
