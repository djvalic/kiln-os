+// ----------------------------------------------------------------------------
+// AD5X printer sounds: the `ad5x_sound` Klipper object
+// ----------------------------------------------------------------------------
+
+constexpr const char* kPrinterSoundObject = "ad5x_sound";
+
+/// One print event: SOUND_SETUP parameter (upper-cased), its row in
+/// settings_sound_overlay.xml and the subject that enables its play button.
+struct PrinterSoundEvent {
+    const char* event;
+    const char* row;
+    const char* on_subject;
+};
+
+constexpr PrinterSoundEvent kPrinterSoundEventList[] = {
+    {"startup", "ad5x_sound_row_startup", "ad5x_sound_on_startup"},
+    {"start", "ad5x_sound_row_start", "ad5x_sound_on_start"},
+    {"complete", "ad5x_sound_row_complete", "ad5x_sound_on_complete"},
+    {"error", "ad5x_sound_row_error", "ad5x_sound_on_error"},
+    {"cancelled", "ad5x_sound_row_cancelled", "ad5x_sound_on_cancelled"},
+    {"paused", "ad5x_sound_row_paused", "ad5x_sound_on_paused"},
+    {"refill", "ad5x_sound_row_refill", "ad5x_sound_on_refill"},
+};
+static_assert(std::size(kPrinterSoundEventList) == SoundSettingsOverlay::kPrinterSoundEvents,
+              "one subject per printer sound event");
+
+int printer_sound_event_index(const std::string& event) {
+    for (int i = 0; i < static_cast<int>(std::size(kPrinterSoundEventList)); ++i) {
+        if (event == kPrinterSoundEventList[i].event) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+/// File names are plain names ("complete.mid"); anything else never reaches a G-code line.
+bool safe_sound_file(const std::string& name) {
+    return !name.empty() && std::all_of(name.begin(), name.end(), [](unsigned char c) {
+        return std::isalnum(c) || c == '-' || c == '_' || c == '.';
+    });
+}
+
+std::string upper(std::string s) {
+    for (auto& c : s) {
+        c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+    }
+    return s;
+}
+
+/// The event an event_cb was bound with (user_data="$event").
+std::string event_name(lv_event_t* e) {
+    const char* s = static_cast<const char*>(lv_event_get_user_data(e));
+    return s ? std::string(s) : std::string();
+}
+
 } // namespace
 
+std::string ad5x_sound_file_label(const std::string& file) {
+    for (const char* ext : {".midi", ".mid"}) {
+        const size_t n = std::strlen(ext);
+        if (file.size() > n) {
+            std::string tail = file.substr(file.size() - n);
+            std::transform(tail.begin(), tail.end(), tail.begin(),
+                           [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+            if (tail == ext) {
+                return file.substr(0, file.size() - n);
+            }
+        }
+    }
+    return file;
+}
