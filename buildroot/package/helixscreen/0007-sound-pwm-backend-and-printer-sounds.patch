+namespace helix::settings {
+
+bool SoundSettingsOverlay::printer_sounds_available() {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api) {
+        return false;
+    }
+    const auto& objects = api->hardware().printer_objects();
+    return std::find(objects.begin(), objects.end(), kPrinterSoundObject) != objects.end();
+}
+
+void SoundSettingsOverlay::activate_printer_sounds() {
+    printer_sounds_pending_ = 0;
+    if (!printer_sounds_available()) {
+        printer_sounds_loaded_ = false;
+        apply_printer_sounds();
+        return;
+    }
+    // The last object stays on screen until the query below replaces it
+
+    if (IMoonrakerAPI* api = get_moonraker_api()) {
+        const auto token = lifetime_.token();
+        // Runs on the WebSocket thread: copy the object out, apply it on the main thread.
+        const SubscriptionId id = api->subscribe_notifications([this, token](const json& note) {
+            const json* params = json_util::find_member(note, "params");
+            if (!params || !params->is_array() || params->empty()) {
+                return;
+            }
+            const json* obj = json_util::find_member((*params)[0], kPrinterSoundObject);
+            if (!obj || !obj->is_object()) {
+                return;
+            }
+            json delta = *obj;
+            token.defer("SoundSettingsOverlay::printer_sounds_update", [this, delta]() {
+                merge_printer_sounds(delta);
+                apply_printer_sounds();
+            });
+        });
+        printer_sounds_subscription_ = SubscriptionGuard(api, id);
+    }
+
+    // A Klipper restart brings the object back, maybe with other sound files
+    printer_klippy_observer_ = ui::observe<int>(
+        get_printer_state().network_state().get_klippy_state_subject(), this,
+        [](SoundSettingsOverlay* self, int state) {
+            const bool ready = static_cast<KlippyState>(state) == KlippyState::READY;
+            if (!ready) {
+                self->printer_sounds_loaded_ = false;
+            } else if (!self->printer_klippy_ready_) {
+                self->query_printer_sounds();
+            }
+            self->printer_klippy_ready_ = ready;
+            self->apply_printer_sounds();
+        },
+        get_printer_state().get_subjects_lifetime());
+
+    query_printer_sounds();
+    apply_printer_sounds();
+}
+
+void SoundSettingsOverlay::query_printer_sounds() {
+    IMoonrakerClient* client = get_moonraker_client();
+    if (!client || client->get_connection_state() != ConnectionState::CONNECTED) {
+        return;
+    }
+    const auto token = lifetime_.token();
+    json params = {{"objects", {{kPrinterSoundObject, nullptr}}}};
+    client->send_jsonrpc(
+        "printer.objects.query", params,
+        [this, token](const json& response) {
+            const json* result = json_util::find_member(response, "result");
+            const json* status = result ? json_util::find_member(*result, "status") : nullptr;
+            const json* obj = status ? json_util::find_member(*status, kPrinterSoundObject) : nullptr;
+            if (!obj || !obj->is_object()) {
+                return;
+            }
+            json full = *obj;
+            token.defer("SoundSettingsOverlay::printer_sounds_query", [this, full]() {
+                printer_sounds_ = full;
+                printer_sounds_loaded_ = true;
+                apply_printer_sounds();
+            });
+        },
+        [](const MoonrakerError& err) {
+            spdlog::debug("[Sound] {} query failed: {}", kPrinterSoundObject, err.message);
+        },
+        0, /*silent=*/true);
+}
+
+void SoundSettingsOverlay::merge_printer_sounds(const json& delta) {
+    // Deltas only patch a full object; the query in flight brings one
+    if (!printer_sounds_loaded_ || !printer_sounds_.is_object()) {
+        return;
+    }
+    for (auto it = delta.begin(); it != delta.end(); ++it) {
+        printer_sounds_[it.key()] = it.value();
+    }
+}
+
+void SoundSettingsOverlay::set_printer_volume_text(int value) {
+    helix::format::format_percent(value, printer_volume_text_buf_,
+                                  sizeof(printer_volume_text_buf_));
+    lv_subject_copy_string(&printer_volume_text_subject_, printer_volume_text_buf_);
+}
+
+void SoundSettingsOverlay::apply_printer_sounds() {
+    if (!subjects_initialized_) {
+        return;
+    }
+    const bool available = printer_sounds_loaded_ && printer_klippy_ready_ &&
+                           json_util::safe_bool(printer_sounds_, "speaker");
+    lv_subject_set_int(&printer_sounds_available_subject_, available ? 1 : 0);
+    // While Klipper has not answered a change, the controls keep what the user set
+    if (!available || printer_sounds_pending_ > 0) {
+        return;
+    }
+
+    lv_subject_set_int(&printer_sounds_enabled_subject_,
+                       json_util::safe_bool(printer_sounds_, "enabled") ? 1 : 0);
+
+    const int volume = std::clamp(json_util::safe_int(printer_sounds_, "volume", 70), 0, 100);
+    lv_obj_t* slider =
+        overlay_root_ ? find_required(overlay_root_, "ad5x_sound_volume_slider", get_name())
+                      : nullptr;
+    // Not under the user's finger
+    if (!slider || !lv_obj_has_state(slider, LV_STATE_PRESSED)) {
+        lv_subject_set_int(&printer_volume_subject_, volume);
+        set_printer_volume_text(volume);
+    }
+
+    printer_sound_files_.clear();
+    if (const json* files = json_util::find_member(printer_sounds_, "files");
+        files && files->is_array()) {
+        for (const auto& f : *files) {
+            std::string name = json_util::as_string(f);
+            if (safe_sound_file(name)) {
+                printer_sound_files_.push_back(std::move(name));
+            }
+        }
+    }
+    std::string options = lv_tr("Off");
+    for (const auto& f : printer_sound_files_) {
+        options += "\n";
+        options += ad5x_sound_file_label(f);
+    }
+
+    const json* events = json_util::find_member(printer_sounds_, "events");
+    for (size_t i = 0; i < kPrinterSoundEvents; ++i) {
+        const PrinterSoundEvent& ev = kPrinterSoundEventList[i];
+        const std::string file =
+            events && events->is_object() ? json_util::safe_string(*events, ev.event) : "";
+        const auto found = std::find(printer_sound_files_.begin(), printer_sound_files_.end(), file);
+        // A file that is gone plays nothing: shown as Off
+        const int selected = found == printer_sound_files_.end()
+                                 ? 0
+                                 : static_cast<int>(found - printer_sound_files_.begin()) + 1;
+        lv_subject_set_int(&printer_sound_on_subjects_[i], selected > 0 ? 1 : 0);
+
+        lv_obj_t* row = overlay_root_ ? find_required(overlay_root_, ev.row, get_name()) : nullptr;
+        lv_obj_t* dropdown = row ? find_required(row, "dropdown", get_name()) : nullptr;
+        // Not while its list is open
+        if (!dropdown || lv_dropdown_is_open(dropdown)) {
+            continue;
+        }
+        const char* current = lv_dropdown_get_options(dropdown);
+        if (!current || options != current) {
+            lv_dropdown_set_options(dropdown, options.c_str());
+        }
+        if (static_cast<int>(lv_dropdown_get_selected(dropdown)) != selected) {
+            lv_dropdown_set_selected(dropdown, static_cast<uint32_t>(selected));
+        }
+    }
+}
+
+void SoundSettingsOverlay::send_printer_sounds(const std::string& gcode, bool changes_settings) {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api) {
+        return;
+    }
+    spdlog::info("[{}] {}", get_name(), gcode);
+    if (changes_settings) {
+        ++printer_sounds_pending_;
+    }
+
+    // Klipper's answer releases the controls; a fresh query then shows what it kept
+    const auto token = lifetime_.token();
+    auto settle = [this, changes_settings]() {
+        if (!changes_settings) {
+            return;
+        }
+        if (printer_sounds_pending_ > 0) {
+            --printer_sounds_pending_;
+        }
+        if (printer_sounds_pending_ == 0) {
+            query_printer_sounds();
+        }
+    };
+    api->execute_gcode(
+        gcode,
+        [token, settle]() { token.defer("SoundSettingsOverlay::printer_sounds_done", settle); },
+        [token, settle](const MoonrakerError& err) {
+            const std::string message = err.message;
+            helix::ui::queue_update("SoundSettingsOverlay::printer_sounds_error",
+                                    [message]() { NOTIFY_WARNING("{}", message); });
+            token.defer("SoundSettingsOverlay::printer_sounds_error", settle);
+        },
+        0, /*silent=*/false, /*on_queued=*/nullptr, /*caller_surfaces_errors=*/true);
+}
+
+void SoundSettingsOverlay::handle_printer_sounds_changed(bool enabled) {
+    lv_subject_set_int(&printer_sounds_enabled_subject_, enabled ? 1 : 0);
+    send_printer_sounds(fmt::format("SOUND_SETUP ENABLE={}", enabled ? 1 : 0), true);
+}
+
+void SoundSettingsOverlay::handle_printer_volume_changed(int value) {
+    // Per drag tick: readout only. The release sends it.
+    set_printer_volume_text(value);
+}
+
+void SoundSettingsOverlay::handle_printer_volume_commit(int value) {
+    value = std::clamp(value, 0, 100);
+    set_printer_volume_text(value);
+    send_printer_sounds(fmt::format("SOUND_SETUP VOLUME={}", value), true);
+}
+
+void SoundSettingsOverlay::handle_printer_sound_selected(const std::string& event, int index) {
+    const int i = printer_sound_event_index(event);
+    if (i < 0 || index < 0 || index > static_cast<int>(printer_sound_files_.size())) {
+        spdlog::warn("[{}] Printer sound {} index {} out of range", get_name(), event, index);
+        apply_printer_sounds();
+        return;
+    }
+    const std::string file = index == 0 ? "0" : printer_sound_files_[index - 1];
+    lv_subject_set_int(&printer_sound_on_subjects_[i], index > 0 ? 1 : 0);
+    send_printer_sounds(fmt::format("SOUND_SETUP {}={}", upper(event), file), true);
+}
+
+void SoundSettingsOverlay::handle_printer_sound_play(const std::string& event) {
+    if (printer_sound_event_index(event) < 0) {
+        return;
+    }
+    send_printer_sounds(fmt::format("PLAY_SOUND EVENT={}", event), false);
+}
+
+} // namespace helix::settings
