 };
 
 inline AboutSettingsOverlay& get_about_settings_overlay() {
diff --git a/src/system/kiln_hardware.cpp b/src/system/kiln_hardware.cpp
index 1b9b5d3ddc..190a6701d2 100644
--- a/src/system/kiln_hardware.cpp
+++ b/src/system/kiln_hardware.cpp
@@ -21,35 +21,33 @@ std::string read_trimmed(const std::string& path) {
 
 } // namespace
 
-std::string emmc_summary(const std::string& root) {
+std::optional<double> EmmcInfo::size_gib() const {
+    if (sectors == 0) {
+        return std::nullopt;
+    }
+    return static_cast<double>(sectors) * 512.0 / (1024.0 * 1024.0 * 1024.0);
+}
+
+std::optional<EmmcInfo> read_emmc(const std::string& root) {
     const std::string block = root + "/sys/block/mmcblk0";
     const std::string dev = block + "/device";
     if (read_trimmed(dev + "/type") != "MMC") {
-        return {};
+        return std::nullopt;
     }
-    const std::string name = read_trimmed(dev + "/name");
-    if (name.empty()) {
-        return {};
+    EmmcInfo info;
+    info.name = read_trimmed(dev + "/name");
+    if (info.name.empty()) {
+        return std::nullopt;
     }
-
-    std::string text = name;
     // manfid reads "0x0000ec"
     const std::string manfid = read_trimmed(dev + "/manfid");
     if (manfid.size() > 2) {
-        if (auto id = tio::parse_int<unsigned>(manfid.substr(2), 16)) {
-            text += fmt::format(" (maker 0x{:02X})", *id);
-        }
-    }
-    const std::string prv = read_trimmed(dev + "/prv");
-    if (!prv.empty()) {
-        text += fmt::format(", PRV {}", prv);
+        info.maker = tio::parse_int<unsigned>(manfid.substr(2), 16);
     }
+    info.prv = read_trimmed(dev + "/prv");
     // 512-byte sectors
-    if (auto sectors = tio::parse_int<unsigned long long>(read_trimmed(block + "/size"))) {
-        text += fmt::format(", {:.1f} GiB", static_cast<double>(*sectors) * 512.0 /
-                                                (1024.0 * 1024.0 * 1024.0));
-    }
-    return text;
+    info.sectors = tio::parse_int<unsigned long long>(read_trimmed(block + "/size")).value_or(0);
+    return info;
 }
 
 } // namespace helix::kiln_hardware
diff --git a/src/ui/settings/ui_settings_about.cpp b/src/ui/settings/ui_settings_about.cpp
index 465e399f3e..4ce16e589e 100644
--- a/src/ui/settings/ui_settings_about.cpp
+++ b/src/ui/settings/ui_settings_about.cpp
@@ -108,15 +108,14 @@ void AboutSettingsOverlay::init_subjects() {
                                   diag.identity.host_arch.c_str(), "host_arch_value", subjects_);
 
         // Kiln OS on the AD5X: the eMMC (a part that differs between
-        // boards). The hardware doesn't change while running.
+        // boards). The hardware doesn't change while running, so it is read
+        // once; populate_info_rows() writes the translated text.
 #if defined(HELIX_KILN_AD5X)
-        const std::string emmc = helix::kiln_hardware::emmc_summary();
-#else
-        const std::string emmc;
+        kiln_emmc_ = helix::kiln_hardware::read_emmc();
 #endif
-        UI_MANAGED_SUBJECT_STRING(emmc_value_subject_, emmc_value_buf_, emmc.c_str(),
-                                  "about_emmc_value", subjects_);
-        UI_MANAGED_SUBJECT_INT(has_emmc_subject_, emmc.empty() ? 0 : 1, "about_has_emmc",
+        UI_MANAGED_SUBJECT_STRING(emmc_value_subject_, emmc_value_buf_, "", "about_emmc_value",
+                                  subjects_);
+        UI_MANAGED_SUBJECT_INT(has_emmc_subject_, kiln_emmc_ ? 1 : 0, "about_has_emmc",
                                subjects_);
     });
 }
@@ -301,6 +300,26 @@ void AboutSettingsOverlay::setup_contributor_marquee() {
 
 // INFO ROWS
 
+namespace {
+
+// Kiln OS: the eMMC row, "A31M8C (maker 0xEC), PRV 0x30, 58.2 GiB". The words
+// are translated; the identifiers (the name, PRV) are not.
+std::string kiln_emmc_text(const helix::kiln_hardware::EmmcInfo& e) {
+    std::string text = e.name;
+    if (e.maker) {
+        text += fmt::format(fmt::runtime(lv_tr(" (maker 0x{:02X})")), *e.maker);
+    }
+    if (!e.prv.empty()) {
+        text += fmt::format(", PRV {}", e.prv);
+    }
+    if (const auto gib = e.size_gib()) {
+        text += fmt::format(fmt::runtime(lv_tr(", {:.1f} GiB")), *gib);
+    }
+    return text;
+}
+
+} // namespace
+
 void AboutSettingsOverlay::populate_info_rows() {
     // Version
     lv_subject_set_string(&version_value_subject_, helix_version());
@@ -314,6 +333,11 @@ void AboutSettingsOverlay::populate_info_rows() {
         config->get_printer_display_name(config->get_active_printer_id(), lv_tr("Unknown"));
     lv_subject_set_string(&printer_value_subject_, printer_name.c_str());
     spdlog::trace("[{}] Printer: {}", get_name(), printer_name);
+
+    // Kiln OS: the eMMC, in the current language
+    if (kiln_emmc_) {
+        lv_subject_set_string(&emmc_value_subject_, kiln_emmc_text(*kiln_emmc_).c_str());
+    }
 }
 
 void AboutSettingsOverlay::fetch_print_hours() {
diff --git a/tests/unit/test_kiln_hardware.cpp b/tests/unit/test_kiln_hardware.cpp
index 2ca5243647..94fc531456 100644
--- a/tests/unit/test_kiln_hardware.cpp
+++ b/tests/unit/test_kiln_hardware.cpp
@@ -43,12 +43,17 @@ struct Root {
 TEST_CASE("Kiln hardware: the eMMC row", "[kiln][hardware]") {
     Root r;
     SECTION("no eMMC: no row") {
-        CHECK(emmc_summary(r.str()).empty());
+        CHECK_FALSE(read_emmc(r.str()));
     }
     SECTION("an SD card is not the eMMC") {
         r.put("sys/block/mmcblk0/device/type", "SD\n");
         r.put("sys/block/mmcblk0/device/name", "SD32G\n");
-        CHECK(emmc_summary(r.str()).empty());
+        CHECK_FALSE(read_emmc(r.str()));
+    }
+    SECTION("an eMMC without a name: no row") {
+        r.put("sys/block/mmcblk0/device/type", "MMC\n");
+        r.put("sys/block/mmcblk0/device/name", "\n");
+        CHECK_FALSE(read_emmc(r.str()));
     }
     SECTION("printer 2's A31M8C") {
         r.put("sys/block/mmcblk0/device/type", "MMC\n");
@@ -56,6 +61,31 @@ TEST_CASE("Kiln hardware: the eMMC row", "[kiln][hardware]") {
         r.put("sys/block/mmcblk0/device/manfid", "0x0000ec\n");
         r.put("sys/block/mmcblk0/device/prv", "0x30\n");
         r.put("sys/block/mmcblk0/size", "122142720\n");
-        CHECK(emmc_summary(r.str()) == "A31M8C (maker 0xEC), PRV 0x30, 58.2 GiB");
+        const auto e = read_emmc(r.str());
+        REQUIRE(e);
+        CHECK(e->name == "A31M8C");
+        CHECK(e->maker == 0xECu);
+        CHECK(e->prv == "0x30");
+        CHECK(e->sectors == 122142720ull);
+        // the About panel shows it as 58.2 GiB
+        REQUIRE(e->size_gib());
+        CHECK(*e->size_gib() == Catch::Approx(58.2422).margin(0.0001));
+    }
+    SECTION("no maker, PRV or size: those are left out") {
+        r.put("sys/block/mmcblk0/device/type", "MMC\n");
+        r.put("sys/block/mmcblk0/device/name", "A31M8C\n");
+        r.put("sys/block/mmcblk0/device/manfid", "0x\n");
+        auto e = read_emmc(r.str());
+        REQUIRE(e);
+        CHECK_FALSE(e->maker);
+        CHECK(e->prv.empty());
+        CHECK(e->sectors == 0);
+        CHECK_FALSE(e->size_gib());
+        // a size of 0 is left out too, not shown as 0.0 GiB
+        r.put("sys/block/mmcblk0/size", "0\n");
+        e = read_emmc(r.str());
+        REQUIRE(e);
+        CHECK(e->sectors == 0);
+        CHECK_FALSE(e->size_gib());
     }
 }
