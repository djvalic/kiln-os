 #include <string>
 
 namespace helix {
@@ -142,6 +144,10 @@ class AboutSettingsOverlay : public OverlayBase {
 
     // Debounce tracker restart on inadvertent re-open
     std::chrono::steady_clock::time_point last_deactivate_{};
+
+    // Kiln OS on the AD5X: read once in init_subjects() (the hardware doesn't
+    // change while running), made into translated text in populate_info_rows()
