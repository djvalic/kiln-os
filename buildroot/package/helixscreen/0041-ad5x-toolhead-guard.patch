From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ad5xrecon <ad5xrecon@localhost>
Date: Sat, 7 Nov 2026 17:00:00 -0500
Subject: [PATCH] ad5x: our controls take the toolhead guard, setup refuses a print

The nozzle size, the plugin switches and buttons, and the bed soak's
Calibrate disabled themselves on print_active. That reads 0 until Klipper
reports the print, so they were live in the moment between Print and the
printer's answer. They now carry moves_machine="true" (upstream's guard,
machine_motion_blocked), composed with their own busy subjects; the C++
checks in the nozzle and soak code ask the same subject.

Settings' "Run Setup Wizard" and "Check Purge Box" now refuse while a
print holds the machine (Klipper's SETUP_WIZARD_STEP refuses too).

The census in test_job_holds_machine.cpp lists our XML files: the four
with guards and their counts, and the six that command nothing (the
setup wizard pages run outside a print).
---
diff --git a/src/ui/ui_ad5x_nozzle.cpp b/src/ui/ui_ad5x_nozzle.cpp
index e5385d1dc2..501a9b2e35 100644
--- a/src/ui/ui_ad5x_nozzle.cpp
+++ b/src/ui/ui_ad5x_nozzle.cpp
@@ -359,7 +359,8 @@ class NozzleChangeFollowUp {
     void offer() const {
         // Not over a wizard (it runs these steps itself) or a print
         if (is_wizard_active() || !ad5x_setup::available() ||
-            lv_subject_get_int(get_printer_state().print_state().get_print_active_subject()) != 0) {
+            lv_subject_get_int(
+                get_printer_state().print_state().get_machine_motion_blocked_subject()) != 0) {
             return;
         }
         spdlog::info("[AD5X nozzle] Klipper runs with {}: offering the checks",
@@ -434,7 +435,8 @@ void Ad5xNozzleModal::on_ok() {
     if (!chosen || status.local || (status.size && ad5x_nozzle::same_size(*chosen, *status.size))) {
         return;
     }
-    if (lv_subject_get_int(get_printer_state().print_state().get_print_active_subject()) != 0) {
+    if (lv_subject_get_int(
+            get_printer_state().print_state().get_machine_motion_blocked_subject()) != 0) {
         NOTIFY_WARNING("{}", lv_tr("The nozzle size can't change during a print"));
         return;
     }
diff --git a/src/ui/ui_panel_settings.cpp b/src/ui/ui_panel_settings.cpp
index d13230fca2..34c12811ae 100644
--- a/src/ui/ui_panel_settings.cpp
+++ b/src/ui/ui_panel_settings.cpp
@@ -363,15 +363,26 @@ void SettingsPanel::handle_hardware_health_clicked() {
     overlay.show(parent_screen_);
 }
 
+// The setup steps home, heat and probe; Klipper refuses them during a print too
+static bool ad5x_setup_refused_now() {
+    if (lv_subject_get_int(
+            get_printer_state().print_state().get_machine_motion_blocked_subject()) != 0) {
+        ToastManager::instance().show(ToastSeverity::WARNING,
+                                      lv_tr("Cannot calibrate while printing"), 3000);
+        return true;
+    }
+    return false;
+}
+
 void SettingsPanel::handle_ad5x_purge_clicked() {
-    if (is_wizard_active()) {
+    if (is_wizard_active() || ad5x_setup_refused_now()) {
         return;
     }
     helix::ad5x_setup::launch_purge_box(parent_screen_);
 }
 
 void SettingsPanel::handle_ad5x_setup_clicked() {
-    if (is_wizard_active()) {
+    if (is_wizard_active() || ad5x_setup_refused_now()) {
         return;
     }
     helix::ui::ConfirmOptions opts;
diff --git a/src/ui/ui_settings_ad5x_soak.cpp b/src/ui/ui_settings_ad5x_soak.cpp
index c0d81d2f4e..5b5a1d0e8d 100644
--- a/src/ui/ui_settings_ad5x_soak.cpp
+++ b/src/ui/ui_settings_ad5x_soak.cpp
@@ -685,7 +685,10 @@ void Ad5xSoakOverlay::handle_calibrate() {
     if (soak.calibrating() || !soak.loaded() || !soak.klippy_ready()) {
         return;
     }
-    if (lv_subject_get_int(get_printer_state().print_state().get_print_active_subject()) != 0) {
+    // machine_motion_blocked, not print_active: it also covers the start of a
+    // print, before Klipper reports it
+    if (lv_subject_get_int(
+            get_printer_state().print_state().get_machine_motion_blocked_subject()) != 0) {
         helix::ui::modal_alert(lv_tr("Can't calibrate now"),
                                lv_tr("The bed soak can't be calibrated during a print."),
                                ModalSeverity::Warning);
diff --git a/tests/unit/test_job_holds_machine.cpp b/tests/unit/test_job_holds_machine.cpp
index d6c03a682f..23366ff4d2 100644
--- a/tests/unit/test_job_holds_machine.cpp
+++ b/tests/unit/test_job_holds_machine.cpp
@@ -359,6 +359,12 @@ constexpr GuardedFile kGuardedFiles[] = {
     {"ui_xml/temp_graph_overlay.xml", 2},
     {"ui_xml/components/tool_switcher_feeder_segment.xml", 1},
     {"ui_xml/components/tool_switcher_park_segment.xml", 1},
+    // AD5X: the nozzle size and the plugins restart Klipper, the soak
+    // calibration homes and probes
+    {"ui_xml/ad5x_nozzle_modal.xml", 2},
+    {"ui_xml/components/ad5x_catalog_row.xml", 1},
+    {"ui_xml/components/ad5x_plugin_row.xml", 3},
+    {"ui_xml/settings_ad5x_soak_overlay.xml", 1},
 };
 
 /// Control-bearing files that command nothing on the printer. A guard appearing
@@ -687,6 +693,14 @@ constexpr const char* kNoMachineControlFiles[] = {
     "ui_xml/wizard_touch_calibration.xml",
     "ui_xml/wizard_vendor_row.xml",
     "ui_xml/wizard_wifi_setup.xml",
+    // AD5X: a notice, settings and sounds; the setup wizard runs outside a
+    // print (Settings refuses it during one)
+    "ui_xml/ad5x_refill_notice_modal.xml",
+    "ui_xml/components/ad5x_sound_event_row.xml",
+    "ui_xml/settings_ad5x_refill_overlay.xml",
+    "ui_xml/wizard_ad5x_nozzle.xml",
+    "ui_xml/wizard_ad5x_setup.xml",
+    "ui_xml/wizard_ad5x_timezone.xml",
 };
 
 std::string read_xml(const std::string& path) {
