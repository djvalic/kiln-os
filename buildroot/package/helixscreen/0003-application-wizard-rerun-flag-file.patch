From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ad5xrecon <ad5xrecon@localhost>
Date: Fri, 16 Oct 2026 14:22:52 -0400
Subject: [PATCH] application: re-run the wizard on request

HELIX_WIZARD_FLAG_FILE names a file whose presence at start runs the
wizard once (the flag is removed once the wizard is up). Unlike --wizard it
keeps the preset, host and hardware selections. A running screen also
opens the AD5X setup steps when Klipper prints
"// action:ad5x_setup_wizard" (SETUP_WIZARD).

Upstream: not applicable (AD5X OS specific)
---
 src/application/application.cpp | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/src/application/application.cpp b/src/application/application.cpp
index d9773e3e6e..9fa45e298a 100644
--- a/src/application/application.cpp
+++ b/src/application/application.cpp
@@ -210,6 +210,8 @@
 #include "action_prompt_manager.h"
 #include "action_prompt_modal.h"
 #include "app_globals.h"
+#include "ui_wizard_ad5x_setup.h"
+#include "helix_fs.h"
 #include "detection_manager.h"
 #include "filament_sensor_manager.h"
 #include "gcode_file_modifier.h"
@@ -1818,8 +1820,24 @@ bool Application::init_translations() {
 }
 
 bool Application::run_wizard() {
+    // A SETUP_WIZARD from Klipper while the screen runs opens the AD5X steps.
+    helix::ad5x_setup::watch_wizard_requests();
+
+    // A firmware-written flag file (HELIX_WIZARD_FLAG_FILE, set by the AD5X
+    // start script) asks for one more wizard run. Unlike --wizard it keeps the
+    // preset, the host and the hardware selections: the run repeats the setup
+    // and tuning steps without turning a pre-configured printer back into an
+    // unknown one.
+    const char* flag_env = std::getenv("HELIX_WIZARD_FLAG_FILE");
+    const std::string rerun_flag = flag_env ? flag_env : "";
+    const bool rerun_requested = !rerun_flag.empty() && helix::fs::exists(rerun_flag);
+    if (rerun_requested) {
+        spdlog::info("[Application] Wizard re-run requested by {}", rerun_flag);
+    }
+
     bool wizard_required =
-        (m_args.force_wizard || m_config->is_wizard_required()) && !m_args.skip_wizard;
+        (m_args.force_wizard || rerun_requested || m_config->is_wizard_required()) &&
+        !m_args.skip_wizard;
 
     if (!wizard_required) {
         return false;
@@ -1872,6 +1890,10 @@ bool Application::run_wizard() {
         spdlog::error("[Application] Failed to create wizard");
         return false;
     }
+    // One run per request: a crash or power cut mid-wizard does not repeat it.
+    if (rerun_requested && !helix::fs::remove(rerun_flag)) {
+        spdlog::warn("[Application] Could not remove {}", rerun_flag);
+    }
 
     // Determine initial wizard step (step 0 = touch calibration, auto-skipped if not needed)
     int initial_step = (m_args.wizard_step >= 0) ? m_args.wizard_step : 0;
-- 
