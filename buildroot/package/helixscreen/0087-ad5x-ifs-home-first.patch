+TEST_CASE("AD5X IFS module leaves homing an unhomed printer to Kiln's module",
+          "[ams][ad5x_ifs][ifs_module]") {
+    // After a Klipper restart nothing is homed. The module's IFS_LOAD,
+    // IFS_UNLOAD, IFS_EJECT and IFS_TUNE take HOME=1: Kiln's module homes an
+    // idle printer itself, inside the operation, and refuses during a print or
+    // pause. Without it an unload only drew "IFS: home the printer first
+    // (G28)". No G28 of ours, so there is one homing path and the screen shows
+    // it ("Homing first...").
+    TestableModuleBackend backend;
+    Ad5xIfsTestAccess::set_running(backend, true);
+    Ad5xIfsTestAccess::handle_status(backend, module_ifs_frame(2, {1, 2}));
+    Ad5xIfsTestAccess::set_head_filament(backend, true);
+    REQUIRE(backend.get_current_slot() == 1);
+    backend.homed = false;
+    backend.captured_gcodes.clear();
+
+    SECTION("load") {
+        REQUIRE(backend.load_filament(2).success());
+        CHECK(backend.captured_gcodes == std::vector<std::string>{"IFS_LOAD SLOT=3 HOME=1"});
+    }
+    SECTION("toolhead unload") {
+        REQUIRE(backend.unload_filament(1).success());
+        CHECK(backend.captured_gcodes == std::vector<std::string>{"IFS_UNLOAD SLOT=2 HOME=1"});
+    }
+    SECTION("eject") {
+        REQUIRE(backend.eject_lane(0).success());
+        CHECK(backend.captured_gcodes == std::vector<std::string>{"IFS_EJECT SLOT=1 HOME=1"});
+    }
+}
