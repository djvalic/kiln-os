diff --git a/src/platform/input/touch_calibration_wrapper.cpp b/src/platform/input/touch_calibration_wrapper.cpp
index 6040cb1b90..bf9b0b7554 100644
--- a/src/platform/input/touch_calibration_wrapper.cpp
+++ b/src/platform/input/touch_calibration_wrapper.cpp
@@ -7,6 +7,8 @@
 #include "helix_display_telemetry.h"
 #include "pointer_frame_hook.h"
 
+#include "lvgl/src/indev/lv_indev_private.h" // pointer.act_obj: no public getter outside dispatch
+
 #include <spdlog/fmt/fmt.h>
 #include <spdlog/spdlog.h>
 
@@ -140,6 +142,57 @@ void note_raw_sample(CalibrationContext& ctx, int raw_x, int raw_y) {
     helix_display_telemetry_error("display", "touch-range-declared-too-narrow", detail.c_str());
 }
 
+/// The hold-to-calibrate gesture (set_calibration_hold_handler). LVGL thread only.
+struct CalibrationHold {
+    std::function<bool()> handler;
+    bool down = false;          ///< A press is being timed
+    uint32_t down_since = 0;    ///< When it started
+    uint32_t last_pressed = 0;  ///< Last read that reported a press
+    bool fired = false;         ///< Fired; waiting for a quiet panel to re-arm
+};
+CalibrationHold s_hold;
+
+/// Time a press for the hold gesture. Runs on every read, ahead of LVGL's
+/// processing of it, so ending the press here keeps it from reaching a widget.
+void track_calibration_hold(lv_indev_t* indev, const lv_indev_data_t* data) {
+    if (!s_hold.handler) {
+        return;
+    }
+    const uint32_t now = lv_tick_get();
+    if (data->state == LV_INDEV_STATE_PRESSED) {
+        if (!s_hold.down) {
+            s_hold.down = true;
+            s_hold.down_since = now;
+        }
+        s_hold.last_pressed = now;
+    } else if (s_hold.down && lv_tick_diff(now, s_hold.last_pressed) >= kCalibrationHoldGapMs) {
+        s_hold.down = false;
+    }
+
+    if (s_hold.fired) {
+        if (!s_hold.down && lv_tick_diff(now, s_hold.last_pressed) >= kCalibrationHoldRearmMs) {
+            s_hold.fired = false;
+        }
+        return;
+    }
+    if (!s_hold.down || data->state != LV_INDEV_STATE_PRESSED ||
+        lv_tick_diff(now, s_hold.down_since) < kCalibrationHoldMs) {
+        return;
+    }
+    s_hold.fired = true;
+    if (!s_hold.handler()) {
+        return;
+    }
+    spdlog::info("[TouchCal] Screen held {} s: opening touch calibration",
+                 kCalibrationHoldMs / 1000);
+    // The widget under the finger loses the press now (a jog pad stops its hold
+    // repeat on PRESS_LOST), and the release that follows is not a click.
+    if (lv_obj_t* obj = indev->pointer.act_obj) {
+        lv_obj_send_event(obj, LV_EVENT_PRESS_LOST, indev);
+    }
+    lv_indev_wait_release(indev);
+}
+
 /// A driver point with the calibration in @p ctx applied. The point is PANEL space,
 /// ahead of lv_display_rotate_point(); the affine was solved against logical,
 /// post-rotation targets, so it is placed rather than applied directly.
@@ -196,6 +249,8 @@ void calibrated_read_cb(lv_indev_t* indev, lv_indev_data_t* data) {
         }
     }
 
+    track_calibration_hold(indev, data);
+
     // Apply affine calibration if valid (for both PRESSED and RELEASED states)
     if (ctx->calibration.valid) {
         helix::Point raw{static_cast<int>(data->point.x), static_cast<int>(data->point.y)};
@@ -214,6 +269,11 @@ void calibrated_read_cb(lv_indev_t* indev, lv_indev_data_t* data) {
     }
 }
 
+void set_calibration_hold_handler(std::function<bool()> handler) {
+    s_hold = CalibrationHold{};
+    s_hold.handler = std::move(handler);
+}
