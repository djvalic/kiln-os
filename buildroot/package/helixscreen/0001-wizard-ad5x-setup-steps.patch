+namespace helix::ad5x_setup {
+
+/// What the step card shows; drives button visibility through ad5x_setup_view.
+enum class View {
+    Idle = 0,        ///< Not started: Start
+    Running = 1,     ///< Step running: Abort
+    WaitingUser = 2, ///< Z offset print waiting for the user: -/+, Accept, Abort
+    Done = 3,        ///< Finished: results, Run again
+    Failed = 4,      ///< Failed or aborted: message, Retry
+};
+
+/// Static description of one tuning step.
+struct StepSpec {
+    wizard::StepId id;
+    const char* key;            ///< STEP= value and key in `results`
+    const char* component;      ///< XML component (carries the title consts)
+    const char* explanation;    ///< Untranslated explanation shown above the controls
+    bool restarts_klipper;      ///< The step may run SAVE_CONFIG
+};
+
+/// The tuning steps in wizard order.
+const std::vector<StepSpec>& step_specs();
+
+/// Spec for @p id, or nullptr when @p id is not an AD5X tuning step.
+const StepSpec* spec_for(wizard::StepId id);
+
+/// The tuning steps' ids in wizard order (for a targeted wizard session).
+std::vector<wizard::StepId> step_ids();
+
+/// Whether the printer has the AD5X setup steps: the `ad5x` preset is set for
+/// the active printer, or Klipper publishes an `ad5x_setup` object.
+bool available(const wizard::StepContext& ctx);
+
+/// available() with a context built from the live config and API.
+bool available();
+
+/// The card view for one step, from the status object's step/state and what
+/// the screen itself knows (a start in flight, an rpc error).
+View view_for(const std::string& key, const std::string& status_step,
+              const std::string& status_state, bool start_in_flight, bool local_error);
+
+/// Shared subjects, the cached `ad5x_setup` status and the command plumbing.
+class Ad5xSetupModel {
+  public:
+    Ad5xSetupModel() = default;
+    ~Ad5xSetupModel();
+    Ad5xSetupModel(const Ad5xSetupModel&) = delete;
+    Ad5xSetupModel& operator=(const Ad5xSetupModel&) = delete;
+
+    void init_subjects();
+
+    /// Show @p spec's card: subscribe, query the current status, refresh.
+    void activate(const StepSpec* spec);
+    /// The card is going away; abort a step still running on the printer.
+    void deactivate();
+
+    void start();
+    void abort();
+    void adjust(double delta_mm);
+    void accept();
+
+  private:
+    void send(const std::string& action, double delta = 0.0);
+    void send_gcode(const std::string& key, const std::string& action, double delta);
+    json step_options() const;
+    void query_status();
+    void merge_status(const json& delta);
+    void refresh();
+    void update_footer(View view);
+    std::string results_text() const;
+
+    SubjectManager subjects_;
+    lv_subject_t view_{};
+    lv_subject_t is_zoffset_{};
+    lv_subject_t progress_{};
+    lv_subject_t explanation_{};
+    lv_subject_t message_{};
+    lv_subject_t results_{};
+    lv_subject_t zoffset_{};
+    char explanation_buf_[512] = "";
+    char message_buf_[256] = "";
+    char results_buf_[1536] = "";
+    char zoffset_buf_[48] = "";
+    bool subjects_initialized_ = false;
+
+    const StepSpec* active_ = nullptr;
+    json status_ = json::object();
+    bool start_in_flight_ = false;
+    std::string local_error_;
+
+    bool klippy_ready_ = true;
+
+    SubscriptionGuard subscription_;
+    ObserverGuard klippy_observer_;
+    AsyncLifetimeGuard lifetime_;
+};
+
+Ad5xSetupModel& model();
+
+/// Run the AD5X tuning steps again as a targeted wizard session on @p parent
+/// (the settings entry). Does not touch wizard_completed.
+void launch_targeted(lv_obj_t* parent);
+
+/// Open the AD5X steps when Klipper's SETUP_WIZARD announces
+/// `// action:ad5x_setup_wizard`, and drop the start-up flag file it wrote
+/// (HELIX_WIZARD_FLAG_FILE), which this run then answers. Idempotent per client.
+void watch_wizard_requests();
+
+} // namespace helix::ad5x_setup
