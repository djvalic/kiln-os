+// ============================================================================
+// Step
+// ============================================================================
+
+using helix::ad5x_setup::model;
+
+WizardAd5xSetupStep* get_wizard_ad5x_setup_step(helix::wizard::StepId id) {
+    auto& steps = helix::ad5x_setup::owner().steps;
+    for (auto& step : steps) {
+        if (step->id() == id) {
+            return step.get();
+        }
+    }
+    return steps.front().get();
+}
+
+bool WizardAd5xSetupStep::should_skip(const helix::wizard::StepContext& ctx) const {
+    return !helix::ad5x_setup::available(ctx);
+}
+
+void WizardAd5xSetupStep::init_subjects() {
+    model().init_subjects();
+}
+
+static void on_ad5x_setup_start(lv_event_t* /*e*/) {
+    LVGL_SAFE_EVENT_CB_BEGIN("[AD5X setup] on_start");
+    model().start();
+    LVGL_SAFE_EVENT_CB_END();
+}
+
+static void on_ad5x_setup_abort(lv_event_t* /*e*/) {
+    LVGL_SAFE_EVENT_CB_BEGIN("[AD5X setup] on_abort");
+    model().abort();
+    LVGL_SAFE_EVENT_CB_END();
+}
+
+static void on_ad5x_setup_adjust(lv_event_t* e) {
+    LVGL_SAFE_EVENT_CB_BEGIN("[AD5X setup] on_adjust");
+    const char* delta = static_cast<const char*>(lv_event_get_user_data(e));
+    if (delta) {
+        model().adjust(std::strtod(delta, nullptr));
+    }
+    LVGL_SAFE_EVENT_CB_END();
+}
+
+static void on_ad5x_setup_accept(lv_event_t* /*e*/) {
+    LVGL_SAFE_EVENT_CB_BEGIN("[AD5X setup] on_accept");
+    model().accept();
+    LVGL_SAFE_EVENT_CB_END();
+}
+
+void WizardAd5xSetupStep::register_callbacks() {
+    lv_xml_register_event_cb(nullptr, "on_ad5x_setup_start", on_ad5x_setup_start);
+    lv_xml_register_event_cb(nullptr, "on_ad5x_setup_abort", on_ad5x_setup_abort);
+    lv_xml_register_event_cb(nullptr, "on_ad5x_setup_adjust", on_ad5x_setup_adjust);
+    lv_xml_register_event_cb(nullptr, "on_ad5x_setup_accept", on_ad5x_setup_accept);
+}
+
+lv_obj_t* WizardAd5xSetupStep::create(lv_obj_t* parent) {
+    root_ = static_cast<lv_obj_t*>(lv_xml_create(parent, spec_.component, nullptr));
+    if (!root_) {
+        spdlog::error("[AD5X setup] Failed to create '{}'", spec_.component);
+        return nullptr;
+    }
+    if (spec_.restarts_klipper) {
+        // The save step restarts Klipper: say so on its button
+        if (lv_obj_t* btn = lv_obj_find_by_name(root_, "btn_ad5x_start")) {
+            ui_button_set_text(btn, lv_tr("Save & Restart"));
+        }
+    }
+    model().activate(&spec_);
+    return root_;
+}
+
+void WizardAd5xSetupStep::cleanup() {
+    model().deactivate();
+    root_ = nullptr;
+}
