+
+using wizard::StepId;
+
+/// Every action goes through Klipper's API endpoint, which answers at once
+/// (the step runs in the background) and works while a long command such as
+/// PID_CALIBRATE or M109 holds the G-code lock.
+constexpr const char* CONTROL_METHOD = "printer.ad5x_setup.control";
+constexpr uint32_t CONTROL_TIMEOUT_MS = 30u * 1000u;
+/// G-code fallback for a Moonraker that does not forward the endpoint.
+constexpr const char* GCODE_COMMAND = "SETUP_WIZARD_STEP";
+
+const std::vector<StepSpec> k_specs = {
+    {StepId::Ad5xSelfcheck, "selfcheck", "wizard_ad5x_selfcheck",
+     "Checks the boards, IFS, accelerometer, bed scale, filament sensor and fans, homes, and "
+     "heats nozzle and bed briefly. Fans and heaters each run for about 10 seconds and switch "
+     "off again.",
+     false},
+    {StepId::Ad5xPid, "pid", "wizard_ad5x_pid",
+     "Tunes the heater control: the nozzle at 220 \xC2\xB0"
+     "C with the part fan running, then the bed at 60 \xC2\xB0"
+     "C. Takes 10 to 20 minutes; stay near the printer.",
+     false},
+    {StepId::Ad5xMesh, "mesh", "wizard_ad5x_mesh",
+     "Heats the bed to 60 \xC2\xB0"
+     "C and probes the whole bed to measure its shape. Keep the bed clear. The bed stays warm "
+     "for the Z offset test that follows.",
+     false},
+    {StepId::Ad5xShaper, "shaper", "wizard_ad5x_shaper",
+     "Measures the frame's vibrations with the toolhead accelerometer and sets vibration "
+     "compensation. The printer is loud for a few minutes.",
+     false},
