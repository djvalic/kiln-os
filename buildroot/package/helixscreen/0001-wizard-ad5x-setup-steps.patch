+
+std::string str_field(const json& obj, const char* key) {
+    auto it = obj.find(key);
+    if (it == obj.end() || !it->is_string()) {
+        return {};
+    }
+    return it->get<std::string>();
+}
+
+std::string result_string(const json& value) {
+    if (value.is_string()) {
+        return value.get<std::string>();
+    }
+    if (value.is_null()) {
+        return {};
+    }
+    return value.dump();
+}
+
+void copy_if_changed(lv_subject_t* subject, const std::string& text) {
+    const char* cur = lv_subject_get_string(subject);
+    if (!cur || text != cur) {
+        lv_subject_copy_string(subject, text.c_str());
+    }
+}
+
+void set_if_changed(lv_subject_t* subject, int value) {
+    if (lv_subject_get_int(subject) != value) {
+        lv_subject_set_int(subject, value);
+    }
+}
