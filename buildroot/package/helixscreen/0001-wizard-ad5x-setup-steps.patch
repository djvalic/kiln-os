+/**
+ * @file ui_wizard_ad5x_setup.h
+ * @brief AD5X tuning steps of the setup wizard (self-check, PID, bed mesh,
+ *        vibration compensation, IFS tuning, Z offset, save)
+ *
+ * One data-driven step class, instantiated once per tuning step. Each step
+ * drives the printer's setup steps (Klipper API `printer.ad5x_setup.control`,
+ * G-code `SETUP_WIZARD_STEP` as fallback) and shows
+ * the `ad5x_setup` Klipper status object (state, message, progress, results,
+ * self-check list, live z offset). The steps exist only for printers that have
+ * that object or carry the `ad5x` preset; every other printer skips them.
+ *
+ * All seven steps share one set of subjects (only one step is on screen at a
+ * time), owned by Ad5xSetupModel together with the status cache and the
+ * Moonraker subscription.
+ */
+
+#include "ui_observer_guard.h"
+#include "ui_subscription_guard.h"
+
+#include "async_lifetime_guard.h"
+#include "json_fwd.h"
+#include "lvgl/lvgl.h"
+#include "subject_managed_panel.h"
