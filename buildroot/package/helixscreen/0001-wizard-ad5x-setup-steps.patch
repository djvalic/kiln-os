diff --git a/ui_xml/wizard_ad5x_setup.xml b/ui_xml/wizard_ad5x_setup.xml
new file mode 100644
index 0000000000..75bd4e9cf7
--- /dev/null
+++ b/ui_xml/wizard_ad5x_setup.xml
@@ -0,0 +1,103 @@
+<?xml version="1.0"?>
+<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
+<component>
+  <!-- First-Run Wizard: body shared by the AD5X tuning steps (self-check, PID,
+       bed mesh, vibration, IFS, Z offset, save). Each step's own component
+       (wizard_ad5x_<step>.xml) carries its title and embeds this. All data comes
+       from the ad5x_setup_* subjects (ui_wizard_ad5x_setup.cpp), driven by the
+       printer's ad5x_setup status object.
+       ad5x_setup_view: 0 idle, 1 running, 2 waiting for the user, 3 done, 4 failed -->
+  <view name="wizard_ad5x_setup_root"
+        extends="lv_obj" width="100%" height="content" style_bg_opa="0" style_border_width="0"
+        style_pad_all="0" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="center"
+        scrollable="false">
+
+    <ui_card width="100%"
+             height="content" style_radius="#border_radius" style_pad_all="#space_lg" style_pad_gap="#space_md"
+             flex_flow="column" style_flex_main_place="start" style_flex_cross_place="center" scrollable="false">
+
+      <text_body width="100%" bind_text="ad5x_setup_explanation" long_mode="wrap" style_text_align="center"/>
+
+      <!-- Status line and progress -->
+      <text_body width="100%" bind_text="ad5x_setup_message" long_mode="wrap" style_text_align="center">
+        <bind_flag_if_eq subject="ad5x_setup_view" flag="hidden" ref_value="0"/>
+      </text_body>
+      <progress_bar name="ad5x_setup_progress_bar" width="80%" bind_value="ad5x_setup_progress">
+        <bind_flag_if cond="ad5x_setup_view ne 1 and ad5x_setup_view ne 2" flag="hidden"/>
+      </progress_bar>
+
+      <!-- Z offset: live baby-stepping while the test patch prints -->
+      <lv_obj name="ad5x_zoffset_panel"
+              width="100%" height="content" style_pad_all="0" style_pad_gap="#space_sm" style_bg_opa="0"
+              style_border_width="0" flex_flow="column" style_flex_cross_place="center" scrollable="false">
+        <bind_flag_if cond="ad5x_setup_is_zoffset eq 0 or ad5x_setup_view ne 2" flag="hidden"/>
+        <text_heading width="100%" bind_text="ad5x_setup_zoffset" style_text_align="center"/>
+        <lv_obj width="100%"
+                height="content" style_pad_all="0" style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0"
+                flex_flow="row" style_flex_main_place="center" scrollable="false">
+          <ui_button name="btn_ad5x_z_down_005" flex_grow="1" height="#button_height" text="-0.05">
+            <event_cb trigger="clicked" callback="on_ad5x_setup_adjust" user_data="-0.05"/>
+          </ui_button>
+          <ui_button name="btn_ad5x_z_down_001" flex_grow="1" height="#button_height" text="-0.01">
+            <event_cb trigger="clicked" callback="on_ad5x_setup_adjust" user_data="-0.01"/>
+          </ui_button>
+          <ui_button name="btn_ad5x_z_up_001" flex_grow="1" height="#button_height" text="+0.01">
+            <event_cb trigger="clicked" callback="on_ad5x_setup_adjust" user_data="0.01"/>
+          </ui_button>
+          <ui_button name="btn_ad5x_z_up_005" flex_grow="1" height="#button_height" text="+0.05">
+            <event_cb trigger="clicked" callback="on_ad5x_setup_adjust" user_data="0.05"/>
+          </ui_button>
+        </lv_obj>
+        <text_small width="100%"
+                    text="- moves the nozzle closer to the bed (more squish), + moves it away."
+                    long_mode="wrap" style_text_align="center" style_text_color="#text_muted"/>
+      </lv_obj>
+
+      <!-- Actions -->
+      <lv_obj width="100%"
+              height="content" style_pad_all="0" style_pad_gap="#space_md" style_bg_opa="0" style_border_width="0"
+              flex_flow="row" style_flex_main_place="center" scrollable="false">
+        <ui_button name="btn_ad5x_start" width="#wizard_button_width" height="#button_height" text="Start">
+          <event_cb trigger="clicked" callback="on_ad5x_setup_start"/>
+          <bind_flag_if_not_eq subject="ad5x_setup_view" flag="hidden" ref_value="0"/>
+        </ui_button>
+        <ui_button name="btn_ad5x_retry" width="#wizard_button_width" height="#button_height" text="Retry">
+          <event_cb trigger="clicked" callback="on_ad5x_setup_start"/>
+          <bind_flag_if_not_eq subject="ad5x_setup_view" flag="hidden" ref_value="4"/>
+        </ui_button>
+        <ui_button name="btn_ad5x_rerun" width="#wizard_button_width" height="#button_height" text="Run Again"
+                   variant="ghost">
+          <event_cb trigger="clicked" callback="on_ad5x_setup_start"/>
+          <bind_flag_if_not_eq subject="ad5x_setup_view" flag="hidden" ref_value="3"/>
+        </ui_button>
+        <!-- Z offset: Start again while waiting prints another patch beside the first -->
+        <ui_button name="btn_ad5x_another" width="#wizard_button_width" height="#button_height"
+                   text="New Patch" variant="secondary">
+          <event_cb trigger="clicked" callback="on_ad5x_setup_start"/>
+          <bind_flag_if cond="ad5x_setup_is_zoffset eq 0 or ad5x_setup_view ne 2" flag="hidden"/>
+        </ui_button>
+        <ui_button name="btn_ad5x_accept" width="#wizard_button_width" height="#button_height" text="Accept"
+                   variant="success">
+          <event_cb trigger="clicked" callback="on_ad5x_setup_accept"/>
+          <bind_flag_if cond="ad5x_setup_is_zoffset eq 0 or ad5x_setup_view ne 2" flag="hidden"/>
+        </ui_button>
+        <ui_button name="btn_ad5x_abort" width="#wizard_button_width" height="#button_height" text="Abort"
+                   variant="danger">
+          <event_cb trigger="clicked" callback="on_ad5x_setup_abort"/>
+          <bind_flag_if cond="ad5x_setup_view ne 1 and ad5x_setup_view ne 2" flag="hidden"/>
+        </ui_button>
+      </lv_obj>
+
+      <!-- Results (self-check list, tuned values, the save step's overview) -->
+      <text_small width="100%" bind_text="ad5x_setup_results" long_mode="wrap" style_text_align="left">
+        <bind_flag_if_eq subject="ad5x_setup_view" flag="hidden" ref_value="0"/>
+      </text_small>
+
+      <text_small width="100%"
+                  text="Skip leaves this step out; you can run it later from Settings." long_mode="wrap"
+                  style_text_align="center" style_text_color="#text_muted">
+        <bind_flag_if_not_eq subject="ad5x_setup_view" flag="hidden" ref_value="0"/>
+      </text_small>
+    </ui_card>
+  </view>
+</component>
