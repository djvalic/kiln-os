+// ============================================================================
+// Model
+// ============================================================================
+
+Ad5xSetupModel::~Ad5xSetupModel() {
+    lifetime_.invalidate();
+    subscription_.reset();
+    klippy_observer_.reset();
+    subjects_.deinit_all();
+}
+
+void Ad5xSetupModel::init_subjects() {
+    if (subjects_initialized_) {
+        return;
+    }
+    UI_MANAGED_SUBJECT_INT(view_, 0, "ad5x_setup_view", subjects_);
+    UI_MANAGED_SUBJECT_INT(is_zoffset_, 0, "ad5x_setup_is_zoffset", subjects_);
+    UI_MANAGED_SUBJECT_INT(progress_, 0, "ad5x_setup_progress", subjects_);
+    UI_MANAGED_SUBJECT_STRING(explanation_, explanation_buf_, "", "ad5x_setup_explanation",
+                              subjects_);
+    UI_MANAGED_SUBJECT_STRING(message_, message_buf_, "", "ad5x_setup_message", subjects_);
+    UI_MANAGED_SUBJECT_STRING(results_, results_buf_, "", "ad5x_setup_results", subjects_);
+    UI_MANAGED_SUBJECT_STRING(zoffset_, zoffset_buf_, "", "ad5x_setup_zoffset", subjects_);
+    subjects_initialized_ = true;
+}
+
+void Ad5xSetupModel::activate(const StepSpec* spec) {
+    active_ = spec;
+    start_in_flight_ = false;
+    local_error_.clear();
+
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (api) {
+        const auto token = lifetime_.token();
+        // Runs on the WebSocket thread: copy the object out, apply it on the main thread.
+        const SubscriptionId id = api->subscribe_notifications([this, token](const json& note) {
+            auto params = note.find("params");
+            if (params == note.end() || !params->is_array() || params->empty()) {
+                return;
+            }
+            const json& status = (*params)[0];
+            if (!status.is_object()) {
+                return;
+            }
+            auto obj = status.find("ad5x_setup");
+            if (obj == status.end() || !obj->is_object()) {
+                return;
+            }
+            json delta = *obj;
+            token.defer("Ad5xSetupModel::status_update", [this, delta]() {
+                merge_status(delta);
+                refresh();
+            });
+        });
+        subscription_ = SubscriptionGuard(api, id);
+    }
+
+    if (!klippy_observer_) {
+        klippy_observer_ = ui::observe<int>(
+            get_printer_state().network_state().get_klippy_state_subject(), this,
+            [](Ad5xSetupModel* self, int state) {
+                self->klippy_ready_ = static_cast<KlippyState>(state) == KlippyState::READY;
+                // Results and the finish step's outcome survive Klipper's restart.
+                if (self->klippy_ready_ && self->active_) {
+                    self->query_status();
+                }
+                self->refresh();
+            },
+            get_printer_state().get_subjects_lifetime());
+    }
+
+    if (subjects_initialized_ && spec) {
+        copy_if_changed(&explanation_, lv_tr(spec->explanation));
+        set_if_changed(&is_zoffset_, std::strcmp(spec->key, "zoffset") == 0 ? 1 : 0);
+    }
+    query_status();
+    refresh();
+}
+
+void Ad5xSetupModel::deactivate() {
+    if (active_ && subjects_initialized_) {
+        const View v = static_cast<View>(lv_subject_get_int(&view_));
+        // Leaving a step that is still heating, moving or printing stops it.
+        // The save step is left alone: a SAVE_CONFIG must not be cut short.
+        if ((v == View::Running || v == View::WaitingUser) && !active_->restarts_klipper) {
+            spdlog::info("[AD5X setup] Leaving step '{}' while it runs: aborting", active_->key);
+            abort();
+        }
+    }
+    active_ = nullptr;
+    start_in_flight_ = false;
+    local_error_.clear();
+    subscription_.reset();
+    lv_subject_set_int(&wizard_show_skip, 0);
+    lv_subject_set_int(&connection_test_passed, 1);
+}
+
+json Ad5xSetupModel::step_options() const {
+    json options = json::object();
+    if (!active_) {
+        return options;
+    }
+    // The mesh step keeps the bed hot when the Z offset test comes next.
+    if (std::strcmp(active_->key, "mesh") == 0) {
+        const auto& ids = ui_wizard_active_step_subset();
+        const bool zoffset_follows =
+            ids.empty() ? available()
+                        : std::find(ids.begin(), ids.end(), StepId::Ad5xZoffset) != ids.end();
+        if (zoffset_follows) {
+            options["keep_bed"] = 1;
+        }
+    }
+    return options;
+}
+
+void Ad5xSetupModel::send(const std::string& action, double delta) {
+    if (!active_) {
+        return;
+    }
+    const std::string key = active_->key;
+    const bool is_start = action == "start";
+    IMoonrakerClient* client = get_moonraker_client();
+    if (!client || client->get_connection_state() != ConnectionState::CONNECTED) {
+        if (is_start) {
+            start_in_flight_ = false;
+            local_error_ = lv_tr("Not connected to the printer");
+        }
+        refresh();
+        return;
+    }
+
+    json params = {{"step", key}, {"action", action}};
+    if (action == "adjust") {
+        params["delta"] = delta;
+    }
+    if (is_start) {
+        const json options = step_options();
+        for (auto it = options.begin(); it != options.end(); ++it) {
+            params[it.key()] = it.value();
+        }
+    }
+    spdlog::info("[AD5X setup] {} {}", CONTROL_METHOD, params.dump());
+
+    const auto token = lifetime_.token();
+    client->send_jsonrpc(
+        CONTROL_METHOD, params,
+        [this, token, is_start](const json& /*reply*/) {
+            token.defer("Ad5xSetupModel::control_done", [this, is_start]() {
+                if (is_start) {
+                    start_in_flight_ = false;
+                }
+                query_status();
+                refresh();
+            });
+        },
+        [this, token, key, action, delta, is_start](const MoonrakerError& err) {
+            const int code = err.code;
+            const std::string message = err.message;
+            token.defer("Ad5xSetupModel::control_error", [this, key, action, delta, is_start,
+                                                          code, message]() {
+                // Moonraker without the endpoint: same action as G-code.
+                if (code == -32601 || code == 404) {
+                    spdlog::warn("[AD5X setup] {} not available ({}), using G-code",
+                                 CONTROL_METHOD, message);
+                    send_gcode(key, action, delta);
+                    return;
+                }
+                if (is_start) {
+                    start_in_flight_ = false;
+                    if (active_ && key == active_->key) {
+                        local_error_ = message.empty() ? std::string(lv_tr("Failed")) : message;
+                    }
+                } else {
+                    NOTIFY_WARNING("{}", message);
+                }
+                spdlog::warn("[AD5X setup] {} {} failed: {}", key, action, message);
+                query_status();
+                refresh();
+            });
+        },
+        CONTROL_TIMEOUT_MS, /*silent=*/true);
+}
+
+void Ad5xSetupModel::send_gcode(const std::string& key, const std::string& action,
+                                double delta) {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api) {
+        return;
+    }
+    std::string cmd = fmt::format("{} STEP={} ACTION={}", GCODE_COMMAND, key, action);
+    if (action == "adjust") {
+        cmd += fmt::format(" DELTA={:.3f}", delta);
+    }
+    if (action == "start") {
+        const json options = step_options();
+        for (auto it = options.begin(); it != options.end(); ++it) {
+            std::string name = it.key();
+            std::transform(name.begin(), name.end(), name.begin(), ::toupper);
+            cmd += fmt::format(" {}={}", name, it.value().dump());
+        }
+    }
+    spdlog::info("[AD5X setup] {}", cmd);
+    const auto token = lifetime_.token();
+    const bool is_start = action == "start";
+    api->execute_gcode(
+        cmd,
+        [this, token, is_start]() {
+            token.defer("Ad5xSetupModel::gcode_done", [this, is_start]() {
+                if (is_start) {
+                    start_in_flight_ = false;
+                }
+                query_status();
+                refresh();
+            });
+        },
+        [this, token, is_start, key](const MoonrakerError& err) {
+            const std::string message = err.message;
+            token.defer("Ad5xSetupModel::gcode_error", [this, is_start, key, message]() {
+                if (is_start) {
+                    start_in_flight_ = false;
+                    if (active_ && key == active_->key) {
+                        local_error_ = message;
+                    }
+                }
+                query_status();
+                refresh();
+            });
+        },
+        IMoonrakerAPI::kMacroTimeoutMs, /*silent=*/false, /*on_queued=*/nullptr,
+        /*caller_surfaces_errors=*/true);
+}
+
+void Ad5xSetupModel::start() {
+    if (!active_) {
+        return;
+    }
+    if (active_->restarts_klipper) {
+        // Finish runs SAVE_CONFIG or RESTART when something is pending; a
+        // restart nobody prepared for shows the disconnect and recovery dialogs.
+        auto it = status_.find("pending_save");
+        const bool pending = it == status_.end() || !it->is_boolean() || it->get<bool>();
+        if (pending) {
+            helix::ui::begin_expected_klippy_restart(
+                "Saving setup results... Klipper will restart.");
+        }
+    }
+    start_in_flight_ = true;
+    local_error_.clear();
+    refresh();
+    send("start");
+}
+
+void Ad5xSetupModel::abort() {
+    send("abort");
+}
+
+void Ad5xSetupModel::adjust(double delta_mm) {
+    send("adjust", delta_mm);
+}
