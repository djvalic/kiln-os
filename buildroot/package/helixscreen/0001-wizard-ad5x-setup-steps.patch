+
+void Ad5xSetupModel::query_status() {
+    IMoonrakerClient* client = get_moonraker_client();
+    if (!client || client->get_connection_state() != ConnectionState::CONNECTED) {
+        return;
+    }
+    const auto token = lifetime_.token();
+    json params = {{"objects", {{"ad5x_setup", nullptr}}}};
+    client->send_jsonrpc(
+        "printer.objects.query", params,
+        [this, token](const json& response) {
+            auto result = response.find("result");
+            if (result == response.end() || !result->is_object()) {
+                return;
+            }
+            auto status = result->find("status");
+            if (status == result->end() || !status->is_object()) {
+                return;
+            }
+            auto obj = status->find("ad5x_setup");
+            if (obj == status->end() || !obj->is_object()) {
+                return;
+            }
+            json full = *obj;
+            token.defer("Ad5xSetupModel::status_query", [this, full]() {
+                status_ = full;
+                refresh();
+            });
+        },
+        [](const MoonrakerError& err) {
+            spdlog::debug("[AD5X setup] ad5x_setup query failed: {}", err.message);
+        },
+        0, /*silent=*/true);
+}
+
+void Ad5xSetupModel::merge_status(const json& delta) {
+    if (!status_.is_object()) {
+        status_ = json::object();
+    }
+    for (auto it = delta.begin(); it != delta.end(); ++it) {
+        status_[it.key()] = it.value();
+    }
+}
+
+std::string Ad5xSetupModel::results_text() const {
+    if (!active_) {
+        return {};
+    }
+    const std::string key = active_->key;
+    json results = json::object();
+    if (auto it = status_.find("results"); it != status_.end() && it->is_object()) {
+        results = *it;
+    }
+
+    std::string out;
+    auto add_line = [&out](const std::string& line) {
+        if (!out.empty()) {
+            out += '\n';
+        }
+        out += line;
+    };
+
+    if (key == "selfcheck") {
+        if (auto it = status_.find("checks"); it != status_.end() && it->is_array()) {
+            for (const auto& check : *it) {
+                if (!check.is_object()) {
+                    continue;
+                }
+                auto ok_it = check.find("ok");
+                const bool ok = ok_it != check.end() && ok_it->is_boolean() && ok_it->get<bool>();
+                // A failed optional item (e.g. a fan without a tachometer) is a warning.
+                auto req_it = check.find("required");
+                const bool required =
+                    req_it == check.end() || !req_it->is_boolean() || req_it->get<bool>();
+                const char* mark = ok ? lv_tr("OK") : required ? lv_tr("FAIL") : lv_tr("WARN");
+                std::string line = fmt::format("{}  {}", mark, str_field(check, "name"));
+                const std::string detail = str_field(check, "detail");
+                if (!detail.empty()) {
+                    line += " - " + detail;
+                }
+                add_line(line);
+            }
+        }
+    }
+
+    if (active_->restarts_klipper) {
+        // The save step sums up everything that ran.
+        for (const auto& label : k_result_labels) {
+            auto it = results.find(label.key);
+            if (it == results.end()) {
+                continue;
+            }
+            const std::string text = result_string(*it);
+            if (!text.empty()) {
+                add_line(fmt::format("{}: {}", lv_tr(label.label), text));
+            }
+        }
+        return out;
+    }
+
+    if (auto it = results.find(key); it != results.end()) {
+        const std::string text = result_string(*it);
+        if (!text.empty()) {
+            add_line(text);
+        }
+    }
+    return out;
+}
+
+void Ad5xSetupModel::update_footer(View view) {
+    // Skip while nothing ran (or it failed); Next once done; neither while running.
+    lv_subject_set_int(&wizard_show_skip, (view == View::Idle || view == View::Failed) ? 1 : 0);
+    lv_subject_set_int(&connection_test_passed,
+                       (view == View::Running || view == View::WaitingUser) ? 0 : 1);
+}
+
+void Ad5xSetupModel::refresh() {
+    if (!subjects_initialized_ || !active_) {
+        return;
+    }
+    const std::string key = active_->key;
+    const std::string st_step = str_field(status_, "step");
+    const std::string st_state = str_field(status_, "state");
+    const bool mine = st_step == key;
+
+    View view = view_for(key, st_step, st_state, start_in_flight_, !local_error_.empty());
+
+    std::string message;
+    if (active_->restarts_klipper && view == View::Running && !klippy_ready_) {
+        message = lv_tr("Saving... Klipper is restarting.");
+    } else if (view == View::Failed && !local_error_.empty() &&
+               !(mine && (st_state == "failed" || st_state == "aborted"))) {
+        message = local_error_;
+    } else if (mine) {
+        message = str_field(status_, "message");
+    }
+    if (message.empty() && view == View::Running) {
+        message = lv_tr("Starting...");
+    }
+
+    int progress = 0;
+    if (view == View::Done) {
+        progress = 100;
+    } else if (mine && (view == View::Running || view == View::WaitingUser)) {
+        auto it = status_.find("progress");
+        if (it != status_.end() && it->is_number()) {
+            progress = static_cast<int>(it->get<double>() * 100.0 + 0.5);
+            progress = std::clamp(progress, 0, 100);
+        }
+    }
+
+    std::string zoffset;
+    if (auto it = status_.find("zoffset"); it != status_.end() && it->is_number()) {
+        zoffset = fmt::format("{:+.3f} mm", it->get<double>());
+    }
+
+    copy_if_changed(&message_, message);
+    copy_if_changed(&results_, results_text());
+    copy_if_changed(&zoffset_, zoffset);
+    set_if_changed(&progress_, progress);
+    set_if_changed(&view_, static_cast<int>(view));
+    update_footer(view);
+}
+
+// ============================================================================
+// Ownership: one model + one step object per spec, created on first use
+// ============================================================================
+
+namespace {
+
+struct Ad5xSetupSteps {
+    Ad5xSetupModel model;
+    std::vector<std::unique_ptr<WizardAd5xSetupStep>> steps;
+
+    Ad5xSetupSteps() {
+        for (const auto& spec : k_specs) {
+            steps.push_back(std::make_unique<WizardAd5xSetupStep>(spec));
+        }
+    }
+};
+
+Ad5xSetupSteps& owner() {
+    return helix::lazy_global<Ad5xSetupSteps>("Ad5xSetupSteps");
+}
+
+} // namespace
+
+Ad5xSetupModel& model() {
+    return owner().model;
+}
+
+void launch_targeted(lv_obj_t* parent) {
+    spdlog::info("[AD5X setup] Running the setup steps again");
+    ui_wizard_register_event_callbacks();
+    ui_wizard_container_register_responsive_constants();
+    ui_wizard_init_subjects();
+    // Back on the first step leaves the session, like the other targeted runs.
+    set_wizard_cancel_callback([]() {
+        ui_wizard_complete_targeted();
+        set_wizard_cancel_callback(nullptr);
+    });
+    ui_wizard_create_targeted(parent, step_ids(), []() { set_wizard_cancel_callback(nullptr); });
+}
+
+void watch_wizard_requests() {
+    IMoonrakerClient* client = get_moonraker_client();
+    if (!client) {
+        return;
+    }
+    // Same handler name on the same client is a no-op, so every call is safe.
+    client->register_method_callback(
+        "notify_gcode_response", "ad5x_setup_wizard", [](const json& note) {
+            // WebSocket thread: only look at the line here.
+            auto params = note.find("params");
+            if (params == note.end() || !params->is_array() || params->empty() ||
+                !(*params)[0].is_string()) {
+                return;
+            }
+            const std::string& line = (*params)[0].get_ref<const std::string&>();
+            if (line.find("action:ad5x_setup_wizard") == std::string::npos) {
+                return;
+            }
+            helix::ui::queue_update("ad5x_setup::wizard_request", []() {
+                if (is_wizard_active()) {
+                    return;
+                }
+                // Answered now, so the next start must not run it again.
+                if (const char* flag = std::getenv("HELIX_WIZARD_FLAG_FILE")) {
+                    helix::fs::remove(flag);
+                }
+                if (!available()) {
+                    return;
+                }
+                spdlog::info("[AD5X setup] SETUP_WIZARD from Klipper: opening the setup steps");
+                launch_targeted(lv_screen_active());
+            });
+        });
+}
+
