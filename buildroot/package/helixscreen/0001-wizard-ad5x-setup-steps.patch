+const std::vector<StepSpec>& step_specs() {
+    return k_specs;
+}
+
+const StepSpec* spec_for(wizard::StepId id) {
+    for (const auto& s : k_specs) {
+        if (s.id == id) {
+            return &s;
+        }
+    }
+    return nullptr;
+}
+
+std::vector<wizard::StepId> step_ids() {
+    std::vector<wizard::StepId> ids;
+    for (const auto& s : k_specs) {
+        ids.push_back(s.id);
+    }
+    return ids;
+}
+
+bool available(const wizard::StepContext& ctx) {
+    if (ctx.config && ctx.config->get_preset() == "ad5x") {
+        return true;
+    }
+    if (ctx.api) {
+        const auto& objects = ctx.api->hardware().printer_objects();
+        return std::find(objects.begin(), objects.end(), "ad5x_setup") != objects.end();
+    }
+    return false;
+}
+
+bool available() {
+    wizard::StepContext ctx;
+    ctx.config = Config::get_instance();
+    ctx.api = get_moonraker_api();
+    return available(ctx);
+}
+
+View view_for(const std::string& key, const std::string& status_step,
+              const std::string& status_state, bool start_in_flight, bool local_error) {
+    const bool mine = status_step == key;
+    if (mine && status_state == "running") {
+        return View::Running;
+    }
+    if (mine && status_state == "waiting_user") {
+        return View::WaitingUser;
+    }
+    if (local_error) {
+        return View::Failed;
+    }
+    if (start_in_flight) {
+        // A stale done/failed from an earlier run must not show while the new
+        // run has not reported yet.
+        return View::Running;
+    }
+    if (mine && status_state == "done") {
+        return View::Done;
+    }
+    if (mine && (status_state == "failed" || status_state == "aborted")) {
+        return View::Failed;
+    }
+    return View::Idle;
+}
