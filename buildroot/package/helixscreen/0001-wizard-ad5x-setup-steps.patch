+/// Result labels for the save step's overview, in wizard order.
+struct ResultLabel {
+    const char* key;
+    const char* label;
+};
+constexpr ResultLabel k_result_labels[] = {
+    {"selfcheck", "Self-check"},      {"pid", "PID"},
+    {"mesh", "Bed mesh"},             {"shaper", "Vibration compensation"},
+    {"ifs", "IFS tuning"},            {"zoffset", "Z offset"},
