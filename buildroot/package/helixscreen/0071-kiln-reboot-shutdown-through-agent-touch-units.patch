+// Kiln OS: Reboot and Shutdown through Moonraker only (plan_power_dialog).
+// Kiln's update agent answers before it acts, so a refusal (a print is
+// running, start-up has not finished, the recovery OS is being written)
+// arrives as the RPC's error: the dialog closes and the toast says why.
+// Nothing runs locally, whatever the error.
+void execute_kiln_power(IMoonrakerAPI* api, bool is_reboot, ShutdownModal& modal,
+                        AsyncLifetimeGuard& lifetime) {
+    const char* action = is_reboot ? "reboot" : "shutdown";
+    if (!api || !api->is_connected()) {
+        spdlog::warn("[ShutdownDialog] Kiln OS: Moonraker not connected, no {}", action);
+        modal.hide();
+        ToastManager::instance().show(ToastSeverity::ERROR, lv_tr("Not connected to the printer"),
+                                      6000);
+        return;
+    }
+    spdlog::info("[ShutdownDialog] Kiln OS: machine {} through Moonraker", action);
+    auto tok = lifetime.token();
+    auto on_ok = [api, is_reboot, action]() {
+        spdlog::info("[ShutdownDialog] Kiln OS: machine {} accepted", action);
+        schedule_host_down_verification(api, is_reboot);
+    };
+    auto on_err = [tok, &modal, is_reboot, action](const MoonrakerError& err) {
+        spdlog::warn("[ShutdownDialog] Kiln OS: machine {} refused ({}, {}): {}", action, err.code,
+                     err.kiln_reason(), err.message);
+        const std::string message = err.message;
+        tok.defer("ShutdownDialog::kiln_refused", [&modal, message, is_reboot]() {
+            modal.hide();
+            ToastManager::instance().show(
+                ToastSeverity::ERROR, kiln_power_failure_message(message, is_reboot).c_str(), 8000);
+        });
+    };
+    if (is_reboot) {
+        api->machine_reboot(on_ok, on_err);
+    } else {
+        api->machine_shutdown(on_ok, on_err);
+    }
+}
