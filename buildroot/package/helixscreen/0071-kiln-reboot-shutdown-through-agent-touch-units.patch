+void republish_kiln_power_locked(lv_observer_t* observer, lv_subject_t* subject);
+
+/// Publishes `kiln_power_locked` and holds the observer that keeps it current.
+/// Held in an optional, as zoffset's save-availability publisher, so the
+/// observer is dropped from a StaticSubjectRegistry deinit while LVGL is up.
+struct KilnPowerLockPublisher {
+    SubjectManager subjects;
+    lv_subject_t kiln_power_locked_{};
+    ObserverGuard job_obs;
+
+    void init(PrinterState& state, bool register_xml) {
+        INIT_SUBJECT_INT(kiln_power_locked, 0, subjects, register_xml);
+        // job_holds_machine, not print_active: print_active reads 0 while a
+        // job prepares on the host side
+        if (lv_subject_t* job = state.print_state().get_job_holds_machine_subject()) {
+            // Attaching notifies once: publishes the state the app is in
+            job_obs = ObserverGuard(job, republish_kiln_power_locked, nullptr);
+            job_obs.set_alive_token(state.get_subjects_lifetime());
+        }
+    }
+};
+
+std::optional<KilnPowerLockPublisher>& kiln_power_lock_storage() {
+    static std::optional<KilnPowerLockPublisher> storage;
+    return storage;
+}
+
+void republish_kiln_power_locked(lv_observer_t* /*observer*/, lv_subject_t* subject) {
+    auto& storage = kiln_power_lock_storage();
+    if (!storage) {
+        return;
+    }
+    const bool holds = subject && lv_subject_get_int(subject) != 0;
+    lv_subject_set_int(&storage->kiln_power_locked_,
+                       kiln_power_locked(helix::kiln_host_power(), holds) ? 1 : 0);
+}
+
+} // namespace
+
+void init_kiln_power_lock_subject(PrinterState& state, bool register_xml) {
+    auto& storage = kiln_power_lock_storage();
+    if (storage) {
+        return;
+    }
+    storage.emplace();
+    storage->init(state, register_xml);
+    StaticSubjectRegistry::instance().register_deinit("kiln_power_locked",
+                                                      deinit_kiln_power_lock_subject);
+}
+
+void deinit_kiln_power_lock_subject() {
+    auto& storage = kiln_power_lock_storage();
+    if (!storage) {
+        return;
+    }
+    // The observer first: a notification after deinit_all() would write to
+    // a freed subject
+    storage->job_obs.reset();
+    storage->subjects.deinit_all();
+    storage.reset();
+}
+
+lv_subject_t* get_kiln_power_lock_subject() {
+    auto& storage = kiln_power_lock_storage();
+    return storage ? &storage->kiln_power_locked_ : nullptr;
+}
