+}
+
+std::string kiln_power_failure_message(const std::string& err_message, bool is_reboot) {
+    const std::string why = MoonrakerError::strip_kiln_reason(err_message);
+    if (why.empty()) {
+        return is_reboot ? lv_tr("Reboot failed") : lv_tr("Shutdown failed");
+    }
+    return fmt::format(fmt::runtime(is_reboot ? lv_tr("Can't restart the printer: {}")
+                                              : lv_tr("Can't shut down the printer: {}")),
+                       why);
+}
