+                    const auto plan = plan_power_dialog(/*kiln_host_power=*/true, connected, remote,
+                                                        same, systemd);
+                    CHECK(plan.mode == ShutdownDialogMode::KilnViaMoonraker);
+                }
+            }
+        }
+    }
+}
+
+TEST_CASE("Kiln power: other builds keep upstream's plan", "[shutdown][power][kiln]") {
+    for (const bool connected : {true, false}) {
+        for (const bool remote : {true, false}) {
+            for (const bool same : {true, false}) {
+                for (const bool systemd : {true, false}) {
+                    const auto plan = plan_power_dialog(/*kiln_host_power=*/false, connected,
+                                                        remote, same, systemd);
+                    const auto upstream = plan_shutdown_dialog(connected, remote, same, systemd);
+                    CHECK(plan.mode == upstream.mode);
+                    CHECK(plan.dual_default == upstream.dual_default);
+                    CHECK(plan.mode != ShutdownDialogMode::KilnViaMoonraker);
+                }
+            }
+        }
+    }
+    // The case Kiln replaces: a same-host screen on a host without systemd
+    // powers itself down locally
+    CHECK(plan_power_dialog(false, true, false, true, false).mode ==
+          ShutdownDialogMode::SingleViaLocalPower);
+}
+
+TEST_CASE("Kiln power: the refusal is shown with its reason", "[shutdown][power][kiln]") {
+    // MoonrakerError::from_json_rpc has already taken "[printing] " off when
+    // the error's data carries the reason
+    CHECK(kiln_power_failure_message("A print is running", true) ==
+          "Can't restart the printer: A print is running");
+    CHECK(kiln_power_failure_message("A print is running", false) ==
+          "Can't shut down the printer: A print is running");
+    // Without data the reason is still in front: taken off here
+    CHECK(kiln_power_failure_message("[starting_up] Start-up has not finished yet, try again in "
+                                     "a minute",
+                                     true) ==
+          "Can't restart the printer: Start-up has not finished yet, try again in a minute");
+    CHECK(kiln_power_failure_message("[recovery_updating] The recovery OS is being written into "
+                                     "slot A, try again in a few minutes",
+                                     false) ==
+          "Can't shut down the printer: The recovery OS is being written into slot A, try again "
+          "in a few minutes");
+    // An agent that doesn't answer, or any other error: its text
+    CHECK(kiln_power_failure_message("[agent_timeout] The update agent didn't answer in 30 s "
+                                     "(is S68ad5x-update-agent running?)",
+                                     true) ==
+          "Can't restart the printer: The update agent didn't answer in 30 s (is "
+          "S68ad5x-update-agent running?)");
+    // A look-alike stays as it is
+    CHECK(kiln_power_failure_message("[Not a reason] text", true) ==
+          "Can't restart the printer: [Not a reason] text");
+    // Nothing to say: the plain texts
+    CHECK(kiln_power_failure_message("", true) == "Reboot failed");
+    CHECK(kiln_power_failure_message("", false) == "Shutdown failed");
+}
+
+TEST_CASE("Kiln power: locked only on Kiln while a job holds the machine",
+          "[shutdown][power][kiln]") {
+    CHECK(kiln_power_locked(true, true));
+    CHECK_FALSE(kiln_power_locked(true, false));
+    CHECK_FALSE(kiln_power_locked(false, true));
+    CHECK_FALSE(kiln_power_locked(false, false));
+}
+
+namespace {
+
+struct KilnPowerLockFixture : public LVGLTestFixture {
+    KilnPowerLockFixture() {
+        state_.init_subjects(false);
+        // Another case (or the app's own init) may have made it with its
+        // PrinterState: this one observes ours
+        deinit_kiln_power_lock_subject();
+    }
+    ~KilnPowerLockFixture() override {
+        deinit_kiln_power_lock_subject();
+        set_kiln_host_power_override(-1);
+    }
+
+    static void drain() {
+        helix::ui::UpdateQueueTestAccess::drain_all(helix::ui::UpdateQueue::instance());
+    }
+
+    void report_job_state(const char* moonraker_state) {
+        state_.update_from_status(json{{"print_stats", {{"state", moonraker_state}}}});
+        drain();
+    }
+
+    int locked() {
+        lv_subject_t* s = get_kiln_power_lock_subject();
+        return s ? lv_subject_get_int(s) : -1;
+    }
+
+    PrinterState state_;
+};
+
+} // namespace
+
+TEST_CASE_METHOD(KilnPowerLockFixture, "Kiln power: the lock follows job_holds_machine on Kiln",
+                 "[shutdown][power][kiln]") {
+    set_kiln_host_power_override(1);
+    init_kiln_power_lock_subject(state_, /*register_xml=*/false);
+    REQUIRE(locked() == 0);
+    report_job_state("printing");
+    CHECK(locked() == 1);
+    report_job_state("paused");
+    CHECK(locked() == 1);
+    report_job_state("complete");
+    CHECK(locked() == 0);
+    // A second init keeps the first
+    init_kiln_power_lock_subject(state_, false);
+    report_job_state("printing");
+    CHECK(locked() == 1);
+}
+
+TEST_CASE_METHOD(KilnPowerLockFixture, "Kiln power: never locked on other builds",
+                 "[shutdown][power][kiln]") {
+    set_kiln_host_power_override(0);
+    init_kiln_power_lock_subject(state_, false);
+    report_job_state("printing");
+    CHECK(locked() == 0);
+}
+
+TEST_CASE_METHOD(KilnPowerLockFixture, "Kiln power: a job already running at init counts",
+                 "[shutdown][power][kiln]") {
+    set_kiln_host_power_override(1);
+    report_job_state("printing");
+    init_kiln_power_lock_subject(state_, false);
+    CHECK(locked() == 1);
+    deinit_kiln_power_lock_subject();
+    CHECK(get_kiln_power_lock_subject() == nullptr);
+}
diff --git a/tests/unit/test_kiln_touch_units.cpp b/tests/unit/test_kiln_touch_units.cpp
new file mode 100644
index 00000000..0c3437c8
--- /dev/null
+++ b/tests/unit/test_kiln_touch_units.cpp
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * Kiln OS: a saved touch range carries the units it is in.
+ *
+ * The AD5X's stock 5.10 kernel reports the touch in panel units, Kiln's own
+ * kernels the raw readings. Kiln's ad5x-touch-units converts the stored range
+ * when the kernel changes and takes a range without /input/ad5x_touch_units
+ * for stock units. A range saved on Kiln's kernel without the tag (after a
+ * factory reset, say) was converted a second time and touch was off; so on
+ * Kiln builds every save writes the tag.
+ */
+
+#include "config.h"
+#include "touch_calibration_wrapper.h"
+
+#include <string>
+#include <sys/utsname.h>
+
+#include "../catch_amalgamated.hpp"
+
+using namespace helix;
+
+namespace {
+
+void forget_touch_keys(Config* cfg) {
+    if (cfg->exists("/input/ad5x_touch_units")) {
+        cfg->get_json("/input").erase("ad5x_touch_units");
+    }
+    cfg->set<bool>("/input/touch_range/valid", false);
+}
+
+std::string running_units() {
+    struct utsname u {};
+    return kiln_touch_units(uname(&u) == 0 ? std::string(u.release) : std::string());
+}
+
+} // namespace
+
+TEST_CASE("Kiln touch units: by the kernel release", "[touch][touch-calibration][kiln]") {
+    CHECK(std::string(kiln_touch_units("5.10.186+")) == "stock");
+    CHECK(std::string(kiln_touch_units("5.10.0")) == "stock");
+    CHECK(std::string(kiln_touch_units("6.6.18-rt23-ad5x")) == "own");
+    CHECK(std::string(kiln_touch_units("7.3.0-ad5x")) == "own");
+    CHECK(std::string(kiln_touch_units("5.15.1")) == "own");
+    CHECK(std::string(kiln_touch_units("15.10.1")) == "own");
+}
+
+TEST_CASE("Kiln touch units: tagged on every save on Kiln builds",
+          "[touch][touch-calibration][kiln]") {
+    Config* cfg = Config::get_instance();
+    forget_touch_keys(cfg);
+    TouchRangeSettings range{};
+    range.valid = true;
+    range.min_x = 4000;
+    range.max_x = 90;
+    range.min_y = 3900;
+    range.max_y = 120;
+    range.capture_rotation = 0;
+
+    SECTION("Kiln: the running kernel's units") {
+        set_kiln_touch_units_tagged_for_test(true);
+        save_touch_range(range);
+        CHECK(cfg->get<std::string>("/input/ad5x_touch_units", "") == running_units());
+        CHECK(cfg->get<int>("/input/touch_range/min_x", 0) == 4000);
+    }
+    SECTION("Kiln: a stale tag is replaced") {
+        set_kiln_touch_units_tagged_for_test(true);
+        cfg->set<std::string>("/input/ad5x_touch_units",
+                              running_units() == "own" ? "stock" : "own");
+        save_touch_range(range);
+        CHECK(cfg->get<std::string>("/input/ad5x_touch_units", "") == running_units());
+    }
+    SECTION("Kiln: an affine-only save (no range) is tagged too") {
+        set_kiln_touch_units_tagged_for_test(true);
+        TouchRangeSettings none{};
+        save_touch_range(none);
+        CHECK(cfg->get<std::string>("/input/ad5x_touch_units", "") == running_units());
+    }
+    SECTION("other builds: no tag") {
+        set_kiln_touch_units_tagged_for_test(false);
+        save_touch_range(range);
+        CHECK_FALSE(cfg->exists("/input/ad5x_touch_units"));
+    }
+    SECTION("the build's own answer") {
+        set_kiln_touch_units_tagged_for_test(std::nullopt);
+#if defined(HELIX_KILN_AD5X)
+        CHECK(kiln_touch_units_tagged());
+#else
+        CHECK_FALSE(kiln_touch_units_tagged());
+#endif
+    }
+
+    set_kiln_touch_units_tagged_for_test(std::nullopt);
+    forget_touch_keys(cfg);
+}
