From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ad5xrecon <ad5xrecon@localhost>
Date: Fri, 16 Oct 2026 19:21:38 -0400
Subject: [PATCH] ams: AD5X IFS ports count as prep sensors (open the slot
 editor on insert)

---
 include/ams_backend_ad5x_ifs.h | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/include/ams_backend_ad5x_ifs.h b/include/ams_backend_ad5x_ifs.h
index 30a5f537ba..24eae86e6a 100644
--- a/include/ams_backend_ad5x_ifs.h
+++ b/include/ams_backend_ad5x_ifs.h
@@ -148,6 +148,10 @@ class AmsBackendAd5xIfs : public AmsSubscriptionBackend,
 
     static constexpr int kDefaultPorts = helix::ad5x::kDefaultPorts;
     static constexpr int kMaxPorts = helix::ad5x::kMaxPorts;
+    /// Kiln OS's IFS driver drives one IFS: its channels, backup lists and
+    /// per-slot state are 1..kNumPorts (the name upstream used before ports
+    /// became a count).
+    static constexpr int kNumPorts = kDefaultPorts;
     static constexpr int kToolMapSize = helix::ad5x::kToolMapSize;
     static constexpr int kUnmappedPort = helix::ad5x::kUnmappedPort;
 
@@ -471,6 +475,14 @@ class AmsBackendAd5xIfs : public AmsSubscriptionBackend,
         return true;
     }
 
+    // Each IFS port senses its filament (IFS_STATUS Ports), which is what a
+    // prep sensor means to FilamentInsertWatcher: a spool inserted into an
+    // idle port opens its editor (filament/auto_open_editor), as the stock
+    // screen asks for the new spool's material and colour.
+    [[nodiscard]] bool slot_has_prep_sensor(int slot_index) const override {
+        return slot_index >= 0 && slot_index < kNumPorts;
+    }
+
     AmsError recover() override;
     AmsError reset() override;
     AmsError cancel() override;
