+
+namespace {
+// Packs cannot be unregistered, so the probe locale outlives the case; going
+// back to the identity locale keeps the rest of the shard on English lookups.
+class ScopedIdentityLanguage {
+  public:
+    ~ScopedIdentityLanguage() {
+        lv_translation_set_language(helix::ui::kIdentityLocale);
+    }
+};
+} // namespace
+
+// The Kiln home seed names its unload tile with "label": "Unload". Drawn as
+// plain text it stayed English in every language, although the catalog had
+// the word and TileSizing already measured its translation.
+TEST_CASE_METHOD(LVGLUITestFixture,
+                 "favorite_macro: a layout's label shows in the screen's language",
+                 "[favorite_macro][i18n]") {
+    ScopedIdentityLanguage restore_lang;
+
+    lv_translation_pack_t* pack = lv_translation_add_dynamic();
+    REQUIRE(lv_translation_add_language(pack, "zz-favmacro") == LV_RESULT_OK);
+    const int32_t lang_idx = lv_translation_get_language_index(pack, "zz-favmacro");
+    REQUIRE(lang_idx >= 0);
+    lv_translation_tag_dsc_t* tag = lv_translation_add_tag(pack, "Unload");
+    REQUIRE(tag != nullptr);
+    REQUIRE(lv_translation_set_tag_translation(pack, tag, lang_idx, "ZZ unload") == LV_RESULT_OK);
+
+    SECTION("a label the catalog knows follows the language") {
+        PanelWidgetHarness<FavoriteMacroWidget> h(
+            test_screen(),
+            HarnessConfig{{{"macro", "UNLOAD_FILAMENT"}, {"icon", "eject"}, {"label", "Unload"}}},
+            "favorite_macro:1");
+        lv_obj_t* name = h.child("fav_macro_name");
+        REQUIRE(name != nullptr);
+        lv_translation_set_language(helix::ui::kIdentityLocale);
+        CHECK(std::string(lv_label_get_text(name)) == "Unload");
+
+        // No restart and no redraw call: the label re-translates itself.
+        lv_translation_set_language("zz-favmacro");
+        CHECK(std::string(lv_label_get_text(name)) == "ZZ unload");
+
+        lv_translation_set_language(helix::ui::kIdentityLocale);
+        CHECK(std::string(lv_label_get_text(name)) == "Unload");
+    }
+
+    SECTION("a label the catalog does not know shows as written") {
+        lv_translation_set_language("zz-favmacro");
+        PanelWidgetHarness<FavoriteMacroWidget> h(
+            test_screen(),
+            HarnessConfig{{{"macro", "UNLOAD_FILAMENT"}, {"label", "Zz my own label"}}},
+            "favorite_macro:1");
+        lv_obj_t* name = h.child("fav_macro_name");
+        REQUIRE(name != nullptr);
+        CHECK(std::string(lv_label_get_text(name)) == "Zz my own label");
+    }
+
+    SECTION("a macro's own name is left alone") {
+        // Even when the name a macro gets happens to be a catalog key.
+        const std::string own = helix::get_display_name("UNLOAD_FILAMENT", DeviceType::MACRO);
+        lv_translation_tag_dsc_t* own_tag = lv_translation_add_tag(pack, own.c_str());
+        REQUIRE(own_tag != nullptr);
+        REQUIRE(lv_translation_set_tag_translation(pack, own_tag, lang_idx, "ZZ wrong") ==
+                LV_RESULT_OK);
+        lv_translation_set_language("zz-favmacro");
+        PanelWidgetHarness<FavoriteMacroWidget> h(
+            test_screen(), HarnessConfig{{{"macro", "UNLOAD_FILAMENT"}}}, "favorite_macro:1");
+        lv_obj_t* name = h.child("fav_macro_name");
+        REQUIRE(name != nullptr);
+        CHECK(std::string(lv_label_get_text(name)) == own);
+    }
+}
