diff --git a/src/system/system_settings_manager.cpp b/src/system/system_settings_manager.cpp
index 3f09350..d1d31d4 100644
--- a/src/system/system_settings_manager.cpp
+++ b/src/system/system_settings_manager.cpp
@@ -50,16 +50,20 @@ static int spdlog_level_to_index(spdlog::level::level_enum level) {
 #endif
 
 // Language options - codes and display names
-// Order: en, de, fr, es, ru, pt, it, zh, ja (indices 0-8). The CJK pair comes
-// last so a build without CJK fonts (HELIX_HAS_CJK=0, the ESP32 firmware) drops
-// it by shortening the list, and every other index keeps its meaning. A saved
-// zh/ja there reads as English.
-static const char* kLanguageCodes[] = {"en", "de", "fr", "es", "ru", "pt", "it", "zh", "ja"};
-static const int kLanguageCount = HELIX_HAS_CJK ? 9 : 7;
+// Order: en, zh, ja, de, es, it, ru, pt, tr. The CJK pair (zh, ja) sits at
+// indices 1-2, so a build without CJK fonts (HELIX_HAS_CJK=0, the ESP32
+// firmware) gets its own list without them. A saved zh/ja there reads as English.
+#if HELIX_HAS_CJK
+static const char* kLanguageCodes[] = {"en", "zh", "ja", "de", "es", "it", "ru", "pt", "tr"};
+static const int kLanguageCount = 9;
 static const char* kLanguageOptionsText =
-    HELIX_HAS_CJK
-        ? "English\nDeutsch\nFrançais\nEspañol\nРусский\nPortuguês\nItaliano\n中文\n日本語"
-        : "English\nDeutsch\nFrançais\nEspañol\nРусский\nPortuguês\nItaliano";
+    "English\n中文\n日本語\nDeutsch\nEspañol\nItaliano\nРусский\nPortuguês\nTürkçe";
+#else
+static const char* kLanguageCodes[] = {"en", "de", "es", "it", "ru", "pt", "tr"};
+static const int kLanguageCount = 7;
+static const char* kLanguageOptionsText =
+    "English\nDeutsch\nEspañol\nItaliano\nРусский\nPortuguês\nTürkçe";
+#endif
 
 using settings::Scope;
 // Row order is SystemSettingsManager::Key.
