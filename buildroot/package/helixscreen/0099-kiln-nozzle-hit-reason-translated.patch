@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * @file kiln_nozzle_hit_reason.h
+ * @brief Kiln OS: the nozzle-hit guard's pause line in the screen's language
+ *
+ * Kiln's nozzle-guard plugin (klipper/plugins/nozzle-guard, ad5x_nozzle_guard.py
+ * `_trip`) writes one English `!!` line before it pauses:
+ *
+ *   Nozzle hit detected: the bed felt 412 g (limit 300 g) at Z 1.20. Print
+ *   paused: check the print and the nozzle, then resume or cancel.
+ *
+ * (" at Z ..." left out when the position is unknown). That line is the pause
+ * reason and the error dialog's text; shown as it is, it would be English on
+ * every screen language. This recognises it and gives the translated sentence
+ * with Klipper's numbers in it, or a translated generic one when the numbers
+ * can't be read.
+ *
+ * @threading lv_tr(): main thread only
+ */
+
+#pragma once
+
+#include <optional>
+#include <string>
+
+namespace helix::kiln {
+
+/// The numbers of a nozzle-hit line, as Klipper wrote them ("412", "300", "1.20").
+struct NozzleHit {
+    std::string force;
+    std::string limit;
+    std::string z; ///< Empty when the line has no " at Z ..."
+};
+
+/// Whether @p text (with or without the "!! " prefix) is the nozzle guard's line.
+bool is_nozzle_hit_line(const std::string& text);
+
+/// The numbers of the nozzle guard's line; nullopt when it isn't one or they
+/// can't be read.
+std::optional<NozzleHit> parse_nozzle_hit(const std::string& text);
+
+/// The sentence the screen shows for @p text in the current language, or
+/// nullopt when @p text isn't the nozzle guard's line (shown as it is then).
+std::optional<std::string> nozzle_hit_reason(const std::string& text);
+
+} // namespace helix::kiln
