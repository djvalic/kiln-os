+#include "test_helpers/printer_state_test_access.h"
+#include "translation_loader.h"
+
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "../catch_amalgamated.hpp"
+#include "hv/json.hpp"
+
+using namespace helix;
+using json = nlohmann::json;
+namespace fs = std::filesystem;
+
+namespace {
+
+// What ad5x_nozzle_guard.py `_trip` writes, with and without the position
+constexpr const char* kWithZ =
+    "!! Nozzle hit detected: the bed felt 412 g (limit 300 g) at Z 1.20. Print paused: check "
+    "the print and the nozzle, then resume or cancel.";
+constexpr const char* kWithoutZ =
+    "!! Nozzle hit detected: the bed felt 650 g (limit 600 g). Print paused: check the print "
+    "and the nozzle, then resume or cancel.";
+constexpr const char* kGarbled =
+    "!! Nozzle hit detected: the bed felt a lot (limit 300 g). Print paused: check the print "
+    "and the nozzle, then resume or cancel.";
+
+constexpr const char* kKeyWithZ = "Nozzle hit: the bed felt {} g (limit {} g) at Z {}. Check the "
+                                  "print and the nozzle, then resume or cancel.";
+constexpr const char* kKeyWithoutZ = "Nozzle hit: the bed felt {} g (limit {} g). Check the print "
+                                     "and the nozzle, then resume or cancel.";
+constexpr const char* kKeyGeneric =
+    "Nozzle hit detected. Check the print and the nozzle, then resume or cancel.";
+
+// Restores the identity locale (LVGL can't unregister a pack)
+class ScopedLanguage {
+  public:
+    explicit ScopedLanguage(const char* lang) {
+        helix::ui::ensure_translation_loaded(lang);
+        lv_translation_set_language(lang);
+    }
+    ~ScopedLanguage() {
+        lv_translation_set_language(helix::ui::kIdentityLocale);
+    }
+    ScopedLanguage(const ScopedLanguage&) = delete;
+    ScopedLanguage& operator=(const ScopedLanguage&) = delete;
+};
+
+/// The single-quoted YAML value of @p key in @p yml
+std::optional<std::string> yaml_value(const std::string& yml, const std::string& key) {
+    std::string quoted;
+    for (char c : key) {
+        quoted += c;
+        if (c == '\'') {
+            quoted += '\'';
+        }
+    }
+    const std::string head = "  '" + quoted + "': '";
+    const size_t at = yml.find(head);
+    if (at == std::string::npos) {
+        return std::nullopt;
+    }
+    std::string out;
+    for (size_t i = at + head.size(); i < yml.size(); ++i) {
+        if (yml[i] == '\'') {
+            if (i + 1 < yml.size() && yml[i + 1] == '\'') {
+                out += '\'';
+                ++i;
+                continue;
+            }
+            return out;
+        }
+        out += yml[i];
+    }
+    return std::nullopt;
+}
+
+size_t placeholders(const std::string& s) {
+    size_t n = 0;
+    for (size_t at = s.find("{}"); at != std::string::npos; at = s.find("{}", at + 2)) {
+        ++n;
+    }
+    return n;
+}
+
+class ReasonTrackerFixture : public LVGLTestFixture {
+  public:
+    ReasonTrackerFixture() {
+        auto& ps = get_printer_state();
+        PrinterStateTestAccess::reset(ps);
+        ps.init_subjects(false);
+        test::set_wire_state(ps, PrintJobState::PRINTING);
+        tracker_ = std::make_unique<PrintStopReasonTracker>(client_, ps, [this] { return now_; });
+        settle();
+    }
+    ~ReasonTrackerFixture() override {
+        tracker_.reset();
+        test::set_wire_state(get_printer_state(), PrintJobState::STANDBY);
+        settle();
+    }
+    static void settle() {
+        ui::UpdateQueue::instance().drain();
+    }
+    static std::string reason() {
+        return lv_subject_get_string(
+            get_printer_state().print_state().get_print_stop_reason_subject());
+    }
+    void pause_after(const char* line) {
+        now_ = kStop - 1;
+        REQUIRE(client_.fire_notification("notify_gcode_response",
+                                          json{{"params", json::array({line})}}));
+        settle();
+        now_ = kStop;
+        get_printer_state().update_from_status(json{{"print_stats", {{"state", "paused"}}}});
+        settle();
+    }
+
+    static constexpr double kStop = 1'700'000'000.0;
+    double now_ = kStop;
+    test::FakeMoonrakerClient client_;
+    std::unique_ptr<PrintStopReasonTracker> tracker_;
+};
+
+const char* find_text_containing(lv_obj_t* node, const char* needle) {
+    if (!node) {
+        return nullptr;
+    }
+    if (lv_obj_check_type(node, &lv_label_class)) {
+        const char* txt = lv_label_get_text(node);
+        if (txt && std::strstr(txt, needle)) {
+            return txt;
+        }
+    }
+    for (uint32_t i = 0; i < lv_obj_get_child_count(node); ++i) {
+        if (const char* hit = find_text_containing(lv_obj_get_child(node, i), needle)) {
+            return hit;
+        }
+    }
+    return nullptr;
+}
+
+} // namespace
+
+TEST_CASE("nozzle hit line: the numbers are read, with and without Z", "[kiln][nozzle_hit]") {
+    auto hit = kiln::parse_nozzle_hit(kWithZ);
+    REQUIRE(hit.has_value());
+    CHECK(hit->force == "412");
+    CHECK(hit->limit == "300");
+    CHECK(hit->z == "1.20");
+
+    hit = kiln::parse_nozzle_hit(kWithoutZ);
+    REQUIRE(hit.has_value());
+    CHECK(hit->force == "650");
+    CHECK(hit->limit == "600");
+    CHECK(hit->z.empty());
+
+    // Without the "!! " (the stop reason has it stripped), and a Z below 0
+    hit = kiln::parse_nozzle_hit("Nozzle hit detected: the bed felt 151 g (limit 150 g) at Z "
+                                 "-0.05. Print paused: check the print and the nozzle, then "
+                                 "resume or cancel.");
+    REQUIRE(hit.has_value());
+    CHECK(hit->z == "-0.05");
+
+    CHECK_FALSE(kiln::parse_nozzle_hit(kGarbled).has_value());
+    CHECK_FALSE(kiln::parse_nozzle_hit("!! Nozzle hit detected: the bed felt 412 g").has_value());
+    CHECK_FALSE(kiln::parse_nozzle_hit("!! Nozzle hit detected: the bed felt 412 g (limit 300 g) "
+                                       "at Z here. Print paused.")
+                    .has_value());
+    CHECK(kiln::is_nozzle_hit_line(kGarbled));
+    CHECK_FALSE(kiln::is_nozzle_hit_line("!! Move out of range: 1 2 3"));
+}
+
+TEST_CASE("nozzle hit line: the sentence shown in English", "[kiln][nozzle_hit][i18n]") {
+    ScopedLanguage lang(helix::ui::kIdentityLocale);
+    CHECK(kiln::nozzle_hit_reason(kWithZ) ==
+          "Nozzle hit: the bed felt 412 g (limit 300 g) at Z 1.20. Check the print and the "
+          "nozzle, then resume or cancel.");
+    CHECK(kiln::nozzle_hit_reason(kWithoutZ) ==
+          "Nozzle hit: the bed felt 650 g (limit 600 g). Check the print and the nozzle, then "
+          "resume or cancel.");
+    CHECK(kiln::nozzle_hit_reason(kGarbled) == std::string(kKeyGeneric));
+    CHECK_FALSE(kiln::nozzle_hit_reason("!! Move out of range: 1 2 3").has_value());
+    CHECK_FALSE(kiln::nozzle_hit_reason("").has_value());
+}
+
+TEST_CASE("nozzle hit line: the sentence shown in Russian", "[kiln][nozzle_hit][i18n]") {
+    ScopedLanguage lang("ru");
+    CHECK(kiln::nozzle_hit_reason(kWithZ) ==
+          "Удар сопла: стол почувствовал 412 г (предел 300 г) на Z 1.20. Проверьте модель и "
+          "сопло, затем продолжите или отмените печать.");
+    CHECK(kiln::nozzle_hit_reason(kWithoutZ) ==
+          "Удар сопла: стол почувствовал 650 г (предел 600 г). Проверьте модель и сопло, затем "
+          "продолжите или отмените печать.");
+    CHECK(kiln::nozzle_hit_reason(kGarbled) ==
+          "Обнаружен удар сопла. Проверьте модель и сопло, затем продолжите или отмените "
+          "печать.");
+}
+
+TEST_CASE("nozzle hit line: every language has the three sentences", "[kiln][nozzle_hit][i18n]") {
+    const std::vector<std::pair<const char*, size_t>> keys = {
+        {kKeyWithZ, 3}, {kKeyWithoutZ, 2}, {kKeyGeneric, 0}};
+    int catalogs = 0;
+    for (const auto& entry : fs::directory_iterator(helix::asset_path("translations"))) {
+        if (entry.path().extension() != ".yml") {
+            continue;
+        }
+        ++catalogs;
+        const std::string locale = entry.path().stem().string();
+        if (locale == "en-GB") {
+            continue; // a regional variant: an empty value inherits en (HelixScreen 1.2)
+        }
+        std::ifstream in(entry.path());
+        const std::string yml((std::istreambuf_iterator<char>(in)),
+                              std::istreambuf_iterator<char>());
+        for (const auto& [key, count] : keys) {
+            INFO(locale << ": " << key);
+            const auto value = yaml_value(yml, key);
+            REQUIRE(value.has_value());
+            CHECK(placeholders(*value) == count);
+            if (locale == "en") {
+                CHECK(*value == key);
+            } else {
+                CHECK(*value != key);
+            }
+        }
+    }
+    CHECK(catalogs >= 11); // de en es fr it ja ko pt ru tr zh (en-GB skipped)
+}
+
+TEST_CASE_METHOD(ReasonTrackerFixture, "nozzle hit: the pause reason is the translated sentence",
+                 "[kiln][nozzle_hit][stop_reason]") {
+    ScopedLanguage lang("ru");
+    pause_after(kWithZ);
+    CHECK(reason() == "Удар сопла: стол почувствовал 412 г (предел 300 г) на Z 1.20. Проверьте "
+                      "модель и сопло, затем продолжите или отмените печать.");
+}
+
+TEST_CASE_METHOD(ReasonTrackerFixture, "nozzle hit: an unreadable line pauses with the generic one",
+                 "[kiln][nozzle_hit][stop_reason]") {
+    ScopedLanguage lang(helix::ui::kIdentityLocale);
+    pause_after(kGarbled);
+    CHECK(reason() == std::string(kKeyGeneric));
+}
+
+TEST_CASE_METHOD(ReasonTrackerFixture, "nozzle hit: other errors keep upstream's wording",
+                 "[kiln][nozzle_hit][stop_reason]") {
+    ScopedLanguage lang("ru");
+    pause_after("!! Move out of range: 1 2 3");
+    // HelixScreen 1.2 words Klipper's own errors itself (error_wording); the
+    // nozzle guard's sentence is not what they get.
+    CHECK_FALSE(reason().empty());
+    CHECK(reason().find("Удар сопла") == std::string::npos);
+}
+
+TEST_CASE_METHOD(LVGLUITestFixture, "nozzle hit: the error dialog shows the translated sentence",
+                 "[kiln][nozzle_hit][error-center]") {
+    ScopedLanguage lang("ru");
+    get_printer_state().update_from_status(json{{"pause_resume", {{"is_paused", true}}}});
+    REQUIRE(get_printer_state().is_paused());
+
+    helix::ui::RecoveryModalPresenter presenter(api());
+    helix::GcodeErrorRouter router(api(), client(), presenter);
+    GcodeErrorRouterTestAccess::process_line(router, kWithZ);
+    helix::ui::UpdateQueue::instance().drain();
+    process_lvgl(50);
+
+    REQUIRE(Modal::any_visible());
+    lv_obj_t* screen = lv_screen_active();
+    CHECK(find_text_containing(screen, "Удар сопла: стол почувствовал 412 г") != nullptr);
+    CHECK(find_text_containing(screen, "Nozzle hit") == nullptr);
+
+    get_printer_state().update_from_status(json{{"pause_resume", {{"is_paused", false}}}});
+    process_lvgl(20);
+}
