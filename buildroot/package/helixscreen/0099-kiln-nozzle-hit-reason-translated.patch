diff --git a/src/print/kiln_nozzle_hit_reason.cpp b/src/print/kiln_nozzle_hit_reason.cpp
new file mode 100644
index 0000000000..bc6889cb10
--- /dev/null
+++ b/src/print/kiln_nozzle_hit_reason.cpp
@@ -0,0 +1,139 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "kiln_nozzle_hit_reason.h"
+
+#include "lvgl/src/others/translation/lv_translation.h"
+
+#include <spdlog/fmt/fmt.h>
+#include <spdlog/spdlog.h>
+
+#include <cctype>
+#include <cstdlib>
+#include <cstring>
+
+namespace helix::kiln {
+
+namespace {
+
+constexpr const char* kBang = "!!";
+constexpr const char* kHead = "Nozzle hit detected";
+constexpr const char* kFelt = "Nozzle hit detected: the bed felt ";
+constexpr const char* kLimit = " g (limit ";
+constexpr const char* kLimitEnd = " g)";
+constexpr const char* kAtZ = " at Z ";
+
+/// @p text without a leading "!!" and spaces
+std::string strip_bang(const std::string& text) {
+    size_t i = 0;
+    while (i < text.size() && std::isspace(static_cast<unsigned char>(text[i]))) {
+        ++i;
+    }
+    if (text.compare(i, std::strlen(kBang), kBang) == 0) {
+        i += std::strlen(kBang);
+        while (i < text.size() && std::isspace(static_cast<unsigned char>(text[i]))) {
+            ++i;
+        }
+    }
+    return text.substr(i);
+}
+
+bool starts_with_at(const std::string& s, size_t pos, const char* what) {
+    return s.compare(pos, std::strlen(what), what) == 0;
+}
+
+/// A number as Python's %.0f / %.2f writes it ("412", "-0.05") at @p pos;
+/// moves @p pos past it. Empty when there is none.
+std::string take_number(const std::string& s, size_t& pos) {
+    size_t i = pos;
+    if (i < s.size() && s[i] == '-') {
+        ++i;
+    }
+    const size_t digits = i;
+    while (i < s.size() && std::isdigit(static_cast<unsigned char>(s[i]))) {
+        ++i;
+    }
+    if (i == digits) {
+        return {};
+    }
+    if (i + 1 < s.size() && s[i] == '.' && std::isdigit(static_cast<unsigned char>(s[i + 1]))) {
+        ++i;
+        while (i < s.size() && std::isdigit(static_cast<unsigned char>(s[i]))) {
+            ++i;
+        }
+    }
+    std::string out = s.substr(pos, i - pos);
+    pos = i;
+    return out;
+}
+
+const char* generic_reason() {
+    return lv_tr("Nozzle hit detected. Check the print and the nozzle, then resume or cancel.");
+}
+
+/// fmt with a translated @p pattern; one whose placeholders don't fit gives
+/// the generic sentence instead
+template <typename... Args> std::string format_reason(const char* pattern, const Args&... args) {
+    try {
+        return fmt::format(fmt::runtime(pattern), args...);
+    } catch (const fmt::format_error& e) {
+        spdlog::warn("[Kiln] nozzle hit: bad translation '{}': {}", pattern, e.what());
+        return generic_reason();
+    }
+}
+
+} // namespace
+
+bool is_nozzle_hit_line(const std::string& text) {
+    return strip_bang(text).rfind(kHead, 0) == 0;
+}
+
+std::optional<NozzleHit> parse_nozzle_hit(const std::string& text) {
+    const std::string s = strip_bang(text);
+    if (!starts_with_at(s, 0, kFelt)) {
+        return std::nullopt;
+    }
+    NozzleHit hit;
+    size_t pos = std::strlen(kFelt);
+    hit.force = take_number(s, pos);
+    if (hit.force.empty() || !starts_with_at(s, pos, kLimit)) {
+        return std::nullopt;
+    }
+    pos += std::strlen(kLimit);
+    hit.limit = take_number(s, pos);
+    if (hit.limit.empty() || !starts_with_at(s, pos, kLimitEnd)) {
+        return std::nullopt;
+    }
+    pos += std::strlen(kLimitEnd);
+    if (starts_with_at(s, pos, kAtZ)) {
+        pos += std::strlen(kAtZ);
+        hit.z = take_number(s, pos);
+        if (hit.z.empty()) {
+            return std::nullopt;
+        }
+    }
+    // The sentence ends here; what follows is the advice the translation carries
+    if (pos >= s.size() || s[pos] != '.') {
+        return std::nullopt;
+    }
+    return hit;
+}
+
+std::optional<std::string> nozzle_hit_reason(const std::string& text) {
+    if (!is_nozzle_hit_line(text)) {
+        return std::nullopt;
+    }
+    const auto hit = parse_nozzle_hit(text);
+    if (!hit) {
+        return std::string(generic_reason());
+    }
+    if (hit->z.empty()) {
+        return format_reason(lv_tr("Nozzle hit: the bed felt {} g (limit {} g). Check the print "
+                                   "and the nozzle, then resume or cancel."),
+                             hit->force, hit->limit);
+    }
+    return format_reason(lv_tr("Nozzle hit: the bed felt {} g (limit {} g) at Z {}. Check the "
+                               "print and the nozzle, then resume or cancel."),
+                         hit->force, hit->limit, hit->z);
+}
+
+} // namespace helix::kiln
