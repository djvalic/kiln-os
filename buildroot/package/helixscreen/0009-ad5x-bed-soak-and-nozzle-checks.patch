+Ad5xSoakModel::~Ad5xSoakModel() {
+    lifetime_.invalidate();
+    subscription_.reset();
+    klippy_observer_.reset();
+    message_observer_.reset();
+    subjects_.deinit_all();
+}
+
+void Ad5xSoakModel::init_subjects() {
+    if (subjects_initialized_) {
+        return;
+    }
+    // "On · 60 °C 7:00" for the Settings row, empty while the object has not answered
+    UI_MANAGED_SUBJECT_STRING(summary_, summary_buf_, "", "ad5x_soak_summary", subjects_);
+    UI_MANAGED_SUBJECT_INT(enabled_, 0, "ad5x_soak_enabled", subjects_);
+    // 0: the calibrate section, 1: a calibration runs (progress and Stop)
+    UI_MANAGED_SUBJECT_INT(view_, 0, "ad5x_soak_view", subjects_);
+    // 1 while calibrating, a change is pending or Klipper is not ready
+    UI_MANAGED_SUBJECT_INT(busy_, 1, "ad5x_soak_busy", subjects_);
+    UI_MANAGED_SUBJECT_INT(stopping_, 0, "ad5x_soak_stopping", subjects_);
+    UI_MANAGED_SUBJECT_STRING(status_line_, status_line_buf_, "", "ad5x_soak_status", subjects_);
+    UI_MANAGED_SUBJECT_STRING(rounds_, rounds_buf_, "", "ad5x_soak_rounds", subjects_);
+    UI_MANAGED_SUBJECT_STRING(calibrated_, calibrated_buf_, "", "ad5x_soak_calibrated", subjects_);
+    UI_MANAGED_SUBJECT_STRING(result_, result_buf_, "", "ad5x_soak_result", subjects_);
+    // ResultKind: hides the line or colours it
+    UI_MANAGED_SUBJECT_INT(result_kind_, 0, "ad5x_soak_result_kind", subjects_);
+    subjects_initialized_ = true;
+}
+
+void Ad5xSoakModel::start() {
+    if (!started_) {
+        IMoonrakerAPI* api = get_moonraker_api();
+        IMoonrakerClient* client = get_moonraker_client();
+        if (api && client) {
+            started_ = true;
+            const auto token = lifetime_.token();
+            // Runs on the WebSocket thread: copy the object out, apply it on the main thread.
+            const SubscriptionId id = api->subscribe_notifications([this, token](const json& note) {
+                const json* params = json_util::find_member(note, "params");
+                if (!params || !params->is_array() || params->empty()) {
+                    return;
+                }
+                const json* obj = json_util::find_member((*params)[0], kObject);
+                if (!obj || !obj->is_object()) {
+                    return;
+                }
+                json delta = *obj;
+                token.defer("Ad5xSoakModel::status_update",
+                            [this, delta]() { merge_status(delta); });
+            });
+            subscription_ = SubscriptionGuard(api, id);
+
+            // The final "Bed soak at 60 C: ..." line; only a request of ours keeps it.
+            // Registering an existing handler name is a no-op: drop one a previous
+            // model (before a printer switch) left behind first.
+            client->unregister_method_callback("notify_gcode_response", "ad5x_soak_result");
+            client->register_method_callback(
+                "notify_gcode_response", "ad5x_soak_result", [this, token](const json& note) {
+                    const json* params = json_util::find_member(note, "params");
+                    if (!params || !params->is_array() || params->empty() ||
+                        !(*params)[0].is_string()) {
+                        return;
+                    }
+                    std::string line = result_line((*params)[0].get<std::string>());
+                    if (line.empty()) {
+                        return;
+                    }
+                    token.defer("Ad5xSoakModel::result_line",
+                                [this, line]() { on_gcode_response(line); });
+                });
+
+            klippy_observer_ = ui::observe<int>(
+                get_printer_state().network_state().get_klippy_state_subject(), this,
+                [](Ad5xSoakModel* self, int state) {
+                    const bool ready = static_cast<KlippyState>(state) == KlippyState::READY;
+                    if (ready == self->klippy_ready_) {
+                        return;
+                    }
+                    self->klippy_ready_ = ready;
+                    if (ready) {
+                        self->query();
+                    } else {
+                        self->loaded_ = false;
+                    }
+                    self->refresh();
+                },
+                get_printer_state().get_subjects_lifetime());
+
+            // The calibration's status line is Klipper's display message
+            message_observer_ = ui::observe<const char*>(
+                get_printer_state().print_state().get_display_message_subject(), this,
+                [](Ad5xSoakModel* self, const char* /*message*/) {
+                    if (self->calibrating()) {
+                        self->refresh();
+                    }
+                },
+                get_printer_state().get_subjects_lifetime());
+        }
+    }
+    query();
+}
+
+void Ad5xSoakModel::query() {
+    IMoonrakerClient* client = get_moonraker_client();
+    if (!client || client->get_connection_state() != ConnectionState::CONNECTED) {
+        return;
+    }
+    const auto token = lifetime_.token();
+    json params = {{"objects", {{kObject, nullptr}}}};
+    client->send_jsonrpc(
+        "printer.objects.query", params,
+        [this, token](const json& response) {
+            const json* result = json_util::find_member(response, "result");
+            const json* status = result ? json_util::find_member(*result, "status") : nullptr;
+            const json* obj = status ? json_util::find_member(*status, kObject) : nullptr;
+            if (!obj || !obj->is_object()) {
+                return;
+            }
+            json full = *obj;
+            token.defer("Ad5xSoakModel::status_query", [this, full]() { set_status(full); });
+        },
+        [](const MoonrakerError& err) {
+            spdlog::debug("[AD5X soak] {} query failed: {}", kObject, err.message);
+        },
+        0, /*silent=*/true);
+}
+
+void Ad5xSoakModel::set_status(const json& full) {
+    status_ = full;
+    loaded_ = true;
+    on_running_changed();
+}
+
+void Ad5xSoakModel::merge_status(const json& delta) {
+    // Deltas only patch a full object; the query in flight brings one
+    if (!loaded_ || !status_.is_object()) {
+        return;
+    }
+    for (auto it = delta.begin(); it != delta.end(); ++it) {
+        status_[it.key()] = it.value();
+    }
+    on_running_changed();
+}
+
+void Ad5xSoakModel::on_running_changed() {
+    running_ = json_util::safe_bool(status_, "running");
+    if (!running_) {
+        if (request_timed_out_) {
+            // Our request outlived its timeout: the object says when it ended
+            finish_from_object();
+        } else if (!request_in_flight_) {
+            // A calibration started elsewhere (console, macro) and stopped here
+            stop_requested_ = false;
+        }
+    }
+    refresh();
+}
+
+void Ad5xSoakModel::on_gcode_response(const std::string& line) {
+    if (request_in_flight_) {
+        console_result_ = line;
+    }
+}
+
+void Ad5xSoakModel::set_bed_index(int index) {
+    const int count = static_cast<int>(bed_temps().size());
+    bed_index_ = std::clamp(index, 0, count - 1);
+}
+
+void Ad5xSoakModel::set_enabled(bool on) {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api || calibrating()) {
+        // Puts the switch back
+        if (subjects_initialized_) {
+            lv_subject_notify(&enabled_);
+        }
+        return;
+    }
+    const std::string gcode = fmt::format("BED_SOAK_ENABLE ENABLE={}", on ? 1 : 0);
+    spdlog::info("[AD5X soak] {}", gcode);
+    if (subjects_initialized_) {
+        lv_subject_set_int(&enabled_, on ? 1 : 0);
+    }
+    ++enable_pending_;
+    refresh();
+
+    // Klipper's answer releases the switch; a fresh query then shows what it kept
+    const auto token = lifetime_.token();
+    api->execute_gcode(
+        gcode,
+        [this, token]() {
+            token.defer("Ad5xSoakModel::enable_done", [this]() {
+                enable_pending_ = std::max(0, enable_pending_ - 1);
+                query();
+                refresh();
+            });
+        },
+        [this, token](const MoonrakerError& err) {
+            const std::string message = err.message;
+            token.defer("Ad5xSoakModel::enable_error", [this, message]() {
+                enable_pending_ = std::max(0, enable_pending_ - 1);
+                NOTIFY_WARNING("{}", message.empty() ? std::string(lv_tr("Failed")) : message);
+                query();
+                refresh();
+            });
+        },
+        0, /*silent=*/false, /*on_queued=*/nullptr, /*caller_surfaces_errors=*/true);
+}
+
+void Ad5xSoakModel::calibrate(int bed) {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api) {
+        NOTIFY_WARNING("{}", lv_tr("Not connected to the printer"));
+        return;
+    }
+    if (calibrating()) {
+        return;
+    }
+    const std::string gcode = calibrate_gcode(bed);
+    spdlog::info("[AD5X soak] {}", gcode);
+    request_in_flight_ = true;
+    request_timed_out_ = false;
+    stop_requested_ = false;
+    request_bed_ = bed;
+    console_result_.clear();
+    if (subjects_initialized_) {
+        lv_subject_set_int(&result_kind_, static_cast<int>(ResultKind::None));
+        copy_if_changed(&result_, "");
+    }
+    refresh();
+
+    // The answer comes when the calibration ends, 20-35 minutes from now; a
+    // long wait is the command working. The model outlives the overlay, so
+    // the end is reported wherever the user is.
+    const auto token = lifetime_.token();
+    api->execute_gcode(
+        gcode,
+        [this, token]() {
+            token.defer("Ad5xSoakModel::calibrate_done", [this]() {
+                if (!request_in_flight_) {
+                    return;
+                }
+                std::string text = console_result_;
+                if (text.empty()) {
+                    text = fmt::format(fmt::runtime(lv_tr("Bed soak at {} °C calibrated.")),
+                                       request_bed_);
+                }
+                finish(ResultKind::Done, text);
+                query();
+            });
+        },
+        [this, token](const MoonrakerError& err) {
+            const bool timed_out = err.type == MoonrakerErrorType::TIMEOUT;
+            const std::string message = err.message;
+            token.defer("Ad5xSoakModel::calibrate_error", [this, timed_out, message]() {
+                if (!request_in_flight_) {
+                    return;
+                }
+                if (timed_out && running_) {
+                    // Still running on the printer: follow `running` from here
+                    spdlog::info("[AD5X soak] No answer yet; following the object");
+                    request_timed_out_ = true;
+                    refresh();
+                    return;
+                }
+                if (stop_requested_) {
+                    finish(ResultKind::Stopped,
+                           lv_tr("Calibration stopped. Heaters off, nothing saved."));
+                } else {
+                    finish(ResultKind::Failed,
+                           message.empty() ? std::string(lv_tr("Failed")) : message);
+                }
+                query();
+            });
+        },
+        kCalibrateTimeoutMs, /*silent=*/false, /*on_queued=*/nullptr,
+        /*caller_surfaces_errors=*/true);
+}
+
+void Ad5xSoakModel::stop() {
+    if (!calibrating() || stop_requested_) {
+        return;
+    }
+    IMoonrakerClient* client = get_moonraker_client();
+    if (!client || client->get_connection_state() != ConnectionState::CONNECTED) {
+        NOTIFY_WARNING("{}", lv_tr("Not connected to the printer"));
+        return;
+    }
+    spdlog::info("[AD5X soak] {}", kAbortMethod);
+    stop_requested_ = true;
+    refresh();
+
+    const auto token = lifetime_.token();
+    client->send_jsonrpc(
+        kAbortMethod, json::object(),
+        [this, token](const json& /*reply*/) {
+            // The calibration ends within a second; its request reports that
+            token.defer("Ad5xSoakModel::abort_done", [this]() {
+                query();
+                refresh();
+            });
+        },
+        [this, token](const MoonrakerError& err) {
+            const int code = err.code;
+            const std::string message = err.message;
+            token.defer("Ad5xSoakModel::abort_error", [this, code, message]() {
+                stop_requested_ = false;
+                if (code == -32601 || code == 404) {
+                    NOTIFY_WARNING("{}", lv_tr("This printer can't stop the calibration from the "
+                                               "screen; use the emergency stop."));
+                } else {
+                    NOTIFY_WARNING("{}", message.empty() ? std::string(lv_tr("Failed")) : message);
+                }
+                refresh();
+            });
+        },
+        kAbortTimeoutMs, /*silent=*/true);
+}
+
+void Ad5xSoakModel::finish(ResultKind kind, const std::string& text) {
+    spdlog::info("[AD5X soak] Calibration ended ({}): {}", static_cast<int>(kind), text);
+    request_in_flight_ = false;
+    request_timed_out_ = false;
+    stop_requested_ = false;
+    console_result_.clear();
+    if (subjects_initialized_) {
+        copy_if_changed(&result_, text);
+        lv_subject_set_int(&result_kind_, static_cast<int>(kind));
+    }
+    switch (kind) {
+    case ResultKind::Done:
+        NOTIFY_SUCCESS("{}", text);
+        break;
+    case ResultKind::Stopped:
+        NOTIFY_INFO("{}", text);
+        break;
+    case ResultKind::Failed:
+        NOTIFY_WARNING("{}", text);
+        break;
+    case ResultKind::None:
+        break;
+    }
+    refresh();
+}
+
+void Ad5xSoakModel::finish_from_object() {
+    if (!console_result_.empty()) {
+        finish(ResultKind::Done, console_result_);
+    } else if (stop_requested_) {
+        finish(ResultKind::Stopped, lv_tr("Calibration stopped. Heaters off, nothing saved."));
+    } else {
+        finish(ResultKind::Done, lv_tr("The calibration ended; the list shows what was saved."));
+    }
+}
+
+std::string Ad5xSoakModel::status_text() const {
+    if (stop_requested_) {
+        return lv_tr("Stopping: heaters off...");
+    }
+    std::string message =
+        lv_subject_get_string(get_printer_state().print_state().get_display_message_subject());
+    if (running_ && starts_with(message, kStatusPrefix)) {
+        message.erase(0, std::char_traits<char>::length(kStatusPrefix));
+        if (!message.empty()) {
+            message[0] = static_cast<char>(std::toupper(static_cast<unsigned char>(message[0])));
+            return message;
+        }
+    }
+    return running_ ? lv_tr("Homing and heating...") : lv_tr("Starting...");
+}
+
+void Ad5xSoakModel::refresh() {
+    if (!subjects_initialized_) {
+        return;
+    }
+    const std::vector<Calibration> calibration = parse_calibration(status_);
+    const bool enabled = json_util::safe_bool(status_, "enabled", true);
+    const bool calib = calibrating();
+
+    std::string summary;
+    if (loaded_) {
+        summary = calib ? std::string(lv_tr("Calibrating...")) : summary_text(enabled, calibration);
+    }
+    copy_if_changed(&summary_, summary);
+    copy_if_changed(&calibrated_, loaded_ ? calibrated_text(calibration) : std::string());
+    // While Klipper has not answered a change, the switch keeps what the user set
+    if (loaded_ && enable_pending_ == 0) {
+        set_if_changed(&enabled_, enabled ? 1 : 0);
+    }
+
+    set_if_changed(&view_, calib ? 1 : 0);
+    set_if_changed(&stopping_, stop_requested_ ? 1 : 0);
+    set_if_changed(&busy_, (calib || enable_pending_ > 0 || !loaded_ || !klippy_ready_) ? 1 : 0);
+    if (calib) {
+        copy_if_changed(&status_line_, status_text());
+        const json* last = json_util::find_member(status_, "last");
+        // Until the printer runs it, `last` still holds the previous calibration's rounds
+        copy_if_changed(&rounds_, (last && running_) ? rounds_text(*last, kRoundsShown)
+                                                     : rounds_text(json::array(), kRoundsShown));
+    }
+}
+
+Ad5xSoakModel& model() {
+    return helix::lazy_global<Ad5xSoakModel>("Ad5xSoakModel");
+}
+
+} // namespace helix::ad5x_soak
+
+// ============================================================================
+// OVERLAY
+// ============================================================================
+
+namespace helix::settings {
+
+namespace ad5x_soak = helix::ad5x_soak;
+
+void Ad5xSoakOverlay::init_subjects() {
+    ad5x_soak::model().init_subjects();
+}
+
+void Ad5xSoakOverlay::register_callbacks() {
+    register_xml_callbacks({
+        {"on_ad5x_soak_enabled_changed",
+         [](lv_event_t* e) {
+             get_ad5x_soak_overlay().handle_enabled_changed(helix::ui::event_checked(e));
+         }},
+        {"on_ad5x_soak_bed_changed",
+         [](lv_event_t* e) {
+             get_ad5x_soak_overlay().handle_bed_changed(helix::ui::event_selected(e));
+         }},
+        {"on_ad5x_soak_calibrate", [](lv_event_t*) { get_ad5x_soak_overlay().handle_calibrate(); }},
+        {"on_ad5x_soak_stop", [](lv_event_t*) { get_ad5x_soak_overlay().handle_stop(); }},
+    });
+}
+
+void Ad5xSoakOverlay::on_activate() {
+    OverlayBase::on_activate();
+    init_bed_dropdown();
+    ad5x_soak::model().start();
+}
+
+void Ad5xSoakOverlay::init_bed_dropdown() {
+    if (!overlay_root_) {
+        return;
+    }
+    lv_obj_t* row = helix::ui::find_required(overlay_root_, "row_ad5x_soak_bed", get_name());
+    lv_obj_t* dropdown = row ? helix::ui::find_required(row, "dropdown", get_name()) : nullptr;
+    if (!dropdown) {
+        return;
+    }
+    std::string options;
+    for (int temp : ad5x_soak::bed_temps()) {
+        if (!options.empty()) {
+            options += '\n';
+        }
+        options += fmt::format("{} °C", temp);
+    }
+    lv_dropdown_set_options(dropdown, options.c_str());
+    lv_dropdown_set_selected(dropdown, static_cast<uint32_t>(ad5x_soak::model().bed_index()));
+}
+
+void Ad5xSoakOverlay::handle_enabled_changed(bool on) {
+    ad5x_soak::model().set_enabled(on);
+}
+
+void Ad5xSoakOverlay::handle_bed_changed(int index) {
+    ad5x_soak::model().set_bed_index(index);
+}
+
+void Ad5xSoakOverlay::handle_calibrate() {
+    auto& soak = ad5x_soak::model();
+    if (soak.calibrating() || !soak.loaded() || !soak.klippy_ready()) {
+        return;
+    }
+    if (lv_subject_get_int(get_printer_state().print_state().get_print_active_subject()) != 0) {
+        helix::ui::modal_alert(lv_tr("Can't calibrate now"),
+                               lv_tr("The bed soak can't be calibrated during a print."),
+                               ModalSeverity::Warning);
+        return;
+    }
+    // Klipper refuses a warm bed too; saying so here spares the homing
+    const int bed_c =
+        lv_subject_get_int(get_printer_state().temperature_state().get_bed_temp_subject()) / 10;
+    if (bed_c >= ad5x_soak::kColdBedC) {
+        const std::string message = fmt::format(
+            fmt::runtime(lv_tr("Let the bed cool below {} °C (now {} °C). The calibration "
+                               "measures from a cold bed.")),
+            ad5x_soak::kColdBedC, bed_c);
+        helix::ui::modal_alert(lv_tr("The bed is still warm"), message.c_str(),
+                               ModalSeverity::Warning);
+        return;
+    }
+
+    const auto& temps = ad5x_soak::bed_temps();
+    const int index = std::clamp(soak.bed_index(), 0, static_cast<int>(temps.size()) - 1);
+    const int bed = temps[static_cast<std::size_t>(index)];
+    const std::string title =
+        fmt::format(fmt::runtime(lv_tr("Calibrate the bed soak at {} °C?")), bed);
+    // The model does the work: it outlives this overlay and the dialog
+    helix::ui::modal_confirm(
+        title.c_str(),
+        lv_tr("The bed must be empty. The printer homes, heats the nozzle and bed and probes "
+              "the bed every minute; this takes 20-35 minutes. Continue?"),
+        ModalSeverity::Warning, lv_tr("Calibrate"), [bed]() { ad5x_soak::model().calibrate(bed); });
+}
+
+void Ad5xSoakOverlay::handle_stop() {
+    if (!ad5x_soak::model().calibrating()) {
+        return;
+    }
+    helix::ui::modal_confirm(
+        lv_tr("Stop the calibration?"), lv_tr("The heaters switch off and nothing is saved."),
+        ModalSeverity::Warning, lv_tr("Stop"), []() { ad5x_soak::model().stop(); });
+}
+
+} // namespace helix::settings
