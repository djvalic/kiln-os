+constexpr const char* kObject = "ad5x_soak";
+constexpr const char* kAbortMethod = "printer.ad5x_soak.abort";
+constexpr uint32_t kAbortTimeoutMs = 10u * 1000u;
+/// BED_SOAK_CALIBRATE answers when it ends: homing, 5 minutes of nozzle soak,
+/// the bed heating and up to 25 minutes of probing. Past this the screen stops
+/// waiting for the answer and follows `running` alone.
+constexpr uint32_t kCalibrateTimeoutMs = 75u * 60u * 1000u;
+/// Rounds shown while a calibration runs (one per minute).
+constexpr std::size_t kRoundsShown = 8;
+/// Klipper's status line during a calibration starts with this.
+constexpr const char* kStatusPrefix = "Bed soak test: ";
+/// Klipper's final console line starts with this.
+constexpr const char* kResultPrefix = "Bed soak at ";
+
+void copy_if_changed(lv_subject_t* subject, const std::string& text) {
+    const char* cur = lv_subject_get_string(subject);
+    if (!cur || text != cur) {
+        lv_subject_copy_string(subject, text.c_str());
+    }
+}
+
+void set_if_changed(lv_subject_t* subject, int value) {
+    if (lv_subject_get_int(subject) != value) {
+        lv_subject_set_int(subject, value);
+    }
+}
+
+bool starts_with(const std::string& s, const char* prefix) {
+    return s.rfind(prefix, 0) == 0;
+}
