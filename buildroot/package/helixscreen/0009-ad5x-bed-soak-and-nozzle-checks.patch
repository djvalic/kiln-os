+// ============================================================================
+// CHECKS AFTER A CHANGE IN SETTINGS
+// ============================================================================
+
+namespace {
+
+/// How long the offer waits for Klipper to come back with the new size.
+constexpr uint32_t kFollowUpTimeoutMs = 90u * 1000u;
+/// Klipper's restart can fall between two klippy state notifications: look again this often.
+constexpr uint32_t kFollowUpPollMs = 2000u;
+
+/// Waits until Klipper runs with the new size, then offers the hotend PID and
+/// Z offset checks. One at a time: a second change restarts the wait.
+class NozzleChangeFollowUp {
+  public:
+    void watch(double mm) {
+        target_ = mm;
+        waited_ms_ = 0;
+        timer_.reset(lv_timer_create(
+            [](lv_timer_t* t) {
+                static_cast<NozzleChangeFollowUp*>(lv_timer_get_user_data(t))->tick();
+            },
+            kFollowUpPollMs, this));
+    }
+
+  private:
+    void tick() {
+        auto& nozzle = model();
+        const auto& size = nozzle.status().size;
+        if (nozzle.klippy_ready() && nozzle.loaded() && size && same_size(*size, target_)) {
+            timer_.reset();
+            offer();
+            return;
+        }
+        waited_ms_ += kFollowUpPollMs;
+        if (waited_ms_ >= kFollowUpTimeoutMs) {
+            spdlog::info("[AD5X nozzle] Klipper is not back with {}: no checks offered",
+                         size_label(target_));
+            timer_.reset();
+            return;
+        }
+        if (nozzle.klippy_ready()) {
+            nozzle.query();
+        }
+    }
+
+    void offer() const {
+        // Not over a wizard (it runs these steps itself) or a print
+        if (is_wizard_active() || !ad5x_setup::available() ||
+            lv_subject_get_int(get_printer_state().print_state().get_print_active_subject()) != 0) {
+            return;
+        }
+        spdlog::info("[AD5X nozzle] Klipper runs with {}: offering the checks",
+                     size_label(target_));
+        const std::string title =
+            fmt::format(fmt::runtime(lv_tr("Nozzle changed to {}")), size_label(target_));
+        helix::ui::ConfirmOptions opts;
+        opts.cancel_text = lv_tr("Later");
+        helix::ui::modal_confirm(
+            title.c_str(),
+            lv_tr("Run the hotend PID tune and the first-layer Z offset test now? (The bed "
+                  "doesn't need retuning.)"),
+            ModalSeverity::Info, lv_tr("Run"),
+            []() {
+                if (!is_wizard_active()) {
+                    ad5x_setup::launch_nozzle_checks(lv_screen_active());
+                }
+            },
+            opts);
+    }
+
+    double target_ = 0.0;
+    uint32_t waited_ms_ = 0;
+    helix::ui::LvglTimerGuard timer_;
+};
+
+} // namespace
+
+void offer_checks_when_applied(double mm) {
+    helix::lazy_global<NozzleChangeFollowUp>("Ad5xNozzleChangeFollowUp").watch(mm);
+}
+
 } // namespace helix::ad5x_nozzle
 
