diff --git a/tests/unit/test_settings_ad5x_soak.cpp b/tests/unit/test_settings_ad5x_soak.cpp
new file mode 100644
index 0000000000..136f3e8cd7
--- /dev/null
+++ b/tests/unit/test_settings_ad5x_soak.cpp
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "ui_settings_ad5x_soak.h"
+
+#include "../catch_amalgamated.hpp"
+#include "hv/json.hpp"
+
+using namespace helix::ad5x_soak;
+
+namespace {
+
+/// The `ad5x_soak` object as Klipper publishes it.
+json sample_status() {
+    return json::parse(R"({
+        "enabled": true,
+        "calibration": {
+            "80": {"settle": 395, "settle_corners": 780, "drift": 0.112, "warp": 0.03,
+                   "points": 5, "from": 22, "stable": false, "date": "2026-10-20"},
+            "60": {"settle": 420, "settle_corners": 760, "drift": -0.0874, "warp": 0.02,
+                   "points": 5, "from": 21, "stable": true, "date": "2026-10-20"},
+            "junk": {"settle": 1},
+            "70": "not an object"
+        },
+        "running": false,
+        "soak": 0.0,
+        "last": []
+    })");
+}
+
+} // namespace
+
+TEST_CASE("calibration entries are parsed and sorted by temperature", "[ad5x_soak]") {
+    const auto cal = parse_calibration(sample_status());
+    REQUIRE(cal.size() == 2);
+    CHECK(cal[0].temp == 60);
+    CHECK(cal[0].settle == 420);
+    CHECK(cal[0].drift == Catch::Approx(-0.0874));
+    CHECK(cal[0].stable);
+    CHECK(cal[1].temp == 80);
+    CHECK(cal[1].settle == 395);
+    CHECK_FALSE(cal[1].stable);
+
+    CHECK(parse_calibration(json::object()).empty());
+    CHECK(parse_calibration(json::parse(R"({"calibration": []})")).empty());
+}
+
+TEST_CASE("bed soak texts", "[ad5x_soak]") {
+    CHECK(duration_text(420) == "7:00");
+    CHECK(duration_text(65) == "1:05");
+    CHECK(duration_text(-3) == "0:00");
+
+    const auto cal = parse_calibration(sample_status());
+    CHECK(summary_text(false, cal) == "Off");
+    CHECK(summary_text(true, cal) == "On · 60 °C 7:00, 80 °C 6:35");
+    CHECK(summary_text(true, {}) == "On · not calibrated");
+
+    const std::string list = calibrated_text(cal);
+    CHECK(list.find("60 °C — 7:00 (centre moved 0.09 mm)") != std::string::npos);
+    CHECK(list.find("80 °C — 6:35 (centre moved 0.11 mm), not fully settled") != std::string::npos);
+    CHECK(calibrated_text({}).rfind("Not calibrated yet", 0) == 0);
+
+    CHECK(calibrate_gcode(60) == "BED_SOAK_CALIBRATE BED=60");
+}
+
+TEST_CASE("rounds show the change since the first reading", "[ad5x_soak]") {
+    const json last = json::parse(R"([
+        [0.0, -0.100, -0.050, -0.040, -0.060, -0.055],
+        [60.2, -0.130, -0.052, -0.030, -0.070, -0.055],
+        [120.4, -0.160, -0.060, -0.020, -0.080, -0.050]
+    ])");
+    const std::string all = rounds_text(last, 8);
+    CHECK(all.find("0:00  centre +0.000 mm, corners +0.000 to +0.000") != std::string::npos);
+    CHECK(all.find("2:00  centre -0.060 mm, corners -0.020 to +0.020") != std::string::npos);
+
+    // Only the newest rows
+    const std::string newest = rounds_text(last, 1);
+    CHECK(newest.find("0:00") == std::string::npos);
+    CHECK(newest.find("2:00") != std::string::npos);
+
+    // Centre only (POINTS=1)
+    const std::string centre = rounds_text(json::parse(R"([[0, 0.5], [30, 0.49]])"), 8);
+    CHECK(centre.find("0:30  centre -0.010 mm") != std::string::npos);
+    CHECK(centre.find("corners") == std::string::npos);
+
+    CHECK(rounds_text(json::array(), 8).rfind("No readings yet", 0) == 0);
+}
+
+TEST_CASE("only Klipper's final line is a result", "[ad5x_soak]") {
+    CHECK(result_line("// Bed soak at 60 C: the centre moved -0.087 mm") ==
+          "Bed soak at 60 C: the centre moved -0.087 mm");
+    CHECK(result_line("Bed soak at 80 C: done\n") == "Bed soak at 80 C: done");
+    CHECK(result_line("// 240 s: centre -0.0659, corners ...").empty());
+    CHECK(result_line("// Bed soak calibration at 60 C (from 21 C): ...").empty());
+}
