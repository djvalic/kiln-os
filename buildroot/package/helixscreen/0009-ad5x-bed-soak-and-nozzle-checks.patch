+
+const std::vector<int>& bed_temps() {
+    static const std::vector<int> temps = {60, 70, 80, 90, 100, 110};
+    return temps;
+}
+
+std::vector<Calibration> parse_calibration(const json& status) {
+    std::vector<Calibration> out;
+    const json* cal = json_util::find_member(status, "calibration");
+    if (!cal || !cal->is_object()) {
+        return out;
+    }
+    for (auto it = cal->begin(); it != cal->end(); ++it) {
+        if (!it.value().is_object()) {
+            continue;
+        }
+        char* end = nullptr;
+        const long temp = std::strtol(it.key().c_str(), &end, 10);
+        if (end == it.key().c_str() || temp <= 0 || temp > 200) {
+            continue;
+        }
+        Calibration c;
+        c.temp = static_cast<int>(temp);
+        c.settle = std::max(
+            0, static_cast<int>(std::lround(json_util::safe_double(it.value(), "settle", 0.0))));
+        c.drift = json_util::safe_double(it.value(), "drift", 0.0);
+        c.stable = json_util::safe_bool(it.value(), "stable", true);
+        out.push_back(c);
+    }
+    std::sort(out.begin(), out.end(),
+              [](const Calibration& a, const Calibration& b) { return a.temp < b.temp; });
+    return out;
+}
+
+std::string duration_text(int seconds) {
+    seconds = std::max(0, seconds);
+    return fmt::format("{}:{:02d}", seconds / 60, seconds % 60);
+}
+
+std::string calibrated_text(const std::vector<Calibration>& calibration) {
+    if (calibration.empty()) {
+        return lv_tr("Not calibrated yet: 3 s per degree the bed heats, at most 10 minutes");
+    }
+    std::string out;
+    for (const auto& c : calibration) {
+        if (!out.empty()) {
+            out += '\n';
+        }
+        out += fmt::format(fmt::runtime(lv_tr("{} °C — {} (centre moved {:.2f} mm)")), c.temp,
+                           duration_text(c.settle), std::fabs(c.drift));
+        if (!c.stable) {
+            out += lv_tr(", not fully settled");
+        }
+    }
+    return out;
+}
+
+std::string summary_text(bool enabled, const std::vector<Calibration>& calibration) {
+    if (!enabled) {
+        return lv_tr("Off");
+    }
+    if (calibration.empty()) {
+        return fmt::format("{} · {}", lv_tr("On"), lv_tr("not calibrated"));
+    }
+    std::string times;
+    for (const auto& c : calibration) {
+        if (!times.empty()) {
+            times += ", ";
+        }
+        times += fmt::format("{} °C {}", c.temp, duration_text(c.settle));
+    }
+    return fmt::format("{} · {}", lv_tr("On"), times);
+}
+
+std::string rounds_text(const json& last, std::size_t max_rows) {
+    if (!last.is_array() || last.empty()) {
+        return lv_tr("No readings yet: the first comes once the bed is hot.");
+    }
+    const json& first = last.front();
+    auto value = [](const json& row, std::size_t i) {
+        return (row.is_array() && i < row.size()) ? json_util::as_double(row[i], NAN) : NAN;
+    };
+    const std::size_t begin = last.size() > max_rows ? last.size() - max_rows : 0;
+    std::string out;
+    for (std::size_t r = begin; r < last.size(); ++r) {
+        const json& row = last[r];
+        const double t = value(row, 0);
+        const double centre = value(row, 1) - value(first, 1);
+        if (std::isnan(t) || std::isnan(centre)) {
+            continue;
+        }
+        std::string line = fmt::format(fmt::runtime(lv_tr("{}  centre {:+.3f} mm")),
+                                       duration_text(static_cast<int>(std::lround(t))), centre);
+        // Corners: the range of their change since the first round
+        double lo = NAN;
+        double hi = NAN;
+        for (std::size_t i = 2; row.is_array() && i < row.size(); ++i) {
+            const double d = value(row, i) - value(first, i);
+            if (std::isnan(d)) {
+                continue;
+            }
+            lo = std::isnan(lo) ? d : std::min(lo, d);
+            hi = std::isnan(hi) ? d : std::max(hi, d);
+        }
+        if (!std::isnan(lo)) {
+            line += fmt::format(fmt::runtime(lv_tr(", corners {:+.3f} to {:+.3f}")), lo, hi);
+        }
+        if (!out.empty()) {
+            out += '\n';
+        }
+        out += line;
+    }
+    return out;
+}
+
+std::string calibrate_gcode(int bed) {
+    return fmt::format("BED_SOAK_CALIBRATE BED={}", bed);
+}
+
+std::string result_line(const std::string& console_line) {
+    std::string line = console_line;
+    if (starts_with(line, "// ")) {
+        line.erase(0, 3);
+    }
+    if (!starts_with(line, kResultPrefix)) {
+        return {};
+    }
+    while (!line.empty() && (line.back() == '\n' || line.back() == '\r')) {
+        line.pop_back();
+    }
+    return line;
+}
+
+bool available() {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api) {
+        return false;
+    }
+    const auto& objects = api->hardware().printer_objects();
+    return std::find(objects.begin(), objects.end(), kObject) != objects.end();
+}
