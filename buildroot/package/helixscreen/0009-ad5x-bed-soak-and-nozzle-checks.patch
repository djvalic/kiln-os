+void launch_session(lv_obj_t* parent, std::vector<StepId> ids, json params) {
     ui_wizard_register_event_callbacks();
     ui_wizard_container_register_responsive_constants();
     ui_wizard_init_subjects();
+    model().set_session_params(std::move(params));
     // Back on the first step leaves the session, like the other targeted runs.
