+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * @file ui_settings_ad5x_soak.h
+ * @brief Settings > Bed Heat Soak on the AD5X: the `ad5x_soak` Klipper object
+ *
+ * After a cold start the bed keeps moving for minutes after it reaches its
+ * temperature; the print start waits this long before it checks Z. Klipper's
+ * object: `enabled` (BED_SOAK_ENABLE ENABLE=0|1, saved), `calibration` (per
+ * bed temperature: `settle` seconds, `drift` mm the centre moved, ...),
+ * `running` (a calibration runs), `soak` and `last` (the rounds of the
+ * running or last calibration: [[seconds, z centre, z corners...], ...]).
+ *
+ * BED_SOAK_CALIBRATE BED=<C> measures one temperature from a cold bed. It
+ * holds the G-code queue for 20-35 minutes and answers only when it ends, so
+ * the request is sent with a long timeout and the screen follows `running`
+ * meanwhile. Stop is the Klipper API endpoint `ad5x_soak/abort` (JSON-RPC
+ * printer.ad5x_soak.abort): no G-code can reach Klipper while it runs.
+ *
+ * Ad5xSoakModel keeps the object, the shared subjects and the calibration
+ * request; it lives on while the overlay is closed, so a calibration started
+ * here ends with a toast wherever the user is. Ad5xSoakOverlay is the screen.
+ *
+ * @pattern Overlay (lazy init) over a process-wide model
+ * @threading Main thread only; Moonraker callbacks hop over via lifetime tokens
+ */
+
+#pragma once
+
+#include "ui_observer_guard.h"
+#include "ui_subscription_guard.h"
+
+#include "async_lifetime_guard.h"
+#include "json_fwd.h"
+#include "lvgl/lvgl.h"
+#include "overlay_base.h"
+#include "static_panel_registry.h"
+#include "subject_managed_panel.h"
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+namespace helix::ad5x_soak {
+
+/// One calibrated bed temperature.
+struct Calibration {
+    int temp = 0;       ///< Bed temperature, °C
+    int settle = 0;     ///< Seconds the print start waits after the bed is hot
+    double drift = 0.0; ///< How far the bed centre moved, mm
+    bool stable = true; ///< Settled before the calibration's time limit
+};
+
+/// The bed temperatures offered for a calibration, in °C.
+const std::vector<int>& bed_temps();
+
+/// Bed temperature Klipper refuses a calibration from (unless FORCE=1), °C.
+inline constexpr int kColdBedC = 40;
+
+/// The `calibration` field, sorted by temperature; malformed entries skipped.
+std::vector<Calibration> parse_calibration(const json& status);
+
+/// "7:00" for 420 s.
+std::string duration_text(int seconds);
+
+/// The calibrated list, one line per temperature, or the uncalibrated fallback.
+std::string calibrated_text(const std::vector<Calibration>& calibration);
+
+/// The Settings row's line: "On · 60 °C 7:00, 80 °C 7:00", "On · not calibrated", "Off".
+std::string summary_text(bool enabled, const std::vector<Calibration>& calibration);
+
+/// The newest @p max_rows rounds of `last`: time since the bed was hot and how
+/// far the centre (and the corners) moved since the first round.
+std::string rounds_text(const json& last, std::size_t max_rows);
+
+/// "BED_SOAK_CALIBRATE BED=60"
+std::string calibrate_gcode(int bed);
+
+/// Klipper's final console line ("// Bed soak at 60 C: ...") without the
+/// prefix; empty for any other line.
+std::string result_line(const std::string& console_line);
+
+/// Whether the printer publishes the `ad5x_soak` object.
+bool available();
+
+/// How the last calibration request ended (ad5x_soak_result_kind).
+enum class ResultKind {
+    None = 0,    ///< Nothing to report: the line is hidden
+    Done = 1,    ///< Finished; the result line
+    Stopped = 2, ///< Stopped from the screen; nothing saved
+    Failed = 3,  ///< Refused or failed; Klipper's reason
+};
+
+/// The object, the shared subjects and the commands.
+///
+/// Subjects: `ad5x_soak_summary` (the Settings row's line), `ad5x_soak_enabled`,
+/// `ad5x_soak_view` (0 idle, 1 calibrating), `ad5x_soak_busy` (1 while
+/// calibrating, a change is pending or Klipper is not ready: the controls bind
+/// it), `ad5x_soak_stopping`, `ad5x_soak_status`, `ad5x_soak_rounds`,
+/// `ad5x_soak_calibrated`, `ad5x_soak_result` and `ad5x_soak_result_kind`.
+class Ad5xSoakModel {
+  public:
+    Ad5xSoakModel() = default;
+    ~Ad5xSoakModel();
+    Ad5xSoakModel(const Ad5xSoakModel&) = delete;
+    Ad5xSoakModel& operator=(const Ad5xSoakModel&) = delete;
+
+    void init_subjects();
+
+    /// Follow the object (status updates, Klipper restarts, the console's
+    /// result line) from now on, and query it. Safe to call again; later
+    /// calls only query.
+    void start();
+
+    /// Ask Klipper for the whole object.
+    void query();
+
+    bool loaded() const {
+        return loaded_;
+    }
+    bool klippy_ready() const {
+        return klippy_ready_;
+    }
+    /// A calibration runs on the printer or our request has not ended.
+    bool calibrating() const {
+        return running_ || request_in_flight_;
+    }
+
+    /// Position in bed_temps() the chooser shows.
+    int bed_index() const {
+        return bed_index_;
+    }
+    void set_bed_index(int index);
+
+    /// BED_SOAK_ENABLE ENABLE=0|1
+    void set_enabled(bool on);
+
+    /// BED_SOAK_CALIBRATE BED=@p bed. The checks (print, cold bed, empty bed)
+    /// are the caller's; this only refuses while a calibration runs.
+    void calibrate(int bed);
+
+    /// printer.ad5x_soak.abort: ends the running calibration, nothing saved.
+    void stop();
+
+  private:
+    void merge_status(const json& delta);
+    void set_status(const json& full);
+    /// `running` from the cached object; ends a request that outlived its timeout.
+    void on_running_changed();
+    void on_gcode_response(const std::string& line);
+    void finish(ResultKind kind, const std::string& text);
+    void finish_from_object();
+    std::string status_text() const;
+    void refresh();
+
+    SubjectManager subjects_;
+    lv_subject_t summary_{};
+    lv_subject_t enabled_{};
+    lv_subject_t view_{};
+    lv_subject_t busy_{};
+    lv_subject_t stopping_{};
+    lv_subject_t status_line_{};
+    lv_subject_t rounds_{};
+    lv_subject_t calibrated_{};
+    lv_subject_t result_{};
+    lv_subject_t result_kind_{};
+    char summary_buf_[128] = "";
+    char status_line_buf_[160] = "";
+    char rounds_buf_[768] = "";
+    char calibrated_buf_[512] = "";
+    char result_buf_[512] = "";
+    bool subjects_initialized_ = false;
+
+    json status_ = json::object();
+    bool loaded_ = false;
+    bool klippy_ready_ = true;
+    bool started_ = false;
+    bool running_ = false;
+    int bed_index_ = 0;
+    int enable_pending_ = 0;
+
+    // The calibration request: sent, answered or timed out, Stop pressed
+    bool request_in_flight_ = false;
+    bool request_timed_out_ = false;
+    bool stop_requested_ = false;
+    int request_bed_ = 0;
+    std::string console_result_; ///< Klipper's final line for this request
+
+    SubscriptionGuard subscription_;
+    ObserverGuard klippy_observer_;
+    ObserverGuard message_observer_;
+    AsyncLifetimeGuard lifetime_;
+};
+
+Ad5xSoakModel& model();
+
+} // namespace helix::ad5x_soak
+
+namespace helix::settings {
+
+/// Settings > Bed Heat Soak: the on/off switch, the calibrated times and a
+/// calibration with its progress and Stop.
+class Ad5xSoakOverlay : public OverlayBase {
+  public:
+    const char* get_name() const override {
+        return "AD5X Bed Heat Soak";
+    }
+    const char* xml_component() const override {
+        return "settings_ad5x_soak_overlay";
+    }
+    /// Freed on close; the next open rebuilds it.
+    bool destroy_on_close() const override {
+        return true;
+    }
+
+    void init_subjects() override;
+    void register_callbacks() override;
+    void on_activate() override;
+
+    void handle_enabled_changed(bool on);
+    void handle_bed_changed(int index);
+    void handle_calibrate();
+    void handle_stop();
+
+  private:
+    void init_bed_dropdown();
+};
+
+inline Ad5xSoakOverlay& get_ad5x_soak_overlay() {
+    return lazy_global<Ad5xSoakOverlay>("Ad5xSoakOverlay");
+}
+
+} // namespace helix::settings
