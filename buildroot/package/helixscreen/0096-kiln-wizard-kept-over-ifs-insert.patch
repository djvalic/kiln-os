+namespace {
+lv_obj_t* s_kept_screen_layer = nullptr;
+
+void kept_layer_deleted_cb(lv_event_t* e) {
+    if (lv_event_get_target(e) == s_kept_screen_layer) {
+        s_kept_screen_layer = nullptr;
+    }
