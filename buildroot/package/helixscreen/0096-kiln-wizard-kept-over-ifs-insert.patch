+
+void set_kept_screen_layer(lv_obj_t* obj) {
+    if (s_kept_screen_layer && s_kept_screen_layer != obj && lv_obj_is_valid(s_kept_screen_layer)) {
+        lv_obj_remove_event_cb(s_kept_screen_layer, kept_layer_deleted_cb);
+    }
+    s_kept_screen_layer = obj;
+    if (obj) {
+        lv_obj_remove_event_cb(obj, kept_layer_deleted_cb);
+        lv_obj_add_event_cb(obj, kept_layer_deleted_cb, LV_EVENT_DELETE, nullptr);
+    }
+}
+
+bool is_kept_screen_layer(const lv_obj_t* child) {
+    return child && child == s_kept_screen_layer;
+}
