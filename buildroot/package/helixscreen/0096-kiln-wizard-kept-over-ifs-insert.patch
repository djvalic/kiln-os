 // completion-mode specific and remain in ui_wizard_complete().
+bool ui_wizard_reshow() {
+    if (!wizard_container || !lv_obj_is_valid(wizard_container)) {
+        return false;
+    }
+    if (lv_obj_has_flag(wizard_container, LV_OBJ_FLAG_HIDDEN)) {
+        spdlog::info("[Wizard] Wizard container was hidden; showing it again");
+        lv_obj_remove_flag(wizard_container, LV_OBJ_FLAG_HIDDEN);
+    }
+    // Front of the screen, where it was created: the wizard covers the main
+    // UI (and its E-stop chrome) until it ends.
+    lv_obj_move_foreground(wizard_container);
+    return true;
+}
