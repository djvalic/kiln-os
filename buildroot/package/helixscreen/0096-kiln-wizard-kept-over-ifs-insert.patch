+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * @file test_kiln_wizard_kept_layer.cpp
+ * @brief Kiln OS: the setup wizard survives overlays that close over it
+ *
+ * An overlay opened over the wizard (the slot editor a filament insert opens)
+ * closed through nav::go_back(), whose stale-overlay sweep hid every other
+ * screen child, the wizard's container included. The wizard was then out of
+ * reach: still active, so Settings' Run Setup Wizard did nothing. The wizard's
+ * container is now a kept screen layer the sweeps skip, and
+ * ui_wizard_reshow() brings a hidden one back.
+ */
+
+#include "ui_effects.h"
+#include "ui_nav.h"
+#include "ui_nav_manager.h"
+#include "ui_update_queue.h"
+#include "ui_wizard.h"
+
+#include "../lvgl_ui_test_fixture.h"
+#include "../test_helpers/update_queue_test_access.h"
+#include "app_globals.h"
+#include "panel_lifecycle.h"
+
+#include "../catch_amalgamated.hpp"
+
+using namespace helix;
+
+namespace {
+
+class NullLifecycle : public IPanelLifecycle {
+  public:
+    void on_activate() override {}
+    void on_deactivate(DeactivateReason) override {}
+    const char* get_name() const override {
+        return "NullLifecycle";
+    }
+};
+
+class KeptLayerFixture : public LVGLUITestFixture {
+  public:
+    KeptLayerFixture() {
+        home_ = lv_obj_create(test_screen());
+        controls_ = lv_obj_create(test_screen());
+        lv_obj_t* panels[kUiPanelCount] = {nullptr};
+        panels[static_cast<int>(PanelId::Home)] = home_;
+        panels[static_cast<int>(PanelId::Controls)] = controls_;
+        NavigationManager::instance().set_panels(panels);
+
+        overlay_ = lv_obj_create(test_screen());
+        lv_obj_add_flag(overlay_, LV_OBJ_FLAG_HIDDEN);
+        // Stands in for the wizard's container: a full-screen child of the
+        // screen that is neither a panel nor an overlay.
+        wizard_ = lv_obj_create(test_screen());
+        // Any other visible child: the sweeps still hide it.
+        stale_ = lv_obj_create(test_screen());
+    }
+
+    ~KeptLayerFixture() override {
+        ui::set_kept_screen_layer(nullptr);
+        nav::unregister_overlay(overlay_);
+        drain();
+    }
+
+    static void drain() {
+        ui::UpdateQueueTestAccess::drain_all(ui::UpdateQueue::instance());
+    }
+
+    static bool visible(lv_obj_t* obj) {
+        return !lv_obj_has_flag(obj, LV_OBJ_FLAG_HIDDEN);
+    }
+
+    lv_obj_t* home_ = nullptr;
+    lv_obj_t* controls_ = nullptr;
+    lv_obj_t* overlay_ = nullptr;
+    lv_obj_t* wizard_ = nullptr;
+    lv_obj_t* stale_ = nullptr;
+    NullLifecycle lifecycle_;
+};
+
+} // namespace
+
+TEST_CASE_METHOD(KeptLayerFixture, "Kiln: go_back's sweep leaves the kept layer visible",
+                 "[navigation][kiln][wizard]") {
+    ui::set_kept_screen_layer(wizard_);
+    nav::register_overlay(overlay_, &lifecycle_);
+
+    nav::push_overlay(overlay_);
+    drain();
+    REQUIRE(nav::is_on_top(overlay_));
+
+    REQUIRE(nav::go_back());
+    drain();
+    CHECK(visible(wizard_));
+    CHECK_FALSE(visible(stale_));
+}
+
+TEST_CASE_METHOD(KeptLayerFixture, "Kiln: a panel switch leaves the kept layer visible",
+                 "[navigation][kiln][wizard]") {
+    ui::set_kept_screen_layer(wizard_);
+    nav::register_overlay(overlay_, &lifecycle_);
+    nav::push_overlay(overlay_);
+    drain();
+    REQUIRE(nav::is_on_top(overlay_));
+
+    // A navbar tap with an overlay open: the switch clears the stack and sweeps
+    // the screen's other children (Home needs no printer connection).
+    REQUIRE(NavigationManager::instance().request_panel(
+                PanelId::Home, NavigationManager::SwitchDispatch::Inline) ==
+            NavigationManager::PanelRequest::Switched);
+    drain();
+    CHECK_FALSE(nav::is_in_stack(overlay_));
+    CHECK(visible(wizard_));
+    CHECK_FALSE(visible(stale_));
+}
+
+TEST_CASE_METHOD(KeptLayerFixture, "Kiln: without the kept layer the sweep hides it, as before",
+                 "[navigation][kiln][wizard]") {
+    nav::register_overlay(overlay_, &lifecycle_);
+    nav::push_overlay(overlay_);
+    drain();
+    REQUIRE(nav::go_back());
+    drain();
+    CHECK_FALSE(visible(wizard_));
+}
+
+TEST_CASE_METHOD(KeptLayerFixture, "Kiln: a deleted kept layer is no longer kept",
+                 "[navigation][kiln][wizard]") {
+    lv_obj_t* layer = lv_obj_create(test_screen());
+    ui::set_kept_screen_layer(layer);
+    REQUIRE(ui::is_kept_screen_layer(layer));
+    lv_obj_delete(layer);
+    CHECK_FALSE(ui::is_kept_screen_layer(layer));
+    CHECK_FALSE(ui::is_kept_screen_layer(nullptr));
+}
+
+TEST_CASE_METHOD(LVGLUITestFixture,
+                 "Kiln: the wizard's container is kept and reshow brings it back",
+                 "[wizard][kiln]") {
+    CHECK_FALSE(ui_wizard_reshow()); // no wizard yet
+
+    lv_obj_t* root =
+        ui_wizard_create_targeted(test_screen(), {helix::wizard::StepId::FanSelect}, [] {});
+    if (root == nullptr) {
+        ui_wizard_complete_targeted();
+        SKIP("wizard container not created (XML infra unavailable)");
+    }
+    REQUIRE(is_wizard_active());
+    CHECK(ui::is_kept_screen_layer(root));
+
+    // Something hid it anyway (any path the sweeps don't cover).
+    lv_obj_t* above = lv_obj_create(test_screen());
+    lv_obj_add_flag(root, LV_OBJ_FLAG_HIDDEN);
+    CHECK(ui_wizard_reshow());
+    CHECK_FALSE(lv_obj_has_flag(root, LV_OBJ_FLAG_HIDDEN));
+    // In front of the screen's other children again.
+    CHECK(lv_obj_get_index(root) > lv_obj_get_index(above));
+
+    ui_wizard_complete_targeted();
+    CHECK_FALSE(is_wizard_active());
+    CHECK_FALSE(ui::is_kept_screen_layer(root));
+    CHECK_FALSE(ui_wizard_reshow());
+}
