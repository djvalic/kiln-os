         fire_event("CONNECTED");
         request_status_refresh();
         return;
@@ -1132,6 +1138,15 @@ void WifiBackendNetworkManager::connect_thread_func(std::string ssid, std::strin
                  attempt.stderr_out.empty()
                      ? ""
                      : ", stderr: " + helix::redact::names_in_text(attempt.stderr_out));
+    // Kiln: a key the access point refuses ends the 4-way handshake in a
+    // timeout; NetworkManager then asks for new secrets, no agent answers,
+    // and nmcli reports "Secrets were required, but not provided". That is
+    // the wrong-password case: say so, not just "Connection failed".
+    if (!password.empty() && is_secrets_required_error(attempt.stderr_out)) {
+        fire_event("AUTH_FAILED", helix::kWifiWrongPasswordReason);
+        request_status_refresh();
+        return;
+    }
     // nmcli exit code 10 = connection timeout; doesn't cleanly distinguish auth
     // failure. Fire AUTH_FAILED as the best guess for secured networks.
     if (!password.empty()) {
@@ -1265,6 +1280,20 @@ WifiBackend::ConnectionStatus WifiBackendNetworkManager::get_status() {
     return cached_status_;
 }
 
+void WifiBackendNetworkManager::refresh_status_cache() {
+    // Only the cache: the transition events stay with the connect path and
+    // the status poll (apply_polled_status). An inconclusive read keeps the
+    // last-known status, as the poll does.
+    if (std::optional<ConnectionStatus> fresh = poll_status_now()) {
+        std::lock_guard<std::mutex> lock(status_mutex_);
+        cached_status_ = *fresh;
+    }
+}
+
+bool WifiBackendNetworkManager::is_secrets_required_error(const std::string& stderr_output) {
+    return stderr_output.find("Secrets were required") != std::string::npos;
+}
+
 std::optional<WifiBackend::ConnectionStatus> WifiBackendNetworkManager::poll_status_now() {
     ConnectionStatus status = {};
     status.connected = false;
