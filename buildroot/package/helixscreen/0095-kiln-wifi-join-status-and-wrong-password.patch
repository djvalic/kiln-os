--- a/src/network/wifi_backend_networkmanager.cpp
+++ b/src/network/wifi_backend_networkmanager.cpp
@@ -1111,6 +1111,12 @@ void WifiBackendNetworkManager::connect_thread_func(std::string ssid, std::strin
 
     if (attempt.exit_code == 0) {
         spdlog::info("[WifiBackend] NM: Connected to '{}'", helix::redact::ssid(ssid));
+        // Kiln: the status cache first, then CONNECTED. The event's listeners
+        // read get_status() at once (Network Settings, the wizard's address
