+// ============================================================================
+// Kiln: CONNECTED carries the joined network's status
+// ============================================================================
+//
+// Network Settings and the setup wizard read get_status() as soon as
+// CONNECTED arrives. The cache used to hold the poll from before the join
+// ("Not connected"), and the poll after it fired nothing to correct the
+// screen: the connect path had already set prev_connected_.
+
+TEST_CASE("NM backend: Kiln: CONNECTED listeners read the joined network",
+          "[network][nm][status][slow]") {
+    FakeNmcliDir fake;
+    ScopedPathPrepend path_prepend(fake.dir);
+    fake.set_status("GENERAL.DEVICE:wlan0\nGENERAL.TYPE:wifi\nGENERAL.HWADDR:88:A9:A7:00:11:22\n"
+                    "GENERAL.STATE:100 (connected)\nGENERAL.CONNECTION:HomeNet\n",
+                    "*:HomeNet:82\n :Neighbour:40\n", "IP4.ADDRESS[1]:192.0.2.41/24\n");
+
+    // Declared before the backend so they outlive the connect thread's
+    // callback (see the hidden connect test).
+    std::atomic<bool> connected{false};
+    WifiBackend::ConnectionStatus seen;
+    TestableNMBackend backend;
+    backend.force_running("wlan0");
+    backend.register_event_callback("CONNECTED", [&](const std::string&) {
+        seen = backend.get_status();
+        connected = true;
+    });
+
+    // Before the join: the last poll said not connected
+    REQUIRE_FALSE(backend.get_status().connected);
+
+    REQUIRE(backend.connect_network("HomeNet", "newpass2", false).success());
+    REQUIRE(helix_test::wait_until([&connected] { return connected.load(); }, 8000));
+
+    CHECK(seen.connected);
+    CHECK(seen.ssid == "HomeNet");
+    CHECK(seen.ip_address == "192.0.2.41");
+    CHECK(seen.signal_strength == 82);
+    CHECK(seen.mac_address == "88:A9:A7:00:11:22");
+    // The reads are not joins: only the connect itself acted
+    CHECK(fake.call_count() == 1);
+
+    // The poll after it, reading the same network, sees no transition: no
+    // second CONNECTED and (1.2) no ADDRESS_CHANGED either
+    CHECK(backend.feed_status(seen).empty());
+}
+
+TEST_CASE("NM backend: Kiln: is_secrets_required_error", "[network][nm][auth]") {
+    CHECK(TestableNMBackend::is_secrets_required_error(
+        "Error: Connection activation failed: Secrets were required, but not provided."));
+    CHECK_FALSE(TestableNMBackend::is_secrets_required_error(""));
+    CHECK_FALSE(TestableNMBackend::is_secrets_required_error(
+        "Error: Connection activation failed: The base network connection was interrupted."));
+}
