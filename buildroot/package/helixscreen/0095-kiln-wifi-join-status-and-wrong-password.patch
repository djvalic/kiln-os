 namespace helix {
+/**
+ * Kiln: the AUTH_FAILED reason a backend gives when the network refused the
+ * password itself (NetworkManager: no secrets after the handshake timed out).
+ * connect_failure_message() turns it into the translated "Wrong password?"
+ * text; anything shown raw still reads as English words.
+ */
+inline constexpr const char kWifiWrongPasswordReason[] = "Wrong password";
+
 /**
  * Platform-provided backend factory for embedded targets. NOT defined in
  * the desktop build — the ESP32 firmware tree implements it against
