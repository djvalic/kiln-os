+
+TEST_CASE_METHOD(LVGLTestFixture,
+                 "Kiln recovery: Return to Flashforge firmware's answer reaches the caller",
+                 "[kiln][kiln_recovery]") {
+    SECTION("rebooting, as Kiln OS answers") {
+        const Answer a = ask_return_stock([](const FakeMoonrakerClient::RpcCall& call) {
+            REQUIRE(call.success_cb);
+            call.success_cb(json{{"jsonrpc", "2.0"},
+                                 {"result", {{"state", "rebooting"}, {"result", "rebooting"}}}});
+        });
+        CHECK(a.rebooting);
+    }
+    SECTION("rebooting in state alone") {
+        const Answer a = ask_return_stock([](const FakeMoonrakerClient::RpcCall& call) {
+            call.success_cb(json{{"jsonrpc", "2.0"}, {"result", {{"state", "rebooting"}}}});
+        });
+        CHECK(a.rebooting);
+    }
+    SECTION("rebooting in result alone") {
+        const Answer a = ask_return_stock([](const FakeMoonrakerClient::RpcCall& call) {
+            call.success_cb(json{{"jsonrpc", "2.0"}, {"result", {{"result", "rebooting"}}}});
+        });
+        CHECK(a.rebooting);
+    }
+    SECTION("refused while printing") {
+        const Answer a = ask_return_stock([](const FakeMoonrakerClient::RpcCall& call) {
+            REQUIRE(call.error_cb);
+            call.error_cb(
+                kiln_error(409, "printing", "A print is running", "machine.kiln_os.return_stock"));
+        });
+        CHECK_FALSE(a.rebooting);
+        CHECK(a.text == "A print is running");
+    }
+    SECTION("refused, the reason left in the message") {
+        const Answer a = ask_return_stock([](const FakeMoonrakerClient::RpcCall& call) {
+            call.error_cb(MoonrakerError::from_json_rpc(
+                {{"code", 409}, {"message", "[printing] A print is running"}},
+                "machine.kiln_os.return_stock"));
+        });
+        CHECK_FALSE(a.rebooting);
+        CHECK(a.text == "A print is running");
+    }
+    SECTION("an answer that is not rebooting is not taken for one") {
+        const Answer a = ask_return_stock([](const FakeMoonrakerClient::RpcCall& call) {
+            call.success_cb(json{{"jsonrpc", "2.0"}, {"result", {{"state", "queued"}}}});
+        });
+        CHECK_FALSE(a.rebooting);
+        CHECK(a.text == "queued");
+    }
+    SECTION("no answer at all is not taken for rebooting") {
+        const Answer a = ask_return_stock([](const FakeMoonrakerClient::RpcCall& call) {
+            call.success_cb(json{{"jsonrpc", "2.0"}, {"result", json::object()}});
+        });
+        CHECK_FALSE(a.rebooting);
+        CHECK_FALSE(a.text.empty());
+    }
+}
