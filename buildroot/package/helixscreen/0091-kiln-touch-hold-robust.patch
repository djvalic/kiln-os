+/// @p ms rounded up to whole readings of @p poll
+uint32_t readings(uint32_t ms, uint32_t poll) {
+    return (ms + poll - 1) / poll * poll;
+}
+
+/// A press with @p lifts lifts of @p lift_ms released readings, one after each
+/// second pressed, then pressed on until @p total_ms after the first pressed
+/// reading. Returns the time of that reading.
+uint32_t hold_with_lifts(Panel& p, int lifts, uint32_t lift_ms, uint32_t total_ms) {
+    const uint32_t t0 = p.now + p.poll;
+    p.press(1000);
+    for (int i = 0; i < lifts; ++i) {
+        p.release(lift_ms);
+        p.press(1000);
+    }
+    while (p.now - t0 < total_ms) {
+        p.press(p.poll);
+    }
+    return t0;
+}
+
