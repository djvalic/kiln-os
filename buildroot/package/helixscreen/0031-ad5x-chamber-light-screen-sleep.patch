diff --git a/src/led/led_screen_light.cpp b/src/led/led_screen_light.cpp
new file mode 100644
index 0000000..8837118
--- /dev/null
+++ b/src/led/led_screen_light.cpp
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "led/led_screen_light.h"
+
+#include "display_settings_manager.h"
+#include "led/led_auto_state.h"
+#include "led/led_controller.h"
+#include "observer_factory.h"
+#include "printer_state.h"
+
+#include <spdlog/spdlog.h>
+
+namespace helix::led {
+
+ScreenSleepLight& ScreenSleepLight::instance() {
+    static ScreenSleepLight s_instance;
+    return s_instance;
+}
+
+void ScreenSleepLight::init(PrinterState& printer_state) {
+    using helix::ui::observe_print_lifecycle;
+    print_state_observer_.reset();
+    printer_state_ = &printer_state;
+    // The lifecycle subject, not the raw job-state int: the two enums do not share
+    // numbering (printer_print_state.h). Preparing is part of the lifecycle.
+    if (auto* subj = printer_state.print_state().get_print_lifecycle_subject()) {
+        print_state_observer_ = observe_print_lifecycle(
+            subj, this,
+            [](ScreenSleepLight* self, PrintState state) {
+                self->on_print_lifecycle_changed(state);
+            },
+            printer_state.get_subjects_lifetime());
+    }
+}
+
+void ScreenSleepLight::deinit() {
+    // light_id_ stays: a wake after a printer switch still turns the light back on.
+    print_state_observer_.reset();
+    printer_state_ = nullptr;
+}
+
+void ScreenSleepLight::on_screen_sleep_changed(bool sleeping) {
+    if (!sleeping) {
+        restore_light();
+        return;
+    }
+    if (!DisplaySettingsManager::instance().get_chamber_light_off_on_sleep()) {
+        return;
+    }
+    if (print_holds_machine()) {
+        return; // a print is preparing, printing or paused: the light stays on
+    }
+    // Also with LedAutoState enabled: auto-state's idle action does not keep the light on.
+    // It only acts on a state change, so nothing re-lights the light while the screen
+    // sleeps and the state stays idle; wake re-applies its colour (restore_light).
+    auto& ctrl = LedController::instance();
+    if (!ctrl.is_initialized()) {
+        return;
+    }
+    const std::string light = ctrl.chamber_light();
+    if (light.empty() || ctrl.device_state(light).power != PowerState::On) {
+        return; // no chamber light, or it is already off: nothing to undo later
+    }
+    spdlog::info("[ScreenSleepLight] Screen asleep, turning off {}", light);
+    ctrl.set_power({light}, false, /*silent=*/true);
+    light_id_ = light;
+}
+
+void ScreenSleepLight::on_print_lifecycle_changed(PrintState state) {
+    if (::job_holds_machine(state)) {
+        restore_light();
+    }
+}
+
+bool ScreenSleepLight::print_holds_machine() const {
+    if (printer_state_ == nullptr || !printer_state_->are_subjects_initialized()) {
+        return true;
+    }
+    return ::job_holds_machine(printer_state_->print_state().get_print_lifecycle());
+}
+
+void ScreenSleepLight::restore_light() {
+    if (light_id_.empty()) {
+        return;
+    }
+    auto& ctrl = LedController::instance();
+    if (!ctrl.is_initialized()) {
+        return; // keep light_id_: a later wake or print start retries
+    }
+    const std::string light = light_id_;
+    spdlog::info("[ScreenSleepLight] Turning on {} (screen awake or print started)", light);
+    ctrl.set_power({light}, true, /*silent=*/true);
+    light_id_.clear();
+    // set_power(on) sends the controller's last colour, which may not be auto-state's
+    // colour any more. With auto-state on, re-apply its action for the current state
+    // (evaluate() clears its dedup), so the light gets auto-state's own colour back.
+    if (LedAutoState::instance().is_enabled()) {
+        LedAutoState::instance().evaluate();
+    }
+}
+
+} // namespace helix::led
