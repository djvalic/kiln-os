diff --git a/include/led/led_screen_light.h b/include/led/led_screen_light.h
new file mode 100644
index 0000000..0f5b1d6
--- /dev/null
+++ b/include/led/led_screen_light.h
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include "ui_observer_guard.h"
+
+#include "print_lifecycle_state.h"
+
+#include <string>
+
+namespace helix {
+class PrinterState;
+}
+
+namespace helix::led {
+
+/// Turns the chamber light off while the screen sleeps and back on at wake or when a
+/// print starts. Opt-in (Display settings, default off). The light is only turned off
+/// when no print is preparing, printing or paused, so it stays on during a print. It
+/// only turns back on a light it turned off. With LedAutoState enabled the light still
+/// goes off at idle; on wake LedAutoState re-applies its own colour. Plain on and off:
+/// no brightness or dimming.
+class ScreenSleepLight {
+  public:
+    static ScreenSleepLight& instance();
+
+    /// Subscribes to the current printer's print lifecycle. Called per printer, like
+    /// LedAutoState::init().
+    void init(PrinterState& printer_state);
+    void deinit();
+
+    /// Display sleep transition: true when the screen sleeps, false on wake. Registered
+    /// once with DisplayManager::register_sleep_callback().
+    void on_screen_sleep_changed(bool sleeping);
+
+  private:
+    ScreenSleepLight() = default;
+    ~ScreenSleepLight() {
+        // As LedAutoState: no LVGL calls during static destruction.
+        print_state_observer_.release();
+    }
+    ScreenSleepLight(const ScreenSleepLight&) = delete;
+    ScreenSleepLight& operator=(const ScreenSleepLight&) = delete;
+
+    /// A job now holds the machine (preparing, printing or paused): light back on.
+    void on_print_lifecycle_changed(PrintState state);
+    /// True while a job holds the machine. Unknown printer state counts as true, so
+    /// the light stays on when the answer is not known.
+    [[nodiscard]] bool print_holds_machine() const;
+    /// Turns back on the light this turned off, if any, then re-applies LedAutoState's
+    /// action when auto-state is enabled. Keeps the record when the LED controller
+    /// cannot send yet, so a later wake or print start retries.
+    void restore_light();
+
+    PrinterState* printer_state_ = nullptr;
+    std::string light_id_; // the light turned off by a sleep; empty when none
+    ObserverGuard print_state_observer_;
+};
+
+} // namespace helix::led
