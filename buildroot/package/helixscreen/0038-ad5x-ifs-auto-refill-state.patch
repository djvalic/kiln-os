+helix::printer::EndlessSpoolConfig AmsBackendAd5xIfs::get_endless_spool_config() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!kiln_refill_live_locked() || !*kiln_refill_.enabled) {
+        return {};
+    }
+    // The backup the driver would take first, per slot.
+    std::vector<int> edges(static_cast<size_t>(kNumPorts), -1);
+    for (int i = 0; i < kNumPorts; ++i) {
+        edges[static_cast<size_t>(i)] = kiln_refill_backup_locked(i, /*remembered=*/false);
+    }
+    return helix::printer::endless_spool_config_from_edges(edges);
