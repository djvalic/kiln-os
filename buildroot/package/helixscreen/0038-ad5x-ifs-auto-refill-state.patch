@@ -7192,12 +7258,73 @@ std::chrono::seconds AmsBackendAd5xIfs::runout_confirm_delay_locked() const {
     // talking over the recovery the printer is already performing. Stock zMod
     // is always-on (no toggle), so the !has_ifs_vars_ path always qualifies;
     // plugins qualify only when variable_backup reads true.
+    //
+    // Kiln OS's auto-refill has a switch and names its backups, so it
+    // qualifies only when it is on, the lane that ran out has a backup and no
+    // refill has run for this runout yet (one that did and left the head empty
+    // has given up).
+    if (kiln_refill_live_locked()) {
+        if (!kiln_refill_.enabled.value_or(false) || kiln_refill_.ran) {
+            return kRunoutConfirmDelay;
+        }
+        const int lane = runout_lane_locked();
+        bool backup = false;
+        for (int i = 0; i < kNumPorts && !backup; ++i) {
+            if (lane < 0 || lane == i) {
+                backup = kiln_refill_backup_locked(i, /*remembered=*/true) >= 0;
+            }
+        }
+        return backup ? kRunoutConfirmDelayWithBackup : kRunoutConfirmDelay;
+    }
     if (!has_ifs_vars_ || ifs_backup_variable_.value_or(false)) {
         return kRunoutConfirmDelayWithBackup;
     }
     return kRunoutConfirmDelay;
 }
 
+int AmsBackendAd5xIfs::runout_lane_locked() const {
+    if (system_info_.current_slot >= 0) {
+        return system_info_.current_slot;
+    }
+    if (seated_chan_ > 0) {
+        return seated_chan_ - 1;
+    }
+    if (ffm_channel_ > 0) {
+        return ffm_channel_ - 1;
+    }
+    if (persisted_seated_slot_.has_value()) {
+        return *persisted_seated_slot_;
+    }
+    return -1;
+}
+
+bool AmsBackendAd5xIfs::kiln_refill_live_locked() const {
+    return ifs_module_live_.load() && !has_ifs_vars_ && kiln_refill_.enabled.has_value();
+}
+
+int AmsBackendAd5xIfs::kiln_refill_backup_locked(int slot, bool remembered) const {
+    if (slot < 0 || slot >= kNumPorts) {
+        return -1;
+    }
+    const auto idx = static_cast<size_t>(slot);
+    const std::vector<int>* list = nullptr;
+    if (remembered) {
+        list = &kiln_refill_.remembered[idx];
+    } else if (kiln_refill_.backups.has_value()) {
+        list = &(*kiln_refill_.backups)[idx];
+    }
+    if (list == nullptr) {
+        return -1;
+    }
+    for (int backup : *list) {
+        if (backup >= 0 && backup < kNumPorts && backup != slot &&
+            port_presence_[static_cast<size_t>(backup)]) {
+            return backup;
+        }
+    }
+    return -1;
+}
