     bool kiln_owns_action_ = false;
+    /// Kiln OS's auto-refill (`ifs.auto_refill`, `refill_match`,
+    /// `refill_backups`), merged across diff frames; `enabled` stays unset on
+    /// a driver without it. Backups are 0-based slots per 0-based slot,
+    /// nearest colour first. Guarded by mutex_.
+    struct KilnRefill {
+        std::optional<bool> enabled;
+        std::string match;
+        std::optional<std::array<std::vector<int>, kNumPorts>> backups;
+        /// Each slot's last non-empty list, kept after the slot ran empty.
+        std::array<std::vector<int>, kNumPorts> remembered{};
+        /// A refill ran since the toolhead last read filament: a runout after
+        /// it is not one the driver is still about to handle.
+        bool ran = false;
