+// --- Auto-refill as endless spool ---
+
+namespace {
+
+/// Captures the G-code the backend sends.
+class KilnCaptureBackend : public AmsBackendAd5xIfs {
+  public:
+    KilnCaptureBackend() : AmsBackendAd5xIfs(nullptr, nullptr) {}
+
+    std::vector<std::string> sent;
+
+    helix::AmsError execute_gcode(const std::string& gcode) override {
+        sent.push_back(gcode);
+        return helix::AmsErrorHelper::success();
+    }
+    helix::AmsError execute_gcode(const std::string& gcode,
+                                  helix::SharedCallback<void()>) override {
+        sent.push_back(gcode);
+        return helix::AmsErrorHelper::success();
+    }
+    helix::AmsError execute_gcode(const std::string& gcode, helix::SharedCallback<void()>,
+                                  helix::SharedCallback<void(const MoonrakerError&)>,
+                                  bool) override {
+        sent.push_back(gcode);
+        return helix::AmsErrorHelper::success();
+    }
+};
+
+/// Auto-refill state: slots 1 and 3 hold filament and back each other up.
+json kiln_refill_frame(bool on, json backups = json{{"1", {3}}, {"2", json::array()},
+                                                    {"3", {1}}, {"4", json::array()}}) {
+    return json{{"ifs",
+                 {{"auto_refill", on},
+                  {"refill_match", "similar"},
+                  {"refill_backups", std::move(backups)},
+                  {"loaded_channels", {1, 3}},
+                  {"active_channel", 1}}}};
+}
+
+} // namespace
+
+TEST_CASE("AD5X IFS reports Kiln's auto-refill as endless spool", "[ams][ad5x_ifs][kiln_ifs]") {
+    using namespace helix::printer;
+    KilnCaptureBackend backend;
+    Ad5xIfsTestAccess::handle_status(backend, kiln_idle_frame());
+
+    SECTION("on, with backups") {
+        Ad5xIfsTestAccess::handle_status(backend, kiln_refill_frame(true));
+        const auto caps = backend.get_endless_spool_capabilities();
+        CHECK(caps.available());
+        CHECK(caps.enabled == EndlessSpoolEnabled::On);
+        CHECK(caps.switchable);
+        CHECK(caps.restriction == EndlessSpoolRestriction::FirmwareManaged);
+        CHECK(caps.provider.empty());
+        // The driver's own list is the rule.
+        CHECK(endless_spool_backup_for(backend.get_endless_spool_config(), 0) == 2);
+        CHECK(endless_spool_backup_for(backend.get_endless_spool_config(), 2) == 0);
+        CHECK(backend.endless_spool_backup_eligibility(0, 2) == BackupEligibility::Eligible);
+        CHECK(backend.endless_spool_backup_eligibility(0, 1) == BackupEligibility::Incompatible);
+    }
+    SECTION("on, nothing backed up") {
+        Ad5xIfsTestAccess::handle_status(
+            backend, kiln_refill_frame(true, json{{"1", json::array()}, {"3", json::array()}}));
+        CHECK(backend.get_endless_spool_capabilities().enabled ==
+              EndlessSpoolEnabled::OnWithoutBackup);
+        CHECK(backend.get_endless_spool_config().empty());
+    }
+    SECTION("off") {
+        Ad5xIfsTestAccess::handle_status(backend, kiln_refill_frame(false));
+        CHECK(backend.get_endless_spool_capabilities().enabled == EndlessSpoolEnabled::Off);
+        CHECK(backend.get_endless_spool_config().empty());
+    }
+    SECTION("the switch sends IFS_AUTO_REFILL") {
+        Ad5xIfsTestAccess::handle_status(backend, kiln_refill_frame(true));
+        REQUIRE(backend.set_endless_spool_enabled(false).success());
+        CHECK(backend.sent == std::vector<std::string>{"IFS_AUTO_REFILL ENABLE=0"});
+    }
+    SECTION("a diff frame keeps the switch") {
+        Ad5xIfsTestAccess::handle_status(backend, kiln_refill_frame(true));
+        Ad5xIfsTestAccess::handle_status(backend, json{{"ifs", {{"refill_match", "exact"}}}});
+        CHECK(backend.get_endless_spool_capabilities().enabled == EndlessSpoolEnabled::On);
+    }
+}
+
+TEST_CASE("AD5X IFS without Kiln's auto_refill keeps the firmware answer",
+          "[ams][ad5x_ifs][kiln_ifs]") {
+    using namespace helix::printer;
+    KilnCaptureBackend backend;
+    Ad5xIfsTestAccess::handle_status(backend, kiln_idle_frame());
+    const auto caps = backend.get_endless_spool_capabilities();
+    CHECK(caps.enabled == EndlessSpoolEnabled::On);
+    CHECK_FALSE(caps.switchable);
+    CHECK_FALSE(backend.set_endless_spool_enabled(false).success());
+    CHECK(backend.sent.empty());
+}
+
+TEST_CASE("AD5X IFS waits for Kiln's auto-refill only when it can refill",
+          "[ams][ad5x_ifs][kiln_ifs][runout]") {
+    AmsBackendAd5xIfs backend(nullptr, nullptr);
+    Ad5xIfsTestAccess::handle_status(backend, kiln_idle_frame());
+    Ad5xIfsTestAccess::handle_status(backend, kiln_refill_frame(true));
+    REQUIRE(backend.get_current_slot() == 0);
+
+    // Slot 1 runs out: the driver lists no backups for an empty slot, but the
+    // list it had still says slot 3 takes over.
+    Ad5xIfsTestAccess::handle_status(
+        backend, json{{"ifs",
+                       {{"loaded_channels", {3}},
+                        {"refill_backups", {{"1", json::array()}, {"3", json::array()}}}}}});
+    CHECK(Ad5xIfsTestAccess::runout_confirm_delay(backend) == std::chrono::seconds(180));
+    CHECK(Ad5xIfsTestAccess::find_backup_slot(backend, 0) == 2);
+
+    SECTION("after a refill ran") {
+        Ad5xIfsTestAccess::handle_status(backend, kiln_step("refill", "feeding", 3, 3));
+        Ad5xIfsTestAccess::handle_status(backend, kiln_idle_frame());
+        CHECK(Ad5xIfsTestAccess::runout_confirm_delay(backend) == std::chrono::seconds(30));
+    }
+    SECTION("auto-refill off") {
+        Ad5xIfsTestAccess::handle_status(backend, json{{"ifs", {{"auto_refill", false}}}});
+        CHECK(Ad5xIfsTestAccess::runout_confirm_delay(backend) == std::chrono::seconds(30));
+        Ad5xIfsTestAccess::set_runout_state(backend, 0, false, std::nullopt);
+        CHECK(Ad5xIfsTestAccess::runout_detail(backend).find("Auto-refill is off") !=
+              std::string::npos);
+    }
+    SECTION("the backup slot is empty too") {
+        Ad5xIfsTestAccess::handle_status(
+            backend, json{{"ifs", {{"loaded_channels", json::array()}}}});
+        CHECK(Ad5xIfsTestAccess::runout_confirm_delay(backend) == std::chrono::seconds(30));
+    }
+    SECTION("the runout text names the backup") {
+        Ad5xIfsTestAccess::set_runout_state(backend, 0, false, std::nullopt);
+        CHECK(Ad5xIfsTestAccess::runout_detail(backend).find("is a backup") != std::string::npos);
+    }
+}
