+    CHECK_THAT(text, !ContainsSubstring("Boot into recovery"));
+    CHECK_THAT(text, !ContainsSubstring("is ready"));
+    CHECK_THAT(text, !ContainsSubstring("To install it"));
+    test::answer_top_modal("btn_primary");
+    settle();
+
+    write_install();
+    check();
+    REQUIRE(dialog());
+    text = test::top_modal_text();
+    CHECK_THAT(text, ContainsSubstring("Einstellungen > System > Wiederherstellungssystem starten > "
+                                       "Reboot / Power > Install Kiln's boot loader"));
+    CHECK_THAT(text, !ContainsSubstring("Boot into recovery"));
+}
