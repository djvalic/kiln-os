+TEST_CASE("Kiln boot loader notice: Boot into recovery in every language, the notice with it",
+          "[kiln][kiln_bl_notice][i18n]") {
+    struct RestoreLanguage {
+        ~RestoreLanguage() {
+            lv_translation_set_language(helix::ui::kIdentityLocale);
+        }
+    } restore;
+    for (const char* lang : {"de", "es", "fr", "it", "ja", "ko", "pt", "ru", "tr", "zh"}) {
+        CAPTURE(lang);
+        helix::ui::ensure_translation_loaded(lang);
+        lv_translation_set_language(lang);
+        const std::string label = lv_tr("Boot into recovery");
+        CHECK(label != "Boot into recovery");
+        CHECK(std::string(lv_tr("Boot into recovery?")) != "Boot into recovery?");
+        CHECK(std::string(lv_tr("Restarting into the recovery OS...")) !=
+              "Restarting into the recovery OS...");
+        // Both notices go through the row's own name
+        for (bln::Kind kind : {bln::Kind::Update, bln::Kind::Install}) {
+            const std::string text = bln::text(kind);
+            CHECK_THAT(text, ContainsSubstring(" > " + label + " > "));
+            CHECK_THAT(text, !ContainsSubstring("Boot into recovery"));
+        }
+    }
+}
