diff --git a/src/ui/ui_kiln_bootloader_notice.cpp b/src/ui/ui_kiln_bootloader_notice.cpp
new file mode 100644
index 0000000..35f0ba0
--- /dev/null
+++ b/src/ui/ui_kiln_bootloader_notice.cpp
@@ -0,0 +1,234 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "ui_kiln_bootloader_notice.h"
+
+#include "ui_kiln_wizard_offer.h"
+#include "ui_modal.h"
+
+#include "app_globals.h"
+#include "config.h"
+#include "helix_fs.h"
+#include "lvgl/lvgl.h"
+#include "lvgl/src/others/translation/lv_translation.h"
+#include "printer_state.h"
+
+#include <spdlog/spdlog.h>
+
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+
+namespace helix::kiln_bl_notice {
+
+namespace {
+
+lv_obj_t* g_dialog = nullptr;
+lv_timer_t* g_timer = nullptr;
+
+/// The dialog is still on the screen (a fixture or a rebuild can delete it
+/// without telling us)
+bool dialog_up() {
+    if (g_dialog && !lv_obj_is_valid(g_dialog)) {
+        g_dialog = nullptr;
+    }
+    return g_dialog != nullptr;
+}
+
+std::string env(const char* name) {
+    const char* v = std::getenv(name);
+    return v ? v : "";
+}
+
+std::string state_file(const char* name) {
+    const std::string dir = env(kStateEnv);
+    return dir.empty() ? "" : dir + "/" + name;
+}
+
+std::string read_file(const std::string& path) {
+    std::ifstream f(path);
+    if (!f) {
+        return "";
+    }
+    std::ostringstream s;
+    s << f.rdbuf();
+    return s.str();
+}
+
+std::string trim(std::string s) {
+    while (!s.empty() && (s.back() == '\n' || s.back() == '\r' || s.back() == ' ')) {
+        s.pop_back();
+    }
+    return s;
+}
+
+bool motion_blocked() {
+    return lv_subject_get_int(
+               get_printer_state().print_state().get_machine_motion_blocked_subject()) != 0;
+}
+
+bool wizard_pending() {
+    if (kiln_wizard_offer::pending() || kiln_wizard_offer::asking()) {
+        return true;
+    }
+    const std::string flag = env("HELIX_WIZARD_FLAG_FILE");
+    return !flag.empty() && helix::fs::exists(flag);
+}
+
+void closed(const Notice& notice) {
+    g_dialog = nullptr;
+    if (mark_shown(notice)) {
+        spdlog::info("[Kiln boot loader notice] {} shown, not again", notice.key);
+    }
+}
+
+void timer_cb(lv_timer_t*) {
+    check_now();
+}
+
+} // namespace
+
+Notice parse(const std::string& text) {
+    Notice n;
+    std::string kind;
+    std::istringstream in(text);
+    std::string line;
+    while (std::getline(in, line)) {
+        line = trim(line);
+        if (line.rfind("kind=", 0) == 0) {
+            kind = line.substr(5);
+        } else if (line.rfind("key=", 0) == 0) {
+            n.key = line.substr(4);
+        }
+    }
+    if (kind == "update" && !n.key.empty()) {
+        n.kind = Kind::Update;
+    } else if (kind == "install") {
+        n.kind = Kind::Install;
+        if (n.key.empty()) {
+            n.key = "install";
+        }
+    } else {
+        n.key.clear();
+    }
+    return n;
+}
+
+Notice read_notice() {
+    const std::string path = env(kNoticeEnv);
+    if (path.empty() || !helix::fs::exists(path)) {
+        return {};
+    }
+    return parse(read_file(path));
+}
+
+bool shown_already(const Notice& notice) {
+    switch (notice.kind) {
+    case Kind::Update: {
+        const std::string f = state_file("update-seen");
+        return !f.empty() && trim(read_file(f)) == notice.key;
+    }
+    case Kind::Install: {
+        const std::string f = state_file("install-dismissed");
+        return !f.empty() && helix::fs::exists(f);
+    }
+    case Kind::None:
+        break;
+    }
+    return true;
+}
+
+bool mark_shown(const Notice& notice) {
+    const std::string dir = env(kStateEnv);
+    if (dir.empty() || notice.kind == Kind::None) {
+        return false;
+    }
+    helix::fs::create_directories(dir);
+    const std::string f =
+        state_file(notice.kind == Kind::Update ? "update-seen" : "install-dismissed");
+    std::ofstream out(f, std::ios::trunc);
+    out << notice.key << "\n";
+    out.close();
+    if (!out) {
+        spdlog::warn("[Kiln boot loader notice] Could not write {}", f);
+        return false;
+    }
+    return true;
+}
+
+bool should_show(const Notice& notice, bool shown, const Gates& gates) {
+    if (notice.kind == Kind::None || shown) {
+        return false;
+    }
+    return !gates.wizard_active && !gates.wizard_pending && !gates.printing && !gates.dialog_up;
+}
+
+std::string title(Kind kind) {
+    return kind == Kind::Update ? lv_tr("Boot loader update ready") : lv_tr("Kiln's own boot loader");
+}
+
+std::string text(Kind kind) {
+    if (kind == Kind::Update) {
+        return lv_tr("A boot loader update is ready. To install it: Settings > System > Boot into "
+                     "recovery > Reboot / Power > Update Kiln's boot loader. Nothing is written "
+                     "until you start it there.");
+    }
+    return lv_tr("Kiln OS has its own boot loader for this printer. To install it: Settings > "
+                 "System > Boot into recovery > Reboot / Power > Install Kiln's boot loader. "
+                 "Read the boot loader guide first; it explains the risk and the "
+                 "rescue stick: github.com/djvalic/kiln-os/blob/main/docs/own-boot-loader.md");
+}
+
+void start() {
+    if (env(kNoticeEnv).empty() || g_timer) {
+        return;
+    }
+    g_timer = lv_timer_create(timer_cb, kPollMs, nullptr);
+    check_now();
+}
+
+void check_now() {
+    if (dialog_up()) {
+        return;
+    }
+    const Notice notice = read_notice();
+    if (notice.kind == Kind::None) {
+        return;
+    }
+    const bool shown = shown_already(notice);
+    Gates gates;
+    gates.wizard_active = Config::get_instance()->is_wizard_required() || is_wizard_active();
+    gates.wizard_pending = wizard_pending();
+    gates.printing = motion_blocked();
+    gates.dialog_up = Modal::any_visible();
+    if (!should_show(notice, shown, gates)) {
+        if (!shown) {
+            spdlog::debug("[Kiln boot loader notice] {} waits (wizard {}{}, printing {}, dialog {})",
+                          notice.key, gates.wizard_active ? "running" : "-",
+                          gates.wizard_pending ? ", pending" : "", gates.printing,
+                          gates.dialog_up);
+        }
+        return;
+    }
+    spdlog::info("[Kiln boot loader notice] Showing the {} notice ({})",
+                 notice.kind == Kind::Update ? "update" : "install", notice.key);
+    const std::string t = title(notice.kind);
+    const std::string m = text(notice.kind);
+    helix::ui::AlertOptions opts;
+    opts.on_dismiss = [notice]() { closed(notice); };
+    g_dialog = helix::ui::modal_alert(t.c_str(), m.c_str(), ModalSeverity::Info, lv_tr("OK"),
+                                      [notice]() { closed(notice); }, opts);
+}
+
+bool showing() {
+    return dialog_up();
+}
+
+void reset_for_test() {
+    if (g_timer) {
+        lv_timer_delete(g_timer);
+        g_timer = nullptr;
+    }
+    g_dialog = nullptr;
+}
+
+} // namespace helix::kiln_bl_notice
diff --git a/tests/unit/test_kiln_bootloader_notice.cpp b/tests/unit/test_kiln_bootloader_notice.cpp
new file mode 100644
index 0000000..7468a97
--- /dev/null
+++ b/tests/unit/test_kiln_bootloader_notice.cpp
@@ -0,0 +1,415 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * Kiln OS: the one-off notice about Kiln's own boot loader. The root script
+ * ad5x-bootloader-notice writes the notice file (HELIX_KILN_BL_NOTICE_FILE):
+ * kind=update (the recovery OS carries a newer build) or kind=install
+ * (Flashforge's boot loader on a supported board), with a key. The screen
+ * shows it at idle only: not while the setup wizard runs or is pending, not
+ * while a print holds the printer, not over another dialog. Closing it in
+ * any way counts as shown (HELIX_KILN_BL_STATE_DIR): an update comes back
+ * only for a new key, the install notice never. In Russian the notice is
+ * Russian only; in German its sentences are German (the menu names of the
+ * screens that show English there stay as those screens show them).
+ */
+
+#include "ui_kiln_bootloader_notice.h"
+#include "ui_kiln_wizard_offer.h"
+#include "ui_modal.h"
+#include "ui_update_queue.h"
+
+#include "../lvgl_ui_test_fixture.h"
+#include "../test_helpers/modal_answer.h"
+#include "../ui_test_utils.h"
+#include "app_globals.h"
+#include "config.h"
+#include "lvgl/src/others/translation/lv_translation.h"
+#include "printer_state.h"
+#include "translation_loader.h"
+
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <string>
+
+#include "../catch_amalgamated.hpp"
+
+using namespace helix;
+using Catch::Matchers::ContainsSubstring;
+namespace bln = helix::kiln_bl_notice;
+namespace fs = std::filesystem;
+
+TEST_CASE("Kiln boot loader notice: the file's lines", "[kiln][kiln_bl_notice]") {
+    using K = bln::Kind;
+    auto n = bln::parse("kind=update\nkey=update 1794903199\ninstalled=Nov 15 2026 - 19:48:50 "
+                        "+0000\ncarries=Nov 17 2026 - 08:13:19 +0000\n");
+    CHECK(n.kind == K::Update);
+    CHECK(n.key == "update 1794903199");
+    n = bln::parse("kind=install\nkey=install\ncarries=Nov 17 2026 - 08:13:19 +0000\n");
+    CHECK(n.kind == K::Install);
+    CHECK(n.key == "install");
+    // An install without a key still has one; CRLF and blanks are fine
+    n = bln::parse("\r\nkind=install\r\n");
+    CHECK(n.kind == K::Install);
+    CHECK(n.key == "install");
+    // An update without a key, an unknown kind, nothing: no notice
+    CHECK(bln::parse("kind=update\n").kind == K::None);
+    CHECK(bln::parse("kind=downgrade\nkey=x\n").kind == K::None);
+    CHECK(bln::parse("").kind == K::None);
+    CHECK(bln::parse("garbage").kind == K::None);
+}
+
+TEST_CASE("Kiln boot loader notice: when it may show", "[kiln][kiln_bl_notice]") {
+    bln::Notice update{bln::Kind::Update, "update 1"};
+    bln::Notice install{bln::Kind::Install, "install"};
+    bln::Gates idle;
+    CHECK(bln::should_show(update, false, idle));
+    CHECK(bln::should_show(install, false, idle));
+    // Shown already, or no notice: never
+    CHECK_FALSE(bln::should_show(update, true, idle));
+    CHECK_FALSE(bln::should_show(install, true, idle));
+    CHECK_FALSE(bln::should_show(bln::Notice{}, false, idle));
+    // Each gate holds it back
+    for (int g = 0; g < 4; ++g) {
+        bln::Gates gates;
+        gates.wizard_active = g == 0;
+        gates.wizard_pending = g == 1;
+        gates.printing = g == 2;
+        gates.dialog_up = g == 3;
+        CAPTURE(g);
+        CHECK_FALSE(bln::should_show(update, false, gates));
+        CHECK_FALSE(bln::should_show(install, false, gates));
+    }
+}
+
+namespace {
+
+struct NoticeFixture : LVGLUITestFixture {
+    fs::path dir;
+    fs::path notice;
+    fs::path seen_dir;
+    fs::path offer;
+    bool had_required = false;
+
+    NoticeFixture() {
+        helix::ui::modal_init_subjects();
+        dir = fs::temp_directory_path() /
+              ("kiln-bl-notice-" + std::to_string(reinterpret_cast<uintptr_t>(this)));
+        fs::create_directories(dir);
+        notice = dir / "ad5x-bootloader-notice";
+        seen_dir = dir / "bootloader-notice";
+        offer = dir / "offer-setup-wizard";
+        setenv(bln::kNoticeEnv, notice.c_str(), 1);
+        setenv(bln::kStateEnv, seen_dir.c_str(), 1);
+        setenv(helix::kiln_wizard_offer::kEnv, offer.c_str(), 1);
+        Config* cfg = Config::get_instance();
+        REQUIRE(cfg != nullptr);
+        had_required = cfg->is_wizard_required();
+        set_wizard_completed(true);
+        set_wizard_active(false);
+        state().update_from_status({{"print_stats", {{"state", "standby"}}}});
+        settle();
+    }
+
+    ~NoticeFixture() override {
+        while (ModalStack::instance().top_dialog() != nullptr) {
+            Modal::hide(ModalStack::instance().top_dialog());
+            process_lvgl(5);
+        }
+        settle();
+        bln::reset_for_test();
+        set_wizard_active(false);
+        if (had_required) {
+            set_wizard_completed(false);
+        }
+        unsetenv(bln::kNoticeEnv);
+        unsetenv(bln::kStateEnv);
+        unsetenv(helix::kiln_wizard_offer::kEnv);
+        std::error_code ec;
+        fs::remove_all(dir, ec);
+    }
+
+    void settle() {
+        helix::ui::UpdateQueue::instance().drain();
+        process_lvgl(10);
+    }
+
+    /// wizard_completed where is_wizard_required() reads it: the printer's
+    /// entry when there is an active printer, the root key otherwise
+    static void set_wizard_completed(bool done) {
+        Config* cfg = Config::get_instance();
+        cfg->set<bool>(cfg->df() + "wizard_completed", done);
+        cfg->set<bool>("/wizard_completed", done);
+    }
+
+    void write_notice(const std::string& text) {
+        std::ofstream(notice) << text;
+        REQUIRE(fs::exists(notice));
+    }
+
+    void write_update(const std::string& key = "update 1794903199") {
+        write_notice("kind=update\nkey=" + key +
+                     "\ninstalled=Nov 15 2026 - 19:48:50 +0000\ncarries=Nov 17 2026 - 08:13:19 "
+                     "+0000\n");
+    }
+
+    void write_install() {
+        write_notice("kind=install\nkey=install\ncarries=Nov 17 2026 - 08:13:19 +0000\n");
+    }
+
+    std::string read(const fs::path& p) {
+        std::ifstream f(p);
+        std::stringstream s;
+        s << f.rdbuf();
+        return s.str();
+    }
+
+    bool dialog() {
