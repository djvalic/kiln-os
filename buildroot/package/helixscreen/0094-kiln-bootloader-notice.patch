--- /dev/null
+++ b/include/ui_kiln_bootloader_notice.h
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * @file ui_kiln_bootloader_notice.h
+ * @brief Kiln OS: a one-off notice about Kiln's own boot loader
+ *
+ * Kiln's own boot loader (SPL and U-Boot in the eMMC's first MiB) is only
+ * ever installed or updated by hand, on the recovery screen's Reboot / Power
+ * page. Most people rarely start the recovery OS, so the main OS tells them
+ * when there is something to do there. The root script ad5x-bootloader-notice
+ * (Kiln OS, run at each complete start) compares the boot loader on the disk
+ * with the build the recovery OS in slot A carries and writes the notice file
+ * (HELIX_KILN_BL_NOTICE_FILE, set by S70helixscreen:
+ * /run/ad5x-bootloader-notice), key=value lines:
+ *
+ *   kind=update    Kiln's boot loader is installed and the recovery OS
+ *                  carries a newer build: "A boot loader update is ready"
+ *   kind=install   Flashforge's boot loader on a board Kiln's boot loader
+ *                  supports, after a few complete starts: "Kiln OS has its
+ *                  own boot loader for this printer"
+ *   key=...        what "shown" refers to (the carried build for an update)
+ *
+ * The screen shows it once, at idle: not while the setup wizard runs or is
+ * pending (the first-run wizard, a requested re-run, the "Run the setup
+ * wizard?" offer of patch 0088), not while a print holds the printer, and not
+ * over another dialog; it looks again every few seconds, since the script
+ * writes the file after the screen has started. Closing it in any way (OK, a
+ * backdrop tap) counts as shown, in HELIX_KILN_BL_STATE_DIR
+ * (/data/ad5x/bootloader-notice): update-seen holds the key, so an update
+ * notice comes back only for a newer carried build; install-dismissed ends the
+ * install notice for good. Without the environment variables (other builds)
+ * nothing happens. Nothing here writes the boot loader.
+ *
+ * @threading Main thread only
+ */
+
+#pragma once
+
+#include <string>
+
+namespace helix::kiln_bl_notice {
+
+/// The environment variable naming the notice file
+inline constexpr const char* kNoticeEnv = "HELIX_KILN_BL_NOTICE_FILE";
+/// The environment variable naming the folder of what was shown
+inline constexpr const char* kStateEnv = "HELIX_KILN_BL_STATE_DIR";
+/// How often the screen looks for the notice (ms)
+inline constexpr unsigned kPollMs = 10000;
+
+enum class Kind {
+    None,    ///< no notice (no file, or nothing this screen knows)
+    Update,  ///< a newer build of Kiln's boot loader is ready
+    Install, ///< Kiln's boot loader can be installed on this printer
+};
+
+struct Notice {
+    Kind kind = Kind::None;
+    std::string key; ///< what "shown" refers to
+};
+
+/// The notice file's text, parsed (pure). An unknown kind, or an update
+/// without a key, is no notice.
+Notice parse(const std::string& text);
+
+/// The notice file (HELIX_KILN_BL_NOTICE_FILE), read now; Kind::None without it
+Notice read_notice();
+
+/// Shown already (update-seen holds its key; install-dismissed exists)
+bool shown_already(const Notice& notice);
+
+/// Record it as shown; true when written
+bool mark_shown(const Notice& notice);
+
+/// What keeps a notice from showing right now
+struct Gates {
+    bool wizard_active = false;  ///< the setup wizard runs (or is required)
+    bool wizard_pending = false; ///< a re-run requested, or the 0088 offer waiting
+    bool printing = false;       ///< a print holds the printer (motion blocked)
+    bool dialog_up = false;      ///< another dialog is on the screen
+};
+
+/// Show it now? (pure) A notice there, not shown already, nothing in the way
+bool should_show(const Notice& notice, bool shown, const Gates& gates);
+
+/// The two notices' title and text, translated (lv_tr)
+std::string title(Kind kind);
+std::string text(Kind kind);
+
+/// At the screen's start: look now and every kPollMs. Nothing without
+/// HELIX_KILN_BL_NOTICE_FILE.
+void start();
+
+/// Look once (start()'s timer): read the file and show the notice when
+/// should_show() says so
+void check_now();
+
+/// The notice is on the screen
+bool showing();
+
+/// Tests: the timer gone, the dialog forgotten
+void reset_for_test();
+
+} // namespace helix::kiln_bl_notice
