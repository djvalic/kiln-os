+            lv_translation_set_language(helix::ui::kIdentityLocale);
+        }
+    } restore;
+    helix::ui::ensure_translation_loaded("de");
+    lv_translation_set_language("de");
+
+    // Settings > System's row is German, and the notice names it so; only
+    // the recovery screen's entries stay English (that screen shows them in
+    // English in German)
+    CHECK(std::string(lv_tr("Boot into recovery")) == "Wiederherstellungssystem starten");
+    CHECK(std::string(lv_tr("Boot into recovery?")) == "Wiederherstellungssystem starten?");
+
