+
+// ============================================================================
+// Kiln OS: zMod's settings macro without zMod (djvalic/kiln-os#57)
+// ============================================================================
+//
+// Kiln OS's zmod-compat plugin, on by default, defines SAVE_ZMOD_DATA so that
+// zMod-made G-code runs. The offset itself is kept by Kiln's SET_GCODE_OFFSET
+// wrapper as save_variables `zoffset`, the Helper-Script layout, and there is
+// no _TEST_POINT macro. Taken for zMod, every idle save first sent
+// SET_GCODE_VARIABLE MACRO=_TEST_POINT ..., which Klipper refused, and the
+// Z offset was not saved.
+
+TEST_CASE("z-offset persistence: SAVE_ZMOD_DATA without _TEST_POINT is not zMod",
+          "[zoffset][persistence][kiln]") {
+    PrinterDiscovery hw = printer_with_macros({"SAVE_ZMOD_DATA"});
+
+    CHECK_FALSE(helix::zoffset::firmware_persists_z_offset(hw));
+    CHECK(helix::zoffset::persistence_provider_name(hw).empty());
+    CHECK(helix::zoffset::stale_probe_delta_clear_gcode(hw).empty());
+    CHECK(helix::zoffset::persistence_enable_gcode(hw).empty());
+}
+
+TEST_CASE("z-offset persistence: Kiln OS resolves to its own zoffset store",
+          "[zoffset][persistence][kiln]") {
+    // zmod-compat's SAVE_ZMOD_DATA plus Kiln's renaming SET_GCODE_OFFSET wrapper.
+    PrinterDiscovery hw = printer_with_macros({"SAVE_ZMOD_DATA", "SET_GCODE_OFFSET"});
+
+    CHECK(helix::zoffset::persistence_provider_name(hw) == "Helper-Script");
+    CHECK(helix::zoffset::firmware_persists_z_offset(hw));
+    CHECK(contains(helix::zoffset::required_status_objects(hw), "save_variables"));
+    // Nothing aimed at zMod's macros: no _TEST_POINT clear, no SAVE_ZMOD_DATA
+    // LOAD_ZOFFSET=1 (zmod-compat would only answer that it is not saved).
+    CHECK(helix::zoffset::stale_probe_delta_clear_gcode(hw).empty());
+    CHECK(helix::zoffset::persistence_enable_gcode(hw).empty());
+
+    // The value Kiln's wrapper saves is the one read back.
+    json status = json{{"save_variables", json{{"variables", json{{"zoffset", json{{"z", -0.15}}}}}}}};
+    CHECK(helix::zoffset::read_persisted_offset_microns(status) == -150);
+    CHECK_FALSE(helix::zoffset::status_refutes_persistence(hw, status));
+}
