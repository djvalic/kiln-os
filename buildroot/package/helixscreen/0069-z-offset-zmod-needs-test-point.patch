diff --git a/src/printer/z_offset_persistence.cpp b/src/printer/z_offset_persistence.cpp
index 217b83cb4c..70715bfec0 100644
--- a/src/printer/z_offset_persistence.cpp
+++ b/src/printer/z_offset_persistence.cpp
@@ -225,8 +225,13 @@ bool refuted_helper_script(const nlohmann::json& status) {
     return variables->find("zoffset") == variables->end();
 }
 
+// Kiln OS: its zmod-compat plugin defines SAVE_ZMOD_DATA so that zMod-made
+// G-code runs, but it keeps the offset as the Helper-Script row's `zoffset`,
+// and it has no _TEST_POINT, whose variable this row clears before every idle
+// adjustment (the command fails there and the save with it). zMod's own
+// SET_GCODE_OFFSET reads _TEST_POINT, so zMod always has it.
 bool detect_zmod(const PrinterDiscovery& hw) {
-    return hw.has_macro("SAVE_ZMOD_DATA");
+    return hw.has_macro("SAVE_ZMOD_DATA") && hw.has_macro("_TEST_POINT");
 }
 
