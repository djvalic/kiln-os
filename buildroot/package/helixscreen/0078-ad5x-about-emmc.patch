+                               subjects_);
     });
 }
 
diff --git a/tests/unit/test_kiln_hardware.cpp b/tests/unit/test_kiln_hardware.cpp
new file mode 100644
index 00000000..2ca52436
--- /dev/null
+++ b/tests/unit/test_kiln_hardware.cpp
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * Kiln OS: the About panel names the eMMC, from /sys/block/mmcblk0.
+ * Values below are printer 2's A31M8C.
+ */
+
+#include "system/kiln_hardware.h"
+
+#include <filesystem>
+#include <fstream>
+#include <string>
+
+#include "../catch_amalgamated.hpp"
+
+using namespace helix::kiln_hardware;
+namespace fs = std::filesystem;
+
+namespace {
+
+struct Root {
+    fs::path dir;
+    Root() {
+        dir = fs::temp_directory_path() /
+              ("kiln_hw_" + std::to_string(reinterpret_cast<std::uintptr_t>(this)));
+        fs::remove_all(dir);
+        fs::create_directories(dir);
+    }
+    ~Root() {
+        std::error_code ec;
+        fs::remove_all(dir, ec);
+    }
+    void put(const std::string& rel, const std::string& body) const {
+        const fs::path p = dir / rel;
+        fs::create_directories(p.parent_path());
+        std::ofstream(p, std::ios::binary) << body;
+    }
+    std::string str() const { return dir.string(); }
+};
+
+} // namespace
+
+TEST_CASE("Kiln hardware: the eMMC row", "[kiln][hardware]") {
+    Root r;
+    SECTION("no eMMC: no row") {
+        CHECK(emmc_summary(r.str()).empty());
+    }
+    SECTION("an SD card is not the eMMC") {
+        r.put("sys/block/mmcblk0/device/type", "SD\n");
+        r.put("sys/block/mmcblk0/device/name", "SD32G\n");
+        CHECK(emmc_summary(r.str()).empty());
+    }
+    SECTION("printer 2's A31M8C") {
+        r.put("sys/block/mmcblk0/device/type", "MMC\n");
+        r.put("sys/block/mmcblk0/device/name", "A31M8C\n");
+        r.put("sys/block/mmcblk0/device/manfid", "0x0000ec\n");
+        r.put("sys/block/mmcblk0/device/prv", "0x30\n");
+        r.put("sys/block/mmcblk0/size", "122142720\n");
+        CHECK(emmc_summary(r.str()) == "A31M8C (maker 0xEC), PRV 0x30, 58.2 GiB");
+    }
+}
