diff --git a/src/system/kiln_hardware.cpp b/src/system/kiln_hardware.cpp
new file mode 100644
index 0000000000..1b9b5d3ddc
--- /dev/null
+++ b/src/system/kiln_hardware.cpp
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "system/kiln_hardware.h"
+
+#include "core/text_io.h"
+
+#include <spdlog/fmt/fmt.h>
+
+namespace helix::kiln_hardware {
+
+namespace tio = helix::text_io;
+
+namespace {
+
+std::string read_trimmed(const std::string& path) {
+    auto body = tio::read_file(path, 4096);
+    if (!body) {
+        return {};
+    }
+    return std::string(tio::trim(*body));
+}
+
+} // namespace
+
+std::string emmc_summary(const std::string& root) {
+    const std::string block = root + "/sys/block/mmcblk0";
+    const std::string dev = block + "/device";
+    if (read_trimmed(dev + "/type") != "MMC") {
+        return {};
+    }
+    const std::string name = read_trimmed(dev + "/name");
+    if (name.empty()) {
+        return {};
+    }
+
+    std::string text = name;
+    // manfid reads "0x0000ec"
+    const std::string manfid = read_trimmed(dev + "/manfid");
+    if (manfid.size() > 2) {
+        if (auto id = tio::parse_int<unsigned>(manfid.substr(2), 16)) {
+            text += fmt::format(" (maker 0x{:02X})", *id);
+        }
+    }
+    const std::string prv = read_trimmed(dev + "/prv");
+    if (!prv.empty()) {
+        text += fmt::format(", PRV {}", prv);
+    }
+    // 512-byte sectors
+    if (auto sectors = tio::parse_int<unsigned long long>(read_trimmed(block + "/size"))) {
+        text += fmt::format(", {:.1f} GiB", static_cast<double>(*sectors) * 512.0 /
+                                                (1024.0 * 1024.0 * 1024.0));
+    }
+    return text;
+}
+
+} // namespace helix::kiln_hardware
