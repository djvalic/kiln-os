+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+/**
+ * @file kiln_hardware.h
+ * @brief Kiln OS on the AD5X: which parts the printer has.
+ *
+ * AD5X boards differ in parts that matter for support, such as the eMMC
+ * (58A398, A31M8C, MMC8GB so far). The About panel shows it.
+ */
+
+#include <string>
+
+namespace helix::kiln_hardware {
+
+/**
+ * @brief The eMMC row: "A31M8C (maker 0xEC), PRV 0x30, 58.2 GiB".
+ *
+ * From /sys/block/mmcblk0; "" when there is no eMMC there. @p root is the
+ * test seam: the files are read below it.
+ */
+std::string emmc_summary(const std::string& root = "");
+
+} // namespace helix::kiln_hardware
