 #include "theme_manager.h"
 
 #include <spdlog/spdlog.h>
@@ -185,6 +187,25 @@ bool swiped_by_pointer(lv_obj_t* scroll) {
     return false;
 }
 
+/**
+ * @brief True when the press under @p indev began on a tile and has been held
+ * long enough for LVGL's long press to fire (400 ms).
+ *
+ * A finger that rests on a tile and then drifts is a hold, not a page swipe.
+ * A quick flick from a tile does not fire the long press, so it still pages.
+ */
+bool held_tile_press(lv_indev_t* indev) {
+    if (!indev || !indev->long_pr_sent) {
+        return false;
+    }
+    for (lv_obj_t* obj = indev->pointer.act_obj; obj != nullptr; obj = lv_obj_get_parent(obj)) {
+        if (lv_obj_has_flag(obj, helix::kPanelWidgetTileFlag)) {
+            return true;
+        }
+    }
+    return false;
+}
+
 /**
  * @brief SCROLL_BEGIN event handler: only a swipe or a goto moves the page
  *
@@ -205,6 +226,13 @@ void carousel_scroll_begin_cb(lv_event_t* e) {
     // an offset set outright.
     auto* anim = static_cast<lv_anim_t*>(lv_event_get_param(e));
     if (!anim) {
+        // A drag that starts on a tile the finger has been holding stays on the
+        // tile: wait for the release and stop this scroll.
+        lv_indev_t* indev = lv_indev_active();
+        if (held_tile_press(indev)) {
+            lv_indev_wait_release(indev);
+            lv_indev_reset(indev, scroll);
+        }
         return;
     }
     CarouselState* state = ui_carousel_get_state(lv_obj_get_parent(scroll));
