+// Kiln OS: Ethernet is re-read every few seconds while this overlay is open, so
+// a cable pulled or plugged in shows up without reopening it. update_ethernet_status()
+// coalesces, so a probe still in flight is not doubled.
+void NetworkSettingsOverlay::start_ethernet_poll() {
+    stop_ethernet_poll();
+    eth_poll_timer_ = lv_timer_create(
+        [](lv_timer_t* t) {
+            auto* self = static_cast<NetworkSettingsOverlay*>(lv_timer_get_user_data(t));
+            if (self)
+                self->update_ethernet_status();
+        },
+        3000, this);
+}
+
+void NetworkSettingsOverlay::stop_ethernet_poll() {
+    if (eth_poll_timer_) {
+        helix::ui::lv_timer_cancel_safe(eth_poll_timer_);
+        eth_poll_timer_ = nullptr;
+    }
+}
