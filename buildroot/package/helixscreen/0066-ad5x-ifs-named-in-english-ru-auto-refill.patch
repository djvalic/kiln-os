diff --git a/tests/unit/test_kiln_ifs_wording.cpp b/tests/unit/test_kiln_ifs_wording.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/test_kiln_ifs_wording.cpp
@@ -0,0 +1,208 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Kiln OS: the AD5X's filament unit is the IFS. English is the identity
+// locale, so the screen shows a source string as written: a text that says
+// AMS on the AD5X has to be a different string there. These tests pin that
+// the AD5X IFS paths say IFS, that every other backend keeps upstream's AMS,
+// and that every catalog has the IFS keys, translated as the AMS ones are.
+
+#include "../lvgl_test_fixture.h"
+#include "../test_helpers/config_test_access.h"
+#include "ams_backend_ad5x_ifs.h"
+#include "ams_error.h"
+#include "ams_types.h"
+#include "config.h"
+#include "data_root_resolver.h"
+#include "hardware_validator.h"
+#include "moonraker_client_mock.h"
+#include "print_start_checks.h"
+#include "test_helpers/ad5x_ifs_test_access.h"
+
+#include <algorithm>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "../catch_amalgamated.hpp"
+
+using namespace helix;
+using json = nlohmann::json;
+namespace fs = std::filesystem;
+
+namespace {
+
+bool says_ams(const std::string& text) {
+    return text.find("AMS") != std::string::npos;
+}
+
+const PrintStartGate& gate_named(const char* name) {
+    const auto& gates = default_print_start_gates();
+    const auto it = std::find_if(gates.begin(), gates.end(), [&](const PrintStartGate& g) {
+        return g.name == std::string(name);
+    });
+    REQUIRE(it != gates.end());
+    return *it;
+}
+
+/// The value of a one-line `'key': 'value'` entry, or nullopt.
+std::optional<std::string> quoted_value(const std::string& yml, const std::string& key) {
+    auto quote = [](const std::string& s) {
+        std::string out = "'";
+        for (char c : s) {
+            out += c;
+            if (c == '\'') {
+                out += '\'';
+            }
+        }
+        return out + "'";
+    };
+    const std::string head = "\n  " + quote(key) + ": '";
+    const size_t at = yml.find(head);
+    if (at == std::string::npos) {
+        return std::nullopt;
+    }
+    std::string value;
+    for (size_t i = at + head.size(); i < yml.size(); ++i) {
+        if (yml[i] == '\'') {
+            if (i + 1 < yml.size() && yml[i + 1] == '\'') {
+                value += '\'';
+                ++i;
+                continue;
+            }
+            return value;
+        }
+        value += yml[i];
+    }
+    return std::nullopt;
+}
+
+} // namespace
+
+TEST_CASE("Kiln IFS wording: the AD5X IFS says the IFS is busy", "[kiln][ams][ad5x_ifs][i18n]") {
+    AmsBackendAd5xIfs backend(nullptr, nullptr);
+    Ad5xIfsTestAccess::set_running(backend, true);
+    Ad5xIfsTestAccess::set_action(backend, AmsAction::LOADING);
+
+    const AmsError err = backend.load_filament(1);
+    REQUIRE(err.result == AmsResult::BUSY);
+    CHECK(err.user_msg == "The IFS is busy");
+    CHECK_FALSE(says_ams(err.display_text()));
+
+    // Every other backend keeps upstream's wording.
+    CHECK(AmsErrorHelper::busy().user_msg == "AMS is busy");
+    CHECK(AmsErrorHelper::busy_ifs().result == AmsResult::BUSY);
+}
+
+TEST_CASE("Kiln IFS wording: print start warnings name the IFS on the AD5X",
+          "[kiln][print-start][i18n]") {
+    auto bypass_ctx = [](bool ad5x) {
+        PrintStartContext c;
+        c.ams_available = true;
+        c.any_bypass_active = true;
+        c.filament_color_count = 4;
+        c.ad5x_ifs_in_use = ad5x;
+        return c;
+    };
+    auto toolhead_ctx = [](bool ad5x, bool clearable) {
+        PrintStartContext c;
+        c.toolhead_unaccounted = {std::optional<bool>(true)};
+        c.toolhead_clearable = {clearable};
+        c.ad5x_ifs_in_use = ad5x;
+        return c;
+    };
+    const auto& bypass = gate_named("bypass_engaged_lane_print");
+    const auto& toolhead = gate_named("unaccounted_toolhead_filament");
+
+    SECTION("AD5X IFS") {
+        auto r = bypass.evaluate(bypass_ctx(true));
+        REQUIRE(r.verdict == CheckResult::Verdict::Warn);
+        CHECK(r.body.find("uses IFS slots") != std::string::npos);
+        CHECK_FALSE(says_ams(r.body));
+        for (bool clearable : {false, true}) {
+            auto t = toolhead.evaluate(toolhead_ctx(true, clearable));
+            REQUIRE(t.verdict == CheckResult::Verdict::Warn);
+            CHECK(t.body.find("no IFS slot") != std::string::npos);
+            CHECK_FALSE(says_ams(t.body));
+        }
+    }
+    SECTION("any other backend") {
+        auto r = bypass.evaluate(bypass_ctx(false));
+        REQUIRE(r.verdict == CheckResult::Verdict::Warn);
+        CHECK(r.body.find("uses AMS slots") != std::string::npos);
+        for (bool clearable : {false, true}) {
+            auto t = toolhead.evaluate(toolhead_ctx(false, clearable));
+            REQUIRE(t.verdict == CheckResult::Verdict::Warn);
+            CHECK(t.body.find("no AMS slot") != std::string::npos);
+        }
+    }
+}
+
+TEST_CASE("Kiln IFS wording: a missing IFS reads IFS not detected", "[kiln][hardware][i18n]") {
+    Config config;
+    setup_printer_data(config, {{"moonraker_host", "127.0.0.1"},
+                                {"moonraker_port", 7125},
+                                {"hardware",
+                                 {{"optional", json::array()},
+                                  {"expected", {"ifs", "AFC"}},
+                                  {"last_snapshot", json::object()}}}});
+    MoonrakerClientMock client;
+    const auto result = HardwareValidator{}.validate(&config, client.hardware());
+
+    std::string ifs_message;
+    std::string afc_message;
+    for (const auto& issue : result.expected_missing) {
+        if (issue.hardware_name == "ifs") {
+            ifs_message = issue.message;
+        } else if (issue.hardware_name == "AFC") {
+            afc_message = issue.message;
+        }
+    }
+    CHECK(ifs_message == "IFS not detected");
+    CHECK(afc_message == "AMS/MMU system not detected");
+}
+
+// The build makes the packs from translations/*.yml. Each IFS key has to be
+// in every catalog, carrying the translation its AMS twin already had (patch
+// 0030 worded those as IFS), so no language falls back to English.
+TEST_CASE("Kiln IFS wording: every catalog has the IFS keys", "[kiln][i18n]") {
+    const std::vector<std::string> keys = {
+        "The IFS is busy",
+        "IFS not detected",
+        "IFS Active: ",
+        "Bypass is active, but this print uses IFS slots. The printer may refuse to load a slot "
+        "while bypass filament is in the toolhead. Remove the filament and turn bypass off before "
+        "printing. Start anyway?",
+        "The toolhead has filament but no IFS slot reports it loaded. The printer may refuse to "
+        "load a slot until it is cleared. Start anyway?",
+        "The toolhead has filament but no IFS slot reports it loaded. Pull it out manually before "
+        "printing. Start anyway?",
+    };
+
+    int catalogs = 0;
+    for (const auto& entry : fs::directory_iterator(helix::asset_path("translations"))) {
+        if (entry.path().extension() != ".yml") {
+            continue;
+        }
+        ++catalogs;
+        const std::string locale = entry.path().stem().string();
+        std::ifstream in(entry.path());
+        const std::string yml((std::istreambuf_iterator<char>(in)),
+                              std::istreambuf_iterator<char>());
+        for (const auto& key : keys) {
+            INFO(locale << ": " << key);
+            const auto value = quoted_value(yml, key);
+            REQUIRE(value.has_value());
+            if (locale == "en") {
+                CHECK(*value == key);
+            } else {
+                CHECK(value->find("IFS") != std::string::npos);
+                CHECK(*value != key);
+            }
+            CHECK_FALSE(says_ams(*value));
+        }
+    }
+    CHECK(catalogs >= 11); // de en es fr it ja ko pt ru tr zh
+}
