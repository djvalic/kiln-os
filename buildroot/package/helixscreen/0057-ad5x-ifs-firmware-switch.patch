diff --git a/src/ui/ad5x_ifs_firmware_view.cpp b/src/ui/ad5x_ifs_firmware_view.cpp
new file mode 100644
index 0000000..dd78cbd
--- /dev/null
+++ b/src/ui/ad5x_ifs_firmware_view.cpp
@@ -0,0 +1,179 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "ad5x_ifs_firmware_view.h"
+
+#include <spdlog/fmt/fmt.h>
+
+namespace helix::ad5x_ifs_firmware {
+
+namespace {
+
+Translator g_translator = nullptr;
+
+const char* tr(const char* english) {
+    return g_translator ? g_translator(english) : english;
+}
+
+bool printing(const std::string& print_state) {
+    // The same test as Moonraker's switch request and the root agent
+    return print_state == "printing" || print_state == "paused";
+}
+
+const char* phase_line(const std::string& phase) {
+    if (phase == "stopping") {
+        return tr("Stopping Klipper…");
+    }
+    if (phase == "writing") {
+        return tr("Writing…");
+    }
+    if (phase == "replug") {
+        return tr("Unplug the IFS cable and plug it back in");
+    }
+    if (phase == "verifying") {
+        return tr("Checking the IFS…");
+    }
+    if (phase == "starting" || phase == "finished") {
+        return tr("Starting Klipper…");
+    }
+    return tr("Checking…");
+}
+
+/// "v3.0.7" from "3.0.7" or "v3.0.7"
+std::string version_text(const std::string& version) {
+    if (version.empty() || version[0] == 'v' || version[0] == 'V') {
+        return version;
+    }
+    return "v" + version;
+}
+
+std::string done_body(const IfsFirmwareStatus& s) {
+    const bool stock = s.target == "stock";
+    std::string line;
+    if (s.version.empty()) {
+        line = stock ? tr("IFS on stock firmware.") : tr("IFS on Klipper firmware.");
+    } else {
+        line = fmt::format(fmt::runtime(stock ? tr("IFS on stock firmware: {} answers.")
+                                              : tr("IFS on Klipper firmware: {} answers.")),
+                           version_text(s.version));
+    }
+    line += ' ';
+    line += stock ? tr("The built-in IFS driver runs it; plugins that need Klipper firmware on "
+                       "the IFS are off.")
+                  : tr("Plugins are as they were.");
+    return line;
+}
+
+IfsFirmwareView result_view(const IfsFirmwareStatus& s) {
+    IfsFirmwareView v;
+    v.ok = true;
+    if (s.state == "done") {
+        v.kind = IfsFirmwareViewKind::Done;
+        v.title = tr("IFS firmware switched");
+        v.body = done_body(s);
+        return v;
+    }
+    v.kind = IfsFirmwareViewKind::Failed;
+    v.title = s.state == "refused" ? tr("IFS firmware switch refused")
+                                   : tr("IFS firmware switch failed");
+    v.body = s.message.empty() ? std::string(tr("No result (ad5x-mcu status)")) : s.message;
+    return v;
+}
+
+IfsFirmwareView choose_view(const IfsFirmwareStatus& s, bool klipper_ready) {
+    IfsFirmwareView v;
+    v.kind = IfsFirmwareViewKind::Choose;
+    const std::string label = ifs_firmware_label(s.firmware);
+    v.title = fmt::format("{}: {}", tr("IFS firmware"), tr(label.c_str()));
+    if (!klipper_ready) {
+        // Nothing to show the firmware from, and the agent would refuse a busy Klipper anyway
+        v.body = tr("Waiting for Klipper…");
+        return v;
+    }
+    if (s.firmware == "klipper") {
+        v.body = tr("The IFS runs Klipper firmware.");
+        v.offer_stock = true;
+    } else if (s.firmware == "stock") {
+        v.body = tr("The IFS runs Flashforge's firmware.");
+        v.offer_klipper = true;
+    } else {
+        v.body = tr("The IFS doesn't answer as either firmware. Switch it to one of them.");
+        v.offer_stock = true;
+        v.offer_klipper = true;
+    }
+    if (s.state == "failed" && !s.message.empty()) {
+        v.body += '\n';
+        v.body += fmt::format(fmt::runtime(tr("Last switch: {}")), s.message);
+    }
+    v.choice_enabled = !printing(s.print_state);
+    if (!v.choice_enabled) {
+        v.body += '\n';
+        v.body += tr("Can't switch during a print.");
+    }
+    return v;
+}
+
+} // namespace
+
+void set_translator(Translator tr) {
+    g_translator = tr;
+}
+
+std::string ifs_firmware_label(const std::string& firmware) {
+    if (firmware == "stock") {
+        return "Stock";
+    }
+    if (firmware == "klipper") {
+        return "Klipper";
+    }
+    return "Unknown";
+}
+
+IfsFirmwareConfirm ifs_firmware_confirm(const std::string& target) {
+    IfsFirmwareConfirm c;
+    c.button = tr("Switch");
+    if (target == "stock") {
+        c.title = tr("Switch the IFS to stock firmware?");
+        c.body = tr("Flashes Flashforge's firmware from this printer's backup (about a minute). "
+                    "Plugins that need Klipper firmware on the IFS (Happy Hare) will be turned "
+                    "off. Klipper restarts.");
+    } else {
+        c.title = tr("Switch the IFS to Klipper firmware?");
+        c.body = tr("Flashes the Klipper firmware that comes with this image (about a minute). "
+                    "Plugins stay as they are; ones that are off stay off. Klipper restarts.");
+    }
+    return c;
+}
+
+IfsFirmwareView ifs_firmware_view(const IfsFirmwareStatus& s, bool klipper_ready,
+                                  int seconds_waiting) {
+    const bool running = s.state == "running" || s.switching;
+
+    if ((running || s.following) && seconds_waiting > kWaitLimitSeconds &&
+        (!klipper_ready || running)) {
+        IfsFirmwareView v;
+        v.kind = IfsFirmwareViewKind::Failed;
+        v.title = tr("IFS firmware switch");
+        v.body = !klipper_ready
+                     ? tr("Klipper did not start again (ad5x-mcu status, klippy.log)")
+                     : tr("The switch did not start (/data/ad5x/kiln-update/agent.log)");
+        v.ok = true;
+        return v;
+    }
+
+    if (running || (s.following && !klipper_ready)) {
+        IfsFirmwareView v;
+        v.kind = IfsFirmwareViewKind::Progress;
+        v.title = tr("Switching IFS firmware…");
+        // A finished switch while Klipper is still away: Klipper is starting
+        const std::string phase = running ? s.phase : std::string("starting");
+        v.body = fmt::format("{}\n{}", phase_line(phase), tr("Don't switch the printer off."));
+        return v;
+    }
+
+    if (s.following) {
+        return result_view(s);
+    }
+    return choose_view(s, klipper_ready);
+}
+
+} // namespace helix::ad5x_ifs_firmware
