@@ -0,0 +1,211 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "ad5x_ifs_firmware_view.h"
+
+#include "../catch_amalgamated.hpp"
+
+using namespace helix::ad5x_ifs_firmware;
+
+namespace {
+
+/// A switch from this screen whose status file says @p state / @p phase.
+IfsFirmwareStatus followed(const std::string& state, const std::string& phase) {
+    IfsFirmwareStatus s;
+    s.firmware = "klipper";
+    s.switching = state == "running";
+    s.print_state = "standby";
+    s.following = true;
+    s.target = "stock";
+    s.state = state;
+    s.phase = phase;
+    return s;
+}
+
+IfsFirmwareStatus idle_on(const std::string& firmware) {
+    IfsFirmwareStatus s;
+    s.firmware = firmware;
+    s.print_state = "standby";
+    s.state = "none";
+    return s;
+}
+
+} // namespace
+
+TEST_CASE("the confirm dialog says what each switch does", "[ad5x_ifs_firmware]") {
+    const IfsFirmwareConfirm stock = ifs_firmware_confirm("stock");
+    CHECK(stock.title == "Switch the IFS to stock firmware?");
+    CHECK(stock.body == "Flashes Flashforge's firmware from this printer's backup (about a "
+                        "minute). Plugins that need Klipper firmware on the IFS (Happy Hare) "
+                        "will be turned off. Klipper restarts.");
+    CHECK(stock.button == "Switch");
+
+    const IfsFirmwareConfirm klipper = ifs_firmware_confirm("klipper");
+    CHECK(klipper.title == "Switch the IFS to Klipper firmware?");
+    CHECK(klipper.body == "Flashes the Klipper firmware that comes with this image (about a "
+                          "minute). Plugins stay as they are; ones that are off stay off. "
+                          "Klipper restarts.");
+    CHECK(klipper.button == "Switch");
+}
+
+TEST_CASE("writing shows the progress view without buttons", "[ad5x_ifs_firmware]") {
+    const IfsFirmwareView v = ifs_firmware_view(followed("running", "writing"), false, 20);
+    CHECK(v.kind == IfsFirmwareViewKind::Progress);
+    CHECK(v.title == "Switching IFS firmware…");
+    CHECK(v.body == "Writing…\nDon't switch the printer off.");
+    CHECK_FALSE(v.offer_stock);
+    CHECK_FALSE(v.offer_klipper);
+    CHECK_FALSE(v.ok);
+}
+
+TEST_CASE("a bootloader that doesn't answer asks for a replug", "[ad5x_ifs_firmware]") {
+    const IfsFirmwareView v = ifs_firmware_view(followed("running", "replug"), false, 0);
+    CHECK(v.kind == IfsFirmwareViewKind::Progress);
+    CHECK(v.title == "Switching IFS firmware…");
+    CHECK(v.body == "Unplug the IFS cable and plug it back in\nDon't switch the printer off.");
+}
+
+TEST_CASE("a running switch waits for Klipper after it finished", "[ad5x_ifs_firmware]") {
+    IfsFirmwareStatus s = followed("done", "finished");
+    s.version = "3.0.7";
+    const IfsFirmwareView v = ifs_firmware_view(s, false, 30);
+    CHECK(v.kind == IfsFirmwareViewKind::Progress);
+    CHECK(v.body == "Starting Klipper…\nDon't switch the printer off.");
+    CHECK_FALSE(v.ok);
+}
+
+TEST_CASE("a switch to stock reports the version the IFS answers", "[ad5x_ifs_firmware]") {
+    IfsFirmwareStatus s = followed("done", "finished");
+    s.firmware = "stock";
+    s.version = "3.0.7";
+    s.message = "IFS firmware: stock";
+    const IfsFirmwareView v = ifs_firmware_view(s, true, 0);
+    CHECK(v.kind == IfsFirmwareViewKind::Done);
+    CHECK(v.title == "IFS firmware switched");
+    CHECK(v.body == "IFS on stock firmware: v3.0.7 answers. The built-in IFS driver runs it; "
+                    "plugins that need Klipper firmware on the IFS are off.");
+    CHECK(v.ok);
+    CHECK_FALSE(v.offer_stock);
+    CHECK_FALSE(v.offer_klipper);
+}
+
+TEST_CASE("a switch to Klipper reports its version", "[ad5x_ifs_firmware]") {
+    IfsFirmwareStatus s = followed("done", "finished");
+    s.target = "klipper";
+    s.version = "v0.13.0-806";
+    const IfsFirmwareView v = ifs_firmware_view(s, true, 0);
+    CHECK(v.kind == IfsFirmwareViewKind::Done);
+    CHECK(v.body == "IFS on Klipper firmware: v0.13.0-806 answers. Plugins are as they were.");
+}
+
+TEST_CASE("a failed switch shows the agent's message", "[ad5x_ifs_firmware]") {
+    IfsFirmwareStatus s = followed("failed", "finished");
+    s.firmware = "unknown";
+    s.message = "stock 1.2.3: ifs.hex doesn't match md5sum.list";
+    const IfsFirmwareView v = ifs_firmware_view(s, true, 0);
+    CHECK(v.kind == IfsFirmwareViewKind::Failed);
+    CHECK(v.title == "IFS firmware switch failed");
+    CHECK(v.body == "stock 1.2.3: ifs.hex doesn't match md5sum.list");
+    CHECK(v.ok);
+}
+
+TEST_CASE("a refused switch says why", "[ad5x_ifs_firmware]") {
+    IfsFirmwareStatus s = followed("refused", "finished");
+    s.message = "a print is running";
+    const IfsFirmwareView v = ifs_firmware_view(s, true, 0);
+    CHECK(v.kind == IfsFirmwareViewKind::Failed);
+    CHECK(v.title == "IFS firmware switch refused");
+    CHECK(v.body == "a print is running");
+    CHECK(v.ok);
+}
+
+TEST_CASE("the choice offers the other firmware", "[ad5x_ifs_firmware]") {
+    const IfsFirmwareView on_klipper = ifs_firmware_view(idle_on("klipper"), true, 0);
+    CHECK(on_klipper.kind == IfsFirmwareViewKind::Choose);
+    CHECK(on_klipper.title == "IFS firmware: Klipper");
+    CHECK(on_klipper.body == "The IFS runs Klipper firmware.");
+    CHECK(on_klipper.offer_stock);
+    CHECK_FALSE(on_klipper.offer_klipper);
+    CHECK(on_klipper.choice_enabled);
+    CHECK_FALSE(on_klipper.ok);
+
+    const IfsFirmwareView on_stock = ifs_firmware_view(idle_on("stock"), true, 0);
+    CHECK(on_stock.title == "IFS firmware: Stock");
+    CHECK(on_stock.body == "The IFS runs Flashforge's firmware.");
+    CHECK_FALSE(on_stock.offer_stock);
+    CHECK(on_stock.offer_klipper);
+    CHECK(on_stock.choice_enabled);
+}
+
+TEST_CASE("an IFS that answers nothing after a failed switch offers both", "[ad5x_ifs_firmware]") {
+    IfsFirmwareStatus s = idle_on("unknown");
+    s.target = "stock";
+    s.state = "failed";
+    s.phase = "finished";
+    s.message = "the IFS doesn't answer";
+    const IfsFirmwareView v = ifs_firmware_view(s, true, 0);
+    CHECK(v.kind == IfsFirmwareViewKind::Choose);
+    CHECK(v.title == "IFS firmware: Unknown");
+    CHECK(v.body == "The IFS doesn't answer as either firmware. Switch it to one of them.\n"
+                    "Last switch: the IFS doesn't answer");
+    CHECK(v.offer_stock);
+    CHECK(v.offer_klipper);
+    CHECK(v.choice_enabled);
+}
+
+TEST_CASE("no switch during a print", "[ad5x_ifs_firmware]") {
+    for (const char* state : {"printing", "paused"}) {
+        IfsFirmwareStatus s = idle_on("klipper");
+        s.print_state = state;
+        const IfsFirmwareView v = ifs_firmware_view(s, true, 0);
+        CHECK(v.kind == IfsFirmwareViewKind::Choose);
+        CHECK(v.offer_stock);
+        CHECK_FALSE(v.choice_enabled);
+        CHECK(v.body == "The IFS runs Klipper firmware.\nCan't switch during a print.");
+    }
+}
+
+TEST_CASE("no choice while Klipper is not ready", "[ad5x_ifs_firmware]") {
+    const IfsFirmwareView v = ifs_firmware_view(idle_on("klipper"), false, 0);
+    CHECK(v.kind == IfsFirmwareViewKind::Choose);
+    CHECK(v.body == "Waiting for Klipper…");
+    CHECK_FALSE(v.offer_stock);
+    CHECK_FALSE(v.offer_klipper);
+}
+
+TEST_CASE("a switch someone else started shows its progress", "[ad5x_ifs_firmware]") {
+    IfsFirmwareStatus s = idle_on("klipper");
+    s.switching = true;
+    s.state = "running";
+    s.phase = "verifying";
+    const IfsFirmwareView v = ifs_firmware_view(s, true, 0);
+    CHECK(v.kind == IfsFirmwareViewKind::Progress);
+    CHECK(v.body == "Checking the IFS…\nDon't switch the printer off.");
+}
+
+TEST_CASE("the screen stops waiting for a Klipper that does not come back",
+          "[ad5x_ifs_firmware]") {
+    IfsFirmwareStatus s = followed("done", "starting");
+    CHECK(ifs_firmware_view(s, false, 180).kind == IfsFirmwareViewKind::Progress);
+
+    const IfsFirmwareView v = ifs_firmware_view(s, false, 181);
+    CHECK(v.kind == IfsFirmwareViewKind::Failed);
+    CHECK(v.body == "Klipper did not start again (ad5x-mcu status, klippy.log)");
+    CHECK(v.ok);
+    CHECK_FALSE(v.offer_stock);
+    CHECK_FALSE(v.offer_klipper);
+}
+
+TEST_CASE("a request nobody picks up stops the wait too", "[ad5x_ifs_firmware]") {
+    IfsFirmwareStatus s = followed("running", "checking");
+    const IfsFirmwareView v = ifs_firmware_view(s, true, 181);
+    CHECK(v.kind == IfsFirmwareViewKind::Failed);
+    CHECK(v.body == "The switch did not start (/data/ad5x/kiln-update/agent.log)");
+    CHECK(v.ok);
+}
+
+TEST_CASE("the row's value names the firmware", "[ad5x_ifs_firmware]") {
+    CHECK(ifs_firmware_label("stock") == "Stock");
+    CHECK(ifs_firmware_label("klipper") == "Klipper");
+    CHECK(ifs_firmware_label("unknown") == "Unknown");
+    CHECK(ifs_firmware_label("") == "Unknown");
+}
