@@ -0,0 +1,197 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * @file ui_settings_ad5x_ifs_firmware.h
+ * @brief Settings > Devices > IFS firmware on the AD5X: Stock or Klipper firmware on the IFS
+ *
+ * Ad5xIfsFirmwareModel follows Klipper's `ifs_firmware` object (firmware,
+ * switching, last) for the Devices row's value. Ad5xIfsFirmwareOverlay shows
+ * the choice, asks first, asks Moonraker for the switch (POST
+ * /server/kiln/ifs_firmware {"target": "stock"|"klipper"}, JSON-RPC
+ * `server.kiln.post_ifs_firmware`; no G-code) and follows it. The root agent
+ * stops Klipper for about a minute while it flashes, so the overlay polls
+ * Moonraker's `server.kiln.get_ifs_firmware` (the agent's status file) once a
+ * second while the switch runs or Klipper is not back, and shows the result
+ * once Klipper is ready again. What it shows comes
+ * from ad5x_ifs_firmware_view.h.
+ *
+ * @pattern Overlay (lazy init) over a process-wide model
+ * @threading Main thread only; Moonraker callbacks hop over via lifetime tokens
+ */
+
+#pragma once
+
+#include "ui_observer_guard.h"
+#include "ui_subscription_guard.h"
+#include "ui_timer_guard.h"
+
+#include "ad5x_ifs_firmware_view.h"
+#include "async_lifetime_guard.h"
+#include "json_fwd.h"
+#include "lvgl/lvgl.h"
+#include "overlay_base.h"
+#include "static_panel_registry.h"
+#include "subject_managed_panel.h"
+
+#include <chrono>
+#include <functional>
+#include <string>
+
+namespace helix::ad5x_ifs_firmware {
+
+/// Whether the printer publishes the `ifs_firmware` object.
+bool available();
+
+/// A switch takes Klipper's `mcu ifs` (and Happy Hare's objects) away or brings them back:
+/// for a while after a request the hardware check doesn't report the change as missing or
+/// new hardware (it still records the new set as the next session's baseline).
+void expect_hardware_change(uint32_t ms);
+void clear_expected_hardware_change();
+bool hardware_change_expected();
+
+/// The `ifs_firmware` object and the Devices row's value.
+///
+/// Subject: `ad5x_ifs_firmware_text` ("Stock", "Klipper", "Unknown"; empty
+/// until the object answered).
+class Ad5xIfsFirmwareModel {
+  public:
+    Ad5xIfsFirmwareModel() = default;
+    ~Ad5xIfsFirmwareModel();
+    Ad5xIfsFirmwareModel(const Ad5xIfsFirmwareModel&) = delete;
+    Ad5xIfsFirmwareModel& operator=(const Ad5xIfsFirmwareModel&) = delete;
+
+    void init_subjects();
+
+    /// Follow the object (status updates, Klipper restarts) from now on, and
+    /// query it. Safe to call again; later calls only query.
+    void start();
+
+    /// Ask Klipper for the whole object.
+    void query();
+
+    /// firmware, switching and the `last` fields; print_state and following unset.
+    const IfsFirmwareStatus& status() const {
+        return status_;
+    }
+    bool klippy_ready() const {
+        return klippy_ready_;
+    }
+
+    /// Runs on the main thread after status() or klippy_ready() changed.
+    /// One listener (the overlay on screen); nullptr clears it.
+    void set_listener(std::function<void()> listener);
+
+  private:
+    void merge(const json& obj);
+    void notify();
+
+    SubjectManager subjects_;
+    lv_subject_t text_{};
+    char text_buf_[32] = "";
+    bool subjects_initialized_ = false;
+
+    IfsFirmwareStatus status_;
+    bool loaded_ = false;
+    bool klippy_ready_ = true;
+    bool started_ = false;
+    std::function<void()> listener_;
+
+    SubscriptionGuard subscription_;
+    ObserverGuard klippy_observer_;
+    AsyncLifetimeGuard lifetime_;
+};
+
+Ad5xIfsFirmwareModel& model();
+
+} // namespace helix::ad5x_ifs_firmware
+
+namespace helix::settings {
+
+class Ad5xIfsFirmwareOverlay : public OverlayBase {
+  public:
+    ~Ad5xIfsFirmwareOverlay() override;
+
+    const char* get_name() const override {
+        return "AD5X IFS Firmware";
+    }
+    const char* xml_component() const override {
+        return "settings_ad5x_ifs_firmware_overlay";
+    }
+    /// Freed on close; the next open rebuilds it. A switch being followed
+    /// stays followed: reopening shows it again.
+    bool destroy_on_close() const override {
+        return true;
+    }
+
+    void init_subjects() override;
+    void deinit_subjects();
+    void register_callbacks() override;
+
+    /// Follow the model and, while a switch runs, poll Moonraker.
+    void on_activate() override;
+
+    /// Confirm, then ask Moonraker to switch to @p target.
+    void handle_switch(const std::string& target);
+    /// Result read: back to the choice.
+    void handle_ok();
+
+  protected:
+    void on_deactivating(DeactivateReason reason) override;
+
+  private:
+    /// The status the view is computed from: the model's, with Moonraker's
+    /// newer status-file fields and the request this screen sent.
+    helix::ad5x_ifs_firmware::IfsFirmwareStatus effective_status() const;
+    int seconds_waiting() const;
+    /// Subjects from the view; starts or stops polling.
+    void refresh();
+    void send(const std::string& target);
+    /// Moonraker refused the request: shown as a refused result.
+    void refused(const std::string& message);
+    void poll();
+    void apply_poll(const json& result);
+    void start_polling();
+    void stop_polling();
+    /// The model's `last` or a Moonraker answer: the status file moved on
+    /// from the one seen when the request was sent.
+    void note_file(const std::string& state, const std::string& phase, const std::string& message,
+                   const std::string& target, const std::string& version);
+    void mark_alive();
+
+    SubjectManager subjects_;
+    lv_subject_t kind_subject_{};
+    lv_subject_t title_subject_{};
+    lv_subject_t body_subject_{};
+    lv_subject_t offer_stock_subject_{};
+    lv_subject_t offer_klipper_subject_{};
+    lv_subject_t choice_enabled_subject_{};
+    lv_subject_t ok_subject_{};
+    char title_buf_[128] = "";
+    char body_buf_[512] = "";
+
+    /// A request went out from here; cleared by OK
+    bool following_ = false;
+    /// The request is out but the status file still shows the switch before it
+    bool pending_ = false;
+    bool command_in_flight_ = false;
+    /// Moonraker's refusal of the request; shown as the result until OK
+    std::string refusal_;
+    std::string requested_target_;
+    /// Status-file fields when the request was sent
+    std::string sent_state_, sent_message_, sent_target_, sent_version_;
+    /// Moonraker's answer, newer than the model's `last` while Klipper is away
+    bool have_file_ = false;
+    std::string file_state_, file_phase_, file_message_, file_target_, file_version_;
+    /// The request, or the last answer saying the switch runs
+    std::chrono::steady_clock::time_point alive_at_{};
+    bool poll_in_flight_ = false;
+
+    helix::ui::LvglTimerGuard poll_timer_;
+    ObserverGuard print_observer_;
+};
+
+inline Ad5xIfsFirmwareOverlay& get_ad5x_ifs_firmware_overlay() {
+    return lazy_global<Ad5xIfsFirmwareOverlay>("Ad5xIfsFirmwareOverlay");
+}
+
+} // namespace helix::settings
