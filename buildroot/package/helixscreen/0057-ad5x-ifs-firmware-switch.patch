@@ -0,0 +1,73 @@
+<?xml version="1.0"?>
+<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
+<!-- Settings > Devices > IFS firmware on the AD5X: Stock or Klipper firmware on the IFS -->
+<!-- Ad5xIfsFirmwareOverlay sets every ad5x_ifs_fw_* subject from ifs_firmware_view(): -->
+<!-- the choice, the progress while the switch runs (Klipper is away), the result. -->
+<component>
+  <styles>
+    <style name="pad_standard" pad_left="#space_lg" pad_right="#space_lg" pad_top="#space_md" pad_bottom="#space_md"/>
+    <style name="pad_micro" pad_left="#space_md" pad_right="#space_md" pad_top="#space_sm" pad_bottom="#space_sm"/>
+    <style name="text_failed" text_color="#danger"/>
+  </styles>
+  <view name="settings_ad5x_ifs_firmware_overlay" extends="overlay_panel" title="IFS firmware" bg_color="#screen_bg">
+    <!-- Content Area - no padding, rows handle their own -->
+    <lv_obj name="overlay_content"
+            width="100%" flex_grow="1" style_pad_top="0" style_pad_left="0" style_pad_right="0"
+            style_pad_bottom="#space_lg" scrollable="true" flex_flow="column">
+      <setting_group name="ad5x_ifs_fw_group">
+        <!-- Title, with a spinner while the switch runs (kind 1) -->
+        <lv_obj name="ad5x_ifs_fw_title_row"
+                width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
+                style_bg_opa="0" style_border_width="0" scrollable="false">
+          <bind_style_if_eq name="pad_micro" subject="ui_breakpoint" ref_value="0"/>
+          <bind_style_if_ge name="pad_standard" subject="ui_breakpoint" ref_value="1"/>
+          <spinner size="sm">
+            <bind_flag_if_not_eq subject="ad5x_ifs_fw_kind" flag="hidden" ref_value="1"/>
+          </spinner>
+          <icon src="check_circle" size="xs" variant="success">
+            <bind_flag_if_not_eq subject="ad5x_ifs_fw_kind" flag="hidden" ref_value="2"/>
+          </icon>
+          <icon src="alert" size="xs" variant="warning">
+            <bind_flag_if_not_eq subject="ad5x_ifs_fw_kind" flag="hidden" ref_value="3"/>
+          </icon>
+          <text_body name="ad5x_ifs_fw_title" width="0" flex_grow="1" bind_text="ad5x_ifs_fw_title" long_mode="wrap"/>
+        </lv_obj>
+        <!-- What the IFS runs, the phase, the result or why the switch is off -->
+        <lv_obj name="ad5x_ifs_fw_body_row"
+                width="100%" height="content" style_bg_opa="0" style_border_width="0" scrollable="false">
+          <bind_style_if_eq name="pad_micro" subject="ui_breakpoint" ref_value="0"/>
+          <bind_style_if_ge name="pad_standard" subject="ui_breakpoint" ref_value="1"/>
+          <text_small name="ad5x_ifs_fw_body" width="100%" bind_text="ad5x_ifs_fw_body" long_mode="wrap">
+            <bind_style_if_eq name="text_failed" subject="ad5x_ifs_fw_kind" ref_value="3"/>
+          </text_small>
+        </lv_obj>
+        <!-- The switch to the other firmware (both when the IFS answers neither), or OK after the result -->
+        <lv_obj name="ad5x_ifs_fw_buttons_row"
+                width="100%" height="content" flex_flow="row_wrap" style_flex_main_place="end" style_pad_gap="#space_md"
+                style_bg_opa="0" style_border_width="0" scrollable="false">
+          <bind_style_if_eq name="pad_micro" subject="ui_breakpoint" ref_value="0"/>
+          <bind_style_if_ge name="pad_standard" subject="ui_breakpoint" ref_value="1"/>
+          <bind_flag_if cond="ad5x_ifs_fw_offer_stock eq 0 and ad5x_ifs_fw_offer_klipper eq 0 and ad5x_ifs_fw_ok eq 0"
+                        flag="hidden"/>
+          <ui_button name="btn_ad5x_ifs_fw_stock"
+                     width="content" height="#button_height_sm" style_min_width="160" text="Switch to Stock" variant="primary">
+            <bind_flag_if_eq subject="ad5x_ifs_fw_offer_stock" flag="hidden" ref_value="0"/>
+            <bind_state_if_eq subject="ad5x_ifs_fw_choice_enabled" state="disabled" ref_value="0"/>
+            <event_cb trigger="clicked" callback="on_ad5x_ifs_fw_stock"/>
+          </ui_button>
+          <ui_button name="btn_ad5x_ifs_fw_klipper"
+                     width="content" height="#button_height_sm" style_min_width="160" text="Switch to Klipper" variant="primary">
+            <bind_flag_if_eq subject="ad5x_ifs_fw_offer_klipper" flag="hidden" ref_value="0"/>
+            <bind_state_if_eq subject="ad5x_ifs_fw_choice_enabled" state="disabled" ref_value="0"/>
+            <event_cb trigger="clicked" callback="on_ad5x_ifs_fw_klipper"/>
+          </ui_button>
+          <ui_button name="btn_ad5x_ifs_fw_ok"
+                     width="content" height="#button_height_sm" style_min_width="120" text="OK" variant="primary">
+            <bind_flag_if_eq subject="ad5x_ifs_fw_ok" flag="hidden" ref_value="0"/>
+            <event_cb trigger="clicked" callback="on_ad5x_ifs_fw_ok"/>
+          </ui_button>
+        </lv_obj>
+      </setting_group>
+    </lv_obj>
+  </view>
+</component>
