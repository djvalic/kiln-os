diff --git a/include/ad5x_ifs_firmware_view.h b/include/ad5x_ifs_firmware_view.h
new file mode 100644
index 0000000..9ac3a53
--- /dev/null
+++ b/include/ad5x_ifs_firmware_view.h
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+/**
+ * @file ad5x_ifs_firmware_view.h
+ * @brief What Settings > Devices > IFS firmware shows, from the switch's status
+ *
+ * Kiln OS switches the AD5X IFS (filament unit) between Flashforge's stock
+ * firmware and Klipper firmware: POST /server/kiln/ifs_firmware with a target
+ * asks Moonraker's kiln component, and through it the root agent, which stops
+ * Klipper, flashes, and starts Klipper again; GET serves the agent's status
+ * file, also while Klipper is down. Klipper publishes `printer.ifs_firmware`
+ * (firmware, switching, last). These functions turn that into the screen's
+ * text and buttons; they need neither LVGL nor a printer.
+ *
+ * @threading Pure functions; the translator hook is set once from the main thread
+ */
+
+#include <string>
+
+namespace helix::ad5x_ifs_firmware {
+
+/// The switch as the screen knows it.
+struct IfsFirmwareStatus {
+    std::string firmware;    ///< printer.ifs_firmware.firmware: stock, klipper, unknown
+    bool switching = false;  ///< printer.ifs_firmware.switching
+    std::string print_state; ///< print_stats.state
+    /// A switch was requested from this screen and its result not dismissed yet
+    bool following = false;
+    // The status file (Moonraker, or printer.ifs_firmware.last)
+    std::string target;  ///< stock, klipper
+    std::string state;   ///< running, done, failed, refused; none without a file
+    std::string phase;   ///< checking, stopping, writing, replug, verifying, starting, finished
+    std::string message; ///< One line for people
+    std::string version; ///< What the IFS answered; may be empty
+};
+
+enum class IfsFirmwareViewKind {
+    Choose = 0,   ///< The firmware now and the switch to the other one
+    Progress = 1, ///< A switch runs, or Klipper is starting after it
+    Done = 2,     ///< The switch worked
+    Failed = 3,   ///< Failed, refused, or Klipper did not come back
+};
+
+struct IfsFirmwareView {
+    IfsFirmwareViewKind kind = IfsFirmwareViewKind::Choose;
+    std::string title;
+    std::string body;            ///< May hold several lines
+    bool offer_stock = false;    ///< "Switch to Stock" shows
+    bool offer_klipper = false;  ///< "Switch to Klipper" shows
+    bool choice_enabled = false; ///< The offered switch can be tapped (not during a print)
+    bool ok = false;             ///< OK shows: back to the choice
+};
+
+/// How long Klipper (or the agent) may stay silent after a request.
+inline constexpr int kWaitLimitSeconds = 180;
+
+/// The screen for @p status. @p seconds_waiting counts from the request, or
+/// from the last answer saying the switch runs; past kWaitLimitSeconds the
+/// screen stops waiting.
+IfsFirmwareView ifs_firmware_view(const IfsFirmwareStatus& status, bool klipper_ready,
+                                  int seconds_waiting);
+
+/// The confirm dialog before a switch to @p target (stock, klipper).
+struct IfsFirmwareConfirm {
+    std::string title;
+    std::string body;
+    std::string button;
+};
+IfsFirmwareConfirm ifs_firmware_confirm(const std::string& target);
+
+/// The Devices row's value: "Stock", "Klipper", else "Unknown".
+std::string ifs_firmware_label(const std::string& firmware);
+
+/// Translates the English texts above (lv_tr on the screen); none: English.
+using Translator = const char* (*)(const char*);
+void set_translator(Translator tr);
+
+} // namespace helix::ad5x_ifs_firmware
