@@ -0,0 +1,523 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "ui_settings_ad5x_ifs_firmware.h"
+
+#include "ui_callback_helpers.h"
+#include "ui_emergency_stop.h"
+#include "ui_modal.h"
+#include "ui_update_queue.h"
+
+#include "app_globals.h"
+#include "i_moonraker_api.h"
+#include "i_moonraker_client.h"
+#include "json_utils.h"
+#include "lvgl/src/others/translation/lv_translation.h"
+#include "observer_factory.h"
+#include "printer_state.h"
+
+#include <spdlog/spdlog.h>
+
+#include <algorithm>
+
+namespace helix::ad5x_ifs_firmware {
+
+namespace {
+
+constexpr const char* kObject = "ifs_firmware";
+// /server/kiln/ifs_firmware takes GET and POST, so Moonraker names its JSON-RPC
+// methods after the request type: the agent's status file, and the switch request
+constexpr const char* kStatusMethod = "server.kiln.get_ifs_firmware";
+constexpr const char* kSwitchMethod = "server.kiln.post_ifs_firmware";
+constexpr uint32_t kPollMs = 1000;
+constexpr uint32_t kPollTimeoutMs = 5000;
+
+const char* translate(const char* english) {
+    return lv_tr(english);
+}
+
+} // namespace
+
+namespace {
+// lv_tick: the validator and the overlay both run on the LVGL main thread
+uint32_t g_expect_since = 0;
+uint32_t g_expect_for = 0;
+} // namespace
+
+void expect_hardware_change(uint32_t ms) {
+    g_expect_since = lv_tick_get();
+    g_expect_for = ms;
+}
+
+void clear_expected_hardware_change() {
+    g_expect_for = 0;
+}
+
+bool hardware_change_expected() {
+    return g_expect_for != 0 && lv_tick_elaps(g_expect_since) < g_expect_for;
+}
+
+bool available() {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api) {
+        return false;
+    }
+    const auto& objects = api->hardware().printer_objects();
+    return std::find(objects.begin(), objects.end(), kObject) != objects.end();
+}
+
+// ============================================================================
+// MODEL
+// ============================================================================
+
+Ad5xIfsFirmwareModel::~Ad5xIfsFirmwareModel() {
+    lifetime_.invalidate();
+    subscription_.reset();
+    klippy_observer_.reset();
+    subjects_.deinit_all();
+}
+
+void Ad5xIfsFirmwareModel::init_subjects() {
+    if (subjects_initialized_) {
+        return;
+    }
+    // The Devices row's value: "Stock", "Klipper", "Unknown"; empty until the object answered
+    UI_MANAGED_SUBJECT_STRING(text_, text_buf_, "", "ad5x_ifs_firmware_text", subjects_);
+    subjects_initialized_ = true;
+}
+
+void Ad5xIfsFirmwareModel::start() {
+    if (!started_) {
+        IMoonrakerAPI* api = get_moonraker_api();
+        if (api) {
+            started_ = true;
+            const auto token = lifetime_.token();
+            // Runs on the WebSocket thread: copy the object out, apply it on the main thread.
+            const SubscriptionId id = api->subscribe_notifications([this, token](const json& note) {
+                const json* params = json_util::find_member(note, "params");
+                if (!params || !params->is_array() || params->empty()) {
+                    return;
+                }
+                const json* obj = json_util::find_member((*params)[0], kObject);
+                if (!obj || !obj->is_object()) {
+                    return;
+                }
+                json delta = *obj;
+                token.defer("Ad5xIfsFirmwareModel::status_update", [this, delta]() {
+                    // Deltas only patch a full object; the query in flight brings one
+                    if (loaded_) {
+                        merge(delta);
+                    }
+                });
+            });
+            subscription_ = SubscriptionGuard(api, id);
+
+            // A switch stops and starts Klipper: the object comes back with the result.
+            klippy_observer_ = ui::observe<int>(
+                get_printer_state().network_state().get_klippy_state_subject(), this,
+                [](Ad5xIfsFirmwareModel* self, int state) {
+                    const bool ready = static_cast<KlippyState>(state) == KlippyState::READY;
+                    if (ready == self->klippy_ready_) {
+                        return;
+                    }
+                    self->klippy_ready_ = ready;
+                    if (ready) {
+                        self->query();
+                    } else {
+                        self->loaded_ = false;
+                    }
+                    self->notify();
+                },
+                get_printer_state().get_subjects_lifetime());
+        }
+    }
+    query();
+}
+
+void Ad5xIfsFirmwareModel::query() {
+    IMoonrakerClient* client = get_moonraker_client();
+    if (!client || client->get_connection_state() != ConnectionState::CONNECTED) {
+        return;
+    }
+    const auto token = lifetime_.token();
+    json params = {{"objects", {{kObject, nullptr}}}};
+    client->send_jsonrpc(
+        "printer.objects.query", params,
+        [this, token](const json& response) {
+            const json* result = json_util::find_member(response, "result");
+            const json* status = result ? json_util::find_member(*result, "status") : nullptr;
+            const json* obj = status ? json_util::find_member(*status, kObject) : nullptr;
+            if (!obj || !obj->is_object()) {
+                return;
+            }
+            json full = *obj;
+            token.defer("Ad5xIfsFirmwareModel::status_query", [this, full]() {
+                loaded_ = true;
+                merge(full);
+            });
+        },
+        [](const MoonrakerError& err) {
+            spdlog::debug("[AD5X IFS firmware] {} query failed: {}", kObject, err.message);
+        },
+        0, /*silent=*/true);
+}
+
+void Ad5xIfsFirmwareModel::merge(const json& obj) {
+    if (const json* fw = json_util::find_member(obj, "firmware")) {
+        status_.firmware = json_util::as_string(*fw);
+    }
+    if (const json* sw = json_util::find_member(obj, "switching")) {
+        status_.switching = json_util::as_bool(*sw);
+    }
+    if (const json* last = json_util::find_member(obj, "last"); last && last->is_object()) {
+        // Klipper sends the whole `last` dict whenever one of its fields changes
+        status_.target = json_util::safe_string(*last, "target");
+        status_.state = json_util::safe_string(*last, "state");
+        status_.phase = json_util::safe_string(*last, "phase");
+        status_.message = json_util::safe_string(*last, "message");
+        status_.version = json_util::safe_string(*last, "version");
+    }
+    if (subjects_initialized_) {
+        const std::string label = ifs_firmware_label(status_.firmware);
+        lv_subject_copy_string(&text_, lv_tr(label.c_str()));
+    }
+    notify();
+}
+
+void Ad5xIfsFirmwareModel::set_listener(std::function<void()> listener) {
+    listener_ = std::move(listener);
+}
+
+void Ad5xIfsFirmwareModel::notify() {
+    // A copy: the listener may replace itself
+    if (auto listener = listener_) {
+        listener();
+    }
+}
+
+Ad5xIfsFirmwareModel& model() {
+    return helix::lazy_global<Ad5xIfsFirmwareModel>("Ad5xIfsFirmwareModel");
+}
+
+} // namespace helix::ad5x_ifs_firmware
+
+// ============================================================================
+// OVERLAY
+// ============================================================================
+
+namespace helix::settings {
+
+namespace fw = helix::ad5x_ifs_firmware;
+
+Ad5xIfsFirmwareOverlay::~Ad5xIfsFirmwareOverlay() {
+    stop_polling();
+    deinit_subjects();
+}
+
+void Ad5xIfsFirmwareOverlay::init_subjects() {
+    init_subjects_guarded([this]() {
+        fw::set_translator(&fw::translate);
+        // fw::IfsFirmwareViewKind: the spinner, the colours
+        UI_MANAGED_SUBJECT_INT(kind_subject_, 0, "ad5x_ifs_fw_kind", subjects_);
+        UI_MANAGED_SUBJECT_STRING(title_subject_, title_buf_, "", "ad5x_ifs_fw_title", subjects_);
+        UI_MANAGED_SUBJECT_STRING(body_subject_, body_buf_, "", "ad5x_ifs_fw_body", subjects_);
+        UI_MANAGED_SUBJECT_INT(offer_stock_subject_, 0, "ad5x_ifs_fw_offer_stock", subjects_);
+        UI_MANAGED_SUBJECT_INT(offer_klipper_subject_, 0, "ad5x_ifs_fw_offer_klipper", subjects_);
+        UI_MANAGED_SUBJECT_INT(choice_enabled_subject_, 0, "ad5x_ifs_fw_choice_enabled",
+                               subjects_);
+        UI_MANAGED_SUBJECT_INT(ok_subject_, 0, "ad5x_ifs_fw_ok", subjects_);
+    });
+}
+
+void Ad5xIfsFirmwareOverlay::deinit_subjects() {
+    deinit_subjects_base(subjects_);
+}
+
+void Ad5xIfsFirmwareOverlay::register_callbacks() {
+    register_xml_callbacks({
+        {"on_ad5x_ifs_fw_stock",
+         [](lv_event_t*) { get_ad5x_ifs_firmware_overlay().handle_switch("stock"); }},
+        {"on_ad5x_ifs_fw_klipper",
+         [](lv_event_t*) { get_ad5x_ifs_firmware_overlay().handle_switch("klipper"); }},
+        {"on_ad5x_ifs_fw_ok", [](lv_event_t*) { get_ad5x_ifs_firmware_overlay().handle_ok(); }},
+    });
+}
+
+void Ad5xIfsFirmwareOverlay::on_activate() {
+    OverlayBase::on_activate();
+
+    auto& m = fw::model();
+    m.start();
+    m.set_listener([this]() {
+        const auto& s = fw::model().status();
+        if (!s.state.empty()) {
+            note_file(s.state, s.phase, s.message, s.target, s.version);
+        }
+        refresh();
+    });
+
+    print_observer_ = ui::observe<const char*>(
+        get_printer_state().print_state().get_print_state_subject(), this,
+        [](Ad5xIfsFirmwareOverlay* self, const char*) { self->refresh(); },
+        get_printer_state().print_state().get_static_subjects_lifetime());
+
+    refresh();
+}
+
+void Ad5xIfsFirmwareOverlay::on_deactivating(DeactivateReason /*reason*/) {
+    // A switch keeps running without the screen; reopening (or waking) follows it again
+    fw::model().set_listener(nullptr);
+    print_observer_.reset();
+    stop_polling();
+    poll_in_flight_ = false;
+}
+
+// ============================================================================
+// STATUS
+// ============================================================================
+
+fw::IfsFirmwareStatus Ad5xIfsFirmwareOverlay::effective_status() const {
+    fw::IfsFirmwareStatus s = fw::model().status();
+    if (have_file_) {
+        s.state = file_state_;
+        s.phase = file_phase_;
+        s.message = file_message_;
+        s.target = file_target_;
+        s.version = file_version_;
+    }
+    // RAW_PRINT_STATE_OK: print_stats.state as Moonraker's request and the agent test it
+    s.print_state =
+        lv_subject_get_string(get_printer_state().print_state().get_print_state_subject());
+    s.following = following_;
+    if (!refusal_.empty()) {
+        s.state = "refused";
+        s.phase = "finished";
+        s.message = refusal_;
+        s.target = requested_target_;
+        s.version.clear();
+    } else if (pending_ || command_in_flight_) {
+        // The file still shows the switch before this one
+        s.state = "running";
+        s.phase = "checking";
+        s.target = requested_target_;
+        s.message.clear();
+        s.version.clear();
+    }
+    return s;
+}
+
+int Ad5xIfsFirmwareOverlay::seconds_waiting() const {
+    if (alive_at_ == std::chrono::steady_clock::time_point{}) {
+        return 0;
+    }
+    return static_cast<int>(std::chrono::duration_cast<std::chrono::seconds>(
+                                std::chrono::steady_clock::now() - alive_at_)
+                                .count());
+}
+
+void Ad5xIfsFirmwareOverlay::mark_alive() {
+    alive_at_ = std::chrono::steady_clock::now();
+}
+
+void Ad5xIfsFirmwareOverlay::note_file(const std::string& state, const std::string& phase,
+                                       const std::string& message, const std::string& target,
+                                       const std::string& version) {
+    have_file_ = true;
+    file_state_ = state;
+    file_phase_ = phase;
+    file_message_ = message;
+    file_target_ = target;
+    file_version_ = version;
+    if (pending_ && (state == "running" || state != sent_state_ || message != sent_message_ ||
+                     target != sent_target_ || version != sent_version_)) {
+        pending_ = false;
+    }
+    if (state == "running") {
+        mark_alive();
+        // Klipper is stopped on purpose for the switch: no "Klipper disconnected" dialog
+        // while the agent says it runs. Klipper's own start after it is still covered for
+        // the LONG window; a Klipper that stays away is reported by the view.
+        EmergencyStopOverlay::instance().suppress_recovery_dialog(
+            helix::recovery_suppression::LONG);
+    }
+}
+
+void Ad5xIfsFirmwareOverlay::refresh() {
+    if (!subjects_initialized_) {
+        return;
+    }
+    const fw::IfsFirmwareView v =
+        fw::ifs_firmware_view(effective_status(), fw::model().klippy_ready(), seconds_waiting());
+    lv_subject_set_int(&kind_subject_, static_cast<int>(v.kind));
+    lv_subject_copy_string(&title_subject_, v.title.c_str());
+    lv_subject_copy_string(&body_subject_, v.body.c_str());
+    lv_subject_set_int(&offer_stock_subject_, v.offer_stock ? 1 : 0);
+    lv_subject_set_int(&offer_klipper_subject_, v.offer_klipper ? 1 : 0);
+    lv_subject_set_int(&choice_enabled_subject_,
+                       v.choice_enabled && !command_in_flight_ && !following_ ? 1 : 0);
+    lv_subject_set_int(&ok_subject_, v.ok ? 1 : 0);
+
+    if (v.kind == fw::IfsFirmwareViewKind::Progress && visible_) {
+        start_polling();
+    } else {
+        stop_polling();
+    }
+}
+
+// ============================================================================
+// POLLING
+// ============================================================================
+
+void Ad5xIfsFirmwareOverlay::start_polling() {
+    if (poll_timer_) {
+        return;
+    }
+    poll_timer_.reset(lv_timer_create(
+        [](lv_timer_t* t) {
+            auto* self = static_cast<Ad5xIfsFirmwareOverlay*>(lv_timer_get_user_data(t));
+            // Klipper is stopped and started on purpose: no recovery dialog while this
+            // screen follows the switch, until Klipper is back (the view stops polling
+            // then) or the wait limit gives up
+            if (self->following_) {
+                EmergencyStopOverlay::instance().suppress_recovery_dialog(
+                    helix::recovery_suppression::LONG);
+            }
+            self->poll();
+            // Also the clock for the wait limit when no answer comes
+            self->refresh();
+        },
+        fw::kPollMs, this));
+    poll();
+}
+
+void Ad5xIfsFirmwareOverlay::stop_polling() {
+    poll_timer_.reset();
+}
+
+void Ad5xIfsFirmwareOverlay::poll() {
+    IMoonrakerClient* client = get_moonraker_client();
+    if (poll_in_flight_ || !client ||
+        client->get_connection_state() != ConnectionState::CONNECTED) {
+        return;
+    }
+    poll_in_flight_ = true;
+    const auto token = lifetime_.token();
+    client->send_jsonrpc(
+        fw::kStatusMethod, json::object(),
+        [this, token](const json& response) {
+            const json* result = json_util::find_member(response, "result");
+            json copy = result && result->is_object() ? *result : json::object();
+            token.defer("Ad5xIfsFirmwareOverlay::poll_done", [this, copy]() {
+                poll_in_flight_ = false;
+                apply_poll(copy);
+                refresh();
+            });
+        },
+        [this, token](const MoonrakerError& err) {
+            spdlog::debug("[AD5X IFS firmware] {} failed: {}", fw::kStatusMethod, err.message);
+            token.defer("Ad5xIfsFirmwareOverlay::poll_error",
+                        [this]() { poll_in_flight_ = false; });
+        },
+        fw::kPollTimeoutMs, /*silent=*/true);
+}
+
+void Ad5xIfsFirmwareOverlay::apply_poll(const json& result) {
+    const std::string state = json_util::safe_string(result, "state");
+    if (state.empty()) {
+        return;
+    }
+    note_file(state, json_util::safe_string(result, "phase"),
+              json_util::safe_string(result, "message"), json_util::safe_string(result, "target"),
+              json_util::safe_string(result, "version"));
+}
+
+// ============================================================================
+// COMMANDS
+// ============================================================================
+
+void Ad5xIfsFirmwareOverlay::handle_switch(const std::string& target) {
+    if ((target != "stock" && target != "klipper") || command_in_flight_ || following_) {
+        return;
+    }
+    const fw::IfsFirmwareView v =
+        fw::ifs_firmware_view(effective_status(), fw::model().klippy_ready(), seconds_waiting());
+    const bool offered = target == "stock" ? v.offer_stock : v.offer_klipper;
+    if (v.kind != fw::IfsFirmwareViewKind::Choose || !offered || !v.choice_enabled) {
+        return;
+    }
+    const fw::IfsFirmwareConfirm c = fw::ifs_firmware_confirm(target);
+    helix::ui::ConfirmOptions opts;
+    opts.owner_token = object_lifetime_.token();
+    helix::ui::modal_confirm(c.title.c_str(), c.body.c_str(), ModalSeverity::Warning,
+                             c.button.c_str(), [this, target]() { send(target); }, opts);
+}
+
+void Ad5xIfsFirmwareOverlay::send(const std::string& target) {
+    IMoonrakerClient* client = get_moonraker_client();
+    requested_target_ = target;
+    following_ = true;
+    refusal_.clear();
+    if (!client || client->get_connection_state() != ConnectionState::CONNECTED) {
+        refused(lv_tr("Not connected to the printer"));
+        return;
+    }
+    // What the file says now: the request has started once it says anything else
+    const fw::IfsFirmwareStatus before = effective_status();
+    sent_state_ = before.state;
+    sent_message_ = before.message;
+    sent_target_ = before.target;
+    sent_version_ = before.version;
+    pending_ = true;
+    command_in_flight_ = true;
+    mark_alive();
+    spdlog::info("[AD5X IFS firmware] {} target={}", fw::kSwitchMethod, target);
+    refresh();
+
+    // The agent stops Klipper about a second after the request, before the first
+    // poll can say the switch runs: suppress the recovery dialog from here on
+    EmergencyStopOverlay::instance().suppress_recovery_dialog(helix::recovery_suppression::LONG);
+    // Klipper comes back with or without `mcu ifs` and Happy Hare's objects: not a
+    // "hardware missing" notice (10 minutes also cover turning Happy Hare on after)
+    fw::expect_hardware_change(10 * 60 * 1000);
+
+    // The object's lifetime, not the screen's: a refusal is still shown after a reopen
+    const auto token = object_lifetime_.token();
+    client->send_jsonrpc(
+        fw::kSwitchMethod, json{{"target", target}},
+        [this, token](const json& response) {
+            const json* result = json_util::find_member(response, "result");
+            json copy = result && result->is_object() ? *result : json::object();
+            token.defer("Ad5xIfsFirmwareOverlay::request_done", [this, copy]() {
+                command_in_flight_ = false;
+                mark_alive();
+                apply_poll(copy);
+                refresh();
+            });
+        },
+        [this, token](const MoonrakerError& err) {
+            // "not while printing", "a switch is already running", ...
+            std::string message = err.message.empty() ? "request failed" : err.message;
+            token.defer("Ad5xIfsFirmwareOverlay::request_error",
+                        [this, message]() { refused(message); });
+        },
+        0, /*silent=*/true);
+}
+
+void Ad5xIfsFirmwareOverlay::refused(const std::string& message) {
+    spdlog::info("[AD5X IFS firmware] request refused: {}", message);
+    command_in_flight_ = false;
+    pending_ = false;
+    refusal_ = message;
+    fw::clear_expected_hardware_change();
+    refresh();
+}
+
+void Ad5xIfsFirmwareOverlay::handle_ok() {
+    following_ = false;
+    pending_ = false;
+    refusal_.clear();
+    alive_at_ = {};
+    fw::model().query();
+    refresh();
+}
+
+} // namespace helix::settings
