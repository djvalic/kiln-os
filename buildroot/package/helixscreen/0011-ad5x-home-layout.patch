+        REQUIRE(c.label.empty());
+        REQUIRE_FALSE(c.lock_while_printing);
+        auto j = favorite_macro_config_to_json(c);
+        REQUIRE_FALSE(j.contains("label"));
+        REQUIRE_FALSE(j.contains("lock_while_printing"));
+    }
+    SECTION("round trip") {
+        nlohmann::json in{{"macro", "UNLOAD_FILAMENT"},
+                          {"icon", "eject"},
+                          {"label", "Unload"},
+                          {"lock_while_printing", true}};
+        auto c = favorite_macro_config_from_json(in);
+        REQUIRE(c.label == "Unload");
+        REQUIRE(c.lock_while_printing);
+        REQUIRE(favorite_macro_config_to_json(c) == in);
+    }
+    SECTION("wrong types fall back to the defaults") {
+        auto c = favorite_macro_config_from_json(
+            nlohmann::json{{"label", 3}, {"lock_while_printing", "yes"}});
+        REQUIRE(c.label.empty());
+        REQUIRE_FALSE(c.lock_while_printing);
+    }
+}
