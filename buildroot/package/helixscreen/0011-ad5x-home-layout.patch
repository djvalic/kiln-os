+// ============================================================================
+// The AD5X preset's home seed (assets/config/panel_widgets/ad5x/home.json)
+// ============================================================================
+
+namespace {
+
+nlohmann::json load_ad5x_seed() {
+    std::ifstream in(helix::find_readable("panel_widgets/ad5x/home.json"));
+    REQUIRE(in.is_open());
+    return nlohmann::json::parse(in);
+}
+
+} // namespace
+
+TEST_CASE("default_layout: the ad5x seed fills the 800x480 grid",
+          "[default_layout][shipped][ad5x]") {
+    const auto layout = load_shipped_layout();
+    const auto seed = load_ad5x_seed();
+    CapabilitySnapshot open = all_closed(layout);
+    for (const auto& s : helix::layout::subjects_named_by(seed)) {
+        open.subjects[s] = 0;
+    }
+    for (auto& [subject, value] : open.subjects) {
+        value = subject == "ams_slot_count" ? 4 : 1;
+    }
+    open.subjects["ams_is_tool_changer"] = 0;
+    CapabilitySnapshot no_ams = open;
+    no_ams.subjects["ams_slot_count"] = 0;
+
+    for (const CapabilitySnapshot* caps : {&open, &no_ams}) {
+        INFO((caps == &open ? "IFS" : "no IFS"));
+        const ResolvedDefault r = helix::layout::resolve_default_layout(
+            layout, &seed, "medium", 12, 8, {}, "ad5x", *caps);
+        REQUIRE(r.ok);
+        CHECK(r.signature.find("|ad5x#") != std::string::npos);
+
+        std::set<std::pair<int, int>> owned;
+        for (const auto& p : r.placed) {
+            const auto* def = helix::find_widget_def(p.id);
+            INFO("widget " << p.id << " at (" << p.col << "," << p.row << ") " << p.colspan << "x"
+                           << p.rowspan);
+            REQUIRE(def != nullptr);
+            CHECK(p.colspan >= def->effective_min_colspan());
+            CHECK(p.colspan <= def->effective_max_colspan());
+            CHECK(p.rowspan >= def->effective_min_rowspan());
+            CHECK(p.rowspan <= def->effective_max_rowspan());
+            CHECK(p.col + p.colspan <= 12);
+            CHECK(p.row + p.rowspan <= 8);
+            for (int row = p.row; row < p.row + p.rowspan; ++row) {
+                for (int col = p.col; col < p.col + p.colspan; ++col) {
+                    CHECK(owned.insert({col, row}).second);
+                }
+            }
+        }
+        if (caps == &open) {
+            CHECK(owned.size() == 96u);
+            const auto* ams = placed_widget(r, "ams");
+            REQUIRE(ams);
+            CHECK((ams->col == 8 && ams->row == 2 && ams->colspan == 4 && ams->rowspan == 2));
+            // The light under Preheat, from its own slot.
+            const auto* led = placed_widget(r, "led");
+            REQUIRE(led);
+            CHECK((led->col == 8 && led->row == 5 && led->colspan == 2 && led->rowspan == 1));
+        }
+
+        const auto* ps = placed_widget(r, "print_status");
+        REQUIRE(ps);
+        CHECK((ps->col == 0 && ps->row == 2 && ps->colspan == 8 && ps->rowspan == 6));
+        CHECK(ps->config.value("layout_style", "") == "detailed");
+        CHECK(ps->config.value("show_temps", true) == false);
+        const auto* preheat = placed_widget(r, "preheat");
+        REQUIRE(preheat);
+        CHECK((preheat->col == 8 && preheat->row == 4 && preheat->colspan == 4 &&
+               preheat->rowspan == 1));
+        const auto* z = placed_widget(r, "z_offset");
+        REQUIRE(z);
+        CHECK((z->col == 10 && z->row == 5 && z->colspan == 2 && z->rowspan == 1));
+        CHECK(preheat->config.value("show_temps", true) == false);
+        CHECK(preheat->config.value("lock_while_printing", false) == true);
+        const auto* unload = placed_widget(r, "favorite_macro");
+        REQUIRE(unload);
+        CHECK(unload->config.value("macro", "") == "UNLOAD_FILAMENT");
+        CHECK(unload->config.value("label", "") == "Unload");
+        CHECK(unload->config.value("lock_while_printing", false) == true);
+        for (const char* id : {"temperature", "bed_temperature", "fan_stack", "notifications",
+                               "preheat", "motion", "favorite_macro"}) {
+            INFO("widget " << id);
+            CHECK(placed_widget(r, id) != nullptr);
+        }
+        for (const char* id : {"printer_image", "temp_graph", "tips"}) {
+            INFO("widget " << id);
+            CHECK(placed_widget(r, id) == nullptr);
+            CHECK(resolved_disabled(r, id));
+        }
+    }
+}
+
+TEST_CASE("default_layout: the ad5x seed leaves every other grid as shipped",
+          "[default_layout][shipped][ad5x]") {
+    const auto layout = load_shipped_layout();
+    const auto seed = load_ad5x_seed();
+    CapabilitySnapshot open = all_closed(layout);
+    for (auto& [subject, value] : open.subjects) {
+        value = subject == "ams_slot_count" ? 4 : 1;
+    }
+    open.subjects["ams_is_tool_changer"] = 0;
+
+    for (const auto& g : helix::test::kMeasuredGrids) {
+        LayoutTypeGuard layout_type(g.panel_w, g.panel_h);
+        const std::vector<std::string> chain = helix::LayoutManager::instance().variant_chain();
+        const int bp = static_cast<int>(breakpoint_for(std::min(g.panel_w, g.panel_h)));
+        if (std::string(kBpNames[bp]) == "medium" && g.cols == 12 && g.rows == 8 && chain.empty()) {
+            continue;
+        }
+        INFO(g.name << " (" << kBpNames[bp] << " " << g.cols << "x" << g.rows << ")");
+        const ResolvedDefault with = helix::layout::resolve_default_layout(
+            layout, &seed, kBpNames[bp], g.cols, g.rows, chain, "ad5x", open);
+        const ResolvedDefault without = helix::layout::resolve_default_layout(
+            layout, nullptr, kBpNames[bp], g.cols, g.rows, chain, "ad5x", open);
+        REQUIRE(with.placed.size() == without.placed.size());
+        for (size_t i = 0; i < with.placed.size(); ++i) {
+            const auto& a = with.placed[i];
+            const auto& b = without.placed[i];
+            INFO("entry " << i << ": " << a.id << " vs " << b.id);
+            CHECK(a.id == b.id);
+            CHECK(a.col == b.col);
+            CHECK(a.row == b.row);
+            CHECK(a.colspan == b.colspan);
+            CHECK(a.rowspan == b.rowspan);
+            CHECK(a.config == b.config);
+        }
+        CHECK(with.disabled == without.disabled);
+    }
+}
