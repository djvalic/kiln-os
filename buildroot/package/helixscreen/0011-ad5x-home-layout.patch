diff --git a/src/system/default_layout_resolver.cpp b/src/system/default_layout_resolver.cpp
index a067d54..fff21c0 100644
--- a/src/system/default_layout_resolver.cpp
+++ b/src/system/default_layout_resolver.cpp
@@ -473,9 +473,19 @@ ResolvedDefault resolve_default_layout(const json& table, const json* overlay,
                                        const std::vector<std::string>& variant_chain,
                                        std::string_view preset, const CapabilitySnapshot& caps) {
     ResolvedDefault out;
+    // A seed's "revision" joins the preset in the signature, so a shipped seed
+    // that changes its arrangement re-resolves every default that is still
+    // unedited (reresolve_default_if_changed); an edited layout keeps its own.
+    std::string seed_key(preset);
+    if (overlay && overlay->is_object()) {
+        const std::string revision = ju::safe_string(*overlay, "revision");
+        if (!revision.empty()) {
+            seed_key += '#' + revision;
+        }
+    }
     const int bp = breakpoint_from_name(std::string(tier).c_str());
     if (!table.is_object() || bp < 0) {
-        out.signature = make_signature(tier, cols, rows, variant_chain, preset, {});
+        out.signature = make_signature(tier, cols, rows, variant_chain, seed_key, {});
         return out;
     }
 
@@ -531,7 +541,7 @@ ResolvedDefault resolve_default_layout(const json& table, const json* overlay,
 
     out.placed = r.take_placed();
     out.disabled = r.disabled();
-    out.signature = make_signature(tier, cols, rows, variant_chain, preset, r.consulted());
+    out.signature = make_signature(tier, cols, rows, variant_chain, seed_key, r.consulted());
     out.ok = !out.placed.empty();
     spdlog::debug("[DefaultLayoutResolver] tier={} grid={}x{} table={} placed={} disabled={} "
                   "signature={}",
