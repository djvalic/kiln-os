+    reset_touch_keys();
+
+    SECTION("the report's range: refused, the kernel's range applies, calibration asked for") {
+        write_stored_range(cfg, reported_damaged());
+        set_declared_touch_range(declared_4095());
+        CHECK_FALSE(load_touch_range().valid);
+        // The kernel's range with the board's default may be upside down, so
+        // the calibration opens at this start (Application reads the flag
+        // after the display is up, and clears it on success)
+        CHECK(cfg->get<bool>("/input/force_calibration", false));
+    }
+    SECTION("normal ranges load, inverted ones included") {
+        set_declared_touch_range(declared_4095());
+        for (const TouchRangeSettings& r :
+             {range_of(150, 3900, 3608, 591), range_of(4000, 90, 3900, 120),
+              range_of(150, 3900, 591, 3608, true)}) {
+            write_stored_range(cfg, r);
+            const TouchRangeSettings got = load_touch_range();
+            CHECK(got.valid);
+            CHECK(same_range(got, r));
+        }
+        CHECK_FALSE(cfg->get<bool>("/input/force_calibration", false));
+    }
+    SECTION("a range a calibration saved on a panel emitting past its range loads next start") {
+        // No loop: what a range fit saves on such a panel is not refused
+        set_declared_touch_range(declared_4095());
+        write_stored_range(cfg, range_of(-2000, 9000, 7000, -1500));
+        CHECK(load_touch_range().valid);
+        CHECK_FALSE(cfg->get<bool>("/input/force_calibration", false));
+    }
+    SECTION("an unknown device range judges nothing (upstream's behaviour)") {
+        write_stored_range(cfg, reported_damaged());
+        CHECK(load_touch_range().valid);
+        CHECK_FALSE(cfg->get<bool>("/input/force_calibration", false));
+    }
+    SECTION("a degenerate range is still refused, as upstream (no forced calibration)") {
+        write_stored_range(cfg, range_of(500, 500, 591, 3608));
+        set_declared_touch_range(declared_4095());
+        CHECK_FALSE(load_touch_range().valid);
+        CHECK_FALSE(cfg->get<bool>("/input/force_calibration", false));
+    }
+    SECTION("the affine check reads quietly: only the backend's load asks") {
+        write_stored_range(cfg, reported_damaged());
+        set_declared_touch_range(declared_4095());
+        cfg->set<bool>("/input/calibration/valid", false);
+        (void)load_touch_calibration();
+        CHECK_FALSE(cfg->get<bool>("/input/force_calibration", false));
+    }
+    reset_touch_keys();
+}
+
+TEST_CASE_METHOD(LVGLTestFixture,
+                 "Kiln touch cal range: the affine stored with a refused range is not loaded",
+                 "[kiln][touch-cal-range][touch-calibration]") {
+    Config* cfg = Config::get_instance();
+    reset_touch_keys();
+    cfg->set<bool>("/input/calibration/valid", true);
+    cfg->set<double>("/input/calibration/a", 1.37);
+    cfg->set<double>("/input/calibration/b", 0.0);
+    cfg->set<double>("/input/calibration/c", 5.0);
+    cfg->set<double>("/input/calibration/d", 0.0);
+    cfg->set<double>("/input/calibration/e", 1.21);
+    cfg->set<double>("/input/calibration/f", -4.0);
+    cfg->set<int>("/input/calibration/rotation", 0);
+    set_declared_touch_range(declared_4095());
+
+    SECTION("with a range off the device") {
+        write_stored_range(cfg, reported_damaged());
+        const TouchCalibration cal = load_touch_calibration();
+        // the uncalibrated path: no affine, or the board's default
+        CHECK_FALSE((cal.valid && cal.a == Approx(1.37f)));
+        const TouchCalibration def = platform_default_calibration();
+        CHECK(cal.valid == def.valid);
+        if (def.valid) {
+            CHECK(cal.a == Approx(def.a));
+            CHECK(cal.e == Approx(def.e));
+        }
+    }
+    SECTION("with a good range it loads as before") {
+        write_stored_range(cfg, panel_edges());
+        const TouchCalibration cal = load_touch_calibration();
+        CHECK(cal.valid);
+        CHECK(cal.a == Approx(1.37f));
+    }
+    reset_touch_keys();
+}
