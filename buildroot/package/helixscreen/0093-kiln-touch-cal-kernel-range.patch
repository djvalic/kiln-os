+    void show_pre_session(ICalibrationSink& sink);
+
+    /// Kiln OS: the range begin_capture() put in place of the live stored one,
+    /// or null when the capture runs under the range live at the start.
+    const TouchRangeSettings* capture_range() const {
+        return capture_range_.range.valid ? &capture_range_.range : nullptr;
+    }
+
+    /// Kiln OS: the evdev range live when the session began (valid=false when
+    /// unknown).
+    const TouchRangeSettings& range_backup() const {
+        return range_backup_.range;
+    }
+
     /// The user accepted/persisted a new calibration: drop the snapshot so a
     /// later restore() will not revert their new calibration.
     void commit();
@@ -185,6 +227,7 @@ class TouchCalibrationSession {
   private:
     TouchCalibration backup_{};
     LiveTouchRange range_backup_{};
+    LiveTouchRange capture_range_{}; ///< Kiln OS: see capture_range()
     bool has_backup_ = false;
 };
 
