+        has_transposed_abs_range(max_x, max_y, display_width, display_height)) {
+        return out;
+    }
+    out.valid = true;
+    out.swap_axes = env_swap;
+    out.min_x = min_x;
+    out.max_x = max_x;
+    out.min_y = min_y;
+    out.max_y = max_y;
+    return out;
+}
+
+Point evdev_point_from_raw(Point raw, const TouchRangeSettings& range, int width, int height) {
+    const int x = range.swap_axes ? raw.y : raw.x;
+    const int y = range.swap_axes ? raw.x : raw.y;
