+/// Three taps on the panel's targets under the sink's live range
+void capture(TouchCalibrationPanel& panel, const RangeSink& sink) {
+    for (int step = 0; step < 3; step++) {
+        const Point target = panel.get_target_position(step);
+        const Point touch = sink.tap(target);
+        const Point raw = raw_at(target);
+        for (int s = 0; s < 3; s++) {
+            panel.add_sample(touch, &raw);
+        }
+    }
+}
