+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Kiln OS: touch calibration works when the stored touch range is damaged
+// (issue #90).
+//
+// lv_evdev scales and clamps every reading through the stored range. A damaged
+// one (the report: X 707..19420, Y -947..-26692 on a 0..4095 device) put every
+// tap at Y=0, the panel rejected the three points as degenerate before the fit
+// from the raw readings was reached, and no recalibration (the hold to
+// recalibrate included) could finish. Now:
+// - a capture runs under the device's declared range in place of a stored one,
+//   and cancel and retry put things back as they were
+// - load_touch_range() refuses a stored range that lies outside the device's
+//   range, and the screen falls back to the kernel's range
+//
+// Run with: ./build/bin/helix-tests "[kiln][touch-cal-range]"
+
+#include "config.h"
+#include "lvgl_test_fixture.h"
+#include "touch_calibration.h"
+#include "touch_calibration_panel.h"
+#include "touch_calibration_session.h"
+#include "touch_calibration_wrapper.h"
+
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+#include "../catch_amalgamated.hpp"
+
+using Catch::Approx;
+using namespace helix;
+
+namespace {
+
+constexpr int kW = 800;
+constexpr int kH = 480;
+
+TouchRangeSettings range_of(int min_x, int max_x, int min_y, int max_y, bool swap = false) {
+    TouchRangeSettings r;
+    r.valid = true;
+    r.swap_axes = swap;
+    r.min_x = min_x;
+    r.max_x = max_x;
+    r.min_y = min_y;
+    r.max_y = max_y;
+    r.capture_rotation = 0;
+    return r;
+}
+
+/// The device: 0..4095 on both axes (TSC2007 on Kiln's kernel)
+TouchRangeSettings declared_4095() {
+    return range_of(0, 4095, 0, 4095);
+}
+
+/// The declared range laid out as the AD5X's stored ranges run: Y from the
+/// bottom up (min_y > max_y)
+TouchRangeSettings declared_y_up() {
+    return range_of(0, 4095, 4095, 0);
+}
+
+/// The report's settings.json (issue #90)
+TouchRangeSettings reported_damaged() {
+    return range_of(707, 19420, -947, -26692);
+}
+
+/// What the AD5X panel emits at the display's edges: X normal, Y inverted
+TouchRangeSettings panel_edges() {
+    return range_of(150, 3900, 3608, 591);
+}
+
+/// The digitizer reading at a screen pixel on that panel
+Point raw_at(Point px) {
+    const TouchRangeSettings e = panel_edges();
+    return Point{e.min_x + px.x * (e.max_x - e.min_x) / (kW - 1),
+                 e.min_y + px.y * (e.max_y - e.min_y) / (kH - 1)};
+}
+
+/// The device as the session sees it: the live evdev range and where it came
+/// from, the declared range, the stored affine
+struct RangeSink : ICalibrationSink {
+    LiveTouchRange live;
+    LiveTouchRange declared;
+    TouchCalibration stored{};
+    bool affine_enabled = true;
+    std::vector<std::string> ops;
+
+    TouchCalibration current_calibration() const override {
+        return stored;
+    }
+    bool apply_calibration(const TouchCalibration& cal) override {
+        if (!cal.valid) {
+            return false;
+        }
+        stored = cal;
+        ops.push_back("apply");
+        return true;
+    }
+    void disable_affine() override {
+        affine_enabled = false;
+    }
+    void enable_affine() override {
+        affine_enabled = true;
+    }
+    void clear_calibration() override {
+        stored = TouchCalibration{};
+        ops.push_back("clear");
+    }
+    bool apply_touch_range(bool swap, int min_x, int min_y, int max_x, int max_y,
+                           TouchRangeSource source) override {
+        if (min_x == max_x || min_y == max_y) {
+            return false;
+        }
+        live.range = range_of(min_x, max_x, min_y, max_y, swap);
+        live.source = source;
+        ops.push_back(std::string("range:") + touch_range_source_name(source));
+        return true;
+    }
+    LiveTouchRange current_touch_range() const override {
+        return live;
+    }
+    LiveTouchRange declared_touch_range() const override {
+        return declared;
+    }
+
+    /// Where a tap at @p px lands under the live range (lv_evdev's output)
+    Point tap(Point px) const {
+        return evdev_point_from_raw(raw_at(px), live.range, kW, kH);
+    }
+};
+
+RangeSink sink_with_stored(const TouchRangeSettings& stored) {
+    RangeSink sink;
+    sink.live.range = stored;
+    sink.live.source = TouchRangeSource::Stored;
+    sink.declared.range = declared_4095();
+    sink.declared.source = TouchRangeSource::Declared;
+    return sink;
+}
+
+bool same_range(const TouchRangeSettings& a, const TouchRangeSettings& b) {
+    return a.swap_axes == b.swap_axes && a.min_x == b.min_x && a.max_x == b.max_x &&
+           a.min_y == b.min_y && a.max_y == b.max_y;
+}
+
+void write_stored_range(Config* cfg, const TouchRangeSettings& r) {
+    cfg->set<bool>("/input/touch_range/valid", true);
+    cfg->set<bool>("/input/touch_range/swap_axes", r.swap_axes);
+    cfg->set<int>("/input/touch_range/min_x", r.min_x);
+    cfg->set<int>("/input/touch_range/max_x", r.max_x);
+    cfg->set<int>("/input/touch_range/min_y", r.min_y);
+    cfg->set<int>("/input/touch_range/max_y", r.max_y);
+    cfg->set<int>("/input/touch_range/rotation", 0);
+}
