+TEST_CASE("Kiln touch cal range: stored range against the declared range",
+          "[kiln][touch-cal-range][touch-calibration]") {
+    const TouchRangeSettings d = declared_4095();
+    CHECK_FALSE(stored_touch_range_fits_declared(reported_damaged(), d));
