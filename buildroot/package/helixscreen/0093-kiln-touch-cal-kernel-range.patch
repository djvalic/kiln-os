+// The helpers
+// ---------------------------------------------------------------------------
+
+TEST_CASE("Kiln touch cal range: the declared range that can be trusted",
+          "[kiln][touch-cal-range][touch-calibration]") {
+    const TouchRangeSettings ok =
+        trusted_declared_touch_range(true, 0, 4095, 0, 4095, false, kW, kH);
+    CHECK(ok.valid);
+    CHECK(same_range(ok, declared_4095()));
+    CHECK(trusted_declared_touch_range(true, 0, 4095, 0, 4095, true, kW, kH).swap_axes);
+
+    CHECK_FALSE(trusted_declared_touch_range(false, 0, 4095, 0, 4095, false, kW, kH).valid);
+    CHECK_FALSE(trusted_declared_touch_range(true, 0, 0, 0, 0, false, kW, kH).valid);
+    CHECK_FALSE(trusted_declared_touch_range(true, 0, 4095, 7, 7, false, kW, kH).valid);
+    // The display transposed: that declaration lies
+    CHECK_FALSE(trusted_declared_touch_range(true, 0, kH, 0, kW, false, kW, kH).valid);
+}
+
+TEST_CASE("Kiln touch cal range: a reading through a range as lv_evdev scales it",
+          "[kiln][touch-cal-range][touch-calibration]") {
+    const TouchRangeSettings d = declared_4095();
+    CHECK(evdev_point_from_raw(Point{0, 0}, d, kW, kH).x == 0);
+    CHECK(evdev_point_from_raw(Point{4095, 4095}, d, kW, kH).x == kW - 1);
+    CHECK(evdev_point_from_raw(Point{4095, 4095}, d, kW, kH).y == kH - 1);
+    CHECK(evdev_point_from_raw(Point{2048, 1024}, d, kW, kH).x == 2048 * (kW - 1) / 4095);
+
+    // Inverted Y, and the clamp
+    const TouchRangeSettings e = panel_edges();
+    CHECK(evdev_point_from_raw(Point{150, 3608}, e, kW, kH).y == 0);
+    CHECK(evdev_point_from_raw(Point{3900, 591}, e, kW, kH).y == kH - 1);
+    CHECK(evdev_point_from_raw(Point{4095, 0}, e, kW, kH).x == kW - 1);
+    CHECK(evdev_point_from_raw(Point{4095, 0}, e, kW, kH).y == kH - 1);
+
+    // Swap comes first
+    const Point swapped =
+        evdev_point_from_raw(Point{0, 4095}, range_of(0, 4095, 0, 4095, true), kW, kH);
+    CHECK(swapped.x == kW - 1);
+    CHECK(swapped.y == 0);
+
+    // The report's range: Y on the top edge wherever the finger is
+    for (int y : {0, 1000, 2000, 4095}) {
+        CHECK(evdev_point_from_raw(Point{2000, y}, reported_damaged(), kW, kH).y == 0);
+    }
+}
