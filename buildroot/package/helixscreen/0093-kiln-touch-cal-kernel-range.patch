+    CHECK(stored_touch_range_fits_declared(range_of(150, 3900, 3608, 591), d));
+    CHECK(stored_touch_range_fits_declared(range_of(4000, 90, 3900, 120), d));
+    CHECK(stored_touch_range_fits_declared(range_of(0, 4095, 0, 4095), d));
+    // A panel emitting a little past its declared range, an extrapolated edge
+    CHECK(stored_touch_range_fits_declared(range_of(-300, 4400, 4500, -200), d));
+    // One emitting well past it (2x, 4x the span): the readings still reach
+    // half, a quarter of the axis, so its own calibration is not refused
+    CHECK(stored_touch_range_fits_declared(range_of(0, 8190, 591, 3608), d));
+    CHECK(stored_touch_range_fits_declared(range_of(150, 3900, 16000, -400), d));
+
+    // An axis the device's readings reach under 1/8 of: in effect one edge
+    CHECK_FALSE(stored_touch_range_fits_declared(range_of(150, 40000, 591, 3608), d));
+    CHECK_FALSE(stored_touch_range_fits_declared(range_of(150, 3900, 591, -30000), d));
+    // Off the device: every reading on one edge
+    CHECK_FALSE(stored_touch_range_fits_declared(range_of(150, 3900, -1900, -100), d));
+    CHECK_FALSE(stored_touch_range_fits_declared(range_of(4200, 6000, 591, 3608), d));
+
+    // The stored range is post-swap: its X is the device's Y
+    const TouchRangeSettings narrow_y = range_of(0, 4095, 0, 1023);
+    CHECK(stored_touch_range_fits_declared(range_of(100, 1000, 300, 3900, true), narrow_y));
+    CHECK_FALSE(stored_touch_range_fits_declared(range_of(2000, 3900, 100, 1000, true), narrow_y));
+
+    // Nothing to judge against
+    CHECK(stored_touch_range_fits_declared(reported_damaged(), TouchRangeSettings{}));
+    CHECK(stored_touch_range_fits_declared(reported_damaged(), range_of(0, 0, 0, 0)));
