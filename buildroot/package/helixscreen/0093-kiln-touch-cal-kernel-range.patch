+
+bool stored_touch_range_fits_declared(const TouchRangeSettings& stored,
+                                      const TouchRangeSettings& declared) {
+    if (!stored.valid || !declared.valid) {
+        return true;
+    }
+    // The stored range is what lv_evdev scales AFTER its swap
+    const int dev_min_x = stored.swap_axes ? declared.min_y : declared.min_x;
+    const int dev_max_x = stored.swap_axes ? declared.max_y : declared.max_x;
+    const int dev_min_y = stored.swap_axes ? declared.min_x : declared.min_y;
+    const int dev_max_y = stored.swap_axes ? declared.max_x : declared.max_y;
+    return stored_axis_fits_declared(stored.min_x, stored.max_x, dev_min_x, dev_max_x) &&
+           stored_axis_fits_declared(stored.min_y, stored.max_y, dev_min_y, dev_max_y);
+}
+
+TouchRangeSettings orient_declared_like(const TouchRangeSettings& declared,
+                                        const TouchRangeSettings& like) {
+    TouchRangeSettings out;
+    if (!declared.valid) {
+        return out;
+    }
+    out.valid = true;
+    out.swap_axes = like.swap_axes;
+    out.capture_rotation = 0;
+    const int x_lo = like.swap_axes ? std::min(declared.min_y, declared.max_y)
+                                    : std::min(declared.min_x, declared.max_x);
+    const int x_hi = like.swap_axes ? std::max(declared.min_y, declared.max_y)
+                                    : std::max(declared.min_x, declared.max_x);
+    const int y_lo = like.swap_axes ? std::min(declared.min_x, declared.max_x)
+                                    : std::min(declared.min_y, declared.max_y);
+    const int y_hi = like.swap_axes ? std::max(declared.min_x, declared.max_x)
+                                    : std::max(declared.min_y, declared.max_y);
+    const bool x_down = like.min_x > like.max_x;
+    const bool y_down = like.min_y > like.max_y;
+    out.min_x = x_down ? x_hi : x_lo;
+    out.max_x = x_down ? x_lo : x_hi;
+    out.min_y = y_down ? y_hi : y_lo;
+    out.max_y = y_down ? y_lo : y_hi;
+    return out;
+}
+
+TouchRangeSettings range_layout_with_affine(const TouchRangeSettings& range,
+                                            const TouchCalibration& affine) {
+    TouchRangeSettings out = range;
+    if (!range.valid || !affine.valid) {
+        return out;
+    }
+    const bool cross =
+        std::abs(affine.b) + std::abs(affine.d) > std::abs(affine.a) + std::abs(affine.e);
+    if (!cross) {
+        if (affine.a < 0.0f) {
+            std::swap(out.min_x, out.max_x);
+        }
+        if (affine.e < 0.0f) {
+            std::swap(out.min_y, out.max_y);
+        }
+        return out;
+    }
+    // Screen X comes from the range's Y stage and screen Y from its X stage
+    out.swap_axes = !range.swap_axes;
+    out.min_x = affine.b < 0.0f ? range.max_y : range.min_y;
+    out.max_x = affine.b < 0.0f ? range.min_y : range.max_y;
+    out.min_y = affine.d < 0.0f ? range.max_x : range.min_x;
+    out.max_y = affine.d < 0.0f ? range.min_x : range.max_x;
+    return out;
