diff --git a/include/touch_calibration.h b/include/touch_calibration.h
index 31b94f0..9cd099e 100644
--- a/include/touch_calibration.h
+++ b/include/touch_calibration.h
@@ -462,6 +462,67 @@ struct TouchRangeSettings {
     int capture_rotation = -1;
 };
 
+/// Kiln OS: the least share of a screen axis the device's declared range must
+/// reach through a stored range. lv_evdev scales the stored range onto the axis
+/// and clamps, so readings within the declared range land on the part of the
+/// axis the two ranges share. Under 1/8 (60 px of the AD5X's 480) the axis is
+/// in effect clamped to one edge: the damaged record of issue #90 (Y
+/// -947..-26692 on a 0..4095 device) reaches none of it. A panel that emits
+/// past its declared range (#1714) saves a wider range and still reaches
+/// 1/k of the axis at k times the span, so only a k over 8 is refused, and a
+/// range a calibration saved on such a panel is not refused at the next start.
+constexpr double kStoredTouchRangeMinReach = 0.125;
+
+/// Kiln OS: whether a stored range belongs to a device declaring @p declared
+/// (EVIOCGABS: min/max per axis, valid=false when unknown): per axis, the
+/// declared range reaches at least kStoredTouchRangeMinReach of the stored
+/// span. The stored range is post-swap, so with swap_axes its X is the
+/// device's Y. Either direction is fine: min > max inverts an axis. An unknown
+/// or degenerate declared range is not judged (true). Pure.
+bool stored_touch_range_fits_declared(const TouchRangeSettings& stored,
+                                      const TouchRangeSettings& declared);
+
+/// Kiln OS: @p declared laid out the way @p like runs, for a capture under the
+/// declared range in place of @p like: like's swap (post-swap X is then the
+/// device's Y range), and each axis reversed (min > max) where like's is.
+/// capture_rotation 0: the result is native digitizer space. Pure.
+TouchRangeSettings orient_declared_like(const TouchRangeSettings& declared,
+                                        const TouchRangeSettings& like);
+
+/// Kiln OS: the swap and axis directions of the whole mapping @p range and
+/// then @p affine make (range alone when the affine is not valid): an axis is
+/// reversed when the range reverses it XOR the affine's term for it is
+/// negative (a for X, e for Y). An affine whose off-diagonal terms dominate
+/// (|b| + |d| > |a| + |e|, as detect_axis_transposition judges) swaps the axes
+/// once more, with b's sign for the new X and d's for the new Y. The numbers
+/// are @p range's, rearranged; only the layout means anything. A calibration
+/// converted from stock units keeps min < max and the Y flip in the affine
+/// (e < 0); one made on Kiln's kernel keeps it in the range. Pure.
+TouchRangeSettings range_layout_with_affine(const TouchRangeSettings& range,
+                                            const TouchCalibration& affine);
+
+/// Kiln OS: @p declared the way the device runs uncalibrated: with
+/// @p raw_y_runs_up (the AD5X's TSC2007 on Kiln's own kernels reports Y from
+/// the screen's bottom up; Flashforge's 5.10 driver flips it) the device's Y
+/// axis reversed. Pure.
+TouchRangeSettings uncalibrated_declared_orientation(const TouchRangeSettings& declared,
+                                                     bool raw_y_runs_up);
+
+/// Kiln OS: the declared ABS range a stored range can be judged against and a
+/// calibration capture can run under: valid only when the query succeeded, both
+/// axes have a span, and the range is not the display transposed (that
+/// declaration lies, and the backends scale by the display size instead).
+/// @p env_swap: the swap the environment holds (HELIX_TOUCH_SWAP_AXES), kept
+/// in swap_axes. Pure.
+TouchRangeSettings trusted_declared_touch_range(bool got_range, int min_x, int max_x, int min_y,
+                                                int max_y, bool env_swap, int display_width,
+                                                int display_height);
+
+/// Kiln OS: what lv_evdev makes of the digitizer reading @p raw under @p range
+/// (lv_evdev.c _evdev_process_pointer: swap, scale onto 0..width-1 and
+/// 0..height-1 in integer steps, clamp). Native, pre-rotation space. Pure.
+Point evdev_point_from_raw(Point raw, const TouchRangeSettings& range, int width, int height);
+
 /**
  * @brief Which stage supplied the ABS range lv_evdev is actually scaling against
  *
