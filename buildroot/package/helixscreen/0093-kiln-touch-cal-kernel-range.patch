+/// One axis of stored_touch_range_fits_declared(): the stored ends (either
+/// order) against the declared ones.
+bool stored_axis_fits_declared(int stored_a, int stored_b, int declared_a, int declared_b) {
+    const long lo = std::min(declared_a, declared_b);
+    const long hi = std::max(declared_a, declared_b);
+    const long s_lo = std::min(stored_a, stored_b);
+    const long s_hi = std::max(stored_a, stored_b);
+    if (hi <= lo || s_hi <= s_lo) {
+        return true; // nothing to judge against (a degenerate stored one is refused before)
+    }
+    // The share of the screen axis that readings within the declared range reach
+    const long shared = std::min(s_hi, hi) - std::max(s_lo, lo);
+    return static_cast<double>(shared) >=
+           kStoredTouchRangeMinReach * static_cast<double>(s_hi - s_lo);
+}
+
+int evdev_scale_axis(int v, int in_min, int in_max, int out_max) {
+    // lv_evdev's _evdev_calibrate with out_min 0, in its integer order
+    if (in_min != in_max) {
+        v = (v - in_min) * out_max / (in_max - in_min);
+    }
+    return std::clamp(v, 0, out_max);
+}
+
