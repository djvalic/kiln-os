+// Kiln OS: the touch device's declared ABS range (set_declared_touch_range).
+// Written by the display backend and read on the LVGL thread only.
+TouchRangeSettings s_declared_range;
+
+enum class StoredRangeState {
+    None,     ///< no stored range, or a degenerate one (upstream: ignored)
+    Usable,   ///< programmed
+    OffDevice ///< Kiln OS: mostly outside the device's declared range (issue #90)
+};
+
+/// @p report: the backend's load (load_touch_range): log what is refused, and
+/// for a range off the device ask for a calibration at this start
+StoredRangeState read_stored_touch_range(TouchRangeSettings& range, bool report) {
+    range = TouchRangeSettings{};
     helix::Config* cfg = helix::Config::get_instance();
 
     if (!cfg->get<bool>("/input/touch_range/valid", false)) {
-        return range;
+        return StoredRangeState::None;
     }
 
     range.swap_axes = cfg->get<bool>("/input/touch_range/swap_axes", false);
@@ -389,12 +403,58 @@ TouchRangeSettings load_touch_range() {
     // min == max is not a passthrough in lv_evdev: the scale is skipped but the
     // clamp is not, so every coordinate would collapse onto one pixel. Refuse it.
     if (range.min_x == range.max_x || range.min_y == range.max_y) {
-        spdlog::warn("[TouchCal] Stored touch range is degenerate X({}..{}) Y({}..{}) - ignoring",
-                     range.min_x, range.max_x, range.min_y, range.max_y);
-        return TouchRangeSettings{};
+        if (report) {
+            spdlog::warn(
+                "[TouchCal] Stored touch range is degenerate X({}..{}) Y({}..{}) - ignoring",
+                range.min_x, range.max_x, range.min_y, range.max_y);
+        }
+        range = TouchRangeSettings{};
+        return StoredRangeState::None;
     }
 
     range.valid = true;
+
+    // Kiln OS: a range the device cannot produce scales and clamps every
+    // reading to an edge: a dead screen, and a recalibration that never gets
+    // three usable taps (issue #90). Fall back to the kernel's range.
+    if (!stored_touch_range_fits_declared(range, s_declared_range)) {
+        if (report) {
+            spdlog::warn("[TouchCal] Stored touch range X({}..{}) Y({}..{}) swap={} lies outside "
+                         "the device's range X({}..{}) Y({}..{}) - ignoring it, the kernel's "
+                         "range applies; touch calibration opens at this start",
+                         range.min_x, range.max_x, range.min_y, range.max_y, range.swap_axes,
+                         s_declared_range.min_x, s_declared_range.max_x, s_declared_range.min_y,
+                         s_declared_range.max_y);
+            // The uncalibrated path is the board's default affine over the
