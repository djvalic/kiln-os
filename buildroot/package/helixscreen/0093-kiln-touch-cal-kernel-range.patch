+        if (out.swap_axes) {
+            std::swap(out.min_x, out.max_x);
+        } else {
+            std::swap(out.min_y, out.max_y);
+        }
+    }
+    return out;
+}
+
+TouchRangeSettings trusted_declared_touch_range(bool got_range, int min_x, int max_x, int min_y,
+                                                int max_y, bool env_swap, int display_width,
+                                                int display_height) {
+    TouchRangeSettings out;
