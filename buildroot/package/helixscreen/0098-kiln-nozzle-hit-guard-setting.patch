diff --git a/src/ui/ui_settings_ad5x_nozzle_guard.cpp b/src/ui/ui_settings_ad5x_nozzle_guard.cpp
new file mode 100644
index 0000000..7efc32f
--- /dev/null
+++ b/src/ui/ui_settings_ad5x_nozzle_guard.cpp
@@ -0,0 +1,456 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "ui_settings_ad5x_nozzle_guard.h"
+
+#include "ui_emergency_stop.h"
+#include "ui_error_reporting.h"
+#include "ui_modal.h"
+#include "ui_settings_ad5x_plugins.h"
+#include "ui_update_queue.h"
+
+#include "app_globals.h"
+#include "i_moonraker_api.h"
+#include "i_moonraker_client.h"
+#include "json_utils.h"
+#include "lvgl/src/others/translation/lv_translation.h"
+#include "macro_executor.h"
+#include "observer_factory.h"
+#include "printer_discovery.h"
+#include "printer_state.h"
+#include "static_panel_registry.h"
+
+#include <spdlog/fmt/fmt.h>
+#include <spdlog/spdlog.h>
+
+#include <algorithm>
+#include <cmath>
+#include <iterator>
+
+namespace helix::ad5x_nozzle_guard {
+
+namespace {
+
+constexpr const char* kObject = "ad5x_nozzle_guard";
+/// The bed weighing board: every Kiln OS printer has it, others don't
+constexpr const char* kKilnObject = "ad5x_weight";
+constexpr const char* kSensitivities[] = {"low", "medium", "high"};
+/// Klipper's limits for them (ad5x_nozzle_guard.py SENSITIVITY), g
+constexpr double kThresholds[] = {600.0, 300.0, 150.0};
+/// How long after ENABLE_PLUGIN's answer Klipper has to go down for its restart
+constexpr uint32_t kRestartWaitMs = 15000;
+
+void set_if_changed(lv_subject_t* subject, int value) {
+    if (lv_subject_get_int(subject) != value) {
+        lv_subject_set_int(subject, value);
+    }
+}
+
+bool has_object(IMoonrakerAPI* api, const char* name) {
+    const auto& objects = api->hardware().printer_objects();
+    return std::find(objects.begin(), objects.end(), name) != objects.end();
+}
+
+bool print_active() {
+    return lv_subject_get_int(get_printer_state().print_state().get_print_active_subject()) != 0;
+}
+
+} // namespace
+
+const char* sensitivity_name(int index) {
+    if (index < 0 || index >= static_cast<int>(std::size(kSensitivities))) {
+        return kSensitivities[static_cast<int>(Sensitivity::Medium)];
+    }
+    return kSensitivities[index];
+}
+
+int sensitivity_index(const std::string& name, double threshold) {
+    for (int i = 0; i < static_cast<int>(std::size(kSensitivities)); ++i) {
+        if (name == kSensitivities[i]) {
+            return i;
+        }
+    }
+    // "custom" (NOZZLE_GUARD THRESHOLD=): the nearest choice
+    int best = static_cast<int>(Sensitivity::Medium);
+    if (threshold > 0) {
+        for (int i = 0; i < static_cast<int>(std::size(kThresholds)); ++i) {
+            if (std::abs(threshold - kThresholds[i]) < std::abs(threshold - kThresholds[best])) {
+                best = i;
+            }
+        }
+    }
+    return best;
+}
+
+std::string enable_gcode(bool on) {
+    return fmt::format("NOZZLE_GUARD ENABLE={}", on ? 1 : 0);
+}
+
+std::string sensitivity_gcode(int index) {
+    return fmt::format("NOZZLE_GUARD SENSITIVITY={}", sensitivity_name(index));
+}
+
+SwitchAction switch_action(bool on, bool installed, bool print_active) {
+    if (installed) {
+        return SwitchAction::Command;
+    }
+    // Without the object the guard is off: only switching it on means
+    // something, and ENABLE_PLUGIN restarts Klipper, which it refuses mid-print
+    return (on && !print_active) ? SwitchAction::EnablePlugin : SwitchAction::None;
+}
+
+// ============================================================================
+// MODEL
+// ============================================================================
+
+Ad5xNozzleGuardModel::~Ad5xNozzleGuardModel() {
+    lifetime_.invalidate();
+    restart_timer_.reset();
+    subscription_.reset();
+    klippy_observer_.reset();
+    print_observer_.reset();
+    subjects_.deinit_all();
+}
+
+void Ad5xNozzleGuardModel::init_subjects() {
+    if (subjects_initialized_) {
+        return;
+    }
+    // 1 on a Kiln OS printer (ad5x_weight): the rows show
+    UI_MANAGED_SUBJECT_INT(available_, 0, "ad5x_nozzle_guard_available", subjects_);
+    // The switch: the plugin on and NOZZLE_GUARD ENABLE=1
+    UI_MANAGED_SUBJECT_INT(enabled_, 0, "ad5x_nozzle_guard_enabled", subjects_);
+    // 0 low, 1 medium, 2 high
+    UI_MANAGED_SUBJECT_INT(sensitivity_, 1, "ad5x_nozzle_guard_sensitivity", subjects_);
+    // 1 while the switch can't be used: a change pending, Klipper not ready or
+    // restarting, or the plugin off during a print
+    UI_MANAGED_SUBJECT_INT(locked_, 1, "ad5x_nozzle_guard_locked", subjects_);
+    // 1 while the sensitivity can't be changed
+    UI_MANAGED_SUBJECT_INT(busy_, 1, "ad5x_nozzle_guard_busy", subjects_);
+    // 1 when the plugin is off and a print runs: "turn it on after the print"
+    UI_MANAGED_SUBJECT_INT(print_hint_, 0, "ad5x_nozzle_guard_print_hint", subjects_);
+    subjects_initialized_ = true;
+}
+
+void Ad5xNozzleGuardModel::attach(IMoonrakerAPI* api, const json& status) {
+    init_subjects();
+    if (!api) {
+        return;
+    }
+    if (!has_object(api, kKilnObject)) {
+        // Not a Kiln OS printer: no rows
+        detach();
+        return;
+    }
+
+    if (api != api_) {
+        detach();
+        api_ = api;
+        const auto token = lifetime_.token();
+        // Runs on the WebSocket thread: copy the object out, apply it on the main thread
+        const SubscriptionId id = api->subscribe_notifications([this, token](const json& note) {
+            const json* params = json_util::find_member(note, "params");
+            if (!params || !params->is_array() || params->empty()) {
+                return;
+            }
+            const json* obj = json_util::find_member((*params)[0], kObject);
+            if (!obj || !obj->is_object() || obj->empty()) {
+                return;
+            }
+            json delta = *obj;
+            token.defer("Ad5xNozzleGuardModel::status_update", [this, delta]() { merge(delta); });
+        });
+        subscription_ = SubscriptionGuard(api, id);
+    }
+
+    if (!klippy_observer_) {
+        klippy_observer_ = ui::observe<int>(
+            get_printer_state().network_state().get_klippy_state_subject(), this,
+            [](Ad5xNozzleGuardModel* self, int state) {
+                const bool ready = static_cast<KlippyState>(state) == KlippyState::READY;
+                if (ready == self->klippy_ready_) {
+                    return;
+                }
+                self->klippy_ready_ = ready;
+                if (!ready && self->restarting_) {
+                    // ENABLE_PLUGIN's restart: the next discovery releases the switch
+                    self->saw_restart_ = true;
+                    self->restart_timer_.reset();
+                }
+                if (ready) {
+                    self->query();
+                }
+                self->refresh();
+            },
+            get_printer_state().get_subjects_lifetime());
+    }
+    if (!print_observer_) {
+        // The plugin can't be switched on during a print: lock and hint follow it
+        print_observer_ = ui::observe<int>(
+            get_printer_state().print_state().get_print_active_subject(), this,
+            [](Ad5xNozzleGuardModel* self, int) { self->refresh(); },
+            get_printer_state().get_subjects_lifetime());
+    }
+
+    // Each discovery lists the objects again: after ENABLE_PLUGIN's restart
+    // the plugin's object is there
+    restarting_ = false;
+    saw_restart_ = false;
+    restart_timer_.reset();
+    const bool had = installed_;
+    installed_ = has_object(api, kObject);
+    if (!installed_ || !had) {
+        obj_ = json::object();
+        loaded_ = false;
+    }
+    // The discovery's initial status carries the object whole
+    if (!installed_) {
+        refresh();
+    } else if (const json* obj = json_util::find_member(status, kObject);
+               obj && obj->is_object() && !obj->empty()) {
+        merge(*obj);
+    } else {
+        query();
+        refresh();
+    }
+}
+
+void Ad5xNozzleGuardModel::detach() {
+    subscription_.reset();
+    api_ = nullptr;
+    obj_ = json::object();
+    installed_ = false;
+    loaded_ = false;
+    restarting_ = false;
+    saw_restart_ = false;
+    restart_timer_.reset();
+    pending_ = 0;
+    refresh();
+}
+
+void Ad5xNozzleGuardModel::query() {
+    IMoonrakerClient* client = get_moonraker_client();
+    if (!client || client->get_connection_state() != ConnectionState::CONNECTED || !api_ ||
+        !installed_) {
+        return;
+    }
+    const auto token = lifetime_.token();
+    json params = {{"objects", {{kObject, json::array({"enabled", "sensitivity", "threshold"})}}}};
+    client->send_jsonrpc(
+        "printer.objects.query", params,
+        [this, token](const json& response) {
+            const json* result = json_util::find_member(response, "result");
+            const json* status = result ? json_util::find_member(*result, "status") : nullptr;
+            const json* obj = status ? json_util::find_member(*status, kObject) : nullptr;
+            if (!obj || !obj->is_object()) {
+                return;
+            }
+            json delta = *obj;
+            token.defer("Ad5xNozzleGuardModel::status_query", [this, delta]() { merge(delta); });
+        },
+        [](const MoonrakerError& err) {
+            spdlog::debug("[AD5X nozzle guard] {} query failed: {}", kObject, err.message);
+        },
+        0, /*silent=*/true);
+}
+
+void Ad5xNozzleGuardModel::merge(const json& delta) {
+    if (!api_ || !installed_) {
+        return;
+    }
+    for (auto it = delta.begin(); it != delta.end(); ++it) {
+        obj_[it.key()] = it.value();
+    }
+    loaded_ = obj_.contains("enabled");
+    refresh();
+}
+
+void Ad5xNozzleGuardModel::send(const std::string& gcode) {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api) {
+        NOTIFY_WARNING("{}", lv_tr("Not connected to the printer"));
+        restore_switch();
+        return;
+    }
+    spdlog::info("[AD5X nozzle guard] {}", gcode);
+    ++pending_;
+    refresh();
+
+    // Klipper's answer releases the rows; a fresh query then shows what it kept
+    const auto token = lifetime_.token();
+    api->execute_gcode(
+        gcode,
+        [this, token]() {
+            token.defer("Ad5xNozzleGuardModel::send_done", [this]() {
+                pending_ = std::max(0, pending_ - 1);
+                query();
+                refresh();
+            });
+        },
+        [this, token](const MoonrakerError& err) {
+            const std::string message = err.message;
+            token.defer("Ad5xNozzleGuardModel::send_error", [this, message]() {
+                pending_ = std::max(0, pending_ - 1);
+                NOTIFY_WARNING("{}", message.empty() ? std::string(lv_tr("Failed")) : message);
+                query();
+                restore_switch();
+            });
+        },
+        0, /*silent=*/false, /*on_queued=*/nullptr, /*caller_surfaces_errors=*/true);
+}
+
+// As Ad5xPluginsOverlay::send(): a restart drops the reply, and that is the
+// command working
+void Ad5xNozzleGuardModel::send_enable_plugin(const std::string& gcode, bool restarts) {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api) {
+        NOTIFY_WARNING("{}", lv_tr("Not connected to the printer"));
+        restore_switch();
+        return;
+    }
+    spdlog::info("[AD5X nozzle guard] {}", gcode);
+    restarting_ = true;
+    saw_restart_ = false;
+    refresh();
+
+    const auto token = lifetime_.token();
+    const MacroHostEffect effect = restarts ? MacroHostEffect::Restarts : MacroHostEffect::None;
+    api->execute_gcode(
+        gcode,
+        [this, token, restarts]() {
+            // The next discovery (after the restart) releases the switch
+            if (restarts) {
+                helix::ui::begin_expected_klippy_restart("Firmware restarting...");
+            }
+            token.defer("Ad5xNozzleGuardModel::enable_plugin_done", [this]() {
+                // "already enabled" restarts nothing: don't wait forever
+                if (restarting_ && !saw_restart_ && !restart_timer_) {
+                    restart_timer_.reset(lv_timer_create(
+                        [](lv_timer_t* t) {
+                            static_cast<Ad5xNozzleGuardModel*>(lv_timer_get_user_data(t))
+                                ->restart_wait_over();
+                        },
+                        kRestartWaitMs, this));
+                }
+            });
+        },
+        [this, token, effect](const MoonrakerError& err) {
+            if (classify_macro_rpc_failure(effect, err) == MacroFailureReport::ExpectedRestart) {
+                helix::ui::begin_expected_klippy_restart("Firmware restarting...");
+                return;
+            }
+            const std::string message = err.message;
+            token.defer("Ad5xNozzleGuardModel::enable_plugin_error", [this, message]() {
+                restarting_ = false;
+                NOTIFY_WARNING("{}", message.empty() ? std::string(lv_tr("Failed")) : message);
+                restore_switch();
+            });
+        },
+        0, /*silent=*/false, /*on_queued=*/nullptr, /*caller_surfaces_errors=*/true);
+}
+
+void Ad5xNozzleGuardModel::restart_wait_over() {
+    restart_timer_.reset();
+    if (!restarting_ || saw_restart_) {
+        return;
+    }
+    spdlog::info("[AD5X nozzle guard] no Klipper restart after ENABLE_PLUGIN");
+    restarting_ = false;
+    query();
+    restore_switch();
+}
+
+void Ad5xNozzleGuardModel::handle_switch(bool on) {
+    spdlog::debug("[AD5X nozzle guard] switched {}", on ? "on" : "off");
+    if (!api_) {
+        restore_switch();
+        return;
+    }
+    switch (switch_action(on, installed_, print_active())) {
+    case SwitchAction::None:
+        restore_switch();
+        return;
+    case SwitchAction::Command:
+        if (subjects_initialized_) {
+            lv_subject_set_int(&enabled_, on ? 1 : 0);
+        }
+        send(enable_gcode(on));
+        return;
+    case SwitchAction::EnablePlugin:
+        break;
+    }
+
+    // The same question Settings > Plugins asks for this plugin
+    settings::Ad5xInstalledPlugin plugin;
+    plugin.name = kPluginName;
+    plugin.title = lv_tr("the nozzle-hit guard");
+    plugin.builtin = true;
+    const settings::Ad5xToggleConfirm c = settings::ad5x_toggle_confirm(plugin, true);
+    helix::ui::ConfirmOptions opts;
+    opts.owner_token = lifetime_.token();
+    // Cancelling puts the switch back
+    opts.on_cancel = [this]() { restore_switch(); };
+    opts.on_dismiss = [this]() { restore_switch(); };
+    helix::ui::modal_confirm(
+        c.title.c_str(), c.message.c_str(), ModalSeverity::Warning, c.button.c_str(),
+        [this, gcode = c.gcode, restarts = c.restarts]() {
+            // A print may have started while the dialog was up
+            if (print_active()) {
+                restore_switch();
+                return;
+            }
+            send_enable_plugin(gcode, restarts);
+        },
+        opts);
+}
+
+void Ad5xNozzleGuardModel::set_sensitivity(int index) {
+    index = std::clamp(index, 0, static_cast<int>(std::size(kSensitivities)) - 1);
+    if (!installed_) {
+        refresh();
+        return;
+    }
+    if (subjects_initialized_) {
+        lv_subject_set_int(&sensitivity_, index);
+    }
+    send(sensitivity_gcode(index));
+}
+
+void Ad5xNozzleGuardModel::restore_switch() {
+    refresh();
+    if (subjects_initialized_) {
+        // An unchanged value does not notify: re-apply the binding by hand
+        lv_subject_notify(&enabled_);
+        lv_subject_notify(&sensitivity_);
+    }
+}
+
+void Ad5xNozzleGuardModel::refresh() {
+    if (!subjects_initialized_) {
+        return;
+    }
+    const bool available = api_ != nullptr;
+    const bool printing = print_active();
+    set_if_changed(&available_, available ? 1 : 0);
+    // While Klipper has not answered a change, the rows keep what the user set
+    if (pending_ == 0 && !restarting_) {
+        const bool on = installed_ && loaded_ && json_util::safe_bool(obj_, "enabled");
+        set_if_changed(&enabled_, on ? 1 : 0);
+        if (loaded_) {
+            set_if_changed(&sensitivity_,
+                           sensitivity_index(json_util::safe_string(obj_, "sensitivity"),
+                                             json_util::safe_double(obj_, "threshold")));
+        }
+    }
+    const bool waiting = pending_ > 0 || restarting_ || !klippy_ready_;
+    const bool locked =
+        !available || waiting || (installed_ && !loaded_) || (!installed_ && printing);
+    set_if_changed(&locked_, locked ? 1 : 0);
+    set_if_changed(&busy_, (!available || waiting || !installed_ || !loaded_) ? 1 : 0);
+    set_if_changed(&print_hint_, (available && !installed_ && !restarting_ && printing) ? 1 : 0);
+}
+
+Ad5xNozzleGuardModel& model() {
+    return helix::lazy_global<Ad5xNozzleGuardModel>("Ad5xNozzleGuardModel");
+}
+
+} // namespace helix::ad5x_nozzle_guard
