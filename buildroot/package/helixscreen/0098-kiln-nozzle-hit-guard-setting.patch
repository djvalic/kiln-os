diff --git a/tests/unit/test_settings_ad5x_nozzle_guard.cpp b/tests/unit/test_settings_ad5x_nozzle_guard.cpp
new file mode 100644
index 0000000..46a2794
--- /dev/null
+++ b/tests/unit/test_settings_ad5x_nozzle_guard.cpp
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Kiln OS nozzle-hit guard: the commands, what the switch does, the rows on
+// Settings > Safety & Alerts, and the module's pause line as the pause reason.
+
+#include "ui_settings_ad5x_nozzle_guard.h"
+#include "ui_update_queue.h"
+
+#include "../lvgl_ui_test_fixture.h"
+#include "helix-xml/src/xml/lv_xml.h"
+#include "print_stop_reason.h"
+#include "printer_state.h"
+#include "settings_manager.h"
+
+#include <lvgl.h>
+#include <string>
+#include <vector>
+
+#include "../catch_amalgamated.hpp"
+#include "hv/json.hpp"
+
+using namespace helix::ad5x_nozzle_guard;
+using helix::ui::UpdateQueue;
+
+namespace {
+
+/// What ad5x_nozzle_guard.py writes before it pauses
+constexpr const char* kHitLine =
+    "!! Nozzle hit detected: the bed felt 412 g (limit 300 g) at Z 1.20. Print paused: check "
+    "the print and the nozzle, then resume or cancel.";
+
+struct NozzleGuardRowsFixture : public LVGLUITestFixture {
+    NozzleGuardRowsFixture() {
+        SettingsManager::instance().init_subjects();
+        model().init_subjects();
+        for (const char* name : {"ad5x_nozzle_guard_available", "ad5x_nozzle_guard_enabled",
+                                 "ad5x_nozzle_guard_locked", "ad5x_nozzle_guard_print_hint",
+                                 "ad5x_nozzle_guard_busy", "ad5x_nozzle_guard_sensitivity"}) {
+            lv_subject_t* s = lv_xml_get_subject(nullptr, name);
+            REQUIRE(s != nullptr);
+            subjects_.push_back(s);
+        }
+    }
+
+    ~NozzleGuardRowsFixture() override {
+        if (root_ && lv_obj_is_valid(root_)) {
+            lv_obj_delete(root_);
+        }
+        root_ = nullptr;
+        UpdateQueue::instance().drain();
+        // The model's defaults: no rows, locked, busy, medium
+        set("ad5x_nozzle_guard_available", 0);
+        set("ad5x_nozzle_guard_enabled", 0);
+        set("ad5x_nozzle_guard_locked", 1);
+        set("ad5x_nozzle_guard_print_hint", 0);
+        set("ad5x_nozzle_guard_busy", 1);
+        set("ad5x_nozzle_guard_sensitivity", 1);
+        UpdateQueue::instance().drain();
+    }
+
+    static void set(const char* name, int value) {
+        lv_subject_set_int(lv_xml_get_subject(nullptr, name), value);
+    }
+
+    void build() {
+        root_ = static_cast<lv_obj_t*>(
+            lv_xml_create(test_screen(), "settings_safety_overlay", nullptr));
+        REQUIRE(root_ != nullptr);
+        process_lvgl(10);
+    }
+
+    lv_obj_t* find(const char* name) {
+        lv_obj_t* o = lv_obj_find_by_name(root_, name);
+        REQUIRE(o != nullptr);
+        return o;
+    }
+
+    bool hidden(const char* name) {
+        return lv_obj_has_flag(find(name), LV_OBJ_FLAG_HIDDEN);
+    }
+
+    lv_obj_t* toggle() {
+        lv_obj_t* t = lv_obj_find_by_name(find("row_ad5x_nozzle_guard"), "toggle");
+        REQUIRE(t != nullptr);
+        return t;
+    }
+
+    lv_obj_t* root_ = nullptr;
+    std::vector<lv_subject_t*> subjects_;
+};
+
+} // namespace
+
+TEST_CASE("nozzle guard commands", "[ad5x_nozzle_guard]") {
+    CHECK(enable_gcode(true) == "NOZZLE_GUARD ENABLE=1");
+    CHECK(enable_gcode(false) == "NOZZLE_GUARD ENABLE=0");
+    CHECK(sensitivity_gcode(0) == "NOZZLE_GUARD SENSITIVITY=low");
+    CHECK(sensitivity_gcode(1) == "NOZZLE_GUARD SENSITIVITY=medium");
+    CHECK(sensitivity_gcode(2) == "NOZZLE_GUARD SENSITIVITY=high");
+    CHECK(sensitivity_gcode(9) == "NOZZLE_GUARD SENSITIVITY=medium");
+    CHECK(sensitivity_gcode(-1) == "NOZZLE_GUARD SENSITIVITY=medium");
+}
+
+TEST_CASE("nozzle guard sensitivity from Klipper's status", "[ad5x_nozzle_guard]") {
+    CHECK(sensitivity_index("low", 600) == 0);
+    CHECK(sensitivity_index("medium", 300) == 1);
+    CHECK(sensitivity_index("high", 150) == 2);
+    // NOZZLE_GUARD THRESHOLD= gives "custom": the nearest choice shows
+    CHECK(sensitivity_index("custom", 500) == 0);
+    CHECK(sensitivity_index("custom", 350) == 1);
+    CHECK(sensitivity_index("custom", 100) == 2);
+    CHECK(sensitivity_index("", 0) == 1);
+}
+
+TEST_CASE("nozzle guard switch: the plugin on its own, the guard by command",
+          "[ad5x_nozzle_guard]") {
+    // The plugin's object there: NOZZLE_GUARD ENABLE=, also during a print
+    CHECK(switch_action(true, true, false) == SwitchAction::Command);
+    CHECK(switch_action(false, true, false) == SwitchAction::Command);
+    CHECK(switch_action(true, true, true) == SwitchAction::Command);
+    CHECK(switch_action(false, true, true) == SwitchAction::Command);
+    // The plugin off: on asks and sends ENABLE_PLUGIN, but not during a print
+    CHECK(switch_action(true, false, false) == SwitchAction::EnablePlugin);
+    CHECK(switch_action(true, false, true) == SwitchAction::None);
+    CHECK(switch_action(false, false, false) == SwitchAction::None);
+    CHECK(std::string(kPluginName) == "nozzle-guard");
+}
+
+TEST_CASE("nozzle guard: the module's pause line is the pause reason",
+          "[ad5x_nozzle_guard][stop_reason]") {
+    const json frame = json{{"params", json::array({"// NOZZLE_GUARD armed", kHitLine})}};
+    const auto text = helix::last_gcode_error_text(frame);
+    REQUIRE(text.has_value());
+    const std::string expected =
+        "Nozzle hit detected: the bed felt 412 g (limit 300 g) at Z 1.20. Print paused: check the "
+        "print and the nozzle, then resume or cancel.";
+    CHECK(*text == expected);
+
+    constexpr double kStop = 1'700'000'000.0;
+    helix::JournalEntry e;
+    e.kind = helix::journal_kind::kGcodeError;
+    e.text = *text;
+    e.time = kStop - 0.5;
+    CHECK(helix::decide_print_stop_reason(helix::PrintJobState::PAUSED, "", {e}, kStop) ==
+          expected);
+}
+
+TEST_CASE_METHOD(NozzleGuardRowsFixture, "nozzle guard rows on Settings > Safety & Alerts",
+                 "[ad5x_nozzle_guard][settings][safety][binding]") {
+    SECTION("not a Kiln OS printer: no rows") {
+        set("ad5x_nozzle_guard_available", 0);
+        build();
+        CHECK(hidden("container_ad5x_nozzle_guard"));
+    }
+
+    SECTION("the guard off: the switch, no sensitivity") {
+        set("ad5x_nozzle_guard_available", 1);
+        set("ad5x_nozzle_guard_enabled", 0);
+        set("ad5x_nozzle_guard_locked", 0);
+        build();
+        CHECK_FALSE(hidden("container_ad5x_nozzle_guard"));
+        CHECK_FALSE(lv_obj_has_state(toggle(), LV_STATE_CHECKED));
+        CHECK_FALSE(lv_obj_has_state(toggle(), LV_STATE_DISABLED));
+        CHECK(hidden("container_ad5x_nozzle_guard_sensitivity"));
+        CHECK(hidden("row_ad5x_nozzle_guard_print_hint"));
+    }
+
+    SECTION("the guard on: the sensitivity shows") {
+        set("ad5x_nozzle_guard_available", 1);
+        set("ad5x_nozzle_guard_enabled", 1);
+        set("ad5x_nozzle_guard_locked", 0);
+        set("ad5x_nozzle_guard_busy", 0);
+        set("ad5x_nozzle_guard_sensitivity", 2);
+        build();
+        CHECK(lv_obj_has_state(toggle(), LV_STATE_CHECKED));
+        CHECK_FALSE(hidden("container_ad5x_nozzle_guard_sensitivity"));
+        lv_obj_t* dd = lv_obj_find_by_name(find("row_ad5x_nozzle_guard_sensitivity"), "dropdown");
+        REQUIRE(dd != nullptr);
+        CHECK(lv_dropdown_get_selected(dd) == 2);
+    }
+
+    SECTION("the plugin off during a print: locked, with the hint") {
+        set("ad5x_nozzle_guard_available", 1);
+        set("ad5x_nozzle_guard_enabled", 0);
+        set("ad5x_nozzle_guard_locked", 1);
+        set("ad5x_nozzle_guard_print_hint", 1);
+        build();
+        CHECK(lv_obj_has_state(toggle(), LV_STATE_DISABLED));
+        CHECK_FALSE(hidden("row_ad5x_nozzle_guard_print_hint"));
+    }
+}
