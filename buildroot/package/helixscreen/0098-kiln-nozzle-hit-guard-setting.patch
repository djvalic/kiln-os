+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * @file ui_settings_ad5x_nozzle_guard.h
+ * @brief Kiln OS nozzle-hit guard: its rows on Settings > Safety & Alerts
+ *
+ * Klipper's `ad5x_nozzle_guard` object (Kiln's shipped plugin nozzle-guard,
+ * off by default): `enabled`, `sensitivity` ("low", "medium", "high" or
+ * "custom") and `threshold` (g). NOZZLE_GUARD ENABLE=0|1 and NOZZLE_GUARD
+ * SENSITIVITY=low|medium|high change them, saved by Klipper, no restart.
+ *
+ * The rows show on a Kiln OS printer (one with `ad5x_weight`, the bed
+ * weighing board). Without the object the plugin is off: switching the guard
+ * on asks first and sends ENABLE_PLUGIN NAME=nozzle-guard, with the same
+ * confirmation and restart handling as Settings > Plugins (patch 0005,
+ * ad5x_toggle_confirm()); Klipper refuses that during a print, so the switch
+ * is locked then, with a hint. With the object the switch sends NOZZLE_GUARD
+ * ENABLE=0|1.
+ *
+ * On a hit the module writes a `!!` line and pauses; the pause overlay shows
+ * that line as the reason (print_stop_reason.cpp), nothing here.
+ *
+ * @pattern Process-wide model, as Ad5xLogModel
+ * @threading Main thread only; Moonraker callbacks hop over via lifetime tokens
+ */
+
+#pragma once
+
+#include "ui_observer_guard.h"
+#include "ui_subscription_guard.h"
+#include "ui_timer_guard.h"
+
+#include "async_lifetime_guard.h"
+#include "json_fwd.h"
+#include "lvgl/lvgl.h"
+#include "subject_managed_panel.h"
+
+#include <string>
+
+namespace helix {
+class IMoonrakerAPI;
+}
+
+namespace helix::ad5x_nozzle_guard {
+
+/// The plugin's NAME= for ENABLE_PLUGIN
+inline constexpr const char* kPluginName = "nozzle-guard";
+
+/// The sensitivity choices, in the dropdown's order.
+enum class Sensitivity {
+    Low = 0,    ///< 600 g
+    Medium = 1, ///< 300 g, the default
+    High = 2,   ///< 150 g
+};
+
+/// "low" / "medium" / "high" for @p index (out of range: "medium").
+const char* sensitivity_name(int index);
+
+/// The dropdown index for Klipper's `sensitivity`; a "custom" limit shows as
+/// the nearest choice by @p threshold (g).
+int sensitivity_index(const std::string& name, double threshold);
+
+/// "NOZZLE_GUARD ENABLE=1"
+std::string enable_gcode(bool on);
+
+/// "NOZZLE_GUARD SENSITIVITY=medium"
+std::string sensitivity_gcode(int index);
+
+/// What the switch does when the user moves it.
+enum class SwitchAction {
+    None = 0,         ///< Nothing to send: the switch goes back
+    EnablePlugin = 1, ///< Ask, then ENABLE_PLUGIN NAME=nozzle-guard (Klipper restarts)
+    Command = 2,      ///< NOZZLE_GUARD ENABLE=0|1 (no restart)
+};
+
+/// The switch moved to @p on; @p installed: Klipper has the object (the
+/// plugin is on); @p print_active: a print runs or is paused.
+SwitchAction switch_action(bool on, bool installed, bool print_active);
+
+/// The model: the object, the shared subjects and the commands.
+///
+/// Subjects: `ad5x_nozzle_guard_available` (1 on a Kiln OS printer: shows the
+/// rows), `ad5x_nozzle_guard_enabled` (the switch: the plugin on and the
+/// guard on), `ad5x_nozzle_guard_sensitivity` (Sensitivity),
+/// `ad5x_nozzle_guard_locked` (1: the switch can't be used now),
+/// `ad5x_nozzle_guard_busy` (1: the sensitivity can't be changed now) and
+/// `ad5x_nozzle_guard_print_hint` (1: the plugin is off and a print runs).
+class Ad5xNozzleGuardModel {
+  public:
+    Ad5xNozzleGuardModel() = default;
+    ~Ad5xNozzleGuardModel();
+    Ad5xNozzleGuardModel(const Ad5xNozzleGuardModel&) = delete;
+    Ad5xNozzleGuardModel& operator=(const Ad5xNozzleGuardModel&) = delete;
+
+    void init_subjects();
+
+    /// From each discovery (again after Klipper's restart, so the object
+    /// the plugin adds is seen): follow @p api's status updates and take
+    /// `ad5x_nozzle_guard` from the discovery's initial @p status. Nothing
+    /// on a printer without `ad5x_weight`.
+    void attach(IMoonrakerAPI* api, const json& status);
+
+    /// Ask Klipper for the object, when it has it.
+    void query();
+
+    /// The switch moved (see switch_action()).
+    void handle_switch(bool on);
+
+    /// NOZZLE_GUARD SENSITIVITY=low|medium|high
+    void set_sensitivity(int index);
+
+    bool available() const {
+        return api_ != nullptr;
+    }
+    bool installed() const {
+        return installed_;
+    }
+
+  private:
+    void detach();
+    void merge(const json& delta);
+    void send(const std::string& gcode);
+    /// ENABLE_PLUGIN: Klipper restarts on success, the reply may never come
+    void send_enable_plugin(const std::string& gcode, bool restarts);
+    void refresh();
+    /// The switch back to what Klipper has (after a refusal or Cancel)
+    void restore_switch();
+    /// ENABLE_PLUGIN answered but Klipper never went down (already enabled)
+    void restart_wait_over();
+
+    SubjectManager subjects_;
+    lv_subject_t available_{};
+    lv_subject_t enabled_{};
+    lv_subject_t sensitivity_{};
+    lv_subject_t locked_{};
+    lv_subject_t busy_{};
+    lv_subject_t print_hint_{};
+    bool subjects_initialized_ = false;
+
+    IMoonrakerAPI* api_ = nullptr;
+    json obj_ = json::object(); ///< `ad5x_nozzle_guard`'s fields
+    bool installed_ = false;    ///< Klipper has the object
+    bool loaded_ = false;       ///< ...and it has answered
+    bool klippy_ready_ = true;
+    bool restarting_ = false;  ///< ENABLE_PLUGIN sent: until Klipper is back
+    bool saw_restart_ = false; ///< ...and Klipper went down since
+    int pending_ = 0;
+
+    SubscriptionGuard subscription_;
+    ObserverGuard klippy_observer_;
+    ObserverGuard print_observer_;
+    helix::ui::LvglTimerGuard restart_timer_;
+    AsyncLifetimeGuard lifetime_;
+};
+
+Ad5xNozzleGuardModel& model();
+
+} // namespace helix::ad5x_nozzle_guard
