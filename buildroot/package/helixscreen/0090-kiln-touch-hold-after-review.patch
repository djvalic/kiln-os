+    helix::set_touch_capture_active(true);
+    hold(kCalibrationHoldMs * 2, true);
+    CHECK(handler_calls == 0);
+    CHECK(events.press_lost == 0);
+    CHECK_FALSE(touch->wait_until_release);
+    hold(200, false);
+    CHECK(events.released == 1);
+
+    // Closed while the finger is down: that press never fires
+    hold(1000, true);
+    helix::set_touch_capture_active(false);
+    hold(kCalibrationHoldMs * 2, true);
+    CHECK(handler_calls == 0);
+    hold(200, false);
+    CHECK(events.released == 2);
