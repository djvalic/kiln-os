diff --git a/tests/unit/test_kiln_touch_hold.cpp b/tests/unit/test_kiln_touch_hold.cpp
new file mode 100644
index 0000000..bb7b04b
--- /dev/null
+++ b/tests/unit/test_kiln_touch_hold.cpp
@@ -0,0 +1,571 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * Kiln OS: holding a finger still anywhere on the screen for 10 s opens touch
+ * calibration (patches 0089 and 0090, issue #90).
+ *
+ * The timing (TouchHoldGesture) is fed readings at a fixed poll rate, as the
+ * touch panel's read callback is; the application's choice of what to open
+ * (touch_hold_action); then the whole path through calibrated_read_cb and
+ * LVGL's input processing, with a button under the finger.
+ */
+
+#include "../lvgl_test_fixture.h"
+#include "lvgl/src/indev/lv_indev_private.h"
+#include "touch_calibration_wrapper.h"
+#include "touch_hold_gesture.h"
+
+#include <cstdint>
+
+#include "../catch_amalgamated.hpp"
+
+using helix::kCalibrationHoldGapMs;
+using helix::kCalibrationHoldMs;
+using helix::kCalibrationHoldRadiusPercent;
+using helix::kCalibrationHoldRearmMs;
+using helix::touch_hold_action;
+using helix::TouchHoldAction;
+using helix::TouchHoldGesture;
+using helix::TouchHoldState;
+
+namespace {
+
+constexpr uint32_t kPollMs = 10;
+constexpr int kRadiusX = 800 * kCalibrationHoldRadiusPercent / 100; // 64
+constexpr int kRadiusY = 480 * kCalibrationHoldRadiusPercent / 100; // 38
+
+TouchHoldGesture make_gesture() {
+    TouchHoldGesture g{kCalibrationHoldMs, kCalibrationHoldGapMs, kCalibrationHoldRearmMs};
+    g.set_radius(kRadiusX, kRadiusY);
+    return g;
+}
+
+/// Readings every `poll` ms into one gesture, counting the fires. A span of
+/// `ms` gives ms / poll readings, the first one `poll` after the last.
+struct Panel {
+    explicit Panel(uint32_t start = 1000, uint32_t poll_ms = kPollMs)
+        : now(start), poll(poll_ms) {}
+
+    int run(uint32_t ms, bool pressed, bool blocked = false) {
+        int fired = 0;
+        for (uint32_t t = 0; t < ms; t += poll) {
+            now += poll;
+            if (gesture.feed(pressed, x, y, now, blocked)) {
+                ++fired;
+                ++fires;
+                last_fire = now;
+            }
+        }
+        return fired;
+    }
+    int press(uint32_t ms, bool blocked = false) {
+        return run(ms, true, blocked);
+    }
+    int release(uint32_t ms, bool blocked = false) {
+        return run(ms, false, blocked);
+    }
+    /// No readings at all for @p ms (the read timer stalled or paused)
+    void silence(uint32_t ms) {
+        now += ms;
+    }
+
+    TouchHoldGesture gesture = make_gesture();
+    uint32_t now;
+    uint32_t poll;
+    int x = 400;
+    int y = 240;
+    int fires = 0;
+    uint32_t last_fire = 0;
+};
+
+} // namespace
+
+TEST_CASE("Kiln touch hold: the times", "[touch][kiln][touch-hold]") {
+    CHECK(kCalibrationHoldMs == 10000);
+    CHECK(kCalibrationHoldGapMs == 70);
+    CHECK(kCalibrationHoldRearmMs == 3000);
+    CHECK(kCalibrationHoldRadiusPercent == 8);
+}
+
+TEST_CASE("Kiln touch hold: fires at 10000 ms, not 9999, once per press",
+          "[touch][kiln][touch-hold]") {
+    TouchHoldGesture g = make_gesture();
+    const uint32_t t0 = 5000;
+    CHECK_FALSE(g.feed(true, 400, 240, t0));
+    CHECK_FALSE(g.feed(true, 400, 240, t0 + 5000));
+    CHECK_FALSE(g.feed(true, 400, 240, t0 + 9999));
