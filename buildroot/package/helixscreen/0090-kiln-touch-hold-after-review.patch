+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+/**
+ * @file touch_hold_gesture.h
+ * @brief Kiln OS: the timing of the hold-to-calibrate gesture
+ *
+ * A finger held still anywhere on the screen opens touch calibration
+ * (set_calibration_hold_handler, touch_calibration_wrapper.h). The read
+ * callback feeds this every touch reading; it says on which reading the hold
+ * fires. No LVGL here, so it is tested on its own
+ * (tests/unit/test_kiln_touch_hold.cpp), as HoldRepeat is.
+ *
+ * - A press starts the timer. Released readings shorter than the gap are
+ *   digitizer noise and do not end the press; a longer release does. So does
+ *   a release followed by a pressed reading after the gap, also when no
+ *   released reading came in between at the gap (readings stopped). Pressed
+ *   readings far apart with no release between (a slow frame) are one press.
+ * - The finger must stay within the radius of where the press began (driver
+ *   points, before the calibration): moving further starts the timer again
+ *   from there, so a scroll, a slider drag or a jog across the pad is no hold.
+ * - The hold fires once, on a pressed reading at least the hold time after
+ *   the press began.
+ * - After that it is spent until the panel has reported no touch for the
+ *   re-arm time, so a panel that reports a touch all the time fires once.
+ * - While a calibration is on screen (blocked) nothing fires, and a press
+ *   seen then spends the gesture too: a finger still down when the
+ *   calibration closes (its own hold-abort, say) does not open it again
+ *   before the re-arm.
+ *
+ * Times are lv_tick_get() milliseconds; unsigned differences, so the tick
+ * may wrap.
+ */
+
+#include <cstdint>
+#include <cstdlib>
+
+namespace helix {
+
+class TouchHoldGesture {
+  public:
+    TouchHoldGesture(uint32_t hold_ms, uint32_t gap_ms, uint32_t rearm_ms)
+        : hold_ms_(hold_ms), gap_ms_(gap_ms), rearm_ms_(rearm_ms) {}
+
+    /// How far (driver points, each axis) the finger may move during a hold.
+    void set_radius(int radius_x, int radius_y) {
+        radius_x_ = radius_x;
+        radius_y_ = radius_y;
+    }
+
+    /// One touch reading at @p now, the driver point @p x, @p y. @p blocked: a
+    /// calibration is on screen. True on the reading where the hold fires.
+    bool feed(bool pressed, int x, int y, uint32_t now, bool blocked = false) {
+        if (!pressed && down_) {
+            release_seen_ = true;
+        }
+        // The press ended: released for the gap, or released and touched
+        // again after it
+        if (down_ && release_seen_ && now - last_pressed_ >= gap_ms_) {
+            down_ = false;
+        }
+        if (spent_ && !down_ && now - last_pressed_ >= rearm_ms_) {
+            spent_ = false;
+        }
+
+        if (pressed) {
+            if (down_ && (std::abs(x - x0_) > radius_x_ || std::abs(y - y0_) > radius_y_)) {
+                down_ = false; // moved away: a hold from here
+            }
+            if (!down_) {
+                down_ = true;
+                down_since_ = now;
+                x0_ = x;
+                y0_ = y;
+            }
+            last_pressed_ = now;
+            release_seen_ = false;
+        }
+
+        if (blocked && down_) {
+            spent_ = true;
+        }
+        if (spent_ || blocked || !down_ || !pressed || now - down_since_ < hold_ms_) {
+            return false;
+        }
+        spent_ = true;
+        return true;
+    }
+
+    /// A press is being timed (or one that fired is still down).
+    bool down() const {
+        return down_;
+    }
+    /// Fired or blocked, and not yet re-armed.
+    bool spent() const {
+        return spent_;
+    }
+
+  private:
+    uint32_t hold_ms_;
+    uint32_t gap_ms_;
+    uint32_t rearm_ms_;
+    int radius_x_ = 64;
+    int radius_y_ = 38;
+    bool down_ = false;
+    bool release_seen_ = false;
+    uint32_t down_since_ = 0;
+    uint32_t last_pressed_ = 0;
+    int x0_ = 0;
+    int y0_ = 0;
+    bool spent_ = false;
+};
+
+/// What a fired hold opens (the application's handler, application.cpp).
+enum class TouchHoldAction {
+    Refuse,     ///< Nothing; the press goes on to the widget as usual
+    WizardStep, ///< The setup wizard's own touch calibration step
+    Overlay,    ///< The Settings touch calibration overlay
+};
+
+struct TouchHoldState {
+    bool has_screen = true;          ///< The application screen exists
+    bool supports_calibration = true; ///< DisplayManager::supports_touch_calibration()
+    bool calibrating = false;        ///< DisplayManager::is_touch_calibration_active()
+    bool overlay_visible = false;    ///< The touch calibration overlay is up
+    bool wizard_active = false;      ///< is_wizard_active()
+    bool wizard_targeted = false;    ///< A targeted wizard session (no touch step)
+};
+
+/// The overlay is never opened over the wizard: closing it hides the screen's
+/// other children (NavigationManager's go_back), the wizard's container
+/// among them. The full wizard goes back to its own first step instead; a
+/// targeted session (Settings > Printer > Run Setup Wizard, SETUP_WIZARD)
+/// has no such step and is left alone.
+inline TouchHoldAction touch_hold_action(const TouchHoldState& s) {
+    if (!s.has_screen || !s.supports_calibration || s.calibrating || s.overlay_visible) {
+        return TouchHoldAction::Refuse;
+    }
+    if (s.wizard_active) {
+        return s.wizard_targeted ? TouchHoldAction::Refuse : TouchHoldAction::WizardStep;
+    }
+    return TouchHoldAction::Overlay;
+}
+
+} // namespace helix
