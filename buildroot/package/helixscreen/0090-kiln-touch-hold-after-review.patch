+TEST_CASE_METHOD(TouchHoldFixture,
+                 "Kiln touch hold: a hold the handler refuses leaves the press alone",
+                 "[touch][kiln][touch-hold]") {
+    handler_takes = false; // calibration already open, a targeted wizard, no touch panel
+    hold(kCalibrationHoldMs + 1000, true);
+    CHECK(handler_calls == 1);
+    CHECK(events.press_lost == 0);
+    CHECK_FALSE(touch->wait_until_release);
+    hold(200, false);
+    CHECK(events.released == 1);
+
+    // Refused counts as fired: no retry every reading, nor before the re-arm
+    hold(kCalibrationHoldMs + 1000, true);
+    CHECK(handler_calls == 1);
+}
