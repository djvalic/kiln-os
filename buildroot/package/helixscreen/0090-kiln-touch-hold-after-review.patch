+// --- Through calibrated_read_cb and LVGL --------------------------------------
+
+namespace {
+
+struct Finger {
+    bool down = false;
+    lv_point_t at{150, 75};
+};
+Finger s_finger;
+
+void finger_read(lv_indev_t* /*indev*/, lv_indev_data_t* data) {
+    data->point = s_finger.at;
+    data->state = s_finger.down ? LV_INDEV_STATE_PRESSED : LV_INDEV_STATE_RELEASED;
+}
+
+struct ButtonEvents {
+    int pressed = 0;
+    int long_pressed = 0;
+    int press_lost = 0;
+    int released = 0;
+    int clicked = 0;
+};
+
+void count_event(lv_event_t* e) {
+    auto* ev = static_cast<ButtonEvents*>(lv_event_get_user_data(e));
+    switch (lv_event_get_code(e)) {
+    case LV_EVENT_PRESSED:
+        ++ev->pressed;
+        break;
+    case LV_EVENT_LONG_PRESSED:
+        ++ev->long_pressed;
+        break;
+    case LV_EVENT_PRESS_LOST:
+        ++ev->press_lost;
+        break;
+    case LV_EVENT_RELEASED:
+        ++ev->released;
+        break;
+    case LV_EVENT_CLICKED:
+        ++ev->clicked;
+        break;
+    default:
+        break;
+    }
+}
+
+class TouchHoldFixture : public LVGLTestFixture {
+  public:
+    TouchHoldFixture() {
+        s_finger = Finger{};
+        touch = lv_indev_create();
+        lv_indev_set_type(touch, LV_INDEV_TYPE_POINTER);
+        lv_indev_set_read_cb(touch, finger_read);
+        // Read by hand below, one reading per tick step
+        lv_timer_pause(lv_indev_get_read_timer(touch));
+        helix::TouchCalibration cal; // not valid: points pass through
+        helix::install_calibration_wrapper(touch, context, cal, kTestDisplayWidth,
+                                           kTestDisplayHeight);
+        helix::set_calibration_hold_handler([this]() {
+            ++handler_calls;
+            return handler_takes;
+        });
+
+        button = lv_button_create(test_screen());
+        lv_obj_set_pos(button, 100, 50);
+        lv_obj_set_size(button, 100, 50);
+        lv_obj_add_event_cb(button, count_event, LV_EVENT_ALL, &events);
+        lv_obj_update_layout(test_screen());
+    }
+    ~TouchHoldFixture() override {
+        helix::set_calibration_hold_handler(nullptr);
+        helix::uninstall_calibration_wrapper(touch, context);
+        lv_indev_delete(touch);
+    }
+
+    /// @p ms of readings with the finger down or up
+    void hold(uint32_t ms, bool down) {
+        s_finger.down = down;
+        for (uint32_t t = 0; t < ms; t += kPollMs) {
+            lv_tick_inc(kPollMs);
+            lv_indev_read(touch);
+        }
+    }
+
+    lv_indev_t* touch = nullptr;
+    helix::CalibrationContext context;
+    lv_obj_t* button = nullptr;
+    ButtonEvents events;
+    int handler_calls = 0;
+    bool handler_takes = true;
+};
+
+} // namespace
+
+TEST_CASE_METHOD(TouchHoldFixture,
+                 "Kiln touch hold: a 10 s hold on a button opens calibration, no click",
+                 "[touch][kiln][touch-hold]") {
+    hold(kCalibrationHoldMs - 100, true);
+    CHECK(handler_calls == 0);
+    CHECK(events.pressed == 1);
+    CHECK(events.long_pressed == 1); // the button's own long press still acts
+    CHECK(events.press_lost == 0);
+
+    hold(200, true);
+    CHECK(handler_calls == 1);
+    CHECK(events.press_lost >= 1); // at once, not only at the release
+    CHECK(touch->wait_until_release);
+
+    hold(5000, true);
+    hold(500, false);
+    CHECK(handler_calls == 1);
+    CHECK(events.released == 0);
+    CHECK(events.clicked == 0);
+    CHECK_FALSE(touch->wait_until_release);
+
+    // The next tap after the re-arm time is a plain click again
+    hold(kCalibrationHoldRearmMs, false);
+    hold(80, true);
+    hold(200, false);
+    CHECK(events.clicked == 1);
+    CHECK(handler_calls == 1);
+}
