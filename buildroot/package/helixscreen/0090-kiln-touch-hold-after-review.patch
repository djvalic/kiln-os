+TEST_CASE_METHOD(TouchHoldFixture, "Kiln touch hold: a tap, a long press and a drag stay what they are",
+                 "[touch][kiln][touch-hold]") {
+    hold(80, true);
+    hold(300, false);
+    CHECK(events.clicked == 1);
+
+    hold(500, true);
+    hold(300, false);
+    CHECK(events.long_pressed == 1);
+    CHECK(events.released == 2);
+
+    // A finger dragged around the screen for 15 s
+    s_finger.down = true;
+    for (int i = 0; i < 1500; ++i) {
+        s_finger.at = {static_cast<int32_t>(100 + (i / 20 % 10) * 70), 200};
+        lv_tick_inc(kPollMs);
+        lv_indev_read(touch);
+    }
+    hold(300, false);
+    CHECK(handler_calls == 0);
+}
