+TEST_CASE_METHOD(KilnWebuiFixture, "Kiln webui: not on another build", "[kiln][kiln_webui]") {
+    webui::set_built_in_for_test(false);
+    webui::model().fetch();
+    CHECK(client.rpc_calls.empty());
+    CHECK(subject("kiln_webui_state") == 0);
+}
