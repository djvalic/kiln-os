+TEST_CASE_METHOD(KilnWebuiFixture, "Kiln webui: the GET shows the choice among what Kiln has",
+                 "[kiln][kiln_webui]") {
+    fetched(info(true), webui_object("mainsail"));
+    CHECK(subject("kiln_webui_state") == 1);
+    CHECK(string_subject("kiln_webui_options") == "Fluidd\nMainsail");
+    CHECK(subject("kiln_webui_selected") == 1);
+    CHECK(subject("kiln_webui_busy") == 0);
+
+    fetched(info(true), webui_object("fluidd", json::array({"fluidd"})));
+    CHECK(subject("kiln_webui_state") == 1);
+    CHECK(string_subject("kiln_webui_options") == "Fluidd");
+    CHECK(subject("kiln_webui_selected") == 0);
+
+    // The plugin serves both: greyed
+    fetched(info(true),
+            webui_object("fluidd", json::array({"fluidd", "mainsail"}), "mainsail-kiln"));
+    CHECK(subject("kiln_webui_state") == 2);
+
+    // The feature gone again (a downgrade): hidden
+    fetched(info(false), json::object());
+    CHECK(subject("kiln_webui_state") == 0);
+}
+
+TEST_CASE_METHOD(KilnWebuiFixture, "Kiln webui: a pick posts it and says to reload the page",
+                 "[kiln][kiln_webui]") {
+    fetched(info(true), webui_object("fluidd"));
+
+    webui::model().select(1);
+    REQUIRE(client.rpc_calls.size() == 1);
+    const auto call = client.rpc_calls[0];
+    CHECK(call.method == webui::kSetMethod);
+    CHECK(call.params == json{{"name", "mainsail"}});
+    CHECK(call.timeout_ms == webui::kTimeoutMs);
+    CHECK(webui::model().busy());
+    CHECK(subject("kiln_webui_busy") == 1);
+
+    // A second pick while the first is on its way sends nothing, and a fetch
+    // waits for the answer
+    webui::model().select(0);
+    webui::model().fetch();
+    CHECK(client.rpc_calls.size() == 1);
+
+    call.success_cb(rpc_result(post_answer("mainsail", "fluidd")));
+    drain();
+    CHECK_FALSE(webui::model().busy());
+    CHECK(subject("kiln_webui_busy") == 0);
+    CHECK(subject("kiln_webui_selected") == 1);
+    CHECK(webui::model().state()->webui == "mainsail");
+    CHECK(webui::model().last_message() ==
+          "Web interface is now Mainsail. Reload the printer's page in your browser.");
+}
