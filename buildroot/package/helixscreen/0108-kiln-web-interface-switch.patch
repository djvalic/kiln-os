+    CHECK(webui::model().state()->webui == "fluidd");
+    CHECK(webui::model().last_message() ==
+          "Can't switch the web interface: nginx -t refused the new configuration; nothing "
+          "changed");
+
+    // A timeout too
+    webui::model().select(1);
+    REQUIRE(client.rpc_calls.size() == 2);
+    client.rpc_calls[1].error_cb(MoonrakerError::timeout(webui::kSetMethod, webui::kTimeoutMs));
+    drain();
+    CHECK(subject("kiln_webui_selected") == 0);
+    CHECK_FALSE(webui::model().busy());
+}
