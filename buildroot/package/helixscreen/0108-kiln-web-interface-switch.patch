diff --git a/src/ui/ui_settings_kiln_webui.cpp b/src/ui/ui_settings_kiln_webui.cpp
new file mode 100644
index 0000000000..6bf64a3ac8
--- /dev/null
+++ b/src/ui/ui_settings_kiln_webui.cpp
@@ -0,0 +1,340 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "ui_settings_kiln_webui.h"
+
+#include "ui_settings_kiln_recovery.h"
+#include "ui_toast_manager.h"
+
+#include "app_globals.h"
+#include "core/static_panel_registry.h"
+#include "core/update_queue.h"
+#include "i_moonraker_client.h"
+#include "json_utils.h"
+#include "lvgl/src/others/translation/lv_translation.h"
+#include "moonraker_error.h"
+
+#include <spdlog/fmt/fmt.h>
+#include <spdlog/spdlog.h>
+
+#include <algorithm>
+
+namespace helix::kiln_webui {
+
+namespace {
+
+// The touch screen is the AD5X's own (HELIX_KILN_AD5X, set in
+// buildroot/package/helixscreen/helixscreen.mk); other builds have no
+// kiln_os component to ask.
+#if defined(HELIX_KILN_AD5X)
+constexpr bool kBuiltIn = true;
+#else
+constexpr bool kBuiltIn = false;
+#endif
+
+std::optional<bool> g_built_in_override;
+
+/// The web interfaces Kiln OS knows, the order the row lists them in when
+/// Kiln's own order says nothing
+constexpr const char* kKnown[] = {"fluidd", "mainsail"};
+
+bool known(const std::string& name) {
+    return std::find(std::begin(kKnown), std::end(kKnown), name) != std::end(kKnown);
+}
+
+bool connected(const IMoonrakerClient* client) {
+    return client && client->get_connection_state() == ConnectionState::CONNECTED;
+}
+
+std::string string_field(const json& object, const char* key) {
+    const json* v = json_util::find_member(object, key);
+    return v && v->is_string() ? v->get<std::string>() : std::string();
+}
+
+/// Set @p subject, notifying also when the value is unchanged (a dropdown the
+/// user moved shows its own line until its subject says otherwise).
+void set_and_notify(lv_subject_t* subject, int value) {
+    if (lv_subject_get_int(subject) == value) {
+        lv_subject_notify(subject);
+    } else {
+        lv_subject_set_int(subject, value);
+    }
+}
+
+constexpr uint32_t kToastMs = 6000;
+
+} // namespace
+
+bool built_in() {
+    return g_built_in_override.value_or(kBuiltIn);
+}
+
+void set_built_in_for_test(std::optional<bool> value) {
+    g_built_in_override = value;
+}
+
+std::optional<State> parse_state(const json& result) {
+    if (!result.is_object()) {
+        return std::nullopt;
+    }
+    const json* available = json_util::find_member(result, "available");
+    if (!available || !available->is_array() || !json_util::find_member(result, "webui")) {
+        return std::nullopt;
+    }
+    State s;
+    s.webui = string_field(result, "webui");
+    s.served = string_field(result, "served");
+    for (const auto& item : *available) {
+        if (item.is_string() && known(item.get<std::string>()) &&
+            std::find(s.available.begin(), s.available.end(), item.get<std::string>()) ==
+                s.available.end()) {
+            s.available.push_back(item.get<std::string>());
+        }
+    }
+    s.plugin = string_field(result, "plugin");
+    return s;
+}
+
+bool has_feature(const json& info_result) {
+    const json* features = json_util::find_member(info_result, "features");
+    if (!features || !features->is_array()) {
+        return false;
+    }
+    return std::any_of(features->begin(), features->end(), [](const json& f) {
+        return f.is_string() && f.get<std::string>() == kFeature;
+    });
+}
+
+std::string display_name(const std::string& name) {
+    if (name == "fluidd") {
+        return "Fluidd";
+    }
+    if (name == "mainsail") {
+        return "Mainsail";
+    }
+    return name;
+}
+
+std::string options_text(const State& state) {
+    std::string text;
+    for (const auto& name : state.available) {
+        if (!text.empty()) {
+            text += "\n";
+        }
+        text += display_name(name);
+    }
+    return text;
+}
+
+RowState row_state(const State& state) {
+    if (state.available.empty()) {
+        return RowState::Hidden;
+    }
+    return state.plugin.empty() ? RowState::Switch : RowState::Plugin;
+}
+
+WebuiModel::~WebuiModel() {
+    lifetime_.invalidate();
+    subjects_.deinit_all();
+}
+
+void WebuiModel::init_subjects() {
+    if (subjects_initialized_) {
+        return;
+    }
+    UI_MANAGED_SUBJECT_INT(state_subject_, 0, "kiln_webui_state", subjects_);
+    UI_MANAGED_SUBJECT_STRING(options_, options_buf_, "", "kiln_webui_options", subjects_);
+    UI_MANAGED_SUBJECT_INT(selected_, 0, "kiln_webui_selected", subjects_);
+    UI_MANAGED_SUBJECT_INT(busy_subject_, 0, "kiln_webui_busy", subjects_);
+    UI_MANAGED_SUBJECT_INT(locked_, 1, "kiln_webui_locked", subjects_);
+    subjects_initialized_ = true;
+    // An answer that came before Settings > System was first opened
+    publish();
+}
+
+void WebuiModel::publish() {
+    if (!subjects_initialized_) {
+        return;
+    }
+    if (!state_) {
+        lv_subject_set_int(&state_subject_, static_cast<int>(RowState::Hidden));
+        lv_subject_set_int(&busy_subject_, busy_ ? 1 : 0);
+        return;
+    }
+    const State& s = *state_;
+    const std::string options = options_text(s);
+    if (options != lv_subject_get_string(&options_)) {
+        lv_subject_set_string(&options_, options.c_str());
+    }
+    const auto it = std::find(s.available.begin(), s.available.end(), s.webui);
+    set_and_notify(&selected_,
+                   it == s.available.end() ? 0 : static_cast<int>(it - s.available.begin()));
+    lv_subject_set_int(&busy_subject_, busy_ ? 1 : 0);
+    lv_subject_set_int(&state_subject_, static_cast<int>(row_state(s)));
+}
+
+IMoonrakerClient* WebuiModel::client() const {
+    IMoonrakerClient* c = client_override_ ? client_override_ : get_moonraker_client();
+    return connected(c) ? c : nullptr;
+}
+
+void WebuiModel::fetch() {
+    IMoonrakerClient* c = built_in() && !busy_ ? client() : nullptr;
+    if (!c) {
+        return;
+    }
+    const auto token = lifetime_.token();
+    c->send_jsonrpc(
+        kInfoMethod, json::object(),
+        [this, token](const json& response) {
+            const json* result = json_util::find_member(response, "result");
+            const bool feature = result && has_feature(*result);
+            token.defer("kiln_webui::info", [this, feature]() {
+                if (!feature) {
+                    apply_no_feature();
+                    return;
+                }
+                if (IMoonrakerClient* again = client()) {
+                    get_webui(*again);
+                }
+            });
+        },
+        [](const MoonrakerError& err) {
+            // Not a Kiln OS, or one from before machine.kiln_os.info
+            spdlog::debug("[Kiln webui] {} failed: {}", kInfoMethod, err.message);
+        },
+        0, /*silent=*/true);
+}
+
+void WebuiModel::get_webui(IMoonrakerClient& c) {
+    const auto token = lifetime_.token();
+    c.send_jsonrpc(
+        kGetMethod, json::object(),
+        [this, token](const json& response) {
+            const json* result = json_util::find_member(response, "result");
+            std::optional<State> s = result ? parse_state(*result) : std::nullopt;
+            if (!s) {
+                spdlog::debug("[Kiln webui] Unexpected answer to {}", kGetMethod);
+                return;
+            }
+            token.defer("kiln_webui::state", [this, state = *s]() {
+                if (!busy_) {
+                    apply(state);
+                }
+            });
+        },
+        [](const MoonrakerError& err) {
+            spdlog::debug("[Kiln webui] {} failed: {}", kGetMethod, err.message);
+        },
+        0, /*silent=*/true);
+}
+
+void WebuiModel::select(int index) {
+    if (busy_ || !state_ || row_state(*state_) != RowState::Switch || index < 0 ||
+        index >= static_cast<int>(state_->available.size())) {
+        // Nothing to send: the dropdown shows the choice again
+        publish();
+        return;
+    }
+    const std::string name = state_->available[static_cast<size_t>(index)];
+    // Nothing to do only when it is the choice and also what is served:
+    // where they differ (a plugin put its own line back), the stored one
+    // is sent again and puts them in line
+    if (name == state_->webui && (state_->served.empty() || state_->served == name)) {
+        return;
+    }
+    IMoonrakerClient* c = client();
+    if (!c) {
+        toast_warning(lv_tr("Not connected to the printer"));
+        publish();
+        return;
+    }
+    spdlog::info("[Kiln webui] Web interface {} -> {}", state_->webui, name);
+    busy_ = true;
+    if (subjects_initialized_) {
+        lv_subject_set_int(&busy_subject_, 1);
+    }
+    const auto token = lifetime_.token();
+    c->send_jsonrpc(
+        kSetMethod, json{{"name", name}},
+        [this, token](const json& response) {
+            const json* result = json_util::find_member(response, "result");
+            std::optional<State> s = result ? parse_state(*result) : std::nullopt;
+            const json* changed = result ? json_util::find_member(*result, "changed") : nullptr;
+            const bool was_changed = changed && changed->is_boolean() && changed->get<bool>();
+            token.defer("kiln_webui::set_done", [this, s, was_changed]() {
+                busy_ = false;
+                if (!s) {
+                    spdlog::warn("[Kiln webui] Unexpected answer to {}", kSetMethod);
+                    toast_warning(lv_tr("Failed"));
+                    publish();
+                    return;
+                }
+                apply(*s);
+                if (was_changed) {
+                    toast_success(fmt::format(
+                        fmt::runtime(lv_tr("Web interface is now {}. Reload the printer's page "
+                                           "in your browser.")),
+                        display_name(s->webui)));
+                }
+            });
+        },
+        [this, token](const MoonrakerError& err) {
+            spdlog::warn("[Kiln webui] Refused ({}, {}): {}", err.code, err.kiln_reason(),
+                         err.message);
+            const bool plugin = err.kiln_reason() == kPluginReason;
+            const std::string text = helix::kiln_recovery::refusal_text(err.message);
+            token.defer("kiln_webui::set_refused", [this, plugin, text]() {
+                busy_ = false;
+                if (plugin && state_) {
+                    // The plugin turned on since the last GET: grey the row
+                    state_->plugin = "mainsail-kiln";
+                    toast_warning(lv_tr("Managed by the mainsail-kiln plugin"));
+                } else {
+                    toast_warning(fmt::format(fmt::runtime(lv_tr("Can't switch the web "
+                                                                 "interface: {}")),
+                                              text.empty() ? std::string(lv_tr("Failed")) : text));
+                }
+                // The choice back as Kiln last said it
+                publish();
+            });
+        },
+        kTimeoutMs, /*silent=*/true);
+}
+
+void WebuiModel::apply(const State& state) {
+    state_ = state;
+    publish();
+}
+
+void WebuiModel::apply_no_feature() {
+    state_.reset();
+    publish();
+}
+
+void WebuiModel::toast_success(const std::string& text) {
+    last_message_ = text;
+    ToastManager::instance().show(ToastSeverity::SUCCESS, text.c_str(), kToastMs);
+}
+
+void WebuiModel::toast_warning(const std::string& text) {
+    last_message_ = text;
+    ToastManager::instance().show(ToastSeverity::WARNING, text.c_str(), kToastMs);
+}
+
+void WebuiModel::reset_for_test() {
+    lifetime_.invalidate();
+    state_.reset();
+    busy_ = false;
+    last_message_.clear();
+    if (subjects_initialized_) {
+        lv_subject_set_string(&options_, "");
+        lv_subject_set_int(&selected_, 0);
+    }
+    publish();
+}
+
+WebuiModel& model() {
+    return helix::lazy_global<WebuiModel>("KilnWebuiModel");
+}
+
+} // namespace helix::kiln_webui
