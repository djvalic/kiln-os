+TEST_CASE("Kiln webui: Kiln's object is read field by field", "[kiln][kiln_webui]") {
+    const auto s = webui::parse_state(webui_object("mainsail"));
+    REQUIRE(s.has_value());
+    CHECK(s->webui == "mainsail");
+    CHECK(s->served == "mainsail");
+    CHECK(s->available == std::vector<std::string>{"fluidd", "mainsail"});
+    CHECK(s->plugin.empty());
+    CHECK(webui::options_text(*s) == "Fluidd\nMainsail");
+    CHECK(webui::row_state(*s) == webui::RowState::Switch);
+
+    // Only the ones this printer has, and no names Kiln OS doesn't know
+    const auto one = webui::parse_state(webui_object("fluidd", json::array({"fluidd", "octo"})));
+    REQUIRE(one.has_value());
+    CHECK(one->available == std::vector<std::string>{"fluidd"});
+    CHECK(webui::options_text(*one) == "Fluidd");
+
+    const auto plugin = webui::parse_state(
+        webui_object("mainsail", json::array({"fluidd", "mainsail"}), "mainsail-kiln"));
+    REQUIRE(plugin.has_value());
+    CHECK(plugin->plugin == "mainsail-kiln");
+    CHECK(webui::row_state(*plugin) == webui::RowState::Plugin);
+
+    const auto none = webui::parse_state(webui_object("fluidd", json::array()));
+    REQUIRE(none.has_value());
+    CHECK(webui::row_state(*none) == webui::RowState::Hidden);
+
+    CHECK_FALSE(webui::parse_state(json::object()).has_value());
+    CHECK_FALSE(webui::parse_state(json::array()).has_value());
+    CHECK_FALSE(webui::parse_state(json{{"webui", "fluidd"}}).has_value());
+
+    CHECK(webui::has_feature(info(true)));
+    CHECK_FALSE(webui::has_feature(info(false)));
+    CHECK_FALSE(webui::has_feature(json::object()));
+    CHECK(webui::display_name("fluidd") == "Fluidd");
+    CHECK(webui::display_name("mainsail") == "Mainsail");
+}
