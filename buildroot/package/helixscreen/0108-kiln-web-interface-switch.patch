new file mode 100644
index 0000000000..74c07add93
--- /dev/null
+++ b/include/ui_settings_kiln_webui.h
@@ -0,0 +1,179 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * @file ui_settings_kiln_webui.h
+ * @brief Kiln OS: Settings > System > Web interface (Fluidd or Mainsail)
+ *
+ * The printer's address in a browser opens Fluidd or Mainsail, one at a time
+ * (Kiln's docs/web-interface.md). Moonraker's kiln_os component answers:
+ *
+ * - `GET /machine/kiln_os/info` (`machine.kiln_os.info`): its `features`
+ *   list holds `webui` on a Kiln OS that has the switch. Without it nothing
+ *   else is asked and the row stays hidden.
+ * - `GET /machine/kiln_os/webui` (`machine.kiln_os.get_webui`): {webui,
+ *   default, served, available, versions, plugin, update_entries,
+ *   moonraker_restart_needed}. webui: the choice, fluidd or mainsail;
+ *   available: the ones this printer has; plugin: "mainsail-kiln" while that
+ *   community plugin serves both and picks port 80 itself.
+ * - `POST /machine/kiln_os/webui` with name (`machine.kiln_os.post_webui`):
+ *   Kiln's root agent switches nginx (a second, no restart, allowed while
+ *   printing) and answers the GET object plus {previous, changed, message}.
+ *   Errors carry their reason: 400 bad_parameter, 409 not_available or
+ *   plugin_manages_webui, 500 agent_failed, 503 agent_timeout or
+ *   agent_unavailable.
+ *
+ * The state is fetched in the discovery sequence (every connect and Klipper
+ * restart) and each time Settings > System opens. The row lists only the
+ * interfaces in `available` and shows the choice; a pick POSTs it with the
+ * control greyed until Kiln answers. Done: a toast says the new one and to
+ * reload the page in the browser. plugin_manages_webui (or `plugin` in the
+ * GET): the row is shown greyed, "Managed by the mainsail-kiln plugin". Any
+ * other error: the error in a toast and the choice back as it was. The row
+ * is behind Settings > Advanced settings (patch 0107's binding).
+ *
+ * HELIX_KILN_AD5X builds only: elsewhere nothing is asked and the row stays
+ * hidden.
+ *
+ * @threading Main thread; Moonraker's answers hop over through lifetime tokens
+ */
+
+#pragma once
+
+#include "async_lifetime_guard.h"
+#include "json_fwd.h"
+#include "lvgl/lvgl.h"
+#include "subject_managed_panel.h"
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace helix {
+class IMoonrakerClient;
+}
+
+namespace helix::kiln_webui {
+
+/// The JSON-RPC method of GET /machine/kiln_os/info
+inline constexpr const char* kInfoMethod = "machine.kiln_os.info";
+
+/// The JSON-RPC method of GET /machine/kiln_os/webui
+inline constexpr const char* kGetMethod = "machine.kiln_os.get_webui";
+
+/// The JSON-RPC method of POST /machine/kiln_os/webui
+inline constexpr const char* kSetMethod = "machine.kiln_os.post_webui";
+
+/// The feature name in machine.kiln_os.info's features
+inline constexpr const char* kFeature = "webui";
+
+/// The reason Kiln refuses a switch while the mainsail-kiln plugin serves both
+inline constexpr const char* kPluginReason = "plugin_manages_webui";
+
+/// The POST waits for Kiln's update agent (up to 30 s); a little more here
+inline constexpr uint32_t kTimeoutMs = 45000;
+
+/// What the row shows: kiln_webui_state's values
+enum class RowState : int { Hidden = 0, Switch = 1, Plugin = 2 };
+
+/// True on HELIX_KILN_AD5X builds; tests override it.
+bool built_in();
+void set_built_in_for_test(std::optional<bool> value);
+
+/// Kiln's web interface object
+struct State {
+    std::string webui;                  ///< the choice
+    std::string served;                 ///< what nginx serves (empty: unknown)
+    std::vector<std::string> available; ///< known names only, in Kiln's order
+    std::string plugin;                 ///< empty: none
+};
+
+/// The object (a JSON-RPC result); nullopt when @p result is not one.
+/// Names other than fluidd and mainsail are left out of available.
+std::optional<State> parse_state(const nlohmann::json& result);
+
+/// Whether machine.kiln_os.info's result lists the webui feature
+bool has_feature(const nlohmann::json& info_result);
+
+/// "Fluidd" or "Mainsail" (product names, the same in every language)
+std::string display_name(const std::string& name);
+
+/// The dropdown's options: one display name per line, in available's order
+std::string options_text(const State& state);
+
+/// What the row shows for @p state
+RowState row_state(const State& state);
+
+/// The Web interface row.
+///
+/// Subjects: `kiln_webui_state` (RowState), `kiln_webui_options` (string,
+/// the dropdown's lines), `kiln_webui_selected` (the choice's line),
+/// `kiln_webui_busy` (1 while a switch is on its way: the control greys) and
+/// `kiln_webui_locked` (always 1: greys the plugin-managed row).
+class WebuiModel {
+  public:
+    WebuiModel() = default;
+    ~WebuiModel();
+    WebuiModel(const WebuiModel&) = delete;
+    WebuiModel& operator=(const WebuiModel&) = delete;
+
+    void init_subjects();
+
+    /// Ask Kiln: the features, then the web interface object (nothing off a
+    /// Kiln build, without a connection, or while a switch is on its way).
+    void fetch();
+
+    /// The dropdown picked line @p index: POST it. Nothing for the current
+    /// one, before Kiln has answered, or while a switch is on its way.
+    void select(int index);
+
+    /// Kiln's answer: the subjects
+    void apply(const State& state);
+
+    /// Kiln's features did not list webui (an older Kiln OS): hide the row
+    void apply_no_feature();
+
+    const std::optional<State>& state() const {
+        return state_;
+    }
+    bool busy() const {
+        return busy_;
+    }
+    /// The last toast's text (tests)
+    const std::string& last_message() const {
+        return last_message_;
+    }
+
+    /// Tests: forget the state (the subjects stay).
+    void reset_for_test();
+    /// Tests: the client the requests go over; nullptr: the screen's own.
+    void set_client_for_test(IMoonrakerClient* client) {
+        client_override_ = client;
+    }
+
+  private:
+    void publish();
+    void get_webui(IMoonrakerClient& c);
+    void toast_success(const std::string& text);
+    void toast_warning(const std::string& text);
+    IMoonrakerClient* client() const;
+
+    SubjectManager subjects_;
+    helix::Subject state_subject_{};
+    helix::Subject options_{};
+    helix::Subject selected_{};
+    helix::Subject busy_subject_{};
+    helix::Subject locked_{};
+    char options_buf_[64] = {};
+    bool subjects_initialized_ = false;
+
+    std::optional<State> state_;
+    bool busy_ = false;
+    std::string last_message_;
+    IMoonrakerClient* client_override_ = nullptr;
+    AsyncLifetimeGuard lifetime_;
+};
+
+WebuiModel& model();
+
+} // namespace helix::kiln_webui
