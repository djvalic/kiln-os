+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Kiln OS: Settings > System > Web interface. Moonraker's kiln_os component
+// lists the webui feature in machine.kiln_os.info and answers
+// machine.kiln_os.get_webui and machine.kiln_os.post_webui with {webui,
+// default, served, available, versions, plugin, update_entries,
+// moonraker_restart_needed} (the POST adds previous, changed, message). A
+// refusal is an error whose data carries the reason.
+
+#include "ui_panel_settings.h"
+#include "ui_settings_kiln_webui.h"
+#include "ui_settings_system.h"
+
+#include "../../src/ui/panel_widgets/shutdown_widget.h"
+#include "../fake_moonraker_client.h"
+#include "../lvgl_ui_test_fixture.h"
+#include "../test_helpers/widget_in_tree.h"
+#include "core/update_queue.h"
+#include "helix-xml/src/xml/lv_xml.h"
+#include "moonraker_error.h"
+#include "settings_manager.h"
+#include "system_settings_manager.h"
+
+#include <string>
+
+#include "../catch_amalgamated.hpp"
+
+using helix::test::FakeMoonrakerClient;
+using nlohmann::json;
+namespace webui = helix::kiln_webui;
+
+namespace {
+
+json info(bool with_webui) {
+    json features = json::array({"ifs", "soak", "plugins", "memory"});
+    if (with_webui) {
+        features.push_back("webui");
+    }
+    return json{{"os_version", "v1.0.1"}, {"api_version", "1.12"}, {"features", features}};
+}
+
+json webui_object(const char* choice, json available = json::array({"fluidd", "mainsail"}),
+                  json plugin = nullptr, json served = nullptr) {
+    return json{{"webui", choice},
+                {"default", "fluidd"},
+                {"served", served.is_null() ? json(choice) : served},
+                {"available", available},
+                {"versions", {{"fluidd", "v1.38.0"}, {"mainsail", "v2.19.0"}}},
+                {"plugin", plugin},
+                {"update_entries", json::array({choice})},
+                {"moonraker_restart_needed", false}};
+}
+
+json post_answer(const char* choice, const char* previous) {
+    json o = webui_object(choice);
+    o["previous"] = previous;
+    o["changed"] = std::string(choice) != previous;
+    o["message"] = "Mainsail on port 80; reload the page in the browser";
+    return o;
+}
+
+json rpc_result(const json& result) {
+    return json{{"jsonrpc", "2.0"}, {"result", result}};
+}
+
+MoonrakerError refusal(int code, const char* reason, const char* text) {
+    return MoonrakerError::from_json_rpc({{"code", code},
+                                          {"message", std::string("[") + reason + "] " + text},
+                                          {"data", {{"reason", reason}}}},
+                                         webui::kSetMethod);
+}
+
+int subject(const char* name) {
+    lv_subject_t* s = lv_xml_get_subject(nullptr, name);
+    REQUIRE(s != nullptr);
+    return lv_subject_get_int(s);
+}
+
+std::string string_subject(const char* name) {
+    lv_subject_t* s = lv_xml_get_subject(nullptr, name);
+    REQUIRE(s != nullptr);
+    return lv_subject_get_string(s);
+}
+
+struct KilnWebuiFixture : LVGLUITestFixture {
+    FakeMoonrakerClient client;
+
+    KilnWebuiFixture() {
+        webui::set_built_in_for_test(true);
+        webui::model().init_subjects();
+        webui::model().set_client_for_test(&client);
+        webui::model().reset_for_test();
+    }
+
+    ~KilnWebuiFixture() override {
+        webui::model().reset_for_test();
+        webui::model().set_client_for_test(nullptr);
+        webui::set_built_in_for_test(std::nullopt);
+        drain();
+    }
+
+    static void drain() {
+        helix::ui::UpdateQueue::instance().drain();
+    }
+
+    /// Fetch; Kiln answers the info with @p info_result and, when it asks,
+    /// the web interface with @p result
+    void fetched(const json& info_result, const json& result) {
+        client.rpc_calls.clear();
+        webui::model().fetch();
+        REQUIRE(client.rpc_calls.size() == 1);
+        CHECK(client.rpc_calls[0].method == webui::kInfoMethod);
+        client.rpc_calls[0].success_cb(rpc_result(info_result));
+        drain();
+        if (client.rpc_calls.size() == 2) {
+            CHECK(client.rpc_calls[1].method == webui::kGetMethod);
+            client.rpc_calls[1].success_cb(rpc_result(result));
+            drain();
+        }
+        client.rpc_calls.clear();
+    }
+};
+
+/// The System page built as the overlay builds it, for the row's bindings
+struct WebuiPageFixture : KilnWebuiFixture {
+    lv_obj_t* root_ = nullptr;
+    bool advanced_before_ = true;
+
+    WebuiPageFixture() {
+        SettingsManager::instance().init_subjects();
+        get_global_settings_panel().init_subjects();
+        advanced_before_ = SystemSettingsManager::instance().get_advanced_settings();
+        SystemSettingsManager::instance().set_advanced_settings(true);
+        helix::deinit_kiln_power_lock_subject();
+        helix::init_kiln_power_lock_subject(state(), /*register_xml=*/true);
+        helix::settings::get_system_settings_overlay().init_subjects();
+        helix::settings::get_system_settings_overlay().register_callbacks();
+        root_ = static_cast<lv_obj_t*>(
+            lv_xml_create(test_screen(), "settings_system_overlay", nullptr));
+        REQUIRE(root_ != nullptr);
+        process_lvgl(5);
+    }
+
+    ~WebuiPageFixture() override {
+        if (root_ && helix::test::widget_in_tree(root_)) {
+            lv_obj_delete(root_);
+        }
+        SystemSettingsManager::instance().set_advanced_settings(advanced_before_);
+        drain();
+        helix::deinit_kiln_power_lock_subject();
+        get_global_settings_panel().deinit_subjects();
+        drain();
+    }
+
+    lv_obj_t* find(const char* name) const {
+        lv_obj_t* obj = lv_obj_find_by_name(root_, name);
+        REQUIRE(obj != nullptr);
+        return obj;
+    }
+
+    lv_obj_t* dropdown(const char* row) const {
+        lv_obj_t* d = lv_obj_find_by_name(find(row), "dropdown");
+        REQUIRE(d != nullptr);
+        return d;
+    }
+
+    std::string options(const char* row) const {
+        return lv_dropdown_get_options(dropdown(row));
+    }
+};
