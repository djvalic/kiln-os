+TEST_CASE_METHOD(KilnWebuiFixture,
+                 "Kiln webui: an older Kiln without the feature asks nothing more",
+                 "[kiln][kiln_webui]") {
+    webui::model().fetch();
+    REQUIRE(client.rpc_calls.size() == 1);
+    CHECK(client.rpc_calls[0].method == webui::kInfoMethod);
+    client.rpc_calls[0].success_cb(rpc_result(info(false)));
+    drain();
+    CHECK(client.rpc_calls.size() == 1); // no get_webui
+    CHECK(subject("kiln_webui_state") == 0);
+    CHECK_FALSE(webui::model().state().has_value());
+
+    // A Kiln OS older still, without machine.kiln_os.info
+    client.rpc_calls.clear();
+    webui::model().fetch();
+    REQUIRE(client.rpc_calls.size() == 1);
+    client.rpc_calls[0].error_cb(MoonrakerError::from_json_rpc(
+        {{"code", -32601}, {"message", "Method not found"}}, webui::kInfoMethod));
+    drain();
+    CHECK(subject("kiln_webui_state") == 0);
+}
