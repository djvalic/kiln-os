+    CHECK_FALSE(lv_obj_is_hidden(find("row_kiln_webui_plugin")));
+    CHECK(lv_obj_has_state(dropdown("row_kiln_webui_plugin"), LV_STATE_DISABLED));
+    CHECK(lv_dropdown_get_selected(dropdown("row_kiln_webui_plugin")) == 1);
+
+    // Only Fluidd on this printer: one line
+    fetched(info(true), webui_object("fluidd", json::array({"fluidd"})));
+    process_lvgl(5);
+    CHECK(options("row_kiln_webui") == "Fluidd");
+}
