+    webui::model().select(5);
+    webui::model().select(-1);
+    CHECK(client.rpc_calls.empty());
+}
+
+TEST_CASE_METHOD(KilnWebuiFixture,
+                 "Kiln webui: the choice while another is served is sent again",
+                 "[kiln][kiln_webui]") {
+    // The choice mainsail, but nginx serves Fluidd (a plugin put its line
+    // back): tapping Mainsail re-applies it
+    fetched(info(true),
+            webui_object("mainsail", json::array({"fluidd", "mainsail"}), nullptr, "fluidd"));
+    CHECK(webui::model().state()->served == "fluidd");
+    webui::model().select(1);
+    REQUIRE(client.rpc_calls.size() == 1);
+    CHECK(client.rpc_calls[0].method == webui::kSetMethod);
+    CHECK(client.rpc_calls[0].params == json{{"name", "mainsail"}});
+    client.rpc_calls[0].success_cb(rpc_result(post_answer("mainsail", "mainsail")));
+    drain();
+    CHECK_FALSE(webui::model().busy());
+
+    // served unknown (null): the choice alone counts, nothing is sent
+    client.rpc_calls.clear();
+    json unknown = webui_object("mainsail");
+    unknown["served"] = nullptr;
+    fetched(info(true), unknown);
+    CHECK(webui::model().state()->served.empty());
+    webui::model().select(1);
+    CHECK(client.rpc_calls.empty());
+}
+
+TEST_CASE_METHOD(KilnWebuiFixture, "Kiln webui: no pick before Kiln has answered",
+                 "[kiln][kiln_webui]") {
+    webui::model().select(1);
