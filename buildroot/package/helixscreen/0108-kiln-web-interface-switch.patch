+TEST_CASE_METHOD(KilnWebuiFixture, "Kiln webui: a refusal shows why and puts the choice back",
+                 "[kiln][kiln_webui]") {
+    fetched(info(true), webui_object("fluidd"));
+    webui::model().select(1);
+    REQUIRE(client.rpc_calls.size() == 1);
+    client.rpc_calls[0].error_cb(
+        refusal(500, "agent_failed", "nginx -t refused the new configuration; nothing changed"));
+    drain();
+    CHECK_FALSE(webui::model().busy());
+    CHECK(subject("kiln_webui_busy") == 0);
+    CHECK(subject("kiln_webui_selected") == 0);
