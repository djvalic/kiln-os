diff --git a/src/printer/ams_state.cpp b/src/printer/ams_state.cpp
index 0e72d12..d05d0f5 100644
--- a/src/printer/ams_state.cpp
+++ b/src/printer/ams_state.cpp
@@ -1482,9 +1482,11 @@ bool AmsState::write_slot_subjects(AmsBackend& backend, int slot_index, const Sl
         changed = true;
     }
 
-    // Measured remaining length, "" when the backend publishes none. The slot
-    // shows it under its material; weight has its own surfaces.
-    std::string remaining = slot.remaining_length_display();
+    // What is left, under the material: grams for a slot linked to a Spoolman
+    // spool (its weight comes from the poll), else the measured length, "" when
+    // the backend publishes neither. Unlinked slots are unchanged.
+    std::string remaining = slot.spoolman_id > 0 ? slot.remaining_summary()
+                                                 : slot.remaining_length_display();
     if (strcmp(lv_subject_get_string(&slot_remaining_[slot_index]), remaining.c_str()) != 0) {
         lv_subject_copy_string(&slot_remaining_[slot_index], remaining.c_str());
     }
