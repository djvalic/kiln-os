 include/ui_settings_about.h       |  4 +-
 src/system/kiln_hardware.cpp      | 42 +++++++--------
 src/ui/ui_settings_about.cpp      | 41 +++++++++++---
 tests/unit/test_kiln_hardware.cpp | 90 +++++++++++++++++++++++++++----
 translations/en.yml               |  6 +++
 translations/ru.yml               |  6 +++
 7 files changed, 179 insertions(+), 51 deletions(-)

diff --git a/include/system/kiln_hardware.h b/include/system/kiln_hardware.h
index bd2bf242..1bd1af9b 100644
--- a/include/system/kiln_hardware.h
+++ b/include/system/kiln_hardware.h
@@ -14,6 +14,14 @@
  * check. Ingenic's 6.6 kernel has no driver for the eFuse; there the variant
  * is unknown, and the RAM size comes from Kiln's boot loader (ad5x.ram= on
  * the kernel command line) when it gave one.
+ *
+ * The cell is readable by root only: kernel patch 0085 makes the X2600's
+ * eFuse root-only, since it also holds the chip ID. HelixScreen runs as
+ * root on Kiln OS; if it ever stops doing so, the read fails and the row
+ * falls back to the 6.6 form (variant unknown).
+ *
+ * This module only reads and decodes. The About panel turns the fields into
+ * the translated row text, so nothing here depends on LVGL.
  */
 
 #include <cstdint>
@@ -38,30 +46,47 @@ struct SocInfo {
  */
 std::optional<SocInfo> decode_socinfo(const std::string& raw);
 
-/// Ingenic's name for the variant ("X2600E", "X2600H", ...), or "X2600 variant N"
+/**
+ * @brief Ingenic's name for the variant ("X2600E", "X2600H", ...).
+ *
+ * "" for codes 7 and up: Ingenic lists 0-6, the same limit as U-Boot's
+ * X2600_SOC_KNOWN (u-boot patch 0029).
+ */
 std::string variant_name(unsigned variant);
 
 /**
  * @brief The board's RAM in MiB from ad5x.ram= in @p cmdline.
  *
  * 256 or 512; nullopt without one, for other values, or when it is given
- * twice with different values.
+ * twice with different values. This is deliberately bl_variant's rule in
+ * buildroot/package/ad5x-system/lib/bootloader.sh (any value other than
+ * one 256 or one 512 is unknown), not mem_hw_mib's in lib/memory.sh, where
+ * the last ad5x.ram= wins: the row names the board, so a command line that
+ * disagrees with itself shows no size rather than a guess.
  */
 std::optional<unsigned> boot_loader_ram_mib(const std::string& cmdline);
 
 /// The core's revision from /proc/cpuinfo ("0.0" from "... XBurst II V0.0"), or ""
 std::string core_revision(const std::string& cpuinfo);
 
+/// What the processor row shows
+struct ProcessorInfo {
+    /// From the eFuse (Kiln's 7.3 kernel); nullopt without the driver, when
+    /// the cell can't be read, or when its two copies differ
+    std::optional<SocInfo> soc;
+    /// Without the eFuse only: ad5x.ram= from Kiln's boot loader; 0 none
+    unsigned boot_loader_ram_mib = 0;
+    /// The core revision ("0.0"); "" when /proc/cpuinfo doesn't say
+    std::string core;
+};
+
 /**
- * @brief The processor row: "X2600E, 256 MiB DDR3, SoC ID 0x18000, core 0.0".
- *
- * Without the eFuse: "X2600, 256 MiB, variant unknown, core 0.0", the size
- * from the boot loader if it gave one.
+ * @brief The processor row's fields.
  *
  * @p root is the test seam: the files are read below it (/sys, /proc).
- * "" when the machine is not an X2600.
+ * nullopt when the machine is not an X2600.
  */
-std::string processor_summary(const std::string& root = "");
+std::optional<ProcessorInfo> read_processor(const std::string& root = "");
 
 /// What the eMMC row shows
 struct EmmcInfo {
