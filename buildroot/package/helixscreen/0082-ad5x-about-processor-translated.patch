 #include <array>
 #include <cctype>
 #include <filesystem>
@@ -30,8 +28,11 @@ std::string read_trimmed(const std::string& path) {
 std::string read_socinfo_cell(const std::string& root) {
     std::error_code ec;
     const std::filesystem::path devices = root + "/sys/bus/nvmem/devices";
-    for (const auto& dev : std::filesystem::directory_iterator(devices, ec)) {
-        const auto cell = dev.path() / "cells" / "socinfo@6b,0";
