         UI_MANAGED_SUBJECT_STRING(emmc_value_subject_, emmc_value_buf_, "", "about_emmc_value",
                                   subjects_);
-        UI_MANAGED_SUBJECT_INT(has_processor_subject_, processor.empty() ? 0 : 1,
+        UI_MANAGED_SUBJECT_INT(has_processor_subject_, kiln_processor_ ? 1 : 0,
                                "about_has_processor", subjects_);
         UI_MANAGED_SUBJECT_INT(has_emmc_subject_, kiln_emmc_ ? 1 : 0, "about_has_emmc",
                                subjects_);
@@ -312,6 +310,29 @@ void AboutSettingsOverlay::setup_contributor_marquee() {
 
 namespace {
 
+// Kiln OS: the processor row, "X2600E, 256 MiB DDR3, SoC ID 0x18000, core 0.0",
+// or without the eFuse "X2600, 256 MiB, variant unknown, core 0.0". The words
+// are translated; the identifiers (chip names, DDR2/DDR3, SoC ID) are not.
+std::string kiln_processor_text(const helix::kiln_hardware::ProcessorInfo& p) {
+    const std::string core =
+        p.core.empty() ? std::string() : fmt::format(fmt::runtime(lv_tr(", core {}")), p.core);
+    if (p.soc) {
+        std::string name = helix::kiln_hardware::variant_name(p.soc->variant);
+        if (name.empty()) {
+            name = fmt::format(fmt::runtime(lv_tr("X2600, variant unknown ({})")), p.soc->variant);
+        }
+        const char* type = p.soc->ddr3 ? "DDR3" : "DDR2";
+        const std::string ram =
+            p.soc->ram_mib ? fmt::format(fmt::runtime(lv_tr("{} MiB {}")), p.soc->ram_mib, type)
+                           : fmt::format(fmt::runtime(lv_tr("{}, size unknown")), type);
+        return fmt::format("{}, {}, SoC ID 0x{:05x}{}", name, ram, p.soc->id, core);
+    }
+    const std::string ram = p.boot_loader_ram_mib
+                                ? fmt::format(fmt::runtime(lv_tr(", {} MiB")), p.boot_loader_ram_mib)
+                                : std::string();
+    return fmt::format(fmt::runtime(lv_tr("X2600{}, variant unknown{}")), ram, core);
+}
+
 // Kiln OS: the eMMC row, "A31M8C (maker 0xEC), PRV 0x30, 58.2 GiB". The words
 // are translated; the identifiers (the name, PRV) are not.
 std::string kiln_emmc_text(const helix::kiln_hardware::EmmcInfo& e) {
@@ -344,7 +365,11 @@ void AboutSettingsOverlay::populate_info_rows() {
     lv_subject_copy_string(&printer_value_subject_, printer_name.c_str());
     spdlog::trace("[{}] Printer: {}", get_name(), printer_name);
 
-    // Kiln OS: the eMMC, in the current language
+    // Kiln OS: processor and eMMC, in the current language
+    if (kiln_processor_) {
+        lv_subject_copy_string(&processor_value_subject_,
+                               kiln_processor_text(*kiln_processor_).c_str());
+    }
     if (kiln_emmc_) {
         lv_subject_copy_string(&emmc_value_subject_, kiln_emmc_text(*kiln_emmc_).c_str());
     }
diff --git a/tests/unit/test_kiln_hardware.cpp b/tests/unit/test_kiln_hardware.cpp
index 0d45b227..18ed641d 100644
--- a/tests/unit/test_kiln_hardware.cpp
+++ b/tests/unit/test_kiln_hardware.cpp
@@ -6,6 +6,7 @@
  * The SoC information comes from the eFuse (Kiln's 7.3 kernel, nvmem cell
  * socinfo@6b: 20 bits twice), the eMMC from /sys/block/mmcblk0. Values
  * below are printer 2's: an X2600E with 256 MiB of DDR3 and an A31M8C.
+ * These are the fields; the About panel turns them into translated text.
  */
 
 #include "system/kiln_hardware.h"
@@ -49,6 +50,15 @@ struct Root {
     std::string str() const { return dir.string(); }
 };
 
+// The cell's 5 bytes for a 20-bit SoC ID stored twice
+std::string socinfo_cell(uint32_t id) {
+    const uint64_t bits = uint64_t(id) | (uint64_t(id) << 20);
+    std::string raw;
+    for (int i = 0; i < 5; ++i)
+        raw += static_cast<char>((bits >> (8 * i)) & 0xff);
+    return raw;
+}
+
 void x2600_board(const Root& r) {
     r.put("proc/device-tree/compatible",
           std::string("flashforge,ad5x\0ingenic,x2600\0", 31));
@@ -71,7 +81,9 @@ TEST_CASE("Kiln hardware: the SoC information decodes", "[kiln][hardware]") {
     CHECK(variant_name(4) == "X2660");
     CHECK(variant_name(5) == "X2670");
     CHECK(variant_name(6) == "X2670M");
-    CHECK(variant_name(7) == "X2600 variant 7");
+    // 7 and up: not one of Ingenic's (U-Boot's X2600_SOC_KNOWN); the row says unknown
+    CHECK(variant_name(7).empty());
+    CHECK(variant_name(15).empty());
 }
 
 TEST_CASE("Kiln hardware: a 512 MiB X2600H decodes", "[kiln][hardware]") {
@@ -123,33 +135,89 @@ TEST_CASE("Kiln hardware: the core revision comes from cpuinfo", "[kiln][hardwar
     CHECK(core_revision("cpu model\t: Ingenic XBurst II") == "");
 }
 
-TEST_CASE("Kiln hardware: the processor row", "[kiln][hardware]") {
+TEST_CASE("Kiln hardware: the processor row's fields", "[kiln][hardware]") {
     Root r;
+    const std::string cell = "sys/bus/nvmem/devices/jz4780-efuse0/cells/socinfo@6b,0";
     SECTION("not an X2600: no row") {
         r.put("proc/device-tree/compatible", std::string("rockchip,rk3328\0", 16));
-        CHECK(processor_summary(r.str()).empty());
+        CHECK_FALSE(read_processor(r.str()));
     }
     SECTION("7.3 with the eFuse") {
         x2600_board(r);
-        r.put("sys/bus/nvmem/devices/jz4780-efuse0/cells/socinfo@6b,0", kSocinfoX2600E);
-        CHECK(processor_summary(r.str()) == "X2600E, 256 MiB DDR3, SoC ID 0x18000, core 0.0");
+        r.put(cell, kSocinfoX2600E);
+        // the eFuse wins over the boot loader's word
+        r.put("proc/cmdline", "console=ttyS0,115200n8 ad5x.ram=512\n");
+        const auto p = read_processor(r.str());
+        REQUIRE(p);
+        REQUIRE(p->soc);
+        CHECK(p->soc->id == 0x18000);
+        CHECK(p->soc->variant == 1);
+        CHECK(p->soc->ddr3);
+        CHECK(p->soc->ram_mib == 256);
+        CHECK(p->boot_loader_ram_mib == 0);
+        CHECK(p->core == "0.0");
     }
     SECTION("7.3 with an unknown capacity code") {
         x2600_board(r);
-        r.put("sys/bus/nvmem/devices/jz4780-efuse0/cells/socinfo@6b,0",
-              std::string("\x00\x84\x01\x40\x18", 5));
-        CHECK(processor_summary(r.str()) ==
-              "X2600E, DDR3, size unknown, SoC ID 0x18400, core 0.0");
+        r.put(cell, std::string("\x00\x84\x01\x40\x18", 5));
+        const auto p = read_processor(r.str());
+        REQUIRE(p);
+        REQUIRE(p->soc);
+        CHECK(p->soc->id == 0x18400);
+        CHECK(p->soc->ddr3);
+        CHECK(p->soc->ram_mib == 0);
+    }
+    SECTION("7.3 with a variant code Ingenic doesn't list") {
+        x2600_board(r);
+        r.put(cell, socinfo_cell(0x78000));
+        const auto p = read_processor(r.str());
+        REQUIRE(p);
+        REQUIRE(p->soc);
+        CHECK(p->soc->variant == 7);
+        CHECK(variant_name(p->soc->variant).empty());
+    }
+    SECTION("the cell is found on whichever nvmem device has it") {
+        x2600_board(r);
+        r.put("sys/bus/nvmem/devices/aaa-other0/nvmem", "x");
+        r.put("sys/bus/nvmem/devices/zzz-efuse0/cells/socinfo@6b,0", socinfo_cell(0x38200));
+        const auto p = read_processor(r.str());
+        REQUIRE(p);
+        REQUIRE(p->soc);
+        CHECK(p->soc->variant == 3);
+        CHECK(p->soc->ram_mib == 512);
+    }
+    SECTION("a cell that can't be read falls back to the boot loader's size") {
+        // as when HelixScreen doesn't run as root (the cell is root-only)
+        x2600_board(r);
+        fs::create_directories(r.dir / cell);
+        r.put("proc/cmdline", "ad5x.ram=512\n");
+        const auto p = read_processor(r.str());
+        REQUIRE(p);
+        CHECK_FALSE(p->soc);
+        CHECK(p->boot_loader_ram_mib == 512);
     }
     SECTION("6.6 without an eFuse driver or ad5x.ram=") {
         x2600_board(r);
         r.put("proc/cmdline", "console=ttyS0,115200n8 mem=236M@0x0\n");
-        CHECK(processor_summary(r.str()) == "X2600, variant unknown, core 0.0");
+        const auto p = read_processor(r.str());
+        REQUIRE(p);
+        CHECK_FALSE(p->soc);
+        CHECK(p->boot_loader_ram_mib == 0);
+        CHECK(p->core == "0.0");
     }
     SECTION("6.6 with Kiln's boot loader's ad5x.ram=") {
         x2600_board(r);
         r.put("proc/cmdline", "console=ttyS0,115200n8 ad5x.ram=256 ad5x.memmode=standard\n");
-        CHECK(processor_summary(r.str()) == "X2600, 256 MiB, variant unknown, core 0.0");
+        const auto p = read_processor(r.str());
+        REQUIRE(p);
+        CHECK_FALSE(p->soc);
+        CHECK(p->boot_loader_ram_mib == 256);
+    }
+    SECTION("no cpuinfo: no core revision") {
+        r.put("proc/device-tree/compatible", std::string("ingenic,x2600\0", 14));
+        const auto p = read_processor(r.str());
+        REQUIRE(p);
+        CHECK(p->core.empty());
     }
 }
 
