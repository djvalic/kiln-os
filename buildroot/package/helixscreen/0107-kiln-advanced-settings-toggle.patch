+TEST_CASE_METHOD(
+    AdvancedFixture,
+    "Advanced settings: off hides the advanced rows on a built page, on brings them back",
+    "[settings][settings_advanced]") {
+    for (const auto& split : splits()) {
+        CAPTURE(split.view);
+        build(split.view);
+
+        std::vector<bool> advanced_on;
+        std::vector<bool> everyday_on;
+        for (const char* name : split.advanced)
+            advanced_on.push_back(lv_obj_is_hidden(find(name)));
+        for (const char* name : split.everyday)
+            everyday_on.push_back(lv_obj_is_hidden(find(name)));
+
+        set_advanced(false);
+        for (const char* name : split.advanced) {
+            CAPTURE(name);
+            CHECK(lv_obj_is_hidden(find(name)));
+        }
+        for (size_t i = 0; i < split.everyday.size(); ++i) {
+            CAPTURE(split.everyday[i]);
+            CHECK(lv_obj_is_hidden(find(split.everyday[i])) == everyday_on[i]);
+        }
+
+        set_advanced(true);
+        for (size_t i = 0; i < split.advanced.size(); ++i) {
+            CAPTURE(split.advanced[i]);
+            CHECK(lv_obj_is_hidden(find(split.advanced[i])) == advanced_on[i]);
+        }
+        for (size_t i = 0; i < split.everyday.size(); ++i) {
+            CAPTURE(split.everyday[i]);
+            CHECK(lv_obj_is_hidden(find(split.everyday[i])) == everyday_on[i]);
+        }
+    }
+}
+
+TEST_CASE_METHOD(AdvancedFixture,
+                 "Advanced settings: a row's own gate still hides it with the setting on",
+                 "[settings][settings_advanced]") {
+    build("settings_panel");
+    lv_subject_t* plugins = lv_xml_get_subject(nullptr, "settings_plugins_available");
+    REQUIRE(plugins != nullptr);
+    const int32_t was = lv_subject_get_int(plugins);
+
+    lv_subject_set_int(plugins, 0);
+    process_lvgl(5);
+    CHECK(lv_obj_is_hidden(find("row_plugins")));
+    lv_subject_set_int(plugins, 1);
+    process_lvgl(5);
+    CHECK_FALSE(lv_obj_is_hidden(find("row_plugins")));
+
+    // Off hides it although its own gate would show it
+    set_advanced(false);
+    CHECK(lv_obj_is_hidden(find("row_plugins")));
+    set_advanced(true);
+    CHECK_FALSE(lv_obj_is_hidden(find("row_plugins")));
+
+    lv_subject_set_int(plugins, was);
+    process_lvgl(5);
+}
+
+TEST_CASE_METHOD(AdvancedFixture, "Advanced settings: the root's switch drives the setting",
+                 "[settings][settings_advanced]") {
+    build("settings_panel");
+    auto& sys = SystemSettingsManager::instance();
+    lv_obj_t* row = find("row_advanced_settings");
+    // Its own group, after the HELIXSCREEN group
+    lv_obj_t* group = find("group_advanced");
+    CHECK(lv_obj_get_parent(row) == group);
+    CHECK(lv_obj_get_index(group) > lv_obj_get_index(find("group_helixscreen")));
+
+    lv_obj_t* toggle = lv_obj_find_by_name(row, "toggle");
+    REQUIRE(toggle != nullptr);
+    CHECK(lv_obj_has_state(toggle, LV_STATE_CHECKED));
+
+    lv_obj_remove_state(toggle, LV_STATE_CHECKED);
+    lv_obj_send_event(toggle, LV_EVENT_VALUE_CHANGED, nullptr);
+    helix::ui::UpdateQueue::instance().drain();
+    process_lvgl(5);
+    CHECK_FALSE(sys.get_advanced_settings());
+    CHECK(Config::get_instance()->get<bool>("/advanced_settings", true) == false);
+    CHECK(lv_obj_is_hidden(find("row_touch_input")));
+    CHECK_FALSE(lv_obj_is_hidden(row));
+
+    lv_obj_add_state(toggle, LV_STATE_CHECKED);
+    lv_obj_send_event(toggle, LV_EVENT_VALUE_CHANGED, nullptr);
+    helix::ui::UpdateQueue::instance().drain();
+    process_lvgl(5);
+    CHECK(sys.get_advanced_settings());
+    CHECK(Config::get_instance()->get<bool>("/advanced_settings", false) == true);
+    CHECK_FALSE(lv_obj_is_hidden(find("row_touch_input")));
+}
+
+TEST_CASE_METHOD(AdvancedFixture, "Advanced settings: the switch follows the setting",
+                 "[settings][settings_advanced]") {
+    build("settings_panel");
+    lv_obj_t* toggle = lv_obj_find_by_name(find("row_advanced_settings"), "toggle");
+    REQUIRE(toggle != nullptr);
+    set_advanced(false);
+    CHECK_FALSE(lv_obj_has_state(toggle, LV_STATE_CHECKED));
+    set_advanced(true);
+    CHECK(lv_obj_has_state(toggle, LV_STATE_CHECKED));
+}
