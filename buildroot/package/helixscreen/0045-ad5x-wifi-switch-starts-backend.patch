From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ad5xrecon <ad5xrecon@localhost>
Date: Sun, 8 Nov 2026 12:00:00 -0500
Subject: [PATCH] wifi: the Wi-Fi switch starts a backend that is down (issue #37)

When the backend's start at launch failed (wpa_supplicant not up yet,
or restarted), nothing started it again unless a scan ran, and the
switch answered NOT_INITIALIZED and snapped back. apply_radio_enabled()
now calls backend start() first when switching on with the backend not
running (off the LVGL thread, inside the radio op's 40 s deadline);
start() fires no READY, so the stored-setting reassert can't switch the
radio off again behind the toggle, and state observers are woken here.
The wpa backend's start() is serialized (start_mutex_, as the
NetworkManager backend does) so it can't overlap the async init worker.
No retry timer: a failing start raises a toast or modal each time.
---

diff --git a/include/wifi_backend_wpa_supplicant.h b/include/wifi_backend_wpa_supplicant.h
index 31f998c..9945308 100644
--- a/include/wifi_backend_wpa_supplicant.h
+++ b/include/wifi_backend_wpa_supplicant.h
@@ -528,6 +528,11 @@ class WifiBackendWpaSupplicant : public WifiBackend, private hv::EventLoopThread
     // Async init worker (used by start_async())
     std::thread async_init_thread_;
     std::atomic<bool> async_init_in_progress_{false};
+
+    /// Serializes start(): the async init worker and WiFiManager's radio
+    /// switch (which starts a backend that is down) can call it at the same
+    /// time, and two overlapping inits would each open a monitor connection.
+    std::mutex start_mutex_;
 };
 
 #endif // __APPLE__
diff --git a/include/wifi_manager.h b/include/wifi_manager.h
index 881bb82..646e662 100644
--- a/include/wifi_manager.h
+++ b/include/wifi_manager.h
@@ -611,7 +611,8 @@ class WiFiManager {
 
     // Drives the backend radio change. Blocking, and safe to call from any
     // thread — it touches only backend_, which the destructor barrier below
-    // keeps alive for the duration.
+    // keeps alive for the duration. Switching on starts a backend that is not
+    // running first.
     WiFiError apply_radio_enabled(bool enabled);
 
     // Surfaces a radio failure to the user. Static (and therefore free of any
diff --git a/src/api/wifi_backend_wpa_supplicant.cpp b/src/api/wifi_backend_wpa_supplicant.cpp
index 0710c6a..8cbb778 100644
--- a/src/api/wifi_backend_wpa_supplicant.cpp
+++ b/src/api/wifi_backend_wpa_supplicant.cpp
@@ -485,6 +485,9 @@ WifiBackendWpaSupplicant::~WifiBackendWpaSupplicant() {
 
 WiFiError WifiBackendWpaSupplicant::start() {
     spdlog::debug("[WifiBackend] Starting wpa_supplicant backend...");
+    // One start at a time (the async worker and the radio switch); a second
+    // caller then finds the backend up and returns at once.
+    std::lock_guard<std::mutex> start_lock(start_mutex_);
     shutdown_requested_ = false;
 
     // Pre-flight checks before starting event loop
diff --git a/src/api/wifi_manager.cpp b/src/api/wifi_manager.cpp
index 36a2ca3..d8c1237 100644
--- a/src/api/wifi_manager.cpp
+++ b/src/api/wifi_manager.cpp
@@ -1133,6 +1133,23 @@ WiFiError WiFiManager::apply_radio_enabled(bool enabled) {
     // off, let alone turn it back on. set_radio_enabled() actually asserts
     // the interface down (or blocks it via rfkill) while keeping the control
     // socket alive.
+    //
+    // Switching on with the backend down (its start at launch failed, e.g.
+    // wpa_supplicant was not up yet or was restarted) answered NOT_INITIALIZED
+    // and the switch snapped back, with nothing that would ever start it.
+    // Start it here first. This runs off the LVGL thread (the radio user op,
+    // whose 40 s deadline covers start()'s 5 s init wait). start() fires no
+    // READY, so the startup reassert of the stored setting (still "off" until
+    // this toggle is persisted) does not run behind it and switch the radio
+    // off again; state observers are woken here instead.
+    if (enabled && !backend_->is_running()) {
+        spdlog::info("[WiFiManager] WiFi switched on with the backend down - starting it");
+        WiFiError started = backend_->start();
+        if (!started.success()) {
+            return started;
+        }
+        notify_state_observers(/*country_may_have_changed=*/true);
+    }
     return backend_->set_radio_enabled(enabled);
 }
 
diff --git a/tests/unit/test_wifi_manager.cpp b/tests/unit/test_wifi_manager.cpp
index 482aa5a..c224128 100644
--- a/tests/unit/test_wifi_manager.cpp
+++ b/tests/unit/test_wifi_manager.cpp
@@ -1364,6 +1364,90 @@ struct ToastCounter {
 
 } // namespace
 
+namespace {
+
+/// Answers the radio switch the way the wpa_supplicant backend does when it
+/// is not running (NOT_INITIALIZED), and counts its starts.
+class DownUntilStartedBackend : public WifiBackendMock {
+  public:
+    WiFiError start() override {
+        starts_.fetch_add(1);
+        if (fail_start_.load()) {
+            return WiFiError(WiFiResult::SERVICE_NOT_RUNNING, "no wpa_supplicant socket",
+                             "WiFi service is not running");
+        }
+        return WifiBackendMock::start();
+    }
+    WiFiError set_radio_enabled(bool on) override {
+        if (!is_running()) {
+            return WiFiError(WiFiResult::NOT_INITIALIZED, "Backend not started",
+                             "WiFi system not ready");
+        }
+        return WifiBackendMock::set_radio_enabled(on);
+    }
+    int starts() const {
+        return starts_.load();
+    }
+    void fail_start() {
+        fail_start_ = true;
+    }
+
+  private:
+    std::atomic<int> starts_{0};
+    std::atomic<bool> fail_start_{false};
+};
+
+} // namespace
+
+// Kiln OS (issue #37): a backend whose start failed at launch stayed down, and
+// the WiFi switch answered NOT_INITIALIZED and snapped back for good.
+TEST_CASE("switching WiFi on starts a backend that is not running",
+          "[wifi][manager][radio][wifi_switch_start]") {
+    auto backend = std::make_unique<DownUntilStartedBackend>();
+    DownUntilStartedBackend* raw = backend.get();
+    WiFiManager manager(std::move(backend));
+    helix::ui::UpdateQueue::instance().drain(); // settle the construction reassert
+    raw->stop();
+    REQUIRE_FALSE(raw->is_running());
+    const int starts = raw->starts();
+
+    // Off leaves a stopped backend stopped.
+    ToastCounter toasts;
+    CHECK_FALSE(manager.set_enabled(false));
+    CHECK_FALSE(raw->is_running());
+    CHECK(raw->starts() == starts);
+
+    REQUIRE(manager.set_enabled(true));
+    CHECK(raw->starts() == starts + 1);
+    CHECK(raw->is_running());
+    CHECK(raw->is_radio_enabled());
+    CHECK(manager.is_enabled());
+
+    // Already running: no second start.
+    REQUIRE(manager.set_enabled(true));
+    CHECK(raw->starts() == starts + 1);
+
+    helix::ui::UpdateQueue::instance().drain();
+}
+
+TEST_CASE("switching WiFi on reports a backend start that fails",
+          "[wifi][manager][radio][wifi_switch_start]") {
+    auto backend = std::make_unique<DownUntilStartedBackend>();
+    DownUntilStartedBackend* raw = backend.get();
+    WiFiManager manager(std::move(backend));
+    helix::ui::UpdateQueue::instance().drain();
+    raw->stop();
+    raw->fail_start();
+
+    ToastCounter toasts;
+    CHECK_FALSE(manager.set_enabled(true));
+    CHECK(raw->starts() >= 1);
+    CHECK_FALSE(raw->is_running());
+    CHECK_FALSE(manager.is_enabled());
+
+    helix::ui::UpdateQueue::instance().drain();
+}
+
