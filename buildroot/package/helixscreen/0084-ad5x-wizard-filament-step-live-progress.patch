+            (ifs.tube_blocked || filament.head_source == "tube")) {
+            if (!head.empty()) {
+                head += '\n';
+            }
+            head += lv_tr("A strand is still in the tube: name the slot first");
+        }
+    }
+    const bool head_shown = !head.empty() && view != View::Running &&
+                            view != View::WaitingUser && prompt != Prompt::PickSlot;
+
     copy_if_changed(&message_, message);
     copy_if_changed(&results_, results_text());
     copy_if_changed(&zoffset_, zoffset);
+    copy_if_changed(&plan_, plan);
+    copy_if_changed(&head_, head);
+    set_if_changed(&show_head_, head_shown ? 1 : 0);
+    set_if_changed(&prompt_, static_cast<int>(prompt));
+    set_if_changed(&prompt_wait_, prompt_waits(prompt) ? 1 : 0);
     set_if_changed(&progress_, progress);
     set_if_changed(&view_, static_cast<int>(view));
     update_footer(view);
+    update_live(view);
+    if (card == "filament") {
+        fill_filament_widgets();
+    }
+    if (prompt == Prompt::PickSlot) {
+        fill_pick_widgets();
+    }
+}
+
+void Ad5xSetupModel::update_live(View view) {
+    const bool live = (view == View::Running || view == View::WaitingUser) &&
+                      lv_subject_get_int(&prompt_wait_) == 0;
+    if (!live || !active_) {
+        clock_run_.clear();
+        copy_if_changed(&action_, "");
+        copy_if_changed(&live_, "");
+        return;
+    }
+    const bool mine = str_field(status_, "step") == followed_key() && !start_in_flight_;
+    std::string action;
+    double started = 0.;
+    if (mine) {
+        int arg = 0;
+        if (auto it = status_.find("action_arg"); it != status_.end() && it->is_number()) {
+            arg = static_cast<int>(it->get<double>());
+        }
+        action = action_text(str_field(status_, "action"), arg);
+        if (auto it = status_.find("step_started"); it != status_.end() && it->is_number()) {
+            started = it->get<double>();
+        }
+    }
+    // The screen's own count starts when it first sees this run
+    const std::string run =
+        mine ? fmt::format("{}@{:.1f}", active_->key, started) : std::string("pending");
+    if (run != clock_run_) {
+        clock_run_ = run;
+        clock_seen_ms_ = lv_tick_get();
+    }
+    const long local = static_cast<long>(lv_tick_elaps(clock_seen_ms_) / 1000u);
+    const long seconds =
+        elapsed_seconds(started, static_cast<double>(std::time(nullptr)), local);
+
+    auto& temps = get_printer_state().temperature_state();
+    const std::string text = fmt::format(
+        "{}  \xC2\xB7  {}",
+        temps_text(lv_subject_get_int(temps.get_active_extruder_temp_subject()),
+                   lv_subject_get_int(temps.get_active_extruder_target_subject()),
+                   lv_subject_get_int(temps.get_bed_temp_subject()),
+                   lv_subject_get_int(temps.get_bed_target_subject())),
+        elapsed_text(seconds));
+    copy_if_changed(&action_, action);
+    copy_if_changed(&live_, text);
+}
+
+json Ad5xSetupModel::filament_step_options() const {
+    std::array<std::optional<std::string>, kFilamentSlots> materials;
+    const FilamentStatus filament = parse_filament(status_);
+    for (int n = 0; n < kFilamentSlots; ++n) {
+        lv_obj_t* dd = material_dropdowns_[n].get();
+        // Only what the user picked for a slot with filament; the rest stays
+        if (!dd || !material_picked_[n] || !filament.present[n]) {
+            continue;
+        }
+        const uint32_t i = lv_dropdown_get_selected(dd);
+        if (i < material_choices_[n].size()) {
+            materials[n] = material_choices_[n][i];
+        }
+    }
+    HeadChoice head = head_choices().front().choice;
+    if (lv_obj_t* dd = head_dropdown_.get()) {
+        const uint32_t i = lv_dropdown_get_selected(dd);
+        if (i < head_choices().size()) {
+            head = head_choices()[i].choice;
+        }
+    }
+    json options = filament_options(materials, head);
+    // The slot named on the pick_slot panel wins over the dropdown, once
+    if (!head_override_.empty()) {
+        options["head"] = head_override_;
+    }
+    return options;
+}
+
+void Ad5xSetupModel::bind_filament_widgets(lv_obj_t* root) {
+    for (int n = 0; n < kFilamentSlots; ++n) {
+        material_dropdowns_[n] = lv_obj_find_by_name(root, fmt::format("ad5x_fil_mat_{}", n + 1).c_str());
+        slot_labels_[n] = lv_obj_find_by_name(root, fmt::format("ad5x_fil_slot_{}", n + 1).c_str());
+        if (lv_obj_t* label = slot_labels_[n].get()) {
+            lv_label_set_text(label, fmt::format(fmt::runtime(lv_tr("Slot {}")), n + 1).c_str());
+        }
+        material_choices_[n].clear();
+    }
+    head_dropdown_ = lv_obj_find_by_name(root, "ad5x_fil_head");
+    if (lv_obj_t* dd = head_dropdown_.get()) {
+        lv_dropdown_set_options(dd, head_choice_options().c_str());
+        lv_dropdown_set_selected(dd, 0);
+    }
+    material_picked_ = {};
+    head_picked_ = false;
+    fill_filament_widgets();
+}
+
+void Ad5xSetupModel::fill_filament_widgets() {
+    const FilamentStatus filament = parse_filament(status_);
+    for (int n = 0; n < kFilamentSlots; ++n) {
+        lv_obj_t* dd = material_dropdowns_[n].get();
+        // A pick the user made stays until the card is built again
+        if (!dd || material_picked_[n]) {
+            continue;
+        }
+        auto choices = material_choices(filament.materials[n]);
+        if (choices != material_choices_[n]) {
+            material_choices_[n] = std::move(choices);
+            lv_dropdown_set_options(dd, material_options(material_choices_[n]).c_str());
+        }
+        const uint32_t index = material_index(material_choices_[n], filament.materials[n]);
+        if (lv_dropdown_get_selected(dd) != index) {
+            lv_dropdown_set_selected(dd, index);
+        }
+    }
+}
+
+void Ad5xSetupModel::filament_picked(lv_obj_t* dropdown) {
+    if (!dropdown) {
+        return;
+    }
+    if (dropdown == head_dropdown_.get()) {
+        head_picked_ = true;
+        return;
+    }
+    for (int n = 0; n < kFilamentSlots; ++n) {
+        if (dropdown == material_dropdowns_[n].get()) {
+            material_picked_[n] = true;
+        }
+    }
+}
+
+void Ad5xSetupModel::pick_slot(int slot) {
+    if (!active_ || slot < 0 || slot > kFilamentSlots) {
+        return;
+    }
+    const std::string head = std::to_string(slot);
+    spdlog::info("[AD5X setup] Slot in the toolhead named: {}", slot);
+    if (std::strcmp(active_->key, "filament") == 0) {
+        // The filament step itself: run it again with that slot
+        head_override_ = head;
+        start();
+        return;
+    }
+    // Another step's card (IFS, Z offset): the filament step runs from here
+    // with only the slot; the card follows it, then offers its own Start
+    const json options = {{"head", head}};
+    start_in_flight_ = true;
+    local_error_.clear();
+    aux_key_ = "filament";
+    refresh();
+    send("start", 0.0, aux_key_, &options);
+}
+
+void Ad5xSetupModel::bind_pick_widgets(lv_obj_t* root) {
+    for (int n = 0; n < kFilamentSlots; ++n) {
+        pick_buttons_[n] = lv_obj_find_by_name(root, fmt::format("btn_ad5x_pick_{}", n + 1).c_str());
+        pick_swatches_[n] = lv_obj_find_by_name(root, fmt::format("ad5x_pick_swatch_{}", n + 1).c_str());
+    }
+    fill_pick_widgets();
+}
+
+void Ad5xSetupModel::fill_pick_widgets() {
+    const FilamentStatus filament = parse_filament(status_);
+    const IfsFindStatus ifs = parse_ifs_find(ifs_status_);
+    for (int n = 0; n < kFilamentSlots; ++n) {
+        if (lv_obj_t* btn = pick_buttons_[n].get()) {
+            ui_button_set_text(btn, pick_slot_label(n + 1, filament.materials[n]).c_str());
+        }
+        if (lv_obj_t* sw = pick_swatches_[n].get()) {
+            // The spool's colour helps match the slot to the tube; none known: hidden
+            const auto rgb = helix::parse_hex_color(ifs.colors[n]);
+            if (rgb) {
+                lv_obj_set_style_bg_color(sw, lv_color_hex(*rgb), LV_PART_MAIN);
+                lv_obj_remove_flag(sw, LV_OBJ_FLAG_HIDDEN);
+            } else {
+                lv_obj_add_flag(sw, LV_OBJ_FLAG_HIDDEN);
+            }
+        }
+    }
 }
 
