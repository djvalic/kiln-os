+TEST_CASE("AD5X setup: action keys read as short phrases", "[ad5x_setup]") {
+    CHECK(action_text("", 0).empty());
+    CHECK(action_text("heating", 0) == "Heating");
+    CHECK(action_text("probing", 0) == "Probing the bed");
+    CHECK(action_text("finding_slot", 0) == "Finding the slot in the toolhead");
+    CHECK(action_text("loading", 2) == "Loading slot 2");
+    CHECK(action_text("loading", 0) == "Loading filament");
+    CHECK(action_text("printing_patch", 3) == "Printing test patch 3");
+    CHECK(action_text("pid_nozzle", 0) == "Tuning the nozzle heater");
+    // A key a newer Klipper adds shows as it is
+    CHECK(action_text("degassing", 0) == "degassing");
+}
+
+TEST_CASE("AD5X setup: elapsed time and the printer clock", "[ad5x_setup]") {
+    CHECK(elapsed_text(0) == "0:00");
+    CHECK(elapsed_text(65) == "1:05");
+    CHECK(elapsed_text(3725) == "1:02:05");
+    CHECK(elapsed_text(-4) == "0:00");
+
+    // A set clock: the printer's own start time
+    CHECK(elapsed_seconds(1795000000.0, 1795000090.4, 3) == 90);
+    // Not started (0), a clock still at 1970, or a jump: the screen's own count
+    CHECK(elapsed_seconds(0.0, 1795000090.0, 12) == 12);
+    CHECK(elapsed_seconds(42.0, 130.0, 7) == 7);
+    CHECK(elapsed_seconds(42.0, 1795000090.0, 7) == 7);
+    CHECK(elapsed_seconds(1795000000.0, 1795000000.0 + 3 * 24 * 3600, 9) == 9);
+    CHECK(elapsed_seconds(1795000100.0, 1795000000.0, 9) == 9);
+    // Jitter of a second or two is no reason to drop the printer's time
+    CHECK(elapsed_seconds(1795000001.0, 1795000000.0, 9) == 0);
