+
+TEST_CASE("AD5X setup: the filament step sits between vibration and IFS", "[ad5x_setup]") {
+    const auto& specs = step_specs();
+    auto at = [&](const char* key) {
+        for (size_t i = 0; i < specs.size(); ++i) {
+            if (std::string(specs[i].key) == key) {
+                return static_cast<int>(i);
+            }
+        }
+        return -1;
+    };
+    REQUIRE(at("filament") >= 0);
+    CHECK(at("filament") == at("shaper") + 1);
+    CHECK(at("ifs") == at("filament") + 1);
