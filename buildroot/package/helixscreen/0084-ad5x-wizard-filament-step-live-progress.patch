+TEST_CASE_METHOD(LVGLUITestFixture, "AD5X setup: the filament step's card loads from XML",
+                 "[ad5x_setup][ui]") {
+    ui_wizard_init_subjects();
+    ui_wizard_container_register_responsive_constants();
+    WizardAd5xSetupStep* step = get_wizard_ad5x_setup_step(helix::wizard::StepId::Ad5xFilament);
+    REQUIRE(step->id() == helix::wizard::StepId::Ad5xFilament);
+    step->init_subjects();
+    step->register_callbacks();
+    lv_obj_t* root = step->create(test_screen());
+    REQUIRE(root != nullptr);
+    lv_timer_handler();
+
+    // Not started, no status yet: the slot panel shows, the prompt panels don't
+    lv_obj_t* panel = lv_obj_find_by_name(root, "ad5x_filament_panel");
+    REQUIRE(panel != nullptr);
+    CHECK_FALSE(lv_obj_has_flag(panel, LV_OBJ_FLAG_HIDDEN));
+    lv_obj_t* clear_bed = lv_obj_find_by_name(root, "ad5x_clear_bed_panel");
+    REQUIRE(clear_bed != nullptr);
+    CHECK(lv_obj_has_flag(clear_bed, LV_OBJ_FLAG_HIDDEN));
+    lv_obj_t* zpanel = lv_obj_find_by_name(root, "ad5x_zoffset_panel");
+    REQUIRE(zpanel != nullptr);
+    CHECK(lv_obj_has_flag(zpanel, LV_OBJ_FLAG_HIDDEN));
+
+    lv_obj_t* head = lv_obj_find_by_name(root, "ad5x_fil_head");
+    REQUIRE(head != nullptr);
+    CHECK(std::string(lv_dropdown_get_options(head)) == head_choice_options());
+    CHECK(lv_dropdown_get_selected(head) == 0);
+    for (int n = 1; n <= kFilamentSlots; ++n) {
+        CAPTURE(n);
+        lv_obj_t* dd = lv_obj_find_by_name(root, ("ad5x_fil_mat_" + std::to_string(n)).c_str());
+        REQUIRE(dd != nullptr);
+        CHECK(std::string(lv_dropdown_get_options(dd)) == material_options(material_choices("")));
+        // No slot is known to have filament yet: the dropdown hides, "Empty" shows
+        CHECK(lv_obj_has_flag(dd, LV_OBJ_FLAG_HIDDEN));
+        lv_obj_t* label =
+            lv_obj_find_by_name(root, ("ad5x_fil_slot_" + std::to_string(n)).c_str());
+        REQUIRE(label != nullptr);
+        CHECK(std::string(lv_label_get_text(label)) == "Slot " + std::to_string(n));
+    }
+
+    // The Z offset adjust panel hides while a prompt waits
+    lv_subject_t* view = lv_xml_get_subject(nullptr, "ad5x_setup_view");
+    lv_subject_t* is_z = lv_xml_get_subject(nullptr, "ad5x_setup_is_zoffset");
+    lv_subject_t* wait = lv_xml_get_subject(nullptr, "ad5x_setup_prompt_wait");
+    lv_subject_t* prompt = lv_xml_get_subject(nullptr, "ad5x_setup_prompt");
+    REQUIRE(view != nullptr);
+    REQUIRE(is_z != nullptr);
+    REQUIRE(wait != nullptr);
+    REQUIRE(prompt != nullptr);
+    lv_subject_set_int(is_z, 1);
+    lv_subject_set_int(view, static_cast<int>(View::WaitingUser));
+    CHECK_FALSE(lv_obj_has_flag(zpanel, LV_OBJ_FLAG_HIDDEN));
+    lv_subject_set_int(prompt, static_cast<int>(Prompt::ClearBed));
+    lv_subject_set_int(wait, 1);
+    CHECK(lv_obj_has_flag(zpanel, LV_OBJ_FLAG_HIDDEN));
+    CHECK_FALSE(lv_obj_has_flag(clear_bed, LV_OBJ_FLAG_HIDDEN));
+
+    // pick_slot: the slot buttons, each named; "pulled it out by hand"
+    lv_obj_t* pick = lv_obj_find_by_name(root, "ad5x_pick_panel");
+    REQUIRE(pick != nullptr);
+    CHECK(lv_obj_has_flag(pick, LV_OBJ_FLAG_HIDDEN));
+    lv_subject_set_int(wait, 0);
+    lv_subject_set_int(view, static_cast<int>(View::Failed));
+    lv_subject_set_int(prompt, static_cast<int>(Prompt::PickSlot));
+    CHECK_FALSE(lv_obj_has_flag(pick, LV_OBJ_FLAG_HIDDEN));
+    CHECK(lv_obj_has_flag(clear_bed, LV_OBJ_FLAG_HIDDEN));
+    REQUIRE(lv_obj_find_by_name(root, "btn_ad5x_pick_none") != nullptr);
+    for (int n = 1; n <= kFilamentSlots; ++n) {
+        CAPTURE(n);
+        lv_obj_t* btn = lv_obj_find_by_name(root, ("btn_ad5x_pick_" + std::to_string(n)).c_str());
+        REQUIRE(btn != nullptr);
+        lv_obj_t* label = ui_button_get_label(btn);
+        REQUIRE(label != nullptr);
+        CHECK(std::string(lv_label_get_text(label)) == "Slot " + std::to_string(n));
+    }
+
+    step->cleanup();
+    lv_obj_delete(root);
+}
