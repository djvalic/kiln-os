+uint32_t material_index(const std::vector<std::string>& choices, const std::string& material) {
+    const std::string want = upper(material);
+    for (size_t i = 0; i < choices.size(); ++i) {
+        if (choices[i] == want) {
+            return static_cast<uint32_t>(i);
+        }
+    }
+    return 0;
+}
+
+const std::vector<HeadChoiceSpec>& head_choices() {
+    static const std::vector<HeadChoiceSpec> choices = {
+        {HeadChoice::Auto, "auto", "Auto (find it)", 0},
+        {HeadChoice::Slot1, "1", "Slot {}", 1},
+        {HeadChoice::Slot2, "2", "Slot {}", 2},
+        {HeadChoice::Slot3, "3", "Slot {}", 3},
+        {HeadChoice::Slot4, "4", "Slot {}", 4},
+        {HeadChoice::Empty, "0", "None (empty)", 0},
+        {HeadChoice::Keep, "keep", "Use the filament in the toolhead as it is", 0},
+    };
+    return choices;
+}
+
+std::string head_choice_options() {
+    std::string out;
+    for (const auto& c : head_choices()) {
+        if (!out.empty()) {
+            out += '\n';
+        }
+        out += c.slot > 0 ? fmt::format(fmt::runtime(lv_tr(c.label)), c.slot)
+                          : std::string(lv_tr(c.label));
+    }
+    return out;
+}
+
+json filament_options(const std::array<std::optional<std::string>, kFilamentSlots>& materials,
+                      HeadChoice head) {
+    json options = json::object();
+    for (int n = 1; n <= kFilamentSlots; ++n) {
+        const auto& m = materials[n - 1];
+        if (m) {
+            options[fmt::format("material_{}", n)] = m->empty() ? std::string("?") : *m;
+        }
+    }
+    options["head"] = head_choices().front().param;
+    for (const auto& c : head_choices()) {
+        if (c.choice == head) {
+            options["head"] = c.param;
+        }
+    }
+    return options;
+}
+
+std::string head_text(const FilamentStatus& filament) {
+    if (!filament.known) {
+        return {};
+    }
+    if (filament.head_source == "tube") {
+        return lv_tr("Toolhead: strand in the tube, slot unknown");
+    }
+    if (filament.head_source == "kept") {
+        return lv_tr("Toolhead: filament kept as it is");
+    }
+    if (filament.head >= 1 && filament.head <= kFilamentSlots) {
+        const std::string& mat = filament.materials[filament.head - 1];
+        if (filament.head_source == "found") {
+            return fmt::format(fmt::runtime(lv_tr("Toolhead: slot {} was in it, now unloaded")),
+                               filament.head);
+        }
+        return mat.empty()
+                   ? fmt::format(fmt::runtime(lv_tr("Toolhead: slot {}")), filament.head)
+                   : fmt::format(fmt::runtime(lv_tr("Toolhead: slot {}, {}")), filament.head, mat);
+    }
+    if (filament.head_filament && *filament.head_filament) {
+        return lv_tr("Toolhead: filament from an unknown slot");
+    }
+    if (filament.head_filament && !*filament.head_filament) {
+        return lv_tr("Toolhead: empty");
+    }
+    return {};
+}
+
+std::string pick_slot_label(int slot, const std::string& material) {
+    return material.empty()
+               ? fmt::format(fmt::runtime(lv_tr("Slot {}")), slot)
+               : fmt::format(fmt::runtime(lv_tr("Slot {} \xC2\xB7 {}")), slot, upper(material));
+}
+
+std::array<bool, kFilamentSlots> pick_slots(const FilamentStatus& filament) {
+    const bool any = std::any_of(filament.present.begin(), filament.present.end(),
+                                 [](bool p) { return p; });
+    if (!any) {
+        std::array<bool, kFilamentSlots> all;
+        all.fill(true);
+        return all;
+    }
+    return filament.present;
+}
+
+IfsFindStatus parse_ifs_find(const json& ifs) {
+    IfsFindStatus out;
+    if (!ifs.is_object()) {
+        return out;
+    }
+    if (auto it = ifs.find("tube_blocked"); it != ifs.end() && it->is_boolean()) {
+        out.tube_blocked = it->get<bool>();
+    }
+    out.find_result = str_field(ifs, "find_result");
+    out.head_found = std::clamp(int_field(ifs, "head_found"), 0, kFilamentSlots);
+    if (auto it = ifs.find("colors"); it != ifs.end() && it->is_array()) {
+        for (size_t i = 0; i < it->size() && i < out.colors.size(); ++i) {
+            if ((*it)[i].is_string()) {
+                out.colors[i] = (*it)[i].get<std::string>();
+            }
+        }
+    }
+    return out;
+}
+
+std::string action_text(const std::string& action, int arg) {
+    if (action.empty()) {
+        return {};
+    }
+    for (const auto& phrase : k_action_phrases) {
+        if (action == phrase.key) {
+            if (arg > 0 && phrase.with_arg) {
+                return fmt::format(fmt::runtime(lv_tr(phrase.with_arg)), arg);
+            }
+            return lv_tr(phrase.text);
+        }
+    }
+    return action;
+}
+
+std::string elapsed_text(long seconds) {
+    seconds = std::max(0L, seconds);
+    if (seconds >= 3600) {
+        return fmt::format("{}:{:02}:{:02}", seconds / 3600, seconds / 60 % 60, seconds % 60);
+    }
+    return fmt::format("{}:{:02}", seconds / 60, seconds % 60);
+}
+
+long elapsed_seconds(double step_started, double now_unix, long local_seconds) {
+    if (step_started > kClockSetAfter && now_unix > kClockSetAfter) {
+        const double since = now_unix - step_started;
+        // A few seconds early is clock jitter; more, or a day, is a clock jump
+        if (since > -5. && since < kMaxStepSeconds) {
+            return std::max(0L, static_cast<long>(since));
+        }
+    }
+    return std::max(0L, local_seconds);
+}
+
+std::string temps_text(int nozzle_dc, int nozzle_target_dc, int bed_dc, int bed_target_dc) {
+    auto one = [](int now, int target) {
+        return target > 0 ? fmt::format("{}/{} \xC2\xB0"
+                                        "C",
+                                        whole_degrees(now), whole_degrees(target))
+                          : fmt::format("{} \xC2\xB0"
+                                        "C",
+                                        whole_degrees(now));
+    };
+    return fmt::format("{} {}  \xC2\xB7  {} {}", lv_tr("Nozzle"), one(nozzle_dc, nozzle_target_dc),
+                       lv_tr("Bed"), one(bed_dc, bed_target_dc));
+}
+
+std::string plan_text(const json& plan) {
+    if (!plan.is_object()) {
+        return {};
+    }
+    const int slot = int_field(plan, "slot");
+    const std::string material = upper(str_field(plan, "material"));
+    const int nozzle = int_field(plan, "nozzle");
+    const int bed = int_field(plan, "bed");
+    std::string out =
+        slot > 0 ? fmt::format(fmt::runtime(lv_tr("Slot {}, {}, {}/{} \xC2\xB0"
+                                                  "C")),
+                               slot, material.empty() ? std::string("?") : material, nozzle, bed)
+                 : fmt::format(fmt::runtime(lv_tr("{}, {}/{} \xC2\xB0"
+                                                  "C")),
+                               material.empty() ? std::string("?") : material, nozzle, bed);
+    auto g = plan.find("guess");
+    if (g != plan.end() && g->is_boolean() && g->get<bool>()) {
+        out += '\n';
+        const std::string source = str_field(plan, "source");
+        // A material the patch table doesn't have also falls back to PLA's
+        if (source == "guess" && !material.empty() && material != "PLA") {
+            out += fmt::format(fmt::runtime(lv_tr("No temperatures for {}: using PLA temperatures")),
+                               material);
+        } else {
+            out += lv_tr("Material unknown: using PLA temperatures");
+        }
+        out += ' ';
+        out += lv_tr("Abort and set it in the Filament step if this is wrong.");
+    }
+    return out;
+}
+
+Prompt prompt_for(const std::string& key, const json& status) {
+    if (str_field(status, "step") != key) {
+        return Prompt::None;
+    }
+    const std::string prompt = str_field(status, "prompt");
+    const std::string state = str_field(status, "state");
+    if (prompt == "clear_bed") {
+        if (state == "waiting_user") {
+            return Prompt::ClearBed;
+        }
+        if (state == "failed" || state == "aborted") {
+            return Prompt::ClearBedReminder;
+        }
+    }
+    if (prompt == "head_unknown" && state == "failed") {
+        return Prompt::HeadUnknown;
+    }
+    if (prompt == "pick_slot" && (state == "failed" || state == "aborted")) {
+        return Prompt::PickSlot;
+    }
+    // A prompt this screen doesn't know: the step's message, then Done or Retry
+    if (!prompt.empty() && prompt != "clear_bed" && prompt != "head_unknown" &&
+        prompt != "pick_slot") {
+        if (state == "waiting_user") {
+            return Prompt::OtherWaiting;
+        }
+        if (state == "failed" || state == "aborted") {
+            return Prompt::OtherFailed;
+        }
+    }
+    return Prompt::None;
+}
