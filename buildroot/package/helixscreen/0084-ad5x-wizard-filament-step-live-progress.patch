+
+FilamentStatus parse_filament(const json& status) {
+    FilamentStatus out;
+    auto it = status.find("filament");
+    if (it == status.end() || !it->is_object()) {
+        return out;
+    }
+    const json& fil = *it;
+    out.known = true;
+    if (auto p = fil.find("present"); p != fil.end() && p->is_array()) {
+        for (const auto& slot : *p) {
+            if (slot.is_number_integer()) {
+                const int n = slot.get<int>();
+                if (n >= 1 && n <= kFilamentSlots) {
+                    out.present[n - 1] = true;
+                }
+            }
+        }
+    }
+    if (auto m = fil.find("materials"); m != fil.end() && m->is_object()) {
+        for (int n = 1; n <= kFilamentSlots; ++n) {
+            out.materials[n - 1] = str_field(*m, std::to_string(n).c_str());
+        }
+    }
+    out.head = std::clamp(int_field(fil, "head"), 0, kFilamentSlots);
+    out.head_source = str_field(fil, "head_source");
+    if (auto h = fil.find("head_filament"); h != fil.end() && h->is_boolean()) {
+        out.head_filament = h->get<bool>();
+    }
+    return out;
+}
+
+std::vector<std::string> material_choices(const std::string& current) {
+    std::vector<std::string> choices = {""};
+    for (const char* type : AmsBackendAd5xIfs::kStockWhitelist) {
+        choices.emplace_back(type);
+    }
+    const std::string cur = upper(current);
+    if (!cur.empty() && cur != "?" &&
+        std::find(choices.begin(), choices.end(), cur) == choices.end()) {
+        choices.push_back(cur);
+    }
+    return choices;
+}
+
+std::string material_options(const std::vector<std::string>& choices) {
+    std::string out;
+    for (const auto& c : choices) {
+        if (!out.empty()) {
+            out += '\n';
+        }
+        out += c.empty() ? std::string(lv_tr("Unknown")) : c;
+    }
+    return out;
+}
