+TEST_CASE("AD5X setup: prompts", "[ad5x_setup]") {
+    json st = {{"step", "zoffset"}, {"state", "waiting_user"}, {"prompt", "clear_bed"}};
+    CHECK(prompt_for("zoffset", st) == Prompt::ClearBed);
