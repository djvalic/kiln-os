+TEST_CASE("Kiln errors: the reason is the data, the message the text", "[kiln][moonraker][error]") {
+    const MoonrakerError err = kiln_error(409, "printing", "A print is running");
+    CHECK(err.code == 409);
+    CHECK(err.kiln_reason() == "printing");
+    CHECK(err.message == "A print is running");
+
+    // Only a "[reason] " that matches the data is taken off
+    const MoonrakerError other = MoonrakerError::from_json_rpc(
+        {{"code", 409}, {"message", "[busy] text"}, {"data", {{"reason", "printing"}}}}, "m");
+    CHECK(other.message == "[busy] text");
+    const MoonrakerError no_data =
+        MoonrakerError::from_json_rpc({{"code", 400}, {"message", "[printing] text"}}, "m");
+    CHECK(no_data.kiln_reason().empty());
+    CHECK(no_data.message == "[printing] text");
+    const MoonrakerError list_data = MoonrakerError::from_json_rpc(
+        {{"code", 424}, {"message", "Agent x RPC error"}, {"data", json::array({1, 2})}}, "m");
+    CHECK(list_data.kiln_reason().empty());
+}
+
+TEST_CASE("Kiln errors: a Klipper endpoint's reason in front comes off",
+          "[kiln][moonraker][error]") {
+    CHECK(MoonrakerError::strip_kiln_reason(
+              "[printing] SETUP_WIZARD_STEP: no setup step during a print") ==
+          "SETUP_WIZARD_STEP: no setup step during a print");
+    CHECK(MoonrakerError::strip_kiln_reason("[step_running] x") == "x");
+    CHECK(MoonrakerError::strip_kiln_reason("[internal_error2] x") == "x");
+    // Not a reason: upper case, spaces, nothing after it, no bracket
+    CHECK(MoonrakerError::strip_kiln_reason("[Errno 2] No such file") ==
+          "[Errno 2] No such file");
+    CHECK(MoonrakerError::strip_kiln_reason("[gcode_macro foo] x") == "[gcode_macro foo] x");
+    CHECK(MoonrakerError::strip_kiln_reason("[printing]x") == "[printing]x");
+    CHECK(MoonrakerError::strip_kiln_reason("[_x] y") == "[_x] y");
+    CHECK(MoonrakerError::strip_kiln_reason("Must home axis first") == "Must home axis first");
+    CHECK(MoonrakerError::strip_kiln_reason("").empty());
+}
