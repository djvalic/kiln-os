         return helix::decode_firmware_error_text(extract_message_field(raw));
     }
 
+    /// Kiln OS: the reason of an error from one of its Moonraker endpoints
+    /// (the JSON-RPC error's data {"reason": "printing"}), "" for any other.
+    std::string kiln_reason() const {
+        if (!details.is_object()) {
+            return {};
+        }
+        const auto it = details.find("reason");
+        return it != details.end() && it->is_string() ? it->get<std::string>() : std::string();
+    }
+
+    /// Kiln OS: @p message without the reason its Klipper endpoints put in
+    /// front ("[printing] SETUP_WIZARD_STEP: ..."; Moonraker passes those on
+    /// without data). A reason is lower case letters, digits and '_'.
+    static std::string strip_kiln_reason(const std::string& message) {
+        if (message.size() < 4 || message[0] != '[' || message[1] < 'a' || message[1] > 'z') {
+            return message;
+        }
+        size_t i = 1;
+        while (i < message.size() && ((message[i] >= 'a' && message[i] <= 'z') ||
+                                      (message[i] >= '0' && message[i] <= '9') ||
+                                      message[i] == '_')) {
+            ++i;
+        }
+        if (i + 1 < message.size() && message[i] == ']' && message[i + 1] == ' ') {
+            return message.substr(i + 2);
+        }
+        return message;
+    }
+
     /// extract_friendly_message() of an error line that may still carry its
     /// `!!` / `Error:` prefixes (`!! Error: foo`), with them and the
     /// whitespace after each removed.
@@ -292,6 +321,14 @@ struct MoonrakerError {
             err.details = error_obj["data"];
         }
 
+        // Kiln OS: its endpoints' errors start with their reason, "[printing] A
+        // print is running", which Moonraker also sends as the error's data
+        // {"reason": "printing"}. People get the text, programs kiln_reason().
+        const std::string reason = err.kiln_reason();
+        if (!reason.empty() && err.message.rfind("[" + reason + "] ", 0) == 0) {
+            err.message.erase(0, reason.size() + 3);
+        }
+
         // Map specific error codes to types
         if (err.code == -32601) { // Method not found
             err.type = MoonrakerErrorType::VALIDATION_ERROR;
