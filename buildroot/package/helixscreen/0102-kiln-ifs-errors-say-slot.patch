diff --git a/tests/unit/test_kiln_ifs_slot_wording.cpp b/tests/unit/test_kiln_ifs_slot_wording.cpp
new file mode 100644
index 0000000000..3d24a8d1bb
--- /dev/null
+++ b/tests/unit/test_kiln_ifs_slot_wording.cpp
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Kiln OS: the AD5X calls the IFS's four positions slots, on its screen and in
+// its docs. The Flashforge IFS error texts (flashforge_error_wording.cpp) say
+// slot too, in English (the identity locale shows a source string as written)
+// and in every catalog, whose keys follow the source.
+
+#include "error_wording.h"
+#include "printer_discovery.h"
+
+#include <string>
+
+#include "../catch_amalgamated.hpp"
+#include "../lvgl_test_fixture.h"
+#include "hv/json.hpp"
+
+using namespace helix;
+
+namespace {
+
+PrinterDiscovery ad5x_ifs() {
+    PrinterDiscovery hw;
+    hw.parse_objects(nlohmann::json{"zmod_ifs", "zmod_color", "extruder"});
+    return hw;
+}
+
+bool says_lane(const std::string& text) {
+    return text.find("lane") != std::string::npos || text.find("Lane") != std::string::npos;
+}
+
+} // namespace
+
+TEST_CASE_METHOD(LVGLTestFixture, "Kiln OS: the IFS error texts say slot, not lane",
+                 "[error-wording][flashforge][kiln]") {
+    const PrinterDiscovery hw = ad5x_ifs();
+    for (const char* line : {"No filament 3 in IFS", "Нет прутка 3 в IFS",
+                             "Filament 2 stalled in IFS",
+                             "IFS: Timeout waiting for status 11|5, received 3",
+                             "Filament runout detected (Head)"}) {
+        CAPTURE(line);
+        const auto c = error_wording::classify(line, &hw);
+        REQUIRE(c.has_value());
+        const auto w = error_wording::word(*c);
+        REQUIRE(w.has_value());
+        CHECK_FALSE(says_lane(w->summary));
+        CHECK_FALSE(says_lane(w->cause));
+        CHECK_FALSE(says_lane(w->fix));
+    }
+    const auto c = error_wording::classify("No filament 3 in IFS", &hw);
+    REQUIRE(c.has_value());
+    CHECK(error_wording::word(*c)->summary == "No filament in IFS slot 3");
+}
