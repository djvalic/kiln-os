                 }
+                // Kiln OS: so is the question after a reinstall (and it closes)
+                kiln_wizard_offer::answered_elsewhere();
                 if (!available()) {
                     return;
                 }
diff --git a/tests/unit/test_kiln_wizard_offer.cpp b/tests/unit/test_kiln_wizard_offer.cpp
new file mode 100644
index 0000000..2fc7ac0
--- /dev/null
+++ b/tests/unit/test_kiln_wizard_offer.cpp
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * Kiln OS: after a reinstall over Flashforge's firmware the settings are kept
+ * (the wizard is marked done), and the installer leaves the offer file
+ * (HELIX_WIZARD_OFFER_FILE). The screen's next start asks "Run the setup
+ * wizard?": Run removes the file and opens the setup steps, Skip removes it
+ * and stays home, a dismissal keeps it for the next start. A wizard running
+ * at that start anyway answers the offer: the file goes, nothing is asked.
+ * In Russian the whole question is Russian, with no English line beside it.
+ */
+
+#include "ui_kiln_wizard_offer.h"
+#include "ui_modal.h"
+#include "ui_toast_manager.h"
+#include "ui_update_queue.h"
+
+#include "../lvgl_ui_test_fixture.h"
+#include "../test_helpers/modal_answer.h"
+#include "../ui_test_utils.h"
+#include "app_globals.h"
+#include "config.h"
+#include "lvgl/src/others/translation/lv_translation.h"
+#include "printer_state.h"
+#include "translation_loader.h"
+
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "../catch_amalgamated.hpp"
+
+using namespace helix;
+using Catch::Matchers::ContainsSubstring;
+namespace offer = helix::kiln_wizard_offer;
+namespace fs = std::filesystem;
+
+TEST_CASE("Kiln wizard offer: the start's decision", "[kiln][kiln_wizard_offer]") {
+    using A = offer::StartAction;
+    // No offer file: nothing, whatever else is true
+    CHECK(offer::start_action(false, false, true) == A::Nothing);
+    CHECK(offer::start_action(false, true, true) == A::Nothing);
+    // A wizard running at this start answers it
+    CHECK(offer::start_action(true, true, true) == A::Drop);
+    CHECK(offer::start_action(true, true, false) == A::Drop);
+    // Otherwise asked, where the setup steps exist; kept where they don't
+    CHECK(offer::start_action(true, false, true) == A::Ask);
+    CHECK(offer::start_action(true, false, false) == A::Nothing);
+}
+
+namespace {
+
+struct OfferFixture : LVGLUITestFixture {
+    fs::path dir;
+    fs::path flag;
+    int launches = 0;
+    std::vector<std::pair<ToastSeverity, std::string>> toasts;
+    bool had_preset = false;
+
+    OfferFixture() {
+        helix::ui::modal_init_subjects();
+        dir = fs::temp_directory_path() /
+              ("kiln-wizard-offer-" + std::to_string(reinterpret_cast<uintptr_t>(this)));
+        fs::create_directories(dir);
+        flag = dir / "offer-setup-wizard";
+        setenv(offer::kEnv, flag.c_str(), 1);
+        offer::set_launch_for_test([this]() { ++launches; });
+        helix::ui::set_test_toast_hook([this](ToastSeverity sev, const std::string& text,
+                                              uint32_t) { toasts.emplace_back(sev, text); });
+        Config* cfg = Config::get_instance();
+        REQUIRE(cfg != nullptr);
+        had_preset = cfg->get_preset() == "ad5x";
+        cfg->set_preset("ad5x");
+        state().update_from_status({{"print_stats", {{"state", "standby"}}}});
+        settle();
+    }
+
+    ~OfferFixture() override {
+        while (ModalStack::instance().top_dialog() != nullptr) {
+            Modal::hide(ModalStack::instance().top_dialog());
+            process_lvgl(5);
+        }
+        settle();
+        offer::set_launch_for_test(nullptr);
+        helix::ui::set_test_toast_hook(nullptr);
+        if (!had_preset) {
+            Config::get_instance()->clear_preset();
+        }
+        unsetenv(offer::kEnv);
+        std::error_code ec;
+        fs::remove_all(dir, ec);
+    }
+
+    void settle() {
+        helix::ui::UpdateQueue::instance().drain();
+        process_lvgl(10);
+    }
+
+    void write_flag() {
+        std::ofstream(flag) << "reinstalled over stock\n";
+        REQUIRE(fs::exists(flag));
+    }
+};
+
+} // namespace
+
+TEST_CASE_METHOD(OfferFixture, "Kiln wizard offer: no offer file, no question",
+                 "[kiln][kiln_wizard_offer]") {
+    offer::at_start(/*wizard_running=*/false);
+    settle();
+    CHECK(ModalStack::instance().top_dialog() == nullptr);
+    CHECK_FALSE(offer::asking());
+    CHECK(launches == 0);
+}
+
+TEST_CASE_METHOD(OfferFixture, "Kiln wizard offer: a wizard running anyway answers it",
+                 "[kiln][kiln_wizard_offer]") {
+    write_flag();
+    offer::at_start(/*wizard_running=*/true);
+    settle();
+    CHECK(ModalStack::instance().top_dialog() == nullptr);
+    CHECK_FALSE(fs::exists(flag));
+    CHECK(launches == 0);
+}
+
+TEST_CASE_METHOD(OfferFixture, "Kiln wizard offer: asked once with Run and Skip",
+                 "[kiln][kiln_wizard_offer]") {
+    write_flag();
+    offer::at_start(/*wizard_running=*/false);
+    settle();
+    REQUIRE(ModalStack::instance().top_dialog() != nullptr);
+    CHECK(offer::asking());
+    const std::string text = test::top_modal_text();
+    CHECK_THAT(text, ContainsSubstring("Run the setup wizard?"));
+    CHECK_THAT(text, ContainsSubstring("kept your settings"));
+    CHECK_THAT(text, ContainsSubstring("the filament, the Z offset or the boards"));
+    lv_obj_t* dialog = ModalStack::instance().top_dialog();
+    CHECK_THAT(test::subtree_text(lv_obj_find_by_name(dialog, "btn_primary")),
+               ContainsSubstring("Run"));
+    CHECK_THAT(test::subtree_text(lv_obj_find_by_name(dialog, "btn_secondary")),
+               ContainsSubstring("Skip"));
+    // Asking again while it is up shows no second dialog
+    offer::ask();
+    settle();
+    CHECK(ModalStack::instance().top_dialog() == dialog);
+
+    SECTION("Run removes the offer and opens the setup steps") {
+        test::answer_top_modal("btn_primary");
+        settle();
+        CHECK(launches == 1);
+        CHECK_FALSE(fs::exists(flag));
+        CHECK_FALSE(offer::asking());
+        // The next start asks nothing
+        offer::at_start(false);
+        settle();
+        CHECK(ModalStack::instance().top_dialog() == nullptr);
+    }
+
+    SECTION("Skip removes the offer and opens nothing") {
+        test::answer_top_modal("btn_secondary");
+        settle();
+        CHECK(launches == 0);
+        CHECK_FALSE(fs::exists(flag));
+        CHECK(ModalStack::instance().top_dialog() == nullptr);
+        offer::at_start(false);
+        settle();
+        CHECK(ModalStack::instance().top_dialog() == nullptr);
+    }
+
+    SECTION("Closed without an answer: asked again at the next start") {
+        test::dismiss_top_modal();
+        settle();
+        CHECK(launches == 0);
+        CHECK(fs::exists(flag));
+        CHECK_FALSE(offer::asking());
+        offer::at_start(false);
+        settle();
+        CHECK(ModalStack::instance().top_dialog() != nullptr);
+    }
+
+    SECTION("SETUP_WIZARD from Klipper answers it and closes the question") {
+        offer::answered_elsewhere();
+        settle();
+        CHECK_FALSE(fs::exists(flag));
+        CHECK_FALSE(offer::asking());
+        CHECK(launches == 0);
+    }
+}
+
+TEST_CASE_METHOD(OfferFixture, "Kiln wizard offer: Run is refused while a print runs",
+                 "[kiln][kiln_wizard_offer]") {
+    write_flag();
+    offer::at_start(false);
+    settle();
+    REQUIRE(ModalStack::instance().top_dialog() != nullptr);
+    state().update_from_status({{"print_stats", {{"state", "printing"}}}});
+    settle();
+
+    test::answer_top_modal("btn_primary");
+    settle();
+    CHECK(launches == 0);
+    // Kept: asked again at the next start
+    CHECK(fs::exists(flag));
+    bool warned = false;
+    for (const auto& t : toasts) {
+        warned = warned || (t.first == ToastSeverity::WARNING &&
+                            t.second == "Cannot calibrate while printing");
+    }
+    CHECK(warned);
+
+    state().update_from_status({{"print_stats", {{"state", "standby"}}}});
+    settle();
+}
+
+TEST_CASE_METHOD(OfferFixture, "Kiln wizard offer: without the variable nothing happens",
+                 "[kiln][kiln_wizard_offer]") {
+    write_flag();
+    unsetenv(offer::kEnv);
+    CHECK(offer::flag_path().empty());
+    CHECK_FALSE(offer::pending());
+    offer::at_start(false);
+    settle();
+    CHECK(ModalStack::instance().top_dialog() == nullptr);
+    CHECK(offer::drop());
+    CHECK(fs::exists(flag));
+}
+
+TEST_CASE_METHOD(OfferFixture, "Kiln wizard offer: in Russian, only Russian",
+                 "[kiln][kiln_wizard_offer][i18n]") {
+    struct RestoreLanguage {
+        ~RestoreLanguage() {
+            lv_translation_set_language(helix::ui::kIdentityLocale);
+        }
+    } restore;
+    helix::ui::ensure_translation_loaded("ru");
+    lv_translation_set_language("ru");
+
+    write_flag();
+    offer::at_start(false);
+    settle();
+    REQUIRE(ModalStack::instance().top_dialog() != nullptr);
+    const std::string text = test::top_modal_text();
+    CHECK_THAT(text, ContainsSubstring("Запустить мастер настройки?"));
+    CHECK_THAT(text, ContainsSubstring("смещение по Z или платы"));
+    // One language on the screen: none of the English texts beside it
+    CHECK_THAT(text, !ContainsSubstring("setup wizard"));
+    CHECK_THAT(text, !ContainsSubstring("kept your settings"));
+    lv_obj_t* dialog = ModalStack::instance().top_dialog();
+    const std::string run = test::subtree_text(lv_obj_find_by_name(dialog, "btn_primary"));
+    const std::string skip = test::subtree_text(lv_obj_find_by_name(dialog, "btn_secondary"));
+    CHECK_THAT(run, ContainsSubstring("Запуск"));
+    CHECK_THAT(run, !ContainsSubstring("Run"));
+    CHECK_THAT(skip, ContainsSubstring("Пропустить"));
+    CHECK_THAT(skip, !ContainsSubstring("Skip"));
+}
