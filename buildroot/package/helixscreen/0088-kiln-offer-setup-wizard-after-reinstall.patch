--- /dev/null
+++ b/include/ui_kiln_wizard_offer.h
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * @file ui_kiln_wizard_offer.h
+ * @brief Kiln OS: "Run the setup wizard?" at the first start after a
+ *        reinstall over Flashforge's firmware
+ *
+ * Return to Flashforge firmware keeps Kiln's data (/data/ad5x), and with it
+ * HelixScreen's settings, where the wizard is marked done. When Kiln OS is
+ * installed again from the install stick (or over SSH), the installer finds
+ * that settings file and writes the offer file (HELIX_WIZARD_OFFER_FILE, set
+ * by S70helixscreen: /data/ad5x/helixscreen/offer-setup-wizard). The settings
+ * stay as they are; at its next start the screen asks once whether to run
+ * the setup wizard, because stock may have changed the filament, the Z offset
+ * or the boards since:
+ *
+ * - Run: the offer file goes, and the setup steps run as Settings > Printer >
+ *   Run Setup Wizard runs them (ad5x_setup::launch_targeted). While the
+ *   printer may move for a print it is refused with a toast, and the offer
+ *   stays for the next start.
+ * - Skip: the offer file goes; the home screen stays. Not asked again.
+ * - Closed some other way (backdrop tap): nothing changes; asked again at the
+ *   next start.
+ *
+ * When a wizard runs at that start anyway (a fresh settings file, or
+ * SETUP_WIZARD's run-setup-wizard flag), the offer is answered by it and the
+ * file goes without a question; so does a SETUP_WIZARD from Klipper while the
+ * question is up. Without the environment variable (other builds) nothing
+ * happens.
+ *
+ * @threading Main thread only
+ */
+
+#pragma once
+
+#include "lvgl/lvgl.h"
+
+#include <functional>
+#include <string>
+
+namespace helix::kiln_wizard_offer {
+
+/// The environment variable naming the offer file
+inline constexpr const char* kEnv = "HELIX_WIZARD_OFFER_FILE";
+
+/// The offer file (HELIX_WIZARD_OFFER_FILE), empty when it isn't set
+std::string flag_path();
+
+/// True when the offer file exists
+bool pending();
+
+/// Remove the offer file; true when it is gone afterwards (or never was)
+bool drop();
+
+/// What the start does with the offer
+enum class StartAction {
+    Nothing, ///< no offer, or no setup steps on this printer: leave it
+    Drop,    ///< a wizard runs at this start anyway: it answers the offer
+    Ask,     ///< ask "Run the setup wizard?"
+};
+
+/// The decision at a start: @p offered (the file exists), @p wizard_running
+/// (the first-run wizard or a requested re-run is up), @p setup_available
+/// (the printer has the AD5X setup steps)
+StartAction start_action(bool offered, bool wizard_running, bool setup_available);
+
+/// At the screen's start, once it is known whether a wizard runs: drop the
+/// offer, ask, or do nothing (start_action()).
+void at_start(bool wizard_running);
+
+/// Show the question now (at_start() calls it). Nothing when it is up already.
+void ask();
+
+/// The question is up
+bool asking();
+
+/// Answered elsewhere (a SETUP_WIZARD from Klipper opened the setup steps):
+/// the offer file goes and an open question closes without an answer.
+void answered_elsewhere();
+
+/// Tests: what Run starts instead of ad5x_setup::launch_targeted
+/// (nullptr: the real one)
+void set_launch_for_test(std::function<void()> launch);
+
+} // namespace helix::kiln_wizard_offer
