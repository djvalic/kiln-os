diff --git a/src/ui/ui_kiln_wizard_offer.cpp b/src/ui/ui_kiln_wizard_offer.cpp
new file mode 100644
index 0000000..9ea020d
--- /dev/null
+++ b/src/ui/ui_kiln_wizard_offer.cpp
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "ui_kiln_wizard_offer.h"
+
+#include "ui_modal.h"
+#include "ui_toast_manager.h"
+#include "ui_wizard_ad5x_setup.h"
+
+#include "app_globals.h"
+#include "helix_fs.h"
+#include "lvgl/src/others/translation/lv_translation.h"
+#include "printer_state.h"
+
+#include <spdlog/spdlog.h>
+
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+
+namespace helix::kiln_wizard_offer {
+
+namespace {
+
+lv_obj_t* g_dialog = nullptr;
+std::function<void()> g_launch_override;
+
+/// The dialog is still on the screen (a fixture or a rebuild can delete it
+/// without telling us)
+bool dialog_up() {
+    if (g_dialog && !lv_obj_is_valid(g_dialog)) {
+        g_dialog = nullptr;
+    }
+    return g_dialog != nullptr;
+}
+
+bool motion_blocked() {
+    return lv_subject_get_int(
+               get_printer_state().print_state().get_machine_motion_blocked_subject()) != 0;
+}
+
+void on_run() {
+    g_dialog = nullptr;
+    if (motion_blocked()) {
+        // Asked again at the next start
+        ToastManager::instance().show(ToastSeverity::WARNING,
+                                      lv_tr("Cannot calibrate while printing"), 3000);
+        return;
+    }
+    drop();
+    spdlog::info("[Kiln wizard offer] Run: opening the setup steps");
+    if (g_launch_override) {
+        g_launch_override();
+    } else {
+        helix::ad5x_setup::launch_targeted(lv_screen_active());
+    }
+}
+
+void on_skip() {
+    g_dialog = nullptr;
+    spdlog::info("[Kiln wizard offer] Skip: not asked again");
+    drop();
+}
+
+void on_dismiss() {
+    // No answer: the file stays, asked again at the next start
+    g_dialog = nullptr;
+}
+
+} // namespace
+
+std::string flag_path() {
+    const char* env = std::getenv(kEnv);
+    return env ? env : "";
+}
+
+bool pending() {
+    const std::string path = flag_path();
+    return !path.empty() && helix::fs::exists(path);
+}
+
+bool drop() {
+    const std::string path = flag_path();
+    if (path.empty()) {
+        return true;
+    }
+    if (!helix::fs::remove(path) && errno != ENOENT) {
+        spdlog::warn("[Kiln wizard offer] Could not remove {}: {}", path, std::strerror(errno));
+        return false;
+    }
+    return true;
+}
+
+StartAction start_action(bool offered, bool wizard_running, bool setup_available) {
+    if (!offered) {
+        return StartAction::Nothing;
+    }
+    if (wizard_running) {
+        return StartAction::Drop;
+    }
+    return setup_available ? StartAction::Ask : StartAction::Nothing;
+}
+
+void at_start(bool wizard_running) {
+    const bool offered = pending();
+    switch (start_action(offered, wizard_running,
+                         offered && !wizard_running && helix::ad5x_setup::available())) {
+    case StartAction::Nothing:
+        if (offered) {
+            spdlog::info("[Kiln wizard offer] {} kept: no setup steps on this printer",
+                         flag_path());
+        }
+        return;
+    case StartAction::Drop:
+        spdlog::info("[Kiln wizard offer] The setup wizard runs anyway: {} dropped", flag_path());
+        drop();
+        return;
+    case StartAction::Ask:
+        spdlog::info("[Kiln wizard offer] Reinstalled over Flashforge's firmware: asking");
+        ask();
+        return;
+    }
+}
+
+void ask() {
+    if (dialog_up()) {
+        return;
+    }
+    helix::ui::ConfirmOptions opts;
+    opts.cancel_text = lv_tr("Skip");
+    opts.on_cancel = []() { on_skip(); };
+    opts.on_dismiss = []() { on_dismiss(); };
+    g_dialog = helix::ui::modal_confirm(
+        lv_tr("Run the setup wizard?"),
+        lv_tr("Kiln OS is installed again and kept your settings. Flashforge's firmware ran in "
+              "between and may have changed the filament, the Z offset or the boards. The setup "
+              "wizard checks and tunes the printer again; every step can be skipped."),
+        ModalSeverity::Info, lv_tr("Run"), []() { on_run(); }, opts);
+}
+
+bool asking() {
+    return dialog_up();
+}
+
+void answered_elsewhere() {
+    if (dialog_up()) {
+        lv_obj_t* dialog = g_dialog;
+        g_dialog = nullptr;
+        helix::ui::modal_hide(dialog);
+    }
+    drop();
+}
+
+void set_launch_for_test(std::function<void()> launch) {
+    g_launch_override = std::move(launch);
+}
+
+} // namespace helix::kiln_wizard_offer
