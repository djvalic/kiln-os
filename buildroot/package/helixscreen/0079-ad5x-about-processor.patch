diff --git a/src/system/kiln_hardware.cpp b/src/system/kiln_hardware.cpp
index fc69422e..514cf279 100644
--- a/src/system/kiln_hardware.cpp
+++ b/src/system/kiln_hardware.cpp
@@ -5,12 +5,19 @@
 
 #include <spdlog/fmt/fmt.h>
 
+#include <array>
+#include <cctype>
+#include <filesystem>
+#include <system_error>
+
 namespace helix::kiln_hardware {
 
 namespace tio = helix::text_io;
 
 namespace {
 
+constexpr uint32_t kFieldMask = 0xfffff; // 20 bits
+
 std::string read_trimmed(const std::string& path) {
     auto body = tio::read_file(path, 4096);
     if (!body) {
@@ -19,8 +26,137 @@ std::string read_trimmed(const std::string& path) {
     return std::string(tio::trim(*body));
 }
 
+/// The socinfo cell of whichever nvmem device carries one
+std::string read_socinfo_cell(const std::string& root) {
+    std::error_code ec;
+    const std::filesystem::path devices = root + "/sys/bus/nvmem/devices";
+    for (const auto& dev : std::filesystem::directory_iterator(devices, ec)) {
+        const auto cell = dev.path() / "cells" / "socinfo@6b,0";
+        if (auto raw = tio::read_file(cell.string(), 16)) {
+            return *raw;
+        }
+    }
+    return {};
+}
+
+bool is_x2600(const std::string& root) {
+    const auto compatible = tio::read_file(root + "/proc/device-tree/compatible", 4096);
+    // NUL-separated strings
+    return compatible && compatible->find("ingenic,x2600") != std::string::npos;
+}
+
 } // namespace
 
+std::optional<SocInfo> decode_socinfo(const std::string& raw) {
+    if (raw.size() < 5) {
+        return std::nullopt;
+    }
+    uint64_t bits = 0;
+    for (std::size_t i = 0; i < 5; ++i) {
+        bits |= static_cast<uint64_t>(static_cast<unsigned char>(raw[i])) << (8 * i);
+    }
+    const auto first = static_cast<uint32_t>(bits & kFieldMask);
+    const auto second = static_cast<uint32_t>((bits >> 20) & kFieldMask);
+    if (first == 0 || first != second) {
+        return std::nullopt;
+    }
+
+    // Ingenic's capacity codes 0-7 (MEM_256M .. MEM_1G); 8 and up unknown
+    static constexpr std::array<unsigned, 8> kMib = {256, 128, 64, 32, 512, 16, 8, 1024};
+    const unsigned capacity = (first >> 7) & 0xf;
+
+    SocInfo info;
+    info.id = first;
+    info.variant = (first >> 16) & 0xf;
+    info.ddr3 = (first >> 15) & 1;
+    info.ram_mib = capacity < kMib.size() ? kMib[capacity] : 0;
+    return info;
+}
+
+std::string variant_name(unsigned variant) {
+    // Ingenic's order (their SPL's soc_type)
+    static constexpr std::array<const char*, 7> kNames = {
+        "X2600", "X2600E", "X2600M", "X2600H", "X2660", "X2670", "X2670M"};
+    if (variant < kNames.size()) {
+        return kNames[variant];
+    }
+    return fmt::format("X2600 variant {}", variant);
+}
+
+std::optional<unsigned> boot_loader_ram_mib(const std::string& cmdline) {
+    static const std::string kKey = "ad5x.ram=";
+    std::optional<unsigned> mib;
+    std::size_t pos = 0;
+    while ((pos = cmdline.find(kKey, pos)) != std::string::npos) {
+        const bool word_start = pos == 0 || std::isspace(static_cast<unsigned char>(cmdline[pos - 1]));
+        pos += kKey.size();
+        if (!word_start) {
+            continue;
+        }
+        std::size_t end = pos;
+        while (end < cmdline.size() && !std::isspace(static_cast<unsigned char>(cmdline[end]))) {
+            ++end;
+        }
+        const std::string value = cmdline.substr(pos, end - pos);
+        unsigned v = 0;
+        if (value == "256") {
+            v = 256;
+        } else if (value == "512") {
+            v = 512;
+        } else {
+            return std::nullopt;
+        }
+        if (mib && *mib != v) {
+            return std::nullopt;
+        }
+        mib = v;
+    }
+    return mib;
+}
+
+std::string core_revision(const std::string& cpuinfo) {
+    // "cpu model : Ingenic XBurst II V0.0  FPU V0.0"
+    const auto line = cpuinfo.find("cpu model");
+    if (line == std::string::npos) {
+        return {};
+    }
+    const auto end = cpuinfo.find('\n', line);
+    const std::string text = cpuinfo.substr(line, end == std::string::npos ? end : end - line);
+    const auto v = text.find(" V");
+    if (v == std::string::npos) {
+        return {};
+    }
+    std::size_t stop = v + 2;
+    while (stop < text.size() && (std::isdigit(static_cast<unsigned char>(text[stop])) ||
+                                  text[stop] == '.')) {
+        ++stop;
+    }
+    return stop > v + 2 ? text.substr(v + 2, stop - v - 2) : std::string();
+}
+
+std::string processor_summary(const std::string& root) {
+    if (!is_x2600(root)) {
+        return {};
+    }
+    const auto cpuinfo = tio::read_file(root + "/proc/cpuinfo", 64 * 1024);
+    const std::string rev = cpuinfo ? core_revision(*cpuinfo) : std::string();
+    const std::string core = rev.empty() ? std::string() : fmt::format(", core {}", rev);
+
+    if (const auto soc = decode_socinfo(read_socinfo_cell(root))) {
+        const char* type = soc->ddr3 ? "DDR3" : "DDR2";
+        const std::string ram = soc->ram_mib ? fmt::format("{} MiB {}", soc->ram_mib, type)
+                                             : fmt::format("{}, size unknown", type);
+        return fmt::format("{}, {}, SoC ID 0x{:05x}{}", variant_name(soc->variant), ram, soc->id,
+                           core);
+    }
+
+    // No eFuse driver (6.6): the size Kiln's boot loader passed, if any
+    const auto cmdline = tio::read_file(root + "/proc/cmdline", 4096);
+    const auto mib = cmdline ? boot_loader_ram_mib(*cmdline) : std::nullopt;
+    const std::string ram = mib ? fmt::format(", {} MiB", *mib) : std::string();
+    return fmt::format("X2600{}, variant unknown{}", ram, core);
+}
+
 std::string emmc_summary(const std::string& root) {
     const std::string block = root + "/sys/block/mmcblk0";
     const std::string dev = block + "/device";
