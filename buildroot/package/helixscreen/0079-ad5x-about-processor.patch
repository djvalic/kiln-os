diff --git a/tests/unit/test_kiln_hardware.cpp b/tests/unit/test_kiln_hardware.cpp
index 2ca52436..719a51dd 100644
--- a/tests/unit/test_kiln_hardware.cpp
+++ b/tests/unit/test_kiln_hardware.cpp
@@ -1,8 +1,11 @@
 // SPDX-License-Identifier: GPL-3.0-or-later
 
 /**
- * Kiln OS: the About panel names the eMMC, from /sys/block/mmcblk0.
- * Values below are printer 2's A31M8C.
+ * Kiln OS: the About panel names the X2600 variant and the eMMC.
+ *
+ * The SoC information comes from the eFuse (Kiln's 7.3 kernel, nvmem cell
+ * socinfo@6b: 20 bits twice), the eMMC from /sys/block/mmcblk0. Values
+ * below are printer 2's: an X2600E with 256 MiB of DDR3 and an A31M8C.
  */
 
 #include "system/kiln_hardware.h"
@@ -18,6 +21,14 @@ namespace fs = std::filesystem;
 
 namespace {
 
+// 0x18000 twice, as the kernel returns the cell
+const std::string kSocinfoX2600E("\x00\x80\x01\x00\x18", 5);
+
+const char* kCpuinfo = "system type\t\t: xburst2-based\n"
+                       "machine\t\t\t: Flashforge Adventurer 5X\n"
+                       "processor\t\t: 0\n"
+                       "cpu model\t\t: Ingenic XBurst II V0.0  FPU V0.0\n";
+
 struct Root {
     fs::path dir;
     Root() {
@@ -38,8 +49,110 @@ struct Root {
     std::string str() const { return dir.string(); }
 };
 
+void x2600_board(const Root& r) {
+    r.put("proc/device-tree/compatible",
+          std::string("flashforge,ad5x\0ingenic,x2600\0", 31));
+    r.put("proc/cpuinfo", kCpuinfo);
+}
+
 } // namespace
 
+TEST_CASE("Kiln hardware: the SoC information decodes", "[kiln][hardware]") {
+    const auto soc = decode_socinfo(kSocinfoX2600E);
+    REQUIRE(soc);
+    CHECK(soc->id == 0x18000);
+    CHECK(soc->variant == 1);
+    CHECK(soc->ddr3);
+    CHECK(soc->ram_mib == 256);
+    CHECK(variant_name(soc->variant) == "X2600E");
+    CHECK(variant_name(0) == "X2600");
+    CHECK(variant_name(2) == "X2600M");
+    CHECK(variant_name(3) == "X2600H");
+    CHECK(variant_name(4) == "X2660");
+    CHECK(variant_name(5) == "X2670");
+    CHECK(variant_name(6) == "X2670M");
+    CHECK(variant_name(7) == "X2600 variant 7");
+}
+
+TEST_CASE("Kiln hardware: a 512 MiB X2600H decodes", "[kiln][hardware]") {
+    // variant 3, DDR3, capacity code 4 (512 MiB): 0x38200, twice
+    const uint64_t bits = 0x38200ull | (0x38200ull << 20);
+    std::string raw;
+    for (int i = 0; i < 5; ++i)
+        raw += static_cast<char>((bits >> (8 * i)) & 0xff);
+    const auto soc = decode_socinfo(raw);
+    REQUIRE(soc);
+    CHECK(soc->variant == 3);
+    CHECK(soc->ram_mib == 512);
+}
+
+TEST_CASE("Kiln hardware: a capacity code of 8 and up is unknown", "[kiln][hardware]") {
+    // variant 1, DDR3, capacity code 8 (bit 10): 0x18400, twice
+    const uint64_t bits = 0x18400ull | (0x18400ull << 20);
+    std::string raw;
+    for (int i = 0; i < 5; ++i)
+        raw += static_cast<char>((bits >> (8 * i)) & 0xff);
+    const auto soc = decode_socinfo(raw);
+    REQUIRE(soc);
+    CHECK(soc->variant == 1);
+    CHECK(soc->ram_mib == 0);
+}
+
+TEST_CASE("Kiln hardware: the boot loader's RAM size", "[kiln][hardware]") {
+    CHECK(boot_loader_ram_mib("console=ttyS0 ad5x.ram=256 ad5x.memmode=standard") == 256u);
+    CHECK(boot_loader_ram_mib("ad5x.ram=512\n") == 512u);
+    CHECK(boot_loader_ram_mib("ad5x.ram=512 ad5x.ram=512") == 512u);
+    CHECK_FALSE(boot_loader_ram_mib("console=ttyS0 mem=236M@0x0"));
+    CHECK_FALSE(boot_loader_ram_mib("ad5x.ram=256 ad5x.ram=512"));
+    CHECK_FALSE(boot_loader_ram_mib("ad5x.ram=1024"));
+    CHECK_FALSE(boot_loader_ram_mib("xad5x.ram=256"));
+}
+
+TEST_CASE("Kiln hardware: a bad SoC information is refused", "[kiln][hardware]") {
+    CHECK_FALSE(decode_socinfo(""));
+    CHECK_FALSE(decode_socinfo(std::string("\x00\x80\x01", 3)));
+    CHECK_FALSE(decode_socinfo(std::string(5, '\0')));
+    // the copies differ
+    CHECK_FALSE(decode_socinfo(std::string("\x00\x80\x01\x00\x19", 5)));
+}
+
+TEST_CASE("Kiln hardware: the core revision comes from cpuinfo", "[kiln][hardware]") {
+    CHECK(core_revision(kCpuinfo) == "0.0");
+    CHECK(core_revision("cpu model\t: Ingenic XBurst II V1.2  FPU V0.0") == "1.2");
+    CHECK(core_revision("model name\t: ARMv7") == "");
+    CHECK(core_revision("cpu model\t: Ingenic XBurst II") == "");
+}
+
+TEST_CASE("Kiln hardware: the processor row", "[kiln][hardware]") {
+    Root r;
+    SECTION("not an X2600: no row") {
+        r.put("proc/device-tree/compatible", std::string("rockchip,rk3328\0", 16));
+        CHECK(processor_summary(r.str()).empty());
+    }
+    SECTION("7.3 with the eFuse") {
+        x2600_board(r);
+        r.put("sys/bus/nvmem/devices/jz4780-efuse0/cells/socinfo@6b,0", kSocinfoX2600E);
+        CHECK(processor_summary(r.str()) == "X2600E, 256 MiB DDR3, SoC ID 0x18000, core 0.0");
+    }
+    SECTION("7.3 with an unknown capacity code") {
+        x2600_board(r);
+        r.put("sys/bus/nvmem/devices/jz4780-efuse0/cells/socinfo@6b,0",
+              std::string("\x00\x84\x01\x40\x18", 5));
+        CHECK(processor_summary(r.str()) ==
+              "X2600E, DDR3, size unknown, SoC ID 0x18400, core 0.0");
+    }
+    SECTION("6.6 without an eFuse driver or ad5x.ram=") {
+        x2600_board(r);
+        r.put("proc/cmdline", "console=ttyS0,115200n8 mem=236M@0x0\n");
+        CHECK(processor_summary(r.str()) == "X2600, variant unknown, core 0.0");
+    }
+    SECTION("6.6 with Kiln's boot loader's ad5x.ram=") {
+        x2600_board(r);
+        r.put("proc/cmdline", "console=ttyS0,115200n8 ad5x.ram=256 ad5x.memmode=standard\n");
+        CHECK(processor_summary(r.str()) == "X2600, 256 MiB, variant unknown, core 0.0");
+    }
+}
+
 TEST_CASE("Kiln hardware: the eMMC row", "[kiln][hardware]") {
     Root r;
     SECTION("no eMMC: no row") {
