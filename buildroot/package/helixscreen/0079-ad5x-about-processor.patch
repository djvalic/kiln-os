diff --git a/include/system/kiln_hardware.h b/include/system/kiln_hardware.h
index 8f2a254b..41f96f40 100644
--- a/include/system/kiln_hardware.h
+++ b/include/system/kiln_hardware.h
@@ -3,21 +3,70 @@
 
 /**
  * @file kiln_hardware.h
- * @brief Kiln OS on the AD5X: which parts the printer has.
+ * @brief Kiln OS on the AD5X: which X2600 and which eMMC the printer has.
  *
- * AD5X boards differ in parts that matter for support, such as the eMMC
- * (58A398, A31M8C, MMC8GB so far). The About panel shows it.
+ * AD5X boards differ in parts that matter for support: the X2600 variant
+ * (the X2600E has 256 MiB of DDR3 in the package, the X2600H 512 MiB) and
+ * the eMMC. The About panel shows both.
+ *
+ * The X2600's SoC information is in its eFuse. Kiln's 7.3 kernel exposes it
+ * as the nvmem cell "socinfo@6b": 20 bits, then the same 20 bits again as a
+ * check. Ingenic's 6.6 kernel has no driver for the eFuse; there the variant
+ * is unknown, and the RAM size comes from Kiln's boot loader (ad5x.ram= on
+ * the kernel command line) when it gave one.
  */
 
+#include <cstdint>
+#include <optional>
 #include <string>
 
 namespace helix::kiln_hardware {
 
+/// The X2600's SoC information, decoded
+struct SocInfo {
+    uint32_t id = 0;       ///< the 20 bits as stored
+    unsigned variant = 0;  ///< bits 19:16: 1 X2600E, 3 X2600H, ...
+    bool ddr3 = false;     ///< bit 15, else DDR2
+    unsigned ram_mib = 0;  ///< from the capacity code, bits 10:7; 0 unknown
+};
+
+/**
+ * @brief Decode the raw socinfo cell.
+ *
+ * @p raw is the cell's bytes as the kernel returns them (little-endian,
+ * at least 5). nullopt when the two copies differ or the field is blank.
+ */
+std::optional<SocInfo> decode_socinfo(const std::string& raw);
+
+/// Ingenic's name for the variant ("X2600E", "X2600H", ...), or "X2600 variant N"
+std::string variant_name(unsigned variant);
+
+/**
+ * @brief The board's RAM in MiB from ad5x.ram= in @p cmdline.
+ *
+ * 256 or 512; nullopt without one, for other values, or when it is given
+ * twice with different values.
+ */
+std::optional<unsigned> boot_loader_ram_mib(const std::string& cmdline);
+
+/// The core's revision from /proc/cpuinfo ("0.0" from "... XBurst II V0.0"), or ""
+std::string core_revision(const std::string& cpuinfo);
+
+/**
+ * @brief The processor row: "X2600E, 256 MiB DDR3, SoC ID 0x18000, core 0.0".
+ *
+ * Without the eFuse: "X2600, 256 MiB, variant unknown, core 0.0", the size
+ * from the boot loader if it gave one.
+ *
+ * @p root is the test seam: the files are read below it (/sys, /proc).
+ * "" when the machine is not an X2600.
+ */
+std::string processor_summary(const std::string& root = "");
+
 /**
  * @brief The eMMC row: "A31M8C (maker 0xEC), PRV 0x30, 58.2 GiB".
  *
- * From /sys/block/mmcblk0; "" when there is no eMMC there. @p root is the
- * test seam: the files are read below it.
+ * From /sys/block/mmcblk0; "" when there is no eMMC there.
  */
 std::string emmc_summary(const std::string& root = "");
 
