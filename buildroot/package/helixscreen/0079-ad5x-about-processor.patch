+++ b/src/ui/ui_settings_about.cpp
@@ -107,15 +107,21 @@ void AboutSettingsOverlay::init_subjects() {
         UI_MANAGED_SUBJECT_STRING(host_arch_value_subject_, host_arch_value_buf_,
                                   diag.identity.host_arch.c_str(), "host_arch_value", subjects_);
 
-        // Kiln OS on the AD5X: the eMMC (a part that differs between
