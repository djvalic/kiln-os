+TEST_CASE_METHOD(RootPwFixture, "Kiln root password: the button's request and its answer",
+                 "[kiln][kiln_rootpw]") {
+    // An old answer is deleted first
+    answer("refused: a print is running");
+    std::optional<rootpw::Answer> got;
+    rootpw::request_reset(1234, [&got](const rootpw::Answer& a) { got = a; });
+    REQUIRE(rootpw::request_pending());
+    CHECK_FALSE(fs::exists(dir.file(rootpw::kStatusFile)));
+
+    // One line, a plain file of mode 0600, renamed into place (no temporary
+    // name left behind)
+    const fs::path req = dir.file(rootpw::kRequestFile);
+    CHECK(read_file(req) == std::string("reset 1234\n"));
+    struct stat st{};
+    REQUIRE(::lstat(req.c_str(), &st) == 0);
+    CHECK(S_ISREG(st.st_mode));
+    CHECK((st.st_mode & 07777) == 0600);
+    CHECK(names_in(dir.path) == std::vector<std::string>{rootpw::kRequestFile});
+
+    // The agent takes the request and answers
+    pump(1000);
+    CHECK_FALSE(got.has_value());
+    fs::remove(req);
+    answer("done");
+    pump(rootpw::kAnswerPollMs + 50);
+    REQUIRE(got.has_value());
+    CHECK(got->kind == Kind::Done);
+    CHECK_FALSE(rootpw::request_pending());
+}
