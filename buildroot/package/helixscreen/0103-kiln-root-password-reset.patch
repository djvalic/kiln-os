+namespace {
+
+/// A request folder of the test's own, gone afterwards
+struct TempDir {
+    fs::path path;
+    TempDir() {
+        static std::atomic<int> n{0};
+        std::random_device rd;
+        path = fs::temp_directory_path() / ("kiln-rootpw-" + std::to_string(::getpid()) + "-" +
+                                            std::to_string(rd()) + "-" + std::to_string(n++));
+        fs::create_directories(path);
+        fs::permissions(path, fs::perms::owner_all, fs::perm_options::replace);
+    }
+    ~TempDir() {
+        std::error_code ec;
+        fs::remove_all(path, ec);
+    }
+    std::string str() const {
+        return path.string();
+    }
+    fs::path file(const char* name) const {
+        return path / name;
+    }
+};
+
+void write_file(const fs::path& p, const std::string& text) {
+    std::ofstream out(p, std::ios::trunc);
+    out << text;
+}
+
+std::optional<std::string> read_file(const fs::path& p) {
+    std::ifstream in(p);
+    if (!in) {
+        return std::nullopt;
+    }
+    return std::string((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+}
+
+/// The names in @p dir
+std::vector<std::string> names_in(const fs::path& dir) {
+    std::vector<std::string> names;
+    for (const auto& e : fs::directory_iterator(dir)) {
+        names.push_back(e.path().filename().string());
+    }
+    std::sort(names.begin(), names.end());
+    return names;
+}
