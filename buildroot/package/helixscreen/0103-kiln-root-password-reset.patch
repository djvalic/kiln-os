+// Kiln OS: Reset root password shows while Kiln's root agent keeps its state
+// file (kiln_rootpw_state 1), greyed during a print; locked over SSH (2) the
+// greyed row says why. The hold starts from the row's press.
+TEST_CASE_METHOD(SystemCallbacksFixture,
+                 "System page: Reset root password, unlocked, locked and without the agent",
+                 "[settings][system_callbacks][kiln]") {
+    lv_subject_t* state = lv_xml_get_subject(nullptr, "kiln_rootpw_state");
+    REQUIRE(state != nullptr);
+    lv_subject_t* locked = lv_xml_get_subject(nullptr, "kiln_rootpw_locked");
+    REQUIRE(locked != nullptr);
+    lv_subject_t* phase = lv_xml_get_subject(nullptr, "kiln_rootpw_phase");
+    REQUIRE(phase != nullptr);
+    lv_subject_t* print_active = lv_xml_get_subject(nullptr, "print_active");
+    REQUIRE(print_active != nullptr);
+    lv_obj_t* container = lv_obj_find_by_name(root_, "container_kiln_rootpw");
+    REQUIRE(container != nullptr);
+    lv_obj_t* row = lv_obj_find_by_name(root_, "row_kiln_rootpw");
+    REQUIRE(row != nullptr);
+    lv_obj_t* row_locked = lv_obj_find_by_name(root_, "row_kiln_rootpw_locked");
+    REQUIRE(row_locked != nullptr);
+    lv_obj_t* progress = lv_obj_find_by_name(root_, "kiln_rootpw_progress");
+    REQUIRE(progress != nullptr);
+    lv_obj_t* bar = lv_obj_find_by_name(root_, "kiln_rootpw_hold_bar");
+    REQUIRE(bar != nullptr);
+    const int state_before = lv_subject_get_int(state);
+
+    // No agent (and the test build is not Kiln OS): hidden
+    lv_subject_set_int(state, 0);
+    process_lvgl(5);
+    CHECK(lv_obj_has_flag(container, LV_OBJ_FLAG_HIDDEN));
+    CHECK(row_runs("row_kiln_rootpw", "on_kiln_rootpw_pressed"));
+
+    // Unlocked: the row and its hold hint, greyed during a print
+    lv_subject_set_int(state, 1);
+    process_lvgl(5);
+    CHECK_FALSE(lv_obj_has_flag(container, LV_OBJ_FLAG_HIDDEN));
+    CHECK_FALSE(lv_obj_has_flag(row, LV_OBJ_FLAG_HIDDEN));
+    CHECK(lv_obj_has_flag(row_locked, LV_OBJ_FLAG_HIDDEN));
+    CHECK(lv_obj_has_flag(progress, LV_OBJ_FLAG_HIDDEN));
+    lv_obj_t* hint = lv_obj_find_by_name(row, "description");
+    REQUIRE(hint != nullptr);
+    CHECK(std::string(lv_label_get_text(hint)) == "Hold 5 seconds: SSH login root / root");
+    CHECK_FALSE(lv_obj_has_flag(hint, LV_OBJ_FLAG_HIDDEN));
+    CHECK_FALSE(lv_obj_has_state(row, LV_STATE_DISABLED));
+    lv_subject_set_int(print_active, 1);
+    process_lvgl(5);
+    CHECK(lv_obj_has_state(row, LV_STATE_DISABLED));
+    lv_subject_set_int(print_active, 0);
+    process_lvgl(5);
+    CHECK_FALSE(lv_obj_has_state(row, LV_STATE_DISABLED));
+
+    // Held: the bar and the line under the row; waiting: the line only
+    lv_subject_set_int(phase, 1);
+    process_lvgl(5);
+    CHECK_FALSE(lv_obj_has_flag(progress, LV_OBJ_FLAG_HIDDEN));
+    CHECK_FALSE(lv_obj_has_flag(bar, LV_OBJ_FLAG_HIDDEN));
+    lv_subject_set_int(phase, 2);
+    process_lvgl(5);
+    CHECK_FALSE(lv_obj_has_flag(progress, LV_OBJ_FLAG_HIDDEN));
+    CHECK(lv_obj_has_flag(bar, LV_OBJ_FLAG_HIDDEN));
+    lv_subject_set_int(phase, 0);
+    process_lvgl(5);
+
+    // Locked over SSH: the greyed row that says how to turn it back on
+    lv_subject_set_int(state, 2);
+    lv_subject_set_int(locked, 1);
+    process_lvgl(5);
+    CHECK(lv_obj_has_flag(row, LV_OBJ_FLAG_HIDDEN));
+    CHECK_FALSE(lv_obj_has_flag(row_locked, LV_OBJ_FLAG_HIDDEN));
+    CHECK(lv_obj_has_state(row_locked, LV_STATE_DISABLED));
+    lv_obj_t* why = lv_obj_find_by_name(row_locked, "description");
+    REQUIRE(why != nullptr);
+    CHECK(std::string(lv_label_get_text(why)) ==
+          "Turned off over SSH (ad5x-passwd --unlock-reset)");
+
+    lv_subject_set_int(locked, 0);
+    lv_subject_set_int(state, state_before);
+    process_lvgl(5);
+}
+
