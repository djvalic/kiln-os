+TEST_CASE_METHOD(RootPwFixture, "Kiln root password: not from the remote pointer or no indev",
+                 "[kiln][kiln_rootpw]") {
+    state("unlocked\n");
+    CHECK_FALSE(rootpw::row().begin_hold(button, kRemote));
+    CHECK_FALSE(rootpw::row().begin_hold(button, nullptr));
+    // Without a panel of its own (DisplayManager has none) nothing counts
+    rootpw::set_panel_pointer_for_test(nullptr);
+    CHECK_FALSE(rootpw::row().begin_hold(button, nullptr));
+    CHECK(rootpw::row().phase() == rootpw::ResetRow::Phase::Idle);
+    // A greyed row (a print) takes no hold
+    rootpw::set_panel_pointer_for_test(kPanel);
+    lv_obj_add_state(button, LV_STATE_DISABLED);
+    CHECK_FALSE(rootpw::row().begin_hold(button, kPanel));
+    lv_obj_remove_state(button, LV_STATE_DISABLED);
+    CHECK(rootpw::row().begin_hold(button, kPanel));
+}
+
+TEST_CASE_METHOD(RootPwFixture, "Kiln root password: a refused request says why",
+                 "[kiln][kiln_rootpw]") {
+    state("unlocked\n");
+    REQUIRE(rootpw::row().begin_hold(button, kPanel));
+    pump(5100);
+    REQUIRE(rootpw::row().phase() == rootpw::ResetRow::Phase::Waiting);
+    fs::remove(dir.file(rootpw::kRequestFile));
+    answer("refused: the screen was used from a browser; touch it on the printer itself and try "
+           "again in 30 seconds");
+    pump(rootpw::kAnswerPollMs + 50);
+    REQUIRE(results.size() == 1);
+    CHECK(results[0].kind == Kind::Refused);
+    CHECK(rootpw::result_text(results[0]) ==
+          "The screen was used from a browser; touch it on the printer itself and try again in "
+          "30 seconds");
+    CHECK(rootpw::row().phase() == rootpw::ResetRow::Phase::Idle);
+    // Once the finger is lifted, the next hold may go again
+    pressed = false;
+    pump(300);
+    pressed = true;
+    CHECK(rootpw::row().begin_hold(button, kPanel));
+}
+
+TEST_CASE_METHOD(RootPwFixture, "Kiln root password: the answer opens a dialog",
+                 "[kiln][kiln_rootpw]") {
+    rootpw::row().set_result_sink_for_test(nullptr);
+    state("unlocked\n");
+    REQUIRE(rootpw::row().begin_hold(button, kPanel));
+    pump(5100);
+    fs::remove(dir.file(rootpw::kRequestFile));
+    answer("done");
+    pump(rootpw::kAnswerPollMs + 50);
+    const std::string text = helix::test::top_modal_text();
+    CHECK_THAT(text, ContainsSubstring("Reset root password"));
+    CHECK_THAT(text, ContainsSubstring("Log in over SSH as root with the password root"));
+    helix::test::answer_top_modal("btn_primary");
+    pump(500);
+}
+
+TEST_CASE_METHOD(RootPwFixture, "Kiln root password: one press, one request",
+                 "[kiln][kiln_rootpw]") {
+    state("unlocked\n");
+    REQUIRE(rootpw::row().begin_hold(button, kPanel));
+    pump(5100);
+    REQUIRE(rootpw::row().phase() == rootpw::ResetRow::Phase::Waiting);
+    fs::remove(dir.file(rootpw::kRequestFile));
+    answer("done");
+    pump(rootpw::kAnswerPollMs + 50);
+    REQUIRE(results.size() == 1);
+
+    // The finger is still down (and LVGL saw a new press after a short
+    // lift): no second hold, however long it stays
+    pump(3000);
+    CHECK_FALSE(rootpw::row().begin_hold(button, kPanel));
+    pressed = false;
+    pump(150);
+    pressed = true;
+    pump(100);
+    CHECK_FALSE(rootpw::row().begin_hold(button, kPanel));
+    pump(6000);
+    CHECK_FALSE(fs::exists(dir.file(rootpw::kRequestFile)));
+    CHECK(results.size() == 1);
+
+    // Let go: the next press holds again, with its own stamp
+    pressed = false;
+    pump(300);
+    pressed = true;
+    rootpw::set_boot_seconds_for_test(600);
+    REQUIRE(rootpw::row().begin_hold(button, kPanel));
+    pump(5100);
+    CHECK(read_file(dir.file(rootpw::kRequestFile)) == std::string("reset 600\n"));
+}
+
+TEST_CASE_METHOD(RootPwFixture, "Kiln root password: the factory reset's stamp is the Reset press",
+                 "[kiln][kiln_rootpw]") {
+    lv_obj_t* dialog = lv_obj_create(test_screen());
+    lv_obj_t* reset = lv_button_create(dialog);
+    lv_obj_set_name(reset, "btn_primary");
+
+    rootpw::set_boot_seconds_for_test(300);
+    rootpw::stamp_confirm_press(dialog);
+    lv_obj_send_event(reset, LV_EVENT_PRESSED, nullptr);
+    rootpw::set_boot_seconds_for_test(303); // the click, the settings reset
+    CHECK(rootpw::take_confirm_stamp() == 300);
+    // Taken once; without a press seen it is now
+    CHECK(rootpw::take_confirm_stamp() == 303);
+
+    // A new question forgets an old press
+    lv_obj_send_event(reset, LV_EVENT_PRESSED, nullptr);
+    rootpw::stamp_confirm_press(dialog);
+    rootpw::set_boot_seconds_for_test(310);
+    CHECK(rootpw::take_confirm_stamp() == 310);
+    lv_obj_delete(dialog);
+}
