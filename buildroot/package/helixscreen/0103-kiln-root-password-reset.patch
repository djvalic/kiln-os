+    // In the System page, once, inside perform_factory_reset()
+    const auto text = read_file(helix::asset_path("src/ui/settings/ui_settings_system.cpp"));
+    REQUIRE(text.has_value());
+    const std::string head = "void SystemSettingsOverlay::perform_factory_reset() {";
+    const auto begin = text->find(head);
+    REQUIRE(begin != std::string::npos);
+    const auto end = text->find("\n}\n", begin);
+    REQUIRE(end != std::string::npos);
+    const auto call = text->find("request_factory_reset(");
+    CHECK(call > begin);
+    CHECK(call < end);
+    CHECK(text->find("request_factory_reset(", call + 1) == std::string::npos);
