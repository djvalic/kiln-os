+/// Every file under src/ and include/ whose text has @p needle
+std::vector<std::string> sources_with(const std::string& needle) {
+    std::vector<std::string> hits;
+    for (const char* top : {"src", "include"}) {
+        const fs::path root = helix::asset_path(top);
+        REQUIRE(fs::is_directory(root));
+        for (const auto& e : fs::recursive_directory_iterator(root)) {
+            const auto ext = e.path().extension();
+            if (!e.is_regular_file() || (ext != ".cpp" && ext != ".h" && ext != ".c")) {
+                continue;
+            }
+            const auto text = read_file(e.path());
+            if (text && text->find(needle) != std::string::npos) {
+                hits.push_back(fs::relative(e.path(), helix::asset_path(".")).generic_string());
+            }
+        }
+    }
+    std::sort(hits.begin(), hits.end());
+    return hits;
+}
