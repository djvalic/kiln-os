+    CHECK(sources_with("screen-request") ==
+          std::vector<std::string>{"include/ui_settings_kiln_rootpw.h"});
+    CHECK(sources_with("request_factory_reset(") ==
+          std::vector<std::string>{"include/ui_settings_kiln_rootpw.h",
+                                   "src/ui/settings/ui_settings_system.cpp",
+                                   "src/ui/ui_settings_kiln_rootpw.cpp"});
