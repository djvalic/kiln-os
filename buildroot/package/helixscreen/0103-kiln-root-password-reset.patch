+/// Stand-ins for input devices: only compared, never read
+lv_indev_t* fake_indev(int which) {
+    static char devices[3];
+    return reinterpret_cast<lv_indev_t*>(&devices[which]);
+}
+lv_indev_t* const kPanel = fake_indev(0);
+lv_indev_t* const kRemote = fake_indev(1);
