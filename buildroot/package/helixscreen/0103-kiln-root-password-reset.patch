+#include <sys/stat.h>
+#include <unistd.h>
+#include <vector>
+
+namespace helix::kiln_rootpw {
+
+namespace {
+
+// The touch screen is the AD5X's own (HELIX_KILN_AD5X, set in
+// buildroot/package/helixscreen/helixscreen.mk); other builds have no agent
+// behind the folder.
+#if defined(HELIX_KILN_AD5X)
+constexpr bool kBuiltIn = true;
+#else
+constexpr bool kBuiltIn = false;
+#endif
+
+std::optional<bool> g_available_override;
+std::optional<std::string> g_dir_override;
+std::optional<lv_indev_t*> g_panel_override;
+std::optional<uint64_t> g_boot_override;
+std::optional<uint64_t> g_confirm_press;
+
+/// What the request file says. Only request_factory_reset() names
+/// FactoryReset.
+enum class RequestKind { Reset, FactoryReset };
+
+std::string path_in(const std::string& dir, const char* name) {
+    return dir + "/" + name;
+}
+
+/// A real folder, not a link to one
+bool plain_dir(const std::string& dir) {
+    struct stat st{};
+    return ::lstat(dir.c_str(), &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+/// The first line of a plain file (not a link, FIFO or device), at most
+/// 512 bytes of it; nullopt when there is none.
+std::optional<std::string> read_line(const std::string& path) {
+    struct stat st{};
+    if (::lstat(path.c_str(), &st) != 0 || !S_ISREG(st.st_mode)) {
+        return std::nullopt;
+    }
+    const int fd = ::open(path.c_str(), O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0) {
+        return std::nullopt;
+    }
+    char buf[512];
+    const ssize_t n = ::read(fd, buf, sizeof(buf));
+    ::close(fd);
+    if (n < 0) {
+        return std::nullopt;
+    }
+    std::string text(buf, static_cast<size_t>(n));
+    const auto nl = text.find('\n');
+    if (nl != std::string::npos) {
+        text.resize(nl);
+    }
+    return text;
+}
+
+std::string_view trim(std::string_view s) {
+    while (!s.empty() &&
+           (s.back() == '\n' || s.back() == '\r' || s.back() == ' ' || s.back() == '\t')) {
+        s.remove_suffix(1);
+    }
+    while (!s.empty() && (s.front() == ' ' || s.front() == '\t')) {
+        s.remove_prefix(1);
+    }
+    return s;
+}
+
+bool write_all(int fd, const char* text) {
+    size_t left = std::strlen(text);
+    while (left > 0) {
+        const ssize_t n = ::write(fd, text, left);
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n <= 0) {
+            return false;
+        }
+        text += n;
+        left -= static_cast<size_t>(n);
+    }
+    return true;
+}
+
+/// The request's one line: the kind and @p stamp, boot-time seconds
+/// (the agent refuses one more than 10 s old)
+std::string request_line(RequestKind kind, uint64_t stamp) {
+    return std::string(kind == RequestKind::FactoryReset ? "factory-reset" : "reset") + " " +
+           std::to_string(stamp) + "\n";
+}
+
+/// The request in @p dir: the old answer deleted, then one line under a
+/// temporary name (mode 0600) renamed into place, so the agent never reads
+/// half a file.
+bool write_request(const std::string& dir, RequestKind kind, uint64_t stamp) {
+    if (!plain_dir(dir)) {
+        spdlog::warn("[Kiln root password] No request folder {}", dir);
+        return false;
+    }
+    const std::string status = path_in(dir, kStatusFile);
+    if (::unlink(status.c_str()) != 0 && errno != ENOENT) {
+        spdlog::warn("[Kiln root password] Could not delete {}: {}", status, std::strerror(errno));
+        return false;
+    }
+    std::string tmpl = path_in(dir, ".s.XXXXXX");
+    std::vector<char> name(tmpl.begin(), tmpl.end());
+    name.push_back('\0');
+    const int fd = ::mkstemp(name.data());
+    if (fd < 0) {
+        spdlog::warn("[Kiln root password] Could not write in {}: {}", dir, std::strerror(errno));
+        return false;
+    }
+    const std::string line = request_line(kind, stamp);
+    bool ok = ::fchmod(fd, 0600) == 0 && write_all(fd, line.c_str());
+    ok = ::close(fd) == 0 && ok;
+    const std::string request = path_in(dir, kRequestFile);
+    if (ok && ::rename(name.data(), request.c_str()) != 0) {
+        ok = false;
+    }
+    if (!ok) {
+        spdlog::warn("[Kiln root password] Could not write {}: {}", request, std::strerror(errno));
+        ::unlink(name.data());
+    }
+    return ok;
+}
+
+/// The one request on its way
+struct Pending {
+    Done done;
+    std::string dir;
+    uint32_t since = 0;
+    lv_timer_t* timer = nullptr;
+};
+std::optional<Pending> g_pending;
+
+/// End the request: its timer goes, then its answer (which may send the next)
+void finish(const Answer& answer) {
+    if (!g_pending) {
+        return;
+    }
+    Done done = std::move(g_pending->done);
+    if (g_pending->timer) {
+        lv_timer_delete(g_pending->timer);
+    }
+    g_pending.reset();
+    if (done) {
+        done(answer);
+    }
+}
+
+void poll_cb(lv_timer_t*) {
+    if (!g_pending) {
+        return;
+    }
+    if (auto line = read_line(path_in(g_pending->dir, kStatusFile))) {
+        const Answer answer = parse_status(*line);
+        spdlog::info("[Kiln root password] The system answered '{}'", trim(*line));
+        finish(answer);
+        return;
+    }
+    if (lv_tick_elaps(g_pending->since) >= kAnswerTimeoutMs) {
+        // Delete the request the screen wrote, if the agent has not picked it
+        // up: a late reset can't land after the screen said there was none
+        const std::string request = path_in(g_pending->dir, kRequestFile);
+        ::unlink(request.c_str());
+        spdlog::warn("[Kiln root password] No answer from the system in {} ms", kAnswerTimeoutMs);
+        finish(Answer{Answer::Kind::NoAnswer, {}});
+    }
+}
+
+void send(RequestKind kind, uint64_t stamp, Done done) {
+    if (g_pending) {
+        // One request at a time: the waiting one gets no answer of its own
+        finish(Answer{Answer::Kind::NoAnswer, {}});
+    }
+    const std::string dir = request_dir();
+    spdlog::info("[Kiln root password] Request: {} (from {} s after boot)",
+                 kind == RequestKind::FactoryReset ? "factory reset" : "reset", stamp);
+    if (!write_request(dir, kind, stamp)) {
+        if (done) {
+            done(Answer{Answer::Kind::NotSent, {}});
+        }
+        return;
+    }
+    g_pending = Pending{std::move(done), dir, lv_tick_get(), nullptr};
+    g_pending->timer = lv_timer_create(poll_cb, kAnswerPollMs, nullptr);
+}
+
+void drop_pending() {
+    if (g_pending && g_pending->timer) {
+        lv_timer_delete(g_pending->timer);
+    }
+    g_pending.reset();
+}
+
+bool starts_with(std::string_view s, std::string_view prefix) {
+    return s.substr(0, prefix.size()) == prefix;
+}
+
+} // namespace
+
+bool available() {
+    return g_available_override.value_or(kBuiltIn);
+}
+
+void set_available_for_test(std::optional<bool> value) {
+    g_available_override = value;
+}
+
+std::string request_dir() {
+    return g_dir_override.value_or(kRequestDir);
+}
+
+void set_request_dir_for_test(std::optional<std::string> dir) {
+    g_dir_override = std::move(dir);
+}
+
+RowState read_row_state(const std::string& dir) {
+    if (!plain_dir(dir)) {
+        return RowState::Hidden;
+    }
+    const auto line = read_line(path_in(dir, kStateFile));
+    if (!line) {
+        return RowState::Hidden;
+    }
+    // Anything but "unlocked" is locked: greyed is the safe side
+    return trim(*line) == "unlocked" ? RowState::Unlocked : RowState::Locked;
+}
+
+Answer parse_status(std::string_view line) {
+    const std::string_view s = trim(line);
+    if (s == "done") {
+        return Answer{Answer::Kind::Done, {}};
+    }
+    if (starts_with(s, "refused: ")) {
+        return Answer{Answer::Kind::Refused, std::string(trim(s.substr(9)))};
+    }
+    if (starts_with(s, "failed: ")) {
+        return Answer{Answer::Kind::Failed, std::string(trim(s.substr(8)))};
+    }
+    return Answer{Answer::Kind::Failed, std::string(s)};
+}
+
+std::string reason_text(const Answer& answer) {
+    switch (answer.kind) {
+    case Answer::Kind::Done:
+        return {};
+    case Answer::Kind::NoAnswer:
+        return lv_tr("No answer from the system, try again");
+    case Answer::Kind::NotSent:
+        return lv_tr("Could not send the request to the system");
+    case Answer::Kind::Refused:
+    case Answer::Kind::Failed:
+        break;
+    }
+    // The agent's reasons (S68ad5x-update-agent, screen_password_request)
+    const std::string& r = answer.reason;
+    if (r == "password reset is locked (turned off over SSH)") {
+        return lv_tr("Password reset is locked (turned off over SSH)");
+    }
+    if (r == "the screen was used from a browser; touch it on the printer itself and try again "
+             "in 30 seconds") {
+        return lv_tr("The screen was used from a browser; touch it on the printer itself and try "
+                     "again in 30 seconds");
+    }
+    if (r == "a print is running") {
+        return lv_tr("A print is running");
+    }
+    if (r == "the request came too late; try again") {
+        return lv_tr("The request came too late; try again");
+    }
+    if (r == "bad request") {
+        return lv_tr("Bad request");
+    }
+    // ad5x-passwd's own message, as it is
+    return r.empty() ? std::string(lv_tr("Failed")) : r;
+}
+
+std::string result_text(const Answer& answer) {
+    if (answer.kind == Answer::Kind::Done) {
+        return lv_tr("Root password reset. Log in over SSH as root with the password root, then "
+                     "run passwd to choose your own.");
+    }
+    return reason_text(answer);
+}
+
+std::string factory_reset_toast(const Answer& answer) {
+    if (answer.kind == Answer::Kind::Done) {
+        return lv_tr("Settings reset to defaults. Root password is root. Restarting...");
+    }
+    return fmt::format(
+        fmt::runtime(lv_tr(
+            "Settings reset to defaults. The root password was not reset: {}. Restarting...")),
+        reason_text(answer));
+}
+
+bool is_physical_touch(const lv_indev_t* active, const lv_indev_t* panel) {
+    return panel != nullptr && active == panel;
+}
+
+lv_indev_t* panel_pointer() {
+    if (g_panel_override) {
+        return *g_panel_override;
+    }
+    DisplayManager* dm = DisplayManager::instance();
+    return dm ? dm->pointer_input() : nullptr;
+}
+
+void set_panel_pointer_for_test(std::optional<lv_indev_t*> indev) {
+    g_panel_override = indev;
+}
+
+void request_reset(uint64_t stamp, Done done) {
+    send(RequestKind::Reset, stamp, std::move(done));
+}
+
+void request_factory_reset(uint64_t stamp, Done done) {
+    send(RequestKind::FactoryReset, stamp, std::move(done));
+}
+
+uint64_t boot_seconds() {
+    if (g_boot_override) {
+        return *g_boot_override;
+    }
+    struct timespec ts{};
+    if (::clock_gettime(CLOCK_BOOTTIME, &ts) != 0) {
+        return 0;
+    }
+    return static_cast<uint64_t>(ts.tv_sec);
+}
+
+void set_boot_seconds_for_test(std::optional<uint64_t> seconds) {
+    g_boot_override = seconds;
+}
+
+void stamp_confirm_press(lv_obj_t* dialog) {
+    g_confirm_press.reset();
+    lv_obj_t* button = dialog ? lv_obj_find_by_name(dialog, "btn_primary") : nullptr;
+    if (!button) {
+        return;
+    }
+    lv_obj_add_event_cb(
+        button, [](lv_event_t*) { g_confirm_press = boot_seconds(); }, LV_EVENT_PRESSED, nullptr);
+}
+
+uint64_t take_confirm_stamp() {
+    const uint64_t stamp = g_confirm_press.value_or(boot_seconds());
+    g_confirm_press.reset();
+    return stamp;
+}
+
+bool request_pending() {
+    return g_pending.has_value();
+}
+
+// ---------------------------------------------------------------------------
+// The row
+// ---------------------------------------------------------------------------
+
+ResetRow::~ResetRow() {
+    subjects_.deinit_all();
+}
+
+void ResetRow::init_subjects() {
+    if (subjects_initialized_) {
+        return;
+    }
+    // 1: the row; 2: the greyed row that says the reset is locked; 0: neither
+    UI_MANAGED_SUBJECT_INT(state_subject_, 0, "kiln_rootpw_state", subjects_);
+    UI_MANAGED_SUBJECT_INT(locked_subject_, 0, "kiln_rootpw_locked", subjects_);
+    UI_MANAGED_SUBJECT_INT(phase_subject_, 0, "kiln_rootpw_phase", subjects_);
+    UI_MANAGED_SUBJECT_INT(hold_pct_subject_, 0, "kiln_rootpw_hold_pct", subjects_);
+    UI_MANAGED_SUBJECT_STRING(status_subject_, status_buf_, "", "kiln_rootpw_status", subjects_);
+    subjects_initialized_ = true;
+    if (available()) {
+        refresh();
+        if (!state_timer_) {
+            state_timer_ = lv_timer_create(state_timer_cb, kStateRefreshMs, nullptr);
+        }
+    }
+}
+
+void ResetRow::refresh() {
+    if (!subjects_initialized_) {
+        return;
+    }
+    const RowState was = state_;
+    state_ = available() ? read_row_state(request_dir()) : RowState::Hidden;
+    if (lv_subject_get_int(&state_subject_) != static_cast<int>(state_)) {
+        lv_subject_set_int(&state_subject_, static_cast<int>(state_));
+    }
+    const int locked = state_ == RowState::Locked ? 1 : 0;
+    if (lv_subject_get_int(&locked_subject_) != locked) {
+        lv_subject_set_int(&locked_subject_, locked);
+    }
+    if (was != state_) {
+        spdlog::info("[Kiln root password] Reset button: {}",
+                     state_ == RowState::Unlocked ? "unlocked"
+                     : state_ == RowState::Locked ? "locked over SSH"
+                                                  : "no system agent");
+    }
+    // Locked (or gone) while held: the hold ends
+    if (state_ != RowState::Unlocked && phase_ == Phase::Holding) {
+        stop_hold_timer();
+        hold_.cancel();
+        set_phase(Phase::Idle);
+    }
+}
+
+void ResetRow::on_pressed(lv_event_t* e) {
+    auto* target = static_cast<lv_obj_t*>(lv_event_get_current_target(e));
+    row().begin_hold(target, lv_indev_active());
+}
+
+bool ResetRow::begin_hold(lv_obj_t* target, const lv_indev_t* active) {
+    if (!available() || !subjects_initialized_ || phase_ != Phase::Idle) {
+        return false;
+    }
+    if (spent_) {
+        spdlog::info("[Kiln root password] Still the press that reset: let go first");
+        return false;
+    }
+    if (!is_physical_touch(active, panel_pointer())) {
+        spdlog::info("[Kiln root password] Press not from the touch panel: ignored");
+        return false;
+    }
+    refresh();
+    if (state_ != RowState::Unlocked) {
+        return false;
+    }
+    if (target && lv_obj_has_state(target, LV_STATE_DISABLED)) {
+        return false;
+    }
+    row_ = target;
+    // The panel itself is down on the row now: an event sent from inside
+    // HelixScreen (a Lua plugin runs in its process) while a finger is
+    // somewhere else on the panel starts nothing
+    if (!probe_ && !pressed_on_row()) {
+        row_ = nullptr;
+        spdlog::info("[Kiln root password] Press not on the row: ignored");
+        return false;
+    }
+    hold_stamp_ = boot_seconds();
+    hold_.start(lv_tick_get());
+    set_phase(Phase::Holding);
+    hold_timer_ = lv_timer_create(hold_timer_cb, kHoldTickMs, nullptr);
+    return true;
+}
+
+void ResetRow::hold_timer_cb(lv_timer_t*) {
+    row().tick();
+}
+
+void ResetRow::state_timer_cb(lv_timer_t*) {
+    row().refresh();
+}
+
+bool ResetRow::pressed_on_row() const {
+    lv_obj_t* r = row_.get();
+    lv_indev_t* panel = panel_pointer();
+    if (!r || !panel) {
+        return false;
+    }
+    if (lv_obj_has_state(r, LV_STATE_DISABLED) || lv_obj_is_hidden(r)) {
+        return false;
+    }
+    if (lv_indev_get_state(panel) != LV_INDEV_STATE_PRESSED) {
+        return false;
+    }
+    // A scroll is no hold
+    if (lv_indev_get_scroll_obj(panel) != nullptr) {
+        return false;
+    }
+    lv_point_t p{};
+    lv_indev_get_point(panel, &p);
+    lv_area_t a{};
+    lv_obj_get_coords(r, &a);
+    return p.x >= a.x1 && p.x <= a.x2 && p.y >= a.y1 && p.y <= a.y2;
+}
+
+void ResetRow::tick() {
+    const uint32_t now = lv_tick_get();
+    const bool pressed = probe_ ? probe_() : pressed_on_row();
+    switch (hold_.feed(pressed, now)) {
+    case ResetHold::Step::Holding:
+        lv_subject_set_int(&hold_pct_subject_, hold_.percent(now));
+        break;
+    case ResetHold::Step::Fired:
+        stop_hold_timer();
+        lv_subject_set_int(&hold_pct_subject_, 100);
+        // Once per press: no new hold until the panel has been let go
+        spent_ = true;
+        spent_last_pressed_ = now;
+        if (!rearm_timer_) {
+            rearm_timer_ = lv_timer_create(rearm_timer_cb, kHoldTickMs, nullptr);
+        }
+        fire();
+        break;
+    case ResetHold::Step::Cancelled:
+    case ResetHold::Step::Idle:
+        stop_hold_timer();
+        set_phase(Phase::Idle);
+        break;
+    }
+}
+
+void ResetRow::rearm_timer_cb(lv_timer_t*) {
+    row().rearm_tick();
+}
+
+bool ResetRow::panel_pressed() const {
+    lv_indev_t* panel = panel_pointer();
+    return panel && lv_indev_get_state(panel) == LV_INDEV_STATE_PRESSED;
+}
+
+void ResetRow::rearm_tick() {
+    const uint32_t now = lv_tick_get();
+    // Anywhere on the panel: the answer's dialog may be under the finger now
+    const bool pressed = probe_ ? probe_() : panel_pressed();
+    if (pressed) {
+        spent_last_pressed_ = now;
+        return;
+    }
+    // Let go for longer than a bridged lift: the next press may hold again
+    if (now - spent_last_pressed_ > kHoldGapMs) {
+        spent_ = false;
+        if (rearm_timer_) {
+            lv_timer_delete(rearm_timer_);
+            rearm_timer_ = nullptr;
+        }
+    }
+}
+
+void ResetRow::set_phase(Phase phase) {
+    phase_ = phase;
+    lv_subject_set_int(&phase_subject_, static_cast<int>(phase));
+    if (phase != Phase::Holding) {
+        lv_subject_set_int(&hold_pct_subject_, 0);
+    }
+    const char* text = phase == Phase::Holding   ? lv_tr("Keep holding...")
+                       : phase == Phase::Waiting ? lv_tr("Resetting...")
+                                                 : "";
+    lv_subject_set_string(&status_subject_, text);
+}
+
+void ResetRow::stop_hold_timer() {
+    if (hold_timer_) {
+        lv_timer_delete(hold_timer_);
+        hold_timer_ = nullptr;
+    }
+}
+
+void ResetRow::fire() {
+    spdlog::warn("[Kiln root password] 5 s hold on the touch panel: resetting root's password");
+    set_phase(Phase::Waiting);
+    request_reset(hold_stamp_, [this](const Answer& answer) { answered(answer); });
+}
+
+void ResetRow::answered(const Answer& answer) {
+    set_phase(Phase::Idle);
+    refresh();
+    if (answer.kind == Answer::Kind::Done) {
+        spdlog::warn("[Kiln root password] Root's password is root again");
+    } else {
+        spdlog::warn("[Kiln root password] Not reset: {}", reason_text(answer));
+    }
+    if (sink_) {
+        sink_(answer);
+        return;
+    }
+    const std::string text = result_text(answer);
+    helix::ui::modal_alert(lv_tr("Reset root password"), text.c_str(),
+                           answer.kind == Answer::Kind::Done ? ModalSeverity::Info
+                                                             : ModalSeverity::Warning,
+                           lv_tr("OK"));
+}
+
+void ResetRow::reset_for_test() {
+    stop_hold_timer();
+    if (rearm_timer_) {
+        lv_timer_delete(rearm_timer_);
+        rearm_timer_ = nullptr;
+    }
+    spent_ = false;
+    hold_.cancel();
+    drop_pending();
+    if (state_timer_) {
+        lv_timer_delete(state_timer_);
+        state_timer_ = nullptr;
+    }
+    row_ = nullptr;
+    probe_ = nullptr;
+    sink_ = nullptr;
+    state_ = RowState::Hidden;
+    if (subjects_initialized_) {
+        set_phase(Phase::Idle);
+        lv_subject_set_int(&state_subject_, 0);
+        lv_subject_set_int(&locked_subject_, 0);
+    } else {
+        phase_ = Phase::Idle;
+    }
+}
+
+ResetRow& row() {
+    return helix::lazy_global<ResetRow>("KilnRootPasswordRow");
+}
+
+} // namespace helix::kiln_rootpw
