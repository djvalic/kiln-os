+struct RootPwFixture : LVGLUITestFixture {
+    TempDir dir;
+    bool pressed = true;
+    std::vector<rootpw::Answer> results;
+    lv_obj_t* button = nullptr;
+
+    RootPwFixture() {
+        rootpw::set_available_for_test(true);
+        rootpw::set_request_dir_for_test(dir.str());
+        rootpw::set_panel_pointer_for_test(kPanel);
+        rootpw::set_boot_seconds_for_test(500);
+        rootpw::row().init_subjects();
+        rootpw::row().reset_for_test();
+        rootpw::row().set_press_probe_for_test([this] { return pressed; });
+        rootpw::row().set_result_sink_for_test(
+            [this](const rootpw::Answer& a) { results.push_back(a); });
+        button = lv_button_create(test_screen());
+    }
+
+    /// @p ms of virtual time in kStep steps, running the timers armed since
+    /// the fixture began as LVGL's handler would (the test pump runs no
+    /// periodic timer: the hold's, the answer's and the re-arm's are ones)
+    void pump(uint32_t ms) {
+        constexpr uint32_t kStep = 10;
+        for (uint32_t t = 0; t < ms; t += kStep) {
+            process_lvgl(kStep);
+            const uint32_t now = lv_tick_get();
+            std::vector<lv_timer_t*> due;
+            for (lv_timer_t* tm = lv_timer_get_next(nullptr); tm; tm = lv_timer_get_next(tm)) {
+                if (!before_.contains(tm) && tm->timer_cb && tm->repeat_count < 0 &&
+                    !tm->paused && now - tm->last_run >= tm->period) {
+                    due.push_back(tm);
+                }
+            }
+            for (lv_timer_t* tm : due) {
+                if (timer_is_live(tm)) {
+                    tm->last_run = now;
+                    tm->timer_cb(tm);
+                }
+            }
+        }
+    }
+
+    helix::test::TimerSnapshot before_;
+
+    ~RootPwFixture() override {
+        rootpw::row().reset_for_test();
+        rootpw::set_panel_pointer_for_test(std::nullopt);
+        rootpw::set_boot_seconds_for_test(std::nullopt);
+        rootpw::set_request_dir_for_test(std::nullopt);
+        rootpw::set_available_for_test(std::nullopt);
+        helix::ui::UpdateQueue::instance().drain();
+    }
+
+    void state(const char* text) {
+        write_file(dir.file(rootpw::kStateFile), text);
+        rootpw::row().refresh();
+    }
+
+    /// The agent's answer
+    void answer(const char* line) {
+        write_file(dir.file(rootpw::kStatusFile), std::string(line) + "\n");
+    }
+
+    static int subject(const char* name) {
+        lv_subject_t* s = lv_xml_get_subject(nullptr, name);
+        REQUIRE(s != nullptr);
+        return lv_subject_get_int(s);
+    }
+
+    static std::string status_line() {
+        lv_subject_t* s = lv_xml_get_subject(nullptr, "kiln_rootpw_status");
+        REQUIRE(s != nullptr);
+        return lv_subject_get_string(s);
+    }
+};
