+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * @file ui_settings_kiln_rootpw.h
+ * @brief Kiln OS: Settings > System > Reset root password, and root's
+ *        password in Settings > System > Factory reset
+ *
+ * HelixScreen runs as root and asks Kiln's root update agent
+ * (S68ad5x-update-agent) through files in /run/ad5x/screen-request, a folder
+ * of root's (0700) in RAM. Moonraker, Klipper, G-code and plugins can't reach
+ * it; this is the touch screen's own way in (Kiln OS
+ * docs/helixscreen-integration.md, "Root password reset").
+ *
+ * - The request: root-password-default.status is deleted, then
+ *   root-password-default is written, one line ("reset <stamp>" or
+ *   "factory-reset <stamp>", the stamp CLOCK_BOOTTIME in whole seconds at the
+ *   start of the hold or when the factory reset was confirmed), mode 0600,
+ *   under a temporary name and renamed into place. The agent refuses a
+ *   request more than 10 s old, and one within 30 s of a touch from Kiln's
+ *   browser screen view.
+ * - The answer: root-password-default.status, one line: "done",
+ *   "refused: <reason>" or "failed: <reason>". The agent's screen loop looks
+ *   every second, apart from its main loop; after kAnswerTimeoutMs the
+ *   screen gives up and deletes the request it wrote, so a late reset can't
+ *   land.
+ * - The lock: root-password-reset.state, "unlocked" or "locked" (the owner's
+ *   ad5x-passwd --lock-reset over SSH). Missing: no agent, no row.
+ *
+ * The button resets root's password to "root" after a hold of kHoldMs on the
+ * printer's own touch panel (DisplayManager's pointer): not the remote pointer
+ * (helix::remote::RemotePointer), not an event made without an input device
+ * (ctl click, a plugin). HelixScreen's Lua plugins run in its process, so
+ * this check is what keeps them out: the press must come from the panel's
+ * indev, the panel must be down on the row then, and the hold is timed from
+ * the panel's own state, never from events. Touches from Kiln's browser screen view arrive on the
+ * panel's own input device; the agent refuses those from its own record.
+ *
+ * Only request_factory_reset() writes "factory-reset", and only
+ * SystemSettingsOverlay::perform_factory_reset() calls it (a test reads the
+ * sources for that). The agent applies it whatever the lock says.
+ *
+ * Both are Kiln OS builds only (HELIX_KILN_AD5X); tests override available().
+ *
+ * @threading Main thread
+ */
+
+#pragma once
+
+#include "ui_widget_ref.h"
+
+#include "lvgl/lvgl.h"
+#include "subject_managed_panel.h"
+#include "touch_hold_gesture.h"
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace helix::kiln_rootpw {
+
+/// The agent's folder for the touch screen's requests
+inline constexpr const char* kRequestDir = "/run/ad5x/screen-request";
+inline constexpr const char* kRequestFile = "root-password-default";
+inline constexpr const char* kStatusFile = "root-password-default.status";
+inline constexpr const char* kStateFile = "root-password-reset.state";
+
+/// The hold on the button, from the press
+inline constexpr uint32_t kHoldMs = 5000;
+/// A lift this long inside the hold does not end it (the resistive panel
+/// drops a reading now and then under load), as for the hold to calibrate
+inline constexpr uint32_t kHoldGapMs = kCalibrationHoldGapMs;
+/// How often the hold looks at the panel
+inline constexpr uint32_t kHoldTickMs = 50;
+/// How long the screen waits for the agent's answer (it looks every second)
+inline constexpr uint32_t kAnswerTimeoutMs = 10000;
+/// How often the screen looks for the answer
+inline constexpr uint32_t kAnswerPollMs = 250;
+/// How often the row re-reads the lock (the agent rewrites it within 3 s)
+inline constexpr uint32_t kStateRefreshMs = 2000;
+/// The factory reset's toast stays this long before HelixScreen restarts
+inline constexpr uint32_t kFactoryResetRestartMs = 4000;
+
+/// True on HELIX_KILN_AD5X builds; tests override it.
+bool available();
+void set_available_for_test(std::optional<bool> value);
+
+/// The request folder (kRequestDir; tests use a folder of their own).
+std::string request_dir();
+void set_request_dir_for_test(std::optional<std::string> dir);
+
+/// The row, from the state file in @p dir
+enum class RowState {
+    Hidden = 0,   ///< No state file: no agent (or not Kiln OS)
+    Unlocked = 1, ///< "unlocked": the hold resets the password
+    Locked = 2,   ///< "locked" (or anything else): greyed, says why
+};
+RowState read_row_state(const std::string& dir);
+
+/// The agent's answer, or why there is none
+struct Answer {
+    enum class Kind {
+        Done,     ///< "done": root's password is "root", already in use
+        Refused,  ///< "refused: <reason>"
+        Failed,   ///< "failed: <reason>"
+        NoAnswer, ///< Nothing within kAnswerTimeoutMs
+        NotSent,  ///< The request could not be written (no folder, ...)
+    };
+    Kind kind = Kind::NoAnswer;
+    std::string reason; ///< The agent's text after "refused: " / "failed: "
+};
+
+/// The status file's one line (trailing newline and spaces ignored);
+/// anything else is a failure with the line as its reason.
+Answer parse_status(std::string_view line);
+
+/// The reason shown, in the screen's language: the agent's known reasons
+/// translated, an unknown one (ad5x-passwd's own message) as it is.
+std::string reason_text(const Answer& answer);
+
+/// The button's result dialog text
+std::string result_text(const Answer& answer);
+
+/// The factory reset's toast once the agent answered
+std::string factory_reset_toast(const Answer& answer);
+
+/// The press came from the printer's own touch panel: @p active (the
+/// event's lv_indev_active()) is @p panel (DisplayManager's pointer), and
+/// there is one.
+bool is_physical_touch(const lv_indev_t* active, const lv_indev_t* panel);
+
+/// DisplayManager's pointer (nullptr without one); tests set their own.
+lv_indev_t* panel_pointer();
+void set_panel_pointer_for_test(std::optional<lv_indev_t*> indev);
+
+/// CLOCK_BOOTTIME in whole seconds: the request's stamp (tests set their own)
+uint64_t boot_seconds();
+void set_boot_seconds_for_test(std::optional<uint64_t> seconds);
+
+/// The factory reset's question @p dialog: remember when its Reset button
+/// (btn_primary) is pressed, for the request's stamp
+void stamp_confirm_press(lv_obj_t* dialog);
+/// That press's boot_seconds() (now, when none was seen), then forgotten
+uint64_t take_confirm_stamp();
+
+/// The answer, on the main thread
+using Done = std::function<void(const Answer&)>;
+
+/// The button's request, "reset <stamp>", @p stamp the boot_seconds() when
+/// the hold began. One request at a time: a new one drops the waiting one's
+/// answer.
+void request_reset(uint64_t stamp, Done done);
+
+/// The factory reset's request, "factory-reset <stamp>", @p stamp the
+/// boot_seconds() when the reset was confirmed. SystemSettingsOverlay::
+/// perform_factory_reset() only.
+void request_factory_reset(uint64_t stamp, Done done);
+
+/// A request is waiting for its answer
+bool request_pending();
+
+/// The 5 s hold, without LVGL: a press starts it; pressed samples keep it;
+/// a lift ends it once longer than kHoldGapMs (from the last pressed sample);
+/// it fires on a pressed sample kHoldMs after the press. Times are
+/// lv_tick_get() milliseconds; unsigned differences, so the tick may wrap.
+class ResetHold {
+  public:
+    enum class Step {
+        Idle,      ///< No hold
+        Holding,   ///< Still holding (or a short lift being bridged)
+        Fired,     ///< kHoldMs reached: the request goes out
+        Cancelled, ///< Lifted for longer than kHoldGapMs
+    };
+
+    void start(uint32_t now) {
+        active_ = true;
+        since_ = now;
+        last_pressed_ = now;
+    }
+
+    void cancel() {
+        active_ = false;
+    }
+
+    /// One look at the panel at @p now
+    Step feed(bool pressed, uint32_t now) {
+        if (!active_) {
+            return Step::Idle;
+        }
+        if (!pressed) {
+            if (now - last_pressed_ > kHoldGapMs) {
+                active_ = false;
+                return Step::Cancelled;
+            }
+            return Step::Holding;
+        }
+        last_pressed_ = now;
+        if (now - since_ >= kHoldMs) {
+            active_ = false;
+            return Step::Fired;
+        }
+        return Step::Holding;
+    }
+
+    bool active() const {
+        return active_;
+    }
+
+    /// 0..100 of the hold at @p now
+    int percent(uint32_t now) const {
+        if (!active_) {
+            return 0;
+        }
+        const uint32_t held = now - since_;
+        return held >= kHoldMs ? 100 : static_cast<int>(held * 100 / kHoldMs);
+    }
+
+  private:
+    bool active_ = false;
+    uint32_t since_ = 0;
+    uint32_t last_pressed_ = 0;
+};
+
+/// The row's subjects and the hold.
+///
+/// Subjects: `kiln_rootpw_state` (RowState: 1 shows the row, 2 the greyed
+/// locked one), `kiln_rootpw_locked` (1 while locked: greys that row),
+/// `kiln_rootpw_phase` (0 idle, 1 holding, 2 waiting for the answer),
+/// `kiln_rootpw_hold_pct` (the hold's bar) and `kiln_rootpw_status` (the
+/// line under the row: "Keep holding...", "Resetting...").
+class ResetRow {
+  public:
+    enum class Phase { Idle = 0, Holding = 1, Waiting = 2 };
+
+    ResetRow() = default;
+    ~ResetRow();
+    ResetRow(const ResetRow&) = delete;
+    ResetRow& operator=(const ResetRow&) = delete;
+
+    /// The subjects; on Kiln OS also the state file now and every
+    /// kStateRefreshMs
+    void init_subjects();
+
+    /// Re-read the state file
+    void refresh();
+
+    /// The row's LV_EVENT_PRESSED (XML callback on_kiln_rootpw_pressed)
+    static void on_pressed(lv_event_t* e);
+
+    /// The press handler's work: starts the hold on @p row when @p active
+    /// is the physical panel, the row is unlocked, not greyed and nothing is
+    /// on its way. True when the hold started.
+    bool begin_hold(lv_obj_t* row, const lv_indev_t* active);
+
+    Phase phase() const {
+        return phase_;
+    }
+    RowState state() const {
+        return state_;
+    }
+
+    /// Tests: what the hold sees each kHoldTickMs (default: the panel is
+    /// pressed on the row, which is not greyed, and nothing scrolls)
+    void set_press_probe_for_test(std::function<bool()> probe) {
+        probe_ = std::move(probe);
+    }
+    /// Tests: the dialog the answer opens instead of the modal
+    void set_result_sink_for_test(std::function<void(const Answer&)> sink) {
+        sink_ = std::move(sink);
+    }
+    /// Tests: stop the hold and the timers, forget the state (the subjects
+    /// stay)
+    void reset_for_test();
+
+  private:
+    static void hold_timer_cb(lv_timer_t* t);
+    static void state_timer_cb(lv_timer_t* t);
+    static void rearm_timer_cb(lv_timer_t* t);
+    void tick();
+    void rearm_tick();
+    bool pressed_on_row() const;
+    bool panel_pressed() const;
+    void set_phase(Phase phase);
+    void stop_hold_timer();
+    void fire();
+    void answered(const Answer& answer);
+
+    SubjectManager subjects_;
+    helix::Subject state_subject_{};
+    helix::Subject locked_subject_{};
+    helix::Subject phase_subject_{};
+    helix::Subject hold_pct_subject_{};
+    helix::Subject status_subject_{};
+    char status_buf_[160] = "";
+    bool subjects_initialized_ = false;
+
+    RowState state_ = RowState::Hidden;
+    Phase phase_ = Phase::Idle;
+    ResetHold hold_;
+    uint64_t hold_stamp_ = 0; ///< boot_seconds() at the press
+    /// The hold fired and the panel has not been let go since (for longer
+    /// than kHoldGapMs): no new hold, so one press sends one request
+    bool spent_ = false;
+    uint32_t spent_last_pressed_ = 0;
+    lv_timer_t* rearm_timer_ = nullptr;
+    helix::ui::WidgetRef row_;
+    lv_timer_t* hold_timer_ = nullptr;
+    lv_timer_t* state_timer_ = nullptr;
+    std::function<bool()> probe_;
+    std::function<void(const Answer&)> sink_;
+};
+
+ResetRow& row();
+
+} // namespace helix::kiln_rootpw
