+TEST_CASE("Kiln root password: the row's three states from the state file", "[kiln][kiln_rootpw]") {
+    TempDir dir;
+    // No folder (no agent, or not Kiln OS) and no state file: no row
+    CHECK(rootpw::read_row_state(dir.str() + "/missing") == rootpw::RowState::Hidden);
+    CHECK(rootpw::read_row_state(dir.str()) == rootpw::RowState::Hidden);
+
+    write_file(dir.file(rootpw::kStateFile), "unlocked\n");
+    CHECK(rootpw::read_row_state(dir.str()) == rootpw::RowState::Unlocked);
+    write_file(dir.file(rootpw::kStateFile), "locked\n");
+    CHECK(rootpw::read_row_state(dir.str()) == rootpw::RowState::Locked);
+    // Anything else: greyed, the safe side
+    write_file(dir.file(rootpw::kStateFile), "maybe\n");
+    CHECK(rootpw::read_row_state(dir.str()) == rootpw::RowState::Locked);
+    write_file(dir.file(rootpw::kStateFile), "");
+    CHECK(rootpw::read_row_state(dir.str()) == rootpw::RowState::Locked);
+
+    // A link is not the agent's file
+    fs::remove(dir.file(rootpw::kStateFile));
+    write_file(dir.file("elsewhere"), "unlocked\n");
+    fs::create_symlink(dir.file("elsewhere"), dir.file(rootpw::kStateFile));
+    CHECK(rootpw::read_row_state(dir.str()) == rootpw::RowState::Hidden);
