+                        app_request_restart_service();
+                    },
+                    helix::kiln_rootpw::kFactoryResetRestartMs, nullptr);
+                lv_timer_set_repeat_count(restart, 1);
+            });
+        return;
+    }
+
     ToastManager::instance().show(ToastSeverity::INFO,
