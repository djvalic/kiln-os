+TEST_CASE("Kiln root password: the 5 s hold", "[kiln][kiln_rootpw]") {
+    rootpw::ResetHold h;
+    CHECK(h.feed(true, 100) == Step::Idle);
+
+    SECTION("held 5 s: fires once") {
+        h.start(1000);
+        for (uint32_t t = 1050; t < 6000; t += 50) {
+            REQUIRE(h.feed(true, t) == Step::Holding);
+        }
+        CHECK(h.percent(3500) == 50);
+        CHECK(h.feed(true, 6000) == Step::Fired);
+        CHECK_FALSE(h.active());
+        CHECK(h.feed(true, 6050) == Step::Idle);
+    }
+    SECTION("an early lift cancels") {
+        h.start(1000);
+        CHECK(h.feed(true, 2000) == Step::Holding);
+        CHECK(h.feed(false, 2100) == Step::Holding);
+        CHECK(h.feed(false, 2201) == Step::Cancelled);
+        CHECK_FALSE(h.active());
+        CHECK(h.feed(true, 6000) == Step::Idle);
+    }
+    SECTION("a 150 ms lift does not") {
+        h.start(1000);
+        CHECK(h.feed(true, 2000) == Step::Holding);
+        CHECK(h.feed(false, 2050) == Step::Holding);
+        CHECK(h.feed(false, 2150) == Step::Holding);
+        CHECK(h.feed(true, 2150) == Step::Holding);
+        CHECK(h.feed(true, 5999) == Step::Holding);
+        CHECK(h.feed(true, 6000) == Step::Fired);
+    }
+    SECTION("the gap is the hold to calibrate's, 200 ms") {
+        CHECK(rootpw::kHoldGapMs == helix::kCalibrationHoldGapMs);
+        CHECK(rootpw::kHoldGapMs == 200);
+        h.start(1000);
+        CHECK(h.feed(true, 2000) == Step::Holding);
+        CHECK(h.feed(false, 2200) == Step::Holding);
+        CHECK(h.feed(false, 2250) == Step::Cancelled);
+    }
+    SECTION("it fires on a pressed reading only") {
+        h.start(1000);
+        CHECK(h.feed(true, 5900) == Step::Holding);
+        CHECK(h.feed(false, 6000) == Step::Holding);
+        CHECK(h.feed(true, 6050) == Step::Fired);
+    }
+    SECTION("the tick may wrap") {
+        h.start(0xFFFFF000u);
+        CHECK(h.feed(true, 0xFFFFF000u + 4999u) == Step::Holding);
+        CHECK(h.feed(true, 0xFFFFF000u + 5000u) == Step::Fired);
+    }
+}
