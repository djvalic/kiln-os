+    // Kiln OS: when Reset was pressed, for root's password below
+    const uint64_t confirmed_at = helix::kiln_rootpw::take_confirm_stamp();
 
     // Get config instance and reset
     Config* config = Config::get_instance();
@@ -180,6 +197,31 @@ void SystemSettingsOverlay::perform_factory_reset() {
     config->save();
     spdlog::info("[{}] Config reset to defaults", get_name());
 
+    // Kiln OS: root's password back to "root" too, through Kiln's root agent
+    // (it applies this whatever the SSH lock says, and removes the lock), and
+    // its answer in the toast before the restart. The only place that sends
+    // "factory-reset".
+    if (helix::kiln_rootpw::available()) {
