+// ============================================================================
+// Saved Profile: update in place
+// ============================================================================
+//
+// nmcli before 1.56 replaces a reused profile's whole 802-11-wireless-security
+// setting with one holding only the psk, so `device wifi connect <ssid>
+// password <psk>` on a saved WPA profile is refused ("key-mgmt: property is
+// missing"). A saved profile is updated in place (full security settings,
+// autoconnect on) and activated instead.
+
+namespace {
+const char* kSavedUuid = "3d1d6b0e-5c1a-3f7e-9b2a-0c4d5e6f7a8b";
+
+std::string profile_show(const std::string& ssid, const std::string& key_mgmt,
+                         const std::string& psk, const std::string& autoconnect) {
+    std::string out = "802-11-wireless.ssid:" + ssid +
+                      "\n802-11-wireless.mode:infrastructure\n802-11-wireless.hidden:yes\n";
+    if (!key_mgmt.empty()) {
+        out += "802-11-wireless-security.key-mgmt:" + key_mgmt +
+               "\n802-11-wireless-security.psk:" + psk + "\n";
+    }
+    return out + "connection.autoconnect:" + autoconnect + "\n";
+}
+} // namespace
+
+TEST_CASE("NM backend: saved profile parsing", "[network][nm][saved_profile]") {
+    TestableNMBackend backend;
+
+    SECTION("only Wi-Fi profiles with plain UUIDs") {
+        auto uuids = backend.parse_wifi_profile_uuids(
+            "11111111-2222-3333-4444-555555555555:802-3-ethernet\n"
+            "3d1d6b0e-5c1a-3f7e-9b2a-0c4d5e6f7a8b:802-11-wireless\n"
+            "$(reboot)-2222-3333-4444-5555555555:802-11-wireless\n"
+            "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee:802-11-wireless\n");
+        CHECK(uuids == std::vector<std::string>{"3d1d6b0e-5c1a-3f7e-9b2a-0c4d5e6f7a8b",
+                                                "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"});
+    }
+
+    SECTION("fields, terse escapes undone") {
+        auto p = backend.parse_profile_fields(
+            "802-11-wireless.ssid:Cafe\\:Bar\n802-11-wireless.mode:infrastructure\n"
+            "802-11-wireless.hidden:yes\n802-11-wireless-security.key-mgmt:wpa-psk\n"
+            "802-11-wireless-security.psk:a\\:b\\\\c\nconnection.autoconnect:no\n");
+        CHECK(p.ssid == "Cafe:Bar");
+        CHECK(p.mode == "infrastructure");
+        CHECK(p.hidden == "yes");
+        CHECK(p.key_mgmt == "wpa-psk");
+        CHECK(p.psk == "a:b\\c");
+        CHECK(p.autoconnect == "no");
+        CHECK(p.uuid.empty());
+    }
+
+    SECTION("which profiles are updated in place") {
+        TestableNMBackend::SavedProfile p;
+        p.key_mgmt = "wpa-psk";
+        CHECK(TestableNMBackend::can_update_in_place(p, "secret12"));
+        CHECK_FALSE(TestableNMBackend::can_update_in_place(p, ""));
+        p.key_mgmt = "sae";
+        CHECK(TestableNMBackend::can_update_in_place(p, "secret12"));
+        p.key_mgmt = "";
+        CHECK_FALSE(TestableNMBackend::can_update_in_place(p, "secret12"));
+        CHECK(TestableNMBackend::can_update_in_place(p, ""));
+        p.key_mgmt = "wpa-eap";
+        CHECK_FALSE(TestableNMBackend::can_update_in_place(p, "secret12"));
+        p.key_mgmt = "none"; // WEP
+        CHECK_FALSE(TestableNMBackend::can_update_in_place(p, "secret12"));
+    }
+
+    SECTION("update and restore argv") {
+        TestableNMBackend::SavedProfile p;
+        p.uuid = kSavedUuid;
+        p.key_mgmt = "wpa-psk";
+        p.psk = "oldpass1";
+        p.autoconnect = "no";
+        p.hidden = "no";
+        CHECK(TestableNMBackend::update_profile_argv(p, "newpass2", false) ==
+              std::vector<std::string>{"connection", "modify", "uuid", kSavedUuid,
+                                       "connection.autoconnect", "yes",
+                                       "802-11-wireless-security.key-mgmt", "wpa-psk",
+                                       "802-11-wireless-security.psk-flags", "0",
+                                       "802-11-wireless-security.psk", "newpass2"});
+        CHECK(TestableNMBackend::update_profile_argv(p, "", true) ==
+              std::vector<std::string>{"connection", "modify", "uuid", kSavedUuid,
+                                       "connection.autoconnect", "yes",
+                                       "802-11-wireless.hidden", "yes"});
+        CHECK(TestableNMBackend::restore_profile_argv(p, "newpass2", true) ==
+              std::vector<std::string>{"connection", "modify", "uuid", kSavedUuid,
+                                       "connection.autoconnect", "no", "802-11-wireless.hidden",
+                                       "no", "802-11-wireless-security.psk", "oldpass1"});
+        CHECK(TestableNMBackend::activate_profile_argv(kSavedUuid, "wlan0") ==
+              std::vector<std::string>{"connection", "up", "uuid", kSavedUuid, "ifname", "wlan0"});
+    }
+}
