+TEST_CASE("NM backend: joining a saved network updates its profile in place",
+          "[network][nm][saved_profile][slow]") {
+    FakeNmcliDir fake;
+    ScopedPathPrepend path_prepend(fake.dir);
+
+    // Declared before the backend so they outlive the connect thread's
+    // callbacks (see the hidden connect test).
+    std::atomic<bool> connected{false};
+    std::atomic<bool> auth_failed{false};
+    TestableNMBackend backend;
+    backend.force_running("wlan0");
+    backend.register_event_callback("CONNECTED", [&](const std::string&) { connected = true; });
+    backend.register_event_callback("AUTH_FAILED",
+                                    [&](const std::string&) { auth_failed = true; });
+
+    const std::vector<std::string> modify{"connection",
+                                          "modify",
+                                          "uuid",
+                                          kSavedUuid,
+                                          "connection.autoconnect",
+                                          "yes",
+                                          "802-11-wireless-security.key-mgmt",
+                                          "wpa-psk",
+                                          "802-11-wireless-security.psk-flags",
+                                          "0",
+                                          "802-11-wireless-security.psk",
+                                          "newpass2"};
+    const std::vector<std::string> up{"connection", "up", "uuid", kSavedUuid, "ifname", "wlan0"};
+
+    // Another network's profile first: only the SSID's own is touched
+    fake.add_profile("aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee", "802-11-wireless",
+                     profile_show("Neighbour", "wpa-psk", "theirs12", "yes"));
+
+    SECTION("a profile saved with autoconnect off (stock's network, as Kiln imports it)") {
+        fake.add_profile(kSavedUuid, "802-11-wireless",
+                         profile_show("HomeNet", "wpa-psk", "oldpass1", "no"));
+
+        REQUIRE(backend.connect_network("HomeNet", "newpass2", false).success());
+        REQUIRE(helix_test::wait_until([&connected] { return connected.load(); }, 8000));
+
+        // modify, then up: no device wifi connect, no delete-and-retry
+        CHECK(fake.history() == std::vector<std::vector<std::string>>{modify, up});
+    }
+
+    SECTION("a failed join puts the profile back") {
+        fake.add_profile(kSavedUuid, "802-11-wireless",
+                         profile_show("HomeNet", "wpa-psk", "oldpass1", "no"));
+        fake.fail_up("Error: Connection activation failed: Secrets were required, but not "
+                     "provided.");
+
+        REQUIRE(backend.connect_network("HomeNet", "newpass2", false).success());
+        REQUIRE(helix_test::wait_until([&auth_failed] { return auth_failed.load(); }, 8000));
+
+        auto calls = fake.history();
+        REQUIRE(calls.size() == 3);
+        CHECK(calls[0] == modify);
+        CHECK(calls[1] == up);
+        CHECK(calls[2] == std::vector<std::string>{"connection", "modify", "uuid", kSavedUuid,
+                                                   "connection.autoconnect", "no",
+                                                   "802-11-wireless-security.psk", "oldpass1"});
+        CHECK_FALSE(connected.load());
+    }
+
+    SECTION("a profile without key-mgmt takes device wifi connect and its self-heal") {
+        fake.add_profile(kSavedUuid, "802-11-wireless", profile_show("HomeNet", "", "", "yes"));
+        fake.fail_first();
+
+        REQUIRE(backend.connect_network("HomeNet", "newpass2", false).success());
+        REQUIRE(helix_test::wait_until([&connected] { return connected.load(); }, 8000));
+
+        auto calls = fake.history();
+        REQUIRE(calls.size() == 3);
+        CHECK(calls[0] == std::vector<std::string>{"device", "wifi", "connect", "HomeNet",
+                                                   "password", "newpass2", "ifname", "wlan0"});
+        CHECK(calls[1] == std::vector<std::string>{"connection", "delete", "id", "HomeNet"});
+        CHECK(calls[2] == calls[0]);
+    }
+
+    SECTION("no saved profile: device wifi connect as before") {
+        REQUIRE(backend.connect_network("HomeNet", "newpass2", false).success());
+        REQUIRE(helix_test::wait_until([&connected] { return connected.load(); }, 8000));
+
+        CHECK(fake.history() ==
+              std::vector<std::vector<std::string>>{{"device", "wifi", "connect", "HomeNet",
+                                                     "password", "newpass2", "ifname", "wlan0"}});
+    }
+}
