From e3e7a9de587e46b102aa9f1f8f8518e5d821d9d9 Mon Sep 17 00:00:00 2001
From: djvalic <djvalic@users.noreply.github.com>
Date: Thu, 19 Nov 2026 03:02:43 -0500
Subject: [PATCH] wifi: NM joins a saved network by updating its profile in
 place

Joining a network that already has a saved NetworkManager profile went
through `nmcli device wifi connect <ssid> password <psk>`. nmcli reuses
the saved profile for that, but before NetworkManager 1.56 its
do_device_wifi_connect() (src/nmcli/devices.c) replaces the profile's
whole 802-11-wireless-security setting with a new one that holds only
the psk:

    if (!s_wsec) {          /* s_wsec is always NULL here */
        s_wsec = nm_setting_wireless_security_new();
        nm_connection_add_setting(connection, s_wsec);
    }

The profile is then saved with Update2, which doesn't complete missing
properties as AddAndActivate does, so NetworkManager refuses it:
"802-11-wireless-security.key-mgmt: property is missing". That happens
for every saved WPA profile, well-formed or not, so the self-heal took
the delete-and-retry path on each such join: the good profile was
deleted (its other settings, its UUID and so its DHCP lease with it) and
a new one made, about 12 s later. NetworkManager 1.56 fixed nmcli
(nm_connection_get_setting_wireless_security() first); 1.52 is in
Buildroot 2026.02.

A join now looks for a saved client profile with the same SSID first
(`nmcli -t -f UUID,TYPE connection show`, then each Wi-Fi profile's SSID,
mode, hidden, key-mgmt, psk and autoconnect; only nmcli's own UUIDs, hex
and dashes, go into these command lines). A WPA/WPA3 personal profile
with a password, or an open profile without one, is updated in place and
activated, both by fork/exec:

    nmcli connection modify uuid <U> connection.autoconnect yes
        [802-11-wireless.hidden yes]
        802-11-wireless-security.key-mgmt <its key-mgmt>
        802-11-wireless-security.psk-flags 0
        802-11-wireless-security.psk <psk>
    nmcli connection up uuid <U> ifname <iface>

so the whole security setting goes in, the psk is stored in the profile,
and autoconnect is on: a network joined by hand is joined again at the
next start (a profile saved with autoconnect off, as Kiln imports a
network stock saved disabled, stayed off before). A failed join puts
back the profile's autoconnect, hidden flag and stored psk, as nmcli
leaves no profile behind for a new network that fails. Anything else (no
profile, a profile without key-mgmt, WEP, enterprise, a modify that
fails) takes `device wifi connect` and its stale-profile self-heal as
before.

Tests: the fake nmcli answers the profile lookups from files (not
counted, so the existing connect cases are unchanged) and keeps every
acting call's argv; new cases for the parsing (Wi-Fi profiles only, odd
UUIDs dropped, terse escapes), which profiles are updated in place, the
update/restore/up argv, a join of a profile saved with autoconnect off
(modify then up, no connect or delete), a failed join (profile put
back, AUTH_FAILED), a profile without key-mgmt (connect, delete, retry)
and no profile (connect as before).
---
 include/wifi_backend_networkmanager.h         |  50 ++++
 src/api/wifi_backend_networkmanager.cpp       | 189 +++++++++++++-
 .../unit/test_wifi_backend_networkmanager.cpp | 239 +++++++++++++++++-
 3 files changed, 472 insertions(+), 6 deletions(-)

diff --git a/include/wifi_backend_networkmanager.h b/include/wifi_backend_networkmanager.h
index c310057..b94d862 100644
--- a/include/wifi_backend_networkmanager.h
+++ b/include/wifi_backend_networkmanager.h
@@ -250,6 +250,56 @@ class WifiBackendNetworkManager : public WifiBackend {
     ConnectAttempt try_nmcli_connect(const std::string& ssid, const std::string& password,
                                      bool is_hidden);
 
+    // Single fork/exec of `nmcli <args>` (no shell), stderr captured, 30 s limit.
+    // Honours connect_active_ for cancellation.
+    ConnectAttempt run_nmcli(const std::vector<std::string>& args);
+
+    /// A saved NetworkManager Wi-Fi profile, as found by find_saved_profile().
+    struct SavedProfile {
+        std::string uuid;
+        std::string ssid;
+        std::string mode;        ///< 802-11-wireless.mode ("" or "infrastructure" for a client)
+        std::string key_mgmt;    ///< 802-11-wireless-security.key-mgmt ("" = open)
+        std::string psk;         ///< Stored psk (empty when not stored in the profile)
+        std::string autoconnect; ///< connection.autoconnect as nmcli prints it ("yes"/"no")
+        std::string hidden;      ///< 802-11-wireless.hidden as nmcli prints it ("yes"/"no")
+    };
+
+    /// UUIDs of the 802-11-wireless profiles in `nmcli -t -f UUID,TYPE connection show`
+    /// output, in nmcli's order. A UUID that is not 36 hex digits and dashes is
+    /// dropped: it goes into a popen() command line.
+    std::vector<std::string> parse_wifi_profile_uuids(const std::string& output);
+
+    /// The fields of one profile from `nmcli -s -t -f <fields> connection show uuid <U>`
+    /// ("setting.property:value" lines, terse escapes undone). uuid is left empty.
+    SavedProfile parse_profile_fields(const std::string& output);
+
+    /// The saved client profile whose SSID is `ssid`, if there is one.
+    std::optional<SavedProfile> find_saved_profile(const std::string& ssid);
+
+    /// Whether a join with `password` can update `profile` in place: a WPA/WPA3
+    /// personal profile when a password is given, an open profile when none is.
+    /// Anything else (no key-mgmt, WEP, enterprise) takes `device wifi connect`
+    /// and its stale-profile self-heal.
+    static bool can_update_in_place(const SavedProfile& profile, const std::string& password);
+
+    /// `nmcli connection modify` argv that updates a saved profile in place for a
+    /// join: autoconnect on, and with a password the full security settings
+    /// (key-mgmt kept, psk stored in the profile). Program name excluded.
+    static std::vector<std::string> update_profile_argv(const SavedProfile& profile,
+                                                        const std::string& password,
+                                                        bool is_hidden);
+
+    /// `nmcli connection modify` argv that puts back what update_profile_argv()
+    /// changed, after a join that failed. Program name excluded.
+    static std::vector<std::string> restore_profile_argv(const SavedProfile& profile,
+                                                         const std::string& password,
+                                                         bool is_hidden);
+
+    /// `nmcli connection up uuid <uuid> ifname <iface>` argv, program name excluded.
+    static std::vector<std::string> activate_profile_argv(const std::string& uuid,
+                                                          const std::string& iface);
+
     // Delete a saved connection profile by id. Best-effort, fork/exec to avoid
     // shell injection with caller-supplied SSIDs. Returns true if nmcli exited 0.
     bool delete_connection_profile(const std::string& profile_id);
diff --git a/src/api/wifi_backend_networkmanager.cpp b/src/api/wifi_backend_networkmanager.cpp
index dd894b9..4ee7e61 100644
--- a/src/api/wifi_backend_networkmanager.cpp
+++ b/src/api/wifi_backend_networkmanager.cpp
@@ -22,6 +22,7 @@
 
 #include <algorithm>
 #include <array>
+#include <cctype>
 #include <cerrno>
 #include <chrono>
 #include <cstdio>
@@ -693,6 +694,135 @@ std::vector<std::string> WifiBackendNetworkManager::connect_argv(const std::stri
 WifiBackendNetworkManager::ConnectAttempt
 WifiBackendNetworkManager::try_nmcli_connect(const std::string& ssid, const std::string& password,
                                              bool is_hidden) {
+    return run_nmcli(connect_argv(ssid, password, is_hidden, wifi_interface_));
+}
+
+std::vector<std::string>
+WifiBackendNetworkManager::parse_wifi_profile_uuids(const std::string& output) {
+    std::vector<std::string> uuids;
+    std::istringstream stream(output);
+    std::string line;
+    while (std::getline(stream, line)) {
+        auto fields = split_nmcli_fields(line);
+        if (fields.size() != 2 || fields[1] != "802-11-wireless") {
+            continue;
+        }
+        const std::string& uuid = fields[0];
+        bool plain = uuid.size() == 36;
+        for (char c : uuid) {
+            plain = plain && (std::isxdigit(static_cast<unsigned char>(c)) || c == '-');
+        }
+        if (plain) {
+            uuids.push_back(uuid);
+        }
+    }
+    return uuids;
+}
+
+WifiBackendNetworkManager::SavedProfile
+WifiBackendNetworkManager::parse_profile_fields(const std::string& output) {
+    SavedProfile profile;
+    std::istringstream stream(output);
+    std::string line;
+    while (std::getline(stream, line)) {
+        // "setting.property:value": property names hold no colon, the value's
+        // own colons and backslashes are escaped in terse mode
+        auto colon = line.find(':');
+        if (colon == std::string::npos) {
+            continue;
+        }
+        const std::string name = line.substr(0, colon);
+        auto parts = split_nmcli_fields(line.substr(colon + 1));
+        std::string value;
+        for (size_t i = 0; i < parts.size(); ++i) {
+            value += (i ? ":" : "") + parts[i];
+        }
+        if (name == "802-11-wireless.ssid") {
+            profile.ssid = value;
+        } else if (name == "802-11-wireless.mode") {
+            profile.mode = value;
+        } else if (name == "802-11-wireless.hidden") {
+            profile.hidden = value;
+        } else if (name == "802-11-wireless-security.key-mgmt") {
+            profile.key_mgmt = value;
+        } else if (name == "802-11-wireless-security.psk") {
+            profile.psk = value;
+        } else if (name == "connection.autoconnect") {
+            profile.autoconnect = value;
+        }
+    }
+    return profile;
+}
+
+std::optional<WifiBackendNetworkManager::SavedProfile>
+WifiBackendNetworkManager::find_saved_profile(const std::string& ssid) {
+    // Only nmcli's own output (UUIDs checked to be hex and dashes) goes into
+    // these command lines, never the SSID.
+    for (const std::string& uuid :
+         parse_wifi_profile_uuids(exec_nmcli("-t -f UUID,TYPE connection show"))) {
+        SavedProfile profile = parse_profile_fields(
+            exec_nmcli("-s -t -f 802-11-wireless.ssid,802-11-wireless.mode,"
+                       "802-11-wireless.hidden,802-11-wireless-security.key-mgmt,"
+                       "802-11-wireless-security.psk,connection.autoconnect "
+                       "connection show uuid " +
+                       uuid));
+        if (profile.ssid != ssid ||
+            (!profile.mode.empty() && profile.mode != "infrastructure")) {
+            continue;
+        }
+        profile.uuid = uuid;
+        return profile;
+    }
+    return std::nullopt;
+}
+
+bool WifiBackendNetworkManager::can_update_in_place(const SavedProfile& profile,
+                                                    const std::string& password) {
+    if (password.empty()) {
+        return profile.key_mgmt.empty();
+    }
+    return profile.key_mgmt == "wpa-psk" || profile.key_mgmt == "sae";
+}
+
+std::vector<std::string> WifiBackendNetworkManager::update_profile_argv(
+    const SavedProfile& profile, const std::string& password, bool is_hidden) {
+    std::vector<std::string> argv = {"connection", "modify",      "uuid",
+                                     profile.uuid, "connection.autoconnect", "yes"};
+    if (is_hidden) {
+        argv.insert(argv.end(), {"802-11-wireless.hidden", "yes"});
+    }
+    if (!password.empty()) {
+        // The whole security setting, not just the psk: key-mgmt is what an
+        // update without it is refused for.
+        argv.insert(argv.end(), {"802-11-wireless-security.key-mgmt", profile.key_mgmt,
+                                 "802-11-wireless-security.psk-flags", "0",
+                                 "802-11-wireless-security.psk", password});
+    }
+    return argv;
+}
+
+std::vector<std::string> WifiBackendNetworkManager::restore_profile_argv(
+    const SavedProfile& profile, const std::string& password, bool is_hidden) {
+    std::vector<std::string> argv = {"connection", "modify", "uuid", profile.uuid,
+                                     "connection.autoconnect",
+                                     profile.autoconnect == "no" ? "no" : "yes"};
+    if (is_hidden) {
+        argv.insert(argv.end(),
+                    {"802-11-wireless.hidden", profile.hidden == "yes" ? "yes" : "no"});
+    }
+    if (!password.empty() && !profile.psk.empty()) {
+        argv.insert(argv.end(), {"802-11-wireless-security.psk", profile.psk});
+    }
+    return argv;
+}
+
+std::vector<std::string> WifiBackendNetworkManager::activate_profile_argv(const std::string& uuid,
+                                                                          const std::string& iface) {
+    return {"connection", "up", "uuid", uuid, "ifname", iface};
+}
+
+WifiBackendNetworkManager::ConnectAttempt
+WifiBackendNetworkManager::run_nmcli(const std::vector<std::string>& args) {
     ConnectAttempt result;
 
     // SECURITY: fork/exec (no shell) so SSID/password can't be interpreted by sh.
@@ -701,7 +831,6 @@ WifiBackendNetworkManager::try_nmcli_connect(const std::string& ssid, const std:
 
     // Built before fork(): the child of a multithreaded process must not
     // allocate between fork and exec, so it inherits ready-to-use pointers.
-    std::vector<std::string> args = connect_argv(ssid, password, is_hidden, wifi_interface_);
     std::vector<char*> exec_args;
     exec_args.reserve(args.size() + 2);
     exec_args.push_back(const_cast<char*>("nmcli"));
@@ -803,7 +932,58 @@ void WifiBackendNetworkManager::connect_thread_func(std::string ssid, std::strin
                                                     bool is_hidden) {
     spdlog::debug("[WifiBackend] NM: Connect thread started for '{}'", helix::redact::ssid(ssid));
 
-    ConnectAttempt attempt = try_nmcli_connect(ssid, password, is_hidden);
+    ConnectAttempt attempt;
+    bool joined_in_place = false;
+
+    // A network that already has a saved profile is joined by updating that
+    // profile in place and activating it. `device wifi connect <ssid> password
+    // <psk>` reuses the saved profile too, but nmcli before 1.56 replaces its
+    // whole 802-11-wireless-security setting with a new one holding only the
+    // psk (do_device_wifi_connect, src/nmcli/devices.c), so NetworkManager
+    // refuses the update ("key-mgmt: property is missing") for every saved
+    // WPA profile, and the self-heal below deleted a good profile to make a new
+    // one. In place, the profile keeps its UUID (and so its DHCP lease), its
+    // other settings and its file, and autoconnect is turned on: a network
+    // joined by hand is joined again at the next start.
+    std::optional<SavedProfile> profile = find_saved_profile(ssid);
+    if (profile && can_update_in_place(*profile, password)) {
+        ConnectAttempt update = run_nmcli(update_profile_argv(*profile, password, is_hidden));
+        if (!connect_active_) {
+            return;
+        }
+        if (update.exit_code == 0) {
+            spdlog::info("[WifiBackend] NM: Updated the saved profile for '{}' in place",
+                         helix::redact::ssid(ssid));
+            attempt = run_nmcli(activate_profile_argv(profile->uuid, wifi_interface_));
+            if (!connect_active_) {
+                return;
+            }
+            joined_in_place = true;
+            if (attempt.exit_code != 0) {
+                // A failed join leaves the saved profile as it was, as nmcli
+                // leaves none behind for a new network that fails
+                ConnectAttempt restore =
+                    run_nmcli(restore_profile_argv(*profile, password, is_hidden));
+                if (restore.exit_code != 0) {
+                    spdlog::warn("[WifiBackend] NM: Could not restore the saved profile for "
+                                 "'{}' after the failed join (exit code {})",
+                                 helix::redact::ssid(ssid), restore.exit_code);
+                }
+            }
+        } else {
+            spdlog::warn("[WifiBackend] NM: Could not update the saved profile for '{}' "
+                         "(exit code {}); trying device wifi connect",
+                         helix::redact::ssid(ssid), update.exit_code);
+        }
+    } else if (profile) {
+        spdlog::debug("[WifiBackend] NM: Saved profile for '{}' (key-mgmt '{}') not updated "
+                      "in place; trying device wifi connect",
+                      helix::redact::ssid(ssid), profile->key_mgmt);
+    }
+
+    if (!joined_in_place) {
+        attempt = try_nmcli_connect(ssid, password, is_hidden);
+    }
 
     if (!connect_active_) {
         return;
@@ -814,13 +994,14 @@ void WifiBackendNetworkManager::connect_thread_func(std::string ssid, std::strin
     // (e.g. created earlier without security), the password write lands but
     // key-mgmt stays empty and NM refuses with:
     //   Error: 802-11-wireless-security.key-mgmt: property is missing.
-    // Self-heal once: delete the stale profile and retry.
+    // Self-heal once: delete the stale profile and retry. (A saved WPA profile
+    // was updated in place above; this is left for a really broken one.)
     auto looks_like_stale_profile = [](const std::string& err) {
         return err.find("key-mgmt") != std::string::npos &&
                err.find("property is missing") != std::string::npos;
     };
 
-    if (attempt.exit_code != 0 && !attempt.timed_out &&
+    if (!joined_in_place && attempt.exit_code != 0 && !attempt.timed_out &&
         looks_like_stale_profile(attempt.stderr_out)) {
         spdlog::warn("[WifiBackend] NM: '{}' has a stale/malformed saved profile "
                      "(key-mgmt missing); deleting and retrying",
diff --git a/tests/unit/test_wifi_backend_networkmanager.cpp b/tests/unit/test_wifi_backend_networkmanager.cpp
