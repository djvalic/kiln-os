+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * @file ui_settings_ad5x_log.h
+ * @brief Kiln OS log detail: Klipper's LOG_MODE on Settings > System
+ *
+ * Klipper's `ad5x_log` object (klipper/extras/ad5x_log.py): `mode` ("short"
+ * or "extended") and `until` (Unix time, or null). LOG_MODE MODE=short|extended
+ * sets it, saved by Klipper. Short: Klipper's statistics once a minute, this
+ * screen's log at warnings and errors. Extended: everything, this screen's
+ * log at debug.
+ *
+ * Ad5xLogModel follows the object from the first discovery on (a tail
+ * discovery step attaches it), so this screen's own log level follows a
+ * change made anywhere (the console, the end of LOG_MODE's HOURS) at once.
+ * S70helixscreen sets the level at start from the same mode.
+ *
+ * @pattern Process-wide model, as Ad5xRefillModel
+ * @threading Main thread only; Moonraker callbacks hop over via lifetime tokens
+ */
+
+#pragma once
+
+#include "ui_observer_guard.h"
+#include "ui_subscription_guard.h"
+
+#include "async_lifetime_guard.h"
+#include "json_fwd.h"
+#include "lvgl/lvgl.h"
+#include "subject_managed_panel.h"
+
+#include <string>
+
+namespace helix {
+class IMoonrakerAPI;
+}
+
+namespace helix::ad5x_log {
+
+/// "short" (index 0) / "extended" (1); out of range: "short".
+const char* mode_name(int index);
+
+/// 1 for Klipper's "extended", 0 for anything else.
+int mode_index(const std::string& name);
+
+/// "LOG_MODE MODE=extended"
+std::string mode_gcode(int index);
+
+/// The object, the shared subjects and the command.
+///
+/// Subjects: `ad5x_log_available` (1 when Klipper has `ad5x_log`: shows the
+/// row and hides HelixScreen's own Log Level row), `ad5x_log_mode` (0 short,
+/// 1 extended) and `ad5x_log_busy` (1 while a change is pending, the object
+/// has not answered or Klipper is not ready).
+class Ad5xLogModel {
+  public:
+    Ad5xLogModel() = default;
+    ~Ad5xLogModel();
+    Ad5xLogModel(const Ad5xLogModel&) = delete;
+    Ad5xLogModel& operator=(const Ad5xLogModel&) = delete;
+
+    void init_subjects();
+
+    /// From each discovery: follow @p api's status updates (again when the
+    /// API changed) and take `ad5x_log` from the discovery's initial
+    /// @p status. Nothing on a printer without it.
+    void attach(IMoonrakerAPI* api, const json& status);
+
+    /// Ask Klipper for the object.
+    void query();
+
+    /// LOG_MODE MODE=short|extended
+    void set_mode(int index);
+
+  private:
+    void detach();
+    void merge(const json& delta);
+    void send(const std::string& gcode);
+    void refresh();
+    /// This screen's log level for Klipper's mode, when it changed.
+    void apply_log_level(int mode);
+
+    SubjectManager subjects_;
+    lv_subject_t available_{};
+    lv_subject_t mode_{};
+    lv_subject_t busy_{};
+    bool subjects_initialized_ = false;
+
+    IMoonrakerAPI* api_ = nullptr;
+    json obj_ = json::object(); ///< `ad5x_log`'s fields
+    bool loaded_ = false;
+    bool klippy_ready_ = true;
+    int pending_ = 0;
+    int applied_mode_ = -1; ///< The mode the log level was last set for
+
+    SubscriptionGuard subscription_;
+    ObserverGuard klippy_observer_;
+    AsyncLifetimeGuard lifetime_;
+};
+
+Ad5xLogModel& model();
+
+} // namespace helix::ad5x_log
