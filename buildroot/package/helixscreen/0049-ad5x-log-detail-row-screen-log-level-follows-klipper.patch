diff --git a/src/ui/ui_settings_ad5x_log.cpp b/src/ui/ui_settings_ad5x_log.cpp
new file mode 100644
index 0000000000..4e3052a012
--- /dev/null
+++ b/src/ui/ui_settings_ad5x_log.cpp
@@ -0,0 +1,266 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "ui_settings_ad5x_log.h"
+
+#include "ui_error_reporting.h"
+#include "ui_update_queue.h"
+
+#include "app_globals.h"
+#include "i_moonraker_api.h"
+#include "i_moonraker_client.h"
+#include "json_utils.h"
+#include "logging_init.h"
+#include "lvgl/src/others/translation/lv_translation.h"
+#include "observer_factory.h"
+#include "printer_discovery.h"
+#include "printer_state.h"
+#include "static_panel_registry.h"
+
+#include <spdlog/fmt/fmt.h>
+#include <spdlog/spdlog.h>
+
+#include <algorithm>
+#include <iterator>
+
+namespace helix::ad5x_log {
+
+namespace {
+
+constexpr const char* kObject = "ad5x_log";
+constexpr const char* kModes[] = {"short", "extended"};
+
+void set_if_changed(lv_subject_t* subject, int value) {
+    if (lv_subject_get_int(subject) != value) {
+        lv_subject_set_int(subject, value);
+    }
+}
+
+} // namespace
+
+const char* mode_name(int index) {
+    if (index < 0 || index >= static_cast<int>(std::size(kModes))) {
+        return kModes[0];
+    }
+    return kModes[index];
+}
+
+int mode_index(const std::string& name) {
+    return name == kModes[1] ? 1 : 0;
+}
+
+std::string mode_gcode(int index) {
+    return fmt::format("LOG_MODE MODE={}", mode_name(index));
+}
+
+// ============================================================================
+// MODEL
+// ============================================================================
+
+Ad5xLogModel::~Ad5xLogModel() {
+    lifetime_.invalidate();
+    subscription_.reset();
+    klippy_observer_.reset();
+    subjects_.deinit_all();
+}
+
+void Ad5xLogModel::init_subjects() {
+    if (subjects_initialized_) {
+        return;
+    }
+    // 1 when Klipper has ad5x_log: the Log detail row shows, Log Level hides
+    UI_MANAGED_SUBJECT_INT(available_, 0, "ad5x_log_available", subjects_);
+    // 0 short, 1 extended
+    UI_MANAGED_SUBJECT_INT(mode_, 0, "ad5x_log_mode", subjects_);
+    // 1 while a change is pending, the object has not answered or Klipper is not ready
+    UI_MANAGED_SUBJECT_INT(busy_, 1, "ad5x_log_busy", subjects_);
+    subjects_initialized_ = true;
+}
+
+void Ad5xLogModel::attach(IMoonrakerAPI* api, const json& status) {
+    init_subjects();
+    if (!api) {
+        return;
+    }
+    const auto& objects = api->hardware().printer_objects();
+    if (std::find(objects.begin(), objects.end(), kObject) == objects.end()) {
+        // Another printer, or a Klipper without Kiln's log mode: the level S70
+        // set stays
+        detach();
+        return;
+    }
+
+    if (api != api_) {
+        detach();
+        api_ = api;
+        const auto token = lifetime_.token();
+        // Runs on the WebSocket thread: copy the object out, apply it on the main thread
+        const SubscriptionId id = api->subscribe_notifications([this, token](const json& note) {
+            const json* params = json_util::find_member(note, "params");
+            if (!params || !params->is_array() || params->empty()) {
+                return;
+            }
+            const json* obj = json_util::find_member((*params)[0], kObject);
+            if (!obj || !obj->is_object() || obj->empty()) {
+                return;
+            }
+            json delta = *obj;
+            token.defer("Ad5xLogModel::status_update", [this, delta]() { merge(delta); });
+        });
+        subscription_ = SubscriptionGuard(api, id);
+    }
+
+    if (!klippy_observer_) {
+        klippy_observer_ = ui::observe<int>(
+            get_printer_state().network_state().get_klippy_state_subject(), this,
+            [](Ad5xLogModel* self, int state) {
+                const bool ready = static_cast<KlippyState>(state) == KlippyState::READY;
+                if (ready == self->klippy_ready_) {
+                    return;
+                }
+                self->klippy_ready_ = ready;
+                if (ready) {
+                    self->query();
+                }
+                self->refresh();
+            },
+            get_printer_state().get_subjects_lifetime());
+    }
+
+    // The discovery's initial status carries the object whole
+    if (const json* obj = json_util::find_member(status, kObject); obj && obj->is_object()) {
+        merge(*obj);
+    } else {
+        query();
+    }
+}
+
+void Ad5xLogModel::detach() {
+    subscription_.reset();
+    api_ = nullptr;
+    obj_ = json::object();
+    loaded_ = false;
+    pending_ = 0;
+    refresh();
+}
+
+void Ad5xLogModel::query() {
+    IMoonrakerClient* client = get_moonraker_client();
+    if (!client || client->get_connection_state() != ConnectionState::CONNECTED || !api_) {
+        return;
+    }
+    const auto token = lifetime_.token();
+    json params = {{"objects", {{kObject, nullptr}}}};
+    client->send_jsonrpc(
+        "printer.objects.query", params,
+        [this, token](const json& response) {
+            const json* result = json_util::find_member(response, "result");
+            const json* status = result ? json_util::find_member(*result, "status") : nullptr;
+            const json* obj = status ? json_util::find_member(*status, kObject) : nullptr;
+            if (!obj || !obj->is_object()) {
+                return;
+            }
+            json delta = *obj;
+            token.defer("Ad5xLogModel::status_query", [this, delta]() { merge(delta); });
+        },
+        [](const MoonrakerError& err) {
+            spdlog::debug("[AD5X log] {} query failed: {}", kObject, err.message);
+        },
+        0, /*silent=*/true);
+}
+
+void Ad5xLogModel::merge(const json& delta) {
+    if (!api_) {
+        return;
+    }
+    for (auto it = delta.begin(); it != delta.end(); ++it) {
+        obj_[it.key()] = it.value();
+    }
+    loaded_ = obj_.contains("mode");
+    refresh();
+}
+
+void Ad5xLogModel::send(const std::string& gcode) {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api) {
+        NOTIFY_WARNING("{}", lv_tr("Not connected to the printer"));
+        refresh();
+        return;
+    }
+    spdlog::info("[AD5X log] {}", gcode);
+    ++pending_;
+    refresh();
+
+    // Klipper's answer releases the row; a fresh query then shows what it kept
+    const auto token = lifetime_.token();
+    api->execute_gcode(
+        gcode,
+        [this, token]() {
+            token.defer("Ad5xLogModel::send_done", [this]() {
+                pending_ = std::max(0, pending_ - 1);
+                query();
+                refresh();
+            });
+        },
+        [this, token](const MoonrakerError& err) {
+            const std::string message = err.message;
+            token.defer("Ad5xLogModel::send_error", [this, message]() {
+                pending_ = std::max(0, pending_ - 1);
+                NOTIFY_WARNING("{}", message.empty() ? std::string(lv_tr("Failed")) : message);
+                query();
+                refresh();
+            });
+        },
+        0, /*silent=*/false, /*on_queued=*/nullptr, /*caller_surfaces_errors=*/true);
+}
+
+void Ad5xLogModel::set_mode(int index) {
+    index = std::clamp(index, 0, static_cast<int>(std::size(kModes)) - 1);
+    if (subjects_initialized_) {
+        lv_subject_set_int(&mode_, index);
+    }
+    send(mode_gcode(index));
+}
+
+void Ad5xLogModel::apply_log_level(int mode) {
+#ifndef HELIX_WATCHDOG
+    if (mode == applied_mode_) {
+        return;
+    }
+    applied_mode_ = mode;
+    // Said at info where it shows: after raising the level, before lowering it
+    const auto say = [mode]() {
+        spdlog::info("[AD5X log] Klipper log mode {}: this screen's log at {}", mode_name(mode),
+                     mode == 1 ? "debug" : "warn");
+    };
+    if (mode == 1) {
+        helix::logging::set_runtime_level(spdlog::level::debug);
+        say();
+    } else {
+        say();
+        helix::logging::set_runtime_level(spdlog::level::warn);
+    }
+#else
+    (void)mode;
+#endif
+}
+
+void Ad5xLogModel::refresh() {
+    const int mode = mode_index(json_util::safe_string(obj_, "mode", "short"));
+    if (subjects_initialized_) {
+        set_if_changed(&available_, loaded_ ? 1 : 0);
+        // While Klipper has not answered a change, the row keeps what the user set
+        if (loaded_ && pending_ == 0) {
+            set_if_changed(&mode_, mode);
+        }
+        set_if_changed(&busy_, (pending_ > 0 || !loaded_ || !klippy_ready_) ? 1 : 0);
+    }
+    if (loaded_) {
+        apply_log_level(mode);
+    }
+}
+
+Ad5xLogModel& model() {
+    return helix::lazy_global<Ad5xLogModel>("Ad5xLogModel");
+}
+
+} // namespace helix::ad5x_log
