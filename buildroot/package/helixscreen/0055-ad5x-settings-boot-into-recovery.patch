new file mode 100644
index 0000000000..8916df45f9
--- /dev/null
+++ b/src/ui/ui_settings_kiln_recovery.cpp
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "ui_settings_kiln_recovery.h"
+
+#include "ui_error_reporting.h"
+#include "ui_modal.h"
+#include "ui_toast_manager.h"
+#include "ui_update_queue.h"
+
+#include "app_globals.h"
+#include "i_moonraker_client.h"
+#include "json_utils.h"
+#include "lvgl/src/others/translation/lv_translation.h"
+#include "moonraker_error.h"
+#include "static_panel_registry.h"
+
+#include <spdlog/fmt/fmt.h>
+#include <spdlog/spdlog.h>
+
+#include <memory>
+
+namespace helix::kiln_recovery {
+
+namespace {
+
+// The touch screen is the AD5X's own (HELIX_KILN_AD5X, set in
+// buildroot/package/helixscreen/helixscreen.mk); other builds have no
+// kiln_os component behind the method.
+#if defined(HELIX_KILN_AD5X)
+constexpr bool kBuiltIn = true;
+#else
+constexpr bool kBuiltIn = false;
+#endif
+
+std::optional<bool> g_available_override;
+
+void strip_prefix(std::string& text, const char* prefix) {
+    const std::string p(prefix);
+    if (text.compare(0, p.size(), p) == 0) {
+        text.erase(0, p.size());
+    }
+}
+
+} // namespace
+
+bool available() {
+    return g_available_override.value_or(kBuiltIn);
+}
+
+void set_available_for_test(std::optional<bool> value) {
+    g_available_override = value;
+}
+
+std::string refusal_text(const std::string& message) {
+    std::string text = message;
+    strip_prefix(text, "Update agent: ");
+    strip_prefix(text, "refused: ");
+    strip_prefix(text, "failed: ");
+    return text;
+}
+
+void request(IMoonrakerClient& client, Done done) {
+    auto shared = std::make_shared<Done>(std::move(done));
+    auto finish = [shared](bool rebooting, std::string text) {
+        helix::ui::queue_update("kiln_recovery::answer", [shared, rebooting, text]() {
+            if (*shared) {
+                (*shared)(rebooting, text);
+            }
+        });
+    };
+    spdlog::info("[Kiln recovery] {}", kMethod);
+    client.send_jsonrpc(
+        kMethod, json::object(),
+        [finish](const json& response) {
+            const json* result = json_util::find_member(response, "result");
+            const json* status = result ? json_util::find_member(*result, "result") : nullptr;
+            const std::string answer =
+                status && status->is_string() ? status->get<std::string>() : std::string();
+            if (answer.rfind("rebooting", 0) == 0) {
+                spdlog::info("[Kiln recovery] Rebooting into the recovery OS");
+                finish(true, answer);
+            } else {
+                spdlog::warn("[Kiln recovery] Unexpected answer '{}'", answer);
+                finish(false, answer.empty() ? std::string(lv_tr("Failed")) : answer);
+            }
+        },
+        [finish](const MoonrakerError& err) {
+            spdlog::warn("[Kiln recovery] Refused: {}", err.message);
+            const std::string text = refusal_text(err.message);
+            finish(false, text.empty() ? std::string(lv_tr("Failed")) : text);
+        },
+        kTimeoutMs, /*silent=*/true);
+}
+
+void confirm_and_request() {
+    if (!available()) {
+        return;
+    }
+    helix::ui::modal_confirm(
+        lv_tr("Boot into recovery?"),
+        lv_tr("The printer restarts into the recovery OS, where it can't print. To come back, "
+              "tap Boot main OS on its screen."),
+        ModalSeverity::Warning, lv_tr("Restart"), [] {
+            IMoonrakerClient* client = get_moonraker_client();
+            if (!client || client->get_connection_state() != ConnectionState::CONNECTED) {
+                NOTIFY_WARNING("{}", lv_tr("Not connected to the printer"));
+                return;
+            }
+            request(*client, [](bool rebooting, const std::string& text) {
+                if (rebooting) {
+                    ToastManager::instance().show(ToastSeverity::INFO,
+                                                  lv_tr("Restarting into the recovery OS..."),
+                                                  5000);
+                } else {
+                    NOTIFY_ERROR("{}", fmt::format(fmt::runtime(lv_tr(
+                                                       "Can't boot into recovery: {}")),
+                                                   text));
+                }
+            });
+        });
+}
+
+RecoveryRow::~RecoveryRow() {
+    subjects_.deinit_all();
+}
+
+void RecoveryRow::init_subjects() {
+    if (subjects_initialized_) {
+        return;
+    }
+    // 1 shows Settings > System > Boot into recovery (Kiln OS builds)
+    UI_MANAGED_SUBJECT_INT(available_, available() ? 1 : 0, "kiln_boot_recovery_available",
+                           subjects_);
+    subjects_initialized_ = true;
+}
+
+RecoveryRow& row() {
+    return helix::lazy_global<RecoveryRow>("KilnRecoveryRow");
+}
+
+} // namespace helix::kiln_recovery
