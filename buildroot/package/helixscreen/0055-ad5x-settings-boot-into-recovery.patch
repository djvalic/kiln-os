diff --git a/tests/unit/test_settings_kiln_recovery.cpp b/tests/unit/test_settings_kiln_recovery.cpp
new file mode 100644
index 0000000000..9549ca8c1c
--- /dev/null
+++ b/tests/unit/test_settings_kiln_recovery.cpp
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Kiln OS (issue #47): Settings > System > Boot into recovery asks Moonraker's
+// kiln_os component (machine.kiln_os.boot_recovery) to restart the printer into
+// the recovery OS, and shows why when Kiln's update agent refuses.
+
+#include "ui_settings_kiln_recovery.h"
+#include "ui_update_queue.h"
+
+#include "../fake_moonraker_client.h"
+#include "../lvgl_test_fixture.h"
+#include "moonraker_error.h"
+
+#include <optional>
+#include <string>
+
+#include "../catch_amalgamated.hpp"
+
+using helix::test::FakeMoonrakerClient;
+using nlohmann::json;
+namespace recovery = helix::kiln_recovery;
+
+namespace {
+
+struct Answer {
+    bool called = false;
+    bool rebooting = false;
+    std::string text;
+};
+
+/// Send the request, then let @p reply answer the recorded call.
+template <typename Reply> Answer ask(Reply reply) {
+    FakeMoonrakerClient client;
+    Answer answer;
+    recovery::request(client, [&answer](bool rebooting, const std::string& text) {
+        answer.called = true;
+        answer.rebooting = rebooting;
+        answer.text = text;
+    });
+    REQUIRE(client.rpc_calls.size() == 1);
+    const auto& call = client.rpc_calls[0];
+    CHECK(call.method == "machine.kiln_os.boot_recovery");
+    CHECK(call.timeout_ms == recovery::kTimeoutMs);
+    reply(call);
+    // The answer reaches the caller on the main thread, through the queue
+    CHECK_FALSE(answer.called);
+    helix::ui::UpdateQueue::instance().drain();
+    REQUIRE(answer.called);
+    return answer;
+}
+
+MoonrakerError agent_error(const std::string& message) {
+    return MoonrakerError::from_json_rpc({{"code", 400}, {"message", message}},
+                                         "machine.kiln_os.boot_recovery");
+}
+
+} // namespace
+
+TEST_CASE("Kiln recovery: the agent's prefixes are left out of the refusal",
+          "[kiln][kiln_recovery]") {
+    CHECK(recovery::refusal_text("Update agent: refused: a print is running") ==
+          "a print is running");
+    CHECK(recovery::refusal_text(
+              "Update agent: refused: start-up has not finished yet, try again in a minute") ==
+          "start-up has not finished yet, try again in a minute");
+    CHECK(recovery::refusal_text("Update agent didn't answer (is S68ad5x-update-agent running?)") ==
+          "Update agent didn't answer (is S68ad5x-update-agent running?)");
+    CHECK(recovery::refusal_text("Method not found") == "Method not found");
+}
+
+TEST_CASE_METHOD(LVGLTestFixture, "Kiln recovery: Moonraker's answer reaches the caller",
+                 "[kiln][kiln_recovery]") {
+    SECTION("rebooting") {
+        const Answer a = ask([](const FakeMoonrakerClient::RpcCall& call) {
+            REQUIRE(call.success_cb);
+            call.success_cb(json{{"jsonrpc", "2.0"}, {"result", {{"result", "rebooting"}}}});
+        });
+        CHECK(a.rebooting);
+    }
+    SECTION("refused while printing") {
+        const Answer a = ask([](const FakeMoonrakerClient::RpcCall& call) {
+            REQUIRE(call.error_cb);
+            call.error_cb(agent_error("Update agent: refused: a print is running"));
+        });
+        CHECK_FALSE(a.rebooting);
+        CHECK(a.text == "a print is running");
+    }
+    SECTION("refused without the recovery OS in slot A") {
+        const Answer a = ask([](const FakeMoonrakerClient::RpcCall& call) {
+            call.error_cb(agent_error("Update agent: refused: slot A doesn't hold the recovery "
+                                      "OS (it holds: stock)"));
+        });
+        CHECK_FALSE(a.rebooting);
+        CHECK(a.text == "slot A doesn't hold the recovery OS (it holds: stock)");
+    }
+    SECTION("an answer that is not rebooting is not taken for one") {
+        const Answer a = ask([](const FakeMoonrakerClient::RpcCall& call) {
+            call.success_cb(json{{"jsonrpc", "2.0"}, {"result", {{"result", "queued"}}}});
+        });
+        CHECK_FALSE(a.rebooting);
+        CHECK(a.text == "queued");
+    }
+}
+
+TEST_CASE("Kiln recovery: only the Kiln OS build has the row", "[kiln][kiln_recovery]") {
+#if defined(HELIX_KILN_AD5X)
+    CHECK(recovery::available());
+#else
+    CHECK_FALSE(recovery::available());
+#endif
+    recovery::set_available_for_test(true);
+    CHECK(recovery::available());
+    recovery::set_available_for_test(std::nullopt);
+}
