                              Binding{"row_performance", "on_system_performance_clicked"},
                              Binding{"row_telemetry_view_data", "on_telemetry_view_data"},
                              Binding{"row_restart_helix", "on_restart_helix_settings_clicked"},
+                             Binding{"row_kiln_boot_recovery", "on_kiln_boot_recovery_clicked"},
                              Binding{"row_factory_reset", "on_factory_reset_clicked"}}) {
         CAPTURE(b.row, b.callback);
         CHECK(row_runs(b.row, b.callback));
@@ -142,3 +144,35 @@ TEST_CASE_METHOD(SystemCallbacksFixture,
     sys.set_telemetry_enabled(before);
     helix::ui::UpdateQueue::instance().drain();
 }
+
+// Kiln OS (issue #47): Boot into recovery shows on the AD5X build only
+// (kiln_boot_recovery_available) and is greyed while a print is active.
+TEST_CASE_METHOD(SystemCallbacksFixture,
+                 "System page: Boot into recovery shows on Kiln OS and greys during a print",
+                 "[settings][system_callbacks][kiln]") {
+    lv_subject_t* available = lv_xml_get_subject(nullptr, "kiln_boot_recovery_available");
+    REQUIRE(available != nullptr);
+    lv_subject_t* print_active = lv_xml_get_subject(nullptr, "print_active");
+    REQUIRE(print_active != nullptr);
+    const int available_before = lv_subject_get_int(available);
+    lv_obj_t* row = lv_obj_find_by_name(root_, "row_kiln_boot_recovery");
+    REQUIRE(row != nullptr);
+
+    // The test build is not HELIX_KILN_AD5X: hidden there
+    CHECK(available_before == (helix::kiln_recovery::available() ? 1 : 0));
+    CHECK(lv_obj_has_flag(row, LV_OBJ_FLAG_HIDDEN) == !helix::kiln_recovery::available());
+
+    lv_subject_set_int(available, 1);
+    process_lvgl(5);
+    CHECK_FALSE(lv_obj_has_flag(row, LV_OBJ_FLAG_HIDDEN));
+
+    lv_subject_set_int(print_active, 1);
+    process_lvgl(5);
+    CHECK(lv_obj_has_state(row, LV_STATE_DISABLED));
+    lv_subject_set_int(print_active, 0);
+    process_lvgl(5);
+    CHECK_FALSE(lv_obj_has_state(row, LV_STATE_DISABLED));
+
+    lv_subject_set_int(available, available_before);
+    process_lvgl(5);
+}
