@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * @file ui_settings_kiln_recovery.h
+ * @brief Kiln OS: Settings > System > Boot into recovery (issue #47)
+ *
+ * Moonraker's kiln_os component answers `machine.kiln_os.boot_recovery`
+ * (POST /machine/kiln_os/boot_recovery): Kiln's root update agent points the
+ * boot flag at the recovery OS in slot A and reboots, answering
+ * {"result": "rebooting"}. It refuses while a print may run, before start-up
+ * has finished, or without the recovery OS in slot A; Moonraker then answers
+ * an error "Update agent: refused: <why>".
+ *
+ * The row shows on HELIX_KILN_AD5X builds only (`kiln_boot_recovery_available`)
+ * and is greyed while a print is active (print_active). It goes through the
+ * screen's own Moonraker connection (127.0.0.1), so it works with the network
+ * down.
+ *
+ * @threading Main thread; Moonraker's answer hops over through the UpdateQueue
+ */
+
+#pragma once
+
+#include "lvgl/lvgl.h"
+#include "subject_managed_panel.h"
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string>
+
+namespace helix {
+class IMoonrakerClient;
+}
+
+namespace helix::kiln_recovery {
+
+/// The JSON-RPC method of POST /machine/kiln_os/boot_recovery
+inline constexpr const char* kMethod = "machine.kiln_os.boot_recovery";
+
+/// Moonraker waits up to 30 s for the update agent; a little more here
+inline constexpr uint32_t kTimeoutMs = 45000;
+
+/// True on HELIX_KILN_AD5X builds; tests override it.
+bool available();
+void set_available_for_test(std::optional<bool> value);
+
+/// Moonraker's error message without the agent's "Update agent: " and
+/// "refused: " prefixes: "a print is running", "start-up has not finished
+/// yet, try again in a minute", ...
+std::string refusal_text(const std::string& message);
+
+/// The answer, on the main thread: @p rebooting true when the printer is
+/// restarting into recovery, else @p text says why not.
+using Done = std::function<void(bool rebooting, const std::string& text)>;
+
+/// Send the request over @p client.
+void request(IMoonrakerClient& client, Done done);
+
+/// The row's action: confirm, then request, with a toast for the outcome.
+void confirm_and_request();
+
+/// The row's subject: `kiln_boot_recovery_available` (1 shows the row).
+class RecoveryRow {
+  public:
+    RecoveryRow() = default;
+    ~RecoveryRow();
+    RecoveryRow(const RecoveryRow&) = delete;
+    RecoveryRow& operator=(const RecoveryRow&) = delete;
+
+    void init_subjects();
+
+  private:
+    SubjectManager subjects_;
+    lv_subject_t available_{};
+    bool subjects_initialized_ = false;
+};
+
+RecoveryRow& row();
+
+} // namespace helix::kiln_recovery
