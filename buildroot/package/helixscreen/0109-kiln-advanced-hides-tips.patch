+                 "upgrade banner: follows Settings > Advanced settings at once",
+                 "[upgrade-banner][updates][settings_advanced]") {
+    SettingsManager::instance().init_subjects();
+    auto& sys = SystemSettingsManager::instance();
+    const bool before = sys.get_advanced_settings();
+    sys.set_advanced_settings(true);
+    REQUIRE(UpgradeNudge::instance().should_show_banner());
+
+    banner.init();
+    helix::ui::UpdateQueue::instance().drain();
+    lv_obj_t* root = find("upgrade_banner");
+    REQUIRE(root != nullptr);
+    CHECK_FALSE(lv_obj_is_hidden(root));
+
+    // Off: hidden now, not dismissed
+    sys.set_advanced_settings(false);
+    helix::ui::UpdateQueue::instance().drain();
+    CHECK(lv_obj_is_hidden(root));
+    CHECK(UpgradeNudge::instance().should_show_banner());
+
+    // On again: back without waiting for the next check
+    sys.set_advanced_settings(true);
+    helix::ui::UpdateQueue::instance().drain();
+    CHECK_FALSE(lv_obj_is_hidden(root));
+
+    sys.set_advanced_settings(before);
+    helix::ui::UpdateQueue::instance().drain();
+}
