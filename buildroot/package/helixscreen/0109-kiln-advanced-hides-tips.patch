+    fetched(memory_object(false, "standard", false, nullptr, /*notice_pending=*/true));
+    CHECK_FALSE(memory::model().notice_posted());
+    CHECK(entries_with_action(memory::kNoticeAction) == 0);
+    // Not seen either: Kiln keeps it pending
+    memory::model().notice_seen();
+    CHECK(client.rpc_calls.empty());
+
+    // Turned on: it comes now, once
+    sys.set_advanced_settings(true);
+    memory::model().advanced_turned_on();
+    CHECK(memory::model().notice_posted());
+    CHECK(entries_with_action(memory::kNoticeAction) == 1);
+    memory::model().advanced_turned_on();
+    CHECK(entries_with_action(memory::kNoticeAction) == 1);
+
+    sys.set_advanced_settings(before);
+    drain();
+}
