diff --git a/tests/unit/test_settings_advanced_texts.cpp b/tests/unit/test_settings_advanced_texts.cpp
new file mode 100644
index 0000000000..2ebae2e1bf
--- /dev/null
+++ b/tests/unit/test_settings_advanced_texts.cpp
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * @file test_settings_advanced_texts.cpp
+ * @brief Kiln OS: texts that point at rows Settings > Advanced settings hides.
+ *
+ * A tip that only leads to such a row is left out while the setting is off
+ * (here the tour's home-editing step; the Extended memory and boot loader
+ * notices are tested beside their own cases). A problem the user has to fix
+ * is always shown and says to turn the setting on first, in English and in
+ * Russian.
+ */
+
+#include "../lvgl_ui_test_fixture.h"
+#include "lvgl/src/others/translation/lv_translation.h"
+#include "moonraker_event_routing.h"
+#include "storage_report.h"
+#include "tour_steps.h"
+#include "translation_loader.h"
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "../catch_amalgamated.hpp"
+
+using Catch::Matchers::ContainsSubstring;
+
+namespace {
+
+bool has_step(const std::vector<helix::tour::TourStep>& steps, const char* title) {
+    return std::any_of(steps.begin(), steps.end(),
+                       [&](const helix::tour::TourStep& s) { return s.title_key == title; });
+}
+
+/// The problem texts, as the code hands them to lv_tr
+std::vector<std::string> problem_texts() {
+    return {
+        "An internal error occurred. The app continues running. If it repeats, send a debug "
+        "bundle from Settings > Help & About (turn on Settings > Advanced settings first).",
+        helix::storage::kNoUploadSpaceMessage,
+        helix::login_refused_message(true),
+        helix::login_refused_message(false),
+        "This printer's start macro sets a Z offset for each material, so saving it into the "
+        "probe would apply it twice. Turn on Settings > Printing > Z Offset by Material (shown "
+        "with Settings > Advanced settings on) to save it for the print's material.",
+    };
+}
+
+struct RestoreLanguage {
+    ~RestoreLanguage() {
+        lv_translation_set_language(helix::ui::kIdentityLocale);
+    }
+};
+
+} // namespace
+
+TEST_CASE("Advanced settings: the tour leaves out the home-editing tip while it is off",
+          "[settings_advanced][tour]") {
+    const auto on = helix::tour::build_kiln_tour_steps(true, 0, true);
+    const auto off = helix::tour::build_kiln_tour_steps(true, 0, false);
+    CHECK(has_step(on, "Customize your home screen"));
+    CHECK_FALSE(has_step(off, "Customize your home screen"));
+    CHECK(off.size() + 1 == on.size());
+    // The default is the full tour
+    CHECK(helix::tour::build_kiln_tour_steps(true, 0).size() == on.size());
+}
+
+TEST_CASE("Advanced settings: problem texts say to turn it on first", "[settings_advanced][i18n]") {
+    for (const auto& text : problem_texts()) {
+        CAPTURE(text);
+        CHECK_THAT(text, ContainsSubstring("Settings > Advanced settings"));
+    }
+}
+
+TEST_CASE_METHOD(LVGLUITestFixture, "Advanced settings: problem texts in Russian, only Russian",
+                 "[settings_advanced][i18n]") {
+    RestoreLanguage restore;
+    helix::ui::ensure_translation_loaded("ru");
+    lv_translation_set_language("ru");
+    for (const auto& text : problem_texts()) {
+        CAPTURE(text);
+        const std::string ru = lv_tr(text.c_str());
+        CHECK(ru != text);
+        CHECK_THAT(ru, ContainsSubstring("Расширенные настройки"));
+        CHECK_THAT(ru, !ContainsSubstring("Advanced"));
+    }
+}
