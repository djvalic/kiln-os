-/// Kiln OS: machine.reboot through Moonraker only, as the Kiln power dialog
-/// does, for a caller without that dialog (Settings > System > Extended
-/// memory's "Restart now?"). Not connected, or Kiln's update agent refuses:
-/// an error toast ("Not connected to the printer", kiln_power_failure_message()).
-/// Main thread.
+/// Kiln OS: machine.reboot (@p is_reboot) or machine.shutdown through
+/// Moonraker only, as the Kiln power dialog does, for a caller without that
+/// dialog (Advanced's Reboot and Shutdown rows, Settings > System > Extended
+/// memory's "Restart now?"). Accepted: "Restarting printer..." or "Shutting
+/// down printer..." as a toast. Not connected, or Kiln's update agent
+/// refuses: an error toast ("Not connected to the printer",
+/// kiln_power_failure_message()). Never powers anything off locally. Main
+/// thread.
+void request_kiln_power(IMoonrakerAPI* api, bool is_reboot);
+
+/// request_kiln_power() with is_reboot.
 void request_kiln_reboot(IMoonrakerAPI* api);
 
+/// Kiln OS: what a Reboot or a Shutdown entry asks (kiln_power_question()):
+/// one action and Cancel, not the dialog with both.
+struct KilnPowerQuestion {
+    const char* title;   ///< "Restart the printer?" or "Shut down the printer?"
+    const char* message; ///< What happens next
+    const char* confirm; ///< "Restart" or "Shutdown"
+    bool destructive;    ///< Shutdown: the confirm button is styled as danger
+};
+
+/// Translated texts for @p is_reboot (Reboot) or Shutdown. Pure apart from
+/// lv_tr().
+KilnPowerQuestion kiln_power_question(bool is_reboot);
+
+/// A dedicated Reboot (@p is_reboot) or Shutdown entry: Advanced's Power
+/// rows. On Kiln OS (helix::kiln_host_power()) it asks for that one action
+/// (kiln_power_question()) and, confirmed, sends it with request_kiln_power().
+/// Other builds open show_shutdown_dialog(), upstream's dialog with both
+/// actions, whichever row was tapped. Nothing on platforms without host power
+/// controls or without @p api.
+void show_power_entry_dialog(IMoonrakerAPI* api, bool is_reboot, ShutdownModal& modal,
+                             AsyncLifetimeGuard& lifetime, lv_obj_t* parent_screen);
+
 /// Kiln OS: whether the power entries are greyed: on a Kiln build
 /// (@p kiln_host_power) while a job holds the machine (@p job_holds_machine:
 /// printing, paused or preparing), when Kiln's update agent refuses anyway. Pure.
