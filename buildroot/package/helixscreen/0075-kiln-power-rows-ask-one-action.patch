new file mode 100644
index 00000000..df7be85a
--- /dev/null
+++ b/tests/unit/test_kiln_power_entries.cpp
@@ -0,0 +1,236 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * Kiln OS: Advanced's Reboot and Shutdown rows each ask for their own action.
+ *
+ * Upstream both rows open the one dialog with Reboot and Shutdown in it, so
+ * tapping Reboot still asked which of the two. On Kiln builds the Reboot row
+ * asks "Restart the printer?" (Restart, Cancel) and the Shutdown row "Shut
+ * down the printer?" (Shutdown, Cancel); a confirmation goes through
+ * Moonraker's machine.reboot or machine.shutdown, which Kiln's update agent
+ * checks, and a refusal is a toast with its reason. Nothing is powered off
+ * locally. Other builds keep upstream's dialog for both rows.
+ */
+
+#include "ui_modal.h"
+#include "ui_panel_advanced.h"
+#include "ui_toast_manager.h"
+#include "ui_update_queue.h"
+
+#include "../../src/ui/panel_widgets/shutdown_widget.h"
+#include "../lvgl_ui_test_fixture.h"
+#include "../test_helpers/modal_answer.h"
+#include "../ui_test_utils.h"
+#include "moonraker_api.h"
+#include "moonraker_client.h"
+#include "moonraker_error.h"
+#include "platform_info.h"
+#include "static_panel_registry.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "../catch_amalgamated.hpp"
+
+using namespace helix;
+using Catch::Matchers::ContainsSubstring;
+
+namespace {
+
+/// Records machine.reboot / machine.shutdown instead of sending them.
+class PowerRecordingAPI : public MoonrakerAPI {
+  public:
+    using MoonrakerAPI::MoonrakerAPI;
+
+    bool is_connected() const override {
+        return connected;
+    }
+    void machine_reboot(SuccessCallback, ErrorCallback on_error) override {
+        calls.emplace_back("reboot");
+        last_error = std::move(on_error);
+    }
+    void machine_shutdown(SuccessCallback, ErrorCallback on_error) override {
+        calls.emplace_back("shutdown");
+        last_error = std::move(on_error);
+    }
+
+    bool connected = true;
+    std::vector<std::string> calls;
+    ErrorCallback last_error;
+};
+
+/// The real advanced_panel.xml, its callbacks registered as the app does,
+/// with a PowerRecordingAPI behind the panel.
+struct PowerRowsFixture : LVGLUITestFixture {
+    PowerRecordingAPI power_api{*client(), state()};
+    lv_obj_t* root = nullptr;
+    std::vector<std::pair<ToastSeverity, std::string>> toasts;
+
+    PowerRowsFixture() {
+        // The rows grey with kiln_power_locked, made before any panel XML
+        deinit_kiln_power_lock_subject();
+        init_kiln_power_lock_subject(state(), /*register_xml=*/true);
+        init_global_advanced_panel(state(), &power_api);
+        get_global_advanced_panel().init_subjects();
+        root = static_cast<lv_obj_t*>(lv_xml_create(test_screen(), "advanced_panel", nullptr));
+        REQUIRE(root != nullptr);
+        process_lvgl(5);
+        helix::ui::set_test_toast_hook([this](ToastSeverity sev, const std::string& text,
+                                              uint32_t) { toasts.emplace_back(sev, text); });
+    }
+
+    ~PowerRowsFixture() override {
+        while (ModalStack::instance().top_dialog() != nullptr) {
+            Modal::hide(ModalStack::instance().top_dialog());
+            process_lvgl(5);
+        }
+        if (root && lv_obj_is_valid(root)) {
+            lv_obj_delete(root);
+        }
+        helix::ui::UpdateQueue::instance().drain();
+        StaticPanelRegistry::instance().destroy_all();
+        deinit_kiln_power_lock_subject();
+        helix::ui::set_test_toast_hook(nullptr);
+        set_kiln_host_power_override(-1);
+    }
+
+    void tap(const char* row_name) {
+        lv_obj_t* row = lv_obj_find_by_name(root, row_name);
+        REQUIRE(row != nullptr);
+        lv_obj_send_event(row, LV_EVENT_CLICKED, nullptr);
+        helix::ui::UpdateQueue::instance().drain();
+        process_lvgl(20);
+    }
+
+    static std::string button_text(const char* name) {
+        lv_obj_t* dialog = ModalStack::instance().top_dialog();
+        REQUIRE(dialog != nullptr);
+        lv_obj_t* button = lv_obj_find_by_name(dialog, name);
+        REQUIRE(button != nullptr);
+        return test::subtree_text(button);
+    }
+
+    bool toast_shows(ToastSeverity sev, const std::string& text) const {
+        for (const auto& t : toasts) {
+            if (t.first == sev && t.second == text) {
+                return true;
+            }
+        }
+        return false;
+    }
+};
+
+} // namespace
+
+TEST_CASE("Kiln power entries: each question names one action", "[shutdown][power][kiln]") {
+    const KilnPowerQuestion reboot = kiln_power_question(/*is_reboot=*/true);
+    CHECK(std::string(reboot.title) == "Restart the printer?");
+    CHECK(std::string(reboot.confirm) == "Restart");
+    CHECK_FALSE(reboot.destructive);
+    CHECK_THAT(std::string(reboot.message), !ContainsSubstring("off"));
+
+    const KilnPowerQuestion shutdown = kiln_power_question(/*is_reboot=*/false);
+    CHECK(std::string(shutdown.title) == "Shut down the printer?");
+    CHECK(std::string(shutdown.confirm) == "Shutdown");
+    CHECK(shutdown.destructive);
+    CHECK_THAT(std::string(shutdown.message), !ContainsSubstring("start"));
+}
+
+TEST_CASE_METHOD(PowerRowsFixture, "Kiln power entries: Reboot asks only to restart",
+                 "[shutdown][power][kiln]") {
+    set_kiln_host_power_override(1);
+    tap("row_reboot");
+
+    REQUIRE(ModalStack::instance().top_dialog() != nullptr);
+    const std::string text = test::top_modal_text();
+    CHECK_THAT(text, ContainsSubstring("Restart the printer?"));
+    CHECK_THAT(text, !ContainsSubstring("Shut"));
+    // Not upstream's dialog with both actions
+    CHECK_THAT(text, !ContainsSubstring("Shutdown / Reboot"));
+    CHECK_THAT(button_text("btn_primary"), ContainsSubstring("Restart"));
+    CHECK_THAT(button_text("btn_secondary"), ContainsSubstring("Cancel"));
+    CHECK(power_api.calls.empty());
+
+    SECTION("Restart sends machine.reboot, nothing else") {
+        test::answer_top_modal("btn_primary");
+        REQUIRE(power_api.calls == std::vector<std::string>{"reboot"});
+        CHECK(ModalStack::instance().top_dialog() == nullptr);
+
+        // Kiln's update agent refuses: a toast says why
+        MoonrakerError err;
+        err.message = "A print is running";
+        power_api.last_error(err);
+        helix::ui::UpdateQueue::instance().drain();
+        CHECK(toast_shows(ToastSeverity::ERROR, "Can't restart the printer: A print is running"));
+        CHECK(power_api.calls.size() == 1);
+    }
+
+    SECTION("Cancel sends nothing") {
+        test::answer_top_modal("btn_secondary");
+        CHECK(power_api.calls.empty());
+        CHECK(ModalStack::instance().top_dialog() == nullptr);
+    }
+}
+
+TEST_CASE_METHOD(PowerRowsFixture, "Kiln power entries: Shutdown asks only to shut down",
+                 "[shutdown][power][kiln]") {
+    set_kiln_host_power_override(1);
+    tap("row_shutdown");
+
+    REQUIRE(ModalStack::instance().top_dialog() != nullptr);
+    const std::string text = test::top_modal_text();
+    CHECK_THAT(text, ContainsSubstring("Shut down the printer?"));
+    CHECK_THAT(text, !ContainsSubstring("Restart"));
+    CHECK_THAT(text, !ContainsSubstring("Reboot"));
+    CHECK_THAT(button_text("btn_primary"), ContainsSubstring("Shutdown"));
+    CHECK_THAT(button_text("btn_secondary"), ContainsSubstring("Cancel"));
+
+    SECTION("Shutdown sends machine.shutdown, nothing else") {
+        test::answer_top_modal("btn_primary");
+        REQUIRE(power_api.calls == std::vector<std::string>{"shutdown"});
+
+        MoonrakerError err;
+        err.message = "[starting_up] Start-up has not finished yet, try again in a minute";
+        power_api.last_error(err);
+        helix::ui::UpdateQueue::instance().drain();
+        CHECK(toast_shows(ToastSeverity::ERROR,
+                          "Can't shut down the printer: Start-up has not finished yet, try again "
+                          "in a minute"));
+    }
+
+    SECTION("Cancel sends nothing") {
+        test::answer_top_modal("btn_secondary");
+        CHECK(power_api.calls.empty());
+    }
+}
+
+TEST_CASE_METHOD(PowerRowsFixture, "Kiln power entries: not connected, nothing sent",
+                 "[shutdown][power][kiln]") {
+    set_kiln_host_power_override(1);
+    power_api.connected = false;
+    tap("row_reboot");
+    test::answer_top_modal("btn_primary");
+    CHECK(power_api.calls.empty());
+    CHECK(toast_shows(ToastSeverity::ERROR, "Not connected to the printer"));
+}
+
+TEST_CASE_METHOD(PowerRowsFixture, "Kiln power entries: other builds keep upstream's dialog",
+                 "[shutdown][power][kiln]") {
+    set_kiln_host_power_override(0);
+    set_platform_override(0);
+    for (const char* row : {"row_reboot", "row_shutdown"}) {
+        CAPTURE(row);
+        tap(row);
+        REQUIRE(ModalStack::instance().top_dialog() != nullptr);
+        // Upstream's dialog: both actions, whichever row was tapped
+        const std::string text = test::top_modal_text();
+        CHECK_THAT(text, ContainsSubstring("Shutdown / Reboot"));
+        CHECK_THAT(text, !ContainsSubstring("Restart the printer?"));
+        CHECK_THAT(text, !ContainsSubstring("Shut down the printer?"));
+        CHECK(power_api.calls.empty());
+        Modal::hide(ModalStack::instance().top_dialog());
+        process_lvgl(20);
+    }
+    set_platform_override(-1);
+}
