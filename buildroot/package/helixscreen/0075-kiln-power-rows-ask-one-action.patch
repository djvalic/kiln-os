+// power dialog asks first. Kiln's Reboot and Shutdown rows always ask, so the
+// switch would do nothing there: it is hidden on Kiln, shown elsewhere.
+TEST_CASE_METHOD(LVGLUITestFixture, "Kiln power entries: Safety hides Confirm shutdown and reboot",
+                 "[shutdown][power][kiln][safety]") {
+    SettingsManager::instance().init_subjects();
+    auto& safety = helix::settings::get_safety_settings_overlay();
+    safety.init_subjects();
+    safety.register_callbacks();
+    for (const int kiln : {1, 0}) {
+        CAPTURE(kiln);
+        set_kiln_host_power_override(kiln);
+        lv_obj_t* root = safety.create(test_screen());
+        REQUIRE(root != nullptr);
+        lv_obj_t* row = lv_obj_find_by_name(root, "row_power_confirm");
+        REQUIRE(row != nullptr);
+        safety.on_activate();
+        CHECK(lv_obj_has_flag(row, LV_OBJ_FLAG_HIDDEN) == (kiln == 1));
+        lv_obj_delete(root);
+        helix::ui::UpdateQueue::instance().drain();
+    }
+    set_kiln_host_power_override(-1);
+}
