+// wpa_supplicant writes a hidden network whose SSID is all zero bytes as
+// literal \x00 text. That is no name, so it is skipped like an empty one.
+static bool is_nul_only_ssid(const std::string& ssid) {
+    std::string rest = ssid;
+    const std::string escaped = "\\x00";
+    for (size_t at = rest.find(escaped); at != std::string::npos; at = rest.find(escaped)) {
+        rest.erase(at, escaped.size());
+    }
+    return rest.empty();
+}
