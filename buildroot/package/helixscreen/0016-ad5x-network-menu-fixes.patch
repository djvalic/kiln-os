+// IPv4 address the kernel has on a netdev, "" when it has none. STATUS can
+// leave out ip_address while the interface is up and addressed (issue #7),
+// so get_status() asks the kernel when STATUS has none.
+static std::string kernel_ipv4(const std::string& netdev) {
+    struct ifaddrs* list = nullptr;
+    if (netdev.empty() || getifaddrs(&list) != 0)
+        return "";
+    std::string found;
+    for (struct ifaddrs* a = list; a != nullptr; a = a->ifa_next) {
+        if (!a->ifa_addr || a->ifa_addr->sa_family != AF_INET || netdev != a->ifa_name)
+            continue;
+        char text[INET_ADDRSTRLEN] = {};
+        const auto* sin = reinterpret_cast<const struct sockaddr_in*>(a->ifa_addr);
+        if (inet_ntop(AF_INET, &sin->sin_addr, text, sizeof(text)) != nullptr) {
+            found = text;
+            break;
+        }
+    }
+    freeifaddrs(list);
+    return found;
+}
