+++ b/src/ui/tour/tour_steps_kiln.cpp
@@ -0,0 +1,142 @@
+// Copyright (C) 2025-2026 356C LLC
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Kiln OS (AD5X): the tour of Kiln's own screens. Upstream's list
+// (tour_steps.cpp) points at tiles the AD5X home doesn't have, calls the
+// IFS an AMS, shows a Print Status sample with steps the AD5X has no use
+// for, and names an "Advanced" panel with firmware updates; on
+// HELIX_KILN_AD5X builds build_tour_steps() returns this list instead.
+// Keys are their own English text, as in tour_steps.cpp.
+
+#include "tour_steps.h"
+
+#include <algorithm>
+#include <utility>
+
+namespace helix::tour {
+
+std::vector<TourStep> build_kiln_tour_steps(bool has_ams, int seen_version) {
+    std::vector<TourStep> steps;
+    steps.reserve(12);
+
+    steps.push_back({"",
+                     "Welcome to Kiln OS",
+                     "Here's a quick tour of the screen, so you can find things fast.",
+                     TooltipAnchor::Center,
+                     {}});
+
+    // Only for someone who saw an earlier tour (upstream's): say why it's back
+    TourStep changed{"",
+                     "A tour of Kiln's screens",
+                     "The tour now shows the screens Kiln OS sets up. Skip it anytime.",
+                     TooltipAnchor::Center,
+                     {}};
+    changed.upgrade_only = true;
+    steps.push_back(std::move(changed));
+
+    TourStep glance{"temperature",
+                    "Your printer at a glance",
+                    "Nozzle and bed temperatures, fans and notifications are along the top. "
+                    "Tap any tile to open its controls.",
+                    TooltipAnchor::PreferBelow,
+                    {}};
+    glance.fallback_target_name = "print_status";
+    steps.push_back(std::move(glance));
+
+    // The tile has no free side: the card goes to its corner, the outline stays
+    steps.push_back({"print_status",
+                     "Print status",
+                     "The print in progress, or your last print with Reprint Last. During a "
+                     "print, tap it for temperatures, IFS slots, and Pause, Tune and Cancel.",
+                     TooltipAnchor::PreferRight,
+                     {}});
+
+    if (has_ams) {
+        steps.push_back({"ams",
+                         "IFS slots",
+                         "The material and colour in each of the four slots. Tap here to open "
+                         "the IFS screen.",
+                         TooltipAnchor::PreferLeft,
+                         {}});
+    }
+
+    TourStep customize{"fan_stack",
+                       "Customize your home screen",
+                       "Long-press any tile to move, resize, remove or add tiles.",
+                       TooltipAnchor::PreferBelow,
+                       {}};
+    customize.fallback_target_name = "print_status";
+    steps.push_back(std::move(customize));
+
+    steps.push_back({"nav_btn_controls",
+                     "Controls",
+                     "Move the toolhead, home axes, level the bed, and fine-tune temperatures, "
+                     "fans, and other motion settings.",
+                     TooltipAnchor::PreferRight,
+                     {}});
+
+    TourStep filament_panel{"filament_operations_group",
+                            "Load and unload",
+                            "Load, unload, and purge from here. Choose a material to set its "
+                            "temperatures first.",
+                            TooltipAnchor::LeftNarrowed,
+                            {}};
+    filament_panel.panel = TourPanel::Filament;
+    steps.push_back(std::move(filament_panel));
+
+    if (has_ams) {
+        TourStep ifs{"ams_unit_card",
+                     "The IFS screen",
+                     "Tap a slot to load it or to set its material and colour. With Spoolman, "
+                     "you can link a spool to it.",
+                     TooltipAnchor::PreferBelow,
+                     {}};
+        ifs.panel = TourPanel::AmsOverlay;
+        ifs.fallback_target_name = "unit_cards_row";
+        steps.push_back(std::move(ifs));
+
+        // The sidebar, not its Settings button: that hides without device ops,
+        // and the overlay doesn't check whether a target is hidden
+        TourStep tools{"ams_operation_sidebar",
+                       "Auto-Refill and IFS tools",
+                       "Load and Unload are here. Settings has Auto-Refill, Tune IFS and "
+                       "Pre-feed.",
+                       TooltipAnchor::LeftNarrowed,
+                       {}};
+        tools.panel = TourPanel::AmsOverlay;
+        steps.push_back(std::move(tools));
+    }
+
+    steps.push_back({"nav_btn_advanced",
+                     "More",
+                     "Macros, G-code console, print history, Spoolman, calibration, and "
+                     "Shutdown or Reboot.",
+                     TooltipAnchor::PreferRight,
+                     {}});
+    steps.push_back({"nav_btn_settings",
+                     "Settings",
+                     "Screen, sound, connection, and the printer's own settings: Run Setup "
+                     "Wizard, Nozzle Size, Filament Auto-Refill, Plugins. Replay this tour "
+                     "from Help & About.",
+                     TooltipAnchor::PreferRight,
+                     {}});
+
+    // Every step but the welcome is new in Kiln's tour (kKilnTourVersion): a
+    // new install sees it all without the "tour of Kiln's screens" card,
+    // someone who saw upstream's tour (1 or 2) sees it all but the welcome,
+    // with that card; once seen (3), nothing.
+    for (auto& s : steps)
+        if (s.title_key != "Welcome to Kiln OS")
+            s.since_version = kKilnTourVersion;
+
+    const bool upgrading = seen_version > 0;
+    steps.erase(std::remove_if(steps.begin(), steps.end(),
+                               [&](const TourStep& s) {
+                                   return upgrading ? s.since_version <= seen_version
+                                                    : s.upgrade_only;
+                               }),
+                steps.end());
+    return steps;
+}
+
+} // namespace helix::tour
