# Laptop build environment for u-boot/build.sh (u-boot/README.md, "Build"):
# the builder's pinned Debian base (BUILDER_BASE_IMAGE in buildroot/PINS)
# with Debian's MIPS cross compiler. The builder itself can use Buildroot's
# toolchain instead (TOOLBIN). Packages are whatever Debian trixie has when
# the image is built; build.sh records the compiler version it used.
FROM docker.io/library/debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
	gcc-mipsel-linux-gnu binutils-mipsel-linux-gnu gcc libc6-dev make bc \
	bison flex libssl-dev libgnutls28-dev uuid-dev python3 python3-dev \
	python3-setuptools python3-pyelftools swig device-tree-compiler patch \
	xz-utils ca-certificates curl file git \
	&& rm -rf /var/lib/apt/lists/*
