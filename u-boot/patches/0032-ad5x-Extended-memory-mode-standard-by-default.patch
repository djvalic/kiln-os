  */
 static void ad5x_bootargs(const char *root, int own, int extra_ok,
-			  unsigned int wdt)
+			  unsigned int wdt, int mem_ext)
 {
 	char extra[256] = "";
 	char *args;
 	long len;
-	unsigned int mib;
+	unsigned int mib = ad5x_ram_mib();
 
 	if (own && extra_ok) {
 		/* as S00ad5x-kernel adds: cmdline-extra comes last */
@@ -471,14 +498,17 @@ static void ad5x_bootargs(const char *root, int own, int extra_ok,
 	snprintf(args + strlen(args), CONFIG_SYS_CBSIZE - strlen(args),
 		 " %s", extra);
 	/*
-	 * 256 MiB (an X2600E, mach/x2600_ram.h, as the SPL decided): no
-	 * second bank, from args_spl or cmdline-extra alike
+	 * The second bank only for extended memory on 512 MiB: standard
+	 * memory and 256 MiB (an X2600E, mach/x2600_ram.h, as the SPL
+	 * decided) drop it, from args_spl or cmdline-extra alike; then
+	 * ad5x.ram= and ad5x.memmode= for Linux userspace
 	 */
