 			 sizeof(rec->failed_mainline));
+	else if (!strcmp(key, "failed-mem"))
+		text_clean(rec->failed_mem, strcmp(val, "-") ? val : "",
+			   sizeof(rec->failed_mem));
 	else if (!strcmp(key, "fallbacks"))
 		rec->fallbacks = parse_uint(val);
 	else if (!strcmp(key, "reason"))
@@ -334,7 +352,7 @@ void ad5x_decide(const struct ad5x_inputs *in, struct ad5x_decision *out)
 	char why[AD5X_REASON_LEN] = "";
 	enum ad5x_kernel k;
 	unsigned int tries;
-	int to_recovery = 0, failed = 0;
+	int to_recovery = 0, failed = 0, mem_failed = 0;
 
 	memset(out, 0, sizeof(*out));
 	out->state = *st;
@@ -368,6 +386,29 @@ void ad5x_decide(const struct ad5x_inputs *in, struct ad5x_decision *out)
 		out->write_flag = -1;	/* the flag to slot B */
 	}
 
+	/*
+	 * Extended memory: a "failed-mem" record is for the main OS to copy
+	 * to /data (kernel/extended-memory-failed) as it starts. Once a later
+	 * start has been confirmed (the state is empty) the copy counts, and
+	 * removing it (ad5x-memory extended on) switches the mode on again.
+	 */
+	if (!st->tries && out->rec.failed_mem[0]) {
+		out->rec.failed_mem[0] = '\0';
+		out->rec_changed = 1;
+	}
+	/* the last start had the second bank and didn't finish: standard */
+	if (st->tries && st->mem_ext) {
+		char mem[AD5X_REASON_LEN];
+
+		snprintf(mem, sizeof(mem), "%s %s did not finish starting with "
+			 "extended memory", short_name(st->kernel),
+			 st->release[0] ? st->release :
+			 release_of(in, st->kernel));
+		text_clean(out->rec.failed_mem, mem, sizeof(out->rec.failed_mem));
+		out->rec_changed = 1;
+		mem_failed = 1;
+	}
+
 	/* the last start of the main OS didn't finish */
 	tries = st->tries;
 	if (tries) {
@@ -414,6 +455,11 @@ void ad5x_decide(const struct ad5x_inputs *in, struct ad5x_decision *out)
 		/* the other kernel of Kiln's: "6.6 until ad5x-kernel retry" */
 		add(why, "; %s until ad5x-kernel retry", short_name(k));
 		set_reason(out, why);
+	} else if (!to_recovery && mem_failed) {
+		/* the same kernel again, with standard memory */
+		snprintf(why, sizeof(why), "%s: standard memory until "
+			 "ad5x-memory extended on", out->rec.failed_mem);
+		set_reason(out, why);
 	}
 
 	if (to_recovery) {
@@ -447,18 +493,30 @@ void ad5x_decide(const struct ad5x_inputs *in, struct ad5x_decision *out)
 		set_reason(out, why);
 	}
 
+	/*
+	 * Extended memory: asked for, not failed, 512 MiB, and only on a
+	 * plain start of the main OS on Kiln's own kernel (it gets
+	 * cmdline-extra too) with no start unconfirmed: never on a retry, a
+	 * fallback, the first start after an install or a flag on slot A.
+	 */
+	out->mem_ext = in->data_ok && in->ext_wanted && !in->ext_failed &&
+		       in->ram_mib == 512 && in->flag_b && !st->tries &&
+		       !in->after_install && !to_recovery &&
+		       (k == AD5X_K_66 || k == AD5X_K_73);
+
 	if (k != st->kernel)
 		tries = 0;
 	out->state.tries = tries < AD5X_MAX_TRIES ? tries + 1 : AD5X_MAX_TRIES;
 	out->state.kernel = k;
 	ad5x_release_clean(out->state.release, release_of(in, k),
 			   AD5X_REL_LEN);
+	out->state.mem_ext = out->mem_ext;
 	out->state_changed = 1;
 	out->target = AD5X_BOOT_MAIN;
 	out->kernel = k;
 	snprintf(out->msg, sizeof(out->msg), "main OS, kernel %s (%s), "
-		 "start %u", ad5x_kernel_name(k), out->state.release,
-		 out->state.tries);
+		 "start %u, %s memory", ad5x_kernel_name(k), out->state.release,
+		 out->state.tries, out->mem_ext ? "extended" : "standard");
 }
 
