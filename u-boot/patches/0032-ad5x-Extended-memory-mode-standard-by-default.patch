diff --git a/arch/mips/mach-jz47xx/include/mach/x2600_ram.h b/arch/mips/mach-jz47xx/include/mach/x2600_ram.h
index 3de48fb5..4fad2fa0 100644
--- a/arch/mips/mach-jz47xx/include/mach/x2600_ram.h
+++ b/arch/mips/mach-jz47xx/include/mach/x2600_ram.h
@@ -168,4 +168,122 @@ static inline void x2600_args_kiln_low(char *s)
 	}
 }
 
+/*
+ * Take every word that begins with @key (NUL-terminated) off command line
+ * @s, in place, the same way.
+ */
+static inline void x2600_args_drop_key(char *s, const char *key)
+{
+	char *w = s, *e;
+	int i;
+
+	while (*w) {
+		if (*w == ' ') {
+			w++;
+			continue;
+		}
+		for (e = w; *e && *e != ' '; e++)
+			;
+		for (i = 0; key[i] && w + i < e && w[i] == key[i]; i++)
+			;
+		w = key[i] ? e : x2600_args_cut(s, w, e);
+	}
+}
+
+/* the longest memory words x2600_args_memory_words() appends */
+#define X2600_ARGS_MEMORY_MAX	sizeof(" ad5x.ram=512 ad5x.memmode=extended")
+
+/*
+ * For Linux userspace, after the last word of command line @s (@size bytes
+ * with its NUL), in place: the board's RAM, "ad5x.ram=<mib>", and the mode
+ * this start got, "ad5x.memmode=standard|extended" (@extended). Trailing
+ * spaces go first; the words are left off when they don't fit @size.
+ */
+static inline void x2600_args_memory_words(char *s, unsigned int size,
+					   unsigned int mib, int extended)
+{
+	static const char ram[] = " ad5x.ram=";
+	static const char mode[] = " ad5x.memmode=";
+	const char *m = extended ? "extended" : "standard";
+	char num[12], *e;
+	unsigned int v = mib, n = 0, i, need;
+
+	for (e = s; *e; e++)
+		;
+	while (e > s && e[-1] == ' ')
+		e--;
+	*e = '\0';
+	do {
+		num[n++] = '0' + v % 10;
+		v /= 10;
+	} while (v && n < sizeof(num));
+	/* the line, both words (the mode is 8 letters either way), NUL */
+	need = (unsigned int)(e - s) + sizeof(ram) - 1 + n + sizeof(mode) - 1 +
+	       8 + 1;
+	if (need > size)
+		return;
+	for (i = 0; ram[i]; i++)
+		*e++ = ram[i];
+	while (n)
+		*e++ = num[--n];
+	for (i = 0; mode[i]; i++)
+		*e++ = mode[i];
+	for (i = 0; m[i]; i++)
+		*e++ = m[i];
+	*e = '\0';
+}
+
+/*
+ * Extended memory mode (Kiln OS): the memory a kernel gets on a board with
+ * @mib MiB (x2600_ram_mib()), on command line @s (@size bytes with its
+ * NUL), in place. Extended only when @extended asks for it and the board
+ * has 512 MiB: the X2600H's second bank (mem=256M@0x30000000) stays.
+ * Standard otherwise: every word "mem=<size>@0x30000000" goes, the low
+ * window alone, as on a 256 MiB board. Any "ad5x.ram=" and
+ * "ad5x.memmode=" words already there (cmdline-extra) go, and
+ * x2600_args_memory_words() says what this start got. Returns 1 when it
+ * is extended, else 0.
+ */
+static inline int x2600_args_memory(char *s, unsigned int size,
+				    unsigned int mib, int extended)
+{
+	extended = extended && mib == 512;
+	if (!extended)
+		x2600_args_drop_high_bank(s);
+	x2600_args_drop_key(s, "ad5x.ram=");
+	x2600_args_drop_key(s, "ad5x.memmode=");
+	x2600_args_memory_words(s, size, mib, extended);
+	return extended;
+}
+
+/* Kiln's 6.6, by the start of its uImage name (kernel-ingenic66/build.sh) */
+#define X2600_KILN66_NAME	"Linux-6.6-ad5x"
+
+/*
+ * The SPL's own start of a kernel slot (no U-Boot proper): command line
+ * @s, the stock SPL's with root= set (@size bytes with its NUL), for the
+ * board's @mib MiB and the slot's uImage named @name, in place. Kiln's
+ * 6.6 gets Kiln's low window (x2600_args_kiln_low) and always the
+ * standard memory mode, the second bank off, with the words that say so
+ * (x2600_args_memory_words): the SPL can't read the owner's choice on
+ * /data, and this start is a fallback. Any other kernel (Flashforge's
+ * 5.10) gets the stock SPL's line as it starts it: without the second
+ * bank on 256 MiB. (The stock line has no ad5x.* words to drop.)
+ */
+static inline void x2600_args_spl(char *s, unsigned int size,
+				  unsigned int mib, const char *name)
+{
+	static const char kiln[] = X2600_KILN66_NAME;
+	unsigned int i;
+
+	for (i = 0; kiln[i] && name[i] == kiln[i]; i++)
+		;
+	if (!kiln[i])
+		x2600_args_kiln_low(s);
+	if (!kiln[i] || mib < 512)
+		x2600_args_drop_high_bank(s);
+	if (!kiln[i])
+		x2600_args_memory_words(s, size, mib, 0);
+}
+
 #endif
