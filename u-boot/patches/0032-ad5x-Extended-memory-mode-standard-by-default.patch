+/*
+ * The board's RAM (mach/x2600_ram.h), as the SPL decided it from the SoC
+ * ID in the eFuse: read once
+ */
+static unsigned int ad5x_ram_mib(void)
+{
+	static int mib = -1;
+
+	if (mib < 0)
+		mib = x2600_ram_mib(x2600_socid());
+	return mib;
+}
+
 static void ad5x_gather(struct ad5x_inputs *in)
 {
 	const char *slot = ad5x_read_slot();
@@ -351,6 +364,7 @@ static void ad5x_gather(struct ad5x_inputs *in)
 	memset(in, 0, sizeof(*in));
 	in->flag_b = slot && *slot == 'b';
 	ad5x_read_records(in);
+	in->ram_mib = ad5x_ram_mib();
 
 	/* /data: p7, ext4 */
 	in->data_ok = !fs_set_blk_dev("mmc", "0:7", FS_TYPE_EXT);
@@ -363,6 +377,10 @@ static void ad5x_gather(struct ad5x_inputs *in)
 		ad5x_line(7, "/ad5x/kernel/failed-mainline",
 			  in->s00_failed_mainline, AD5X_REL_LEN);
 		in->wdt_off = ad5x_exists(7, "/ad5x/watchdog.disable");
+		/* extended memory mode: the owner's switch, the OS's record */
+		in->ext_wanted = ad5x_exists(7, "/ad5x/kernel/extended-memory");
+		in->ext_failed =
+			ad5x_exists(7, "/ad5x/kernel/extended-memory-failed");
 	}
 
 	/* rootfs2: p4, SquashFS */
@@ -407,6 +425,13 @@ static void ad5x_print(const struct ad5x_inputs *in)
 	       env_get_ulong("wdt_os", 10, 0),
 	       in->wdt_capable ? "feeds it" : "doesn't feed it",
 	       in->wdt_off ? "switches it off" : "doesn't switch it off");
+	printf("ad5x: memory: %u MiB; extended memory %s%s; unconfirmed "
+	       "start %s; failed-mem %s\n", in->ram_mib,
+	       in->ext_wanted ? "on" : "off",
+	       in->ext_failed ? " (failed, on /data)" : "",
+	       !in->state.tries ? "none" :
+	       in->state.mem_ext ? "extended" : "standard",
+	       in->rec.failed_mem[0] ? in->rec.failed_mem : "-");
 }
 
