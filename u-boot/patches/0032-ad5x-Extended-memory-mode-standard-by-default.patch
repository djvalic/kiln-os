 }
@@ -580,7 +610,7 @@ static int do_ad5x_boot(struct cmd_tbl *cmdtp, int flag, int argc,
 
 		if (d.target == AD5X_BOOT_RECOVERY) {
 			/* p1's Kiln 6.6, loaded and checked by ad5x_gather */
-			ad5x_bootargs("/dev/mmcblk0p2", 1, 0, 0);
