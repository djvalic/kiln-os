@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Flashforge Adventurer 5X (Ingenic X2600), U-Boot proper.
+ */
+
+/dts-v1/;
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	compatible = "flashforge,ad5x", "ingenic,x2600";
+	model = "Flashforge Adventurer 5X";
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x0ec00000>;
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+		bootph-all;
+
+		/* UART0, on the DEBUG header (PE9/PE10), 24 MHz EXCLK */
+		uart0: serial@10030000 {
+			compatible = "ingenic,x2600-uart", "ingenic,jz4780-uart";
+			reg = <0x10030000 0x100>;
+			reg-shift = <2>;
+			clock-frequency = <24000000>;
+			bootph-all;
+		};
+	};
+};
