@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Flashforge Adventurer 5X (Ingenic X2600)
+ */
+
+#include <init.h>
+#include <asm/global_data.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+void x2600_uart0_plain_baud(void);
+
+int board_early_init_f(void)
+{
+	x2600_uart0_plain_baud();
+	return 0;
+}
+
+/*
+ * 512 MiB in two banks: 236 MiB at 0 (lowmem, the only part KSEG0 reaches
+ * below the rmem and rtos regions) and 256 MiB at 0x30000000. Above 236 MiB
+ * the low bank holds rmem (16 MiB at 0x0ec00000) and the RISC-V
+ * co-processor's 4 MiB (0x0fc00000), which the SPL may have started: U-Boot
+ * keeps to the 236 MiB below them.
+ */
+int dram_init(void)
+{
+	gd->ram_size = 236 << 20;
+	return 0;
+}
