--- /dev/null
+++ b/arch/mips/mach-jz47xx/x2600/x2600.c
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic X2600 SoC: U-Boot proper started by the boot ROM's SPL (or by
+ * Linux, for tests), which has already set up the clocks and the DRAM.
+ */
+
+#include <init.h>
+#include <asm/io.h>
+#include <linux/bitops.h>
+
+/* UART0: Ingenic's fractional baud registers, after the 16550 ones */
+#define X2600_UART0		((void __iomem *)0xb0030000)
+#define UART_UMR		0x24
+#define UART_UACR		0x28
+
+int print_cpuinfo(void)
+{
+	printf("CPU:   Ingenic X2600\n");
+	return 0;
+}
+
+/*
+ * Plain 16550 divisors from the 24 MHz clock need the fractional baud
+ * registers at their reset values (16 cycles per bit, no extra cycles).
+ * Linux may leave them otherwise; set them before the console starts.
+ */
+void x2600_uart0_plain_baud(void)
+{
+	writel(16, X2600_UART0 + UART_UMR);
+	writel(0, X2600_UART0 + UART_UACR);
+}
+
+/*
+ * Timer: the global OST, a 64-bit counter at the 24 MHz EXCLK. The CP0
+ * counter doesn't run here (a "sleep" on it never ends). The clock gate is
+ * CLKGR0 bit 28 (set = off); started unless already running, so a count
+ * left by the SPL or Linux carries on.
+ */
+#define X2600_CPM_CLKGR0	((void __iomem *)0xb0000020)
+#define CLKGR0_OST		BIT(28)
+#define X2600_OST		((void __iomem *)0xb2000000)
+#define GOST_CCR		0x00	/* prescaler */
+#define GOST_ER			0x04	/* enable */
+#define GOST_CR			0x08	/* clear */
+#define GOST_CNTH		0x0c
+#define GOST_CNTL		0x10
+
+int timer_init(void)
+{
+	clrbits_le32(X2600_CPM_CLKGR0, CLKGR0_OST);
+	if (!(readl(X2600_OST + GOST_ER) & BIT(0))) {
+		writel(0, X2600_OST + GOST_CCR);	/* divide by 1 */
+		writel(BIT(0), X2600_OST + GOST_CR);
+		writel(BIT(0), X2600_OST + GOST_ER);
+	}
+	return 0;
+}
+
+unsigned long long get_ticks(void)
+{
+	u32 hi, lo;
+
+	/* the high word again until the low word didn't wrap in between */
+	do {
+		hi = readl(X2600_OST + GOST_CNTH);
+		lo = readl(X2600_OST + GOST_CNTL);
+	} while (hi != readl(X2600_OST + GOST_CNTH));
+
+	return ((u64)hi << 32) | lo;
+}
