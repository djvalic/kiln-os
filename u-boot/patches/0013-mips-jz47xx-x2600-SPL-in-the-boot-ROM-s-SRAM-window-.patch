+/* SPDX-License-Identifier: GPL-2.0+ */
+/* Ingenic X2600 SPL: between its parts */
+#ifndef __X2600_SPL_H__
+#define __X2600_SPL_H__
+
+#include <linux/types.h>
+
+int ad5x_emmc_init(void);
+int ad5x_emmc_read(u32 lba, u32 cnt, void *dst);
+
+void x2600_spl_clocks_init(void);
+int x2600_sdram_init(void);
+
+#endif
diff --git a/arch/mips/mach-jz47xx/x2600/spl_emmc.c b/arch/mips/mach-jz47xx/x2600/spl_emmc.c
new file mode 100644
index 00000000..5b385e4f
--- /dev/null
+++ b/arch/mips/mach-jz47xx/x2600/spl_emmc.c
@@ -0,0 +1,302 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic X2600 SPL: reading the eMMC on MSC0, a Synopsys DWC MSHC
+ * (SDHCI), by PIO. eMMC only: CMD0, CMD1, CMD2, CMD3, CMD7, 4-bit bus
+ * through CMD6, then CMD17/CMD18 with auto CMD12, at 25 MHz without the
+ * high-speed timing switch.
+ *
+ * The sequence follows the eMMC part of Ingenic's SPL driver for this SoC
+ * (U-Boot 2013.07 xburst2, common/spl/spl_jzsdhci.c), which Flashforge's
+ * SPL is built from. U-Boot's MMC and SDHCI drivers do the same in about
+ * five times the code, more than the boot ROM's SRAM window leaves room
+ * for (u-boot/README.md, "SPL memory").
+ *
+ * Copyright (c) 2013 Ingenic Semiconductor Co., Ltd.
+ */
+
+#include <asm/io.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/types.h>
+#include "spl.h"
+
+#define MSC0			((void __iomem *)0xb3450000)
+#define SD_BLOCKSIZE		0x04	/* 16 bit */
+#define SD_BLOCKCOUNT		0x06	/* 16 bit */
+#define SD_ARGUMENT		0x08
+#define SD_XFER_MODE		0x0c	/* 16 bit */
+#define  XFER_BLKCNT_EN		BIT(1)
+#define  XFER_AUTO_CMD12	BIT(2)
+#define  XFER_READ		BIT(4)
+#define  XFER_MULTI		BIT(5)
+#define SD_COMMAND		0x0e	/* 16 bit */
+#define  CMD_RESP_NONE		0x00
+#define  CMD_RESP_LONG		0x01
+#define  CMD_RESP_SHORT		0x02
+#define  CMD_RESP_BUSY		0x03
+#define  CMD_CRC		0x08
+#define  CMD_INDEX		0x10
+#define  CMD_DATA		0x20
+#define SD_RESPONSE		0x10
+#define SD_BUFFER		0x20
+#define SD_PRESENT_STATE	0x24
+#define  PS_CMD_INHIBIT		BIT(0)
+#define  PS_DAT_INHIBIT		BIT(1)
+#define SD_HOST_CONTROL		0x28	/* 8 bit */
+#define  HC_4BIT		BIT(1)
+#define SD_POWER_CONTROL	0x29	/* 8 bit */
+#define  PWR_ON			BIT(0)
+#define  PWR_180		(5 << 1)
+#define  PWR_300		(6 << 1)
+#define  PWR_330		(7 << 1)
+#define SD_CLOCK_CONTROL	0x2c	/* 16 bit */
+#define  CLK_INT_EN		BIT(0)
+#define  CLK_INT_STABLE		BIT(1)
+#define  CLK_CARD_EN		BIT(2)
+#define SD_TIMEOUT_CONTROL	0x2e	/* 8 bit */
+#define SD_SOFTWARE_RESET	0x2f	/* 8 bit */
+#define  RESET_ALL		BIT(0)
+#define  RESET_CMD		BIT(1)
+#define  RESET_DATA		BIT(2)
+#define SD_INT_STATUS		0x30
+#define  INT_CMD_DONE		BIT(0)
+#define  INT_XFER_DONE		BIT(1)
+#define  INT_BUF_RD		BIT(5)
+#define  INT_ERROR		BIT(15)
+#define SD_INT_ENABLE		0x34
+#define SD_SIGNAL_ENABLE	0x38
+#define SD_CAPABILITIES		0x40
+#define  CAP_VS33		BIT(24)
+#define  CAP_VS30		BIT(25)
+
+/* MSC0's card clock: CGU MSC0CDR, rate = parent / ((div + 1) * 4) */
+#define CPM_CLKGR0		((void __iomem *)0xb0000020)
+#define CLKGR0_MSC0		BIT(2)
+#define CPM_MSC0CDR		((void __iomem *)0xb0000068)
+#define CDR_PARENT_SHIFT	30
+#define CDR_PARENT_MPLL		1
+#define CDR_PARENT_EXCLK	2
+#define CDR_CE			BIT(29)
+#define CDR_BUSY		BIT(28)
+#define CDR_STOP		BIT(27)
+#define CDR_DIV_MASK		0xff
+
+#define EMMC_RCA		1
+#define EMMC_OCR		0x40ff8080	/* sector mode, 2.7-3.6 V, 1.7-1.95 V */
+#define OCR_BUSY		BIT(31)
+#define OCR_HCS			BIT(30)
+
+static int emmc_sector_mode;
+
+/*
+ * 0 when (register & mask) == want within usec. 8- and 16-bit registers
+ * are read through their aligned 32-bit word.
+ */
+static int wait_reg(u32 reg, u32 mask, u32 want, u32 usec)
+{
+	u32 t, sh = (reg & 3) * 8;
+
+	for (t = 0; ((readl(MSC0 + (reg & ~3)) >> sh) & mask) != want; t++) {
+		if (t >= usec)
+			return -ETIMEDOUT;
+		udelay(1);
+	}
+	return 0;
+}
+
+/* the status register once one of mask's bits is set; 0 on a timeout */
+static u32 wait_int(u32 mask, u32 usec)
+{
+	u32 st, t;
+
+	for (t = 0; !((st = readl(MSC0 + SD_INT_STATUS)) & mask); t++) {
+		if (t >= usec)
+			return 0;
+		udelay(1);
+	}
+	return st;
+}
+
+static int emmc_reset(u8 mask)
+{
+	writeb(mask, MSC0 + SD_SOFTWARE_RESET);
+	return wait_reg(SD_SOFTWARE_RESET, mask, 0, 100000);
+}
+
+/*
+ * The CGU feeds the card clock. Only the parent and divider fields change;
+ * the parent switches only while the clock is gated, and a new divider
+ * takes effect (busy clears) only while the controller runs the card clock
+ * (as in drivers/mmc/x2600_sdhci.c).
+ */
+static void emmc_set_clock(bool fast)
+{
+	u32 parent = fast ? CDR_PARENT_MPLL : CDR_PARENT_EXCLK;
+	/* 1800 MHz / (18 * 4) = 25 MHz; 24 MHz / (15 * 4) = 400 kHz */
+	u32 div = fast ? 17 : 14;
+	u32 val;
+
+	writew(0, MSC0 + SD_CLOCK_CONTROL);
+	val = readl(CPM_MSC0CDR);
+	if (((val >> CDR_PARENT_SHIFT) & 3) != parent) {
+		setbits_le32(CPM_CLKGR0, CLKGR0_MSC0);
+		val &= ~(3U << CDR_PARENT_SHIFT);
+		val |= parent << CDR_PARENT_SHIFT;
+		writel(val & ~CDR_CE, CPM_MSC0CDR);
+	}
+	clrbits_le32(CPM_CLKGR0, CLKGR0_MSC0);
+	val &= ~(CDR_DIV_MASK | CDR_STOP | CDR_BUSY);
+	writel(val | div | CDR_CE, CPM_MSC0CDR);
+
+	writew(CLK_INT_EN, MSC0 + SD_CLOCK_CONTROL);
+	wait_reg(SD_CLOCK_CONTROL, CLK_INT_STABLE, CLK_INT_STABLE, 20000);
+	writew(CLK_INT_EN | CLK_CARD_EN, MSC0 + SD_CLOCK_CONTROL);
+
+	for (val = 0; (readl(CPM_MSC0CDR) & CDR_BUSY) && val < 10000; val++)
+		udelay(1);
+	writel(readl(CPM_MSC0CDR) & ~CDR_CE, CPM_MSC0CDR);
+}
+
+/* one command; *resp gets the short response */
+static int emmc_cmd(u32 idx, u32 arg, u32 flags, u32 *resp)
+{
+	u32 inhibit = PS_CMD_INHIBIT, st;
+
+	if ((flags & CMD_DATA) || (flags & 3) == CMD_RESP_BUSY)
+		inhibit |= PS_DAT_INHIBIT;
+	if (wait_reg(SD_PRESENT_STATE, inhibit, 0, 100000))
+		return -EBUSY;
+
+	writel(~0U, MSC0 + SD_INT_STATUS);
+	writel(arg, MSC0 + SD_ARGUMENT);
+	writew(idx << 8 | flags, MSC0 + SD_COMMAND);
+
+	st = wait_int(INT_CMD_DONE | INT_ERROR, 100000);
+	if (!(st & INT_CMD_DONE) || (st & INT_ERROR))
+		goto err;
+	writel(INT_CMD_DONE, MSC0 + SD_INT_STATUS);
+	if (resp)
+		*resp = readl(MSC0 + SD_RESPONSE);
+
+	if ((flags & 3) == CMD_RESP_BUSY) {
+		st = wait_int(INT_XFER_DONE | INT_ERROR, 1000000);
+		if (!(st & INT_XFER_DONE) || (st & INT_ERROR))
+			goto err;
+		writel(INT_XFER_DONE, MSC0 + SD_INT_STATUS);
+	}
+	return 0;
+err:
+	emmc_reset(RESET_CMD | RESET_DATA);
+	return -EIO;
+}
+
+#define R1	(CMD_RESP_SHORT | CMD_CRC | CMD_INDEX)
+#define R1B	(CMD_RESP_BUSY | CMD_CRC | CMD_INDEX)
+#define R2	(CMD_RESP_LONG | CMD_CRC)
+#define R3	CMD_RESP_SHORT
+
+/* wait while the card is in its programming state (CMD13) */
+static int emmc_wait_ready(void)
+{
+	u32 st, t;
+
+	for (t = 0; t < 100000; t++) {
+		if (emmc_cmd(13, EMMC_RCA << 16, R1, &st))
+			return -EIO;
+		if (((st >> 9) & 15) != 7)	/* not prg */
+			return 0;
+		udelay(10);
+	}
+	return -ETIMEDOUT;
+}
+
+int ad5x_emmc_init(void)
+{
+	u32 caps, ocr = 0, t;
+
+	if (emmc_reset(RESET_ALL))
+		return -EIO;
+	writel(~0U, MSC0 + SD_INT_ENABLE);	/* latch every status bit */
+	writel(0, MSC0 + SD_SIGNAL_ENABLE);	/* no interrupts */
+	writeb(0xe, MSC0 + SD_TIMEOUT_CONTROL);
+	caps = readl(MSC0 + SD_CAPABILITIES);
+	caps = caps & CAP_VS33 ? PWR_330 : caps & CAP_VS30 ? PWR_300 : PWR_180;
+	writeb(caps, MSC0 + SD_POWER_CONTROL);
+	writeb(caps | PWR_ON, MSC0 + SD_POWER_CONTROL);
+	writeb(0, MSC0 + SD_HOST_CONTROL);	/* 1 bit, normal speed */
+	emmc_set_clock(false);
+	mdelay(1);				/* 74 clocks and more */
+
+	emmc_cmd(0, 0, CMD_RESP_NONE, NULL);
+	/* CMD1 until the card leaves busy: up to 1 s by the standard */
+	for (t = 0; t < 2000; t++) {
+		if (!emmc_cmd(1, EMMC_OCR, R3, &ocr) && (ocr & OCR_BUSY))
+			break;
+		udelay(1000);
+	}
+	if (!(ocr & OCR_BUSY))
+		return -ETIMEDOUT;
+	emmc_sector_mode = !!(ocr & OCR_HCS);
+
+	if (emmc_cmd(2, 0, R2, NULL) ||
+	    emmc_cmd(3, EMMC_RCA << 16, R1, NULL) ||
+	    emmc_cmd(7, EMMC_RCA << 16, R1, NULL))
+		return -EIO;
+
+	/* 4-bit bus: EXT_CSD[183] BUS_WIDTH = 1 */
+	if (emmc_cmd(6, 3 << 24 | 183 << 16 | 1 << 8, R1B, NULL) ||
+	    emmc_wait_ready())
+		return -EIO;
+	writeb(HC_4BIT, MSC0 + SD_HOST_CONTROL);
+	emmc_set_clock(true);
+	return 0;
+}
+
+static int emmc_read_chunk(u32 lba, u32 cnt, u32 *dst)
+{
+	u32 st, i;
+
+	writew(512, MSC0 + SD_BLOCKSIZE);
+	writew(cnt, MSC0 + SD_BLOCKCOUNT);
+	writew(XFER_BLKCNT_EN | XFER_READ |
+	       (cnt > 1 ? XFER_MULTI | XFER_AUTO_CMD12 : 0),
+	       MSC0 + SD_XFER_MODE);
+	if (emmc_cmd(cnt > 1 ? 18 : 17, emmc_sector_mode ? lba : lba * 512,
+		     R1 | CMD_DATA, NULL))
+		return -EIO;
+
+	while (cnt--) {
+		st = wait_int(INT_BUF_RD | INT_ERROR, 500000);
+		if (!(st & INT_BUF_RD) || (st & INT_ERROR))
+			goto err;
+		writel(INT_BUF_RD, MSC0 + SD_INT_STATUS);
+		for (i = 0; i < 128; i++)
+			*dst++ = readl(MSC0 + SD_BUFFER);
+	}
+	st = wait_int(INT_XFER_DONE | INT_ERROR, 500000);
+	if ((st & INT_XFER_DONE) && !(st & INT_ERROR)) {
+		writel(INT_XFER_DONE, MSC0 + SD_INT_STATUS);
+		return 0;
+	}
+err:
+	emmc_reset(RESET_CMD | RESET_DATA);
+	emmc_cmd(12, 0, R1B, NULL);
+	return -EIO;
+}
+
+/* cnt sectors from lba to dst (word aligned) */
+int ad5x_emmc_read(u32 lba, u32 cnt, void *dst)
+{
+	u32 n;
+
+	while (cnt) {
+		n = cnt > 2048 ? 2048 : cnt;
+		if (emmc_read_chunk(lba, n, dst))
+			return -EIO;
+		lba += n;
+		cnt -= n;
+		dst += n * 512;
+	}
+	return 0;
+}
diff --git a/arch/mips/mach-jz47xx/x2600/u-boot-spl.lds b/arch/mips/mach-jz47xx/x2600/u-boot-spl.lds
new file mode 100644
index 00000000..f2c3cad0
--- /dev/null
+++ b/arch/mips/mach-jz47xx/x2600/u-boot-spl.lds
@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Ingenic X2600 SPL: the boot ROM loads the image (a 2 KiB header, then
+ * this) to 0x80001000 and runs it at 0x80001800. Before the DDR is up only
+ * the SRAM window up to 0x80007000 exists for it (Ingenic's SPL keeps
+ * everything in the same 24 KiB): code, data, BSS and the stack, whose top
+ * is CONFIG_SPL_STACK. No heap. The checks below fail the link otherwise;
+ * u-boot/tools/ad5x_spl_image.py checks the boot ROM's load size.
+ */
+
+#define AD5X_SRAM_END		0x80007000
+#define AD5X_SPL_STACK_SIZE	0x800
+
+MEMORY { .sram : ORIGIN = IMAGE_TEXT_BASE, \
+		LENGTH = AD5X_SRAM_END - IMAGE_TEXT_BASE }
+
+OUTPUT_ARCH(mips)
+ENTRY(_start)
+SECTIONS
+{
+	. = ALIGN(4);
+	.text : {
+		__text_start = .;
+		*(.text*)
+		__text_end = .;
+	} > .sram
+
+	. = ALIGN(4);
+	.rodata : {
+		*(SORT_BY_ALIGNMENT(SORT_BY_NAME(.rodata*)))
+	} > .sram
+
+	. = ALIGN(4);
+	.data : {
+		*(SORT_BY_ALIGNMENT(.data*))
+		*(SORT_BY_ALIGNMENT(.sdata*))
+		. = ALIGN(8);
+	} > .sram
+
+	. = ALIGN(4);
+	__u_boot_list : {
+		KEEP(*(SORT(__u_boot_list*)));
+		. = ALIGN(8);
+	} > .sram
+
+	__image_copy_end = .;
+	__image_copy_len = __image_copy_end - __text_start;
+	_image_binary_end = .;
+
+	.bss (NOLOAD) : {
+		__bss_start = .;
+		*(.bss*)
+		*(.sbss*)
+		*(COMMON)
+		. = ALIGN(4);
+		__bss_end = .;
+	} > .sram
+
+	__ad5x_stack_bottom = AD5X_SRAM_END - AD5X_SPL_STACK_SIZE;
+
+	.mdebug.abi32 : {
+		KEEP(*(.mdebug.abi32))
+	}
+	.comment 0 : { *(.comment) }
+	.debug_aranges 0 : { *(.debug_aranges) }
+	.debug_pubnames 0 : { *(.debug_pubnames) }
+	.debug_info 0 : { *(.debug_info .gnu.linkonce.wi.*) }
+	.debug_abbrev 0 : { *(.debug_abbrev) }
+	.debug_line 0 : { *(.debug_line .debug_line.* .debug_line_end) }
+	.debug_frame 0 : { *(.debug_frame) }
+	.debug_str 0 : { *(.debug_str) }
+	.debug_loc 0 : { *(.debug_loc) }
+	.debug_macinfo 0 : { *(.debug_macinfo) }
+	.debug_pubtypes 0 : { *(.debug_pubtypes) }
+	.debug_ranges 0 : { *(.debug_ranges) }
+	.debug_addr 0 : { *(.debug_addr) }
+	.debug_line_str 0 : { *(.debug_line_str) }
+	.debug_loclists 0 : { *(.debug_loclists) }
+	.debug_rnglists 0 : { *(.debug_rnglists) }
+	.debug_str_offsets 0 : { *(.debug_str_offsets) }
+	.gnu.attributes 0 : { KEEP(*(.gnu.attributes)) }
+
+	/DISCARD/ : {
+		*(.MIPS.abiflags)
+		*(.MIPS.options)
+		*(.options)
+		*(.pdr)
+		*(.reginfo)
+		*(.eh_frame)
+	}
+}
+
+ASSERT(CONFIG_SPL_STACK == AD5X_SRAM_END,
+	"SPL: the stack must start at the top of the SRAM window")
+ASSERT(__bss_end <= __ad5x_stack_bottom,
+	"SPL: code, data and BSS run into the stack reserve (SRAM window)")
+ASSERT(__text_start == 0x80001800,
+	"SPL: the boot ROM starts the code at 0x80001800")
