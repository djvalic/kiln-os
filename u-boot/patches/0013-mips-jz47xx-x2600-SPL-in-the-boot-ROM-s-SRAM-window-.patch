index 69906d51..2231723d 100644
--- a/arch/mips/mach-jz47xx/include/mach/x2600.h
+++ b/arch/mips/mach-jz47xx/include/mach/x2600.h
@@ -1,8 +1,60 @@
 /* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Ingenic X2600 and the Flashforge Adventurer 5X: what the SPL and U-Boot
+ * proper share.
+ */
 #ifndef __MACH_X2600_H__
 #define __MACH_X2600_H__
 
+#include <linux/types.h>
+
+void x2600_uart0_plain_baud(void);
+
+/* the watchdog: up to about 1431 s; stop also stops its clock */
+#define X2600_WDT_MAX_MS	1431000U
 void x2600_wdt_start(unsigned int ms);
 void x2600_wdt_stop(void);
 
+/*
+ * CPM scratch pad (CPSPR, 0x10000034): kept over a watchdog reset, written
+ * only after the unlock word in CPSPPR. Linux writes 0x1a1a, 0x3535 or
+ * 0x4343 there when it reboots (soc-x2600/reset.c), Ingenic's SPLs use
+ * 0x4f5441/0x41544f; bits 18-22 are reserved. Kiln's values:
+ *
+ *   0x4b00 | stage << 4 | n   SPL attempt n (0-15) got to stage (0-3)
+ *   0x4b80                    SPL started U-Boot proper (from 0xA400)
+ *   0x4b81                    U-Boot proper is running
+ *
+ * Anything else: a fresh start (power on, a reboot from Linux).
+ */
+#define AD5X_CPSPR_TRY(stage, n)	(0x4b00 | ((stage) & 3) << 4 | ((n) & 15))
+#define AD5X_CPSPR_IS_TRY(v)		(((v) & ~0x3fU) == 0x4b00)
+#define AD5X_CPSPR_TRY_STAGE(v)		(((v) >> 4) & 3)
+#define AD5X_CPSPR_TRY_N(v)		((v) & 15)
+#define AD5X_CPSPR_HANDOFF		0x4b80
+#define AD5X_CPSPR_UBOOT_UP		0x4b81
+u32 x2600_cpspr_read(void);
+void x2600_cpspr_write(u32 val);
+
+/*
+ * The eMMC as the stock SPL sees it: its built-in partition table (the
+ * GPT agrees on every AD5X examined), 512-byte sectors.
+ */
+#define AD5X_KERNEL_A_LBA	0x800		/* "kernel", p1 */
+#define AD5X_ROOTFS_A_LBA	0x4800		/* "rootfs", p2 */
+#define AD5X_KERNEL_B_LBA	0x36800		/* "kernel2", p3 */
+#define AD5X_ROOTFS_B_LBA	0x3a800		/* "rootfs2", p4 */
+#define AD5X_OTA_LBA		0x6c800		/* "ota", p5 */
+#define AD5X_KERNEL_SECTORS	0x4000		/* 8 MiB per kernel slot */
+#define AD5X_FLAG_B		"ota:kernel2"
+#define AD5X_FLAG_A		"ota:kernel"
+
+/*
+ * U-Boot proper as a legacy uImage (ih_os U-Boot, load = entry =
+ * CONFIG_TEXT_BASE) where the SDK and the stock layout keep U-Boot: eMMC
+ * byte 0xA400, up to the end of the first MiB.
+ */
+#define AD5X_UBOOT_LBA		(0xa400 / 512)
+#define AD5X_UBOOT_MAX		(0x100000 - 0xa400)
+
 #endif
