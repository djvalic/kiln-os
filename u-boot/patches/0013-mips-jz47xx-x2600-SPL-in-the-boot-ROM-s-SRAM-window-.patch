+/*
+ * The parents of every CGU clock, as Ingenic's cgu_clks_set() sets them
+ * for this board's configuration (x2600_base: DDR and the peripherals from
+ * the MPLL, CGU_CLK_SRC LCD/MSC0/SFC from the MPLL, the PWM from the APLL,
+ * the CPU's PLL): only the parent field (31:30) changes. The DDR's parent
+ * numbering differs (0 none, 1 APLL, 2 MPLL).
+ */
+static const struct {
+	u16 cdr;
+	u8 parent;
+} x2600_cgu_parents[] = {
+	{ CPM_DDRCDR, 2 },	/* MPLL */
+	{ CPM_MACPHYCDR, 1 },	/* MPLL */
+	{ CPM_LPCDR, 1 },	/* MPLL */
+	{ CPM_MSC0CDR, 1 },	/* MPLL */
+	{ CPM_MSC1CDR, 1 },	/* MPLL */
+	{ CPM_SSICDR, 1 },	/* MPLL */
+	{ CPM_PWMCDR, 0 },	/* APLL */
+	{ CPM_SFCCDR, 1 },	/* MPLL */
+};
+
 static void x2600_clk_init(void)
 {
+	int i;
+	u32 v;
+
 	cpm_wr(cpm_rd(CPM_CLKGR0) & ~CLKGR0_EFUSE, CPM_CLKGR0);
 	cpm_wr(cpm_rd(CPM_CLKGR1) & ~CLKGR1_DDR, CPM_CLKGR1);
+	for (i = 0; i < ARRAY_SIZE(x2600_cgu_parents); i++) {
+		v = cpm_rd(x2600_cgu_parents[i].cdr) & ~(3U << 30);
+		cpm_wr(v | x2600_cgu_parents[i].parent << 30,
+		       x2600_cgu_parents[i].cdr);
+	}
 }
 
 /* DDR clock: MPLL (parent 2) / 2 = 900 MHz */
@@ -395,8 +418,8 @@ static void ddrp_set_drvodt(void)
