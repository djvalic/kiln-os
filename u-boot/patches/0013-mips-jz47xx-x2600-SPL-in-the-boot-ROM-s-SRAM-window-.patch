diff --git a/arch/mips/mach-jz47xx/x2600/spl.c b/arch/mips/mach-jz47xx/x2600/spl.c
new file mode 100644
index 00000000..17a42ef3
--- /dev/null
+++ b/arch/mips/mach-jz47xx/x2600/spl.c
@@ -0,0 +1,369 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic X2600 SPL for the Flashforge Adventurer 5X, where the boot ROM
+ * starts Flashforge's: loaded with its 2 KiB header to 0x80001000, code at
+ * 0x80001800, everything (code, data, BSS, stack) inside the SRAM window
+ * up to 0x80007000 (u-boot-spl.lds checks it at link time).
+ *
+ * It does what the stock SPL does, plus a second try:
+ *  1. pins (MSC0 on port D, UART0 on port E, as the stock SPL sets them),
+ *     console on UART0 (the DEBUG header), 115200 8N1;
+ *  2. the CPM scratch pad tells a fresh start from a second try after a
+ *     watchdog reset; the watchdog is armed for every stage;
+ *  3. clocks and DDR3 (sdram.c); not in the chainload-test build
+ *     (CONFIG_AD5X_SPL_CHAINLOAD), which runs from DDR under Linux;
+ *  4. the eMMC (spl_emmc.c);
+ *  5. U-Boot proper, when eMMC 0xA400 holds a U-Boot uImage with good
+ *     CRCs (header and data) that didn't fail to come up last time;
+ *  6. otherwise the stock SPL's boot: the slot the "ota" flag names, its
+ *     uImage (header and data CRCs checked) started with the stock SPL's
+ *     command line and the watchdog stopped, as the stock SPL leaves it.
+ *     On a second try after a failed load, the other slot.
+ * A failure resets the board through the watchdog for the next try; after
+ * AD5X_SPL_TRIES attempts the SPL stops, the watchdog off.
+ */
+
+#include <cpu_func.h>
+#include <hang.h>
+#include <image.h>
+#include <init.h>
+#include <serial.h>
+#include <spl.h>
+#include <asm/cache.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <asm/sections.h>
+#include <linux/bitops.h>
+#include <linux/string.h>
+#include <mach/x2600.h>
+#include "spl.h"
+
+DECLARE_GLOBAL_DATA_PTR;
+gd_t gdata __section(".bss");
+
+#define AD5X_SPL_TRIES		3
+#define AD5X_SPL_WDT_MS		10000	/* each SPL stage */
+#define AD5X_UBOOT_WDT_MS	30000	/* U-Boot proper to come up */
+
+enum { STAGE_DDR, STAGE_EMMC, STAGE_LOAD };
+
+#ifdef CONFIG_AD5X_SPL_CHAINLOAD
+/* the image tools refuse to make a boot ROM image from this build */
+static const char spl_kind[] = "KILN-SPL-CHAINLOAD-TEST-ONLY";
+#else
+static const char spl_kind[] = "boot ROM";
+#endif
+
+/* ---- pins, as the stock SPL sets them (its gpio_set_func calls) ---- */
+
+#define GPIO_PORT(n)		((void __iomem *)(0xb3601000 + (n) * 0x1000))
+#define PX_INTC			0x18
+#define PX_MSKC			0x28
+#define PX_PAT1S		0x34
+#define PX_PAT1C		0x38
+#define PX_PAT0S		0x44
+#define PX_PAT0C		0x48
+#define PX_PUS			0x84	/* port E: pull enable set */
+#define PX_PUC			0x88
+#define PX_PDS			0x94	/* port E: pull select up */
+#define PX_PDC			0x98
+#define PORT_D			3
+#define PORT_E			4
+
+static void x2600_spl_pins(void)
+{
+	void __iomem *pd = GPIO_PORT(PORT_D), *pe = GPIO_PORT(PORT_E);
+	u32 msc = 0xfff;	/* PD0-PD5 MSC0, PD6-PD11 (SFC) */
+	u32 uart = 0xf << 9;	/* PE9-PE12: UART0 */
+
+	/* function 0, no pull: the eMMC and the SDK's SFC group */
+	writel(msc, pd + PX_INTC);
+	writel(msc, pd + PX_MSKC);
+	writel(msc, pd + PX_PAT1C);
+	writel(msc, pd + PX_PAT0C);
+	writel(msc, pd + PX_PUC);
+	writel(msc, pd + PX_PDC);
+
+	/* function 1 with the pull-up */
+	writel(uart, pe + PX_INTC);
+	writel(uart, pe + PX_MSKC);
+	writel(uart, pe + PX_PAT1C);
+	writel(uart, pe + PX_PAT0S);
+	writel(uart, pe + PX_PUS);
+	writel(uart, pe + PX_PDS);
+}
+
+/* ---- console: UART0, 115200 from the 24 MHz EXCLK ---- */
+
+#define X2600_UART0		((void __iomem *)0xb0030000)
+#define UART_THR		0x00
+#define UART_DLL		0x00
+#define UART_IER		0x04
+#define UART_DLM		0x04
+#define UART_FCR		0x08
+#define UART_LCR		0x0c
+#define UART_LSR		0x14
+#define UART_FCR_FIFO		0x07	/* enable, clear RX and TX */
+#define UART_FCR_UME		0x10	/* Ingenic: the UART's enable bit */
+#define UART_LCR_8N1		0x03
+#define UART_LCR_DLAB		0x80
+#define UART_LSR_THRE		0x20
+#define UART_DIV_115200		13	/* 24 MHz / (16 * 13) = 115384 */
+
+static void x2600_spl_uart_init(void)
+{
+	writel(0, X2600_UART0 + UART_IER);
+	writel(UART_LCR_DLAB | UART_LCR_8N1, X2600_UART0 + UART_LCR);
+	writel(UART_DIV_115200, X2600_UART0 + UART_DLL);
+	writel(0, X2600_UART0 + UART_DLM);
+	writel(UART_LCR_8N1, X2600_UART0 + UART_LCR);
+	x2600_uart0_plain_baud();
+	writel(UART_FCR_FIFO | UART_FCR_UME, X2600_UART0 + UART_FCR);
+}
+
+static void x2600_spl_putc(const char c)
+{
+	if (c == '\n')
+		x2600_spl_putc('\r');
+	while (!(readl(X2600_UART0 + UART_LSR) & UART_LSR_THRE))
+		;
+	writel(c, X2600_UART0 + UART_THR);
+}
+
+static void x2600_spl_puts(const char *s)
+{
+	while (*s)
+		x2600_spl_putc(*s++);
+}
+
+static int x2600_spl_serial_start(void) { return 0; }
+static int x2600_spl_serial_stop(void) { return 0; }
+static void x2600_spl_setbrg(void) { }
+static int x2600_spl_getc(void) { return 0; }
+static int x2600_spl_tstc(void) { return 0; }
+
+static struct serial_device x2600_spl_serial = {
+	.name	= "x2600-uart0",
+	.start	= x2600_spl_serial_start,
+	.stop	= x2600_spl_serial_stop,
+	.setbrg	= x2600_spl_setbrg,
+	.putc	= x2600_spl_putc,
+	.puts	= x2600_spl_puts,
+	.getc	= x2600_spl_getc,
+	.tstc	= x2600_spl_tstc,
+};
+
+struct serial_device *default_serial_console(void)
+{
+	return &x2600_spl_serial;
+}
+
+/* ---- the second try ---- */
+
+static unsigned int attempt;
+
+/* record how far this attempt got, so a reset by the watchdog tells */
+static void spl_stage(int stage)
+{
+	x2600_cpspr_write(AD5X_CPSPR_TRY(stage, attempt));
+	x2600_wdt_start(AD5X_SPL_WDT_MS);
+}
+
+static void __noreturn spl_fail(int stage, const char *why)
+{
+	printf("SPL: %s; attempt %u of %u failed\n", why, attempt + 1,
+	       AD5X_SPL_TRIES);
+	x2600_cpspr_write(AD5X_CPSPR_TRY(stage, attempt));
+	x2600_wdt_start(10);
+	while (1)
+		;
+}
+
+/* ---- uImages ---- */
+
+/* CRC-32 (IEEE), a nibble at a time: 64 bytes of table */
+static u32 spl_crc32(u32 crc, const u8 *p, u32 len)
+{
+	static const u32 t[16] = {
+		0x00000000, 0x1db71064, 0x3b6e20c8, 0x26d930ac,
+		0x76dc4190, 0x6b6b51f4, 0x4db26158, 0x5005713c,
+		0xedb88320, 0xf00f9344, 0xd6d6a3e8, 0xcb61b38c,
+		0x9b64c2b0, 0x86d3d2d4, 0xa00ae278, 0xbdbdf21c,
+	};
+
+	crc = ~crc;
+	while (len--) {
+		crc ^= *p++;
+		crc = (crc >> 4) ^ t[crc & 15];
+		crc = (crc >> 4) ^ t[crc & 15];
+	}
+	return ~crc;
+}
+
+static u8 spl_sector[512] __aligned(4);
+
+/*
+ * Load the uImage at @lba (at most @max bytes with its header) to its load
+ * address; return its entry point, 0 if it isn't good. Accepted: MIPS,
+ * ih_os @os (a U-Boot wrapped for a kernel slot is ih_os Linux too),
+ * header and data CRCs right, loaded between the SRAM window and the
+ * ramoops region (0x0EB00000), entry point inside the image.
+ */
+static ulong spl_load_uimage(u32 lba, ulong max, u8 os)
+{
+	struct legacy_img_hdr *hdr = (void *)spl_sector, h;
+	ulong size, load, ep, blocks;
+
+	if (ad5x_emmc_read(lba, 1, spl_sector) ||
+	    image_get_magic(hdr) != IH_MAGIC)
+		return 0;
+	h = *hdr;
+	h.ih_hcrc = 0;
+	size = image_get_size(hdr);
+	load = image_get_load(hdr);
+	ep = image_get_ep(hdr);
+	if (spl_crc32(0, (u8 *)&h, sizeof(h)) != image_get_hcrc(hdr) ||
+	    image_get_arch(hdr) != IH_ARCH_MIPS || image_get_os(hdr) != os ||
+	    size + sizeof(h) > max || (load & 3) ||
+	    load - sizeof(h) < 0x80008000 ||
+	    load + size + 512 > 0x8eb00000 || ep < load || ep >= load + size) {
+		printf("SPL: LBA 0x%x: not a usable uImage\n", lba);
+		return 0;
+	}
+	printf("SPL: %.32s, %lu bytes at 0x%lx\n", (char *)hdr->ih_name, size,
+	       load);
+	blocks = (size + sizeof(h) + 511) / 512;
+	if (ad5x_emmc_read(lba, blocks, (void *)(load - sizeof(h))))
+		return 0;
+	if (spl_crc32(0, (u8 *)load, size) != image_get_dcrc(&h)) {
+		puts("SPL: data CRC wrong\n");
+		return 0;
+	}
+	flush_cache(load - sizeof(h), blocks * 512);
+	return ep;
+}
+
+/* the stock SPL's command line (lpj as the stock SPL passes it) */
+#define AD5X_ARGS	"console=ttyS0,115200n8 loglevel=8 mem=236M@0x0 " \
+			"rmem=16M@0xec00000 rtos_size=4M@0xfc00000 " \
+			"mem=256M@0x30000000 init=/linuxrc root=/dev/mmcblk0pX " \
+			"rootwait rootfstype=squashfs ro lpj=11935744"
+#define AD5X_MAX_ARGS	16
+
+static char spl_args[sizeof(AD5X_ARGS)];
+static char *spl_argv[AD5X_MAX_ARGS + 1];
+
+/* split spl_args in place into spl_argv[1..], argv[0] being "spl" */
+static int ad5x_build_argv(char root)
+{
+	char *p;
+	int argc = 0;
+
+	strcpy(spl_args, AD5X_ARGS);
+	p = strstr(spl_args, "mmcblk0pX");
+	p[8] = root;
+
+	spl_argv[argc++] = "spl";
+	for (p = spl_args; *p && argc < AD5X_MAX_ARGS; ) {
+		spl_argv[argc++] = p;
+		while (*p && *p != ' ')
+			p++;
+		if (*p)
+			*p++ = '\0';
+	}
+	spl_argv[argc] = NULL;
+	return argc;
+}
+
+typedef void __noreturn (*entry_t)(int, char **, char **, int);
+
+static void __noreturn ad5x_boot(int uboot_failed, int other_slot)
+{
+	ulong ep;
+	int slot_b, argc;
+
+	spl_stage(STAGE_EMMC);
+	if (ad5x_emmc_init())
+		spl_fail(STAGE_EMMC, "eMMC init failed");
+
+	spl_stage(STAGE_LOAD);
+	if (uboot_failed) {
+		puts("SPL: U-Boot proper didn't come up last time: slot\n");
+	} else {
+		ep = spl_load_uimage(AD5X_UBOOT_LBA, AD5X_UBOOT_MAX,
+				     IH_OS_U_BOOT);
+		if (ep) {
+			x2600_cpspr_write(AD5X_CPSPR_HANDOFF);
+			x2600_wdt_start(AD5X_UBOOT_WDT_MS);
+			puts("SPL: starting U-Boot proper\n");
+			((entry_t)ep)(0, NULL, NULL, 0);
+		}
+		puts("SPL: no U-Boot at 0xA400: the slot, as the stock SPL\n");
+	}
+
+	if (ad5x_emmc_read(AD5X_OTA_LBA, 1, spl_sector))
+		spl_fail(STAGE_LOAD, "can't read the boot flag");
+	slot_b = !strncmp((char *)spl_sector, AD5X_FLAG_B,
+			  strlen(AD5X_FLAG_B));
+	if (other_slot) {
+		puts("SPL: the slot failed to load last time: the other one\n");
+		slot_b = !slot_b;
+	}
+	printf("SPL: slot %c\n", slot_b ? 'b' : 'a');
+	ep = spl_load_uimage(slot_b ? AD5X_KERNEL_B_LBA : AD5X_KERNEL_A_LBA,
+			     AD5X_KERNEL_SECTORS * 512, IH_OS_LINUX);
+	if (!ep)
+		spl_fail(STAGE_LOAD, "no good uImage in the slot");
+
+	/* as the stock SPL hands over: watchdog stopped */
+	argc = ad5x_build_argv(slot_b ? '4' : '2');
+	x2600_wdt_stop();
+	x2600_cpspr_write(0);
+	puts("SPL: starting the kernel\n");
+	((entry_t)ep)(argc, spl_argv, NULL, 0);
+}
+
+void board_init_f(ulong dummy)
+{
+	u32 prev;
+	int uboot_failed = 0, other_slot = 0;
+
+	gd = &gdata;
+	memset(__bss_start, 0, (size_t)__bss_end - (size_t)__bss_start);
+
+	x2600_spl_pins();
+	x2600_spl_uart_init();
+	timer_init();
+	mips_cache_probe();
+	gd->flags |= GD_FLG_SPL_INIT;
+	preloader_console_init();
+	printf("SPL: %s\n", spl_kind);
+
+	prev = x2600_cpspr_read();
+	if (AD5X_CPSPR_IS_TRY(prev)) {
+		attempt = AD5X_CPSPR_TRY_N(prev) + 1;
+		other_slot = AD5X_CPSPR_TRY_STAGE(prev) == STAGE_LOAD;
+		printf("SPL: attempt %u stopped at stage %u: trying again\n",
+		       attempt, AD5X_CPSPR_TRY_STAGE(prev));
+	} else if (prev == AD5X_CPSPR_HANDOFF || prev == AD5X_CPSPR_UBOOT_UP) {
+		attempt = 1;
+		uboot_failed = 1;
+	}
+	if (attempt >= AD5X_SPL_TRIES) {
+		x2600_wdt_stop();
+		x2600_cpspr_write(0);
+		printf("SPL: %u attempts failed: stopped (power cycle to retry)\n",
+		       attempt);
+		hang();
+	}
+
+	spl_stage(STAGE_DDR);
+#ifndef CONFIG_AD5X_SPL_CHAINLOAD
+	x2600_spl_clocks_init();
+	if (x2600_sdram_init())
+		spl_fail(STAGE_DDR, "DDR training failed");
+#else
+	puts("SPL: chainload test build: clocks and DDR as Linux left them\n");
+#endif
+	ad5x_boot(uboot_failed, other_slot);
+}
diff --git a/arch/mips/mach-jz47xx/x2600/spl.h b/arch/mips/mach-jz47xx/x2600/spl.h
