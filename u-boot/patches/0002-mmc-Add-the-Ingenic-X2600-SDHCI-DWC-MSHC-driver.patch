index a07a369d..7ba34210 100644
--- a/configs/ad5x_defconfig
+++ b/configs/ad5x_defconfig
@@ -21,3 +21,12 @@ CONFIG_VERSION_VARIABLE=y
 CONFIG_ENV_IS_NOWHERE=y
 CONFIG_DM_SERIAL=y
 CONFIG_SYS_NS16550=y
+CONFIG_CMD_MMC=y
