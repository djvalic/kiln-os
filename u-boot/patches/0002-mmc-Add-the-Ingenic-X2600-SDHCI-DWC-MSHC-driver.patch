From e390cef8f8c85dfa9c609f08c404cd4e6b793153 Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Sat, 14 Nov 2026 15:01:21 -0700
Subject: [PATCH 02/10] mmc: Add the Ingenic X2600 SDHCI (DWC MSHC) driver

The X2600's MSC controllers are Synopsys DWC MSHC cores whose card clock
comes from the CGU: the SDCLK frequency select bits have no effect, so
the clock is set in the controller's CGU divider (MSCnCDR). Only the
parent and divider fields change; the parent switches while the clock is
gated, the divider while it runs.

Enable it for the Adventurer 5X's eMMC (MSC0), 4-bit at 50 MHz, in PIO
mode, with eMMC writes left out for now.

Signed-off-by: Hunter Laux <hunterlaux@gmail.com>
---
 arch/mips/dts/ad5x.dts    |  16 ++++
 configs/ad5x_defconfig    |   9 ++
 drivers/mmc/Kconfig       |   9 ++
 drivers/mmc/Makefile      |   1 +
 drivers/mmc/x2600_sdhci.c | 176 ++++++++++++++++++++++++++++++++++++++
 5 files changed, 211 insertions(+)
 create mode 100644 drivers/mmc/x2600_sdhci.c

diff --git a/arch/mips/dts/ad5x.dts b/arch/mips/dts/ad5x.dts
index 416b90eb..bb0a3ca7 100644
--- a/arch/mips/dts/ad5x.dts
+++ b/arch/mips/dts/ad5x.dts
@@ -12,6 +12,7 @@
 	model = "Flashforge Adventurer 5X";
 
 	aliases {
+		mmc0 = &msc0;
 		serial0 = &uart0;
 	};
 
@@ -39,5 +40,20 @@
 			clock-frequency = <24000000>;
 			bootph-all;
 		};
+
+		/*
+		 * MSC0, the eMMC. 4-bit: the SPL sets up only PD0-PD5 (the
+		 * 4-bit group). 50 MHz, as Kiln's kernels run it.
+		 */
+		msc0: mmc@13450000 {
+			compatible = "ingenic,x2600-dwcmshc";
+			reg = <0x13450000 0x10000>;
+			ingenic,msc-id = <0>;
+			bus-width = <4>;
+			max-frequency = <50000000>;
+			non-removable;
+			no-sd;
+			no-sdio;
+		};
 	};
 };
