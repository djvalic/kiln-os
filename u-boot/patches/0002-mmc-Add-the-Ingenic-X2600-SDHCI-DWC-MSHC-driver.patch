index f9f7aa5c..e4ccf720 100644
--- a/drivers/mmc/Kconfig
+++ b/drivers/mmc/Kconfig
@@ -302,6 +302,15 @@ config MMC_SDHCI_ADI
 	  This enables support for the SD/MMC controller included in some Analog
 	  Devices SC5XX Socs.
 
+config MMC_SDHCI_X2600
