@@ -139,6 +280,245 @@ int board_late_init(void)
 	return 0;
 }
 
+/* ---- the watchdog over the jump to a kernel ---- */
+
+/*
+ * By default the kernel starts with the watchdog stopped, as both SPLs
+ * leave it: neither kernel's driver knows U-Boot started it, nothing would
+ * feed it before a userspace feeder, and poweroff wouldn't stop it, so a
+ * printer shut down from the screen would restart. wdt_os=SECONDS (opt-in,
+ * for when the kernels and userspace take it over, README) starts the OS
+ * with it running and passes ad5x.wdt=SECONDS.
+ */
+void board_preboot_os(void)
+{
+	ulong s = env_get_ulong("wdt_os", 10, 0);
+
+	if (s)
+		x2600_wdt_start(s * 1000);
+	else
+		x2600_wdt_stop();
+	x2600_cpspr_write(0);
+}
+
+/* ---- the start ---- */
+
+static int ad5x_read_records(struct ad5x_inputs *in)
+{
+	char buf[AD5X_REC_SIZE] __aligned(ARCH_DMA_MINALIGN);
+
+	if (ad5x_read_sector(AD5X_STATE_LBA, buf) ||
+	    ad5x_state_parse(buf, &in->state))
+		memset(&in->state, 0, sizeof(in->state));
+	if (ad5x_read_sector(AD5X_RECORDS_LBA, buf) ||
+	    ad5x_records_parse(buf, &in->rec))
+		memset(&in->rec, 0, sizeof(in->rec));
+	return 0;
+}
+
+static void ad5x_gather(struct ad5x_inputs *in)
+{
+	const char *slot = ad5x_read_slot();
+
+	memset(in, 0, sizeof(*in));
+	in->flag_b = slot && *slot == 'b';
+	ad5x_read_records(in);
+
+	/* /data: p7, ext4 */
+	in->data_ok = !fs_set_blk_dev("mmc", "0:7", FS_TYPE_EXT);
+	if (in->data_ok) {
+		in->mainline_wanted = ad5x_exists(7, "/ad5x/kernel/mainline");
+		in->after_install =
+			ad5x_exists(7, "/ad5x/install/recovery.squashfs");
+		ad5x_line(7, "/ad5x/kernel/failed", in->s00_failed,
+			  AD5X_REL_LEN);
+		ad5x_line(7, "/ad5x/kernel/failed-mainline",
+			  in->s00_failed_mainline, AD5X_REL_LEN);
+	}
+
+	/* rootfs2: p4, SquashFS */
+	in->have_66 = ad5x_exists(4, "/usr/lib/ad5x/kernel66/xImage");
+	ad5x_line(4, "/usr/lib/ad5x/kernel66/release", in->rel_66,
+		  AD5X_REL_LEN);
+	in->have_73 = ad5x_exists(4, "/usr/lib/ad5x/kernel-mainline/xImage");
+	ad5x_line(4, "/usr/lib/ad5x/kernel-mainline/release", in->rel_73,
+		  AD5X_REL_LEN);
+
+	/* slot A, and p1's kernel for the main OS too */
+	in->stock_kernel_ok = ad5x_check_kernel(AD5X_KERNEL_A_LBA, AD5X_LOAD_A);
+	in->slot_a_ok = in->stock_kernel_ok &&
+			ad5x_squashfs_at(AD5X_ROOTFS_A_LBA);
+}
+
+static void ad5x_print(const struct ad5x_inputs *in)
+{
+	printf("ad5x: flag %s; state: %u tries, last %s %s; records: own "
+	       "%s, mainline %s\n", in->flag_b ? "b" : "a", in->state.tries,
+	       ad5x_kernel_name(in->state.kernel), in->state.release,
+	       in->rec.failed_own[0] ? in->rec.failed_own : "-",
+	       in->rec.failed_mainline[0] ? in->rec.failed_mainline : "-");
+	printf("ad5x: /data %s (mainline %s, after install %s, S00 failed "
+	       "%s/%s); rootfs2 6.6 %s %s, 7.3 %s %s; slot A %s, p1 %s\n",
+	       in->data_ok ? "ok" : "unread", in->mainline_wanted ? "on" : "off",
+	       in->after_install ? "yes" : "no",
+	       in->s00_failed[0] ? in->s00_failed : "-",
+	       in->s00_failed_mainline[0] ? in->s00_failed_mainline : "-",
+	       in->have_66 ? "yes" : "no", in->rel_66,
+	       in->have_73 ? "yes" : "no", in->rel_73,
+	       in->slot_a_ok ? "ok" : "not startable",
+	       in->stock_kernel_ok ? "ok" : "no kernel");
+}
+
+static int ad5x_commit(const struct ad5x_decision *d)
+{
+	char buf[AD5X_REC_SIZE] __aligned(ARCH_DMA_MINALIGN);
+	int ret = 0;
+
+	if (!ad5x_layout_ok()) {
+		printf("ad5x: layout not as expected: nothing written\n");
+		return -EIO;
+	}
+	if (d->rec_changed) {
+		ad5x_records_format(&d->rec, buf);
+		ret |= ad5x_write_sector(AD5X_RECORDS_LBA, buf);
+	}
+	if (d->state_changed) {
+		ad5x_state_format(&d->state, buf);
+		ret |= ad5x_write_sector(AD5X_STATE_LBA, buf);
+	}
+	if (d->write_flag)
+		ret |= ad5x_write_slot(d->write_flag > 0 ? 'a' : 'b');
+	if (ret)
+		printf("ad5x: writing to ota failed\n");
+	return ret;
+}
+
+static void ad5x_bootargs(const char *root, int own)
+{
+	char extra[256] = "";
+	char *args;
+	long len;
+
+	if (own) {
+		/* as S00ad5x-kernel adds: cmdline-extra comes last */
+		ad5x_small(7, "/ad5x/kernel/cmdline-extra", extra,
+			   sizeof(extra));
+		for (len = 0; extra[len]; len++)
+			if (extra[len] == '\n' || extra[len] == '\r' ||
+			    extra[len] == '\t')
+				extra[len] = ' ';
+	}
+	args = malloc(CONFIG_SYS_CBSIZE);
+	if (!args)
+		return;
+	snprintf(args, CONFIG_SYS_CBSIZE, "%s root=%s%s ad5x.uboot=1%s%s %s",
+		 env_get("args_spl"), root,
+		 own ? " ad5x.kernel=own panic=10 loglevel=5" : "",
+		 env_get_ulong("wdt_os", 10, 0) ? " ad5x.wdt=" : "",
+		 env_get_ulong("wdt_os", 10, 0) ? env_get("wdt_os") : "",
+		 extra);
+	env_set("bootargs", args);
+	free(args);
+}
+
+static void ad5x_bootm(ulong addr)
+{
+	char cmd[32];
+
+	snprintf(cmd, sizeof(cmd), "bootm 0x%lx", addr);
+	run_command(cmd, 0);	/* returns only when it failed */
+}
+
+static void ad5x_to_prompt(const char *why)
+{
+	x2600_wdt_stop();
+	x2600_cpspr_write(0);
+	printf("ad5x: %s: U-Boot prompt, watchdog off\n", why);
+}
+
+/* the U-Boot prompt when a key comes within ad5x_delay seconds */
+static int ad5x_wait_key(void)
+{
+	ulong s = env_get_ulong("ad5x_delay", 10, 2), ms;
+
+	if (!s)
+		return 0;
+	printf("ad5x: any key within %lu s for the U-Boot prompt\n", s);
+	for (ms = 0; ms < s * 1000; ms += 10) {
+		if (tstc()) {
+			getchar();
+			return 1;
+		}
+		mdelay(10);
+	}
+	return 0;
+}
+
+static int do_ad5x_boot(struct cmd_tbl *cmdtp, int flag, int argc,
+			char *const argv[])
+{
+	struct ad5x_inputs in;
+	struct ad5x_decision d;
+	int dry = argc > 1 && !strcmp(argv[1], "-n");
+	int round;
+	long len;
+
+	if (!dry && ad5x_wait_key()) {
+		ad5x_to_prompt("key pressed");
+		return CMD_RET_SUCCESS;
+	}
+	ad5x_gather(&in);
+	ad5x_print(&in);
+
+	/* a kernel that can't even be loaded is left out, and decided again */
+	for (round = 0; round < 4; round++) {
+		ad5x_decide(&in, &d);
+		printf("ad5x: %s\n", d.msg);
+		if (dry)
+			return CMD_RET_SUCCESS;
+		if (d.target == AD5X_BOOT_PROMPT)
+			break;
+		ad5x_commit(&d);
+
+		if (d.target == AD5X_BOOT_RECOVERY) {
+			ad5x_bootargs("/dev/mmcblk0p2", 0);
+			ad5x_bootm(AD5X_LOAD_A);
+			in.slot_a_ok = in.stock_kernel_ok = 0;
+		} else if (d.kernel == AD5X_K_STOCK) {
+			ad5x_bootargs("/dev/mmcblk0p4", 0);
+			ad5x_bootm(AD5X_LOAD_A);
+			in.stock_kernel_ok = in.slot_a_ok = 0;
+		} else {
+			const char *path = d.kernel == AD5X_K_73 ?
+				"/usr/lib/ad5x/kernel-mainline/xImage" :
+				"/usr/lib/ad5x/kernel66/xImage";
+
+			len = ad5x_load(4, path, AD5X_LOAD_MAIN,
+					AD5X_KERNEL_MAX);
+			if (len > 0) {
+				ad5x_bootargs("/dev/mmcblk0p4", 1);
+				ad5x_bootm(AD5X_LOAD_MAIN);
+			}
+			printf("ad5x: %s didn't start\n", path);
+			if (d.kernel == AD5X_K_73)
+				in.have_73 = 0;
+			else
+				in.have_66 = 0;
+		}
+		/* the state written counts this attempt: start from it */
+		in.state = d.state;
+		in.rec = d.rec;
+		in.flag_b = d.write_flag ? d.write_flag < 0 : in.flag_b;
+	}
+	ad5x_to_prompt("nothing could be started");
+	return CMD_RET_FAILURE;
+}
+
+U_BOOT_CMD(ad5x_boot, 2, 0, do_ad5x_boot,
+	   "start the main or the recovery OS (u-boot/README.md)",
+	   "    - as at power on\n"
+	   "ad5x_boot -n - only show what it would start and why");
+
 /* ad5x_flag [a|b]: show the boot flag, or set it for the next start */
