diff --git a/board/flashforge/ad5x/bootlogic.c b/board/flashforge/ad5x/bootlogic.c
new file mode 100644
index 00000000..44805eda
--- /dev/null
+++ b/board/flashforge/ad5x/bootlogic.c
@@ -0,0 +1,423 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Flashforge Adventurer 5X: which system and kernel U-Boot starts, and the
+ * text records in "ota" it keeps for that (bootlogic.h). No U-Boot headers:
+ * tools/test_bootlogic.py builds this file on the build host.
+ *
+ * Rules (u-boot/README.md, "Boot rules"):
+ *
+ * - Flag on slot A: start the recovery OS if slot A is startable (p1 a
+ *   uImage with good header and data CRCs that isn't U-Boot, p2 starting
+ *   with "hsqs"); that start also gives the main OS fresh tries (the state
+ *   is cleared). Slot A not startable: start the main OS and point the flag
+ *   at slot B, so the flag tells the truth.
+ * - Flag on slot B, the main OS: the state counts its unconfirmed starts
+ *   and the kernel of the last one. Kernel order as S00ad5x-kernel's:
+ *   mainline 7.3 when /data/ad5x/kernel/mainline exists (not on the first
+ *   start after an install, not when its release failed), else Kiln's 6.6
+ *   (unless its release failed), else the printer's stock kernel from p1.
+ *   - one unconfirmed 7.3 start: 7.3's release is recorded as failed and
+ *     this start uses 6.6 (S00: "this boot goes on to 6.6 at once");
+ *   - two unconfirmed 6.6 starts in a row (one on the first start after an
+ *     install): 6.6's release is recorded as failed, the stock kernel next;
+ *   - two unconfirmed stock-kernel starts in a row, or no kernel at all:
+ *     fall back to the recovery OS: flag to slot A ("ota:kernel"), state
+ *     cleared, the reason recorded. If slot A isn't startable either, the
+ *     main OS is started again (never a loop on a broken slot A), or with
+ *     nothing startable at all U-Boot stays at its prompt.
+ *   S00ad5x-kernel's own records on /data (failed, failed-mainline) count
+ *   as U-Boot's. A record naming another release than the one installed
+ *   is dropped (an update), as S00 does.
+ * - Counts saturate at AD5X_MAX_TRIES; a record that doesn't parse or has
+ *   a bad CRC32 counts as empty: never a reason to fall back.
+ */
+
+#include <stdio.h>
+#ifdef __UBOOT__	/* U-Boot's build; not the host test's */
+#include <linux/string.h>
+#else
+#include <string.h>
+#endif
+#include "bootlogic.h"
+
+#define STATE_MAGIC	"kiln-uboot-state 1\n"
+#define RECORDS_MAGIC	"kiln-uboot-records 1\n"
+
+unsigned int ad5x_crc32(unsigned int crc, const void *buf, unsigned int len)
+{
+	const unsigned char *p = buf;
+	int k;
+
+	crc = ~crc;
+	while (len--) {
+		crc ^= *p++;
+		for (k = 0; k < 8; k++)
+			crc = (crc >> 1) ^ (0xedb88320 & -(crc & 1));
+	}
+	return ~crc;
+}
+
+const char *ad5x_kernel_name(enum ad5x_kernel k)
+{
+	switch (k) {
+	case AD5X_K_66:
+		return "66";
+	case AD5X_K_73:
+		return "73";
+	case AD5X_K_STOCK:
+		return "stock";
+	default:
+		return "none";
+	}
+}
+
+static enum ad5x_kernel kernel_from_name(const char *s)
+{
+	if (!strcmp(s, "66"))
+		return AD5X_K_66;
+	if (!strcmp(s, "73"))
+		return AD5X_K_73;
+	if (!strcmp(s, "stock"))
+		return AD5X_K_STOCK;
+	return AD5X_K_NONE;
+}
+
+static int safe_char(char c)
+{
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+	       (c >= '0' && c <= '9') || c == '.' || c == '-' || c == '_' ||
+	       c == '+' || c == '~' || c == ':';
+}
+
+void ad5x_release_clean(char *dst, const char *src, unsigned int len)
+{
+	unsigned int i;
+
+	for (i = 0; i + 1 < len && src[i] && src[i] != '\n' && src[i] != '\r';
+	     i++)
+		dst[i] = safe_char(src[i]) ? src[i] : '_';
+	dst[i] = '\0';
+}
+
+/* reason text: printable, no newlines */
+static void text_clean(char *dst, const char *src, unsigned int len)
+{
+	unsigned int i;
+
+	for (i = 0; i + 1 < len && src[i]; i++)
+		dst[i] = (src[i] >= ' ' && src[i] <= '~') ? src[i] : ' ';
+	dst[i] = '\0';
+}
+
+static unsigned int parse_uint(const char *s)
+{
+	unsigned int v = 0;
+
+	while (*s >= '0' && *s <= '9') {
+		if (v < 100000)
+			v = v * 10 + (*s - '0');
+		s++;
+	}
+	return v;
+}
+
+static void finish(char *buf, unsigned int n)
+{
+	unsigned int crc = ad5x_crc32(0, buf, n);
+
+	snprintf(buf + n, AD5X_REC_SIZE - n, "crc32 %08x\n", crc);
+}
+
+void ad5x_state_format(const struct ad5x_state *st, char *buf)
+{
+	int n;
+
+	memset(buf, 0, AD5X_REC_SIZE);
+	n = snprintf(buf, AD5X_REC_SIZE,
+		     STATE_MAGIC "tries %u\nkernel %s\nrelease %s\n",
+		     st->tries, ad5x_kernel_name(st->kernel),
+		     st->release[0] ? st->release : "-");
+	finish(buf, n);
+}
+
+void ad5x_records_format(const struct ad5x_records *rec, char *buf)
+{
+	int n;
+
+	memset(buf, 0, AD5X_REC_SIZE);
+	n = snprintf(buf, AD5X_REC_SIZE,
+		     RECORDS_MAGIC "failed-own %s\nfailed-mainline %s\n"
+		     "fallbacks %u\nreason %s\n",
+		     rec->failed_own[0] ? rec->failed_own : "-",
+		     rec->failed_mainline[0] ? rec->failed_mainline : "-",
+		     rec->fallbacks, rec->reason[0] ? rec->reason : "-");
+	finish(buf, n);
+}
+
+/*
+ * Walk the "key value" lines after @magic up to the crc32 line; call @fn
+ * for each. 0 when the sector parses and its CRC32 matches.
+ */
+static int parse(const char *buf, const char *magic,
+		 void (*fn)(void *obj, const char *key, const char *val),
+		 void *obj)
+{
+	char line[AD5X_REASON_LEN + 32];
+	unsigned int pos, len, crc, i;
+	const char *sp;
+
+	len = strlen(magic);
+	if (strncmp(buf, magic, len))
+		return -1;
+	for (pos = len; pos < AD5X_REC_SIZE && buf[pos];) {
+		for (i = pos; i < AD5X_REC_SIZE && buf[i] && buf[i] != '\n'; i++)
+			;
+		if (i >= AD5X_REC_SIZE || buf[i] != '\n' ||
+		    i - pos >= sizeof(line))
+			return -1;
+		memcpy(line, buf + pos, i - pos);
+		line[i - pos] = '\0';
+		sp = strchr(line, ' ');
+		if (!sp)
+			return -1;
+		if (!strncmp(line, "crc32 ", 6)) {
+			crc = 0;
+			for (sp = line + 6; *sp; sp++) {
+				if (*sp >= '0' && *sp <= '9')
+					crc = crc << 4 | (*sp - '0');
+				else if (*sp >= 'a' && *sp <= 'f')
+					crc = crc << 4 | (*sp - 'a' + 10);
+				else
+					return -1;
+			}
+			return crc == ad5x_crc32(0, buf, pos) ? 0 : -1;
+		}
+		line[sp - line] = '\0';
+		fn(obj, line, sp + 1);
+		pos = i + 1;
+	}
+	return -1;	/* no crc32 line */
+}
+
+static void copy_val(char *dst, const char *val, unsigned int len)
+{
+	if (!strcmp(val, "-"))
+		dst[0] = '\0';
+	else
+		ad5x_release_clean(dst, val, len);
+}
+
+static void state_kv(void *obj, const char *key, const char *val)
+{
+	struct ad5x_state *st = obj;
+
+	if (!strcmp(key, "tries"))
+		st->tries = parse_uint(val);
+	else if (!strcmp(key, "kernel"))
+		st->kernel = kernel_from_name(val);
+	else if (!strcmp(key, "release"))
+		copy_val(st->release, val, sizeof(st->release));
+}
+
+static void records_kv(void *obj, const char *key, const char *val)
+{
+	struct ad5x_records *rec = obj;
+
+	if (!strcmp(key, "failed-own"))
+		copy_val(rec->failed_own, val, sizeof(rec->failed_own));
+	else if (!strcmp(key, "failed-mainline"))
+		copy_val(rec->failed_mainline, val,
+			 sizeof(rec->failed_mainline));
+	else if (!strcmp(key, "fallbacks"))
+		rec->fallbacks = parse_uint(val);
+	else if (!strcmp(key, "reason"))
+		text_clean(rec->reason, strcmp(val, "-") ? val : "",
+			   sizeof(rec->reason));
+}
+
+int ad5x_state_parse(const char *buf, struct ad5x_state *st)
+{
+	memset(st, 0, sizeof(*st));
+	if (parse(buf, STATE_MAGIC, state_kv, st)) {
+		memset(st, 0, sizeof(*st));
+		return -1;
+	}
+	if (st->tries > AD5X_MAX_TRIES)
+		st->tries = AD5X_MAX_TRIES;
+	return 0;
+}
+
+int ad5x_records_parse(const char *buf, struct ad5x_records *rec)
+{
+	memset(rec, 0, sizeof(*rec));
+	if (parse(buf, RECORDS_MAGIC, records_kv, rec)) {
+		memset(rec, 0, sizeof(*rec));
+		return -1;
+	}
+	return 0;
+}
+
+static int same(const char *a, const char *b)
+{
+	return a[0] && b[0] && !strcmp(a, b);
+}
+
+static void set_reason(struct ad5x_decision *out, const char *why)
+{
+	text_clean(out->rec.reason, why, sizeof(out->rec.reason));
+	if (out->rec.fallbacks < AD5X_MAX_TRIES)
+		out->rec.fallbacks++;
+	out->rec_changed = 1;
+}
+
+static enum ad5x_kernel pick_kernel(const struct ad5x_inputs *in,
+				    const struct ad5x_records *rec)
+{
+	if (in->have_73 && in->data_ok && in->mainline_wanted &&
+	    !in->after_install && !same(in->rel_73, rec->failed_mainline) &&
+	    !same(in->rel_73, in->s00_failed_mainline))
+		return AD5X_K_73;
+	if (in->have_66 && !same(in->rel_66, rec->failed_own) &&
+	    !same(in->rel_66, in->s00_failed))
+		return AD5X_K_66;
+	if (in->stock_kernel_ok)
+		return AD5X_K_STOCK;
+	return AD5X_K_NONE;
+}
+
+static const char *release_of(const struct ad5x_inputs *in,
+			      enum ad5x_kernel k)
+{
+	if (k == AD5X_K_73)
+		return in->rel_73;
+	if (k == AD5X_K_66)
+		return in->rel_66;
+	return "stock";
+}
+
+void ad5x_decide(const struct ad5x_inputs *in, struct ad5x_decision *out)
+{
+	const struct ad5x_state *st = &in->state;
+	char why[AD5X_REASON_LEN];
+	enum ad5x_kernel k;
+	unsigned int tries;
+	int to_recovery = 0;
+
+	memset(out, 0, sizeof(*out));
+	out->state = *st;
+	out->rec = in->rec;
+
+	/* a record of another release than the installed one: an update */
+	if (out->rec.failed_own[0] &&
+	    !(in->have_66 && same(out->rec.failed_own, in->rel_66))) {
+		out->rec.failed_own[0] = '\0';
+		out->rec_changed = 1;
+	}
+	if (out->rec.failed_mainline[0] &&
+	    !(in->have_73 && same(out->rec.failed_mainline, in->rel_73))) {
+		out->rec.failed_mainline[0] = '\0';
+		out->rec_changed = 1;
+	}
+
+	if (!in->flag_b) {
+		if (in->slot_a_ok) {
+			if (st->tries || st->kernel) {
+				memset(&out->state, 0, sizeof(out->state));
+				out->state_changed = 1;
+			}
+			out->target = AD5X_BOOT_RECOVERY;
+			snprintf(out->msg, sizeof(out->msg),
+				 "boot flag on slot A: recovery OS");
+			return;
+		}
+		set_reason(out, "slot A (recovery) not startable: kernel or "
+			   "root check failed; main OS instead");
+		out->write_flag = -1;	/* the flag to slot B */
+	}
+
+	/* the last start of the main OS didn't finish */
+	tries = st->tries;
+	if (tries) {
+		const char *rel = st->release[0] ? st->release :
+				  release_of(in, st->kernel);
+		int limit = in->after_install ? 1 : 2;
+
+		switch (st->kernel) {
+		case AD5X_K_73:
+			ad5x_release_clean(out->rec.failed_mainline, rel,
+					   AD5X_REL_LEN);
+			snprintf(why, sizeof(why), "mainline kernel %s did not "
+				 "finish starting; 6.6 until ad5x-kernel retry",
+				 rel);
+			set_reason(out, why);
+			tries = 0;
+			break;
+		case AD5X_K_66:
+			if (tries < (unsigned int)limit)
+				break;
+			ad5x_release_clean(out->rec.failed_own, rel,
+					   AD5X_REL_LEN);
+			snprintf(why, sizeof(why), "own kernel %s did not finish "
+				 "starting, %u in a row; stock kernel until "
+				 "ad5x-kernel retry", rel, tries);
+			set_reason(out, why);
+			tries = 0;
+			break;
+		default:	/* stock kernel, or not known */
+			if (tries < (unsigned int)limit)
+				break;
+			snprintf(why, sizeof(why), "main OS did not finish "
+				 "starting with the %s kernel, %u in a row: "
+				 "recovery OS",
+				 st->kernel == AD5X_K_STOCK ? "stock" :
+				 "last", tries);
+			to_recovery = 1;
+			break;
+		}
+	}
+
+	k = pick_kernel(in, &out->rec);
+	if (k == AD5X_K_NONE) {
+		snprintf(why, sizeof(why), "no kernel for the main OS: "
+			 "recovery OS");
+		to_recovery = 1;
+	}
+
+	if (to_recovery) {
+		if (in->flag_b && in->slot_a_ok) {
+			set_reason(out, why);
+			memset(&out->state, 0, sizeof(out->state));
+			out->state_changed = 1;
+			out->write_flag = 1;
+			out->target = AD5X_BOOT_RECOVERY;
+			snprintf(out->msg, sizeof(out->msg), "%s", why);
+			return;
+		}
+		if (k == AD5X_K_NONE) {
+			set_reason(out, "nothing to start: no kernel for the "
+				   "main OS, slot A not startable");
+			out->write_flag = 0;
+			out->target = AD5X_BOOT_PROMPT;
+			snprintf(out->msg, sizeof(out->msg), "%s",
+				 out->rec.reason);
+			return;
+		}
+		/* slot A isn't startable: the main OS again, never a loop */
+		snprintf(why + strlen(why), sizeof(why) - strlen(why),
+			 "; slot A not startable: main OS again");
+		set_reason(out, why);
+	}
+
+	if (k != st->kernel)
+		tries = 0;
+	out->state.tries = tries < AD5X_MAX_TRIES ? tries + 1 : AD5X_MAX_TRIES;
+	out->state.kernel = k;
+	ad5x_release_clean(out->state.release, release_of(in, k),
+			   AD5X_REL_LEN);
+	out->state_changed = 1;
+	out->target = AD5X_BOOT_MAIN;
+	out->kernel = k;
+	snprintf(out->msg, sizeof(out->msg), "main OS, kernel %s (%s), "
+		 "start %u", ad5x_kernel_name(k), out->state.release,
+		 out->state.tries);
+}
diff --git a/board/flashforge/ad5x/bootlogic.h b/board/flashforge/ad5x/bootlogic.h
new file mode 100644
index 00000000..9d38fc3e
--- /dev/null
+++ b/board/flashforge/ad5x/bootlogic.h
@@ -0,0 +1,107 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Flashforge Adventurer 5X: which system and kernel U-Boot starts.
+ *
+ * Plain C without U-Boot headers, so that tools/test_bootlogic.py can build
+ * and test it on the build host. board/flashforge/ad5x/ad5x.c gathers the
+ * inputs (boot flag, records in "ota", files on /data and in rootfs2, slot
+ * A checks), calls ad5x_decide() and carries out the result.
+ *
+ * Records, in the "ota" partition (p5), each one 512-byte sector of text,
+ * "key value" lines ending in a CRC32 line; a sector that doesn't parse or
+ * whose CRC32 is wrong counts as empty (all zeros = empty too):
+ *
+ *   0x90000  state    unconfirmed starts of the main OS: written by U-Boot
+ *                     before each start of the main OS; userspace clears it
+ *                     (writes zeros) once a start has finished, and to give
+ *                     the main OS fresh tries (recovery's "Boot main OS",
+ *                     a finished install).
+ *   0x90200  records  U-Boot's failure records and the reason for the last
+ *                     fallback. Cleared by userspace with "ad5x-kernel retry"
+ *                     (zeros), like S00ad5x-kernel's failed/failed-mainline.
+ *
+ * Bytes 0-11 (boot flag), 64-72 KiB (boot trace) and the environment
+ * (512 KiB and 544 KiB, 32 KiB each) are elsewhere in the partition.
+ */
+
+#ifndef __AD5X_BOOTLOGIC_H__
+#define __AD5X_BOOTLOGIC_H__
+
+#define AD5X_REC_SIZE		512
+#define AD5X_REL_LEN		64	/* release strings, NUL included */
+#define AD5X_REASON_LEN		160
+#define AD5X_MAX_TRIES		250	/* saturates: never wraps to 0 */
+
+/* the kernel a start of the main OS used */
+enum ad5x_kernel {
+	AD5X_K_NONE = 0,
+	AD5X_K_66,	/* Kiln's 6.6 (/usr/lib/ad5x/kernel66 in rootfs2) */
+	AD5X_K_73,	/* mainline 7.3, opt-in (/usr/lib/ad5x/kernel-mainline) */
+	AD5X_K_STOCK,	/* the printer's own 5.10 from "kernel" (p1) */
+};
+
+enum ad5x_target {
+	AD5X_BOOT_MAIN,		/* slot B, root=/dev/mmcblk0p4, kernel below */
+	AD5X_BOOT_RECOVERY,	/* slot A: p1's uImage, root=/dev/mmcblk0p2 */
+	AD5X_BOOT_PROMPT,	/* nothing startable: stay at the prompt */
+};
+
+struct ad5x_state {
+	unsigned int tries;		/* unconfirmed starts in a row */
+	enum ad5x_kernel kernel;	/* kernel of the last of them */
+	char release[AD5X_REL_LEN];	/* its release */
+};
+
+struct ad5x_records {
+	char failed_own[AD5X_REL_LEN];		/* 6.6 release that failed */
+	char failed_mainline[AD5X_REL_LEN];	/* 7.3 release that failed */
+	char reason[AD5X_REASON_LEN];		/* why the last fallback */
+	unsigned int fallbacks;			/* fallbacks counted */
+};
+
+struct ad5x_inputs {
+	int flag_b;		/* "ota" starts with "ota:kernel2" */
+	struct ad5x_state state;
+	struct ad5x_records rec;
+	/* /data (ext4 p7, read only); data_ok: it mounted */
+	int data_ok;
+	int mainline_wanted;	/* /data/ad5x/kernel/mainline exists */
+	int after_install;	/* /data/ad5x/install/recovery.squashfs */
+	char s00_failed[AD5X_REL_LEN];		/* line 1 of kernel/failed */
+	char s00_failed_mainline[AD5X_REL_LEN];	/* ... failed-mainline */
+	/* rootfs2 (squashfs p4) */
+	int have_66;
+	char rel_66[AD5X_REL_LEN];
+	int have_73;
+	char rel_73[AD5X_REL_LEN];
+	/* p1: valid uImage (header + data CRC), not a U-Boot image */
+	int stock_kernel_ok;
+	/* slot A startable: p1 as above and p2 starts with "hsqs" */
+	int slot_a_ok;
+};
+
+struct ad5x_decision {
+	enum ad5x_target target;
+	enum ad5x_kernel kernel;	/* for AD5X_BOOT_MAIN */
+	int write_flag;		/* first: 1 flag to slot A, -1 to B, 0 leave */
+	struct ad5x_state state;	/* to write before the start */
+	struct ad5x_records rec;	/* to write before the start */
+	int state_changed, rec_changed;
+	char msg[AD5X_REASON_LEN];	/* what was decided and why */
+};
+
+void ad5x_decide(const struct ad5x_inputs *in, struct ad5x_decision *out);
+
+/* text sectors: buf is AD5X_REC_SIZE bytes */
+void ad5x_state_format(const struct ad5x_state *st, char *buf);
+int ad5x_state_parse(const char *buf, struct ad5x_state *st);
+void ad5x_records_format(const struct ad5x_records *rec, char *buf);
+int ad5x_records_parse(const char *buf, struct ad5x_records *rec);
+
+/* a release string from a file: first line, unsafe characters as '_' */
+void ad5x_release_clean(char *dst, const char *src, unsigned int len);
+
+const char *ad5x_kernel_name(enum ad5x_kernel k);
+unsigned int ad5x_crc32(unsigned int crc, const void *buf, unsigned int len);
+
+#endif /* __AD5X_BOOTLOGIC_H__ */
