+/* ---- the eMMC ---- */
 
 static struct blk_desc *ad5x_emmc(void)
 {
@@ -72,64 +93,184 @@ static struct blk_desc *ad5x_emmc(void)
 	return mmc_get_blk_desc(mmc);
 }
 
+static int ad5x_read_sector(ulong lba, void *buf)
+{
+	struct blk_desc *desc = ad5x_emmc();
+
+	return desc && blk_dread(desc, lba, 1, buf) == 1 ? 0 : -EIO;
+}
+
+static int ad5x_write_sector(ulong lba, const void *buf)
+{
+	struct blk_desc *desc = ad5x_emmc();
+
+	return desc && blk_dwrite(desc, lba, 1, buf) == 1 ? 0 : -EIO;
+}
+
+/*
+ * The GPT must agree with the stock SPL's table (mach/x2600.h) and name
+ * the partitions as Kiln expects before U-Boot writes "ota" or reads
+ * /data: it addresses them by LBA, as the SPL does.
+ */
+static int ad5x_layout_ok(void)
+{
+	static const struct {
+		int part;
+		const char *name;
+		ulong start;
+	} want[] = {
+		{ 1, "kernel", AD5X_KERNEL_A_LBA },
+		{ 2, "rootfs", AD5X_ROOTFS_A_LBA },
+		{ 3, "kernel2", AD5X_KERNEL_B_LBA },
+		{ 4, "rootfs2", AD5X_ROOTFS_B_LBA },
+		{ 5, "ota", AD5X_OTA_LBA },
+		{ 7, "userdata", 0 },
+	};
+	static int ok = -1;
+	struct blk_desc *desc;
+	struct disk_partition info;
+	int i;
+
+	if (ok >= 0)
+		return ok;
+	desc = ad5x_emmc();
+	ok = !!desc;
+	for (i = 0; ok && i < ARRAY_SIZE(want); i++) {
+		if (part_get_info(desc, want[i].part, &info) ||
+		    strcmp((char *)info.name, want[i].name) ||
+		    (want[i].start && info.start != want[i].start)) {
+			printf("ad5x: GPT partition %d isn't %s at LBA 0x%lx\n",
+			       want[i].part, want[i].name, want[i].start);
+			ok = 0;
+		}
+	}
+	return ok;
+}
+
 /* "a" or "b", as the SPL reads the flag; NULL if it can't be read */
 static const char *ad5x_read_slot(void)
 {
-	struct blk_desc *desc = ad5x_emmc();
-	char *buf;
-	const char *slot = NULL;
+	char buf[512] __aligned(ARCH_DMA_MINALIGN);
 
-	if (!desc)
-		return NULL;
-	buf = memalign(ARCH_DMA_MINALIGN, desc->blksz);
-	if (!buf)
+	if (ad5x_read_sector(AD5X_OTA_LBA, buf))
 		return NULL;
-	if (blk_dread(desc, AD5X_OTA_LBA, 1, buf) == 1)
-		slot = strncmp(buf, AD5X_FLAG_B, strlen(AD5X_FLAG_B)) ? "a" : "b";
-	free(buf);
-	return slot;
+	return strncmp(buf, AD5X_FLAG_B, strlen(AD5X_FLAG_B)) ? "a" : "b";
 }
 
+/*
+ * As "echo ota:kernel > /dev/mmcblk0p5" writes it: the string and a
+ * newline over the first bytes, the rest of the sector as it was.
+ */
 static int ad5x_write_slot(char slot)
+{
+	char buf[512] __aligned(ARCH_DMA_MINALIGN);
+	const char *s = slot == 'b' ? AD5X_FLAG_B "\n" : AD5X_FLAG_A "\n";
+
+	if (!ad5x_layout_ok() || ad5x_read_sector(AD5X_OTA_LBA, buf))
+		return -EIO;
+	memcpy(buf, s, strlen(s));
+	return ad5x_write_sector(AD5X_OTA_LBA, buf);
+}
+
+/* ---- files, read only ---- */
+
+/* @path on partition @part to @addr (at most @max bytes); its size or <0 */
+static long ad5x_load(int part, const char *path, ulong addr, loff_t max)
+{
+	char dev[8];
+	loff_t size, got;
+
+	snprintf(dev, sizeof(dev), "0:%d", part);
+	if (fs_set_blk_dev("mmc", dev, FS_TYPE_ANY) || fs_size(path, &size) ||
+	    size > max)
+		return -ENOENT;
+	if (fs_set_blk_dev("mmc", dev, FS_TYPE_ANY) ||
+	    fs_read(path, addr, 0, size, &got) || got != size)
+		return -EIO;
+	return size;
+}
+
+static int ad5x_exists(int part, const char *path)
+{
+	char dev[8];
+
+	snprintf(dev, sizeof(dev), "0:%d", part);
+	return !fs_set_blk_dev("mmc", dev, FS_TYPE_ANY) && fs_exists(path);
+}
+
+/* a small file into @buf (NUL-terminated, "" without it) */
+static void ad5x_small(int part, const char *path, char *buf, unsigned int n)
+{
+	long len = ad5x_load(part, path, AD5X_SCRATCH, n - 1);
+
+	if (len < 0)
+		len = 0;
+	memcpy(buf, map_sysmem(AD5X_SCRATCH, len), len);
+	buf[len] = '\0';
+}
+
+/* first line of a small file, cleaned; "" without it */
+static void ad5x_line(int part, const char *path, char *dst, unsigned int n)
+{
+	char buf[256];
+
+	ad5x_small(part, path, buf, sizeof(buf));
+	ad5x_release_clean(dst, buf, n);
+}
+
+/* ---- slot A ---- */
+
+/*
+ * A uImage at @lba that a kernel slot may hold: Linux for MIPS, header and
+ * data CRCs good, not a U-Boot (as a uImage for a kernel slot it is ih_os
+ * Linux, loaded at U-Boot's own address): loaded to @addr.
+ */
+static int ad5x_check_kernel(ulong lba, ulong addr)
 {
 	struct blk_desc *desc = ad5x_emmc();
-	char *buf;
-	int ret = -EIO;
-
-	if (!desc)
-		return -ENODEV;
-	buf = memalign(ARCH_DMA_MINALIGN, desc->blksz);
-	if (!buf)
-		return -ENOMEM;
-	/* as Linux writes it: the string, a newline, zeros */
-	memset(buf, 0, desc->blksz);
-	strcpy(buf, slot == 'b' ? AD5X_FLAG_B "\n" : AD5X_FLAG_A "\n");
-	if (blk_dwrite(desc, AD5X_OTA_LBA, 1, buf) == 1)
-		ret = 0;
-	free(buf);
-	return ret;
+	struct legacy_img_hdr *hdr = map_sysmem(addr, 0);
+	ulong blocks;
+
+	if (!desc || blk_dread(desc, lba, 1, hdr) != 1 ||
+	    !image_check_magic(hdr) || !image_check_hcrc(hdr) ||
+	    image_get_os(hdr) != IH_OS_LINUX ||
+	    image_get_arch(hdr) != IH_ARCH_MIPS ||
+	    image_get_load(hdr) == CONFIG_TEXT_BASE ||
+	    image_get_image_size(hdr) > AD5X_KERNEL_SECTORS * 512)
+		return 0;
+	blocks = DIV_ROUND_UP(image_get_image_size(hdr), desc->blksz);
+	if (blk_dread(desc, lba, blocks, hdr) != blocks ||
+	    !image_check_dcrc(hdr))
+		return 0;
+	return 1;
 }
 
+static int ad5x_squashfs_at(ulong lba)
+{
+	char buf[512] __aligned(ARCH_DMA_MINALIGN);
+
+	return !ad5x_read_sector(lba, buf) && !memcmp(buf, "hsqs", 4);
+}
