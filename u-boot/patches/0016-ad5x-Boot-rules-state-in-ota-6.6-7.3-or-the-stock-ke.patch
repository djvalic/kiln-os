 			char *const argv[])
@@ -170,8 +550,7 @@ U_BOOT_CMD(ad5x_flag, 2, 0, do_ad5x_flag,
 
 /*
  * ad5x_wdt SECONDS|off: start the watchdog, so a hang from here on (in
- * U-Boot, the kernel or early user space) resets the board; Linux takes it
- * over and keeps it fed once it runs (/dev/watchdog).
+ * U-Boot, the kernel or early user space) resets the board, or stop it.
  */
 static int do_ad5x_wdt(struct cmd_tbl *cmdtp, int flag, int argc,
 		       char *const argv[])
@@ -186,7 +565,7 @@ static int do_ad5x_wdt(struct cmd_tbl *cmdtp, int flag, int argc,
 		return CMD_RET_SUCCESS;
 	}
 	s = dectoul(argv[1], NULL);
-	if (!s || s > 1431)
+	if (!s || s > X2600_WDT_MAX_MS / 1000)
 		return CMD_RET_USAGE;
 	x2600_wdt_start(s * 1000);
 	printf("watchdog: reset in %lu s unless fed\n", s);
diff --git a/board/flashforge/ad5x/ad5x.env b/board/flashforge/ad5x/ad5x.env
index f89a9fdb..2907550a 100644
--- a/board/flashforge/ad5x/ad5x.env
+++ b/board/flashforge/ad5x/ad5x.env
@@ -1,33 +1,19 @@
 /*
- * U-Boot runs only for slot B (the SPL starts it from kernel2): it boots
- * the main OS's own kernel from rootfs2. When the last start wasn't
- * confirmed, or this one can't be loaded, it boots the recovery OS (slot
- * A) the way the SPL would, and points the boot flag there. Linux confirms
- * a finished start with "fw_setenv boot_pending" (S99ad5x-booted).
+ * Kiln OS on the Flashforge Adventurer 5X. bootcmd runs ad5x_boot, which
+ * picks the system and the kernel (board/flashforge/ad5x/bootlogic.c,
+ * Kiln's u-boot/README.md "Boot rules"); nothing here holds state.
  *
- * The main OS starts with the watchdog running (wdt_boot seconds) and
- * nothing feeding it: a start that hasn't finished by then, a hang
- * included, resets the board, and the next start goes to the recovery OS.
