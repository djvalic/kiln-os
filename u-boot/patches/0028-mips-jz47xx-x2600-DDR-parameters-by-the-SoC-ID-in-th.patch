+/*
+ * The X2600 comes in variants with different DDR dies in the package. The
+ * eFuse says which (Ingenic's x2600/check_socid.c): 20 bits of SoC info,
+ * the variant in 19:16 (1 X2600E, 3 X2600H, ...), DDR3 in 15 (else DDR2),
+ * the DDR vendor in 14:11 and the capacity code in 10:7. x2600_socid()
+ * returns them, or -1 when the eFuse has none. The DDR ID that picks the
+ * DDR parameters is built from them as Ingenic's DDR_CHIP_ID().
+ */
+int x2600_socid(void);
+#define X2600_SOC(id)		(((id) >> 16) & 0xf)
+#define X2600_DDR_ID(id)	(((id) & BIT(15) ? 2 : 3) << 6 |	\
+				 (((id) >> 11) & 0xf) << 3 |		\
+				 (((id) >> 7) & 0xf))
+/* the capacity code in MiB (Ingenic's MEM_256M .. MEM_1G) */
+unsigned int x2600_ddr_mib(unsigned int ddr_id);
+/* the RAM this unit has: from the eFuse, else 512 MiB (an X2600H) */
+unsigned int x2600_ram_mib(void);
+/* the X2600H's second bank on the kernel command line, gone with 256 MiB */
+#define AD5X_ARGS_HIGH		" mem=256M@0x30000000"
+
