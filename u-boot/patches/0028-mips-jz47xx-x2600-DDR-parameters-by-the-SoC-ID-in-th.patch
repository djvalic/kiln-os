+/*
+ * eFuse: the SoC info as Ingenic's x2600/check_socid.c reads it, two words
+ * from word 0x1a: 20 bits from byte 0x6b (bit 24 of the first word), then
+ * the same 20 bits again as a check. Read only; the eFuse clock gate is
+ * left as it was found.
+ */
+#define X2600_EFUSE		((void __iomem *)0xb3480000)
+#define EFUSE_CTRL		0x00
+#define EFUSE_CFG		0x04
+#define EFUSE_STATE		0x08
+#define EFUSE_DATA(n)		(0x0c + 4 * (n))
+#define EFUSE_CTRL_RD_EN	BIT(0)
+#define CLKGR0_EFUSE		BIT(0)
+#define SOCINFO_WORD		0x1a
+
+int x2600_socid(void)
+{
+	u32 gate = readl(X2600_CPM_CLKGR0) & CLKGR0_EFUSE;
+	u32 d0, d1, a, b;
+	int timeout = 100000;
+
+	clrbits_le32(X2600_CPM_CLKGR0, CLKGR0_EFUSE);
+	writel(0x4 << 24, X2600_EFUSE + EFUSE_CFG);	/* RD_ADJ 4 */
+	writel(0, X2600_EFUSE + EFUSE_CTRL);
+	writel(SOCINFO_WORD << 21 | (2 - 1) << 16 | EFUSE_CTRL_RD_EN,
+	       X2600_EFUSE + EFUSE_CTRL);
+	while (!(readl(X2600_EFUSE + EFUSE_STATE) & BIT(0)) && --timeout)
+		;
+	d0 = readl(X2600_EFUSE + EFUSE_DATA(0));
+	d1 = readl(X2600_EFUSE + EFUSE_DATA(1));
+	writel(0, X2600_EFUSE + EFUSE_STATE);
+	setbits_le32(X2600_CPM_CLKGR0, gate);
+
+	a = (d0 >> 24 | d1 << 8) & 0xfffff;
+	b = d1 >> 12;
+	if (!timeout || a != b || !a)
+		return -1;
+	return a;
+}
+
+unsigned int x2600_ddr_mib(unsigned int ddr_id)
+{
+	/* Ingenic's MEM_256M .. MEM_1G codes */
+	static const u16 mib[8] = { 256, 128, 64, 32, 512, 16, 8, 1024 };
+
+	return mib[ddr_id & 7];
+}
+
+unsigned int x2600_ram_mib(void)
+{
+	int id = x2600_socid();
+
+	return id < 0 ? 512 : x2600_ddr_mib(X2600_DDR_ID(id));
+}
