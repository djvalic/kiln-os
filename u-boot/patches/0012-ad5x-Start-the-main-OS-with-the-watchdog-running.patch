From 32b22413b67f7a4552c1afa2c7dc288922bf0b09 Mon Sep 17 00:00:00 2001
From: Hunter Laux <hunterlaux@gmail.com>
Date: Sun, 15 Nov 2026 01:55:02 -0700
Subject: [PATCH 12/12] ad5x: Start the main OS with the watchdog running

Arm the watchdog (wdt_boot, 300 s) just before the main OS's kernel is
started, and tell Linux on the command line: ad5x.uboot=1 (started by
this U-Boot: confirm a finished start with fw_setenv boot_pending) and
ad5x.wdt=1 (feed the watchdog once start-up has finished). Nothing feeds
it during start-up, so a start that hasn't finished in time, a hang
included, resets the board, and boot_pending then sends the next start
to the recovery OS. The recovery OS starts with it off.

Tested by chainload from Flashforge's 5.10: the vendor 6.6 keeps the
watchdog counting; with BusyBox's watchdog feeding /dev/watchdog from
90 s on there was no reset after 300 s, and killing it reset the board
60 s later. fw_setenv (libubootenv) clears boot_pending.

Signed-off-by: Hunter Laux <hunterlaux@gmail.com>
---
 board/flashforge/ad5x/ad5x.env | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/board/flashforge/ad5x/ad5x.env b/board/flashforge/ad5x/ad5x.env
index 992725f7..f89a9fdb 100644
--- a/board/flashforge/ad5x/ad5x.env
+++ b/board/flashforge/ad5x/ad5x.env
@@ -4,18 +4,26 @@
  * confirmed, or this one can't be loaded, it boots the recovery OS (slot
  * A) the way the SPL would, and points the boot flag there. Linux confirms
  * a finished start with "fw_setenv boot_pending" (S99ad5x-booted).
+ *
+ * The main OS starts with the watchdog running (wdt_boot seconds) and
+ * nothing feeding it: a start that hasn't finished by then, a hang
+ * included, resets the board, and the next start goes to the recovery OS.
+ * S99ad5x-booted feeds it from then on (ad5x.wdt=1 on the command line).
+ * The recovery OS starts without it.
  */
 loadaddr=0x82000000
 kernel_path=/usr/lib/ad5x/kernel66/xImage
+wdt_boot=300
 /* the SPL's own command line, without the root */
 args_spl=console=ttyS0,115200n8 loglevel=8 mem=236M@0x0
 	rmem=16M@0xec00000 rtos_size=4M@0xfc00000 mem=256M@0x30000000
 	init=/linuxrc rootwait rootfstype=squashfs ro lpj=11935744
 boot_main=setenv bootargs ${args_spl} root=/dev/mmcblk0p4
-	ad5x.kernel=own panic=10 loglevel=5;
-	sqfsload mmc 0:4 ${loadaddr} ${kernel_path} && bootm ${loadaddr}
+	ad5x.kernel=own ad5x.uboot=1 ad5x.wdt=1 panic=10 loglevel=5;
+	sqfsload mmc 0:4 ${loadaddr} ${kernel_path} &&
+	ad5x_wdt ${wdt_boot} && bootm ${loadaddr}
 /* slot A: the stock uImage at the start of "kernel" (LBA 0x800), 5 MiB */
-boot_recovery=setenv bootargs ${args_spl} root=/dev/mmcblk0p2;
+boot_recovery=ad5x_wdt off; setenv bootargs ${args_spl} root=/dev/mmcblk0p2;
 	mmc read ${loadaddr} 0x800 0x2800 && bootm ${loadaddr}
 fallback=echo "ad5x: start not confirmed: recovery OS";
 	ad5x_flag a; run boot_recovery
-- 
