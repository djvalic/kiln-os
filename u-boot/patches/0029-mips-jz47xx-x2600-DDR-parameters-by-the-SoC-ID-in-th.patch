@@ -307,6 +310,26 @@ static int spl_ddr_test(void)
 }
 #endif
 
+/* ---- which X2600 (mach/x2600_ram.h) ---- */
+
+static unsigned int spl_ram_mib;	/* 512: X2600H, 256: X2600E */
+
+/* the SoC info from the eFuse, logged, and the RAM it means (0: none) */
+static unsigned int spl_x2600_ram(void)
+{
+	int id = x2600_socid();
+
+	if (id >= 0)
+		printf("SPL: SoC ID %05x (variant %u), DDR ID %02x\n", id,
+		       X2600_SOC(id), X2600_DDR_ID(id));
+	else
+		printf("SPL: SoC ID: %s: as an X2600H\n",
+		       id == X2600_SOCID_BLANK ? "none in the eFuse" :
+		       id == X2600_SOCID_TIMEOUT ? "the eFuse read timed out" :
+		       "check bits differ");
+	return x2600_ram_mib(id);
+}
+
 /* ---- the tries (mach/ad5x_start.h) ---- */
 
