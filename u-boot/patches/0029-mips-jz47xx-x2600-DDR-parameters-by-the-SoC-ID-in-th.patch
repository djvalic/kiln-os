  * The eMMC as the stock SPL sees it: its built-in partition table (the
  * GPT agrees on every AD5X examined), 512-byte sectors.
diff --git a/arch/mips/mach-jz47xx/include/mach/x2600_ram.h b/arch/mips/mach-jz47xx/include/mach/x2600_ram.h
new file mode 100644
index 00000000..76a2b716
--- /dev/null
+++ b/arch/mips/mach-jz47xx/include/mach/x2600_ram.h
@@ -0,0 +1,121 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Ingenic X2600: which variant this is and how much RAM it has, the one
+ * decision the SPL (DDR table, kernel command line) and U-Boot proper
+ * (kernel command line) both take from the SoC info in the eFuse. Plain C
+ * without U-Boot headers: Kiln's laptop tests
+ * (u-boot/tools/test_ad5x_start.py) build it on the host.
+ *
+ * The SoC info, as Ingenic's x2600/check_socid.c reads it: eFuse words
+ * 0x1a and 0x1b, 20 bits from byte 0x6b (bit 24 of the first word), then
+ * the same 20 bits again as check bits (the second word's 31:12). In it:
+ * the variant in 19:16 (0 X2600, 1 X2600E, 2 X2600M, 3 X2600H, 4 X2660,
+ * 5 X2670, 6 X2670M), DDR3 in 15 (else DDR2), the DDR vendor in 14:11 and
+ * the capacity code in 10:7 (Ingenic's MEM_256M 0 ... MEM_512M 4 ...).
+ * The DDR ID Ingenic's tables are matched by is DDR_CHIP_ID(vendor, type,
+ * capacity) of those fields.
+ *
+ * The AD5X boards seen so far: an X2600H (0x38200, DDR ID 0x84) with
+ * 512 MiB of DDR3L, and an X2600E (0x18000, DDR ID 0x80) with 256 MiB of
+ * DDR3 (djvalic/kiln-os#68, #74).
+ *
+ * Fail-safe: only a SoC ID with good check bits that is not an X2600H and
+ * decodes to DDR3 with 256 MiB is an X2600E. An X2600H, a blank eFuse, a
+ * read that doesn't finish, check bits that differ or a variant Ingenic
+ * doesn't list all give 512 MiB, the X2600H's table, as every Kiln SPL
+ * before this one did. Another known variant with a DDR Kiln has no table
+ * for (128 MiB and less, DDR2) gives 0: the SPL stops before the DDR
+ * setup, since the kernels' memory layout (mem=236M, rmem at 0x0ec00000,
+ * the RISC-V core's 4 MiB at 0x0fc00000) needs the low 256 MiB.
+ */
+#ifndef __MACH_X2600_RAM_H__
+#define __MACH_X2600_RAM_H__
+
+/* x2600_socid()'s answers that are no SoC ID (< 0) */
+#define X2600_SOCID_BLANK	(-1)	/* no SoC info in the eFuse */
+#define X2600_SOCID_TIMEOUT	(-2)	/* the eFuse read didn't finish */
+#define X2600_SOCID_CHECK	(-3)	/* the check bits differ */
+
+#define X2600_SOC(id)		(((unsigned int)(id) >> 16) & 0xf)
+#define X2600_SOC_H		3
+#define X2600_SOC_KNOWN		7	/* Ingenic lists variants 0-6 */
+#define X2600_SOC_DDR3(id)	(((unsigned int)(id) >> 15) & 1)
+#define X2600_SOC_MEM(id)	(((unsigned int)(id) >> 7) & 0xf)
+/* Ingenic's DDR_CHIP_ID(vendor, type, capacity), type 2 DDR3, 3 DDR2 */
+#define X2600_DDR_ID(id)	((X2600_SOC_DDR3(id) ? 2U : 3U) << 6 |	\
+				 (((unsigned int)(id) >> 11) & 0xf) << 3 | \
+				 X2600_SOC_MEM(id))
+#define X2600_MEM_256M		0
+#define X2600_MEM_512M		4
+
+/* the SoC info from eFuse words 0x1a (@d0) and 0x1b (@d1) */
+static inline int x2600_socid_decode(unsigned int d0, unsigned int d1)
+{
+	unsigned int id = (d0 >> 24 | d1 << 8) & 0xfffff;
+
+	if (id != d1 >> 12)
+		return X2600_SOCID_CHECK;
+	if (!id)
+		return X2600_SOCID_BLANK;
+	return (int)id;
+}
+
+/*
+ * The RAM of the board with SoC info @socid (x2600_socid()), in MiB: 512
+ * (the X2600H's DDR table), 256 (the X2600E's), or 0 (no table: the SPL
+ * stops).
+ */
+static inline unsigned int x2600_ram_mib(int socid)
+{
+	if (socid < 0 || X2600_SOC(socid) == X2600_SOC_H ||
+	    X2600_SOC(socid) >= X2600_SOC_KNOWN)
+		return 512;
+	if (!X2600_SOC_DDR3(socid))
+		return 0;
+	switch (X2600_SOC_MEM(socid)) {
+	case X2600_MEM_512M:
+		return 512;
+	case X2600_MEM_256M:
+		return 256;
+	}
+	return 0;
+}
+
+/*
+ * Take the X2600H's second bank off kernel command line @s, in place:
+ * every word "mem=<size>@0x30000000", with the spaces after it (before it
+ * when it is the last word). Words are separated by spaces.
+ */
+static inline void x2600_args_drop_high_bank(char *s)
+{
+	static const char at[] = "@0x30000000";
+	const int n = sizeof(at) - 1;
+	char *w = s, *e, *d;
+	int i, hit;
+
+	while (*w) {
+		if (*w == ' ') {
+			w++;
+			continue;
+		}
+		for (e = w; *e && *e != ' '; e++)
+			;
+		hit = e - w > 4 + n && w[0] == 'm' && w[1] == 'e' &&
+		      w[2] == 'm' && w[3] == '=';
+		for (i = 0; hit && i < n; i++)
+			hit = e[i - n] == at[i];	/* the word's last n */
+		if (!hit) {
+			w = e;
+			continue;
+		}
+		while (*e == ' ')
+			e++;
+		if (!*e)
+			while (w > s && w[-1] == ' ')
+				w--;
+		for (d = w; (*d = *e); d++, e++)
+			;
+	}
+}
+
+#endif
