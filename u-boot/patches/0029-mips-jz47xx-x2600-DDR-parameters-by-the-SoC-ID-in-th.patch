+ * mach/x2600_ram.h): 236 MiB at 0 (lowmem, the only part KSEG0 reaches
  * below the rmem and rtos regions) and 256 MiB at 0x30000000. Above 236 MiB
  * the low bank holds rmem (16 MiB at 0x0ec00000) and the RISC-V
  * co-processor's 4 MiB (0x0fc00000), which the SPL may have started: U-Boot
@@ -439,6 +440,7 @@ static void ad5x_bootargs(const char *root, int own, int extra_ok,
 	char extra[256] = "";
 	char *args;
 	long len;
+	unsigned int mib;
 
 	if (own && extra_ok) {
 		/* as S00ad5x-kernel adds: cmdline-extra comes last */
@@ -461,6 +463,15 @@ static void ad5x_bootargs(const char *root, int own, int extra_ok,
 			 " ad5x.wdt=%u", wdt);
 	snprintf(args + strlen(args), CONFIG_SYS_CBSIZE - strlen(args),
 		 " %s", extra);
+	/*
+	 * 256 MiB (an X2600E, mach/x2600_ram.h, as the SPL decided): no
+	 * second bank, from args_spl or cmdline-extra alike
+	 */
+	mib = x2600_ram_mib(x2600_socid());
+	if (mib < 512) {
+		x2600_args_drop_high_bank(args);
+		printf("ad5x: %u MiB: no second bank for the kernel\n", mib);
+	}
 	env_set("bootargs", args);
 	free(args);
 }
