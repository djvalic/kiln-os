 #include <linux/types.h>
@@ -190,6 +194,42 @@ static struct x2600_ddr_params ddr = {
 	.rx_dqs1 = 3, .tx_dqs1 = 3,
 };
 
+/*
+ * The X2600E's 256 MiB of DDR3 (DDR ID 0x80), as the newer stock SPL
+ * carries it: no PHY drive/ODT or deskew values, so the SDK's defaults
+ * stay. Copied over the table above only on an X2600E, so that the code
+ * below reads one table either way.
+ */
+static const struct x2600_ddr_params ddr_x2600e = {
+	.name		= "X2600E-DDR3",
+	.id		= 0x80,
+	.type		= X2600_DDR3,
+	.freq		= 900000000,
+	.ddrc_cfg	= 0x82004a35,
+	.ddrc_ctrl	= 0x00003092,
+	.ddrc_mmap0	= 0x000020f0,
+	.ddrc_mmap1	= 0x00003000,
+	.ddrc_refcnt	= 0x40db0081,
+	.ddrc_timing	= { 0x08140e09, 0x0a0a070d, 0x030d040d, 0x202c1f06,
+			    0x8006a065 },
+	.ddrc_autosr_cnt = 0x52000101,
+	.ddrc_autosr_en	= 1,
+	.ddrc_hregpro	= 1,
+	.ddrc_pregpro	= 1,
+	.ddrc_cguc0	= 0x11111111,
+	.ddrc_cguc1	= 0x00000113,
+	.ddrp_memcfg	= 0x8a,
+	.ddrp_cl	= 0xd,
+	.ddrp_cwl	= 0x9,
+	.mr0		= 0x1f14,
+	.mr1		= 0x10002,
+	.mr2		= 0x20020,
+	.mr3		= 0x30000,
+	.chip0_size	= 0x10000000,
+	.remap		= { 0x11020100, 0x07061312, 0x0b0a0908, 0x0f0e0d0c,
+			    0x05040310, 0x17161514 },
+};
+
 static inline u32 cpm_rd(u32 off) { return readl(CPM + off); }
 static inline void cpm_wr(u32 v, u32 off) { writel(v, CPM + off); }
 static inline u32 ddrc_rd(u32 off) { return readl(DDRC + off); }
@@ -490,6 +530,18 @@ void x2600_spl_clocks_init(void)
 	       cpm_rd(CPM_CPEPCR));
 }
 
+/*
+ * The DDR table for @mib (x2600_ram_mib(): 512 or 256): the X2600H's,
+ * which the table above already is, or the X2600E's copied over it.
+ */
+void x2600_sdram_select(unsigned int mib)
+{
+	if (mib == 256)
+		memcpy(&ddr, &ddr_x2600e, sizeof(ddr));
+	printf("SPL: %s DDR table %s, %u MiB\n",
+	       mib == 256 ? "X2600E" : "X2600H", ddr.name, ddr.chip0_size >> 20);
+}
+
 int x2600_sdram_init(void)
 {
 	if (ddr.type != X2600_DDR3) {
diff --git a/arch/mips/mach-jz47xx/x2600/spl.c b/arch/mips/mach-jz47xx/x2600/spl.c
