+/*
+ * eFuse: the SoC info as Ingenic's x2600/check_socid.c reads it (words
+ * 0x1a-0x1b, RD_ADJ 4, RD_STROBE 0), powered down (EFUSE_CTRL PD) once the
+ * read is done, as there; read only. The eFuse clock gate is left as it
+ * was found (Kiln's SPL opens it in its clock setup, before this).
+ */
+#define X2600_EFUSE		((void __iomem *)0xb3480000)
+#define EFUSE_CTRL		0x00
+#define EFUSE_CFG		0x04
+#define EFUSE_STATE		0x08
+#define EFUSE_DATA(n)		(0x0c + 4 * (n))
+#define EFUSE_CTRL_ADDR_SHIFT	21
+#define EFUSE_CTRL_LEN_SHIFT	16
+#define EFUSE_CTRL_PD		BIT(8)
+#define EFUSE_CTRL_RD_EN	BIT(0)
+#define EFUSE_CFG_RD_ADJ_SHIFT	24
+#define EFUSE_STATE_RD_DONE	BIT(0)
+#define EFUSE_SOCINFO_WORD	0x1a
+#define CLKGR0_EFUSE		BIT(0)
+
+int x2600_socid(void)
+{
+	u32 gate = readl(X2600_CPM_CLKGR0) & CLKGR0_EFUSE;
+	u32 d0, d1, t;
+
+	clrbits_le32(X2600_CPM_CLKGR0, CLKGR0_EFUSE);
+	writel(0, X2600_EFUSE + EFUSE_STATE);
+	writel(4 << EFUSE_CFG_RD_ADJ_SHIFT, X2600_EFUSE + EFUSE_CFG);
+	writel(0, X2600_EFUSE + EFUSE_CTRL);
+	writel(EFUSE_SOCINFO_WORD << EFUSE_CTRL_ADDR_SHIFT |
+	       (2 - 1) << EFUSE_CTRL_LEN_SHIFT, X2600_EFUSE + EFUSE_CTRL);
+	setbits_le32(X2600_EFUSE + EFUSE_CTRL, EFUSE_CTRL_RD_EN);
+	for (t = 0; !(readl(X2600_EFUSE + EFUSE_STATE) & EFUSE_STATE_RD_DONE);
+	     t++)
+		if (t >= 100000)
+			break;
+	writel(EFUSE_CTRL_PD, X2600_EFUSE + EFUSE_CTRL);
+	d0 = readl(X2600_EFUSE + EFUSE_DATA(0));
+	d1 = readl(X2600_EFUSE + EFUSE_DATA(1));
+	writel(0, X2600_EFUSE + EFUSE_STATE);
+	setbits_le32(X2600_CPM_CLKGR0, gate);
+
+	if (t >= 100000)
+		return X2600_SOCID_TIMEOUT;
+	return x2600_socid_decode(d0, d1);
+}
