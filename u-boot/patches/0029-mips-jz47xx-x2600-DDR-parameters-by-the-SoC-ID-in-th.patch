--- a/arch/mips/mach-jz47xx/x2600/spl.c
+++ b/arch/mips/mach-jz47xx/x2600/spl.c
@@ -11,8 +11,11 @@
  *  2. the CPM scratch pad tells a fresh start from another try after a
  *     watchdog reset (mach/ad5x_start.h); the watchdog is armed for every
  *     phase;
- *  3. clocks and DDR3 (sdram.c); not in the chainload-test build
- *     (CONFIG_AD5X_SPL_CHAINLOAD), which runs from DDR under Linux;
+ *  3. clocks and DDR3 (sdram.c): the DDR table by the SoC info in the
+ *     eFuse (mach/x2600_ram.h: the X2600H's 512 MiB, also when the eFuse
