--- a/arch/mips/mach-jz47xx/x2600/spl.c
+++ b/arch/mips/mach-jz47xx/x2600/spl.c
@@ -407,13 +407,13 @@ static ulong spl_load_uimage(u32 lba, ulong max, u8 os)
 }
 
 /*
- * the stock SPL's command line (lpj as the stock SPL passes it); without
- * the second bank on a unit with 256 MiB, as the stock SPL starts it
+ * the kernel's command line: all of the RAM (no rmem=/rtos_size= holes,
+ * which only Flashforge's kernel used), without the second bank on a unit
+ * with 256 MiB; lpj as the 2025 stock SPL passes it
  */
-#define AD5X_ARGS	"console=ttyS0,115200n8 loglevel=8 mem=236M@0x0 " \
-			"rmem=16M@0xec00000 rtos_size=4M@0xfc00000 " \
+#define AD5X_ARGS	"console=ttyS0,115200n8 loglevel=8 mem=256M@0x0 " \
 			"mem=256M@0x30000000 init=/linuxrc root=/dev/mmcblk0pX " \
-			"rootwait rootfstype=squashfs ro lpj=11935744"
+			"rootwait rootfstype=squashfs ro lpj=11476992"
 #define AD5X_MAX_ARGS	16
 
 static char spl_args[sizeof(AD5X_ARGS)];
