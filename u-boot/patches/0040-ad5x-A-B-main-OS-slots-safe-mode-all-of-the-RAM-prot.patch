+/* a slot's rootfs partition and root= */
+#define AD5X_ROOT_PART(s)	((s) == AD5X_SLOT_A ? 2 : 4)
+#define AD5X_ROOT_DEV(s)	((s) == AD5X_SLOT_A ? "/dev/mmcblk0p2" : \
+						      "/dev/mmcblk0p4")
+
 static void ad5x_gather(struct ad5x_inputs *in)
 {
 	const char *slot = ad5x_read_slot();
+	int s;
 
 	memset(in, 0, sizeof(*in));
 	in->flag_b = slot && *slot == 'b';
@@ -576,14 +584,23 @@ static void ad5x_gather(struct ad5x_inputs *in)
 		in->wdt_off = ad5x_exists(7, "/ad5x/watchdog.disable");
 	}
 
-	/* rootfs2: p4, SquashFS */
-	in->have_66 = ad5x_exists(4, "/usr/lib/ad5x/kernel66/xImage");
-	ad5x_line(4, "/usr/lib/ad5x/kernel66/release", in->rel_66,
-		  AD5X_REL_LEN);
-	in->have_73 = ad5x_exists(4, "/usr/lib/ad5x/kernel-mainline/xImage");
-	ad5x_line(4, "/usr/lib/ad5x/kernel-mainline/release", in->rel_73,
-		  AD5X_REL_LEN);
-	in->wdt_capable = ad5x_exists(4, "/usr/lib/ad5x/watchdog.conf");
+	/* each slot's rootfs: p2 (A), p4 (B), SquashFS */
+	for (s = AD5X_SLOT_A; s <= AD5X_SLOT_B; s++) {
+		struct ad5x_slot *sl = &in->slot[s];
+		int part = AD5X_ROOT_PART(s);
+
+		sl->have_66 = ad5x_exists(part,
+					  "/usr/lib/ad5x/kernel66/xImage");
+		ad5x_line(part, "/usr/lib/ad5x/kernel66/release", sl->rel_66,
+			  AD5X_REL_LEN);
+		sl->have_73 = ad5x_exists(part,
+					  "/usr/lib/ad5x/kernel-mainline/xImage");
+		ad5x_line(part, "/usr/lib/ad5x/kernel-mainline/release",
+			  sl->rel_73, AD5X_REL_LEN);
+		sl->wdt_capable = ad5x_exists(part,
+					      "/usr/lib/ad5x/watchdog.conf");
+		sl->main_os = sl->have_66 || sl->have_73;
+	}
 
 	/* slot A: p1's kernel (loaded to AD5X_LOAD_A) and p2's root */
 	ad5x_a_name[0] = '\0';
@@ -597,26 +614,38 @@ static void ad5x_gather(struct ad5x_inputs *in)
 
 static void ad5x_print(const struct ad5x_inputs *in)
 {
-	printf("ad5x: flag %s; state: %u tries, last %s %s; records: own "
-	       "%s, mainline %s\n", in->flag_b ? "b" : "a", in->state.tries,
+	int s;
+
+	printf("ad5x: flag %s; state: %u tries, last %s %s, slot %c%s; "
+	       "records: B own %s, mainline %s; A own %s, mainline %s\n",
+	       in->flag_b ? "b" : "a", in->state.tries,
 	       ad5x_kernel_name(in->state.kernel), in->state.release,
+	       in->state.slot == AD5X_SLOT_A ? 'a' : 'b',
+	       in->state.safe ? " (safe mode)" : "",
 	       in->rec.failed_own[0] ? in->rec.failed_own : "-",
-	       in->rec.failed_mainline[0] ? in->rec.failed_mainline : "-");
+	       in->rec.failed_mainline[0] ? in->rec.failed_mainline : "-",
+	       in->rec.failed_own_a[0] ? in->rec.failed_own_a : "-",
+	       in->rec.failed_mainline_a[0] ? in->rec.failed_mainline_a : "-");
+	for (s = AD5X_SLOT_A; s <= AD5X_SLOT_B; s++)
+		printf("ad5x: slot %c: %s; 6.6 %s %s, 7.3 %s %s\n",
+		       s == AD5X_SLOT_A ? 'A' : 'B',
+		       in->slot[s].main_os ? "main OS" : "no main OS",
+		       in->slot[s].have_66 ? "yes" : "no", in->slot[s].rel_66,
+		       in->slot[s].have_73 ? "yes" : "no", in->slot[s].rel_73);
 	printf("ad5x: /data %s (mainline %s, after install %s, S00 failed "
-	       "%s/%s); rootfs2 6.6 %s %s, 7.3 %s %s; slot A %s, p1 %s%s\n",
+	       "%s/%s); 1.x recovery in slot A %s, p1 %s%s\n",
 	       in->data_ok ? "ok" : "unread", in->mainline_wanted ? "on" : "off",
 	       in->after_install ? "yes" : "no",
 	       in->s00_failed[0] ? in->s00_failed : "-",
 	       in->s00_failed_mainline[0] ? in->s00_failed_mainline : "-",
-	       in->have_66 ? "yes" : "no", in->rel_66,
-	       in->have_73 ? "yes" : "no", in->rel_73,
 	       in->slot_a_ok ? "ok" : "not startable",
 	       ad5x_a_name[0] ? ad5x_a_name : "no kernel",
 	       !ad5x_a_name[0] || ad5x_slot_a_kernel_ok(ad5x_a_name) ? "" :
 	       " (not Kiln's 6.6: never started)");
-	printf("ad5x: watchdog: wdt_os %lu, rootfs2 %s, /data %s\n",
+	printf("ad5x: watchdog: wdt_os %lu, slot A %s, slot B %s, /data %s\n",
 	       env_get_ulong("wdt_os", 10, 0),
-	       in->wdt_capable ? "feeds it" : "doesn't feed it",
+	       in->slot[AD5X_SLOT_A].wdt_capable ? "feeds it" : "doesn't",
+	       in->slot[AD5X_SLOT_B].wdt_capable ? "feeds it" : "doesn't",
 	       in->wdt_off ? "switches it off" : "doesn't switch it off");
 }
 
@@ -644,19 +673,49 @@ static int ad5x_commit(const struct ad5x_decision *d)
 	return ret;
 }
 
+/* drop the words starting with @prefix from @args (in place) */
+static void ad5x_drop_args(char *args, const char *prefix)
+{
+	char *p = args, *e;
+	size_t n = strlen(prefix);
+
+	while (*p) {
+		while (*p == ' ')
+			p++;
+		e = p;
+		while (*e && *e != ' ')
+			e++;
+		if (!strncmp(p, prefix, n)) {
+			while (*e == ' ')
+				e++;
+			memmove(p, e, strlen(e) + 1);
+		} else {
+			p = e;
+		}
+	}
+}
+
 /*
  * @own: Kiln's kernel (ad5x.kernel=own panic=10 loglevel=5); @extra: and
  * /data/ad5x/kernel/cmdline-extra after it, as S00ad5x-kernel adds it (the
- * main OS only: the recovery OS starts without the owner's test options)
+ * main OS only: the recovery OS and safe mode start without the owner's
+ * test options); @safe: ad5x.safe=1.
+ *
+ * Memory: all of it. Stock's command line keeps the top 20 MiB of the low
+ * 256 MiB from Linux (rmem= for Flashforge's media drivers, rtos_size= for
+ * the RISC-V core) and gives only mem=236M@0x0; neither is used by Kiln's
+ * kernels, which keep their crash log (ramoops, 1 MiB) in their device
+ * trees. So mem=256M@0x0, and the X2600H's second 256 MiB bank. lpj as
+ * the 2025 stock SPL passes it on both variants (the CPU clock is the same).
  */
 static void ad5x_bootargs(const char *root, int own, int extra_ok,
-			  unsigned int wdt)
+			  unsigned int wdt, int safe)
 {
 	char extra[256] = "";
 	char *args;
 	long len;
 
-	if (own && extra_ok) {
+	if (own && extra_ok && !safe) {
 		/* as S00ad5x-kernel adds: cmdline-extra comes last */
 		ad5x_small(7, "/ad5x/kernel/cmdline-extra", extra,
 			   sizeof(extra));
@@ -668,23 +727,23 @@ static void ad5x_bootargs(const char *root, int own, int extra_ok,
 	args = malloc(CONFIG_SYS_CBSIZE);
 	if (!args)
 		return;
-	snprintf(args, CONFIG_SYS_CBSIZE, "%s root=%s%s ad5x.uboot=1",
-		 env_get("args_spl"), root,
-		 own ? " ad5x.kernel=own panic=10 loglevel=5" : "");
-	/* an X2600 with 256 MiB has no second bank (mach/x2600.h) */
-	if (x2600_ram_mib() < 512) {
-		char *p = strstr(args, AD5X_ARGS_HIGH);
-
-		if (p)
-			memmove(p, p + strlen(AD5X_ARGS_HIGH),
-				strlen(p + strlen(AD5X_ARGS_HIGH)) + 1);
-	}
+	snprintf(args, CONFIG_SYS_CBSIZE, "%s", env_get("args_spl") ?: "");
+	ad5x_drop_args(args, "mem=");
+	ad5x_drop_args(args, "rmem=");
+	ad5x_drop_args(args, "rtos_size=");
+	ad5x_drop_args(args, "lpj=");
+	snprintf(args + strlen(args), CONFIG_SYS_CBSIZE - strlen(args),
+		 " mem=256M@0x0%s lpj=11476992 root=%s%s ad5x.uboot=1%s",
+		 x2600_ram_mib() >= 512 ? AD5X_ARGS_HIGH : "", root,
+		 own ? " ad5x.kernel=own panic=10 loglevel=5" : "",
+		 safe ? " ad5x.safe=1" : "");
 	/* the watchdog runs into this kernel: for how long (information) */
 	if (wdt)
 		snprintf(args + strlen(args), CONFIG_SYS_CBSIZE - strlen(args),
 			 " ad5x.wdt=%u", wdt);
-	snprintf(args + strlen(args), CONFIG_SYS_CBSIZE - strlen(args),
-		 " %s", extra);
+	if (extra[0])
+		snprintf(args + strlen(args), CONFIG_SYS_CBSIZE - strlen(args),
+			 " %s", extra);
 	env_set("bootargs", args);
 	free(args);
 }
@@ -786,7 +845,7 @@ static int do_ad5x_boot(struct cmd_tbl *cmdtp, int flag, int argc,
 
 		if (d.target == AD5X_BOOT_RECOVERY) {
 			/* p1's Kiln 6.6, loaded and checked by ad5x_gather */
-			ad5x_bootargs("/dev/mmcblk0p2", 1, 0, 0);
+			ad5x_bootargs("/dev/mmcblk0p2", 1, 0, 0, 0);
 			ad5x_ub_what = AD5X_UB_RECOVERY;
 			ad5x_ub_tries = 0;
 			ad5x_bootm(AD5X_LOAD_A);
@@ -799,10 +858,13 @@ static int do_ad5x_boot(struct cmd_tbl *cmdtp, int flag, int argc,
 				"/usr/lib/ad5x/kernel-mainline/xImage" :
 				"/usr/lib/ad5x/kernel66/xImage";
 
-			len = ad5x_load(4, path, AD5X_LOAD_MAIN,
-					AD5X_KERNEL_MAX);
+			int safe = d.target == AD5X_BOOT_SAFE;
+
+			len = ad5x_load(AD5X_ROOT_PART(d.slot), path,
+					AD5X_LOAD_MAIN, AD5X_KERNEL_MAX);
 			if (len > 0) {
-				ad5x_bootargs("/dev/mmcblk0p4", 1, 1, wdt);
+				ad5x_bootargs(AD5X_ROOT_DEV(d.slot), 1, 1, wdt,
+					      safe);
 				ad5x_wdt_s = wdt;
 				ad5x_ub_what = d.kernel == AD5X_K_73 ?
 					AD5X_UB_MAIN_73 : AD5X_UB_MAIN_66;
@@ -812,11 +874,14 @@ static int do_ad5x_boot(struct cmd_tbl *cmdtp, int flag, int argc,
 				ad5x_ub_tries = 0;
 				ad5x_wdt_s = 0;
 			}
-			printf("ad5x: %s didn't start\n", path);
+			printf("ad5x: slot %c's %s didn't start\n",
+			       d.slot == AD5X_SLOT_A ? 'A' : 'B', path);
 			if (d.kernel == AD5X_K_73)
-				in.have_73 = 0;
+				in.slot[d.slot].have_73 = 0;
 			else
-				in.have_66 = 0;
+				in.slot[d.slot].have_66 = 0;
+			in.slot[d.slot].main_os = in.slot[d.slot].have_66 ||
+						  in.slot[d.slot].have_73;
 		}
 		/* the state written counts this attempt: start from it */
 		in.state = d.state;
diff --git a/board/flashforge/ad5x/bootlogic.c b/board/flashforge/ad5x/bootlogic.c
index d6350ddd..a225eb43 100644
--- a/board/flashforge/ad5x/bootlogic.c
+++ b/board/flashforge/ad5x/bootlogic.c
@@ -39,9 +39,11 @@
  *   (ad5x_wdt_seconds).
  */
 
