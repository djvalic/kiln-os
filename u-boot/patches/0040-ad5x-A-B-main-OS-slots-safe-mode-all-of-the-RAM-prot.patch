 #include <stdio.h>
 #ifdef __UBOOT__	/* U-Boot's build; not the host test's */
 #include <linux/string.h>
+#include <vsprintf.h>
 #else
 #include <string.h>
 #endif
@@ -138,9 +140,10 @@ void ad5x_state_format(const struct ad5x_state *st, char *buf)
 
 	memset(buf, 0, AD5X_REC_SIZE);
 	n = snprintf(buf, AD5X_REC_SIZE,
-		     STATE_MAGIC "tries %u\nkernel %s\nrelease %s\n",
