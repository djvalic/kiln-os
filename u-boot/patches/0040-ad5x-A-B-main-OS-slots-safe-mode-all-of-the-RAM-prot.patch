 	finish(buf, n);
 }
 
@@ -151,9 +154,12 @@ void ad5x_records_format(const struct ad5x_records *rec, char *buf)
 	memset(buf, 0, AD5X_REC_SIZE);
 	n = snprintf(buf, AD5X_REC_SIZE,
 		     RECORDS_MAGIC "failed-own %s\nfailed-mainline %s\n"
+		     "failed-own-a %s\nfailed-mainline-a %s\n"
 		     "fallbacks %u\nreason %s\n",
 		     rec->failed_own[0] ? rec->failed_own : "-",
 		     rec->failed_mainline[0] ? rec->failed_mainline : "-",
+		     rec->failed_own_a[0] ? rec->failed_own_a : "-",
+		     rec->failed_mainline_a[0] ? rec->failed_mainline_a : "-",
 		     rec->fallbacks, rec->reason[0] ? rec->reason : "-");
 	finish(buf, n);
 }
@@ -221,15 +227,25 @@ static void state_kv(void *obj, const char *key, const char *val)
 		st->kernel = kernel_from_name(val);
 	else if (!strcmp(key, "release"))
 		copy_val(st->release, val, sizeof(st->release));
+	else if (!strcmp(key, "slot"))
+		st->slot = val[0] == 'a' ? AD5X_SLOT_A : AD5X_SLOT_B;
+	else if (!strcmp(key, "safe"))
+		st->safe = parse_uint(val) != 0;
 }
 
 static void records_kv(void *obj, const char *key, const char *val)
 {
 	struct ad5x_records *rec = obj;
 
-	if (!strcmp(key, "failed-own"))
+	if (!strcmp(key, "failed-own") || !strcmp(key, "failed-own-b"))
 		copy_val(rec->failed_own, val, sizeof(rec->failed_own));
-	else if (!strcmp(key, "failed-mainline"))
+	else if (!strcmp(key, "failed-own-a"))
+		copy_val(rec->failed_own_a, val, sizeof(rec->failed_own_a));
+	else if (!strcmp(key, "failed-mainline-a"))
+		copy_val(rec->failed_mainline_a, val,
+			 sizeof(rec->failed_mainline_a));
+	else if (!strcmp(key, "failed-mainline") ||
+		 !strcmp(key, "failed-mainline-b"))
 		copy_val(rec->failed_mainline, val,
 			 sizeof(rec->failed_mainline));
 	else if (!strcmp(key, "fallbacks"))
@@ -242,6 +258,7 @@ static void records_kv(void *obj, const char *key, const char *val)
 int ad5x_state_parse(const char *buf, struct ad5x_state *st)
 {
 	memset(st, 0, sizeof(*st));
+	st->slot = AD5X_SLOT_B;	/* an older build's state: the main OS in B */
 	if (parse(buf, STATE_MAGIC, state_kv, st)) {
 		memset(st, 0, sizeof(*st));
 		return -1;
@@ -279,83 +296,134 @@ static void set_reason(struct ad5x_decision *out, const char *why)
 	out->rec_changed = 1;
 }
 
-static enum ad5x_kernel pick_kernel(const struct ad5x_inputs *in,
-				    const struct ad5x_records *rec)
+/* a slot's failure records */
+static char *rec_own(struct ad5x_records *rec, int s)
 {
-	if (in->have_73 && in->data_ok && in->mainline_wanted &&
-	    !in->after_install && !same(in->rel_73, rec->failed_mainline) &&
-	    !same(in->rel_73, in->s00_failed_mainline))
+	return s == AD5X_SLOT_A ? rec->failed_own_a : rec->failed_own;
+}
+
+static char *rec_main(struct ad5x_records *rec, int s)
+{
+	return s == AD5X_SLOT_A ? rec->failed_mainline_a :
+				  rec->failed_mainline;
+}
+
+/* the kernel a start of slot @s uses: 7.3 if wanted and not failed, else 6.6 */
+static enum ad5x_kernel pick_kernel(const struct ad5x_inputs *in, int s,
+				    struct ad5x_records *rec)
+{
+	const struct ad5x_slot *sl = &in->slot[s];
+
+	if (sl->have_73 && in->data_ok && in->mainline_wanted &&
+	    !in->after_install && !same(sl->rel_73, rec_main(rec, s)) &&
+	    !same(sl->rel_73, in->s00_failed_mainline))
 		return AD5X_K_73;
-	if (in->have_66 && !same(in->rel_66, rec->failed_own) &&
-	    !same(in->rel_66, in->s00_failed))
+	if (sl->have_66 && !same(sl->rel_66, rec_own(rec, s)) &&
+	    !same(sl->rel_66, in->s00_failed))
 		return AD5X_K_66;
 	return AD5X_K_NONE;
 }
 
