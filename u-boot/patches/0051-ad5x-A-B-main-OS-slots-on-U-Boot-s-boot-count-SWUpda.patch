+/*
+ * A/B (ad5x.c, "A/B"): the main OS in both slots, the U-Boot environment
+ * holding the slot to start (kiln_slot) and U-Boot's standard boot count
+ * (upgrade_available, bootcount, bootlimit, altbootcmd) with SWUpdate's
+ * markers (ustate, recovery_status). A printer is A/B when slot A's root
+ * holds Kiln's kernels; otherwise 1.x's rules run, unchanged.
+ */
+enum ad5x_slot_id {
+	AD5X_SLOT_A,
+	AD5X_SLOT_B,
+};
+
+struct ad5x_ab_in {
+	enum ad5x_slot_id slot;	/* kiln_slot, else the boot flag's */
+	int other_main;		/* the other slot's root holds the main OS */
+	int upgrade;		/* upgrade_available: an update not confirmed */
+	int alt;		/* altbootcmd: bootcount passed bootlimit */
+	int in_progress;	/* recovery_status set: an install cut off */
+	int no_kernel;		/* ad5x_decide() found no kernel in slot */
+	int switched;		/* this start already went to the other slot */
+};
+
+struct ad5x_ab_out {
+	enum ad5x_slot_id slot;	/* the slot to start */
+	int switched;		/* it is the other one: kiln_slot changes */
+	int failed;		/* SWUpdate's ustate=3: the update failed */
+	int clear_upgrade;	/* upgrade_available and bootcount to 0 */
+	char msg[AD5X_REASON_LEN];
+};
+
+void ad5x_ab_pick(const struct ad5x_ab_in *in, struct ad5x_ab_out *out);
+char ad5x_slot_char(enum ad5x_slot_id s);
+
 unsigned int ad5x_crc32(unsigned int crc, const void *buf, unsigned int len);
 
