diff --git a/arch/mips/mach-jz47xx/include/mach/ad5x_start.h b/arch/mips/mach-jz47xx/include/mach/ad5x_start.h
new file mode 100644
index 00000000..92b96b70
--- /dev/null
+++ b/arch/mips/mach-jz47xx/include/mach/ad5x_start.h
@@ -0,0 +1,170 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Flashforge Adventurer 5X: how a start is handed from the SPL to U-Boot
+ * proper or a kernel, and back after a watchdog reset, through the CPM
+ * scratch pad CPSPR (kept over a watchdog reset). Plain C without U-Boot
+ * headers: Kiln's laptop tests (u-boot/tools/test_ad5x_start.py) build it
+ * on the host and walk every failure combination through it.
+ *
+ * Kiln's values are 0x4b00 | a low byte:
+ *
+ *   bits 0-1  the attempt (0-3) the value belongs to
+ *   bit  2    skip U-Boot proper at eMMC 0xA400 (it failed this start)
+ *   bit  3    slot B (else A): the slot this attempt boots (phases SLOT,
+ *             KERNEL, SLOT_UBOOT; in the others only with bit 7)
+ *   bits 4-6  the phase (enum ad5x_phase)
+ *   bit  7    the slot is forced: not the one the boot flag names
+ *
+ * Linux writes 0x1a1a, 0x3535 or 0x4343 when it reboots, Ingenic's SPLs
+ * 0x4f5441/0x41544f; anything not 0x4b00-0x4bff is a fresh start.
+ *
+ * The SPL, from the value it finds (ad5x_start_plan):
+ *   - fresh, or KERNEL (a kernel was started; this is its reboot or a
+ *     power cycle): attempt 0, U-Boot proper if there is one, the flag's
+ *     slot;
+ *   - DDR, EMMC (reset during the clock/DDR or eMMC setup): the same plan
+ *     again, next attempt;
+ *   - UBOOT, UBOOT_UP, GAVE_UP (U-Boot proper loaded, up, or gave up
+ *     without starting a kernel): next attempt without U-Boot proper;
+ *   - SLOT, SLOT_UBOOT (the slot's uImage didn't load, or a U-Boot proper
+ *     started from that slot didn't start a kernel): next attempt with the
+ *     other slot, forced;
+ *   - after AD5X_START_TRIES attempts: stop, watchdog off.
+ * Every value but a fresh one or KERNEL moves the attempt on, so within
+ * AD5X_START_TRIES attempts the board starts a kernel, or the next start
+ * stops.
+ *
+ * U-Boot proper keeps the fields and changes the phase: UBOOT -> UBOOT_UP
+ * (started by the SPL from 0xA400), KERNEL -> SLOT_UBOOT (started by the
+ * SPL from a kernel slot); started otherwise (the stock SPL, a chainload
+ * test) it writes SLOT_UBOOT for slot B, where Kiln puts it. Giving up
+ * without a key (no eMMC, nothing to start): UBOOT_UP -> GAVE_UP, and
+ * SLOT_UBOOT stays. Before it jumps to a kernel it writes 0.
+ */
+#ifndef __MACH_AD5X_START_H__
+#define __MACH_AD5X_START_H__
+
+#define AD5X_START_TRIES	4	/* attempts 0-3, two bits */
+
+enum ad5x_phase {
+	AD5X_PH_DDR,		/* SPL: clocks and DDR */
+	AD5X_PH_EMMC,		/* SPL: eMMC setup, the boot flag */
+	AD5X_PH_UBOOT,		/* SPL: loading or started U-Boot at 0xA400 */
+	AD5X_PH_UBOOT_UP,	/* U-Boot proper (from 0xA400) is running */
+	AD5X_PH_GAVE_UP,	/* U-Boot proper (from 0xA400) gave up */
+	AD5X_PH_SLOT,		/* SPL: loading the slot's uImage */
+	AD5X_PH_KERNEL,		/* SPL: started the slot's uImage */
+	AD5X_PH_SLOT_UBOOT,	/* U-Boot proper started from a slot runs */
+};
+
+#define AD5X_ST_MAGIC		0x4b00u
+#define AD5X_ST_SKIP		0x04u
+#define AD5X_ST_SLOT_B		0x08u
+#define AD5X_ST_FORCED		0x80u
+
+static inline int ad5x_st_ours(unsigned int v)
+{
+	return (v & ~0xffu) == AD5X_ST_MAGIC;
+}
+
+static inline unsigned int ad5x_st_phase(unsigned int v)
+{
+	return (v >> 4) & 7;
+}
+
+static inline unsigned int ad5x_st_attempt(unsigned int v)
+{
+	return v & 3;
+}
+
+static inline unsigned int ad5x_st_with_phase(unsigned int v,
+					      enum ad5x_phase ph)
+{
+	return (v & ~0x70u) | (unsigned int)ph << 4;
+}
+
+/* the SPL's plan for this start */
+struct ad5x_plan {
+	unsigned int attempt;	/* 0 .. AD5X_START_TRIES - 1 */
+	int skip_uboot;		/* boot the slot, not U-Boot at 0xA400 */
+	int forced;		/* slot_b, not the boot flag, names the slot */
+	int slot_b;
+	int stop;		/* attempts used up: stop, watchdog off */
+};
+
+static inline void ad5x_start_plan(unsigned int prev, struct ad5x_plan *p)
+{
+	unsigned int ph = ad5x_st_phase(prev), next;
+
+	p->attempt = 0;
+	p->skip_uboot = p->forced = p->slot_b = p->stop = 0;
+	if (!ad5x_st_ours(prev) || ph == AD5X_PH_KERNEL)
+		return;				/* a fresh start */
+
+	next = ad5x_st_attempt(prev) + 1;
+	p->skip_uboot = !!(prev & AD5X_ST_SKIP);
+	p->forced = !!(prev & AD5X_ST_FORCED);
+	p->slot_b = !!(prev & AD5X_ST_SLOT_B);
+	switch (ph) {
+	case AD5X_PH_UBOOT:
+	case AD5X_PH_UBOOT_UP:
+	case AD5X_PH_GAVE_UP:
+		p->skip_uboot = 1;
+		break;
+	case AD5X_PH_SLOT:
+	case AD5X_PH_SLOT_UBOOT:
+		p->forced = 1;
+		p->slot_b = !p->slot_b;
+		break;
+	default:			/* DDR, EMMC: the same again */
+		break;
+	}
+	if (next >= AD5X_START_TRIES) {
+		p->stop = 1;
+		next = AD5X_START_TRIES - 1;
+	}
+	p->attempt = next;
+}
+
+/*
+ * The value for @ph in an attempt with plan @p; @slot_b is the slot it
+ * boots, once known (SLOT, KERNEL), else the plan's.
+ */
+static inline unsigned int ad5x_start_value(const struct ad5x_plan *p,
+					    enum ad5x_phase ph, int slot_b)
+{
+	return AD5X_ST_MAGIC | (p->attempt & 3) |
+	       (p->skip_uboot ? AD5X_ST_SKIP : 0) |
+	       (slot_b ? AD5X_ST_SLOT_B : 0) | (unsigned int)ph << 4 |
+	       (p->forced ? AD5X_ST_FORCED : 0);
+}
+
+/* U-Boot proper, as it starts: the value to write for the one it found */
+static inline unsigned int ad5x_start_uboot_entry(unsigned int cur)
+{
+	if (ad5x_st_ours(cur)) {
+		switch (ad5x_st_phase(cur)) {
+		case AD5X_PH_UBOOT:
+			return ad5x_st_with_phase(cur, AD5X_PH_UBOOT_UP);
+		case AD5X_PH_KERNEL:
+			return ad5x_st_with_phase(cur, AD5X_PH_SLOT_UBOOT);
+		case AD5X_PH_UBOOT_UP:
+		case AD5X_PH_SLOT_UBOOT:
+			return cur;
+		}
+	}
+	/* not started by Kiln's SPL: as if from slot B, attempt 0 */
+	return AD5X_ST_MAGIC | AD5X_ST_SLOT_B | AD5X_PH_SLOT_UBOOT << 4;
+}
+
+/* U-Boot proper gives up without a key: the value to reset with */
+static inline unsigned int ad5x_start_uboot_gave_up(unsigned int cur)
+{
+	unsigned int v = ad5x_start_uboot_entry(cur);
+
+	if (ad5x_st_phase(v) == AD5X_PH_UBOOT_UP)
+		return ad5x_st_with_phase(v, AD5X_PH_GAVE_UP);
+	return v;			/* SLOT_UBOOT: the other slot next */
+}
+
+#endif
diff --git a/arch/mips/mach-jz47xx/include/mach/x2600.h b/arch/mips/mach-jz47xx/include/mach/x2600.h
index 2231723d..8d72d4be 100644
--- a/arch/mips/mach-jz47xx/include/mach/x2600.h
+++ b/arch/mips/mach-jz47xx/include/mach/x2600.h
@@ -17,22 +17,9 @@ void x2600_wdt_stop(void);
 
 /*
  * CPM scratch pad (CPSPR, 0x10000034): kept over a watchdog reset, written
- * only after the unlock word in CPSPPR. Linux writes 0x1a1a, 0x3535 or
- * 0x4343 there when it reboots (soc-x2600/reset.c), Ingenic's SPLs use
- * 0x4f5441/0x41544f; bits 18-22 are reserved. Kiln's values:
- *
- *   0x4b00 | stage << 4 | n   SPL attempt n (0-15) got to stage (0-3)
- *   0x4b80                    SPL started U-Boot proper (from 0xA400)
- *   0x4b81                    U-Boot proper is running
- *
- * Anything else: a fresh start (power on, a reboot from Linux).
+ * only after the unlock word in CPSPPR. Kiln's values and how the SPL and
+ * U-Boot proper use them: mach/ad5x_start.h.
  */
-#define AD5X_CPSPR_TRY(stage, n)	(0x4b00 | ((stage) & 3) << 4 | ((n) & 15))
-#define AD5X_CPSPR_IS_TRY(v)		(((v) & ~0x3fU) == 0x4b00)
-#define AD5X_CPSPR_TRY_STAGE(v)		(((v) >> 4) & 3)
-#define AD5X_CPSPR_TRY_N(v)		((v) & 15)
-#define AD5X_CPSPR_HANDOFF		0x4b80
-#define AD5X_CPSPR_UBOOT_UP		0x4b81
 u32 x2600_cpspr_read(void);
 void x2600_cpspr_write(u32 val);
 
diff --git a/arch/mips/mach-jz47xx/x2600/spl.c b/arch/mips/mach-jz47xx/x2600/spl.c
index 17a42ef3..1e26912e 100644
