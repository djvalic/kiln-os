 arch/mips/mach-jz47xx/include/mach/x2600.h    |  17 +-
 arch/mips/mach-jz47xx/x2600/spl.c             | 104 ++++++-----
 board/flashforge/ad5x/ad5x.c                  |   9 +-
 4 files changed, 234 insertions(+), 66 deletions(-)
