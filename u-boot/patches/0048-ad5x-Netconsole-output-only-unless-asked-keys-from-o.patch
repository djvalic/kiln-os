From 767b527cab487350ebdbd7ea263a8fb5cd00ed04 Mon Sep 17 00:00:00 2001
From: djvalic <djvalic@users.noreply.github.com>
Date: Tue, 17 Nov 2026 15:02:54 -0500
Subject: [PATCH 48/48] ad5x: Netconsole output only unless asked; keys from
 one address; nothing kept

The previous patch turned netconsole on with /data/ad5x/netconsole or
ad5x_nc in the environment, then took keys from the network as well
(from the whole LAN with an empty file: anyone there could stop the
start and reach the prompt, with the watchdog off), and switched it on
by putting "run ad5x_nc_up;" in front of bootcmd and the console devices
into the environment, which a saveenv kept for every later start.

- Output only: /data/ad5x/netconsole (its first line the PC's IPv4
  address, or empty for the broadcast address) sends the console to UDP
  6666. Keys come from the network only with /data/ad5x/netconsole-input
  too, and only from that one unicast address: never with an empty line,
  a broadcast (255.255.255.255 or the subnet's, once DHCP gave the
  netmask), multicast, loopback or 0.x address. The rescue's console goes
  to its server, output only. The decision is in bootlogic.c
  (ad5x_nc_decide), host-tested.
- A prompt reached with keys from the network resets after 300 s idle
  (BOOT_RETRY with RESET_TO_RETRY, bootretry set for that start only;
  BOOT_RETRY_TIME -1 leaves every other prompt as it was).
- Nothing is kept: bootcmd is no longer changed; ad5x_boot starts
  netconsole itself before its key window. console_init_r() takes serial
  for stdin, stdout and stderr at every start whatever the environment
  holds (SYS_CONSOLE_OVERWRITE_ROUTINE, SYS_CONSOLE_ENV_OVERWRITE), and
  ncip, ncinport, ncoutport, bootretry and the old ad5x_nc are dropped at
  every start, so a saveenv made while it was on changes nothing later.
  ad5x_nc is no switch any more.

Off, a start reads /data/ad5x/netconsole's existence once and does
nothing more.
---
 board/flashforge/ad5x/ad5x.c      | 131 +++++++++++++++++++++---------
 board/flashforge/ad5x/bootlogic.c |  44 ++++++++++
 board/flashforge/ad5x/bootlogic.h |  31 +++++++
 configs/ad5x_defconfig            |   5 ++
 4 files changed, 173 insertions(+), 38 deletions(-)

diff --git a/board/flashforge/ad5x/ad5x.c b/board/flashforge/ad5x/ad5x.c
index b11e39b8..20a56931 100644
--- a/board/flashforge/ad5x/ad5x.c
+++ b/board/flashforge/ad5x/ad5x.c
@@ -342,40 +342,99 @@ static void ad5x_ethaddr(void)
 
 /*
  * U-Boot's console over UDP as well as UART0, for a printer without a
- * serial cable (docs/emmc-repair.md, "Netconsole"): output goes to port
- * 6666 of ncip, or to the whole LAN without one; input (the stop key
- * too) comes back to port 6666. On when /data/ad5x/netconsole exists (its
- * first line: the PC's IP, empty for the LAN) or the environment has
- * ad5x_nc (an IP or "on"); then a DHCP of at most 10 s comes before the
- * boot rules and, without an address, the start goes on as without it.
- * Always on in the network rescue. Off: nothing changes.
+ * serial cable (u-boot/README.md, "Netconsole"). Off unless switched on
+ * by /data/ad5x/netconsole (bootlogic.h: its first line the PC's IPv4
+ * address, or empty for the LAN's broadcast address), read by ad5x_boot
+ * before its key window: then a DHCP of at most 10 s (without an address
+ * the start goes on as without it) and output to port 6666 of that
+ * address. Output only; with /data/ad5x/netconsole-input as well, keys
+ * (the stop key too) come from that one unicast address, and the prompt
+ * they give resets the board after AD5X_NC_PROMPT_S idle seconds
+ * (bootretry), so a start stopped from the network goes on by itself.
+ *
+ * Nothing of it is kept: the boot command is never changed, and the
+ * console devices, ncip, the netconsole ports and bootretry are this
+ * build's at every start whatever a saveenv kept (overwrite_console(),
+ * ad5x_nc_reset()). The network rescue sends its console to the PC that
+ * serves it, output only.
+ *
+ * On every start: one fs_exists() of /data/ad5x/netconsole.
  */
-static const char ad5x_nc_up[] =
-	"setenv autoload no; setenv bootpretryperiod 10000; "
-	"if dhcp; then setenv stdin serial,nc; setenv stdout serial,nc; "
-	"setenv stderr serial,nc; echo ad5x: netconsole on (UDP 6666); "
-	"else echo ad5x: netconsole: no address, serial only; fi";
+#define AD5X_NC_PROMPT_S	"300"
 
-static int ad5x_netconsole(void)
+/* console_init_r(): stdin, stdout and stderr serial, not the saved ones */
+int overwrite_console(void)
 {
-	char ip[32] = "";
-	const char *v = env_get("ad5x_nc");
-
-	if (v)
-		strlcpy(ip, strcmp(v, "on") ? v : "", sizeof(ip));
-	else if (ad5x_exists(7, "/ad5x/netconsole"))
-		ad5x_small(7, "/ad5x/netconsole", ip, sizeof(ip));
-	else
-		return 0;
-	ip[strcspn(ip, " \t\r\n")] = '\0';
-	if (ip[0])
-		env_set("ncip", ip);
-	else
-		env_set("ncip", NULL);	/* the LAN's broadcast */
-	env_set("ad5x_nc_up", ad5x_nc_up);
 	return 1;
 }
 
+static void ad5x_nc_reset(void)
+{
+	static const char *const vars[] = {
+		"ncip", "ncinport", "ncoutport", "bootretry", "ad5x_nc",
+		"ad5x_nc_up",
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(vars); i++)
+		if (env_get(vars[i]))
+			env_set(vars[i], NULL);
+}
+
+/* @ip is the broadcast address of the network DHCP gave */
+static int ad5x_nc_subnet_bcast(const char *ip)
+{
+	struct in_addr a = string_to_ip(ip);
+
+	return net_netmask.s_addr &&
+	       (a.s_addr & net_netmask.s_addr) ==
+	       (net_ip.s_addr & net_netmask.s_addr) &&
+	       (a.s_addr | net_netmask.s_addr) == ~0U;
+}
+
+static void ad5x_netconsole(void)
+{
+	static int done;
+	char line[64];
+	struct ad5x_nc nc;
+
+	if (done)
+		return;
+	done = 1;
+	if (!ad5x_exists(7, "/ad5x/netconsole"))
+		return;
+	ad5x_small(7, "/ad5x/netconsole", line, sizeof(line));
+	ad5x_nc_decide(1, line, ad5x_exists(7, "/ad5x/netconsole-input"), &nc);
+	if (nc.note[0])
+		printf("ad5x: netconsole: %s\n", nc.note);
+	if (nc.mode == AD5X_NC_OFF)
+		return;
+	ad5x_ethaddr();
+	env_set("autoload", "no");
+	env_set("bootpretryperiod", "10000");
+	if (run_command("dhcp", 0)) {
+		printf("ad5x: netconsole: no address by DHCP: serial only\n");
+		return;
+	}
+	if (nc.mode == AD5X_NC_IN && ad5x_nc_subnet_bcast(nc.ip)) {
+		printf("ad5x: netconsole: %s is this network's broadcast "
+		       "address: output only\n", nc.ip);
+		nc.mode = AD5X_NC_OUT;
+	}
+	env_set("ncip", nc.ip[0] ? nc.ip : NULL);	/* none: broadcast */
+	env_set("stdout", "serial,nc");
+	env_set("stderr", "serial,nc");
+	if (nc.mode == AD5X_NC_IN) {
+		env_set("stdin", "serial,nc");
+		env_set("bootretry", AD5X_NC_PROMPT_S);
+	}
+	printf("ad5x: netconsole on: output to %s, UDP 6666; %s\n",
+	       nc.ip[0] ? nc.ip : "the LAN's broadcast address",
+	       nc.mode == AD5X_NC_IN ? "keys from there too (the prompt resets "
+	       "after " AD5X_NC_PROMPT_S " s idle)" : "keys from the serial "
+	       "console only");
+}
+
 /* ---- network rescue ---- */
 
 /*
@@ -473,11 +532,11 @@ static int ad5x_rescue(void)
 		"run kr_fail; mmc write ${kr_la} ${blk} ${cnt} && "
 		"mmc read ${kr_rb} ${blk} ${cnt} && "
 		"hash -v sha256 ${kr_rb} ${sz} ${sum} || run kr_fail");
-	env_set("ncip", r.server);	/* the console to the PC that serves */
+	/* the console to the PC that serves, output only */
+	env_set("ncip", r.server);
 	env_set("kr_start", "ad5x_wdt " AD5X_RESCUE_WDT_S "; mmc dev 0; "
 		"run kr_net || run kr_fail; "
-		"setenv stdin serial,nc; setenv stdout serial,nc; "
-		"setenv stderr serial,nc; "
+		"setenv stdout serial,nc; setenv stderr serial,nc; "
 		"wget ${kr_sa} ${kr_srv}:/rescue/rescue.scr || run kr_fail; "
 		"hash -v sha256 ${kr_sa} ${filesize} ${kr_sha} || run kr_fail; "
 		"source ${kr_sa} || run kr_fail");
@@ -511,14 +570,8 @@ int board_late_init(void)
 	if (ad5x_rescue())
 		return 0;
 	ad5x_env_follow_build();
+	ad5x_nc_reset();
 	env_set("ad5x_slot", ad5x_read_slot());
-	if (ad5x_netconsole()) {
-		const char *b = env_get("bootcmd");
-		char cmd[256];
-
-		snprintf(cmd, sizeof(cmd), "run ad5x_nc_up; %s", b ? b : "");
-		env_set("bootcmd", cmd);
-	}
 	return 0;
 }
 
@@ -804,6 +857,8 @@ static int do_ad5x_boot(struct cmd_tbl *cmdtp, int flag, int argc,
 	int round;
 	long len;
 
+	if (!dry)
+		ad5x_netconsole();
 	if (!dry && ad5x_wait_key()) {
 		ad5x_to_prompt("key pressed");
 		return CMD_RET_SUCCESS;
diff --git a/board/flashforge/ad5x/bootlogic.c b/board/flashforge/ad5x/bootlogic.c
index 8f60df32..7221861e 100644
--- a/board/flashforge/ad5x/bootlogic.c
+++ b/board/flashforge/ad5x/bootlogic.c
@@ -672,3 +672,47 @@ int ad5x_rescue_counted(const char *sec, unsigned int tries, char *out)
 	}
 	return 0;
 }
+
+void ad5x_nc_decide(int file, const char *line, int input,
+		    struct ad5x_nc *nc)
+{
+	unsigned char ip[4];
+	char tok[16];		/* an IPv4 address fits */
+	unsigned int n = 0;
+
+	memset(nc, 0, sizeof(*nc));
+	if (!file)
+		return;
+	/* the first line's first word */
+	while (*line == ' ' || *line == '\t')
+		line++;
+	while (*line && !strchr(" \t\r\n", *line)) {
+		if (n + 1 >= sizeof(tok)) {
+			snprintf(nc->note, sizeof(nc->note), "the first line "
+				 "isn't an IPv4 address: off");
+			return;
+		}
+		tok[n++] = *line++;
+	}
+	tok[n] = '\0';
+	if (!tok[0] || !strcmp(tok, "255.255.255.255")) {
+		nc->mode = AD5X_NC_OUT;
+		if (input)
+			snprintf(nc->note, sizeof(nc->note), "output to the "
+				 "LAN's broadcast address only: keys need the "
+				 "PC's address on the first line");
+		return;
+	}
+	if (!ad5x_ipv4(tok, ip)) {
+		snprintf(nc->note, sizeof(nc->note), "the first line (\"%s\") "
+			 "isn't an IPv4 address: off", tok);
+		return;
+	}
+	if (!ip[0] || ip[0] == 127 || ip[0] >= 224) {
+		snprintf(nc->note, sizeof(nc->note), "%s isn't a unicast "
+			 "address: off", tok);
+		return;
+	}
+	snprintf(nc->ip, sizeof(nc->ip), "%s", tok);
+	nc->mode = input ? AD5X_NC_IN : AD5X_NC_OUT;
+}
diff --git a/board/flashforge/ad5x/bootlogic.h b/board/flashforge/ad5x/bootlogic.h
index 0d3ddc2b..75bf5b87 100644
--- a/board/flashforge/ad5x/bootlogic.h
+++ b/board/flashforge/ad5x/bootlogic.h
@@ -199,6 +199,37 @@ enum ad5x_rescue_state ad5x_rescue_parse(const char *sec,
  * (AD5X_REC_SIZE bytes, NUL-padded); 0, or -1 when it doesn't fit
  */
 int ad5x_rescue_counted(const char *sec, unsigned int tries, char *out);
+
+/*
+ * Netconsole (ad5x.c): U-Boot's console over UDP port 6666 as well as
+ * UART0, for a printer without a serial cable. Off unless the owner
+ * switches it on: /data/ad5x/netconsole, its first line the PC's IPv4
+ * address (output goes there) or empty (or 255.255.255.255: output to the
+ * LAN's broadcast address). Output only: keys come from the network as
+ * well only with /data/ad5x/netconsole-input too, and only from that one
+ * unicast address; never with an empty first line or a broadcast one. A
+ * first line that is no address at all, or a multicast, loopback or
+ * 0.x one, leaves it off. (A subnet's own broadcast address is known only
+ * after DHCP: ad5x.c drops the keys for it then.)
+ */
+enum ad5x_nc_mode {
+	AD5X_NC_OFF,
+	AD5X_NC_OUT,		/* output only */
+	AD5X_NC_IN,		/* output, and keys from ip */
+};
+
+struct ad5x_nc {
+	enum ad5x_nc_mode mode;
+	char ip[16];		/* "": the broadcast address */
+	char note[112];		/* why it is off, or output only */
+};
+
+/*
+ * @file: /data/ad5x/netconsole exists, @line its contents (its first line
+ * counts, NUL-terminated), @input: netconsole-input exists
+ */
+void ad5x_nc_decide(int file, const char *line, int input,
+		    struct ad5x_nc *nc);
 unsigned int ad5x_crc32(unsigned int crc, const void *buf, unsigned int len);
 
 #endif /* __AD5X_BOOTLOGIC_H__ */
diff --git a/configs/ad5x_defconfig b/configs/ad5x_defconfig
index 825d400a..188961ed 100644
--- a/configs/ad5x_defconfig
+++ b/configs/ad5x_defconfig
@@ -96,3 +96,8 @@ CONFIG_CMD_WGET=y
 CONFIG_PROT_TCP_SACK=y
 CONFIG_NETCONSOLE=y
 CONFIG_CONSOLE_MUX=y
+CONFIG_SYS_CONSOLE_OVERWRITE_ROUTINE=y
+CONFIG_SYS_CONSOLE_ENV_OVERWRITE=y
+CONFIG_BOOT_RETRY=y
+CONFIG_BOOT_RETRY_TIME=-1
+CONFIG_RESET_TO_RETRY=y
